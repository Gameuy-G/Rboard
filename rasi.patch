+    <string name="rasi_rooms_title">Listen together</string>
+    <string name="rasi_rooms_subtitle">Rooms where everyone sees what the others play, with one tap to play it in your own app (uses the internet)</string>
+    <string name="rasi_stats_title">Stats</string>
