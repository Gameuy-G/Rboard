+    fun baseColors(p0: android.content.SharedPreferences, prefix: String, sh: Boolean = false): Colors {
+        val p = if (prefix == "viz_") RasiSongLooks.over(p0) else p0
+        val src = p.getString(prefix + "color_src", "song") ?: "song"
+        val now = System.currentTimeMillis()
+        if (src == "song") {
+            val art = RasiNowPlaying.track?.art ?: return Colors("song", AColor.WHITE, AColor.WHITE, now)
+            val pal = RasiNowPlayingTheme.palette(art)
+            if (pal == null || pal.s1 <= 0f) return Colors("song", AColor.WHITE, AColor.WHITE, now)
+            val n = p.getInt(prefix + "song_n", 3).coerceIn(2, 6)
+            val minV = p.getInt(prefix + "song_minv", 60) / 100f
+            val boost = p.getInt(prefix + "song_sat", 10) / 100f
+            val rev = p.getBoolean(prefix + "song_rev", false)
+            fun fix(c: Int): Int {
+                val hv = FloatArray(3)
+                AColor.colorToHSV(c, hv)
+                hv[1] = (hv[1] + boost).coerceAtMost(1f)
+                hv[2] = hv[2].coerceIn(minV, 1f)
+                return AColor.HSVToColor(hv)
+            }
+            val sw = rotSw(RasiNowPlayingTheme.swatches(art), sh)
+            if (sw.isNotEmpty()) {
+                val list = IntArray(minOf(n, sw.size)) { fix(sw[it]) }
+                if (rev) list.reverse()
+                val a = list[0]
+                val b = if (list.size > 1) list[1] else lerpC(a, AColor.WHITE, 0.5f)
+                return Colors("song", a, b, now, if (list.size >= 3) list else null)
+            }
+            val a = AColor.HSVToColor(floatArrayOf(pal.h1, (pal.s1 + 0.08f).coerceAtMost(1f), pal.v1.coerceIn(0.7f, 1f)))
+            val b = if (pal.s2 > 0f) AColor.HSVToColor(floatArrayOf(pal.h2, (pal.s2 + 0.08f).coerceAtMost(1f), pal.v2.coerceIn(0.7f, 1f)))
+                    else lerpC(a, AColor.WHITE, 0.5f)
+            return Colors("song", a, b, now)
+        }
+        val c1 = p.getInt(prefix + "color1", 0xFF7CF29C.toInt())
+        val c2 = p.getInt(prefix + "color2", 0xFF4F8CFF.toInt())
+        return Colors(src, c1, c2, now)
+    }
