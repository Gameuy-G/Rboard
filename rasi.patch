+/** Renders a theme's background (or a flat color) so the editor can start from it. */
+fun schemeToBitmap(context: android.content.Context, colors: KeyboardColorScheme): android.graphics.Bitmap {
+    val opts = colors.extended.advancedThemeOptions
+    val img = opts.backgroundImage ?: opts.thumbnailImage
+    val fromImg = img?.let {
+        runCatching { it.asAndroidBitmap().copy(android.graphics.Bitmap.Config.ARGB_8888, false) }.getOrNull()
+    }
+    if (fromImg != null) return fromImg
+    val bmp = android.graphics.Bitmap.createBitmap(1080, 900, android.graphics.Bitmap.Config.ARGB_8888)
+    bmp.eraseColor(colors.keyboardSurface.toArgb())
+    return bmp
+}
+
+internal fun schemeToEditUri(context: android.content.Context, colors: KeyboardColorScheme): String {
+    val bmp = schemeToBitmap(context, colors)
+    val dir = java.io.File(context.cacheDir, "rasi_edit").also { it.mkdirs() }
+    val f = java.io.File(dir, "theme_${System.currentTimeMillis()}.png")
+    f.outputStream().use { bmp.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, it) }
+    return android.net.Uri.fromFile(f).toString()
+}
