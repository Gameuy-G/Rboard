@@ -0,0 +1,135 @@
+package org.futo.inputmethod.latin.uix
+
+import android.Manifest
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.graphics.BitmapFactory
+import android.net.Uri
+import android.os.Build
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import androidx.datastore.preferences.core.stringSetPreferencesKey
+import kotlinx.coroutines.runBlocking
+import org.futo.inputmethod.latin.R
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.text.SimpleDateFormat
+import java.util.Locale
+import java.util.TimeZone
+
+val RasiNoticesSetting = SettingsKey(booleanPreferencesKey("rasi_notices"), true)
+val RasiNoticesSeen = SettingsKey(stringSetPreferencesKey("rasi_notices_seen"), emptySet<String>())
+
+/**
+ * Reads notice.json from the repo (raw GitHub URL) and shows every notice not seen yet as a
+ * notification. One object or an array of objects with: id, title, message, url?, image?, expiry?
+ */
+object RasiNotice {
+    const val NOTICE_URL = "https://raw.githubusercontent.com/Gameuy-G/Rboard/master/notice.json"
+    const val CHANNEL_ID = "rasi_notices"
+
+    private fun fetch(url: String): String? {
+        val c = URL(url).openConnection() as HttpURLConnection
+        return try {
+            c.connectTimeout = 10000
+            c.readTimeout = 15000
+            c.setRequestProperty("User-Agent", "Rboard-notice-check")
+            if (c.responseCode != 200) null else c.inputStream.bufferedReader().use { it.readText() }
+        } catch (_: Throwable) {
+            null
+        } finally {
+            c.disconnect()
+        }
+    }
+
+    private fun parseExpiry(s: String): Long {
+        for (f in listOf("yyyy-MM-dd'T'HH:mm:ss'Z'", "yyyy-MM-dd")) {
+            try {
+                val d = SimpleDateFormat(f, Locale.US).apply { timeZone = TimeZone.getTimeZone("UTC") }.parse(s)
+                if (d != null) return d.time
+            } catch (_: Throwable) {
+            }
+        }
+        return 0L
+    }
+
+    /** Blocking. Returns how many notifications were shown. */
+    fun check(context: Context): Int {
+        val app = context.applicationContext
+        if (!rasiRead(app, RasiNoticesSetting.key, RasiNoticesSetting.default)) return 0
+        if (Build.VERSION.SDK_INT >= 33 &&
+            app.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+        ) return 0
+
+        val text = fetch("$NOTICE_URL?t=${System.currentTimeMillis()}") ?: return 0
+        val list = ArrayList<JSONObject>()
+        try {
+            val t = text.trim()
+            if (t.startsWith("[")) {
+                val a = JSONArray(t)
+                for (i in 0 until a.length()) list.add(a.getJSONObject(i))
+            } else list.add(JSONObject(t))
+        } catch (_: Throwable) {
+            return 0
+        }
+
+        val seen = rasiRead(app, RasiNoticesSeen.key, emptySet<String>()).toMutableSet()
+        var shown = 0
+        for (o in list) {
+            val id = o.optString("id")
+            val title = o.optString("title")
+            val message = o.optString("message")
+            if (id.isBlank() || (title.isBlank() && message.isBlank()) || id in seen) continue
+            val expiry = o.optString("expiry")
+            if (expiry.isNotBlank()) {
+                val e = parseExpiry(expiry)
+                if (e > 0 && System.currentTimeMillis() > e) continue
+            }
+            show(app, id, title, message, o.optString("url"), o.optString("image"))
+            seen.add(id)
+            shown++
+        }
+        if (shown > 0) runBlocking { app.setSetting(RasiNoticesSeen.key, seen.toSet()) }
+        return shown
+    }
+
+    fun show(app: Context, id: String, title: String, message: String, url: String, image: String) {
+        if (Build.VERSION.SDK_INT >= 33 &&
+            app.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+        ) return
+        val nm = app.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        nm.createNotificationChannel(
+            NotificationChannel(CHANNEL_ID, app.getString(R.string.rasi_notice_channel), NotificationManager.IMPORTANCE_DEFAULT)
+        )
+        val b = NotificationCompat.Builder(app, CHANNEL_ID)
+            .setSmallIcon(R.mipmap.ic_launcher)
+            .setContentTitle(title.ifBlank { app.getString(R.string.rasi_notice_default_title) })
+            .setContentText(message)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(message))
+            .setAutoCancel(true)
+        if (url.startsWith("http://") || url.startsWith("https://")) {
+            b.setContentIntent(
+                PendingIntent.getActivity(
+                    app, id.hashCode(),
+                    Intent(Intent.ACTION_VIEW, Uri.parse(url)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                    PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+                )
+            )
+        }
+        if (image.startsWith("http://") || image.startsWith("https://")) {
+            try {
+                val bmp = URL(image).openStream().use { BitmapFactory.decodeStream(it) }
+                if (bmp != null) b.setStyle(NotificationCompat.BigPictureStyle().bigPicture(bmp).setSummaryText(message))
+            } catch (_: Throwable) {
+            }
+        }
+        NotificationManagerCompat.from(app).notify(10000 + (id.hashCode() and 0xFFFF), b.build())
+    }
+}
