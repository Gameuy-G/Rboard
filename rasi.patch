+/** Full emoji picker for reactions: search by word, recently used, and categories. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun EmojiPickerSheet(prefs: SharedPreferences, onPick: (String) -> Unit, onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    var q by remember { mutableStateOf("") }
+    var ready by remember { mutableStateOf(false) }
+    androidx.compose.runtime.LaunchedEffect(Unit) {
+        kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.IO) { RasiEmojiWords.ensureLoaded(context); EMOJI_CATS }
+        ready = true
+    }
+    val recents = remember { recentEmojis(prefs) }
+    val t = q.trim()
+    val found by remember(t, ready) { mutableStateOf(if (ready && t.length >= 3) (RasiEmojiWords.lookup(t) + RasiEmojiWords.lookupPrefix(t)).distinct() else emptyList()) }
+    val pick: (String) -> Unit = { e -> pushRecent(prefs, e); onPick(e) }
+    val gridState = androidx.compose.foundation.lazy.grid.rememberLazyGridState()
+    val scope = rememberCoroutineScope()
+    val sections = if (t.length >= 3) emptyList() else buildList {
+        if (recents.isNotEmpty()) add("Frequently used" to recents)
+        if (ready) addAll(EMOJI_CATS)
+    }
+    val starts = remember(sections) { var n = 0; sections.map { val st = n; n += 1 + it.second.size; st } }
+    val cur by remember(starts) { androidx.compose.runtime.derivedStateOf { starts.indexOfLast { it <= gridState.firstVisibleItemIndex }.coerceAtLeast(0) } }
+    ModalBottomSheet(onDismissRequest = onDismiss, shape = RoundedCornerShape(topStart = 28.dp, topEnd = 28.dp)) {
+        OutlinedTextField(q, { q = it.take(20) }, placeholder = { Text("Find the perfect reaction") }, singleLine = true,
+            shape = RoundedCornerShape(28.dp),
+            leadingIcon = { androidx.compose.material3.Icon(androidx.compose.material.icons.Icons.Filled.Search, null, Modifier.size(20.dp)) },
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp))
+        if (sections.isNotEmpty()) androidx.compose.foundation.lazy.LazyRow(
+            Modifier.fillMaxWidth().padding(top = 8.dp), contentPadding = PaddingValues(horizontal = 12.dp), horizontalArrangement = Arrangement.spacedBy(6.dp)
+        ) {
+            itemsIndexed(sections, key = { _, c -> c.first }) { idx, c ->
+                val on = idx == cur
+                Box(Modifier.clip(RoundedCornerShape(16.dp))
+                    .background(if (on) MaterialTheme.colorScheme.primary.copy(alpha = 0.25f) else MaterialTheme.colorScheme.surfaceContainerHigh)
+                    .clickable { scope.launch { gridState.scrollToItem(starts[idx]) } }
+                    .padding(horizontal = 14.dp, vertical = 6.dp), contentAlignment = Alignment.Center) {
+                    Text(if (c.first == "Frequently used") "\uD83D\uDD58" else c.second.first(), fontSize = 20.sp, maxLines = 1)
+                }
+            }
+        }
+        LazyVerticalGrid(GridCells.Fixed(8), Modifier.fillMaxWidth().heightIn(max = 480.dp).padding(horizontal = 8.dp), state = gridState) {
+            if (t.length >= 3) {
+                emojiSection("Results", found, pick)
+                if (found.isEmpty()) item(span = { GridItemSpan(maxLineSpan) }) { Text("No emoji found for that word", Modifier.padding(12.dp), fontSize = 13.sp) }
+            } else {
+                sections.forEach { (name, list) -> emojiSection(name, list, pick) }
+            }
+        }
+    }
+}
