+@Composable
+fun RasiClipImportScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiClipImport.prefs(context) }
+    remember { RasiSections.init(context); RasiClipImport.init(context) }
+
+    var modeOn by remember { mutableStateOf(RasiClipImport.modeOn.value) }
+    var skipDupes by remember { mutableStateOf(RasiClipImport.skipDupes(context)) }
+    var images by remember { mutableStateOf(RasiClipImport.saveImages(context)) }
+    var split by remember { mutableStateOf(RasiClipImport.splitMode(context)) }
+    var section by remember { mutableStateOf(RasiClipImport.section(context)) }
+    var newSection by remember { mutableStateOf("") }
+    var pasted by remember { mutableStateOf("") }
+    var resultText by remember { mutableStateOf("") }
+    var tick by remember { mutableIntStateOf(0) }
+
+    val shownSections = (listOf(RasiClipImport.DEFAULT_SECTION) + RasiSections.names.toList()).distinct()
+
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.rasi_import_title), showBack = true, navController)
+
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(stringResource(R.string.rasi_import_hint))
+
+            // ---- where imported items go ----
+            Text(stringResource(R.string.rasi_import_section))
+            Row(Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                shownSections.forEach { n ->
+                    FilterChip(
+                        selected = section == n,
+                        onClick = {
+                            section = n
+                            prefs.edit().putString("section", n).apply()
+                        },
+                        label = { Text(n) }
+                    )
+                }
+            }
+            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(
+                    value = newSection,
+                    onValueChange = { newSection = it },
+                    label = { Text(stringResource(R.string.rasi_import_new_section)) },
+                    singleLine = true,
+                    modifier = Modifier.weight(1f)
+                )
+                OutlinedButton(
+                    enabled = newSection.isNotBlank(),
+                    onClick = {
+                        val n = newSection.trim()
+                        RasiSections.addSection(n)
+                        section = n
+                        prefs.edit().putString("section", n).apply()
+                        newSection = ""
+                        tick++
+                    }
+                ) { Text(stringResource(R.string.rasi_import_add)) }
+            }
+
+            // ---- import mode ----
+            Row(
+                Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.SpaceBetween
+            ) {
+                Text(stringResource(R.string.rasi_import_mode), Modifier.weight(1f))
+                Switch(checked = modeOn, onCheckedChange = {
+                    modeOn = it
+                    RasiClipImport.setMode(context, it)
+                })
+            }
+            Text(stringResource(R.string.rasi_import_mode_hint))
+
+            Row(
+                Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.SpaceBetween
+            ) {
+                Text(stringResource(R.string.rasi_import_dupes), Modifier.weight(1f))
+                Switch(checked = skipDupes, onCheckedChange = {
+                    skipDupes = it
+                    prefs.edit().putBoolean("skip_dupes", it).apply()
+                })
+            }
+            Row(
+                Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.SpaceBetween
+            ) {
+                Text(stringResource(R.string.rasi_import_images), Modifier.weight(1f))
+                Switch(checked = images, onCheckedChange = {
+                    images = it
+                    prefs.edit().putBoolean("save_images", it).apply()
+                })
+            }
+
+            // ---- bulk import ----
+            Text(stringResource(R.string.rasi_import_bulk))
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                val blank = split == RasiClipImport.SPLIT_BLANK
+                val blankLabel = stringResource(R.string.rasi_import_split_blank)
+                val lineLabel = stringResource(R.string.rasi_import_split_line)
+                if (blank) Button(onClick = {}) { Text(blankLabel) }
+                else OutlinedButton(onClick = {
+                    split = RasiClipImport.SPLIT_BLANK
+                    prefs.edit().putString("split", split).apply()
+                }) { Text(blankLabel) }
+                if (!blank) Button(onClick = {}) { Text(lineLabel) }
+                else OutlinedButton(onClick = {
+                    split = RasiClipImport.SPLIT_LINE
+                    prefs.edit().putString("split", split).apply()
+                }) { Text(lineLabel) }
+            }
+            OutlinedTextField(
+                value = pasted,
+                onValueChange = { pasted = it; resultText = "" },
+                label = { Text(stringResource(R.string.rasi_import_paste)) },
+                modifier = Modifier.fillMaxWidth().heightIn(min = 160.dp)
+            )
+            val count = RasiClipImport.splitItems(pasted, split).size
+            Text(stringResource(R.string.rasi_import_count, count))
+            Button(
+                enabled = count > 0,
+                onClick = {
+                    val items = RasiClipImport.splitItems(pasted, split)
+                    val n = RasiClipImport.queue(context, items, section)
+                    resultText = context.getString(R.string.rasi_import_done, n, section)
+                    pasted = ""
+                },
+                modifier = Modifier.fillMaxWidth()
+            ) { Text(stringResource(R.string.rasi_import_button)) }
+            if (resultText.isNotEmpty()) Text(resultText)
+            val waiting = if (tick >= 0) RasiClipImport.pendingCount(context) else 0
+            if (waiting > 0) Text(stringResource(R.string.rasi_import_waiting, waiting))
+        }
+    }
