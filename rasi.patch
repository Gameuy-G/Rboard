+package org.futo.inputmethod.latin.rasi
+
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+
+/**
+ * Unicode "fancy font" styles. While a style is selected, letters and digits typed on the
+ * keyboard are committed as the styled characters (like Facemoji's font bar).
+ */
+class RasiFontStyle(val name: String, val map: (Int) -> Int, val combining: Int = 0) {
+    fun apply(text: String): String {
+        val sb = StringBuilder()
+        text.codePoints().forEach { cp ->
+            val m = transformCodePoint(cp)
+            sb.append(m ?: String(Character.toChars(cp)))
+        }
+        return sb.toString()
+    }
+
+    fun transformCodePoint(cp: Int): String? {
+        val isLetterOrDigit = (cp in 'A'.code..'Z'.code) || (cp in 'a'.code..'z'.code) || (cp in '0'.code..'9'.code)
+        if (!isLetterOrDigit) return null
+        val out = StringBuilder()
+        out.appendCodePoint(map(cp))
+        if (combining != 0) out.appendCodePoint(combining)
+        return out.toString()
+    }
+}
+
+object RasiFonts {
+    val barVisibleState = mutableStateOf(false)
+    val selectedState = mutableIntStateOf(0)
+
+    @JvmStatic
+    fun toggleBar() {
+        val show = !barVisibleState.value
+        barVisibleState.value = show
+        if (!show) selectedState.intValue = 0
+    }
+
+    @JvmStatic
+    fun closeBar() {
+        barVisibleState.value = false
+        selectedState.intValue = 0
+    }
+
+    /** Styled text for a typed code point, or null if the keystroke should be handled normally. */
+    @JvmStatic
+    fun transform(codePoint: Int): String? {
+        if (!barVisibleState.value) return null
+        val idx = selectedState.intValue
+        if (idx <= 0 || idx >= styles.size) return null
+        return styles[idx].transformCodePoint(codePoint)
+    }
+
+    private fun block(upper: Int, lower: Int, digit: Int = -1, ex: Map<Int, Int> = emptyMap()): (Int) -> Int = { c ->
+        ex[c] ?: when (c) {
+            in 'A'.code..'Z'.code -> if (upper >= 0) upper + (c - 'A'.code) else c
+            in 'a'.code..'z'.code -> if (lower >= 0) lower + (c - 'a'.code) else c
+            in '0'.code..'9'.code -> if (digit >= 0) digit + (c - '0'.code) else c
+            else -> c
+        }
+    }
+
+    /** 26 letters (same glyphs for upper and lower case), optional 10 digits. */
+    private fun letters(lower26: String, digits: String? = null): (Int) -> Int {
+        val cps = lower26.codePoints().toArray()
+        val dg = digits?.codePoints()?.toArray()
+        return { c ->
+            when (c) {
+                in 'A'.code..'Z'.code -> if (cps.size == 26) cps[c - 'A'.code] else c
+                in 'a'.code..'z'.code -> if (cps.size == 26) cps[c - 'a'.code] else c
+                in '0'.code..'9'.code -> if (dg != null && dg.size == 10) dg[c - '0'.code] else c
+                else -> c
+            }
+        }
+    }
+
+    val styles: List<RasiFontStyle> = listOf(
+        RasiFontStyle("Normal", { it }),
+        RasiFontStyle("Bold", block(0x1D400, 0x1D41A, 0x1D7CE)),
+        RasiFontStyle("Italic", block(0x1D434, 0x1D44E, -1, mapOf('h'.code to 0x210E))),
+        RasiFontStyle("Bold Italic", block(0x1D468, 0x1D482, 0x1D7CE)),
+        RasiFontStyle("Script", block(0x1D4D0, 0x1D4EA, 0x1D7CE)),
+        RasiFontStyle("Fraktur", block(0x1D56C, 0x1D586, 0x1D7CE)),
+        RasiFontStyle("Gothic", block(0x1D504, 0x1D51E, -1, mapOf(
+            'C'.code to 0x212D, 'H'.code to 0x210C, 'I'.code to 0x2111, 'R'.code to 0x211C, 'Z'.code to 0x2128
+        ))),
+        RasiFontStyle("Double", block(0x1D538, 0x1D552, 0x1D7D8, mapOf(
+            'C'.code to 0x2102, 'H'.code to 0x210D, 'N'.code to 0x2115, 'P'.code to 0x2119,
+            'Q'.code to 0x211A, 'R'.code to 0x211D, 'Z'.code to 0x2124
+        ))),
+        RasiFontStyle("Sans", block(0x1D5A0, 0x1D5BA, 0x1D7E2)),
+        RasiFontStyle("Sans Bold", block(0x1D5D4, 0x1D5EE, 0x1D7EC)),
+        RasiFontStyle("Sans Italic", block(0x1D608, 0x1D622, 0x1D7E2)),
+        RasiFontStyle("Sans Bold Italic", block(0x1D63C, 0x1D656, 0x1D7EC)),
+        RasiFontStyle("Mono", block(0x1D670, 0x1D68A, 0x1D7F6)),
+        RasiFontStyle("Wide", block(0xFF21, 0xFF41, 0xFF10)),
+        RasiFontStyle("Bubble", block(0x24B6, 0x24D0, -1, mapOf(
+            '0'.code to 0x24EA, '1'.code to 0x2460, '2'.code to 0x2461, '3'.code to 0x2462, '4'.code to 0x2463,
+            '5'.code to 0x2464, '6'.code to 0x2465, '7'.code to 0x2466, '8'.code to 0x2467, '9'.code to 0x2468
+        ))),
+        RasiFontStyle("Black Bubble", block(0x1F150, 0x1F150)),
+        RasiFontStyle("Square", block(0x1F130, 0x1F130)),
+        RasiFontStyle("Black Square", block(0x1F170, 0x1F170)),
+        RasiFontStyle("Brackets", block(0x249C, 0x249C)),
+        RasiFontStyle("Small Caps", letters("ᴀʙᴄᴅᴇꜰɢʜɪᴊᴋʟᴍɴᴏᴘǫʀꜱᴛᴜᴠᴡxʏᴢ")),
+        RasiFontStyle("Tiny", letters("ᵃᵇᶜᵈᵉᶠᵍʰⁱʲᵏˡᵐⁿᵒᵖᵠʳˢᵗᵘᵛʷˣʸᶻ", "⁰¹²³⁴⁵⁶⁷⁸⁹")),
+        RasiFontStyle("Cool", letters("ᗩᗷᑕᗪEᖴGᕼIᒍKᒪᗰᑎOᑭᑫᖇᔕTᑌᐯᗯᕽYᘔ")),
+        RasiFontStyle("Festival", letters("αв¢∂єƒgнιנкℓмησρqяѕтυνωχуz")),
+        RasiFontStyle("Strike", { it }, 0x0336),
+        RasiFontStyle("Underline", { it }, 0x0332),
+        RasiFontStyle("Slash", { it }, 0x0338),
+        RasiFontStyle("Dotted", { it }, 0x0307),
+        RasiFontStyle("Bold Strike", block(0x1D400, 0x1D41A, 0x1D7CE), 0x0336),
