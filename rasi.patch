+    private val devaFallback = mapOf( // sounds a script lacks fall back to the plain letter
+        0x0916 to 0x0915, 0x0917 to 0x0915, 0x0918 to 0x0915, 0x091B to 0x091A, 0x091D to 0x091C,
+        0x0920 to 0x091F, 0x0921 to 0x091F, 0x0922 to 0x091F, 0x0925 to 0x0924, 0x0926 to 0x0924,
