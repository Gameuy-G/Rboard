+import org.futo.inputmethod.latin.uix.RasiBackupParts
+import org.futo.inputmethod.latin.uix.SettingsExporter
+import org.futo.inputmethod.latin.uix.settings.ScreenTitle
+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+import org.futo.inputmethod.latin.uix.settings.SettingToggleRaw
+
+/** Import: choose which parts of a backup file to bring in. */
+@Composable
+fun RasiImportPickScreen(
+    metadata: SettingsExporter.CfgFileMetadata,
+    present: Set<String>,
+    settingsOnly: Boolean,
+    onApply: (chosen: Set<String>, replace: Boolean) -> Unit,
+    onCancel: () -> Unit
+) {
+    val ctx = LocalContext.current
+    val parts = remember { present.map { RasiBackupParts.forId(ctx, it) } }
+    val chosen = remember { mutableStateMapOf<String, Boolean>().also { m -> parts.forEach { m[it.id] = !it.sensitive } } }
+    var replace by remember { mutableStateOf(!settingsOnly) }
+    var importing by remember { mutableStateOf(false) }
+    val count = chosen.values.count { it }
+
+    ScrollableList {
+        ScreenTitle("Import configuration")
+        if (importing) {
+            Box(Modifier.fillMaxWidth().padding(32.dp)) {
+                CircularProgressIndicator(modifier = Modifier.align(Alignment.Center))
+            }
+            Text("Importing, please wait. Do not close the app.", modifier = Modifier.padding(16.dp, 8.dp))
+            return@ScrollableList
+        }
+        Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            if (metadata.isNewer) Text("Warning: this backup comes from a newer version. Some things may not import.")
+            Text("Backup made: " + metadata.dateExported.toString(), style = MaterialTheme.typography.bodySmall)
+            if (parts.isEmpty()) {
+                Text("Nothing in this file could be recognised.")
+            } else {
+                Text(
+                    "Tick the parts you want to bring in. Parts with keys or account data start switched off.",
+                    style = MaterialTheme.typography.bodySmall
+                )
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    OutlinedButton(onClick = { parts.forEach { chosen[it.id] = true } }) { Text("Select all") }
+                    OutlinedButton(onClick = { parts.forEach { chosen[it.id] = !it.sensitive } }) { Text("Safe ones") }
+                    OutlinedButton(onClick = { parts.forEach { chosen[it.id] = false } }) { Text("None") }
+                }
+            }
+        }
+        SettingToggleRaw(
+            "Replace existing data of chosen parts", replace, { replace = it },
+            subtitle = "On = a chosen part is wiped first, so it ends up exactly like the backup. Off = the backup is merged into what you have."
+        )
+        for (g in 0..3) {
+            val gp = parts.filter { it.group == g }
+            if (gp.isEmpty()) continue
+            Text(
+                RasiBackupParts.groupNames[g], style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.Bold,
+                modifier = Modifier.padding(16.dp, 12.dp, 16.dp, 0.dp)
+            )
+            gp.forEach { p ->
+                SettingToggleRaw(
+                    p.title, chosen[p.id] == true, { chosen[p.id] = it },
+                    subtitle = p.desc + (if (p.sensitive) " Replaces your keys or account data on this phone." else "")
+                )
+            }
+        }
+        Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text(count.toString() + " of " + parts.size + " parts chosen", style = MaterialTheme.typography.bodySmall)
+            Button(enabled = count > 0, onClick = {
+                importing = true
+                onApply(chosen.filter { it.value }.keys.toSet(), replace)
+            }) { Text("Import chosen parts") }
+            OutlinedButton(onClick = onCancel) { Text("Cancel") }
+        }
+    }
+}
