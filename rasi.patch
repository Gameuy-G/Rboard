+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Movie
+import android.graphics.ImageDecoder
+import android.net.Uri
+import android.os.Build
+import android.util.Base64
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.ui.graphics.ImageBitmap
+import androidx.compose.ui.graphics.asImageBitmap
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.SetOptions
+import java.io.ByteArrayOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.File
+import kotlin.math.max
+
+/**
+ * Profile pictures WITHOUT Firebase Storage (free plan): a small JPEG is stored as base64 text in
+ * users/{uid}/media/avatar and users/{uid}/media/banner. The profile doc keeps a version number
+ * (avatarPicV / bannerPicV, 0 = none) so pictures are only downloaded when they changed.
+ * Downloaded pictures are cached in the app cache folder to save the free read quota.
+ */
+/** A picture: one frame (static) or several JPEG frames with delays in ms (GIF). */
+class RasiAnimPic(val frames: List<ImageBitmap>, val delays: IntArray)
+
+class RasiGifResult(val frames: List<ByteArray>, val delays: IntArray, val w: Int, val h: Int)
+
+object RasiPictures {
+    const val AVATAR = "avatar"
+    const val BANNER = "banner"
+
+    val avatarImg = mutableStateOf<RasiAnimPic?>(null)
+    val bannerImg = mutableStateOf<RasiAnimPic?>(null)
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun myUid(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+    private fun dir(c: Context) = File(c.applicationContext.cacheDir, "rasi_pics").also { it.mkdirs() }
+    private fun file(c: Context, uid: String, kind: String, v: Long) = File(dir(c), "${uid}_${kind}_$v.pic")
+
+    /** Reads a picture from the gallery, shrunk so that its longest side is at most maxSide. */
+    fun decodeUri(c: Context, uri: Uri, maxSide: Int): Bitmap? = try {
+        if (Build.VERSION.SDK_INT >= 28) {
+            val src = ImageDecoder.createSource(c.contentResolver, uri)
+            ImageDecoder.decodeBitmap(src) { dec, info, _ ->
+                dec.allocator = ImageDecoder.ALLOCATOR_SOFTWARE
+                val m = max(info.size.width, info.size.height)
+                if (m > maxSide) {
+                    val f = maxSide.toFloat() / m
+                    dec.setTargetSize((info.size.width * f).toInt().coerceAtLeast(1), (info.size.height * f).toInt().coerceAtLeast(1))
+                }
+            }
+        } else {
+            val o = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            c.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, o) }
+            var sample = 1
+            while (max(o.outWidth, o.outHeight) / sample > maxSide * 2) sample *= 2
+            val o2 = BitmapFactory.Options().apply { inSampleSize = sample }
+            c.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, o2) }
+        }
+    } catch (t: Throwable) {
+        RasiLog.fallback("RasiPictures", "Could not read the picture: " + t.javaClass.simpleName); null
+    }
+
+    fun animationAllowed(c: Context): Boolean =
+        RasiAccount.prefs(c).getBoolean("pic_animate", true) && !org.futo.inputmethod.latin.uix.RasiPerf.isOn()
+
+    /** Returns a Movie when the picture is an animated GIF, otherwise null. */
+    fun loadGif(c: Context, uri: Uri): Movie? = try {
+        val bytes = c.contentResolver.openInputStream(uri)?.use { it.readBytes() }
+        if (bytes == null || bytes.size < 6 || String(bytes, 0, 3, Charsets.US_ASCII) != "GIF") null
+        else Movie.decodeByteArray(bytes, 0, bytes.size)?.takeIf { it.duration() > 0 && it.width() > 0 && it.height() > 0 }
+    } catch (t: Throwable) {
+        RasiLog.fallback("RasiPictures", "Could not read the GIF: " + t.javaClass.simpleName); null
+    }
+
+    /** One frame of the GIF at time t, drawn on white, scaled by f. */
+    fun gifFrame(m: Movie, tMs: Int, f: Float): Bitmap {
+        val bmp = Bitmap.createBitmap((m.width() * f).toInt().coerceAtLeast(1), (m.height() * f).toInt().coerceAtLeast(1), Bitmap.Config.ARGB_8888)
+        val cv = Canvas(bmp)
+        cv.drawColor(Color.WHITE)
+        cv.scale(f, f)
+        m.setTime(tMs.coerceIn(0, m.duration()))
+        m.draw(cv, 0f, 0f)
+        return bmp
+    }
+
+    /**
+     * AUTO-FIT for GIFs: r = crop rectangle (x, y, w, h) in GIF pixels. Lowers quality first, then size and
+     * frame count, until all JPEG frames together are at most maxKb. The loop length of the GIF is kept.
+     */
+    fun encodeGif(m: Movie, r: IntArray, w0: Int, h0: Int, maxKb: Int, q0: Int, maxFrames: Int): RasiGifResult? {
+        val dur = m.duration().coerceAtLeast(1)
+        var w = w0; var h = h0; var n = maxFrames.coerceIn(2, 60); var q = q0
+        repeat(16) {
+            val frames = ArrayList<ByteArray>()
+            var total = 0
+            val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+            val cv = Canvas(bmp)
+            for (i in 0 until n) {
+                m.setTime((i.toLong() * dur / n).toInt())
+                cv.drawColor(Color.WHITE)
+                cv.save()
+                cv.scale(w.toFloat() / r[2], h.toFloat() / r[3])
+                cv.translate(-r[0].toFloat(), -r[1].toFloat())
+                m.draw(cv, 0f, 0f)
+                cv.restore()
+                val bos = ByteArrayOutputStream()
+                bmp.compress(Bitmap.CompressFormat.JPEG, q, bos)
+                total += bos.size()
+                frames.add(bos.toByteArray())
+                if (total > maxKb * 1024) break
+            }
+            bmp.recycle()
+            if (frames.size == n && total <= maxKb * 1024) return RasiGifResult(frames, IntArray(n) { (dur / n).coerceAtLeast(40) }, w, h)
+            if (q > 45) q -= 10 else {
+                w = (w * 0.85f).toInt().coerceAtLeast(48); h = (h * 0.85f).toInt().coerceAtLeast(16)
+                n = (n * 0.85f).toInt().coerceAtLeast(2)
+            }
+        }
+        return null
+    }
+
+    private fun pack(frames: List<ByteArray>, delays: IntArray): ByteArray {
+        val bos = ByteArrayOutputStream(); val o = DataOutputStream(bos)
+        o.writeInt(frames.size)
+        frames.forEachIndexed { i, b -> o.writeInt(delays.getOrElse(i) { 0 }); o.writeInt(b.size); o.write(b) }
+        o.flush(); return bos.toByteArray()
+    }
+
+    private fun toPic(c: Context, frames: List<ByteArray>, delays: IntArray): RasiAnimPic? {
+        val all = animationAllowed(c)
+        val bmps = ArrayList<ImageBitmap>()
+        for ((i, b) in frames.withIndex()) {
+            if (i > 0 && !all) break
+            val bm = BitmapFactory.decodeByteArray(b, 0, b.size) ?: return null
+            bmps.add(bm.asImageBitmap())
+        }
+        return if (bmps.isEmpty()) null else RasiAnimPic(bmps, delays)
+    }
+
+    private fun unpack(c: Context, f: File): RasiAnimPic? = try {
+        DataInputStream(f.inputStream().buffered()).use { i ->
+            val n = i.readInt()
+            val frames = ArrayList<ByteArray>(); val delays = IntArray(n)
+            for (k in 0 until n) { delays[k] = i.readInt(); val b = ByteArray(i.readInt()); i.readFully(b); frames.add(b) }
+            toPic(c, frames, delays)
+        }
+    } catch (t: Throwable) { null }
+
+    /** AUTO-FIT: lowers quality, then size, until the JPEG is at most maxKb. */
+    fun encode(src: Bitmap, w: Int, h: Int, maxKb: Int, startQuality: Int): ByteArray? {
+        var cw = w; var ch = h
+        repeat(10) {
+            val scaled = Bitmap.createScaledBitmap(src, cw, ch, true)
+            var q = startQuality
+            var out: ByteArray? = null
+            while (q >= 35 && out == null) {
+                val bos = ByteArrayOutputStream()
+                scaled.compress(Bitmap.CompressFormat.JPEG, q, bos)
+                if (bos.size() <= maxKb * 1024) out = bos.toByteArray()
+                q -= 10
+            }
+            if (scaled !== src) scaled.recycle()
+            if (out != null) return out
+            cw = (cw * 0.85f).toInt().coerceAtLeast(32)
+            ch = (ch * 0.85f).toInt().coerceAtLeast(32)
+        }
+        return null
+    }
+
+    private fun picFields(kind: String, v: Long, use: Boolean): Map<String, Any> =
+        if (kind == AVATAR) mapOf("avatarPicV" to v, "avatarUsePic" to use) else mapOf("bannerPicV" to v, "bannerUsePic" to use)
+
+    /** Static pictures pass one frame and delays = intArrayOf(0). GIFs pass all frames. */
+    fun upload(c: Context, kind: String, frames: List<ByteArray>, delays: IntArray, w: Int, h: Int, done: (Boolean) -> Unit) {
+        val d = db(); val id = myUid()
+        if (d == null || id == null || frames.isEmpty()) { done(false); return }
+        val v = System.currentTimeMillis()
+        val doc = hashMapOf<String, Any>(
+            "data" to Base64.encodeToString(frames[0], Base64.NO_WRAP), "kind" to "jpg", "w" to w, "h" to h, "updatedAt" to v
+        )
+        if (frames.size > 1) {
+            doc["frames"] = frames.drop(1).map { Base64.encodeToString(it, Base64.NO_WRAP) }
+            doc["delays"] = delays.map { it.toLong() }
+            doc["n"] = frames.size
+        }
+        d.collection("users").document(id).collection("media").document(kind).set(doc).addOnSuccessListener {
+            try { file(c, id, kind, v).writeBytes(pack(frames, delays)) } catch (_: Throwable) {}
+            d.collection("users").document(id).set(picFields(kind, v, true), SetOptions.merge()).addOnCompleteListener { t ->
+                if (t.isSuccessful) RasiAccount.loadProfile()
+                done(t.isSuccessful)
+            }
+        }.addOnFailureListener {
+            RasiLog.fallback("RasiPictures", "Could not upload the picture: " + it.javaClass.simpleName); done(false)
+        }
+    }
+
+    fun remove(kind: String, done: (Boolean) -> Unit) {
+        val d = db(); val id = myUid()
+        if (d == null || id == null) { done(false); return }
+        d.collection("users").document(id).collection("media").document(kind).delete().addOnCompleteListener {
+            d.collection("users").document(id).set(picFields(kind, 0L, true), SetOptions.merge()).addOnCompleteListener { t ->
+                if (t.isSuccessful) RasiAccount.loadProfile()
+                done(t.isSuccessful)
+            }
+        }
+    }
+
+    fun setUse(kind: String, on: Boolean) {
+        val d = db(); val id = myUid() ?: return
+        val cur = RasiAccount.profile.value ?: return
+        val v = if (kind == AVATAR) cur.avatarPicV else cur.bannerPicV
+        d?.collection("users")?.document(id)?.set(picFields(kind, v, on), SetOptions.merge())?.addOnSuccessListener { RasiAccount.loadProfile() }
+    }
+
+    /** Loads a picture of any user: cache first, one Firestore read only when it is not cached yet. */
+    fun fetch(c: Context, uid: String, kind: String, v: Long, cb: (RasiAnimPic?) -> Unit) {
+        if (v <= 0L) { cb(null); return }
+        val f = file(c, uid, kind, v)
+        if (f.exists()) { cb(unpack(c, f)); return }
+        val d = db()
+        if (d == null) { cb(null); return }
+        d.collection("users").document(uid).collection("media").document(kind).get().addOnSuccessListener { s ->
+            try {
+                val first = Base64.decode(s.getString("data") ?: "", Base64.NO_WRAP)
+                if (first.isEmpty()) { cb(null); return@addOnSuccessListener }
+                val frames = ArrayList<ByteArray>(); frames.add(first)
+                (s.get("frames") as? List<*>)?.forEach { x -> (x as? String)?.let { frames.add(Base64.decode(it, Base64.NO_WRAP)) } }
+                val dl = (s.get("delays") as? List<*>)?.map { ((it as? Number)?.toInt() ?: 100) } ?: emptyList()
+                val delays = IntArray(frames.size) { dl.getOrElse(it) { 100 } }
+                try {
+                    dir(c).listFiles()?.filter { it.name.startsWith("${uid}_${kind}_") }?.forEach { it.delete() }
+                    f.writeBytes(pack(frames, delays))
+                } catch (_: Throwable) {}
+                cb(toPic(c, frames, delays))
+            } catch (t: Throwable) {
+                RasiLog.fallback("RasiPictures", "Bad picture data: " + t.javaClass.simpleName); cb(null)
+            }
+        }.addOnFailureListener {
+            RasiLog.fallback("RasiPictures", "Could not download a picture: " + it.javaClass.simpleName); cb(null)
+        }
+    }
+
+    /** Fills avatarImg / bannerImg for the signed in user from the loaded profile. */
+    fun refreshOwn(c: Context) {
+        val id = myUid(); val p = RasiAccount.profile.value
+        if (id == null || p == null) { avatarImg.value = null; bannerImg.value = null; return }
+        if (p.avatarUsePic) fetch(c, id, AVATAR, p.avatarPicV) { avatarImg.value = it } else avatarImg.value = null
+        if (p.bannerUsePic) fetch(c, id, BANNER, p.bannerPicV) { bannerImg.value = it } else bannerImg.value = null
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiRoomChat.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiRoomChat.kt
new file mode 100644
