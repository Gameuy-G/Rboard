+        val map = context.getSettingBlocking(ActionsSettings)
+            .toActionEditorItems().ensureWellFormed().toActionMap()
+        val allFavs = (map[ActionCategory.Favorites] ?: listOf()).filter { it.shownInEditor && !(it === RasiKeysAction && !org.futo.inputmethod.latin.rasi.RasiMap.secret) }
+        favs.addAll(allFavs.take(RASI_TOP_MAX))
+        pinned.addAll(map[ActionCategory.PinnedKey] ?: listOf())
+        val base = ((map[ActionCategory.ActionKey] ?: listOf()) +
+                (map[ActionCategory.More] ?: listOf()) +
+                allFavs.drop(RASI_TOP_MAX)).filter { it.shownInEditor && !(it === RasiKeysAction && !org.futo.inputmethod.latin.rasi.RasiMap.secret) }
+        grid.addAll(gridActions(context.getSettingBlocking(RasiGridOrder), base))
+        if (allFavs.size > RASI_TOP_MAX) save()
+    }
+
+    private fun zoneOf(a: Action) = if (favs.contains(a)) favs else if (pinned.contains(a)) pinned else grid
+
+    private fun swap(a: Action, b: Action) {
+        val la = zoneOf(a)
+        val lb = zoneOf(b)
+        val ia = la.indexOf(a)
+        val ib = lb.indexOf(b)
+        la[ia] = b
+        lb[ib] = a
+    }
+
+    private var lastMoveAt = 0L
+
+    fun openSettings(action: Action) {
+        val id = ActionRegistry.actionToStringId(action)
+        val route = action.settingsMenu?.navPath ?: RASI_ACTION_SETTINGS[id]
+        if (route == null) {
+            android.widget.Toast.makeText(context, "This action has no settings", android.widget.Toast.LENGTH_SHORT).show()
+            return
+        }
+        org.futo.inputmethod.latin.uix.settings.SettingsActivity.openToNavDest(context, route)
+    }
+
+    /** While dragging a grid item over the grid, move it live so the others slide aside. */
+    fun liveMove(a: Action) {
+        val p = finger.value
+        if (!grid.contains(a) || !gridBounds.contains(p)) return
+        val now = android.os.SystemClock.uptimeMillis()
+        if (now - lastMoveAt < 220L) return
+        val t = grid.firstOrNull { it != a && rects[it.name]?.contains(p) == true } ?: return
+        val from = grid.indexOf(a)
+        val to = grid.indexOf(t)
+        if (from != to) {
+            grid.removeAt(from)
+            grid.add(to, a)
+            lastMoveAt = now
+        }
+    }
+
+    fun drop() {
+        val a = dragging.value ?: return
+        val p = finger.value
+        dragging.value = null
+        if (grid.contains(a) && gridBounds.contains(p)) {
+            // already moved live while dragging
+            save()
+            return
+        }
+        val target = (favs.toList() + pinned.toList() + grid.toList())
+            .firstOrNull { it != a && rects[it.name]?.contains(p) == true }
+        val bothInGrid = target != null && grid.contains(a) && grid.contains(target)
+        if (pinnedBounds.contains(p) && !pinned.contains(a)) {
+            // Dropped on the pinned slot: take it (the old pinned one goes back to the grid)
+            favs.remove(a)
+            grid.remove(a)
+            if (pinned.isNotEmpty()) grid.add(0, pinned.removeAt(0))
+            pinned.add(a)
+            save()
+            return
+        }
+        val fromOutsideOntoTop = target != null && favs.contains(target) && !favs.contains(a)
+        if (target != null && !bothInGrid && !fromOutsideOntoTop) {
+            // Dropped on another action: they trade places
+            swap(a, target)
+        } else if (topBounds.contains(p)) {
+            if (favs.contains(a)) {
+                val idx = favs.filter { it != a }.count { (rects[it.name]?.center?.x ?: 0f) < p.x }
+                favs.remove(a)
+                favs.add(idx.coerceIn(0, favs.size), a)
+            } else {
+                // Insert where dropped; if the row is full, the far-right one slides out to the
+                // top-left of the grid
+                val idx = favs.count { (rects[it.name]?.center?.x ?: 0f) < p.x }
+                pinned.remove(a)
+                grid.remove(a)
+                favs.add(idx.coerceIn(0, minOf(favs.size, RASI_TOP_MAX - 1)), a)
+                if (favs.size > RASI_TOP_MAX) {
+                    val out = favs.removeAt(favs.size - 1)
+                    grid.add(0, out)
+                }
+            }
+        } else if (gridBounds.contains(p)) {
+            val others = grid.filter { it != a }
+            val nearest = others.minByOrNull { o ->
+                val c = rects[o.name]?.center ?: Offset(1e9f, 1e9f)
+                (c - p).getDistance()
+            }
+            val oldIdx = grid.indexOf(a)
+            val tIdx = if (nearest != null) grid.indexOf(nearest) else -1
+            favs.remove(a)
+            pinned.remove(a)
+            grid.remove(a)
+            if (nearest == null) {
+                grid.add(a)
+            } else {
+                var i = grid.indexOf(nearest)
+                if (oldIdx in 0 until tIdx) i += 1
+                grid.add(i.coerceIn(0, grid.size), a)
+            }
+        } else {
+            return
+        }
+        save()
+    }
+
+    private fun save() {
+        val cur = context.getSettingBlocking(ActionsSettings)
+            .toActionEditorItems().ensureWellFormed().toActionMap().ensureAllCategoriesPresent()
+        val used = (favs + pinned).toSet()
+        val m: Map<ActionCategory, List<Action>> = mapOf(
+            ActionCategory.ActionKey to (cur[ActionCategory.ActionKey] ?: emptyList()).filter { it !in used },
+            ActionCategory.PinnedKey to pinned.toList(),
+            ActionCategory.Favorites to favs.toList(),
+            ActionCategory.More to (cur[ActionCategory.More] ?: emptyList()).filter { it !in used },
+            ActionCategory.Disabled to (cur[ActionCategory.Disabled] ?: emptyList())
+        )
+        context.updateSettingsWithNewActions(m)
+        context.setSettingBlocking(
+            RasiGridOrder.key,
+            grid.joinToString(",") { ActionRegistry.actionToStringId(it) }
+        )
+    }
+}
+
+/** Settings page opened by long-pressing an action that has no settingsMenu of its own. */
+private val RASI_ACTION_SETTINGS = mapOf(
+    "themes" to "themes",
+    "rasi_music_toggle" to "rasiNowPlaying",
+    "rasi_fx_toggle" to "rasiFx",
+    "rasi_media2" to "rasiMedia",
+    "rasi_stickers" to "rasiMedia",
+    "rasi_gifs" to "rasiGifQuality",
+    "rasi_gemini" to "rasiGemini",
+    "rasi_messages" to "rasiChats",
+    "rasi_keys" to "rasiPhonetic",
+    "rasi_mode" to "rasiPhonetic",
+    "voice_input" to "voiceInput",
+    "system_voice_input" to "voiceInput",
+    "switch_language" to "languages",
+    "keyboard_modes" to "keyboardAndTyping",
+    "settings" to "home"
+)
+
+@OptIn(androidx.compose.foundation.ExperimentalFoundationApi::class)
+private fun Modifier.rasiItem(st: RasiGridState, action: Action, view: View, manager: KeyboardManagerForAction): Modifier =
+    if (st.edit.value) this.rasiDrag(st, action, view)
+    else this.combinedClickable(
+        onClick = { manager.activateAction(action) },
+        onLongClick = {
+            view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
+            st.openSettings(action)
+        }
+    )
+
+private fun Modifier.rasiDrag(st: RasiGridState, action: Action, view: View): Modifier =
+    this.pointerInput(action.name) {
+        detectDragGesturesAfterLongPress(
+            onDragStart = { off ->
+                st.dragging.value = action
+                st.finger.value = (st.rects[action.name]?.topLeft ?: Offset.Zero) + off
+                view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
+            },
+            onDrag = { change, _ ->
+                change.consume()
+                st.finger.value = (st.rects[action.name]?.topLeft ?: Offset.Zero) + change.position
+                st.liveMove(action)
+            },
+            onDragEnd = { st.drop() },
+            onDragCancel = { st.dragging.value = null }
+        )
+    }
+
+/**
+ * Gboard-style 4-square menu. The suggestion bar turns into your favourite actions row and the
+ * keyboard turns into the grid of all other actions. Hold and drag an icon between the two
+ * (or inside the grid / row) to rearrange; the result is saved.
+ */
+val RasiGridAction = Action(
+    icon = R.drawable.rasi_grid,
+    name = R.string.rasi_grid_title,
+    simplePressImpl = null,
+    shownInEditor = false,
+    windowImpl = { manager: KeyboardManagerForAction, _ ->
+        val st = RasiGridState(manager.getContext())
+
+        object : ActionWindow() {
+            @Composable
+            override fun windowName(): String = stringResource(R.string.rasi_grid_title)
+
+            @Composable
+            override fun WindowContents(keyboardShown: Boolean) {
+                val view = LocalView.current
+                val gridState = androidx.compose.foundation.lazy.grid.rememberLazyGridState()
+                val edgePx = with(androidx.compose.ui.platform.LocalDensity.current) { 72.dp.toPx() }
+                // Dragging a grid item to the top or bottom edge scrolls the whole list.
+                androidx.compose.runtime.LaunchedEffect(st.dragging.value) {
+                    val d = st.dragging.value ?: return@LaunchedEffect
+                    while (st.dragging.value != null) {
+                        val pt = st.finger.value
+                        val b = st.gridBounds
+                        if (st.grid.contains(d) && b.contains(pt)) {
+                            val step = when {
+                                pt.y < b.top + edgePx -> -((1f - (pt.y - b.top) / edgePx).coerceIn(0.25f, 1f)) * 30f
+                                pt.y > b.bottom - edgePx -> ((1f - (b.bottom - pt.y) / edgePx).coerceIn(0.25f, 1f)) * 30f
+                                else -> 0f
+                            }
+                            if (step != 0f) {
+                                gridState.scrollBy(step)
+                                st.liveMove(d)
+                            }
+                        }
+                        kotlinx.coroutines.delay(16)
+                    }
+                }
+                Box(
+                    Modifier
+                        .fillMaxSize()
+                        .onGloballyPositioned { st.gridBounds = it.boundsInRoot() }
+                ) {
+                    LazyVerticalGrid(
+                        state = gridState,
+                        modifier = Modifier
+                            .fillMaxSize()
+                            .padding(8.dp),
+                        columns = GridCells.Fixed(if (org.futo.inputmethod.latin.uix.rasiCompact()) 4 else 2),
+                        horizontalArrangement = Arrangement.spacedBy(16.dp),
+                        verticalArrangement = Arrangement.spacedBy(16.dp)
+                    ) {
+                        items(st.grid.toList(), key = { it.name }) { action ->
+                            ActionItem(
+                                action,
+                                pill = true,
+                                modifier = Modifier
+                                    .animateItem()
+                                    .alpha(if (st.dragging.value == action) 0.3f else 1f)
+                                    .onGloballyPositioned { st.rects[action.name] = it.boundsInRoot() }
+                                    .rasiItem(st, action, view, manager)
+                            )
+                        }
+                    }
+
+                    val d = st.dragging.value
+                    if (d != null && st.gridBounds.contains(st.finger.value)) {
+                        ActionItem(
+                            d,
+                            pill = true,
+                            modifier = Modifier
+                                .offset {
+                                    IntOffset(
+                                        (st.finger.value.x - st.gridBounds.left).roundToInt() - 85.dp.roundToPx(),
+                                        (st.finger.value.y - st.gridBounds.top).roundToInt() - 30.dp.roundToPx()
+                                    )
+                                }
+                                .width(170.dp)
+                                .alpha(0.9f)
+                        )
+                    }
+                }
+            }
+
+            @Composable
+            override fun WindowTitleBar(rowScope: RowScope) {
+                val view = LocalView.current
+                val context = LocalContext.current
+                with(rowScope) {
+                    Box(
+                        Modifier
+                            .weight(1.0f)
+                            .fillMaxHeight()
+                            .onGloballyPositioned { st.topBounds = it.boundsInRoot() }
+                    ) {
+                        val dragged = st.dragging.value
+                        val overTop = dragged != null && st.topBounds.contains(st.finger.value)
+                        val scheme = LocalKeyboardScheme.current
+                        // While dragging a new action over the row, leave a gap (null) where it will land
+                        val shown: List<Action?> = remember(st.favs.toList(), dragged, overTop, st.finger.value) {
+                            val base = st.favs.toList()
+                            if (dragged != null && overTop && !base.contains(dragged)) {
+                                val idx = base.count { (st.rects[it.name]?.center?.x ?: 0f) < st.finger.value.x }
+                                    .coerceIn(0, minOf(base.size, RASI_TOP_MAX - 1))
+                                base.toMutableList<Action?>().apply { add(idx, null) }
+                            } else base
+                        }
+                        Row(
+                            modifier = Modifier
+                                .fillMaxSize()
+                                .padding(vertical = 2.dp)
+                                .then(
+                                    if (dragged != null)
+                                        Modifier.border(2.dp, scheme.primary, RoundedCornerShape(24.dp))
+                                    else Modifier
+                                )
+                                .padding(horizontal = 3.dp),
+                            verticalAlignment = Alignment.CenterVertically
+                        ) {
+                            shown.forEachIndexed { i, action ->
+                                if (action == null) key("rasi_gap") {
+                                    val gapW = remember { androidx.compose.animation.core.Animatable(0.01f) }
+                                    androidx.compose.runtime.LaunchedEffect(Unit) {
+                                        gapW.animateTo(1f, androidx.compose.animation.core.tween(180))
+                                    }
+                                    Box(
+                                        Modifier.weight(gapW.value.coerceAtLeast(0.01f)).fillMaxHeight()
+                                            .padding(horizontal = 3.dp, vertical = 4.dp)
+                                            .border(1.dp, scheme.primary.copy(alpha = 0.6f), RoundedCornerShape(20.dp))
+                                    )
+                                } else key(action.name) {
+                                    // The far-right one is about to slide out of the row
+                                    val sliding = shown.size > RASI_TOP_MAX && i == shown.size - 1
+                                    Box(
+                                        Modifier
+                                            .weight(1.0f)
+                                            .fillMaxHeight()
+                                            .alpha(if (st.dragging.value == action) 0.3f else if (sliding) 0.35f else 1f)
+                                            .onGloballyPositioned { st.rects[action.name] = it.boundsInRoot() }
+                                            .padding(horizontal = 3.dp, vertical = 4.dp)
+                                            .clip(RoundedCornerShape(20.dp))
+                                            .background(scheme.keyboardContainer)
+                                            .rasiItem(st, action, view, manager),
+                                        contentAlignment = Alignment.Center
+                                    ) {
+                                        Icon(
+                                            painter = painterResource(id = action.icon),
+                                            contentDescription = stringResource(action.name),
+                                            tint = scheme.onKeyboardContainer,
+                                            modifier = Modifier.size(24.dp)
+                                        )
+                                    }
+                                }
+                            }
+                        }
+
+                        val d = st.dragging.value
+                        if (d != null && st.topBounds.contains(st.finger.value)) {
+                            Box(
+                                Modifier
+                                    .offset {
+                                        IntOffset(
+                                            (st.finger.value.x - st.topBounds.left).roundToInt() - 20.dp.roundToPx(),
+                                            (st.finger.value.y - st.topBounds.top).roundToInt() - 20.dp.roundToPx()
+                                        )
+                                    }
+                                    .size(40.dp)
+                                    .background(LocalKeyboardScheme.current.keyboardContainer, CircleShape),
+                                contentAlignment = Alignment.Center
+                            ) {
+                                Icon(
+                                    painter = painterResource(id = d.icon),
+                                    contentDescription = null,
+                                    tint = LocalKeyboardScheme.current.onKeyboardContainer,
+                                    modifier = Modifier.size(24.dp)
+                                )
+                            }
+                        }
+                    }
+
+                    val fgCol = LocalKeyboardScheme.current.onKeyboardContainer
+                    val bgCol = fgCol.copy(alpha = 0.16f)
+                    val circleR = with(LocalDensity.current) { 18.dp.toPx() }
+                    val pinDragging = st.dragging.value != null
+                    Box(
+                        Modifier
+                            .width(42.dp)
+                            .fillMaxHeight()
+                            .onGloballyPositioned { st.pinnedBounds = it.boundsInRoot() }
+                            .padding(vertical = 2.dp)
+                            .then(
+                                if (pinDragging)
+                                    Modifier.border(2.dp, LocalKeyboardScheme.current.primary, RoundedCornerShape(24.dp))
+                                else Modifier
+                            ),
+                        contentAlignment = Alignment.Center
+                    ) {
+                        st.pinned.toList().forEach { action ->
+                            key(action.name) {
+                                Box(
+                                    Modifier
+                                        .width(42.dp)
+                                        .fillMaxHeight()
+                                        .alpha(if (st.dragging.value == action) 0.3f else 1f)
+                                        .onGloballyPositioned { st.rects[action.name] = it.boundsInRoot() }
+                                        .drawBehind { drawCircle(color = bgCol, radius = circleR) }
+                                        .clip(CircleShape)
+                                        .rasiItem(st, action, view, manager),
+                                    contentAlignment = Alignment.Center
+                                ) {
+                                    Icon(
+                                        painter = painterResource(id = action.icon),
+                                        contentDescription = stringResource(action.name),
+                                        tint = fgCol,
+                                        modifier = Modifier.size(20.dp)
+                                    )
+                                }
+                            }
+                        }
+                    }
+                    val editScheme = LocalKeyboardScheme.current
+                    val editOn = st.edit.value
+                    Box(
+                        Modifier
+                            .padding(start = 4.dp, end = 2.dp)
+                            .align(Alignment.CenterVertically)
+                            .size(36.dp)
+                            .clip(CircleShape)
+                            .background(if (editOn) editScheme.primary else bgCol)
+                            .clickable {
+                                st.edit.value = !st.edit.value
+                                view.performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK)
+                            },
+                        contentAlignment = Alignment.Center
+                    ) {
+                        Icon(
+                            painter = painterResource(id = R.drawable.rasi_pencil),
+                            contentDescription = null,
+                            tint = if (editOn) editScheme.onPrimary else fgCol,
+                            modifier = Modifier.size(20.dp)
+                        )
+                    }
+                }
+            }
+
+            override fun close(): org.futo.inputmethod.latin.uix.CloseResult =
+                org.futo.inputmethod.latin.uix.CloseResult.Default
+        }
+    }
+)
