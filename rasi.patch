+                Text(if (isVideo) "VIDEO" else "?")
+            }
+            if (isVideo) {
+                Text("\u25B6", modifier = Modifier.align(Alignment.BottomStart).padding(4.dp))
+            }
+            if (pinned) {
+                Text(
+                    "\uD83D\uDCCC",
+                    fontSize = 14.sp,
+                    modifier = Modifier.align(Alignment.TopEnd).padding(2.dp)
+                )
+            }
+        }
+        Text(
+            name ?: "",
+            fontSize = 12.sp,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            textAlign = TextAlign.Center,
+            modifier = Modifier.fillMaxWidth().height(18.dp)
+        )
+    }
+}
+
+private fun mediaAction(kind: String, nameRes: Int, iconRes: Int, emptyHint: String) = Action(
+    icon = iconRes,
+    name = nameRes,
+    simplePressImpl = null,
+    windowImpl = { manager, _ ->
+        val files = mutableStateListOf<File>()
+        val metaState = mutableStateOf(RasiMedia.Meta())
+
+        object : ActionWindow() {
+            override val showCloseButton: Boolean
+                get() = true
+
+            override val positionIsUserManagable: Boolean
+                get() = false
+
+            override val fixedWindowHeight: androidx.compose.ui.unit.Dp?
+                get() = rasiTallPanelHeight(manager.getContext())
+
+            @Composable
+            override fun windowName(): String = stringResource(nameRes)
+
+            @Composable
+            override fun WindowContents(keyboardShown: Boolean) {
+                val context = LocalContext.current
+                val menuFile = remember { mutableStateOf<File?>(null) }
+                val renameFile = remember { mutableStateOf<File?>(null) }
+                val renameText = remember { mutableStateOf("") }
+                val reorder = remember { mutableStateOf(false) }
+
+                fun refresh() {
+                    val m = RasiMedia.loadMeta(context, kind)
+                    if (m != metaState.value) metaState.value = m
+                    val latest = RasiMedia.sorted(context, kind, m)
+                    if (latest != files.toList()) {
+                        files.clear()
+                        files.addAll(latest)
+                    }
+                }
+
+                fun saveMeta(m: RasiMedia.Meta) {
+                    RasiMedia.saveMeta(context, kind, m)
+                    metaState.value = m
+                    refresh()
+                }
+
+                // Re-check the folder every second so new uploads show up on their own.
+                LaunchedEffect(Unit) {
+                    while (true) {
+                        if (!reorder.value) refresh()
+                        delay(1000)
+                    }
+                }
+
+                Column(Modifier.fillMaxSize()) {
+                Column(Modifier.weight(1.0f).fillMaxWidth().padding(8.dp)) {
+                    val rf = renameFile.value
+                    val mf = menuFile.value
+                    if (rf != null) {
+                        Surface(
+                            color = LocalKeyboardScheme.current.surface,
+                            border = BorderStroke(1.dp, SolidColor(LocalKeyboardScheme.current.outline)),
+                            shape = RoundedCornerShape(8.dp),
+                            modifier = Modifier.fillMaxWidth().height(56.dp),
+                        ) {
+                            Box(Modifier.padding(8.dp), contentAlignment = Alignment.CenterStart) {
+                                ActionTextEditor(
+                                    renameText,
+                                    multiline = false,
+                                    autocorrect = true,
+                                    placeholder = "Name"
+                                )
+                            }
+                        }
+                        Spacer(Modifier.height(8.dp))
+                        Row {
+                            Button(onClick = {
+                                val m = metaState.value
+                                val t = renameText.value.trim()
+                                saveMeta(m.copy(names = if (t.isEmpty()) m.names - rf.name else m.names + (rf.name to t)))
+                                renameFile.value = null
+                            }) { Text("Save") }
+                            Spacer(Modifier.width(8.dp))
+                            OutlinedButton(onClick = { renameFile.value = null }) { Text("Cancel") }
+                        }
+                    } else if (mf != null) {
+                        val pinnedNow = metaState.value.pinned.contains(mf.name)
+                        val opts: List<Pair<String, () -> Unit>> = listOf(
+                            (if (pinnedNow) "Unpin" else "Pin to top") to {
+                                val m = metaState.value
+                                if (pinnedNow) {
+                                    saveMeta(m.copy(pinned = m.pinned - mf.name))
+                                } else {
+                                    saveMeta(m.copy(
+                                        pinned = m.pinned + mf.name,
+                                        order = listOf(mf.name) + m.order.filter { it != mf.name }
+                                    ))
+                                }
+                            },
+                            "Rename" to {
+                                renameText.value = metaState.value.names[mf.name] ?: ""
+                                renameFile.value = mf
+                            },
+                            "Delete" to {
+                                manager.requestDialog(
+                                    "Delete this from your collection?",
+                                    listOf(
+                                        DialogRequestItem("Cancel") { },
+                                        DialogRequestItem("Delete") {
+                                            mf.delete()
+                                            val m = metaState.value
+                                            saveMeta(m.copy(
+                                                names = m.names - mf.name,
+                                                pinned = m.pinned - mf.name,
+                                                order = m.order - mf.name
+                                            ))
+                                        }
+                                    )
+                                ) { }
+                            }
+                        )
+                        RasiHoldMenu(opts, onDismiss = { menuFile.value = null })
+                    } else {
+                        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                            Button(
+                                onClick = {
+                                    val i = Intent(context, RasiPickerActivity::class.java)
+                                    i.putExtra("kind", kind)
+                                    i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                                    context.startActivity(i)
+                                },
+                                modifier = Modifier.weight(1.0f)
+                            ) { Text("+ Add pictures or videos", maxLines = 1) }
+                            if (files.size > 1 || reorder.value) {
+                                Spacer(Modifier.width(8.dp))
+                                if (reorder.value) {
+                                    Button(onClick = { reorder.value = false }) { Text("Done") }
+                                } else {
+                                    OutlinedButton(onClick = { reorder.value = true }) { Text("Reorder") }
+                                }
+                            }
+                        }
+
+                        Spacer(Modifier.height(8.dp))
+
+                        if (files.isEmpty()) {
+                            Text(emptyHint)
+                        } else {
+                            if (reorder.value) {
+                                Text("Long-press one, then drag it", fontSize = 13.sp)
+                                Spacer(Modifier.height(4.dp))
+                            }
+                            val gridState = rememberLazyGridState()
+                            val order = remember(reorder.value) {
+                                mutableStateListOf<File>().apply { addAll(files) }
+                            }
+                            val dragKey = remember { mutableStateOf<String?>(null) }
+                            val dragX = remember { mutableFloatStateOf(0f) }
+                            val dragY = remember { mutableFloatStateOf(0f) }
+                            val shown = if (reorder.value) order.toList() else files.toList()
+
+                            LazyVerticalGrid(
+                                state = gridState,
+                                columns = GridCells.Adaptive(88.dp),
+                                modifier = Modifier.weight(1.0f).fillMaxWidth(),
+                                horizontalArrangement = Arrangement.spacedBy(6.dp),
+                                verticalArrangement = Arrangement.spacedBy(6.dp)
+                            ) {
+                                items(shown, key = { it.name }) { file ->
+                                    val k = file.name
+                                    val isDragging = dragKey.value == k
+                                    val m = metaState.value
+                                    Box(
+                                        Modifier
+                                            .then(
+                                                if (isDragging) Modifier else Modifier.animateItem(
+                                                    placementSpec = androidx.compose.animation.core.spring(
+                                                        dampingRatio = 0.8f, stiffness = 400f
+                                                    )
+                                                )
+                                            )
+                                            .zIndex(if (isDragging) 1f else 0f)
+                                            .graphicsLayer {
+                                                translationX = if (isDragging) dragX.floatValue else 0f
+                                                translationY = if (isDragging) dragY.floatValue else 0f
+                                                val sc = if (isDragging) 1.08f else 1f
+                                                scaleX = sc
+                                                scaleY = sc
+                                                shadowElevation = if (isDragging) 24f else 0f
+                                                alpha = if (isDragging) 0.95f else 1f
+                                            }
+                                    ) {
+                                        MediaThumb(
+                                            file,
+                                            m.names[k],
+                                            m.pinned.contains(k),
+                                            !reorder.value,
+                                            onSend = {
+                                                val mime = RasiMedia.mimeOf(file)
+                                                val id = ClipboardProviderState.addRequest(
+                                                    ClipboardPasteRequest(
+                                                        file = file,
+                                                        mimeType = mime,
+                                                        expiration = System.currentTimeMillis() + 5L * 60L * 1000L
+                                                    )
+                                                )
+                                                val uri = Uri.parse("content://${CLIPBOARD_AUTHORITY}/clip/$id")
+                                                manager.typeUri(uri, listOf(mime), true)
+                                                if (mime == "image/gif") {
+                                                    // GIF sent: close the panel and hide the whole keyboard
+                                                    android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
+                                                        manager.closeActionWindow()
+                                                        manager.getLatinIMEForDebug().requestHideSelf(0)
+                                                    }, 150)
+                                                }
+                                            },
+                                            onHold = { menuFile.value = file }
+                                        )
+                                        if (reorder.value) {
+                                            Box(
+                                                Modifier
+                                                    .matchParentSize()
+                                                    .pointerInput(k) {
+                                                        detectDragGesturesAfterLongPress(
+                                                            onDragStart = {
+                                                                dragKey.value = k
+                                                                dragX.floatValue = 0f
+                                                                dragY.floatValue = 0f
+                                                            },
+                                                            onDrag = { change, amount ->
+                                                                change.consume()
+                                                                dragX.floatValue += amount.x
+                                                                dragY.floatValue += amount.y
+                                                                val visible = gridState.layoutInfo.visibleItemsInfo
+                                                                val me = visible.firstOrNull { it.key == k }
+                                                                if (me != null) {
+                                                                    val cx = me.offset.x + me.size.width / 2f + dragX.floatValue
+                                                                    val cy = me.offset.y + me.size.height / 2f + dragY.floatValue
+                                                                    val pins = metaState.value.pinned
+                                                                    val target = visible.firstOrNull {
+                                                                        it.key != k &&
+                                                                                pins.contains(it.key.toString()) == pins.contains(k) &&
+                                                                                cx >= it.offset.x && cx <= it.offset.x + it.size.width &&
+                                                                                cy >= it.offset.y && cy <= it.offset.y + it.size.height
+                                                                    }
+                                                                    if (target != null) {
+                                                                        val from = order.indexOfFirst { it.name == k }
+                                                                        val to = order.indexOfFirst { it.name == target.key.toString() }
+                                                                        if (from >= 0 && to >= 0 && from != to) {
+                                                                            order.add(to, order.removeAt(from))
+                                                                            dragX.floatValue -= (target.offset.x - me.offset.x)
+                                                                            dragY.floatValue -= (target.offset.y - me.offset.y)
+                                                                        }
+                                                                    }
+                                                                }
+                                                            },
+                                                            onDragEnd = {
+                                                                dragKey.value = null
+                                                                dragX.floatValue = 0f
+                                                                dragY.floatValue = 0f
+                                                                saveMeta(metaState.value.copy(order = order.map { it.name }))
+                                                            },
+                                                            onDragCancel = {
+                                                                dragKey.value = null
+                                                                dragX.floatValue = 0f
+                                                                dragY.floatValue = 0f
+                                                                saveMeta(metaState.value.copy(order = order.map { it.name }))
+                                                            }
+                                                        )
+                                                    }
+                                            )
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                if (!keyboardShown) {
+                    RasiEmojiBottomBar(
+                        selected = 2,
+                        onExit = { manager.closeActionWindow() },
+                        onBackspace = { manager.backspace(1) }
+                    )
+                }
+                }
+            }
+
+            override fun close(): CloseResult = CloseResult.Default
+        }
+    },
+)
