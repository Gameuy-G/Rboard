+private class GiphyItem(val id: String, val previewUrl: String, val gifUrl: String, val ratio: Float)
+
+private const val RECENT_QUERY = "@recent"
+
+/** GIFs you sent lately (newest first), kept on the device so the tab opens on them. */
+private object GifRecents {
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("rasi_klipy", Context.MODE_PRIVATE)
+
+    fun load(context: Context): List<GiphyItem> = try {
+        val arr = org.json.JSONArray(prefs(context).getString("recent_gifs", "[]") ?: "[]")
+        (0 until arr.length()).mapNotNull {
+            val o = arr.optJSONObject(it) ?: return@mapNotNull null
+            GiphyItem(
+                o.optString("id"), o.optString("p"), o.optString("g"),
+                o.optDouble("r", 1.0).toFloat()
+            )
+        }.filter { it.id.isNotEmpty() && it.previewUrl.isNotEmpty() && it.gifUrl.isNotEmpty() }
+    } catch (e: Exception) {
+        emptyList()
+    }
+
+    fun add(context: Context, item: GiphyItem) {
+        val list = (listOf(item) + load(context).filter { it.id != item.id }).take(30)
+        val arr = org.json.JSONArray()
+        list.forEach {
+            arr.put(JSONObject().put("id", it.id).put("p", it.previewUrl).put("g", it.gifUrl).put("r", it.ratio.toDouble()))
+        }
+        prefs(context).edit().putString("recent_gifs", arr.toString()).apply()
+    }
+}
+
+private const val FAV_QUERY = "@favs"
+private const val SEC_PREFIX = "@sec:"
+
+private class SavedGif(val item: GiphyItem, val fav: Boolean, val section: String?)
+
+/** Pinned (favourite) GIFs and named sections, kept on the device. */
+private object GifLibrary {
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("rasi_klipy", Context.MODE_PRIVATE)
+
+    fun sections(context: Context): List<String> = try {
+        val arr = org.json.JSONArray(prefs(context).getString("gif_sections", "[]") ?: "[]")
+        (0 until arr.length()).map { arr.optString(it) }.filter { it.isNotBlank() }
+    } catch (e: Exception) {
+        emptyList()
+    }
+
+    private fun saveSections(context: Context, list: List<String>) {
+        val arr = org.json.JSONArray()
+        list.forEach { arr.put(it) }
+        prefs(context).edit().putString("gif_sections", arr.toString()).apply()
+    }
+
+    fun addSection(context: Context, name: String): String? {
+        val n = name.trim()
+        if (n.isEmpty()) return null
+        val list = sections(context)
+        if (!list.contains(n)) saveSections(context, list + n)
+        return n
+    }
+
+    fun removeSection(context: Context, name: String) {
+        saveSections(context, sections(context).filter { it != name })
+        val updated = load(context).map { if (it.section == name) SavedGif(it.item, it.fav, null) else it }
+        save(context, updated.filter { it.fav || it.section != null })
+    }
+
+    fun load(context: Context): List<SavedGif> = try {
+        val arr = org.json.JSONArray(prefs(context).getString("gif_library", "[]") ?: "[]")
+        (0 until arr.length()).mapNotNull {
+            val o = arr.optJSONObject(it) ?: return@mapNotNull null
+            val item = GiphyItem(o.optString("id"), o.optString("p"), o.optString("g"), o.optDouble("r", 1.0).toFloat())
+            if (item.id.isEmpty() || item.previewUrl.isEmpty() || item.gifUrl.isEmpty()) return@mapNotNull null
+            SavedGif(item, o.optBoolean("f", false), o.optString("s", "").ifEmpty { null })
+        }
+    } catch (e: Exception) {
+        emptyList()
+    }
+
+    private fun save(context: Context, list: List<SavedGif>) {
+        val arr = org.json.JSONArray()
+        list.forEach {
+            arr.put(
+                JSONObject().put("id", it.item.id).put("p", it.item.previewUrl).put("g", it.item.gifUrl)
+                    .put("r", it.item.ratio.toDouble()).put("f", it.fav).put("s", it.section ?: "")
+            )
+        }
+        prefs(context).edit().putString("gif_library", arr.toString()).apply()
+    }
+
+    /** Sets favourite flag and section of a GIF. A GIF that is neither a favourite nor in a section is removed. */
+    fun set(context: Context, item: GiphyItem, fav: Boolean, section: String?) {
+        val rest = load(context).filter { it.item.id != item.id }
+        save(context, if (fav || section != null) listOf(SavedGif(item, fav, section)) + rest else rest)
+    }
+}
