+
+private fun dayKey(ms: Long): Int {
+    val c = java.util.Calendar.getInstance().apply { timeInMillis = ms }
+    return c.get(java.util.Calendar.YEAR) * 400 + c.get(java.util.Calendar.DAY_OF_YEAR)
+}
+
+internal fun chatHm(ms: Long, h24: Boolean): String =
+    java.text.SimpleDateFormat(if (h24) "HH:mm" else "h:mm a", java.util.Locale.getDefault()).format(java.util.Date(ms))
+
+/** "Today at 4:35 AM", "Yesterday at 4:35 AM" or "11/12/2026 4:35 AM". */
+internal fun chatStamp(ms: Long, h24: Boolean): String {
+    val k = dayKey(ms)
+    val now = System.currentTimeMillis()
+    val hm = chatHm(ms, h24)
+    return when (k) {
+        dayKey(now) -> "Today at $hm"
+        dayKey(now - 86400000L) -> "Yesterday at $hm"
+        else -> java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT).format(java.util.Date(ms)) + " " + hm
+    }
+}
