+/** Palette taken from the current cover: hue, saturation and brightness of the two strongest colors. */
+class RasiPalette(val h1: Float, val s1: Float, val h2: Float, val s2: Float, val v1: Float = 0.9f, val v2: Float = 0.9f)
+
+object RasiNowPlayingTheme {
+    private var palArt: Bitmap? = null
+    private var pal: RasiPalette? = null
+
+    private const val BINS = 24
+
+    private var swArt: Bitmap? = null
+    private var swList = IntArray(0)
+
+    /**
+     * Up to 6 distinct, opaque colors of the cover, strongest first. K-means on the pixels, skipping near-white,
+     * near-gray and near-black ones, each pixel weighted by saturation and brightness, so the weight of a color
+     * is its area times how colorful it is. Near duplicates are merged.
+     */
+    fun swatches(art: Bitmap): IntArray {
+        if (art === swArt) return swList
+        swArt = art
+        swList = try { computeSwatches(art) } catch (t: Throwable) { IntArray(0) }
+        return swList
+    }
+
+    private fun computeSwatches(art: Bitmap): IntArray {
+        val sz = 48
+        val small = Bitmap.createScaledBitmap(art.copy(Bitmap.Config.ARGB_8888, false), sz, sz, true)
+        val px = IntArray(sz * sz)
+        small.getPixels(px, 0, sz, 0, 0, sz, sz)
+        val hsv = FloatArray(3)
+        val r = FloatArray(px.size)
+        val g = FloatArray(px.size)
+        val b = FloatArray(px.size)
+        val wt = FloatArray(px.size)
+        var n = 0
+        for (c in px) {
+            if (AColor.alpha(c) < 128) continue
+            AColor.colorToHSV(c, hsv)
+            if (hsv[1] < 0.10f || hsv[2] < 0.12f) continue
+            if (hsv[2] > 0.92f && hsv[1] < 0.15f) continue
+            r[n] = AColor.red(c).toFloat(); g[n] = AColor.green(c).toFloat(); b[n] = AColor.blue(c).toFloat()
+            wt[n] = (0.04f + hsv[1] * hsv[1]) * (0.3f + hsv[2])
+            n++
+        }
+        if (n < 24) return IntArray(0)
+        val k = 6
+        val cr = FloatArray(k); val cg = FloatArray(k); val cb = FloatArray(k)
+        var best = 0
+        for (i in 1 until n) if (wt[i] > wt[best]) best = i
+        cr[0] = r[best]; cg[0] = g[best]; cb[0] = b[best]
+        val minD = FloatArray(n) { Float.MAX_VALUE }
+        for (c in 1 until k) {
+            var bi = 0
+            var bs = -1f
+            for (i in 0 until n) {
+                val dr = r[i] - cr[c - 1]; val dg = g[i] - cg[c - 1]; val db = b[i] - cb[c - 1]
+                val d = dr * dr + dg * dg + db * db
+                if (d < minD[i]) minD[i] = d
+                val sc = minD[i] * wt[i]
+                if (sc > bs) { bs = sc; bi = i }
+            }
+            cr[c] = r[bi]; cg[c] = g[bi]; cb[c] = b[bi]
+        }
+        val sr = FloatArray(k); val sg = FloatArray(k); val sb = FloatArray(k); val sw = FloatArray(k)
+        repeat(8) {
+            java.util.Arrays.fill(sr, 0f); java.util.Arrays.fill(sg, 0f); java.util.Arrays.fill(sb, 0f); java.util.Arrays.fill(sw, 0f)
+            for (i in 0 until n) {
+                var bc = 0
+                var bd = Float.MAX_VALUE
+                for (c in 0 until k) {
+                    val dr = r[i] - cr[c]; val dg = g[i] - cg[c]; val db = b[i] - cb[c]
+                    val d = dr * dr + dg * dg + db * db
+                    if (d < bd) { bd = d; bc = c }
+                }
+                sr[bc] += r[i] * wt[i]; sg[bc] += g[i] * wt[i]; sb[bc] += b[i] * wt[i]; sw[bc] += wt[i]
+            }
+            for (c in 0 until k) if (sw[c] > 0f) { cr[c] = sr[c] / sw[c]; cg[c] = sg[c] / sw[c]; cb[c] = sb[c] / sw[c] }
+        }
+        var total = 0f
+        for (c in 0 until k) total += sw[c]
+        val order = (0 until k).filter { sw[it] > total * 0.04f }.sortedByDescending { sw[it] }
+        val out = ArrayList<Int>()
+        for (c in order) {
+            val col = AColor.rgb(cr[c].toInt().coerceIn(0, 255), cg[c].toInt().coerceIn(0, 255), cb[c].toInt().coerceIn(0, 255))
+            var ok = true
+            for (o in out) {
+                val dr = (AColor.red(o) - AColor.red(col)).toFloat()
+                val dg = (AColor.green(o) - AColor.green(col)).toFloat()
+                val db = (AColor.blue(o) - AColor.blue(col)).toFloat()
+                if (dr * dr + dg * dg + db * db < 3600f) { ok = false; break }
+            }
+            if (ok) out.add(col)
+        }
+        return out.toIntArray()
+    }
+
+    /** Hue/saturation of the two strongest colors, now taken from [swatches]; the old hue-bin method is the fallback. */
+    fun palette(art: Bitmap): RasiPalette? {
+        if (art === palArt) return pal
+        val sw = swatches(art)
+        if (sw.isEmpty()) return legacyPalette(art)
+        val h1 = FloatArray(3)
+        AColor.colorToHSV(sw[0], h1)
+        val np = if (sw.size > 1) {
+            val h2 = FloatArray(3)
+            AColor.colorToHSV(sw[1], h2)
+            RasiPalette(h1[0], h1[1].coerceIn(0.2f, 0.85f), h2[0], h2[1].coerceIn(0.2f, 0.85f), h1[2], h2[2])
+        } else {
+            RasiPalette(h1[0], h1[1].coerceIn(0.2f, 0.85f), (h1[0] + 25f) % 360f, h1[1].coerceIn(0.2f, 0.85f), h1[2], h1[2])
+        }
+        palArt = art
+        pal = np
+        return np
+    }
+
+    private fun legacyPalette(art: Bitmap): RasiPalette? {
+        if (art === palArt) return pal
+        palArt = art
+        pal = try {
+            val small = Bitmap.createScaledBitmap(art.copy(Bitmap.Config.ARGB_8888, false), 40, 40, true)
+            val wt = FloatArray(BINS)
+            val sx = FloatArray(BINS)
+            val sy = FloatArray(BINS)
+            val ss = FloatArray(BINS)
+            val sv = FloatArray(BINS)
+            val hsv = FloatArray(3)
+            for (x in 0 until 40) for (y in 0 until 40) {
+                AColor.colorToHSV(small.getPixel(x, y), hsv)
+                if (hsv[1] < 0.10f || hsv[2] < 0.15f) continue
+                val w = (0.2f + hsv[1]) * (0.3f + hsv[2])
+                val bin = ((hsv[0] / 15f).toInt()).coerceIn(0, BINS - 1)
+                val rad = Math.toRadians(hsv[0].toDouble())
+                wt[bin] += w
+                sx[bin] += (Math.cos(rad) * w).toFloat()
+                sy[bin] += (Math.sin(rad) * w).toFloat()
+                ss[bin] += hsv[1] * w
+                sv[bin] += hsv[2] * w
+            }
+            // a color group is a bin plus its two neighbours, so one hue is not split in two
+            fun grp(b: Int): Float = wt[(b + BINS - 1) % BINS] + wt[b] + wt[(b + 1) % BINS]
+            var b1 = 0
+            for (i in 1 until BINS) if (grp(i) > grp(b1)) b1 = i
+            if (grp(b1) <= 0f) {
+                // gray or very dark cover: neutral palette
+                RasiPalette(0f, 0f, 0f, 0f)
+            } else {
+                // real average hue / saturation / brightness of a group
+                fun avg(b: Int): FloatArray {
+                    var x = 0f; var y = 0f; var w = 0f; var sa = 0f; var va = 0f
+                    for (d in -1..1) {
+                        val k = (b + d + BINS) % BINS
+                        x += sx[k]; y += sy[k]; w += wt[k]; sa += ss[k]; va += sv[k]
+                    }
+                    var h = Math.toDegrees(Math.atan2(y.toDouble(), x.toDouble())).toFloat()
+                    if (h < 0f) h += 360f
+                    return floatArrayOf(h, sa / w, va / w)
+                }
+                val a1 = avg(b1)
+                var b2 = -1
+                for (i in 0 until BINS) {
+                    val d = minOf((i - b1 + BINS) % BINS, (b1 - i + BINS) % BINS)
+                    if (d >= 3 && (b2 < 0 || grp(i) > grp(b2))) b2 = i
+                }
+                val s1 = a1[1].coerceIn(0.2f, 0.85f)
+                if (b2 >= 0 && grp(b2) > grp(b1) * 0.4f) {
+                    val a2 = avg(b2)
+                    RasiPalette(a1[0], s1, a2[0], a2[1].coerceIn(0.2f, 0.85f), a1[2], a2[2])
+                } else {
+                    // no clear second color: stay close to the first one instead of jumping to a far hue
+                    RasiPalette(a1[0], s1, (a1[0] + 25f) % 360f, s1, a1[2], a1[2])
+                }
+            }
+        } catch (t: Throwable) { null }
+        return pal
+    }
+
+    private fun active(c: Context): RasiPalette? {
+        if (!RasiNowPlaying.live(c).getBoolean("mode_dyn", false)) return null
+        RasiSongLooks.customPalette(c)?.let { return it }
+        val art = RasiNowPlaying.track?.art ?: return null
+        return palette(art)
+    }
+
+    /** Liquid glass is on when the general switch is on, or a mode that is on has its glass toggle on. */
+    fun glassOn(c: Context): Boolean {
+        val p = RasiNowPlaying.live(c)
+        return p.getBoolean("glass_all", false) ||
+            (p.getBoolean("mode_bg", false) && p.getBoolean("glass_bg", false)) ||
+            (p.getBoolean("mode_dyn", false) && p.getBoolean("glass_dyn", false)) ||
+            (p.getBoolean("mode_viz", false) && p.getBoolean("glass_viz", false))
+    }
+
+    @Volatile var glassPrimary: Int = AColor.rgb(120, 160, 255)
+    @Volatile var glassTertiary: Int = AColor.rgb(190, 120, 255)
+
+    /** Changes only when the resulting theme would change. */
+    fun key(c: Context): String {
+        val p = active(c)
+        val pr = RasiNowPlaying.live(c)
+        val glass = if (glassOn(c)) "g" + pr.getInt("glass_strength", 60) else "n"
+        val kf = keysKey(c)
+        val tr = if (transOn(c)) "t" + pr.getInt("keys_trans_pct", 40) else "n"
+        val bar = if (behindOn(c)) "w" + pr.getInt("bar_trans", 60) else "n"
+        if (p == null && glass == "n" && kf.isEmpty() && tr == "n" && bar == "n") return "off"
+        val gradient = RasiSongLooks.over(pr).getBoolean("dyn_gradient", false)
+        val pk = if (p == null) "x" else "${p.h1.toInt()}|${(p.s1 * 100).toInt()}|${p.h2.toInt()}"
+        return "$pk|$gradient|$glass|$kf|$tr|$bar"
+    }
+
+    private fun hsv(h: Float, s: Float, v: Float) =
+        Color(AColor.HSVToColor(floatArrayOf(h, s.coerceIn(0f, 1f), v.coerceIn(0f, 1f))))
+
+    fun apply(c: Context, scheme: KeyboardColorScheme): KeyboardColorScheme {
+        val themed = applyKeys(c, applyDynamic(c, scheme))
+        glassPrimary = themed.primary.toArgbCompat()
+        glassTertiary = themed.base.tertiary.toArgbCompat()
+        return when {
+            glassOn(c) -> applyGlass(c, themed)
+            transOn(c) -> applyTrans(c, themed)
+            else -> themed
+        }
+    }
+
+    /** True while something is drawn behind the keyboard bars: song background, visualizer or visual effects. */
+    fun behindOn(c: Context): Boolean {
+        val p = RasiNowPlaying.live(c)
+        return RasiNowPlayingBg.windowMode(c) || p.getBoolean("mode_viz", false) ||
+            RasiNowPlayingViz.fxWanted(c)
+    }
+
+    /** Suggestions bar and actions bar color, see-through while something is drawn behind them. */
+    fun barColor(c: Context, base: Color): Color {
+        if (!behindOn(c)) return base
+        val f = 1f - RasiNowPlaying.live(c).getInt("bar_trans", 60) / 100f
+        return base.copy(alpha = base.alpha * f.coerceIn(0f, 1f))
+    }
+
+    fun transOn(c: Context): Boolean = RasiNowPlaying.live(c).getBoolean("keys_trans", false)
+
+    private fun keysKey(c: Context): String {
+        val pr = RasiNowPlaying.live(c)
+        if (!pr.getBoolean("keys_follow", false)) return ""
+        val art = RasiNowPlaying.track?.art ?: return ""
+        val p = palette(art) ?: return ""
+        return "k" + pr.getString("keys_mode", "tint") + p.h1.toInt() + "|" + (p.s1 * 100).toInt()
+    }
+
+    /** Translucent keys on any theme, so the background and visualizer show through. */
+    private fun applyTrans(c: Context, scheme: KeyboardColorScheme): KeyboardColorScheme {
+        val f = (1f - RasiNowPlaying.live(c).getInt("keys_trans_pct", 40) / 100f).coerceIn(0.05f, 1f)
+        val e = scheme.extended
+        fun a(col: Color) = col.copy(alpha = col.alpha * f)
+        fun ap(col: Color) = col.copy(alpha = (col.alpha * f + 0.25f).coerceAtMost(0.9f))
+        return KeyboardColorScheme(
+            scheme.base,
+            e.copy(
+                keyboardContainer = a(e.keyboardContainer),
+                keyboardContainerVariant = a(e.keyboardContainerVariant),
+                keyboardContainerPressed = ap(e.keyboardContainerPressed),
+                keyboardPress = ap(e.keyboardPress),
+            )
+        )
+    }
+
+    private fun tintColor(col: Color, p: RasiPalette): Color {
+        val hsv = FloatArray(3)
+        AColor.colorToHSV(col.toArgbCompat(), hsv)
+        val sat = (hsv[1] * 0.4f + p.s1 * 0.5f).coerceIn(0f, 1f)
+        return Color(AColor.HSVToColor((col.alpha * 255).toInt(), floatArrayOf(p.h1, sat, hsv[2])))
+    }
+
+    private fun contrastOf(a: Color, b: Color): Float {
+        val l1 = a.luminance(); val l2 = b.luminance()
+        return (max(l1, l2) + 0.05f) / (minOf(l1, l2) + 0.05f)
+    }
+
+    /** Keeps text readable on its background. */
+    private fun readable(fg: Color, bg: Color): Color =
+        if (contrastOf(fg, bg) >= 4.5f) fg else if (bg.luminance() > 0.45f) Color(0xFF111111) else Color.White
+
+    /** "Keys follow the song": works on any theme, including downloaded ones. */
+    private fun applyKeys(c: Context, scheme: KeyboardColorScheme): KeyboardColorScheme {
+        val pr = RasiNowPlaying.live(c)
+        if (!pr.getBoolean("keys_follow", false)) return scheme
+        val art = RasiNowPlaying.track?.art ?: return scheme
+        val p = palette(art) ?: return scheme
+        if (p.s1 == 0f) return scheme // gray cover: keep the theme
+        val e = scheme.extended
+        val b = scheme.base
+        val ne: ExtraColors
+        val nb: ColorScheme
+        if (pr.getString("keys_mode", "tint") == "replace") {
+            val d = applyDynamic(c, scheme, p)
+            ne = e.copy(
+                keyboardContainer = d.keyboardContainer, keyboardContainerVariant = d.keyboardContainerVariant,
+                onKeyboardContainer = d.onKeyboardContainer, keyboardPress = d.keyboardPress,
+                keyboardContainerPressed = d.keyboardContainerPressed, onKeyboardContainerPressed = d.onKeyboardContainerPressed,
+            )
+            nb = b.copy(
+                primary = d.primary, onPrimary = d.onPrimary,
+                primaryContainer = d.primaryContainer, onPrimaryContainer = d.onPrimaryContainer,
+                secondary = d.secondary, secondaryContainer = d.secondaryContainer, onSecondaryContainer = d.onSecondaryContainer,
+            )
+        } else {
+            ne = e.copy(
+                keyboardContainer = tintColor(e.keyboardContainer, p),
+                keyboardContainerVariant = tintColor(e.keyboardContainerVariant, p),
+                keyboardPress = tintColor(e.keyboardPress, p),
+                keyboardContainerPressed = tintColor(e.keyboardContainerPressed, p),
+            )
+            nb = b.copy(
+                primary = tintColor(b.primary, p), primaryContainer = tintColor(b.primaryContainer, p),
+                secondary = tintColor(b.secondary, p), secondaryContainer = tintColor(b.secondaryContainer, p),
+            )
+        }
+        val ne2 = ne.copy(
+            onKeyboardContainer = readable(ne.onKeyboardContainer, ne.keyboardContainer),
+            onKeyboardContainerPressed = readable(ne.onKeyboardContainerPressed, ne.keyboardContainerPressed),
+        )
+        val nb2 = nb.copy(
+            onPrimary = readable(nb.onPrimary, nb.primary),
+            onPrimaryContainer = readable(nb.onPrimaryContainer, nb.primaryContainer),
+            onSecondaryContainer = readable(nb.onSecondaryContainer, nb.secondaryContainer),
+        )
+        return KeyboardColorScheme(nb2, ne2)
+    }
+
+    private fun Color.toArgbCompat(): Int =
+        AColor.argb((alpha * 255).toInt(), (red * 255).toInt(), (green * 255).toInt(), (blue * 255).toInt())
+
+    /** Translucent keys so the glass backdrop shows through. */
+    private fun applyGlass(c: Context, scheme: KeyboardColorScheme): KeyboardColorScheme {
+        val st = RasiNowPlaying.live(c).getInt("glass_strength", 60) / 100f
+        val a = (0.6f - 0.45f * st).coerceIn(0.12f, 0.6f)
+        val e = scheme.extended
+        return KeyboardColorScheme(
+            scheme.base,
+            e.copy(
+                keyboardContainer = e.keyboardContainer.copy(alpha = a),
+                keyboardContainerVariant = e.keyboardContainerVariant.copy(alpha = a * 0.75f),
+                keyboardContainerPressed = e.keyboardContainerPressed.copy(alpha = (a + 0.2f).coerceAtMost(0.85f)),
+                keyboardPress = e.keyboardPress.copy(alpha = (a + 0.2f).coerceAtMost(0.85f)),
+            )
+        )
+    }
+
+    private fun applyDynamic(c: Context, scheme: KeyboardColorScheme, forced: RasiPalette? = null): KeyboardColorScheme {
+        val p = forced ?: active(c) ?: return scheme
+        val gradient = RasiSongLooks.over(RasiNowPlaying.live(c)).getBoolean("dyn_gradient", false)
+        val dark = scheme.keyboardSurface.luminance() < 0.5f
+        val h = p.h1
+        val s = if (p.s1 == 0f) 0f else p.s1
+        val sec = if (p.s2 == 0f) 0f else p.s2
+
+        val surface: Color; val dim: Color; val container: Color; val variant: Color
+        val primary: Color; val onPrimary: Color; val primaryC: Color; val onPrimaryC: Color
+        val onSurface: Color; val press: Color
+        if (dark) {
+            surface = hsv(h, s * 0.55f, 0.11f); dim = hsv(h, s * 0.55f, 0.08f)
+            container = hsv(h, s * 0.45f, 0.24f); variant = hsv(h, s * 0.45f, 0.18f)
+            primary = hsv(h, s * 0.5f, 0.88f); onPrimary = hsv(h, s, 0.15f)
+            primaryC = hsv(h, s * 0.6f, 0.32f); onPrimaryC = hsv(h, 0.15f, 0.95f)
+            onSurface = hsv(h, 0.06f, 0.93f); press = hsv(h, s * 0.5f, 0.38f)
+        } else {
+            surface = hsv(h, s * 0.12f, 0.97f); dim = hsv(h, s * 0.15f, 0.93f)
+            container = hsv(h, s * 0.20f, 0.90f); variant = hsv(h, s * 0.15f, 0.94f)
+            primary = hsv(h, s, 0.45f); onPrimary = Color.White
+            primaryC = hsv(h, s * 0.35f, 0.88f); onPrimaryC = hsv(h, s, 0.20f)
+            onSurface = hsv(h, 0.3f, 0.12f); press = hsv(h, s * 0.35f, 0.80f)
+        }
+        val surface2 = if (dark) hsv(p.h2, sec * 0.55f, 0.16f) else hsv(p.h2, sec * 0.18f, 0.93f)
+        val brush: Brush? = if (gradient) Brush.verticalGradient(listOf(surface, surface2)) else null
+
+        val base = scheme.base.copy(
+            primary = primary, onPrimary = onPrimary,
+            primaryContainer = primaryC, onPrimaryContainer = onPrimaryC,
+            secondary = primary, secondaryContainer = primaryC, onSecondaryContainer = onPrimaryC,
+            background = surface, surface = surface, onSurface = onSurface, onBackground = onSurface,
+            surfaceVariant = variant, onSurfaceVariant = onSurface,
+            surfaceContainer = container, surfaceContainerHigh = container, surfaceContainerHighest = container,
+        )
+        val ext = scheme.extended.copy(
+            keyboardSurface = surface, keyboardSurfaceDim = dim,
+            keyboardContainer = container, keyboardContainerVariant = variant,
+            onKeyboardContainer = onSurface, keyboardPress = press,
+            keyboardBackgroundGradient = brush,
+            primaryTransparent = primary.copy(alpha = 0.3f),
+            onSurfaceTransparent = onSurface.copy(alpha = 0.6f),
+            keyboardContainerPressed = press, onKeyboardContainerPressed = onSurface,
+            // a downloaded theme must not paint its own picture, shader or hint color over the song colors
+            hintColor = null,
+            advancedThemeOptions = scheme.extended.advancedThemeOptions.copy(backgroundShader = null, backgroundImage = null),
+        )
+        return KeyboardColorScheme(base, ext)
+    }
+
+    private fun Color.luminance(): Float = 0.2126f * red + 0.7152f * green + 0.0722f * blue
+}
+
+/** Draws the cover, blurred and dimmed, behind the keys. */
+object RasiNowPlayingBg {
+    private var cache: Bitmap? = null
+    private var cacheKey = ""
+    private val paint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val views = ArrayList<WeakReference<View>>()
+    private var hooked = false
+
+    /** Frees the cached background (when music stops or the phone is short on memory). */
+    fun trim() {
+        cache = null
+        cacheKey = ""
+    }
+
+    private fun register(v: View) {
+        if (views.none { it.get() === v }) views.add(WeakReference(v))
+        if (hooked) return
+        hooked = true
+        RasiNowPlaying.listeners.add {
+            if (RasiNowPlaying.track?.playing != true) trim()
+            val it2 = views.iterator()
+            while (it2.hasNext()) {
+                val x = it2.next().get()
+                if (x == null) it2.remove() else x.postInvalidate()
+            }
+        }
+    }
+
+    /** True when the cover is drawn as one background behind the whole keyboard, bar included. */
+    fun windowMode(c: Context): Boolean =
+        RasiNowPlaying.live(c).getBoolean("mode_bg", false) && RasiNowPlaying.track?.art != null
+
+    fun bitmapFor(art: Bitmap, blur: Int, dim: Int, w: Int, h: Int): Bitmap? {
+        val key = "${System.identityHashCode(art)}|$blur|$dim|$w|$h"
+        if (key != cacheKey) {
+            cache = build(art, blur, dim, w, h)
+            cacheKey = key
+        }
+        return cache
+    }
+
+    fun draw(view: View, canvas: Canvas) {
+        try {
+            val p = RasiSongLooks.over(RasiNowPlaying.live(view.context))
+            if (!p.getBoolean("mode_bg", false)) return
+            register(view)
+            val art = RasiNowPlaying.track?.art ?: return
+            val w = view.width
+            val h = view.height
+            if (w <= 0 || h <= 0) return
+            val blur = p.getInt("bg_blur", 40)
+            val dim = p.getInt("bg_dim", 35)
+            val opacity = p.getInt("bg_opacity", 80)
+            val key = "${System.identityHashCode(art)}|$blur|$dim|$w|$h"
+            if (key != cacheKey) {
+                cache = build(art, blur, dim, w, h)
+                cacheKey = key
+            }
+            val bmp = cache ?: return
+            paint.alpha = (255 * opacity / 100).coerceIn(0, 255)
+            canvas.drawBitmap(bmp, 0f, 0f, paint)
+        } catch (t: Throwable) {
+        }
+    }
+
+    private fun build(art: Bitmap, blur: Int, dim: Int, w: Int, h: Int): Bitmap? {
+        // only copy when needed (hardware bitmaps cannot be scaled directly)
+        val src = if (art.config == Bitmap.Config.HARDWARE) (art.copy(Bitmap.Config.ARGB_8888, false) ?: return null) else art
+        val longSide = (320f - (320f - 10f) * blur / 100f).coerceAtLeast(8f)
+        val k = longSide / max(src.width, src.height)
+        val small = Bitmap.createScaledBitmap(
+            src, max(1, (src.width * k).toInt()), max(1, (src.height * k).toInt()), true
+        )
+        val out = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+        val c = Canvas(out)
+        val scale = max(w.toFloat() / small.width, h.toFloat() / small.height)
+        val dw = small.width * scale
+        val dh = small.height * scale
+        val dst = RectF((w - dw) / 2f, (h - dh) / 2f, (w + dw) / 2f, (h + dh) / 2f)
+        c.drawBitmap(small, null, dst, Paint(Paint.FILTER_BITMAP_FLAG))
+        if (dim > 0) c.drawColor(AColor.argb((255 * dim / 100).coerceIn(0, 255), 0, 0, 0))
+        return out
+    }
+}
+
+/** Soft glass backdrop and top sheen, painted behind the keys. Static, so it costs nothing while idle. */
+object RasiNowPlayingGlass {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    fun draw(view: View, canvas: Canvas) {
+        try {
+            val c = view.context
+            if (!RasiNowPlayingTheme.glassOn(c)) return
+            val p = RasiNowPlaying.live(c)
+            val w = view.width.toFloat()
+            val h = view.height.toFloat()
+            if (w <= 0f || h <= 0f) return
+            val st = p.getInt("glass_strength", 60) / 100f
+            // with the cover as background the cover itself is the glass backdrop
+            val hasCover = p.getBoolean("mode_bg", false) && RasiNowPlaying.track?.art != null
+            if (!hasCover) {
+                blob(canvas, w * 0.15f, h * 0.2f, w * 0.55f, RasiNowPlayingTheme.glassPrimary, 0.45f * st + 0.15f)
+                blob(canvas, w * 0.85f, h * 0.55f, w * 0.5f, RasiNowPlayingTheme.glassTertiary, 0.4f * st + 0.12f)
+                blob(canvas, w * 0.4f, h * 1.0f, w * 0.6f, RasiNowPlayingTheme.glassPrimary, 0.3f * st + 0.1f)
+            }
+            paint.shader = android.graphics.LinearGradient(
+                0f, 0f, 0f, h * 0.45f,
+                intArrayOf(AColor.argb((40 + 50 * st).toInt(), 255, 255, 255), AColor.argb(0, 255, 255, 255)),
+                null, Shader.TileMode.CLAMP
+            )
+            canvas.drawRect(0f, 0f, w, h * 0.45f, paint)
+            paint.shader = null
+        } catch (t: Throwable) {
+        }
+    }
+
+    private fun blob(canvas: Canvas, cx: Float, cy: Float, r: Float, color: Int, alpha: Float) {
+        val a = (255 * alpha).toInt().coerceIn(0, 255)
+        paint.shader = RadialGradient(
+            cx, cy, r,
+            intArrayOf(AColor.argb(a, AColor.red(color), AColor.green(color), AColor.blue(color)),
+                AColor.argb(0, AColor.red(color), AColor.green(color), AColor.blue(color))),
+            null, Shader.TileMode.CLAMP
+        )
+        canvas.drawCircle(cx, cy, r, paint)
+        paint.shader = null
+    }
+}
