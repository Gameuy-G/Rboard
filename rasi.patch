+private val MENTION = Regex("@[\\p{L}\\p{N}_]+")
+
+private fun mentionKeys(names: List<String>): List<String> =
+    names.filter { it.isNotBlank() }.map { "@" + it.replace(" ", "").lowercase() }
+
+/** True when the text contains an @mention of one of these names. */
+internal fun pingsOf(text: String, names: List<String>): Boolean {
+    val keys = mentionKeys(names)
+    return MENTION.findAll(text).any { keys.contains(it.value.lowercase()) }
+}
+
+internal fun mentionText(text: String, c: ChatCtx, m: RasiChats.Msg, tagColor: Color): AnnotatedString = buildAnnotatedString {
+    val keys = mentionKeys(c.mentionNames)
+    var i = 0
+    if (c.look.pingOn) {
+        for (r in MENTION.findAll(text)) {
+            if (!keys.contains(r.value.lowercase())) continue
+            append(text.substring(i, r.range.first))
+            withStyle(SpanStyle(background = c.look.pingColor.copy(alpha = 0.3f), fontWeight = FontWeight.Bold)) { append(r.value) }
+            i = r.range.last + 1
+        }
+    }
+    append(text.substring(i))
+    if (m.editedAt > 0L && c.look.editTag) withStyle(SpanStyle(fontSize = 11.sp, color = tagColor)) { append(" (edited)") }
+}
