--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/settings/pages/RasiGeminiScreen.kt
@@ -0,0 +1,201 @@
+package org.futo.inputmethod.latin.uix.settings.pages
+
+import androidx.compose.animation.AnimatedVisibility
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.horizontalScroll
+import androidx.compose.material3.AssistChip
+import androidx.compose.material3.Button
+import androidx.compose.material3.FilterChip
+import androidx.compose.material3.OutlinedButton
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.input.PasswordVisualTransformation
+import androidx.compose.ui.unit.dp
+import androidx.navigation.NavHostController
+import androidx.navigation.compose.rememberNavController
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.futo.inputmethod.latin.R
+import org.futo.inputmethod.latin.uix.actions.RasiGallery
+import org.futo.inputmethod.latin.uix.actions.RasiGeminiStore
+import org.futo.inputmethod.latin.uix.settings.ScreenTitle
+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+
+private val personaPresets = listOf(
+    "Short answers" to "Answer in one or two short sentences. No markdown, no lists.",
+    "Friendly" to "Be warm, casual and friendly. Keep answers brief and use plain text without markdown.",
+    "Writing helper" to "Help me write and rewrite text. Reply only with the text I can paste, no explanations.",
+    "Translator" to "Translate whatever I send into English unless I name another language. Reply only with the translation.",
+    "Teacher" to "Explain things simply, step by step, like a patient teacher. Keep it concise."
+)
+
+@OptIn(androidx.compose.material3.ExperimentalMaterial3Api::class)
+@Composable
+fun RasiGeminiScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var key by remember { mutableStateOf(RasiGeminiStore.key(context)) }
+    var model by remember { mutableStateOf(RasiGeminiStore.model(context)) }
+    var persona by remember { mutableStateOf(RasiGeminiStore.persona(context)) }
+    var saved by remember { mutableStateOf(false) }
+    var models by remember { mutableStateOf(listOf<String>()) }
+    var loading by remember { mutableStateOf(false) }
+    var loadError by remember { mutableStateOf("") }
+
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.rasi_gemini_title), showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(stringResource(R.string.rasi_gemini_hint))
+            OutlinedTextField(
+                value = key,
+                onValueChange = { key = it; saved = false },
+                label = { Text(stringResource(R.string.rasi_gemini_key)) },
+                singleLine = true,
+                visualTransformation = PasswordVisualTransformation(),
+                modifier = Modifier.fillMaxWidth()
+            )
+            OutlinedButton(onClick = {
+                try {
+                    context.startActivity(
+                        android.content.Intent(
+                            android.content.Intent.ACTION_VIEW,
+                            android.net.Uri.parse("https://aistudio.google.com/apikey")
+                        ).addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK)
+                    )
+                } catch (e: Exception) { }
+            }) {
+                Text(stringResource(R.string.rasi_gemini_getkey))
+            }
+
+            OutlinedButton(onClick = { navController.navigate("rasiGeminiTheme") }, modifier = Modifier.fillMaxWidth()) {
+                Text("Gemini theme")
+            }
+
+            // One-time gallery permission (a keyboard cannot show the permission prompt itself)
+            val galleryCtx = LocalContext.current
+            var galleryAccess by remember { mutableStateOf(RasiGallery.hasAccess(galleryCtx)) }
+            val galleryAsk = androidx.activity.compose.rememberLauncherForActivityResult(
+                androidx.activity.result.contract.ActivityResultContracts.RequestMultiplePermissions()
+            ) { galleryAccess = RasiGallery.hasAccess(galleryCtx) }
+            androidx.compose.runtime.DisposableEffect(galleryCtx) {
+                val lc = (galleryCtx as? androidx.lifecycle.LifecycleOwner)?.lifecycle
+                val obs = androidx.lifecycle.LifecycleEventObserver { _, e ->
+                    if (e == androidx.lifecycle.Lifecycle.Event.ON_RESUME) galleryAccess = RasiGallery.hasAccess(galleryCtx)
+                }
+                lc?.addObserver(obs)
+                onDispose { lc?.removeObserver(obs) }
+            }
+            val fullVideo = RasiGallery.hasFullVideoAccess(galleryCtx)
+            Text("Gallery picker inside Gemini: " + if (galleryAccess) (if (fullVideo) "allowed (photos and videos)" else "limited, videos may be missing") else "not allowed yet")
+            if (!galleryAccess || !fullVideo) {
+                Button(onClick = { galleryAsk.launch(RasiGallery.permissions()) }, modifier = Modifier.fillMaxWidth()) {
+                    Text("Allow access to photos and videos")
+                }
+                OutlinedButton(onClick = {
+                    galleryCtx.startActivity(
+                        android.content.Intent(
+                            android.provider.Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
+                            android.net.Uri.parse("package:" + galleryCtx.packageName)
+                        )
+                    )
+                }, modifier = Modifier.fillMaxWidth()) { Text("Open app settings") }
+            }
+
+            Text(stringResource(R.string.rasi_gemini_model))
+            Row(
+                Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                FilterChip(
+                    selected = model == "gemini-flash-latest",
+                    onClick = { model = "gemini-flash-latest"; saved = false },
+                    label = { Text("Latest Flash (default)") }
+                )
+                FilterChip(
+                    selected = model == "gemini-pro-latest",
+                    onClick = { model = "gemini-pro-latest"; saved = false },
+                    label = { Text("Latest Pro") }
+                )
+                FilterChip(
+                    selected = model == "gemini-flash-lite-latest",
+                    onClick = { model = "gemini-flash-lite-latest"; saved = false },
+                    label = { Text("Latest Flash-Lite") }
+                )
+            }
+            OutlinedButton(enabled = key.isNotBlank() && !loading, onClick = {
+                loading = true
+                loadError = ""
+                scope.launch {
+                    try {
+                        models = withContext(Dispatchers.IO) { RasiGeminiStore.listModels(key.trim()) }
+                    } catch (e: Exception) {
+                        loadError = "Could not load models: " + e.message
+                    }
+                    loading = false
+                }
+            }) {
+                Text(if (loading) "Loading..." else "Load all available models")
+            }
+            if (loadError.isNotEmpty()) Text(loadError)
+            AnimatedVisibility(visible = models.isNotEmpty()) {
+                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                    models.forEach { m ->
+                        FilterChip(
+                            selected = model == m,
+                            onClick = { model = m; saved = false },
+                            label = { Text(m) }
+                        )
+                    }
+                }
+            }
+            OutlinedTextField(
+                value = model,
+                onValueChange = { model = it; saved = false },
+                label = { Text("Selected model") },
+                singleLine = true,
+                modifier = Modifier.fillMaxWidth()
+            )
+
+            Text("How should Gemini act? (personality and instructions)")
+            Row(
+                Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                personaPresets.forEach { (name, text) ->
+                    AssistChip(onClick = { persona = text; saved = false }, label = { Text(name) })
+                }
+            }
+            OutlinedTextField(
+                value = persona,
+                onValueChange = { persona = it; saved = false },
+                label = { Text("Instructions (optional)") },
+                minLines = 3,
+                maxLines = 8,
+                modifier = Modifier.fillMaxWidth()
+            )
+
+            Button(onClick = {
+                RasiGeminiStore.save(context, key, model, persona)
+                saved = true
+            }) {
+                Text(stringResource(if (saved) R.string.rasi_gemini_saved else R.string.rasi_gemini_save))
+            }
+        }
+    }
+}
