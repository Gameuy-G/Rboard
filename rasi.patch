+/** Full text of a clip, scrollable. The scrollbar is hidden until you scroll, then fades out again. */
+@Composable
+fun RasiScrollPreviewCard(
+    modifier: Modifier,
+    text: String,
+    autoHide: Boolean,
+    hideDelayMs: Int,
+    barWidthDp: Int
+) {
+    val scheme = LocalKeyboardScheme.current
+    val st = rememberScrollState()
+    var barOn by remember { mutableStateOf(!autoHide) }
+    androidx.compose.runtime.LaunchedEffect(st.isScrollInProgress, autoHide, hideDelayMs) {
+        if (!autoHide || st.isScrollInProgress) {
+            barOn = true
+        } else {
+            kotlinx.coroutines.delay(hideDelayMs.toLong())
+            barOn = false
+        }
+    }
+    val perf = org.futo.inputmethod.latin.uix.RasiPerf.isOn()
+    val barAlpha by androidx.compose.animation.core.animateFloatAsState(
+        if (barOn) 1f else 0f,
+        androidx.compose.animation.core.tween(if (perf) 0 else 220),
+        label = "holdScrollbar"
+    )
+    val barColor = scheme.onKeyboardContainer
+    Surface(
+        color = scheme.keyboardContainer,
+        contentColor = scheme.onKeyboardContainer,
+        shape = RoundedCornerShape(16.dp),
+        modifier = modifier.padding(2.dp)
+    ) {
+        Text(
+            text,
+            modifier = Modifier
+                .drawWithContent {
+                    drawContent()
+                    val max = st.maxValue
+                    if (barAlpha > 0f && max > 0 && max != Int.MAX_VALUE) {
+                        val h = size.height
+                        val thumbH = (h * h / (h + max)).coerceAtLeast(24.dp.toPx()).coerceAtMost(h)
+                        val y = (st.value.toFloat() / max) * (h - thumbH)
+                        val w = barWidthDp.dp.toPx()
+                        drawRoundRect(
+                            color = barColor.copy(alpha = 0.55f * barAlpha),
+                            topLeft = androidx.compose.ui.geometry.Offset(size.width - w - 3.dp.toPx(), y),
+                            size = androidx.compose.ui.geometry.Size(w, thumbH),
+                            cornerRadius = androidx.compose.ui.geometry.CornerRadius(w / 2f)
+                        )
+                    }
+                }
+                .verticalScroll(st)
+                .padding(start = 12.dp, end = 14.dp, top = 12.dp, bottom = 12.dp)
+        )
+    }
+}
+
+/** Gboard-style "1 item deleted  Undo" pill. Tap anywhere on it to undo. */
+@Composable
+fun RasiUndoSnackbar(count: Int, pending: Any, modifier: Modifier, onUndo: () -> Unit, onExpire: () -> Unit) {
+    val scheme = LocalKeyboardScheme.current
+    val dragY = remember { androidx.compose.runtime.mutableFloatStateOf(0f) }
+    androidx.compose.runtime.LaunchedEffect(pending) {
+        dragY.floatValue = 0f
+        kotlinx.coroutines.delay(4500)
+        onExpire()
+    }
+    val density = androidx.compose.ui.platform.LocalDensity.current
+    val limit = with(density) { 36.dp.toPx() }
+    Row(
+        modifier
+            .graphicsLayer {
+                translationY = dragY.floatValue.coerceAtLeast(0f)
+                alpha = (1f - dragY.floatValue.coerceAtLeast(0f) / (limit * 3f)).coerceIn(0f, 1f)
+            }
+            .pointerInput(pending) {
+                detectVerticalDragGestures(
+                    onDragEnd = {
+                        if (dragY.floatValue > limit) onExpire() else dragY.floatValue = 0f
+                    },
+                    onDragCancel = { dragY.floatValue = 0f },
+                    onVerticalDrag = { _, d -> dragY.floatValue += d }
+                )
+            }
+            .clip(RoundedCornerShape(28.dp))
+            .background(scheme.onKeyboardContainer)
+            .padding(start = 24.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Text(if (count == 1) "1 item deleted" else "$count items deleted", color = scheme.keyboardContainer)
+        Text(
+            "Undo",
+            color = scheme.primary,
+            modifier = Modifier
+                .clip(RoundedCornerShape(24.dp))
+                .clickable { onUndo() }
+                .padding(horizontal = 20.dp, vertical = 14.dp)
+        )
+    }
+}
