+private fun httpGet(url: String): String {
+    val conn = URL(url).openConnection() as HttpURLConnection
+    conn.connectTimeout = 10000
+    conn.readTimeout = 15000
+    try {
+        if (conn.responseCode != 200) throw Exception("HTTP " + conn.responseCode)
+        return conn.inputStream.bufferedReader().use { it.readText() }
+    } finally {
+        conn.disconnect()
+    }
+}
+
+private fun klipyUrl(file: JSONObject?, size: String): String =
+    file?.optJSONObject(size)?.optJSONObject("gif")?.optString("url").orEmpty()
+
+private fun giphyFetch(key: String, customerId: String, query: String): List<GiphyItem> {
+    val base = "https://api.klipy.com/api/v1/" + URLEncoder.encode(key, "UTF-8").replace("+", "%20") + "/gifs/"
+    val common = "page=1&per_page=24&customer_id=" + URLEncoder.encode(customerId, "UTF-8")
+    val url = if (query.isBlank()) {
+        base + "trending?" + common
+    } else {
+        base + "search?q=" + URLEncoder.encode(query, "UTF-8") + "&" + common
+    }
+    val root = JSONObject(httpGet(url))
+    val dataObj = root.optJSONObject("data")
+    val data = dataObj?.optJSONArray("data") ?: root.optJSONArray("data")
+        ?: return emptyList()
+    val out = ArrayList<GiphyItem>()
+    for (i in 0 until data.length()) {
+        val o = data.optJSONObject(i) ?: continue
+        val file = o.optJSONObject("file") ?: continue
+        val preview = klipyUrl(file, "sm").ifEmpty { klipyUrl(file, "md") }
+            .ifEmpty { klipyUrl(file, "xs") }
+        val gif = klipyUrl(file, "md").ifEmpty { klipyUrl(file, "hd") }
+            .ifEmpty { klipyUrl(file, "sm") }
+        if (preview.isNotEmpty() && gif.isNotEmpty()) {
+            val id = o.optString("slug", "").ifEmpty { o.optString("id", gif.hashCode().toString()) }
+            val dims = file.optJSONObject("md")?.optJSONObject("gif")
+                ?: file.optJSONObject("sm")?.optJSONObject("gif")
+            val w = dims?.optDouble("width", 0.0) ?: 0.0
+            val h = dims?.optDouble("height", 0.0) ?: 0.0
+            val ratio = if (w > 0.0 && h > 0.0) (w / h).toFloat().coerceIn(0.4f, 2.5f) else 1.0f
+            if (out.none { it.id == id }) out.add(GiphyItem(id, preview, gif, ratio))
+        }
+    }
+    return out
+}
+
+private fun downloadGif(context: Context, item: GiphyItem): File {
+    val file = File(context.cacheDir, "klipy_" + item.id + ".gif")
+    if (!file.exists() || file.length() == 0L) {
+        val conn = URL(item.gifUrl).openConnection() as HttpURLConnection
+        conn.connectTimeout = 10000
+        conn.readTimeout = 30000
+        try {
+            conn.inputStream.use { input -> file.outputStream().use { input.copyTo(it) } }
+        } finally {
+            conn.disconnect()
+        }
+    }
+    return file
+}
