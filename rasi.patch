+import org.futo.inputmethod.latin.uix.settings.ScreenTitle
+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+import org.futo.inputmethod.latin.uix.settings.SettingToggleRaw
+
+private fun matchesFilter(level: Char, filter: Int): Boolean = when (filter) {
+    1 -> level == 'W' || level == 'E' || level == 'C'
+    2 -> level == 'N' || level == 'F'
+    else -> true
+}
+
+@Composable
+fun RasiLogScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    remember { RasiLog.init(context); 0 }
+    val version = RasiLog.version.intValue
+    var filter by remember { mutableIntStateOf(0) }
+    var enabled by remember { mutableStateOf(RasiLog.enabled()) }
+    var persist by remember { mutableStateOf(RasiLog.persist()) }
+    var info by remember { mutableStateOf(RasiLog.infoToo()) }
+    var maxF by remember { mutableFloatStateOf(RasiLog.maxEntries().toFloat()) }
+
+    val all = remember(version) { RasiLog.snapshot() }
+    val shown = remember(version, filter) {
+        all.filter { matchesFilter(it.level, filter) }.asReversed().take(300)
+    }
+
+    ScrollableList {
+        ScreenTitle("Log", showBack = true, navController)
+        Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text("Errors, network failures, fallbacks and caught crashes from Rboard. It never contains what you type. Newest first.")
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                RasiTextButton(onClick = {
+                    context.copyToClipboard(RasiLog.asText(shown.asReversed()), "Rboard log")
+                    Toast.makeText(context, "Log copied", Toast.LENGTH_SHORT).show()
+                }) { Text("Copy") }
+                RasiTextButton(onClick = {
+                    RasiLog.clear()
+                    Toast.makeText(context, "Log cleared", Toast.LENGTH_SHORT).show()
+                }) { Text("Clear") }
+            }
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                listOf("All", "Problems", "Network").forEachIndexed { idx, name ->
+                    RasiTextButton(onClick = { filter = idx }) {
+                        Text(name, fontWeight = if (filter == idx) FontWeight.Bold else FontWeight.Normal)
+                    }
+                }
+            }
+            Text(
+                when (filter) {
+                    1 -> "Showing warnings, errors and crashes (${shown.size})"
+                    2 -> "Showing network failures and fallbacks (${shown.size})"
+                    else -> "Showing everything (${shown.size})"
+                }
+            )
+        }
+
+        SettingToggleRaw(
+            title = "Record the log",
+            subtitle = "On: Rboard writes problems into this log. Off: nothing new is recorded (crashes are always recorded)",
+            enabled = enabled,
+            setValue = { enabled = it; RasiLog.setBool(RasiLog.KEY_ENABLED, it) }
+        )
+        SettingToggleRaw(
+            title = "Keep the log after a restart",
+            subtitle = "On: the log is saved in a private file, so a crash can still be read afterwards. Off: it only lives until the app closes",
+            enabled = persist,
+            setValue = { persist = it; RasiLog.setBool(RasiLog.KEY_PERSIST, it) }
+        )
+        SettingToggleRaw(
+            title = "Also record info messages",
+            subtitle = "On: adds harmless notes about what Rboard is doing (more lines). Off: only problems are recorded",
+            enabled = info,
+            setValue = { info = it; RasiLog.setBool(RasiLog.KEY_INFO, it) }
+        )
+        Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp)) {
+            Text("How many entries to keep: ${maxF.toInt()}")
+            Text("The oldest entries are dropped when the log is full")
+            Slider(
+                value = maxF,
+                onValueChange = { maxF = it },
+                onValueChangeFinished = { RasiLog.setMax(maxF.toInt()) },
+                valueRange = 100f..1000f,
+                steps = 8
+            )
+        }
+
+        Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            if (shown.isEmpty()) {
+                Text("Nothing here. That is good news.")
+            }
+            shown.forEach { e ->
+                Column {
+                    val bad = e.level == 'E' || e.level == 'C'
+                    Text(
+                        RasiLog.timeText(e.time) + "  " + RasiLog.label(e.level) + "  " + e.tag,
+                        fontSize = 11.sp,
+                        fontWeight = FontWeight.Bold,
+                        color = if (bad) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurfaceVariant
+                    )
+                    Text(e.msg, fontSize = 12.sp, fontFamily = FontFamily.Monospace)
+                }
+            }
+        }
+    }
+}
