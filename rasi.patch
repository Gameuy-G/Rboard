+/** A private @gemini answer shown inside the chat (only on this phone, not stored). */
+internal class GemItem(val id: Long, val question: String) {
+    var answer by mutableStateOf<String?>(null)
+    var error by mutableStateOf<String?>(null)
+}
+
+internal fun gemQuestion(t: String): String? =
+    Regex("^\\s*@gemini\\b[:,]?\\s*(.*)$", setOf(RegexOption.IGNORE_CASE, RegexOption.DOT_MATCHES_ALL)).find(t)?.groupValues?.get(1)?.trim()
+
+@Composable
+internal fun GemCard(g: GemItem, size: Int, onSend: (String) -> Unit, onCopy: (String) -> Unit, onClose: () -> Unit) {
+    Column(Modifier.fillMaxWidth().padding(vertical = 6.dp).clip(RoundedCornerShape(14.dp))
+        .background(MaterialTheme.colorScheme.secondaryContainer.copy(alpha = 0.85f)).padding(12.dp)) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            ChatAv("\u2726", GEM_COLOR, 28, false)
+            Spacer(Modifier.width(8.dp))
+            Text("Gemini (only you see this)", fontSize = 12.sp, fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.onSecondaryContainer)
+        }
+        Text("You asked: " + g.question, fontSize = 12.sp, maxLines = 2, overflow = TextOverflow.Ellipsis, color = MaterialTheme.colorScheme.onSecondaryContainer)
+        val a = g.answer
+        val e = g.error
+        if (a == null && e == null) Text("Thinking...", fontSize = size.sp, color = MaterialTheme.colorScheme.onSecondaryContainer)
+        if (e != null) Text(e, fontSize = size.sp, color = Color(0xFFE57373))
+        if (a != null) Text(a, fontSize = size.sp, color = MaterialTheme.colorScheme.onSecondaryContainer)
+        Row {
+            if (a != null) {
+                RasiTextButton(onClick = { onSend(a) }) { Text("Send to chat") }
+                RasiTextButton(onClick = { onCopy(a) }) { Text("Copy") }
+            }
+            RasiTextButton(onClick = onClose) { Text("Dismiss") }
+        }
+    }
+}
