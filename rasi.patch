diff --git a/java/assets/layouts_rasi/symbols.yaml b/java/assets/layouts_rasi/symbols.yaml
new file mode 100644
index 0000000..2d52544
--- /dev/null
+++ b/java/assets/layouts_rasi/symbols.yaml
@@ -0,0 +1,33 @@
+name: "Symbols"
+attributes:
+  shiftable: false
+rows:
+  - letters: "1 2 3 4 5 6 7 8 9 0"
+    # Only show this row if number row is inactive on main layout
+    numRowMode: Hideable
+  - letters: "% \\ | = [ ] < > { }"
+    # Only show this row if number row is active on main layout
+    numRowMode: Filler
+  # Gboard ?123 page: @ # $ _ & - + ( ) /
+  - letters:
+      - "@"
+      - ["#", "\u2116"]
+      - "$"
+      - "_"
+      - "&"
+      - ["-", "_", "\u2013", "\u2014", "\u207B", "\u208B", "\u00B7"]
+      - ["+", "\u207A", "\u208A"]
+      - "("
+      - ")"
+      - "/"
+  - letters:
+      - "$shift"
+      - "*"
+      - "\""
+      - "'"
+      - ":"
+      - ";"
+      - "!"
+      - "?"
+      - "$delete"
+  - bottom: "$alphabet , $number $space . $enter"
diff --git a/java/assets/layouts_rasi/symbols_shift.yaml b/java/assets/layouts_rasi/symbols_shift.yaml
new file mode 100644
index 0000000..ec0daca
--- /dev/null
+++ b/java/assets/layouts_rasi/symbols_shift.yaml
@@ -0,0 +1,59 @@
+name: "Symbols (Shifted)"
+numberRowMode: UserConfigurable
