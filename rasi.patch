+private fun cps(vararg r: IntRange): List<String> = r.flatMap { it.map { c -> String(Character.toChars(c)) } }
+
+/** Emoji by category for the reaction picker (plain Unicode text, no images, no internet). */
+internal val EMOJI_CATS: List<Pair<String, List<String>>> by lazy {
+    listOf(
+        "Faces" to cps(0x1F600..0x1F64F, 0x1F910..0x1F92F),
+        "Hands and people" to cps(0x1F440..0x1F440, 0x1F442..0x1F445, 0x1F446..0x1F450, 0x1F918..0x1F91F, 0x1F466..0x1F469),
+        "Hearts and symbols" to (listOf("\u2764\uFE0F", "\u2705", "\u274C", "\u2753", "\u2757", "\u2728", "\u2B50", "\u26A1") + cps(0x1F493..0x1F49F, 0x1F4A2..0x1F4AF)),
+        "Animals" to cps(0x1F400..0x1F43E),
+        "Nature" to cps(0x1F300..0x1F320, 0x1F330..0x1F335, 0x1F337..0x1F344),
+        "Food" to cps(0x1F345..0x1F37C),
+        "Activities" to cps(0x1F380..0x1F393, 0x1F3A0..0x1F3CA),
+        "Travel" to cps(0x1F680..0x1F6A4),
+        "Objects" to cps(0x1F4B0..0x1F4FC)
+    )
+}
