+/** Gboard-style long-press popup: the clip stays where it is, the actions open on the opposite side. */
+@Composable
+fun RasiHoldOverlay(
+    modifier: Modifier,
+    entry: ClipboardEntry,
+    itemRect: androidx.compose.ui.geometry.Rect?,
+    options: List<Triple<String, Int?, () -> Unit>>,
+    onDismiss: () -> Unit
+) {
+    val shown = remember { mutableStateOf(false) }
+    androidx.compose.runtime.LaunchedEffect(Unit) { shown.value = true }
+    val t by androidx.compose.animation.core.animateFloatAsState(
+        if (shown.value) 1f else 0f,
+        androidx.compose.animation.core.tween(160),
+        label = "holdOverlay"
+    )
+    val scheme = LocalKeyboardScheme.current
+    val density = androidx.compose.ui.platform.LocalDensity.current
+    var origin by remember { mutableStateOf(androidx.compose.ui.geometry.Offset.Zero) }
+    var boxSize by remember { mutableStateOf(androidx.compose.ui.unit.IntSize.Zero) }
+    var menuH by remember { mutableStateOf(0) }
+    val margin = with(density) { 8.dp.roundToPx() }
+
+    Box(
+        modifier
+            .onGloballyPositioned { origin = it.positionInRoot(); boxSize = it.size }
+            .graphicsLayer { alpha = t }
+            .background(androidx.compose.ui.graphics.Color.Black.copy(alpha = 0.9f))
+            .clickable(
+                interactionSource = remember { androidx.compose.foundation.interaction.MutableInteractionSource() },
+                indication = null
+            ) { onDismiss() }
+    ) {
+        val r = itemRect
+        val menuW = (boxSize.width * 0.46f).toInt()
+        // Where the clip is: left half -> menu opens right, right half -> menu opens left.
+        val itemLeft = r?.let { (it.left - origin.x).toInt() } ?: margin
+        val itemTop = r?.let { (it.top - origin.y).toInt() } ?: margin
+        val itemW = r?.width?.toInt() ?: (boxSize.width / 2 - margin)
+        val itemH = r?.height?.toInt() ?: 0
+        val wide = boxSize.width > 0 && itemW > boxSize.width * 0.7f
+        val onLeft = (itemLeft + itemW / 2) < boxSize.width / 2
+
+        // preview: the real item, same size, exactly where it is
+        ClipboardEntryView(
+            modifier = Modifier
+                .offset { androidx.compose.ui.unit.IntOffset(itemLeft, itemTop) }
+                .width(with(density) { itemW.toDp() })
+                .then(if (r != null) Modifier.height(with(density) { itemH.toDp() }) else Modifier),
+            clipboardEntry = entry,
+            onPaste = { onDismiss() },
+            onRemove = { },
+            onPin = { }
+        )
+
+        // menu on the opposite side
+        val menuX = if (wide) boxSize.width - menuW - margin
+            else if (onLeft) boxSize.width - menuW - margin else margin
+        val rawY = if (wide) itemTop + itemH + margin else itemTop
+        val menuY = rawY.coerceAtMost(boxSize.height - menuH - margin).coerceAtLeast(margin)
+        Surface(
+            color = scheme.keyboardContainer,
+            contentColor = scheme.onKeyboardContainer,
+            shape = RoundedCornerShape(20.dp),
+            modifier = Modifier
+                .offset { androidx.compose.ui.unit.IntOffset(menuX, menuY) }
+                .width(with(density) { menuW.toDp() })
+                .heightIn(max = with(density) { (boxSize.height - 2 * margin).coerceAtLeast(0).toDp() })
+                .onSizeChanged { menuH = it.height }
+                .graphicsLayer {
+                    scaleX = 0.94f + 0.06f * t
+                    scaleY = 0.94f + 0.06f * t
+                }
+        ) {
+            Column(Modifier.verticalScroll(rememberScrollState())) {
+                options.forEachIndexed { i, (label, icon, action) ->
+                    Row(
+                        Modifier
+                            .fillMaxWidth()
+                            .clickable { onDismiss(); action() }
+                            .padding(horizontal = 16.dp, vertical = 14.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(14.dp)
+                    ) {
+                        if (icon != null) {
+                            androidx.compose.material3.Icon(
+                                androidx.compose.ui.res.painterResource(icon),
+                                contentDescription = null,
+                                modifier = Modifier.size(22.dp)
+                            )
+                        }
+                        Text(label)
+                    }
+                    if (i < options.size - 1) {
+                        Box(
+                            Modifier.fillMaxWidth().height(1.dp)
+                                .background(scheme.onKeyboardContainer.copy(alpha = 0.10f))
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
