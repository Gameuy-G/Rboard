+// Search state shared by every row of one settings screen.
+// filter = true: rows that do not match are hidden (section search).
+// filter = false: only highlights (the global search decides what to show).
+class RasiSearchState(
+    val query: MutableState<String> = mutableStateOf(""),
+    val filter: Boolean = true
+) {
+    val open = mutableStateOf(false)
+}
+
+val LocalRasiSearch = compositionLocalOf<RasiSearchState?> { null }
+
+private fun tokens(q: String): List<String> =
+    q.lowercase(Locale.ROOT).trim().split(Regex("\\s+")).filter { it.isNotEmpty() }
+
+fun rasiRowMatches(query: String, title: String, subtitle: String?): Boolean {
+    val t = tokens(query)
+    if (t.isEmpty()) return true
+    val hay = (title + "\n" + (subtitle ?: "")).lowercase(Locale.ROOT)
+    return t.all { hay.contains(it) }
+}
+
+@Composable
+fun rasiRowHidden(title: String, subtitle: String?): Boolean {
+    val st = LocalRasiSearch.current ?: return false
+    if (!st.filter) return false
+    val q = st.query.value
+    return q.isNotBlank() && !rasiRowMatches(q, title, subtitle)
+}
+
+fun rasiHighlight(text: String, query: String, bg: Color, fg: Color): AnnotatedString {
+    val t = tokens(query)
+    if (t.isEmpty()) return AnnotatedString(text)
+    val low = text.lowercase(Locale.ROOT)
+    if (low.length != text.length) return AnnotatedString(text)
+    val hit = BooleanArray(text.length)
+    for (tok in t) {
+        var from = 0
+        while (true) {
+            val i = low.indexOf(tok, from)
+            if (i < 0) break
+            for (k in i until i + tok.length) hit[k] = true
+            from = i + tok.length
+        }
+    }
+    return buildAnnotatedString {
+        var k = 0
+        while (k < text.length) {
+            var e = k
+            while (e < text.length && hit[e] == hit[k]) e++
+            val part = text.substring(k, e)
+            if (hit[k]) {
+                pushStyle(SpanStyle(background = bg, color = fg, fontWeight = FontWeight.Bold))
+                append(part)
+                pop()
+            } else {
+                append(part)
+            }
+            k = e
+        }
+    }
+}
+
+// Highlights the current search text inside a row title or subtitle, in the current theme colors.
+@Composable
+fun rasiHL(text: String): AnnotatedString {
+    val q = LocalRasiSearch.current?.query?.value ?: ""
+    if (q.isBlank()) return AnnotatedString(text)
+    val cs = MaterialTheme.colorScheme
+    return rasiHighlight(text, q, cs.primaryContainer, cs.onPrimaryContainer)
+}
