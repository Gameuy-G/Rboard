+                val tab = remember { mutableStateOf<String?>(null) }
+                val menuFile = remember { mutableStateOf<File?>(null) }
+                val menuSource = remember { mutableStateOf<String?>(null) }
+                val pickFiles = remember { mutableStateOf<List<File>>(emptyList()) }
+                val selectMode = remember { mutableStateOf(false) }
+                val selected = remember { mutableStateListOf<String>() }
+                val hideOverride = remember { mutableStateOf(false) }
+                val pickSource = remember { mutableStateOf<String?>(null) }
+                val pickMode = remember { mutableStateOf<String?>(null) }
+                val sectionMenu = remember { mutableStateOf<String?>(null) }
+                val viewMenu = remember { mutableStateOf(false) }
+                val edit = remember { mutableStateOf<MediaTextEdit?>(null) }
+                val editText = remember { mutableStateOf("") }
+                val reorder = remember { mutableStateOf(false) }
+
+                fun refresh() {
+                    val m = RasiMedia.loadMeta(context, kind)
+                    if (m != metaState.value) metaState.value = m
+                    val t = tab.value
+                    if (t != null && !m.sections.containsKey(t)) tab.value = null
+                    val latest = RasiMedia.sorted(context, kind, m)
