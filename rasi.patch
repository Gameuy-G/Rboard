+        val section = RasiSections.sectionOf(item)
+        val updated = item.copy(text = newText)
+        clipboardHistory[idx] = updated
+        if(section != null) {
+            RasiSections.assign(item, null)
+            RasiSections.assign(updated, section)
+        }
