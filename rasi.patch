+/** Messages inside the keyboard: pick a friend, read the chat and send text without leaving the app you are typing in. */
+val RasiMessagesAction = Action(
+    icon = R.drawable.rasi_message,
+    name = R.string.rasi_messages_action,
+    simplePressImpl = null,
+    windowImpl = { manager, _ ->
+        val other = mutableStateOf<String?>(null)
+        val text = mutableStateOf("")
+        val typing = mutableStateOf(false)
+        var stop: () -> Unit = {}
+
+        fun openChat(uid: String?) {
+            stop(); stop = {}
+            other.value = uid
+            text.value = ""
+            typing.value = false
+            manager.forceActionWindowAboveKeyboard(false)
+            if (uid != null) stop = RasiChats.open(uid, 40)
+        }
+
+        object : ActionWindow() {
+            override val showCloseButton: Boolean
+                get() = true
+
+            override val positionIsUserManagable: Boolean
+                get() = false
+
+            override val fixedWindowHeight: androidx.compose.ui.unit.Dp?
+                get() = rasiTallPanelHeight(manager.getContext())
+
+            @Composable
+            override fun windowName(): String = stringResource(R.string.rasi_messages_action)
+
+            @Composable
+            override fun WindowContents(keyboardShown: Boolean) {
+                val context = LocalContext.current
+                val me = remember { try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null } }
+                LaunchedEffect(Unit) { if (me != null) { RasiFriends.refresh(context); RasiChats.loadMetas() } }
+                DisposableEffect(Unit) { onDispose { stop(); stop = {}; manager.forceActionWindowAboveKeyboard(false) } }
+                val cs = MaterialTheme.colorScheme
+                val who = other.value
+
+                if (me == null) {
+                    Box(Modifier.fillMaxSize().padding(16.dp), contentAlignment = Alignment.Center) {
+                        Text("Sign in under Online in Rboard settings to message friends", fontSize = 14.sp, color = cs.onSurfaceVariant)
+                    }
+                    return
+                }
+
+                if (who == null) {
+                    val friends = RasiFriends.friends.value
+                    val last = RasiChats.metas.value.associate { it.other to it.lastAt }
+                    val sorted = friends.sortedByDescending { last[it.uid] ?: 0L }
+                    if (sorted.isEmpty()) Box(Modifier.fillMaxSize().padding(16.dp), contentAlignment = Alignment.Center) {
+                        Text("No friends yet. Add friends in Rboard settings", fontSize = 14.sp, color = cs.onSurfaceVariant)
+                    } else LazyColumn(Modifier.fillMaxSize()) {
+                        items(sorted, key = { it.uid }) { f ->
+                            val meta = RasiChats.metas.value.firstOrNull { it.other == f.uid }
+                            Row(Modifier.fillMaxWidth().clickable { openChat(f.uid) }.padding(horizontal = 12.dp, vertical = 8.dp), verticalAlignment = Alignment.CenterVertically) {
+                                ChatAv(f.p.avatar.ifBlank { "?" }, f.p.avatarColor, 40, false, f.uid)
+                                Spacer(Modifier.width(12.dp))
+                                Column(Modifier.weight(1f)) {
+                                    Text(f.p.name.ifBlank { f.p.username }, fontSize = 16.sp, maxLines = 1, color = cs.onSurface)
+                                    if (meta != null && meta.lastMessage.isNotBlank()) Text(
+                                        (if (meta.lastFrom == me) "You: " else "") + meta.lastMessage, fontSize = 13.sp, maxLines = 1, color = cs.onSurfaceVariant
+                                    )
+                                }
+                            }
+                        }
+                    }
+                    return
+                }
+
+                val friend = RasiFriends.friends.value.firstOrNull { it.uid == who }
+                val msgs = RasiChats.messages.value
+                val listState = rememberLazyListState()
+                LaunchedEffect(msgs.size) { if (msgs.isNotEmpty()) listState.scrollToItem(msgs.size - 1) }
+                val send = {
+                    val t = text.value.trim()
+                    if (t.isNotEmpty()) { RasiChats.send(context, who, t); text.value = "" }
+                }
+                Column(Modifier.fillMaxSize()) {
+                    Row(Modifier.fillMaxWidth().padding(horizontal = 8.dp, vertical = 4.dp), verticalAlignment = Alignment.CenterVertically) {
+                        Text("\u2039", Modifier.clip(RoundedCornerShape(12.dp)).clickable { openChat(null) }.padding(horizontal = 12.dp), fontSize = 28.sp, color = cs.onSurface)
+                        if (friend != null) ChatAv(friend.p.avatar.ifBlank { "?" }, friend.p.avatarColor, 28, false, friend.uid)
+                        Spacer(Modifier.width(8.dp))
+                        Text(friend?.p?.name?.ifBlank { friend.p.username } ?: "Chat", fontSize = 16.sp, maxLines = 1, color = cs.onSurface)
+                    }
+                    LazyColumn(Modifier.weight(1f).fillMaxWidth().padding(horizontal = 10.dp), state = listState, verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                        items(msgs, key = { it.id }) { m ->
+                            val mine = m.from == me
+                            Row(Modifier.fillMaxWidth(), horizontalArrangement = if (mine) Arrangement.End else Arrangement.Start) {
+                                Text(m.text, Modifier.widthIn(max = 260.dp).clip(RoundedCornerShape(16.dp))
+                                    .background(if (mine) cs.primary else cs.surfaceContainerHigh).padding(horizontal = 12.dp, vertical = 7.dp),
+                                    fontSize = 15.sp, color = if (mine) cs.onPrimary else cs.onSurface)
+                            }
+                        }
+                    }
+                    Row(Modifier.fillMaxWidth().padding(8.dp), verticalAlignment = Alignment.CenterVertically) {
+                        Box(Modifier.weight(1f).height(44.dp).clip(RoundedCornerShape(22.dp)).background(cs.surfaceContainerHigh).padding(horizontal = 14.dp), contentAlignment = Alignment.CenterStart) {
+                            if (typing.value) ActionTextEditor(text, multiline = false, autocorrect = true, placeholder = "Message", onEnter = { send() })
+                            else Text(text.value.ifBlank { "Message" }, Modifier.fillMaxWidth().clickable { typing.value = true; manager.forceActionWindowAboveKeyboard(true) },
+                                maxLines = 1, color = cs.onSurfaceVariant)
+                        }
+                        Spacer(Modifier.width(8.dp))
+                        Text("Send", Modifier.clip(RoundedCornerShape(22.dp)).background(cs.primary).clickable { send() }.padding(horizontal = 16.dp, vertical = 11.dp),
+                            fontSize = 15.sp, color = cs.onPrimary)
+                    }
+                }
+            }
+
+            override fun close(): CloseResult {
+                if (other.value != null) { openChat(null); return CloseResult.PreventClosing }
+                if (typing.value) { typing.value = false; manager.forceActionWindowAboveKeyboard(false); return CloseResult.PreventClosing }
+                return CloseResult.Default
+            }
+        }
+    },
