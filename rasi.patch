+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.graphics.Canvas
+import android.view.View
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.viewinterop.AndroidView
+
+private class RasiNavStripView(c: Context) : View(c) {
+    override fun onDraw(canvas: Canvas) {
+        RasiNowPlayingViz.drawStrip(this, canvas)
+        // the bottom part of the one big keyboard glow (behind the navigation buttons)
+        RasiBorderGlow.drawPiece(this, canvas, "over_viz")
+        RasiBorderGlow.drawPiece(this, canvas, "all")
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, ow: Int, oh: Int) {
+        super.onSizeChanged(w, h, ow, oh)
+        RasiNowPlayingViz.navExt = h.toFloat()
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        RasiNowPlayingViz.navExt = 0f
+    }
+}
+
+/** Thin view under the keyboard, as high as the navigation bar, so the visualizer reaches the screen bottom. */
+@Composable
+fun RasiVizNavStrip(modifier: Modifier) {
+    AndroidView(factory = { RasiNavStripView(it) }, modifier = modifier)
+}
