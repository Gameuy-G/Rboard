+internal object GradientMath {
+    /** Start and end points of a gradient line across a w x h box for the given angle (0 = left to right, 90 = top to bottom). */
+    fun endpoints(w: Float, h: Float, angleDeg: Float): FloatArray {
+        val rad = Math.toRadians(angleDeg.toDouble())
+        val dx = cos(rad).toFloat()
+        val dy = sin(rad).toFloat()
+        val half = (abs(w * dx) + abs(h * dy)) / 2f
+        val cx = w / 2f
+        val cy = h / 2f
+        return floatArrayOf(cx - dx * half, cy - dy * half, cx + dx * half, cy + dy * half)
+    }
+}
+
+private val gradientPresets = listOf(
+    listOf(0xFFFF9A5A.toInt(), 0xFFE0408E.toInt(), 0xFF5B2A9E.toInt()),
+    listOf(0xFF1FA2FF.toInt(), 0xFF12D8FA.toInt(), 0xFFA6FFCB.toInt()),
+    listOf(0xFF0F2027.toInt(), 0xFF203A43.toInt(), 0xFF2C5364.toInt()),
+    listOf(0xFFFFD1A9.toInt(), 0xFFFF8BA7.toInt()),
+    listOf(0xFF7F00FF.toInt(), 0xFFE100FF.toInt()),
+)
+
+private fun evenStops(n: Int): List<Float> =
+    if (n <= 1) listOf(0f) else List(n) { it / (n - 1).toFloat() }
+
+private fun renderGradientBitmap(colors0: List<Int>, stops0: List<Float>, angle: Float, w: Int = 1080, h: Int = 900): Bitmap {
+    val colors = if (colors0.size == 1) listOf(colors0[0], colors0[0]) else colors0
+    val stops = if (stops0.size == 1) listOf(0f, 1f) else stops0
+    val order = colors.indices.sortedBy { stops[it] }
+    val e = endpoints(w.toFloat(), h.toFloat(), angle)
+    val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    paint.shader = LinearGradient(
+        e[0], e[1], e[2], e[3],
+        order.map { colors[it] }.toIntArray(),
+        order.map { stops[it].coerceIn(0f, 1f) }.toFloatArray(),
+        Shader.TileMode.CLAMP
+    )
+    val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+    Canvas(bmp).drawRect(0f, 0f, w.toFloat(), h.toFloat(), paint)
+    return bmp
+}
+
+/**
+ * Gradient maker: choose 2 to 4 colors, their positions and the angle, then continue into the
+ * normal theme editor (which handles blur, transparency, key shape/colors and saving).
+ */
+@Composable
+fun GradientMakerScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+
+    val colors = remember { mutableStateListOf(0xFF6EB0F8.toInt()) }
+    val stops = remember { mutableStateListOf(0f) }
+    var angle by remember { mutableFloatStateOf(90f) }
+    var selected by remember { mutableIntStateOf(0) }
+    var tick by remember { mutableIntStateOf(0) }
+
+    val safeSel = selected.coerceIn(0, colors.size - 1)
+
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .verticalScroll(rememberScrollState())
+            .padding(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp)
+    ) {
+        Text(stringResource(R.string.rasi_gradient_title))
+
+        // Live preview
+        val previewColors = if (colors.size == 1) listOf(colors[0], colors[0]) else colors.toList()
+        val previewStops = if (stops.size == 1) listOf(0f, 1f) else stops.toList()
+        Column(
+            Modifier
+                .widthIn(max = if (org.futo.inputmethod.latin.uix.rasiCompact()) 240.dp else 360.dp)
+                .fillMaxWidth()
+                .aspectRatio(1.2f)
+                .clip(RoundedCornerShape(20.dp))
+                .drawBehind {
+                    val order = previewColors.indices.sortedBy { previewStops[it] }
+                    val e = endpoints(size.width, size.height, angle)
+                    drawRect(
+                        ShaderBrush(
+                            LinearGradientShader(
+                                Offset(e[0], e[1]),
+                                Offset(e[2], e[3]),
+                                order.map { Color(previewColors[it]) },
+                                order.map { previewStops[it].coerceIn(0f, 1f) }
+                            )
+                        ),
+                        size = Size(size.width, size.height)
+                    )
+                }
+        ) {}
+
+        // Presets
+        Row(
+            modifier = Modifier.horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            gradientPresets.forEach { preset ->
+                Row(
+                    Modifier
+                        .size(44.dp)
+                        .clip(CircleShape)
+                        .background(Brush.linearGradient(preset.map { Color(it) }))
+                        .border(1.dp, Color.Gray, CircleShape)
+                        .clickable {
+                            colors.clear()
+                            colors.addAll(preset)
+                            stops.clear()
+                            stops.addAll(evenStops(preset.size))
+                            selected = 0
+                            tick++
+                        }
+                ) {}
+            }
+        }
+
+        // Color chips: first = top, last = bottom (at 90 degrees)
+        Row(
+            modifier = Modifier.horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            colors.forEachIndexed { i, c ->
+                Row(
+                    Modifier
+                        .size(40.dp)
+                        .clip(CircleShape)
+                        .background(Color(c))
+                        .border(if (i == safeSel) 3.dp else 1.dp, if (i == safeSel) Color.White else Color.Gray, CircleShape)
+                        .clickable { selected = i; tick++ }
+                ) {}
+            }
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            if (colors.size < 8) {
+                OutlinedButton(onClick = {
+                    val hsv = FloatArray(3)
+                    android.graphics.Color.colorToHSV(colors.last(), hsv)
+                    hsv[0] = (hsv[0] + 40f) % 360f
+                    colors.add(android.graphics.Color.HSVToColor(hsv))
+                    val ns = evenStops(colors.size)
+                    stops.clear()
+                    stops.addAll(ns)
+                    selected = colors.size - 1
+                    tick++
+                }) { Text(stringResource(R.string.rasi_gradient_add)) }
+            }
+            if (colors.size > 1) {
+                OutlinedButton(onClick = {
+                    colors.removeAt(safeSel)
+                    val ns = evenStops(colors.size)
+                    stops.clear()
+                    stops.addAll(ns)
+                    selected = 0
+                    tick++
+                }) { Text(stringResource(R.string.rasi_gradient_remove)) }
+            }
+        }
+
+        // Selected color HSV + hex
+        val cur = colors[safeSel]
+        val init = remember(safeSel, tick) { FloatArray(3).also { android.graphics.Color.colorToHSV(cur, it) } }
+        var h by remember(safeSel, tick) { mutableFloatStateOf(init[0]) }
+        var s by remember(safeSel, tick) { mutableFloatStateOf(init[1]) }
+        var v by remember(safeSel, tick) { mutableFloatStateOf(init[2]) }
+        var hex by remember(safeSel, tick, cur) { mutableStateOf(String.format("#%06X", cur and 0xFFFFFF)) }
+
+        val setColor = { c: Int -> colors[safeSel] = c }
+        val applyHsv = { nh: Float, ns: Float, nv: Float ->
+            h = nh
+            s = ns
+            v = nv
+            setColor(android.graphics.Color.HSVToColor(floatArrayOf(nh.coerceIn(0f, 360f), ns.coerceIn(0f, 1f), nv.coerceIn(0f, 1f))))
+        }
+        val hueColor = Color(android.graphics.Color.HSVToColor(floatArrayOf(h.coerceIn(0f, 360f), 1f, 1f)))
+
+        LabeledSlider(
+            label = "Hue", value = h, valueRange = 0f..360f,
+            gradient = remember {
+                Brush.horizontalGradient((0..360 step 30).map { deg ->
+                    Color(android.graphics.Color.HSVToColor(floatArrayOf(deg.toFloat(), 1f, 1f)))
+                })
+            },
+            onValueChange = { applyHsv(it, s, v) }
+        )
+        LabeledSlider(
+            label = "Saturation", value = s, valueRange = 0f..1f,
+            gradient = Brush.horizontalGradient(listOf(Color.White, hueColor)),
+            onValueChange = { applyHsv(h, it, v) }
+        )
+        LabeledSlider(
+            label = "Brightness", value = v, valueRange = 0f..1f,
+            gradient = Brush.horizontalGradient(listOf(Color.Black, hueColor)),
+            onValueChange = { applyHsv(h, s, it) }
+        )
+
+        OutlinedTextField(
+            value = hex,
+            onValueChange = { t ->
+                hex = t
+                if (t.length == 7 && t[0] == '#') {
+                    val c = runCatching { android.graphics.Color.parseColor(t) }.getOrNull()
+                    if (c != null) {
+                        val a = FloatArray(3)
+                        android.graphics.Color.colorToHSV(c, a)
+                        h = a[0]; s = a[1]; v = a[2]
+                        setColor(c)
+                    }
+                }
+            },
+            singleLine = true,
+            label = { Text(stringResource(R.string.rasi_key_color_hex)) },
+            modifier = Modifier.fillMaxWidth()
+        )
+
+        Text(stringResource(R.string.rasi_gradient_position))
+        LabeledSlider(
+            label = "Position", value = stops[safeSel].coerceIn(0f, 1f), valueRange = 0f..1f,
+            gradient = Brush.horizontalGradient(listOf(Color(0xFF555555), Color(0xFFBBBBBB))),
+            onValueChange = { stops[safeSel] = it }
+        )
+
+        Text(stringResource(R.string.rasi_gradient_angle))
+        LabeledSlider(
+            label = "Angle", value = angle.coerceIn(0f, 360f), valueRange = 0f..360f,
+            gradient = Brush.horizontalGradient(listOf(Color(0xFF555555), Color(0xFFBBBBBB))),
+            onValueChange = { angle = it }
+        )
+
+        Button(
+            modifier = Modifier.fillMaxWidth(),
+            onClick = {
+                val bmp = renderGradientBitmap(colors.toList(), stops.toList(), angle)
+                val dir = File(context.cacheDir, "rasi_gradients").also { it.mkdirs() }
+                val f = File(dir, "gradient_${System.currentTimeMillis()}.png")
+                f.outputStream().use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }
+                bmp.recycle()
+                navController.navigateUp()
+                navController.navigate(Route.CustomTheme(Uri.fromFile(f).toString()))
+            }
+        ) { Text(stringResource(R.string.rasi_gradient_continue)) }
+    }
+}
