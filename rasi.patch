+@Composable
+fun rememberRasiCtx(manager: KeyboardManagerForAction?, key: Any?): State<RasiCtx> {
+    val context = LocalContext.current
+    val state = remember { mutableStateOf(RasiCtx()) }
+    LaunchedEffect(key) {
+        delay(60)
+        while (true) {
+            val ime = manager?.getLatinIMEForDebug()
+            if (ime != null && ime.isInputConnectionOverridden) {
+                // A search box (etc.) has the input right now; its text isn't the user's message
+                delay(300)
+                continue
+            }
+            val text = try {
+                ime?.currentInputConnection?.getTextBeforeCursor(300, 0)?.toString() ?: ""
+            } catch (e: Exception) {
+                ""
+            }
+            val ctx = withContext(Dispatchers.Default) { RasiKitchen.analyze(context, text) }
+            if (ctx != state.value) state.value = ctx
+            if (ctx.combos.isEmpty() && ctx.lastEmoji == null) RasiBarState.open.value = false
+            delay(300)
+        }
+    }
+    return state
+}
