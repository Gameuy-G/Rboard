+/** Your own stickers and GIFs, saved inside the keyboard's private storage. */
+object RasiMedia {
+    fun dir(context: Context, kind: String): File {
+        val d = File(context.filesDir, "rasi_media/$kind")
+        d.mkdirs()
+        return d
+    }
+
+    fun list(context: Context, kind: String): List<File> {
+        val files = dir(context, kind).listFiles()?.toList() ?: emptyList()
+        return files.sortedByDescending { it.lastModified() }
+    }
+
+    fun mimeOf(file: File): String = when (file.extension.lowercase()) {
+        "gif" -> "image/gif"
+        "png" -> "image/png"
+        "webp" -> "image/webp"
+        "jpg", "jpeg" -> "image/jpeg"
+        "mp4", "m4v" -> "video/mp4"
+        "webm" -> "video/webm"
+        "3gp" -> "video/3gpp"
+        "mkv" -> "video/x-matroska"
+        "mov" -> "video/quicktime"
+        else -> "image/*"
+    }
+
+    fun isVideo(file: File): Boolean = mimeOf(file).startsWith("video/")
+
+    /** Setting: moving an item into a section also hides it from All. Default OFF. */
+    fun removeFromAllOnMove(context: Context): Boolean =
+        context.getSharedPreferences("rasi_media_ui", Context.MODE_PRIVATE)
+            .getBoolean("remove_from_all_on_move", false)
+
+    fun setRemoveFromAllOnMove(context: Context, v: Boolean) {
+        context.getSharedPreferences("rasi_media_ui", Context.MODE_PRIVATE)
+            .edit().putBoolean("remove_from_all_on_move", v).apply()
+    }
+
+    /** Setting: which date is used for sorting and headers: "added" (default) or "taken". */
+    fun dateSource(context: Context): String =
+        context.getSharedPreferences("rasi_media_ui", Context.MODE_PRIVATE)
+            .getString("date_source", "added") ?: "added"
+
+    fun setDateSource(context: Context, v: String) {
+        context.getSharedPreferences("rasi_media_ui", Context.MODE_PRIVATE)
+            .edit().putString("date_source", v).apply()
