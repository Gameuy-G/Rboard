+private fun recentEmojis(p: SharedPreferences): List<String> = p.getString("ch_emoji_recent", "").orEmpty().split("|").filter { it.isNotBlank() }
+
+private fun pushRecent(p: SharedPreferences, e: String) {
+    val l = (listOf(e) + recentEmojis(p).filter { it != e }).take(16)
+    p.edit().putString("ch_emoji_recent", l.joinToString("|")).apply()
+}
