+        if (!cfg.nextEnabled) return
+        val tb = inputLogic.mConnection.getTextBeforeCursor(300, 0)?.toString() ?: return
+        if (tb.isEmpty() || !tb.last().isWhitespace()) return
+        val sentence = tb.substring(tb.lastIndexOfAny(charArrayOf('.', '!', '?', '\n')) + 1)
+        // never send anything that looks like an email address or a long number
