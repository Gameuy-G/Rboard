+            scope.launch {
+                val ok = withContext(Dispatchers.IO) { RasiAnimBg.importFile(context, uri, target) }
+                message = if (ok) "" else failed
+            }
+        }
+    }
+
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text(title)
+        if (has) {
+            Box(Modifier.fillMaxWidth().height(120.dp).clip(RoundedCornerShape(12.dp))) {
+                RasiAnimatedBackground(target, Modifier.fillMaxSize())
+            }
+            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.SpaceBetween) {
+                Text(stringResource(R.string.rasi_animbg_show), Modifier.weight(1f))
+                Switch(checked = on, onCheckedChange = { on = it; RasiAnimBg.set(context, target, on = it) })
+            }
+            Text(stringResource(R.string.rasi_animbg_opacity, Math.round(opacity * 100)))
+            Slider(value = opacity, onValueChange = { opacity = it }, valueRange = 0.1f..1f,
+                onValueChangeFinished = { RasiAnimBg.set(context, target, opacity = opacity) })
+            Text(stringResource(R.string.rasi_animbg_dim, Math.round(dim * 100)))
+            Slider(value = dim, onValueChange = { dim = it }, valueRange = 0f..0.8f,
+                onValueChangeFinished = { RasiAnimBg.set(context, target, dim = dim) })
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            Button(onClick = { picker.launch(arrayOf("image/gif", "image/webp", "image/*")) }) {
+                Text(stringResource(if (has) R.string.rasi_animbg_change else R.string.rasi_animbg_choose))
+            }
+            if (has) OutlinedButton(onClick = { RasiAnimBg.clear(context, target) }) {
+                Text(stringResource(R.string.rasi_animbg_remove))
+            }
+        }
+        if (message.isNotEmpty()) Text(message)
+    }
+}
+
+@Composable
+fun RasiAnimBgScreen(navController: NavHostController = rememberNavController()) {
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.rasi_animbg_title), showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(20.dp)) {
+            Text(stringResource(R.string.rasi_animbg_hint))
+            AnimBgSection(stringResource(R.string.rasi_animbg_keyboard), RasiAnimBg.KEYBOARD)
+            AnimBgSection(stringResource(R.string.rasi_animbg_settings), RasiAnimBg.SETTINGS)
+        }
+    }
+}
