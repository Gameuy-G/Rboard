+        val from = mutableStateOf(saved("tr_from", RASI_LANGS.first { it.kind == "auto" }))
+        val to = mutableStateOf(saved("tr_to", RASI_LANGS.first { it.code == TranslateLanguage.ENGLISH }))
+        val detected = mutableStateOf("")
+        val picking = mutableStateOf(0) // 0 = none, 1 = picking "from", 2 = picking "to"
+        var seq = 0
+
+        fun baseConnection() = manager.getLatinIMEForDebug().getBaseInputConnection()
+
+        object : ActionWindow() {
+            override val showCloseButton: Boolean
+                get() = true
+
