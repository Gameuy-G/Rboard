+                fun validName(raw: String, except: String?): String? {
+                    val t = raw.trim()
+                    if (t.isEmpty() || t.equals("All", ignoreCase = true)) return null
+                    if (metaState.value.sections.keys.any { it.equals(t, ignoreCase = true) && it != except }) return null
+                    return t
