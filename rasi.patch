+@Composable
+private fun Modifier.geminiGlass(shape: androidx.compose.ui.graphics.Shape, accent: Boolean, strength: Float = 1f): Modifier {
+    val sch = LocalKeyboardScheme.current
+    val base = sch.onSurface
+    val customC = if (accent) RasiGeminiThemePrefs.meColor else RasiGeminiThemePrefs.aiColor
+    val tint = if (customC != 0) androidx.compose.ui.graphics.Color(customC) else if (accent) sch.primary else base
+    if (!RasiGeminiThemePrefs.glassOn) {
+        return this.clip(shape).background(
+            tint.copy(alpha = if (customC != 0) 1f else if (accent) 0.55f else 0.16f), shape
+        )
+    }
+    val top = (if (accent) 0.42f else 0.15f) * strength
+    val bottom = (if (accent) 0.24f else 0.06f) * strength
+    return this
+        .clip(shape)
+        .background(
+            androidx.compose.ui.graphics.Brush.linearGradient(
+                listOf(tint.copy(alpha = top), tint.copy(alpha = bottom))
+            ),
+            shape
+        )
+        .border(
+            1.dp,
+            androidx.compose.ui.graphics.Brush.linearGradient(
+                listOf(base.copy(alpha = 0.38f), tint.copy(alpha = 0.12f), base.copy(alpha = 0.2f))
+            ),
+            shape
+        )
+}
