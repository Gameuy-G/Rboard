+                            }
+                            Text(m.text, fontSize = size.sp, fontWeight = if (mention) FontWeight.Bold else null)
+                            DropdownMenu(expanded = menuFor == m.id, onDismissRequest = { menuFor = null }) {
+                                DropdownMenuItem(text = { Text("Copy") }, onClick = {
+                                    val cm = context.getSystemService(android.content.Context.CLIPBOARD_SERVICE) as android.content.ClipboardManager
+                                    cm.setPrimaryClip(android.content.ClipData.newPlainText("message", m.text)); menuFor = null
+                                })
+                                if (isMine || isOwner) DropdownMenuItem(text = { Text("Delete") }, onClick = { RasiRoomChat.delete(code, m); menuFor = null })
+                            }
+                        }
+                    }
+                }
+            }
+            Row(
+                (if (barOn) Modifier.fillMaxWidth().background(MaterialTheme.colorScheme.surface.copy(alpha = barA), RoundedCornerShape(topStart = 20.dp, topEnd = 20.dp)) else Modifier.fillMaxWidth())
+                    .padding(8.dp),
+                verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                OutlinedTextField(text, { text = it.take(maxLen) }, Modifier.weight(1f), placeholder = { Text("Message the room") }, maxLines = 4)
+                Button(enabled = text.isNotBlank(), onClick = { RasiRoomChat.send(code, text, maxLen); text = "" }) { Text("Send") }
+            }
+        }
+    }
+}
