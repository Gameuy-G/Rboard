+        favs.addAll(allFavs.take(RASI_TOP_MAX))
+        pinned.addAll(map[ActionCategory.PinnedKey] ?: listOf())
+        val base = ((map[ActionCategory.ActionKey] ?: listOf()) +
+                (map[ActionCategory.More] ?: listOf()) +
+                allFavs.drop(RASI_TOP_MAX)).filter { it.shownInEditor }
+        grid.addAll(gridActions(context.getSettingBlocking(RasiGridOrder), base))
+        if (allFavs.size > RASI_TOP_MAX) save()
+    }
+
+    private fun zoneOf(a: Action) = if (favs.contains(a)) favs else if (pinned.contains(a)) pinned else grid
+
+    private fun swap(a: Action, b: Action) {
+        val la = zoneOf(a)
+        val lb = zoneOf(b)
+        val ia = la.indexOf(a)
+        val ib = lb.indexOf(b)
+        la[ia] = b
+        lb[ib] = a
+    }
+
+    private var lastMoveAt = 0L
+
+    /** While dragging a grid item over the grid, move it live so the others slide aside. */
+    fun liveMove(a: Action) {
+        val p = finger.value
+        if (!grid.contains(a) || !gridBounds.contains(p)) return
+        val now = android.os.SystemClock.uptimeMillis()
+        if (now - lastMoveAt < 220L) return
+        val t = grid.firstOrNull { it != a && rects[it.name]?.contains(p) == true } ?: return
+        val from = grid.indexOf(a)
+        val to = grid.indexOf(t)
+        if (from != to) {
+            grid.removeAt(from)
+            grid.add(to, a)
+            lastMoveAt = now
+        }
+    }
+
+    fun drop() {
+        val a = dragging.value ?: return
+        val p = finger.value
+        dragging.value = null
+        if (grid.contains(a) && gridBounds.contains(p)) {
+            // already moved live while dragging
+            save()
+            return
+        }
+        val target = (favs.toList() + pinned.toList() + grid.toList())
+            .firstOrNull { it != a && rects[it.name]?.contains(p) == true }
+        val bothInGrid = target != null && grid.contains(a) && grid.contains(target)
+        if (pinnedBounds.contains(p) && !pinned.contains(a)) {
+            // Dropped on the pinned slot: take it (the old pinned one goes back to the grid)
+            favs.remove(a)
+            grid.remove(a)
+            if (pinned.isNotEmpty()) grid.add(0, pinned.removeAt(0))
+            pinned.add(a)
+            save()
+            return
+        }
+        val fromOutsideOntoTop = target != null && favs.contains(target) && !favs.contains(a)
+        if (target != null && !bothInGrid && !fromOutsideOntoTop) {
+            // Dropped on another action: they trade places
+            swap(a, target)
+        } else if (topBounds.contains(p)) {
+            if (favs.contains(a)) {
+                val idx = favs.filter { it != a }.count { (rects[it.name]?.center?.x ?: 0f) < p.x }
+                favs.remove(a)
+                favs.add(idx.coerceIn(0, favs.size), a)
+            } else {
+                // Insert where dropped; if the row is full, the far-right one slides out to the
+                // top-left of the grid
+                val idx = favs.count { (rects[it.name]?.center?.x ?: 0f) < p.x }
+                pinned.remove(a)
+                grid.remove(a)
+                favs.add(idx.coerceIn(0, minOf(favs.size, RASI_TOP_MAX - 1)), a)
+                if (favs.size > RASI_TOP_MAX) {
+                    val out = favs.removeAt(favs.size - 1)
+                    grid.add(0, out)
+                }
+            }
+        } else if (gridBounds.contains(p)) {
+            val others = grid.filter { it != a }
+            val nearest = others.minByOrNull { o ->
+                val c = rects[o.name]?.center ?: Offset(1e9f, 1e9f)
+                (c - p).getDistance()
+            }
+            val oldIdx = grid.indexOf(a)
+            val tIdx = if (nearest != null) grid.indexOf(nearest) else -1
+            favs.remove(a)
+            pinned.remove(a)
+            grid.remove(a)
+            if (nearest == null) {
+                grid.add(a)
+            } else {
+                var i = grid.indexOf(nearest)
+                if (oldIdx in 0 until tIdx) i += 1
+                grid.add(i.coerceIn(0, grid.size), a)
+            }
+        } else {
+            return
+        }
+        save()
+    }
+
+    private fun save() {
+        val cur = context.getSettingBlocking(ActionsSettings)
+            .toActionEditorItems().ensureWellFormed().toActionMap().ensureAllCategoriesPresent()
+        val used = (favs + pinned).toSet()
+        val m: Map<ActionCategory, List<Action>> = mapOf(
+            ActionCategory.ActionKey to (cur[ActionCategory.ActionKey] ?: emptyList()).filter { it !in used },
+            ActionCategory.PinnedKey to pinned.toList(),
+            ActionCategory.Favorites to favs.toList(),
+            ActionCategory.More to (cur[ActionCategory.More] ?: emptyList()).filter { it !in used },
+            ActionCategory.Disabled to (cur[ActionCategory.Disabled] ?: emptyList())
+        )
+        context.updateSettingsWithNewActions(m)
+        context.setSettingBlocking(
+            RasiGridOrder.key,
+            grid.joinToString(",") { ActionRegistry.actionToStringId(it) }
+        )
+    }
+}
+
+private fun Modifier.rasiDrag(st: RasiGridState, action: Action, view: View): Modifier =
+    this.pointerInput(action.name) {
+        detectDragGesturesAfterLongPress(
+            onDragStart = { off ->
+                st.dragging.value = action
+                st.finger.value = (st.rects[action.name]?.topLeft ?: Offset.Zero) + off
+                view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
+            },
+            onDrag = { change, _ ->
+                change.consume()
+                st.finger.value = (st.rects[action.name]?.topLeft ?: Offset.Zero) + change.position
+                st.liveMove(action)
+            },
+            onDragEnd = { st.drop() },
+            onDragCancel = { st.dragging.value = null }
+        )
+    }
+
