+import org.futo.inputmethod.latin.R
+import org.futo.inputmethod.latin.common.Constants
+import org.futo.inputmethod.latin.rasi.RasiState
+import org.futo.inputmethod.latin.uix.actions.clipboard.CLIPBOARD_AUTHORITY
+import org.futo.inputmethod.latin.uix.actions.clipboard.ClipboardPasteRequest
+import org.futo.inputmethod.latin.uix.actions.clipboard.ClipboardProviderState
+import org.futo.inputmethod.latin.uix.actions.clipboard.clipboardDir
+import org.futo.inputmethod.latin.uix.theme.Typography
+import java.io.File
+
+/** "Screenshot" chip shown in the suggestion bar after taking a screenshot, like a copied-text chip. */
+@Composable
+fun RowScope.RasiScreenshotChip() {
+    val shot = RasiState.screenshot.value ?: return
+    val manager = LocalManager.current
+    val context = LocalContext.current
+    val view = LocalView.current
+
+    val thumb by produceState<ImageBitmap?>(null, shot.file) {
+        value = withContext(Dispatchers.IO) {
+            // The screenshot file may still be being written when the chip appears, so keep retrying
+            var result: ImageBitmap? = null
+            var attempt = 0
+            while (result == null && attempt < 12) {
+                try {
+                    val f = File(context.clipboardDir, shot.file)
+                    if (f.exists() && f.length() > 0L) {
+                        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+                        BitmapFactory.decodeFile(f.path, bounds)
+                        if (bounds.outWidth > 0 && bounds.outHeight > 0) {
+                            var sample = 1
+                            while (bounds.outWidth / (sample * 2) >= 160 && bounds.outHeight / (sample * 2) >= 160) sample *= 2
+                            val opts = BitmapFactory.Options().apply { inSampleSize = sample }
+                            result = BitmapFactory.decodeFile(f.path, opts)?.asImageBitmap()
+                        }
+                    }
+                } catch (e: Throwable) {
+                    result = null
+                }
+                if (result == null) {
+                    attempt++
+                    kotlinx.coroutines.delay(400)
+                }
+            }
+            result
+        }
+    }
+
+    Row(
+        Modifier.weight(1.0f).fillMaxHeight(),
+        horizontalArrangement = Arrangement.Center,
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Box(Modifier.fillMaxHeight().clickable {
+            manager.performHapticAndAudioFeedback(Constants.CODE_TAB, view)
+            val request = ClipboardProviderState.addRequest(
+                ClipboardPasteRequest(
+                    file = File(context.clipboardDir, shot.file),
+                    mimeType = shot.mime,
+                    expiration = System.currentTimeMillis() + 5L * 60L * 1000L
+                )
+            )
+            val uri = "content://${CLIPBOARD_AUTHORITY}/clip/$request".toUri()
+            manager.typeUri(uri, listOf(shot.mime), true)
+            RasiState.screenshot.value = null
+        }.padding(4.dp)) {
+            Surface(
+                color = LocalKeyboardScheme.current.keyboardContainer,
+                shape = RoundedCornerShape(8.dp)
+            ) {
+                CompositionLocalProvider(LocalContentColor provides LocalKeyboardScheme.current.onKeyboardContainer) {
+                    Row(
+                        horizontalArrangement = Arrangement.spacedBy(4.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp).fillMaxHeight()
+                    ) {
+                        val b = thumb
+                        if (b != null) {
+                            Image(
+                                bitmap = b,
+                                contentDescription = null,
+                                contentScale = ContentScale.Crop,
+                                modifier = Modifier
+                                    .height(30.dp)
+                                    .aspectRatio(b.width.toFloat() / b.height.toFloat())
+                                    .clip(RoundedCornerShape(4.dp))
+                            )
+                        } else {
+                            Icon(painterResource(R.drawable.image), contentDescription = null)
+                        }
+                        Text("Screenshot", style = Typography.Small)
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiSounds.kt b/java/src/org/futo/inputmethod/latin/uix/RasiSounds.kt
new file mode 100644
index 000000000..42455823c
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiSounds.kt
@@ -0,0 +1,159 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioManager
+import android.media.SoundPool
+import android.net.Uri
+import android.widget.Toast
+import org.futo.inputmethod.latin.common.Constants
+import java.io.File
+
+/** Custom key press sounds picked by the user (letters, space, delete, enter). */
+object RasiSounds {
+    const val PREFS = "rasi_sounds"
+    val SLOTS = listOf("letters", "space", "delete", "enter")
+
+    private var appContext: Context? = null
+    private var pool: SoundPool? = null
+    private val ids = HashMap<String, Int>()
+
+    fun prefs(context: Context) = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun dir(context: Context) = File(context.applicationContext.filesDir, "rasi_sounds").also { it.mkdirs() }
+
+    @JvmStatic
+    fun init(context: Context) {
+        appContext = context.applicationContext
+        RasiPerf.init(context)
+        RasiPopup.init(context)
+        reload()
+    }
+
+    fun reload() {
+        val ctx = appContext ?: return
+        pool?.release()
+        ids.clear()
+        val p = SoundPool.Builder()
+            .setMaxStreams(6)
+            .setAudioAttributes(
+                AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                    .build()
+            )
+            .build()
+        pool = p
+        val prefs = prefs(ctx)
+        if (!prefs.getBoolean("enabled", false)) return
+        for (slot in SLOTS) {
+            val name = prefs.getString("file_$slot", null) ?: continue
+            val f = File(dir(ctx), name)
+            if (f.exists()) ids[slot] = p.load(f.absolutePath, 1)
+        }
+    }
+
+    fun fileName(context: Context, slot: String): String? =
+        prefs(context).getString("file_$slot", null)
+
+    fun importSound(context: Context, slot: String, uri: Uri): Boolean {
+        val ctx = context.applicationContext
+        return try {
+            val name = "${slot}_${System.currentTimeMillis()}.snd"
+            val out = File(dir(ctx), name)
+            ctx.contentResolver.openInputStream(uri)?.use { input ->
+                out.outputStream().use { input.copyTo(it) }
+            } ?: return false
+            if (out.length() > 2_000_000L) {
+                out.delete()
+                Toast.makeText(ctx, "Sound is too large, use a short clip (under 2 MB)", Toast.LENGTH_LONG).show()
+                return false
+            }
+            fileName(ctx, slot)?.let { File(dir(ctx), it).delete() }
+            prefs(ctx).edit().putString("file_$slot", name).apply()
+            reload()
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    fun clear(context: Context, slot: String) {
+        val ctx = context.applicationContext
+        fileName(ctx, slot)?.let { File(dir(ctx), it).delete() }
+        prefs(ctx).edit().remove("file_$slot").apply()
+        reload()
+    }
+
+    fun playSlot(slot: String) {
+        val ctx = appContext ?: return
+        val id = ids[slot] ?: ids["letters"] ?: return
+        val v = prefs(ctx).getFloat("volume", 0.8f)
+        pool?.play(id, v, v, 1, 0, 1f)
+    }
+
+    /** True when wired, USB or Bluetooth headphones are connected. */
+    @JvmStatic
+    fun headphonesConnected(): Boolean {
+        val ctx = appContext ?: return false
+        val am = ctx.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return false
+        return try {
+            am.getDevices(AudioManager.GET_DEVICES_OUTPUTS).any {
+                when (it.type) {
+                    android.media.AudioDeviceInfo.TYPE_WIRED_HEADSET,
+                    android.media.AudioDeviceInfo.TYPE_WIRED_HEADPHONES,
+                    android.media.AudioDeviceInfo.TYPE_USB_HEADSET,
+                    android.media.AudioDeviceInfo.TYPE_BLUETOOTH_A2DP,
+                    android.media.AudioDeviceInfo.TYPE_BLUETOOTH_SCO,
+                    26, 27, 23 -> true // BLE headset, BLE speaker, hearing aid
+                    else -> false
+                }
+            }
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /** True when key vibration should ignore battery saver. */
+    @JvmStatic
+    fun vibrateInBatterySaver(): Boolean {
+        val ctx = appContext ?: return false
+        return prefs(ctx).getBoolean("vibrate_battery_saver", false)
+    }
+
+    /** Vibration strength 1..255, or 0 for the phone default. */
+    @JvmStatic
+    fun vibrationStrength(): Int {
+        val ctx = appContext ?: return 0
+        return prefs(ctx).getInt("vibration_strength", 0)
+    }
+
+    /** True when "headphones only" is on and no headphones are connected, so key clicks must stay silent. */
+    @JvmStatic
+    fun mutedWithoutHeadphones(): Boolean {
+        val ctx = appContext ?: return false
+        if (!prefs(ctx).getBoolean("headphones_only", false)) return false
+        return !headphonesConnected()
+    }
+
+    /** Returns true when a custom sound handled this key press (so the system click is skipped). */
+    @JvmStatic
+    fun tryPlay(code: Int): Boolean {
+        val ctx = appContext ?: return false
+        if (ids.isEmpty()) return false
+        if (!prefs(ctx).getBoolean("enabled", false)) return false
+
+        val am = ctx.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        if (am != null && am.ringerMode != AudioManager.RINGER_MODE_NORMAL) return true
+
+        val slot = when (code) {
+            Constants.CODE_DELETE -> "delete"
+            Constants.CODE_ENTER -> "enter"
+            Constants.CODE_SPACE -> "space"
+            else -> "letters"
+        }
+        if (ids[slot] == null && ids["letters"] == null) return false
+        playSlot(slot)
+        return true
+    }
+}
