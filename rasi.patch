+/** Uploads big videos through the Gemini Files API (kept for 48 hours, so follow-up questions reuse them). */
+object RasiGeminiFiles {
+    private const val BASE = "https://generativelanguage.googleapis.com"
+
+    private fun prefs(c: Context) = c.applicationContext.getSharedPreferences("rasi_gemini_files", Context.MODE_PRIVATE)
+
+    private fun cached(c: Context, name: String): String? {
+        val v = prefs(c).getString(name, null) ?: return null
+        val p = v.split("|")
+        if (p.size < 2) return null
+        val exp = p[1].toLongOrNull() ?: return null
+        return if (System.currentTimeMillis() < exp) p[0] else null
+    }
+
+    fun upload(c: Context, key: String, file: File, mime: String): String {
+        cached(c, file.name)?.let { return it }
+        val len = file.length()
+
+        // step 1: ask for an upload address
+        val start = URL("$BASE/upload/v1beta/files").openConnection() as HttpURLConnection
+        val uploadUrl: String
+        try {
+            start.requestMethod = "POST"
+            start.connectTimeout = 20000
+            start.readTimeout = 30000
+            start.doOutput = true
+            start.setRequestProperty("x-goog-api-key", key)
+            start.setRequestProperty("X-Goog-Upload-Protocol", "resumable")
+            start.setRequestProperty("X-Goog-Upload-Command", "start")
+            start.setRequestProperty("X-Goog-Upload-Header-Content-Length", len.toString())
+            start.setRequestProperty("X-Goog-Upload-Header-Content-Type", mime)
+            start.setRequestProperty("Content-Type", "application/json")
+            start.outputStream.use {
+                it.write("{\"file\":{\"display_name\":\"rboard-video\"}}".toByteArray(Charsets.UTF_8))
+            }
+            val code = start.responseCode
+            if (code !in 200..299) {
+                val err = start.errorStream?.bufferedReader()?.use { it.readText() } ?: ""
+                throw RuntimeException("Upload error $code: " + err.take(160))
+            }
+            uploadUrl = start.getHeaderField("X-Goog-Upload-URL") ?: throw RuntimeException("Upload address missing")
+        } finally {
+            start.disconnect()
+        }
+
+        // step 2: send the video
+        val up = URL(uploadUrl).openConnection() as HttpURLConnection
+        val info: JSONObject
+        try {
+            up.requestMethod = "POST"
+            up.connectTimeout = 20000
+            up.readTimeout = 120000
+            up.doOutput = true
+            up.setFixedLengthStreamingMode(len)
+            up.setRequestProperty("X-Goog-Upload-Offset", "0")
+            up.setRequestProperty("X-Goog-Upload-Command", "upload, finalize")
+            up.outputStream.use { o ->
+                file.inputStream().use { i ->
+                    val buf = ByteArray(65536)
+                    while (true) {
+                        val r = i.read(buf)
+                        if (r < 0) break
+                        o.write(buf, 0, r)
+                    }
+                }
+            }
+            val code = up.responseCode
+            val text = (if (code in 200..299) up.inputStream else up.errorStream)?.bufferedReader()?.use { it.readText() } ?: ""
+            if (code !in 200..299) throw RuntimeException("Upload error $code: " + text.take(160))
+            info = JSONObject(text).getJSONObject("file")
+        } finally {
+            up.disconnect()
+        }
+
+        // step 3: wait until Google has processed the video
+        val fileName = info.getString("name")
+        var uri = info.getString("uri")
+        var state = info.optString("state", "ACTIVE")
+        var waited = 0
+        while (state == "PROCESSING" && waited < 120) {
+            Thread.sleep(2000)
+            waited += 2
+            val g = URL("$BASE/v1beta/$fileName").openConnection() as HttpURLConnection
+            try {
+                g.connectTimeout = 15000
+                g.readTimeout = 30000
+                g.setRequestProperty("x-goog-api-key", key)
+                if (g.responseCode in 200..299) {
+                    val o = JSONObject(g.inputStream.bufferedReader().use { it.readText() })
+                    state = o.optString("state", "ACTIVE")
+                    uri = o.optString("uri", uri)
+                }
+            } finally {
+                g.disconnect()
+            }
+        }
+        if (state == "FAILED") throw RuntimeException("Google could not process this video")
+        if (state == "PROCESSING") throw RuntimeException("The video is still processing, try again in a minute")
+
+        prefs(c).edit().putString(file.name, uri + "|" + (System.currentTimeMillis() + 46L * 3600L * 1000L)).apply()
+        return uri
+    }
+}
