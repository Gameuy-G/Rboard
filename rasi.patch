+    // ---- more styles ----
+    private class Ripple(val born: Long, val t: Float)
+    private var ripples = ArrayList<Ripple>()
+    private var rippleLast = 0L
+    private val previewRipples = ArrayList<Ripple>()
+
+    private fun frac(x: Float): Float = x - Math.floor(x.toDouble()).toFloat()
+
+    private fun withA(c: Int, a: Int): Int = AColor.argb(a.coerceIn(0, 255), AColor.red(c), AColor.green(c), AColor.blue(c))
+
+    private fun band(a: Int, b: Int, sens: Float): Float {
+        var sum = 0f
+        for (i in a until b) sum += disp[i]
+        return (sum / (b - a) * sens).coerceIn(0f, 1f)
+    }
+
+    private fun drawMore(
+        canvas: Canvas, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float
+    ): Boolean {
+        if (!isFree(style)) return false
+        val t = (col.now % 600000L) / 1000f
+        val pi = Math.PI.toFloat()
+        paint.shader = null
+        paint.style = Paint.Style.FILL
+        when (style) {
+            "aurora" -> {
+                val amps = floatArrayOf(band(0, 8, sens), band(8, 28, sens), band(28, N, sens * 1.6f))
+                val steps = 36
+                for (layer in 0..2) {
+                    val baseY = h - h * (0.06f + 0.10f * layer)
+                    val amp = h * (0.12f + 0.30f * amps[layer])
+                    val dir = if (layer == 1) -1f else 1f
+                    extraPath.reset()
+                    extraPath.moveTo(0f, h)
+                    for (i in 0..steps) {
+                        val ph = i * (0.32f + 0.1f * layer) + t * (0.9f + 0.5f * layer) * dir
+                        val y = baseY - amp * (0.55f + 0.3f * sin(ph) + 0.15f * sin(ph * 2.3f + layer))
+                        extraPath.lineTo(w * i / steps, y)
+                    }
+                    extraPath.lineTo(w, h)
+                    extraPath.close()
+                    val c = col.at(layer / 2f)
+                    paint.shader = android.graphics.LinearGradient(
+                        0f, baseY - amp, 0f, h, withA(c, (alpha * 0.75f).toInt()), withA(c, 0), Shader.TileMode.CLAMP
+                    )
+                    canvas.drawPath(extraPath, paint)
+                }
+                paint.shader = null
+            }
+            "scope" -> {
+                val cy = h / 2f
+                val amp = h * 0.40f
+                val steps = 110
+                extraPath.reset()
+                for (i in 0..steps) {
+                    val u = i / steps.toFloat()
+                    var y = 0f
+                    for (k in 0 until 12) {
+                        val lv = (disp[k * 4] * sens).coerceIn(0f, 1f)
+                        y += lv * sin(u * (k + 1) * pi * 1.5f + t * (2f + k * 0.7f)) / (1f + k * 0.35f)
+                    }
+                    val env = 0.35f + 0.65f * sin(u * pi)
+                    val yy = cy - amp * (y / 2.2f).coerceIn(-1f, 1f) * env
+                    if (i == 0) extraPath.moveTo(0f, yy) else extraPath.lineTo(w * u, yy)
+                }
+                paint.shader = android.graphics.LinearGradient(0f, 0f, w, 0f, col.at(0f), col.at(1f), Shader.TileMode.CLAMP)
+                paint.style = Paint.Style.STROKE
+                paint.strokeJoin = Paint.Join.ROUND
+                paint.strokeWidth = 8f * dens
+                paint.alpha = alpha / 4
+                canvas.drawPath(extraPath, paint)
+                paint.strokeWidth = 2.5f * dens
+                paint.alpha = alpha
+                canvas.drawPath(extraPath, paint)
+                paint.shader = null
+            }
+            "sunburst" -> {
+                val n = 56
+                val cx = w / 2f
+                val cy = h
+                val r0 = h * 0.10f
+                val maxLen = h * 0.85f - r0
+                paint.style = Paint.Style.STROKE
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.strokeWidth = maxOf(2f * dens, (pi * r0 * 2f / n) * 0.8f)
+                for (j in 0 until n) {
+                    val u = (j + 0.5f) / n
+                    val ang = pi + pi * u
+                    val lv = (at(disp, Math.abs(2f * u - 1f) * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val len = maxLen * (0.08f + 0.92f * lv)
+                    val ca = Math.cos(ang.toDouble()).toFloat()
+                    val sa = Math.sin(ang.toDouble()).toFloat()
+                    paint.color = col.at(1f - Math.abs(2f * u - 1f)); paint.alpha = alpha
+                    canvas.drawLine(cx + ca * r0, cy + sa * r0, cx + ca * (r0 + len), cy + sa * (r0 + len), paint)
+                }
+                paint.strokeCap = Paint.Cap.BUTT
+            }
+            "ripples" -> {
+                val now = col.now
+                val b = (bass * sens).coerceIn(0f, 1f)
+                if (b > 0.62f && now - rippleLast > 320L) {
+                    ripples.add(Ripple(now, Math.random().toFloat())); rippleLast = now
+                }
+                val cx = w / 2f
+                val cy = h / 2f
+                val maxR = minOf(w, h * 1.3f) * 0.6f
+                val it = ripples.iterator()
+                paint.style = Paint.Style.STROKE
+                while (it.hasNext()) {
+                    val rp = it.next()
+                    val age = (now - rp.born) / 1700f
+                    if (age >= 1f) { it.remove(); continue }
+                    val r = maxR * (1f - (1f - age) * (1f - age))
+                    paint.color = col.at(rp.t)
+                    paint.alpha = (alpha * (1f - age)).toInt().coerceIn(0, 255)
+                    paint.strokeWidth = (2f + 6f * (1f - age)) * dens
+                    canvas.drawCircle(cx, cy, r, paint)
+                }
+                paint.style = Paint.Style.FILL
+                paint.color = col.at(0.5f); paint.alpha = alpha
+                canvas.drawCircle(cx, cy, minOf(w, h) * 0.05f * (0.8f + 0.6f * b), paint)
+            }
+            "stars" -> {
+                val cx = w / 2f
+                val cy = h / 2f
+                val maxR = hypot(w, h) / 2f
+                val b = (bass * sens).coerceIn(0f, 1f)
+                paint.style = Paint.Style.STROKE
+                paint.strokeCap = Paint.Cap.ROUND
+                for (i in 0 until 70) {
+                    val seed = i * 12.9898f
+                    val ang = frac(sin(seed) * 43758.547f) * 2f * pi
+                    val spd = 0.08f + 0.12f * frac(sin(seed * 1.7f) * 9631.1f)
+                    val ph = frac(sin(seed * 3.1f) * 1273.7f)
+                    val u = (ph + t * spd) % 1f
+                    val r = maxR * u * u
+                    val r1 = r * (1f - 0.05f - 0.12f * b)
+                    val ca = Math.cos(ang.toDouble()).toFloat()
+                    val sa = Math.sin(ang.toDouble()).toFloat()
+                    paint.strokeWidth = (0.8f + 2.8f * u + 2f * b * u) * dens
+                    paint.color = col.at(frac(sin(seed * 5.3f) * 517.3f))
+                    paint.alpha = (alpha * (0.25f + 0.75f * u)).toInt().coerceIn(0, 255)
+                    canvas.drawLine(cx + ca * r1, cy + sa * r1, cx + ca * r, cy + sa * r, paint)
+                }
+                paint.strokeCap = Paint.Cap.BUTT
+            }
+            "concentric" -> {
+                val cx = w / 2f
+                val cy = h / 2f
+                val rMax = minOf(w, h) * 0.5f
+                val rings = 6
+                paint.style = Paint.Style.STROKE
+                for (k in 0 until rings) {
+                    val lv = band(k * 10, k * 10 + 10, sens * (1f + k * 0.25f))
+                    val r = rMax * (0.22f + 0.78f * (k + 1) / rings) * 0.85f + lv * rMax * 0.12f
+                    paint.strokeWidth = (2f + 6f * lv) * dens
+                    paint.color = col.at(k / (rings - 1f))
+                    paint.alpha = (alpha * (0.35f + 0.65f * lv)).toInt().coerceIn(0, 255)
+                    canvas.drawCircle(cx, cy, r, paint)
+                }
+            }
+        }
+        paint.shader = null
+        paint.style = Paint.Style.FILL
+        return true
+    }
