+    android.graphics.Color.colorToHSV(start, hsv)
+    var hue by remember { mutableFloatStateOf(hsv[0]) }
+    var sat by remember { mutableFloatStateOf(hsv[1]) }
+    var bri by remember { mutableFloatStateOf(hsv[2]) }
+    val color = android.graphics.Color.HSVToColor(floatArrayOf(hue, sat, bri))
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        Text(label)
+        Spacer(
+            Modifier.size(28.dp).clip(CircleShape)
+                .background(androidx.compose.ui.graphics.Color(color))
+        )
+    }
+    fun save() { prefs.edit().putInt(key, color).apply(); RasiNowPlaying.notifyChanged() }
+    Slider(value = hue, onValueChange = { hue = it }, valueRange = 0f..360f, onValueChangeFinished = { save() })
+    Slider(value = sat, onValueChange = { sat = it }, valueRange = 0f..1f, onValueChangeFinished = { save() })
+    Slider(value = bri, onValueChange = { bri = it }, valueRange = 0.2f..1f, onValueChangeFinished = { save() })
+}
+
+@Composable
+fun RasiBeatColorSection(prefs: SharedPreferences) {
+    var on by remember { mutableStateOf(prefs.getBoolean("viz_bc_on", false)) }
+    var mode by remember { mutableStateOf(prefs.getString("viz_bc_mode", "auto") ?: "auto") }
+    RasiSection("Beat colors")
+    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+        Column(Modifier.weight(1.0f)) {
+            Text("Color by beat strength")
+            Text("Weak beats show pale colors, strong beats show deep colors. Replaces the color source above while on. In Performance mode the colors stay a fixed weak/strong mix.", style = MaterialTheme.typography.bodySmall)
+        }
+        Switch(checked = on, onCheckedChange = {
+            on = it; prefs.edit().putBoolean("viz_bc_on", it).apply(); RasiNowPlaying.notifyChanged()
+        })
+    }
+    if (!on) return
+    RasiOptionRows(
+        listOf("auto" to "Auto (from the thumbnail)", "manual" to "Manual colors"),
+        mode
+    ) { mode = it; prefs.edit().putString("viz_bc_mode", it).apply(); RasiNowPlaying.notifyChanged() }
+    if (mode == "manual") {
+        RasiColorPickSV(prefs, "viz_bc_w1", "Weak color 1", 0xFFFFE3E3.toInt())
+        RasiColorPickSV(prefs, "viz_bc_w2", "Weak color 2", 0xFFFFB0B0.toInt())
+        RasiColorPickSV(prefs, "viz_bc_s1", "Strong color 1", 0xFFB3001B.toInt())
+        RasiColorPickSV(prefs, "viz_bc_s2", "Strong color 2", 0xFF6A0010.toInt())
+    }
+    RasiPrefSlider(prefs, "viz_bc_sens", "Beat strength sensitivity", " %", 100, 20, 200)
+    RasiPrefSlider(prefs, "viz_bc_thr", "Weak / strong threshold", " %", 50, 10, 90)
+    RasiPrefSlider(prefs, "viz_bc_curve", "Blend curve (0 linear, 1 soft, 2 sharp)", "", 1, 0, 2)
+    RasiPrefSlider(prefs, "viz_bc_speed", "Color speed", " %", 60, 10, 100)
+    RasiPrefSlider(prefs, "viz_bc_smooth", "Fade-out smoothing", " %", 50, 0, 100)
+    RasiPrefSlider(prefs, "viz_bc_hold", "Hold the strong color", " ms", 100, 0, 600)
+    RasiPrefSlider(prefs, "viz_bc_glow", "Glow boost (0 = off)", " %", 40, 0, 100)
+    RasiPrefSlider(prefs, "viz_bc_flash", "Beat flash of the strong color (0 = off)", " %", 60, 0, 100)
+    RasiPrefSwitch(prefs, "viz_bc_viz", "Apply to the visualizer", "Keyboard and navigation strip visualizer.", true)
+    RasiPrefSwitch(prefs, "viz_bc_pill", "Apply to the floating pill", "The music pill visualizer.", true)
+}
