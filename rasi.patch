+    id 'com.google.gms.google-services' version '4.4.2'
 }
 
 def getVersionCode = { ->
@@ -181,6 +182,17 @@ tasks.register('updateContributors') {
 
 preBuild.dependsOn updateLocales
 
+// Rasi: fingerprint (git blob sha) of rasi.patch, so the app can tell if GitHub has a newer one
+def rasiPatchId() {
+    def f = file('rasi.patch')
+    if (!f.exists()) return 'dev'
+    def bytes = f.bytes
+    def md = java.security.MessageDigest.getInstance('SHA-1')
+    md.update(("blob " + bytes.length + "\u0000").getBytes('UTF-8'))
+    md.update(bytes)
+    return md.digest().collect { String.format('%02x', it) }.join()
+}
