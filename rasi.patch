+import org.futo.inputmethod.latin.uix.settings.rasiGlass
+
+/**
+ * A scrolling settings page with a "Try typing here" button pinned at the bottom (same as the start
+ * page). It brings up the keyboard, so changes like moving the visualizer can be watched live.
+ */
+@Composable
+fun RasiScrollableWithKeyboardButton(content: @Composable () -> Unit) {
+    val context = LocalContext.current
+    Column(Modifier.fillMaxSize()) {
+        Box(Modifier.weight(1.0f).fillMaxWidth()) {
+            ScrollableList { content() }
+        }
+        TextButton(
+            onClick = {
+                val intent = Intent()
+                intent.setClass(context, TextEditPopupActivity::class.java)
+                intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+                context.startActivity(intent)
+            },
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 10.dp, vertical = 6.dp)
+                .rasiGlass(androidx.compose.foundation.shape.RoundedCornerShape(24.dp), 0.8f)
+        ) {
+            Text(
+                stringResource(R.string.settings_try_typing_here),
+                color = MaterialTheme.colorScheme.onBackground.copy(alpha = 0.7f),
+                modifier = Modifier.fillMaxWidth()
+            )
+        }
+    }
+}
