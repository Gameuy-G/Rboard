+
+val LAST_SEEN_CHANGELOG = SettingsKey(stringPreferencesKey("rboard_last_seen_changelog"), "")
+
+@Composable
+fun ChangelogDialog(onDismiss: () -> Unit) {
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        confirmButton = { TextButton(onClick = onDismiss) { Text("OK") } },
+        title = { Text("What's new") },
+        text = {
+            Column(Modifier.verticalScroll(rememberScrollState())) {
+                RboardVersion.RELEASES.forEach { release ->
+                    Text("v${release.version} - ${release.title}")
+                    Spacer(Modifier.height(4.dp))
+                    release.notes.forEach { Text("\u2022 $it") }
+                    Spacer(Modifier.height(12.dp))
+                }
+            }
+        }
+    )
+}
+
+// Shows the changelog once, the first time the settings app opens after an update.
+@Composable
+fun RboardChangelogHost() {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val lastSeen = useDataStoreValue(LAST_SEEN_CHANGELOG)
+    var dismissed by remember { mutableStateOf(false) }
+
+    if (!dismissed && lastSeen != RboardVersion.NAME) {
+        ChangelogDialog(onDismiss = {
+            dismissed = true
+            scope.launch { context.setSetting(LAST_SEEN_CHANGELOG, RboardVersion.NAME) }
+        })
+    }
+}
