+
+/** One Emoji Kitchen mashup picture (hosted by Google). */
+data class KitchenCombo(val left: String, val right: String, val date: String) {
+    val key: String get() = left + "_" + right + "_" + date
+    val url: String
+        get() {
+            fun u(c: String) = "u" + c.replace("-", "-u")
+            return "https://www.gstatic.com/android/keyboard/emojikitchen/$date/${u(left)}/${u(left)}_${u(right)}.png"
+        }
+}
+
+/** What the keyboard currently knows about the text before the cursor. */
+data class RasiCtx(
+    val text: String = "",
+    val combos: List<KitchenCombo> = emptyList(),
+    val lastEmoji: String? = null,
+    val prevEmoji: String? = null,
+    val pairCombo: KitchenCombo? = null,
+    val phrase: String? = null
+)
+
+object RasiBarState {
+    /** True while the 8-mashup strip is open in the suggestion bar. */
+    val open = mutableStateOf(false)
+}
+
+object RasiKitchen {
+    private var loaded = false
+    private val byCode = HashMap<String, ArrayList<KitchenCombo>>()
+    private val pairs = HashMap<String, KitchenCombo>()
+    private val normToKnown = HashMap<String, String>()
+    private val memCache = object : android.util.LruCache<String, ImageBitmap>(60) {}
+
+    private fun norm(code: String) = code.split("-").filter { it != "fe0f" }.joinToString("-")
+
+    @Synchronized
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        try {
+            val lines = context.resources.openRawResource(R.raw.rasi_kitchen)
+                .bufferedReader().use { it.readLines() }
+            val known = lines[0].split(",")
+            val dates = lines[1].split(",")
+            known.forEach { normToKnown[norm(it)] = it }
+            for (i in 2 until lines.size) {
+                val line = lines[i]
+                val colon = line.indexOf(':')
+                if (colon < 0) continue
+                val left = known[line.substring(0, colon).toInt(36)]
+                for (part in line.substring(colon + 1).split(' ')) {
+                    val dot = part.indexOf('.')
+                    if (dot < 0) continue
+                    val right = known[part.substring(0, dot).toInt(36)]
+                    val combo = KitchenCombo(left, right, dates[part.substring(dot + 1).toInt(36)])
+                    pairs[left + "_" + right] = combo
+                    byCode.getOrPut(left) { ArrayList() }.add(combo)
+                    if (right != left) byCode.getOrPut(right) { ArrayList() }.add(combo)
+                }
+            }
+            loaded = true
+        } catch (e: Exception) {
+            // Kitchen simply stays unavailable
+        }
+    }
+
+    fun codeOf(emoji: String): String? {
+        val parts = ArrayList<String>()
+        var i = 0
+        while (i < emoji.length) {
+            val cp = emoji.codePointAt(i)
+            i += Character.charCount(cp)
+            if (cp in 0x1F3FB..0x1F3FF) continue // skin tones
+            parts.add(Integer.toHexString(cp))
+        }
+        if (parts.isEmpty()) return null
+        return normToKnown[norm(parts.joinToString("-"))]
+    }
+
+    /** Kitchen combos for one emoji the user just tapped (before the text field has updated). */
+    fun combosForEmoji(context: Context, emoji: String): List<KitchenCombo> {
+        ensureLoaded(context)
+        val c = codeOf(emoji) ?: return emptyList()
+        return combosFor(c, null)
+    }
+
+    fun combosFor(x: String?, y: String?): List<KitchenCombo> {
+        var a = x
+        var b = y
+        if (a == null) { a = b; b = null }
+        if (a == null) return emptyList()
+        val out = LinkedHashMap<String, KitchenCombo>()
+        fun add(c: KitchenCombo?) {
+            if (c != null && out.size < 8) out.putIfAbsent(c.left + "_" + c.right, c)
+        }
+        if (b != null) {
+            add(pairs[a + "_" + b]); add(pairs[b + "_" + a])
+        } else {
+            add(pairs[a + "_" + a])
+        }
+        val la = byCode[a] ?: emptyList<KitchenCombo>()
+        val lb = if (b != null) (byCode[b] ?: emptyList<KitchenCombo>()) else emptyList<KitchenCombo>()
+        var i = 0
+        while (out.size < 8 && (i < la.size || i < lb.size)) {
+            if (i < la.size) add(la[i])
+            if (i < lb.size) add(lb[i])
+            i++
+        }
+        return out.values.toList()
+    }
+
+    /** Every combo for the last typed emoji (c1) and/or the one before it (c2); pair first. */
+    fun allFor(emoji1: String?, emoji2: String?): List<KitchenCombo> {
+        val c1 = emoji1?.let { codeOf(it) }
+        val c2 = emoji2?.let { codeOf(it) }
+        val out = LinkedHashMap<String, KitchenCombo>()
+        fun add(c: KitchenCombo?) { if (c != null) out.putIfAbsent(c.left + "_" + c.right, c) }
+        if (c1 != null && c2 != null) { add(pairs[c2 + "_" + c1]); add(pairs[c1 + "_" + c2]) }
+        c1?.let { k -> byCode[k]?.forEach { add(it) } }
+        c2?.let { k -> byCode[k]?.forEach { add(it) } }
+        return out.values.toList()
+    }
+
+    val recents = mutableStateOf<List<KitchenCombo>>(emptyList())
+    private var recentsLoaded = false
+
+    private fun fromKey(k: String): KitchenCombo? {
+        val p = k.split("_")
+        return if (p.size == 3) KitchenCombo(p[0], p[1], p[2]) else null
+    }
+
+    fun loadRecents(context: Context) {
+        if (recentsLoaded) return
+        recentsLoaded = true
+        val raw = context.getSharedPreferences("rasi_kitchen_prefs", Context.MODE_PRIVATE)
+            .getString("recent", "") ?: ""
+        recents.value = raw.split(",").filter { it.isNotEmpty() }.mapNotNull { fromKey(it) }
+    }
+
+    fun addRecent(context: Context, combo: KitchenCombo) {
+        loadRecents(context)
+        val list = (listOf(combo) + recents.value.filter { it.key != combo.key }).take(12)
+        recents.value = list
+        context.getSharedPreferences("rasi_kitchen_prefs", Context.MODE_PRIVATE).edit()
+            .putString("recent", list.joinToString(",") { it.key }).apply()
+    }
+
+    val liked = mutableStateOf<List<KitchenCombo>>(emptyList())
+    private var likedLoaded = false
+
+    fun loadLiked(context: Context) {
+        if (likedLoaded) return
+        likedLoaded = true
+        val raw = context.getSharedPreferences("rasi_kitchen_prefs", Context.MODE_PRIVATE)
+            .getString("liked", "") ?: ""
+        liked.value = raw.split(",").filter { it.isNotEmpty() }.mapNotNull { fromKey(it) }
+    }
+
+    fun toggleLiked(context: Context, combo: KitchenCombo) {
+        loadLiked(context)
+        val cur = liked.value
+        val list = if (cur.any { it.key == combo.key }) cur.filter { it.key != combo.key } else listOf(combo) + cur
+        liked.value = list
+        context.getSharedPreferences("rasi_kitchen_prefs", Context.MODE_PRIVATE).edit()
+            .putString("liked", list.joinToString(",") { it.key }).apply()
+    }
+
+    private fun isEmojiLike(cluster: String): Boolean {
+        var i = 0
+        while (i < cluster.length) {
+            val cp = cluster.codePointAt(i)
+            i += Character.charCount(cp)
+            if (cp in 0x1F000..0x1FAFF || cp in 0x2600..0x27BF || cp in 0x2B00..0x2BFF) return true
+        }
+        return false
+    }
+
+    fun analyze(context: Context, rawText: String): RasiCtx {
+        ensureLoaded(context)
+        // Spaces/newlines after an emoji must not end the combo suggestions; only a new letter does
+        val text = rawText.trimEnd()
+        if (text.isEmpty()) return RasiCtx(text = text)
+
+        val bi = BreakIterator.getCharacterInstance()
+        bi.setText(text)
+        val run = ArrayList<String>()
+        var end = bi.last()
+        var start = bi.previous()
+        var runStart = text.length
+        while (start != BreakIterator.DONE && run.size < 12) {
+            val cluster = text.substring(start, end)
+            if (!isEmojiLike(cluster)) break
+            run.add(cluster)
+            runStart = start
+            end = start
+            start = bi.previous()
+        }
+        if (run.isEmpty()) return RasiCtx(text = text)
+
+        val codes = run.take(2).mapNotNull { codeOf(it) }
+        val combos = combosFor(codes.getOrNull(1), codes.getOrNull(0))
+        val c1 = codeOf(run[0])
+        val c2 = run.getOrNull(1)?.let { codeOf(it) }
+        val pairCombo = if (c1 != null && c2 != null) (pairs[c2 + "_" + c1] ?: pairs[c1 + "_" + c2]) else null
+
+        var phrase = text.substring(0, runStart).trim()
+        phrase = phrase.substringAfterLast('\n').trim()
+        if (phrase.length > 60) phrase = phrase.takeLast(60).trim()
+        return RasiCtx(
+            text = text,
+            combos = combos,
+            lastEmoji = run[0],
+            prevEmoji = run.getOrNull(1),
+            pairCombo = pairCombo,
+            phrase = if (phrase.isEmpty()) null else phrase
+        )
+    }
+
+    /** Removes the emoji (or the emoji pair) the user typed, so the sticker replaces it. */
+    fun deleteTyped(manager: KeyboardManagerForAction, ctx: RasiCtx, combo: KitchenCombo) {
+        try {
+            val ic = manager.getLatinIMEForDebug()?.currentInputConnection ?: return
+            val before = ic.getTextBeforeCursor(300, 0)?.toString() ?: return
+            val a = ctx.lastEmoji ?: return
+            val b = ctx.prevEmoji
+            val ca = codeOf(a)
+            val cb = b?.let { codeOf(it) }
+            val two = b != null && ca != null && cb != null &&
+                setOf(norm(combo.left), norm(combo.right)) == setOf(norm(ca), norm(cb))
+            val trailing = before.length - before.trimEnd().length
+            val len = trailing + a.length + (if (two) b!!.length else 0)
+            if (len <= before.length) ic.deleteSurroundingText(len, 0)
+        } catch (e: Exception) {
+        }
+    }
+
+    fun fetch(context: Context, combo: KitchenCombo): File? {
+        val dir = File(context.cacheDir, "rasi_kitchen")
+        dir.mkdirs()
+        val f = File(dir, combo.key + ".png")
+        if (f.exists() && f.length() > 0) return f
+        return try {
+            val conn = java.net.URL(combo.url).openConnection() as java.net.HttpURLConnection
+            conn.connectTimeout = 8000
+            conn.readTimeout = 10000
+            if (conn.responseCode != 200) {
+                conn.disconnect()
+                null
+            } else {
+                val tmp = File(dir, combo.key + ".tmp")
+                conn.inputStream.use { i -> tmp.outputStream().use { o -> i.copyTo(o) } }
+                conn.disconnect()
+                tmp.renameTo(f)
+                f
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    suspend fun loadImage(context: Context, combo: KitchenCombo): ImageBitmap? {
+        memCache.get(combo.key)?.let { return it }
+        return withContext(Dispatchers.IO) {
+            val file = fetch(context, combo) ?: return@withContext null
+            val opts = BitmapFactory.Options()
+            opts.inSampleSize = 2
+            val bmp = try {
+                BitmapFactory.decodeFile(file.absolutePath, opts)?.asImageBitmap()
+            } catch (e: Exception) {
+                null
+            }
+            if (bmp != null) memCache.put(combo.key, bmp)
+            bmp
+        }
+    }
+
+    fun sendFile(manager: KeyboardManagerForAction, file: File, mime: String = "image/png") {
+        val id = ClipboardProviderState.addRequest(
+            ClipboardPasteRequest(
+                file = file,
+                mimeType = mime,
+                expiration = System.currentTimeMillis() + 5L * 60L * 1000L
+            )
+        )
+        val uri = Uri.parse("content://${CLIPBOARD_AUTHORITY}/clip/$id")
+        manager.typeUri(uri, listOf(mime), true)
+    }
+}
