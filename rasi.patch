@@ -0,0 +1,69 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+
+/** Developer switches: which music connection methods may be used (all on by default). */
+object RasiMethods {
+    private const val PREFS = "rasi_dev"
+
+    @Volatile var root = true
+    @Volatile var shizuku = true
+    @Volatile var player = true
+    @Volatile var mix = true
+    @Volatile var smart = true
+    @Volatile var capture = true
+    /** On: the nav-strip bars copy exactly what the keyboard drew (one continuous row). Off: the old separate row. */
+    @Volatile var stripAligned = true
+    /** On: the right-hand (high) bars get a smooth boost so they reach as high as the rest. Off: the old shape. */
+    @Volatile var smoothBars = true
+    /** On: the old beat sync (reacts when bass is loud). Off: the new rhythm detector (kicks and drums). */
+    @Volatile var beatOld = false
+    /** On: the Beat shake options appear in the visualizer settings (off by default). */
+    @Volatile var shakes = false
+    /** On: the music master switch also turns the keyboard visual effects on and off together with the visualizer. */
+    @Volatile var fxMaster = false
+    /** On: the old FUTO symbols pages. Off (default): the Gboard-style symbols pages (same keys and places as Gboard). */
+    @Volatile var classicSymbols = false
+    /** On (default): the shift key is a filled arrow while shifted, like Gboard. Off: the old outlined arrow with an underline. */
+    @Volatile var filledShift = true
+    /** How the Shizuku/root player lookup reads dumpsys audio: 0 auto, 1 Android 10-12 style, 2 Android 13+ style. */
+    @Volatile var shzFmt = 0
+    @Volatile private var loaded = false
+
+    fun init(context: Context) {
+        if (loaded) return
+        val p = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        root = p.getBoolean("m_root", true)
+        shizuku = p.getBoolean("m_shizuku", true)
+        player = p.getBoolean("m_player", true)
+        mix = p.getBoolean("m_mix", true)
+        smart = p.getBoolean("m_smart", true)
+        capture = p.getBoolean("m_capture", true)
+        stripAligned = p.getBoolean("m_strip_aligned", true)
+        smoothBars = p.getBoolean("m_smooth_bars", true)
+        beatOld = p.getBoolean("m_beat_old", false)
+        shakes = p.getBoolean("m_shakes", false)
+        fxMaster = p.getBoolean("m_fx_master", false)
+        classicSymbols = p.getBoolean("m_classic_symbols", false)
+        filledShift = p.getBoolean("m_filled_shift", true)
+        shzFmt = p.getInt("m_shz_fmt", 0).coerceIn(0, 2)
+        loaded = true
+    }
+
+    fun setShzFmt(context: Context, v: Int) {
+        init(context)
+        shzFmt = v.coerceIn(0, 2)
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putInt("m_shz_fmt", shzFmt).apply()
+        RasiNowPlayingViz.retryReal()
+    }
+
+    fun set(context: Context, which: String, on: Boolean) {
+        init(context)
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putBoolean("m_$which", on).apply()
+        when (which) { "root" -> root = on; "shizuku" -> shizuku = on; "player" -> player = on; "mix" -> mix = on; "smart" -> smart = on; "capture" -> capture = on; "strip_aligned" -> stripAligned = on; "smooth_bars" -> smoothBars = on; "beat_old" -> { beatOld = on; RasiBeat.reset() }; "shakes" -> shakes = on; "fx_master" -> fxMaster = on; "classic_symbols" -> classicSymbols = on; "filled_shift" -> filledShift = on }
+        if (which == "capture" && !on) RasiCapture.stop(context)
+        RasiNowPlayingViz.retryReal()
+        RasiNowPlaying.notifyChanged()
+    }
+}
