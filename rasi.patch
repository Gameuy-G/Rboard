+    /** Returns true if [style] is one of the extra styles and was drawn. */
+    // ---- batch 8: ten more styles (one shared draw function for the keyboard and the previews) ----
+    fun isNew(style: String) = style == "flames" || style == "fireflies" || style == "lava" || style == "lightning" || style == "rain" ||
+        style == "heartbeat" || style == "waterfall" || style == "fountain" || style == "tunnel" ||
+        style == "fireworks" || style == "ribbons" || isB9(style)
+
+    private var previewMode = false
+    private var previewBeat = 0f
+    private var previewSeed = 0
+    private val hist = Array(32) { FloatArray(N) }
+    private var histHead = 0
+    private var histAt = 0L
+
+    private fun hash(n: Int): Float {
+        val x = Math.sin(n * 12.9898 + 78.233) * 43758.5453
+        return (x - Math.floor(x)).toFloat()
+    }
+
+    private fun ecg(ph: Float): Float {
+        fun g(x: Float, c: Float, wd: Float) = Math.exp((-(x - c) * (x - c) / (wd * wd)).toDouble()).toFloat()
+        return 0.12f * g(ph, 0.18f, 0.035f) - 0.12f * g(ph, 0.30f, 0.012f) + g(ph, 0.33f, 0.011f) -
+            0.28f * g(ph, 0.365f, 0.014f) + 0.22f * g(ph, 0.58f, 0.05f)
+    }
+
+    private fun histVal(r: Int, bin: Int, nowSec: Float): Float {
+        if (previewMode) {
+            return (0.25f + 0.75f * abs(sin(nowSec * 3f - r * 0.5f + bin * 0.35f))) * (1f - bin / N.toFloat() * 0.6f)
+        }
+        return hist[(histHead - r + 64) % 32][bin]
+    }
+
+    private fun drawBolt(canvas: Canvas, px: FloatArray, py: FloatArray, n: Int, c: Int, alpha: Int, k: Float, dens: Float, size: Float) {
+        extraPath.reset()
+        extraPath.moveTo(px[0], py[0])
+        for (s in 1..n) extraPath.lineTo(px[s], py[s])
+        paint.style = Paint.Style.STROKE
+        paint.strokeCap = Paint.Cap.ROUND
+        paint.strokeJoin = Paint.Join.ROUND
+        paint.strokeWidth = dens * (5f + 5f * size)
+        paint.color = withA(c, (alpha * 0.25f * k).toInt())
+        canvas.drawPath(extraPath, paint)
+        paint.strokeWidth = dens * (1.4f + 1.6f * size)
+        paint.color = withA(lerpC(c, AColor.WHITE, 0.6f), (alpha * k).toInt())
+        canvas.drawPath(extraPath, paint)
+    }
