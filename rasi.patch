--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiSecret.kt
@@ -0,0 +1,29 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+
+/** Master switch for the secret languages (Rasi, Wingdings, uwu, Binary). Off by default. */
+object RasiSecret {
+    private const val PREFS = "rasi_dev"
+    private const val KEY = "secret_languages"
+
+    @Volatile private var loaded = false
+
+    fun init(context: Context) {
+        if (loaded) return
+        val on = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getBoolean(KEY, false)
+        RasiMap.secret = on
+        loaded = true
+    }
+
+    fun isOn(context: Context): Boolean { init(context); return RasiMap.secret }
+
+    fun set(context: Context, on: Boolean) {
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putBoolean(KEY, on).apply()
+        RasiMap.secret = on
+        if (!on) RasiMap.enabled = false
+        loaded = true
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiSettingsAmbience.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiSettingsAmbience.kt
new file mode 100644
index 000000000..ad1c8d307
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiSettingsAmbience.kt
@@ -0,0 +1,120 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.graphics.Canvas
+import android.graphics.Color as AColor
+import android.graphics.Paint
+import androidx.compose.foundation.Canvas as ComposeCanvas
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.drawscope.drawIntoCanvas
+import androidx.compose.ui.graphics.nativeCanvas
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.viewinterop.AndroidView
+
+/** Song cover, song colors and visualizer as ambience behind the settings screens. */
+object RasiSettingsAmbience {
+    private fun on(p: SharedPreferences, key: String) = p.getBoolean(key, true)
+
+    private fun tone(h: Float, s: Float, v: Float) =
+        Color(AColor.HSVToColor(floatArrayOf(h, s.coerceIn(0f, 1f), v.coerceIn(0f, 1f))))
+
+    private fun pal(c: Context): RasiPalette? {
+        if (!on(RasiNowPlaying.live(c), "set_gradient")) return null
+        val art = RasiNowPlaying.track?.art ?: return null
+        val p = RasiNowPlayingTheme.palette(art) ?: return null
+        return if (p.s1 > 0f) p else null
+    }
+
+    /** Vertical gradient from the two main cover colors, or null when off or nothing plays. */
+    fun brush(c: Context, dark: Boolean, tick: Int): Brush? {
+        val p = pal(c) ?: return null
+        val h2 = if (p.s2 > 0f) p.h2 else p.h1
+        val s2 = if (p.s2 > 0f) p.s2 else p.s1
+        return if (dark) Brush.verticalGradient(listOf(tone(p.h1, p.s1 * 0.8f, 0.24f), tone(h2, s2 * 0.8f, 0.16f), tone(p.h1, p.s1 * 0.7f, 0.09f)))
+        else Brush.verticalGradient(listOf(tone(p.h1, p.s1 * 0.30f, 0.97f), tone(h2, s2 * 0.30f, 0.95f), tone(p.h1, p.s1 * 0.25f, 0.98f)))
+    }
+
+    fun blobColors(c: Context, dark: Boolean, tick: Int): Triple<Color, Color, Color>? {
+        val p = pal(c) ?: return null
+        val h2 = if (p.s2 > 0f) p.h2 else p.h1
+        val s2 = if (p.s2 > 0f) p.s2 else p.s1
+        val v = if (dark) 0.85f else 0.95f
+        val s = if (dark) 0.8f else 0.5f
+        return Triple(tone(p.h1, p.s1 * s, v), tone(h2, s2 * s, v), tone((p.h1 + h2) / 2f, (p.s1 + s2) / 2f * s, v))
+    }
+
+    fun coverOn(c: Context) = on(RasiNowPlaying.live(c), "set_cover") && RasiNowPlaying.track?.art != null
+    fun vizOn(c: Context) = on(RasiNowPlaying.live(c), "set_viz")
+}
+
+/** Changes whenever the song, cover or play state changes, so settings can redraw. */
+@Composable
+fun rememberNowPlayingTick(): Int {
+    var tick by remember { mutableIntStateOf(0) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        RasiNowPlaying.listeners.add(l)
+        onDispose { RasiNowPlaying.listeners.remove(l) }
+    }
+    return tick
+}
+
+/** The blurred, dimmed cover behind a settings screen (same blur and dim as the keyboard). */
+@Composable
+fun RasiSettingsCover(modifier: Modifier, tick: Int) {
+    val ctx = LocalContext.current
+    if (!RasiSettingsAmbience.coverOn(ctx)) return
+    val art = RasiNowPlaying.track?.art ?: return
+    val p = RasiNowPlaying.live(ctx)
+    val blur = p.getInt("bg_blur", 40)
+    val dim = p.getInt("bg_dim", 35)
+    val opacity = p.getInt("bg_opacity", 80)
+    val paint = remember { Paint(Paint.FILTER_BITMAP_FLAG) }
+    val cachedKey = remember { KeyBox() }
+    val holder = remember { arrayOfNulls<android.graphics.Bitmap>(1) }
+    ComposeCanvas(modifier) draw@{
+        val w = size.width.toInt()
+        val h = size.height.toInt()
+        if (w <= 0 || h <= 0) return@draw
+        val key = "${System.identityHashCode(art)}|$blur|$dim|$w|$h"
+        if (cachedKey.v != key || holder[0] == null) {
+            holder[0] = RasiNowPlayingBg.bitmapFor(art, blur, dim, w, h)
+            cachedKey.v = key
+        }
+        val bmp = holder[0] ?: return@draw
+        paint.alpha = (255 * opacity / 100).coerceIn(0, 255)
+        drawIntoCanvas { it.nativeCanvas.drawBitmap(bmp, 0f, 0f, paint) }
+    }
+}
+
+private class KeyBox { var v: String = "" }
+
+private class RasiAmbientVizView(c: Context) : android.view.View(c) {
+    var withFx = true
+    init { tag = "rasi_ambient" }
+    override fun onDraw(canvas: Canvas) {
+        val w = width.toFloat()
+        val h = height.toFloat()
+        // the "behind" and "mid" effect layers are drawn here so they sit exactly under / over the visualizer
+        if (withFx && RasiSettingsFx.wantedFor(context, "behind")) RasiSettingsFx.draw(this, canvas, "behind", w, h)
+        RasiNowPlayingViz.drawAmbient(this, canvas)
+        if (withFx && RasiSettingsFx.wantedFor(context, "mid")) RasiSettingsFx.draw(this, canvas, "mid", w, h)
+    }
+}
+
+/** The music visualizer drawn behind a settings screen, with the effect layers that sit under and over it. */
+@Composable
+fun RasiSettingsViz(modifier: Modifier, withFx: Boolean = true) {
+    val ctx = LocalContext.current
+    if (!RasiSettingsAmbience.vizOn(ctx)) return
+    AndroidView(factory = { RasiAmbientVizView(it) }, update = { it.withFx = withFx }, modifier = modifier)
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiSettingsFx.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiSettingsFx.kt
new file mode 100644
index 000000000..b7b8ba3c1
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiSettingsFx.kt
@@ -0,0 +1,96 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.graphics.Canvas
+import android.view.View
+import androidx.compose.foundation.Canvas as ComposeCanvas
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.drawscope.drawIntoCanvas
+import androidx.compose.ui.graphics.nativeCanvas
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.platform.LocalView
+import kotlinx.coroutines.delay
+
+/**
+ * Border glow and keyboard-style visual effects drawn behind (or over) the settings screens.
+ * They are separate copies of the keyboard versions: sgl_ options for the glow, sfx_ and sfxviz_ for the effect,
+ * each with its own on/off, colors, size, strength, beat reaction and layer. Both are off in Performance mode.
+ * They only draw, so taps always go through to the settings.
+ */
+object RasiSettingsFx {
+    /** Number of effect layers currently shown, so the beat loop knows it has to keep running. */
+    @Volatile var active = 0
+
+    private fun base(ctx: Context) = RasiNowPlaying.prefs(ctx)
+    fun glowPrefs(ctx: Context) = RasiGlowPrefs.settings(base(ctx))
+    fun fxPrefs(ctx: Context) = RasiFxPrefs.settingsOf(base(ctx))
+
+    fun glowOn(ctx: Context) = RasiBorderGlow.wanted(ctx, glowPrefs(ctx))
+    fun fxOn(ctx: Context) = RasiNowPlayingViz.settingsFxWanted(ctx)
+    fun glowLayer(ctx: Context): String = glowPrefs(ctx).getString("gl_layer", "behind") ?: "behind"
+    fun fxLayer(ctx: Context): String = fxPrefs(ctx).getString("fx_layer", "behind") ?: "behind"
+
+    fun wantedFor(ctx: Context, layer: String): Boolean =
+        (glowOn(ctx) && glowLayer(ctx) == layer) || (fxOn(ctx) && fxLayer(ctx) == layer)
+
+    /** True when this layer has to be redrawn every frame. */
+    fun animatedFor(ctx: Context, layer: String): Boolean =
+        (fxOn(ctx) && fxLayer(ctx) == layer) ||
+            (glowOn(ctx) && glowLayer(ctx) == layer && RasiBorderGlow.animated(ctx, glowPrefs(ctx)))
+
+    /** The glow wants the real audio levels. */
+    fun reactive(ctx: Context): Boolean = RasiBorderGlow.reactive(ctx, glowPrefs(ctx))
+
+    /** Something here needs the animation loop. */
+    fun running(ctx: Context): Boolean = fxOn(ctx) || RasiBorderGlow.animated(ctx, glowPrefs(ctx))
+
+    fun draw(view: View, canvas: Canvas, layer: String, w: Float, h: Float) {
+        val ctx = view.context
+        if (fxOn(ctx) && fxLayer(ctx) == layer) RasiNowPlayingViz.drawSettingsFx(view, canvas, w, h)
+        val gp = glowPrefs(ctx)
+        if (glowOn(ctx) && glowLayer(ctx) == layer) {
+            RasiNowPlayingViz.registerView(view)
+            RasiBorderGlow.drawCore(view, canvas, gp, RasiSetGlowBeat, w, h, 60)
+        }
+        if (running(ctx)) RasiNowPlayingViz.wake()
+    }
+}
+
+/** One layer of the settings effects ("behind" or "over" the settings content). Draw-only, never takes touches. */
+@Composable
+fun RasiSettingsEffects(layer: String, modifier: Modifier = Modifier) {
+    val view = LocalView.current
+    val ctx = LocalContext.current
+    var tick by remember { mutableIntStateOf(0) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        RasiNowPlaying.listeners.add(l)
+        RasiSettingsFx.active++
+        onDispose {
+            RasiNowPlaying.listeners.remove(l)
+            RasiSettingsFx.active = maxOf(0, RasiSettingsFx.active - 1)
+        }
+    }
+    LaunchedEffect(layer) {
+        while (true) {
+            if (RasiSettingsFx.animatedFor(ctx, layer) && !(layer != "over" && RasiSettingsAmbience.vizOn(ctx))) {
+                androidx.compose.runtime.withFrameNanos { }
+                tick++
+            } else delay(400)
+        }
+    }
+    ComposeCanvas(modifier) {
+        val t = tick // read so this is redrawn when it changes
+        // with the visualizer on, its own view draws the "behind" and "mid" layers (so the order is exact)
+        if (t >= 0 && RasiSettingsFx.wantedFor(ctx, layer) && !(layer != "over" && RasiSettingsAmbience.vizOn(ctx))) {
+            drawIntoCanvas { RasiSettingsFx.draw(view, it.nativeCanvas, layer, size.width, size.height) }
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiShake.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiShake.kt
new file mode 100644
index 000000000..f98a7917c
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiShake.kt
@@ -0,0 +1,113 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.SharedPreferences
+import android.graphics.Canvas
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.setValue
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.max
+import kotlin.math.pow
+import kotlin.math.sin
+
+/**
+ * Beat shake: the visualizer and/or the song background shake on every beat (from the shared beat detector).
+ * Optional color change on each shake: black and white, or cycling the thumbnail colors.
+ * Only works when the Developer switch "Beat shakes" is on.
+ */
+object RasiShake {
+    /** Compose reads this inside the song background so it redraws while shaking. */
+    var version by mutableIntStateOf(0)
+    @Volatile var amp = 0f
+    @Volatile var gray = false
+    @Volatile var colorIdx = 0
+    @Volatile var toViz = false
+    @Volatile var toBg = false
+    @Volatile var cycle = false
+    @Volatile private var dx = 0f
+    @Volatile private var dy = 0f
+    @Volatile private var zoom = 0f
+    @Volatile private var rot = 0f
+    @Volatile private var mag = 0.5f
+    private var phase = 0f
+    private var ang = 0f
+    private var beats = 0
+    private var changes = 0
+    private var wasActive = false
+
+    private fun reset() {
+        val was = toBg && (amp > 0f || gray)
+        amp = 0f; dx = 0f; dy = 0f; zoom = 0f; rot = 0f
+        gray = false; toViz = false; toBg = false; cycle = false
+        wasActive = false
+        if (was) version++
+    }
+
+    /** Called every tick by the visualizer. hit = a beat started this tick, strength 0..1, k = frame scale. */
+    fun update(p: SharedPreferences, hit: Boolean, strength: Float, k: Float) {
+        val on = RasiMethods.shakes && p.getBoolean("viz_shake_on", false) &&
+            !org.futo.inputmethod.latin.uix.RasiPerf.isOn()
+        if (!on) { if (amp > 0f || toViz || toBg || gray) reset(); return }
+        val tgt = p.getString("viz_shake_target", "both") ?: "both"
+        toViz = tgt != "bg"
+        toBg = tgt != "viz"
+        val style = p.getString("viz_shake_style", "jolt") ?: "jolt"
+        val cmode = p.getString("viz_shake_cmode", "off") ?: "off"
+        cycle = cmode == "cycle"
+        mag = p.getInt("viz_shake_int", 50) / 100f
+        val spd = p.getInt("viz_shake_speed", 50) / 100f
+        val len = p.getInt("viz_shake_len", 50) / 100f
+        if (hit && strength >= p.getInt("viz_shake_thr", 0) / 100f) {
+            beats++
+            if (beats % p.getInt("viz_shake_every", 1).coerceAtLeast(1) == 0) {
+                amp = 1f
+                phase = 0f
+                ang = when (style) {
+                    "side" -> 0f
+                    "up" -> (Math.PI / 2).toFloat()
+                    else -> (Math.random() * 2 * Math.PI).toFloat()
+                }
+                changes++
+                if (changes % p.getInt("viz_shake_cevery", 1).coerceAtLeast(1) == 0) {
+                    if (cmode == "bw_alt") gray = !gray
+                    if (cmode == "cycle") colorIdx++
+                }
+            }
+        }
+        phase += (0.5f + 1.5f * spd) * k
+        amp *= (0.74f + 0.23f * len).toDouble().pow(k.toDouble()).toFloat()
+        if (amp < 0.01f) amp = 0f
+        val o = amp * cos(phase)
+        when (style) {
+            "zoom" -> { dx = 0f; dy = 0f; zoom = amp; rot = 0f }
+            "tilt" -> { dx = 0f; dy = 0f; zoom = 0f; rot = o }
+            else -> { dx = cos(ang) * o; dy = sin(ang) * o; zoom = 0f; rot = 0f }
+        }
+        if (cmode == "bw_flash") gray = amp > 0.12f
+        else if (cmode != "bw_alt") gray = false
+        val active = amp > 0f || gray
+        if (toBg && (active || wasActive)) version++
+        wasActive = active
+    }
+
+    /** Moves the canvas for the visualizer. */
+    fun apply(c: Canvas, w: Float, h: Float) {
+        val m = mag * 0.06f * w
+        c.translate(dx * m, dy * m)
+        if (zoom > 0f) { val s = 1f + zoom * mag * 0.15f; c.scale(s, s, w / 2f, h) }
+        if (rot != 0f) c.rotate(rot * mag * 4f, w / 2f, h / 2f)
+    }
+
+    /** Moves the canvas for the song background, zooming in a little so no edge shows. */
+    fun applyBg(c: Canvas, w: Float, h: Float) {
+        val m = mag * 0.06f * w
+        val tx = dx * m
+        val ty = dy * m
+        val rd = rot * mag * 4f
+        val s = 1f + 2f * max(abs(tx) / w, abs(ty) / h) + abs(rd) * 0.03f + zoom * mag * 0.15f
+        c.translate(tx, ty)
+        c.scale(s, s, w / 2f, h / 2f)
+        if (rd != 0f) c.rotate(rd, w / 2f, h / 2f)
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiShizuku.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiShizuku.kt
new file mode 100644
index 000000000..ed6b32a47
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiShizuku.kt
@@ -0,0 +1,72 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+
+/** Small bridge to Shizuku. Runs the same shell commands as adb, without a PC. */
+object RasiShizuku {
+    const val PKG = "moe.shizuku.privileged.api"
+    private const val REQ = 4721
+
+    fun installed(c: Context): Boolean = try {
+        c.packageManager.getPackageInfo(PKG, 0)
+        true
+    } catch (e: Throwable) { false }
+
+    fun running(): Boolean = try { rikka.shizuku.Shizuku.pingBinder() } catch (e: Throwable) { false }
+
+    fun granted(): Boolean = try {
+        running() && !rikka.shizuku.Shizuku.isPreV11() &&
+            rikka.shizuku.Shizuku.checkSelfPermission() == PackageManager.PERMISSION_GRANTED
+    } catch (e: Throwable) { false }
+
+    fun requestPermission() {
+        try { rikka.shizuku.Shizuku.requestPermission(REQ) } catch (e: Throwable) { }
+    }
+
+    fun openApp(c: Context): Boolean = try {
+        val i = c.packageManager.getLaunchIntentForPackage(PKG)
+        if (i == null) false else { c.startActivity(i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)); true }
+    } catch (e: Throwable) { false }
+
+    /** Blocking. Call from a background thread. */
+    fun run(cmd: String): String = try {
+        val m = rikka.shizuku.Shizuku::class.java.getDeclaredMethod(
+            "newProcess", Array<String>::class.java, Array<String>::class.java, String::class.java
+        )
+        m.isAccessible = true
+        val p = m.invoke(null, arrayOf("sh", "-c", cmd), null, null) as Process
+        val out = p.inputStream.bufferedReader().readText().trim()
+        val err = p.errorStream.bufferedReader().readText().trim()
+        p.waitFor()
+        if (out.isNotEmpty()) out else if (err.isNotEmpty()) err else "done"
+    } catch (e: Throwable) {
+        "failed: " + (e.cause?.message ?: e.message)
+    }
+
+    /** Enables our listener, asks Android to bind it, then grants the one-time permission for no-root self fix. */
+    fun fixAccess(c: Context): String {
+        val r = run(RasiNowPlaying.allowCommand(c))
+        RasiNowPlaying.ensureConnectedForce(c)
+        val g = run(RasiNowPlaying.grantCommand(c))
+        val a = grantAudio(c)
+        return "Shizuku allow: " + r + ". Grant: " + g + ". " + a + " Wait a few seconds."
+    }
+
+    /** Lets the visualizer read the player's sound output (the permission is named RECORD_AUDIO; the mic is not used). */
+    fun grantAudio(c: Context): String {
+        val r = run("pm grant " + c.packageName + " android.permission.RECORD_AUDIO")
+        RasiNowPlayingViz.retryReal()
+        return "Audio capture: " + r + "."
+    }
+
+    /** The dumpsys audio lines about players, to copy and send for debugging the format of a phone. */
+    fun playerLines(c: Context): String {
+        val o = run("dumpsys audio")
+        if (o.startsWith("failed:")) return o
+        val keep = o.lines().filter { it.contains("u/pid:") || it.contains("AudioPlaybackConfiguration") || it.contains("session", ignoreCase = true) }
+        val ver = "Android " + android.os.Build.VERSION.RELEASE + " (" + android.os.Build.VERSION.SDK_INT + "), " + android.os.Build.MANUFACTURER + " " + android.os.Build.MODEL
+        return ver + "\n" + keep.take(40).joinToString("\n") { it.trim().take(300) }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiSmartBeat.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiSmartBeat.kt
new file mode 100644
index 000000000..21ece4065
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiSmartBeat.kt
@@ -0,0 +1,92 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.os.SystemClock
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+
+/**
+ * Smart simulated beat: looks up the song tempo (BPM) on Deezer's free public API (title and artist
+ * are the only data sent) and pulses in time with the song position. Results are saved on the phone.
+ */
+object RasiSmartBeat {
+    @Volatile var bpm = 0f
+    @Volatile var status = "not used yet"
+    @Volatile private var key = ""
+    @Volatile private var busy = false
+    @Volatile private var retryAt = 0L
+
+    fun request(ctx: Context, title: String, artist: String) {
+        val k = title.trim().lowercase() + "|" + artist.trim().lowercase()
+        if (k == key || busy) return
+        val now = System.currentTimeMillis()
+        if (now < retryAt) return
+        key = k
+        bpm = 0f
+        val app = ctx.applicationContext
+        val p = app.getSharedPreferences("rasi_bpm", Context.MODE_PRIVATE)
+        if (p.contains(k)) {
+            val v = p.getFloat(k, 0f)
+            bpm = v
+            status = if (v > 0f) "Tempo " + v.toInt() + " BPM (saved)" else "Tempo not found for this song (saved)"
+            return
+        }
+        busy = true
+        status = "Looking up the song tempo..."
+        Thread {
+            try {
+                val v = fetch(title, artist)
+                if (key == k) {
+                    bpm = v
+                    status = if (v > 0f) "Tempo " + v.toInt() + " BPM (Deezer)" else "Tempo not found for this song"
+                }
+                p.edit().putFloat(k, v).apply()
+            } catch (t: Throwable) {
+                if (key == k) status = "Tempo lookup failed (no internet?), plain simulated beat"
+                key = ""
+                retryAt = System.currentTimeMillis() + 30000L
+            } finally {
+                busy = false
+            }
+        }.start()
+    }
+
+    /** 0..1 pulse for right now, or -1 when no tempo is known. */
+    fun beatNow(): Float {
+        val b = bpm
+        if (b <= 0f) return -1f
+        val posMs = if (RasiNowPlaying.posMs >= 0L)
+            RasiNowPlaying.posMs + ((SystemClock.elapsedRealtime() - RasiNowPlaying.posAt) * RasiNowPlaying.posSpeed).toLong()
+        else System.currentTimeMillis()
+        val phase = posMs / 1000.0 * b / 60.0
+        val frac = phase - Math.floor(phase)
+        return Math.pow(1.0 - frac, 2.5).toFloat()
+    }
+
+    private fun get(url: String): String {
+        val c = URL(url).openConnection() as HttpURLConnection
+        c.connectTimeout = 5000
+        c.readTimeout = 5000
+        return try { c.inputStream.bufferedReader().use { it.readText() } } finally { c.disconnect() }
+    }
+
+    private fun search(q: String): Long {
+        val s = JSONObject(get("https://api.deezer.com/search?limit=1&q=" + URLEncoder.encode(q, "UTF-8")))
+        val d = s.optJSONArray("data") ?: return 0L
+        return if (d.length() == 0) 0L else d.getJSONObject(0).optLong("id", 0L)
+    }
+
+    private fun fetch(title: String, artist: String): Float {
+        val clean = title.replace(Regex("\\(.*?\\)|\\[.*?\\]"), "").replace(Regex(" - .*$"), "").trim()
+        var id = search("track:\"" + clean + "\" artist:\"" + artist + "\"")
+        if (id == 0L) id = search(clean + " " + artist)
+        if (id == 0L) return 0f
+        var v = JSONObject(get("https://api.deezer.com/track/" + id)).optDouble("bpm", 0.0).toFloat()
+        if (v <= 0f) return 0f
+        while (v > 190f) v /= 2f
+        while (v < 70f) v *= 2f
+        return v
+    }
+}
