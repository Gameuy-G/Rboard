@@ -0,0 +1,113 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioManager
+import android.media.SoundPool
+import android.net.Uri
+import android.widget.Toast
+import org.futo.inputmethod.latin.common.Constants
+import java.io.File
+
+/** Custom key press sounds picked by the user (letters, space, delete, enter). */
+object RasiSounds {
+    const val PREFS = "rasi_sounds"
+    val SLOTS = listOf("letters", "space", "delete", "enter")
+
+    private var appContext: Context? = null
+    private var pool: SoundPool? = null
+    private val ids = HashMap<String, Int>()
+
+    fun prefs(context: Context) = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun dir(context: Context) = File(context.applicationContext.filesDir, "rasi_sounds").also { it.mkdirs() }
+
+    @JvmStatic
+    fun init(context: Context) {
+        appContext = context.applicationContext
+        reload()
+    }
+
+    fun reload() {
+        val ctx = appContext ?: return
+        pool?.release()
+        ids.clear()
+        val p = SoundPool.Builder()
+            .setMaxStreams(6)
+            .setAudioAttributes(
+                AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                    .build()
+            )
+            .build()
+        pool = p
+        val prefs = prefs(ctx)
+        if (!prefs.getBoolean("enabled", false)) return
+        for (slot in SLOTS) {
+            val name = prefs.getString("file_$slot", null) ?: continue
+            val f = File(dir(ctx), name)
+            if (f.exists()) ids[slot] = p.load(f.absolutePath, 1)
+        }
+    }
+
+    fun fileName(context: Context, slot: String): String? =
+        prefs(context).getString("file_$slot", null)
+
+    fun importSound(context: Context, slot: String, uri: Uri): Boolean {
+        val ctx = context.applicationContext
+        return try {
+            val name = "${slot}_${System.currentTimeMillis()}.snd"
+            val out = File(dir(ctx), name)
+            ctx.contentResolver.openInputStream(uri)?.use { input ->
+                out.outputStream().use { input.copyTo(it) }
+            } ?: return false
+            if (out.length() > 2_000_000L) {
+                out.delete()
+                Toast.makeText(ctx, "Sound is too large, use a short clip (under 2 MB)", Toast.LENGTH_LONG).show()
+                return false
+            }
+            fileName(ctx, slot)?.let { File(dir(ctx), it).delete() }
+            prefs(ctx).edit().putString("file_$slot", name).apply()
+            reload()
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    fun clear(context: Context, slot: String) {
+        val ctx = context.applicationContext
+        fileName(ctx, slot)?.let { File(dir(ctx), it).delete() }
+        prefs(ctx).edit().remove("file_$slot").apply()
+        reload()
+    }
+
+    fun playSlot(slot: String) {
+        val ctx = appContext ?: return
+        val id = ids[slot] ?: ids["letters"] ?: return
+        val v = prefs(ctx).getFloat("volume", 0.8f)
+        pool?.play(id, v, v, 1, 0, 1f)
+    }
+
+    /** Returns true when a custom sound handled this key press (so the system click is skipped). */
+    @JvmStatic
+    fun tryPlay(code: Int): Boolean {
+        val ctx = appContext ?: return false
+        if (ids.isEmpty()) return false
+        if (!prefs(ctx).getBoolean("enabled", false)) return false
+
+        val am = ctx.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        if (am != null && am.ringerMode != AudioManager.RINGER_MODE_NORMAL) return true
+
+        val slot = when (code) {
+            Constants.CODE_DELETE -> "delete"
+            Constants.CODE_ENTER -> "enter"
+            Constants.CODE_SPACE -> "space"
+            else -> "letters"
+        }
+        if (ids[slot] == null && ids["letters"] == null) return false
+        playSlot(slot)
+        return true
+    }
+}
