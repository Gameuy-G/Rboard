--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiChroma.kt
@@ -0,0 +1,336 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Movie
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.drawable.Drawable
+import android.media.MediaMetadataRetriever
+import android.net.Uri
+import android.os.Build
+import android.os.SystemClock
+import java.io.File
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sqrt
+
+/** Plays a baked chroma-key frame sequence. All slots of one effect share the same bitmaps. */
+class ChromaDrawable(private val frames: Array<Bitmap>, private val frameMs: Long) : Drawable() {
+    var loop = false
+    var stretch = false
+    var onEnd: (() -> Unit)? = null
+    private var startTime = 0L
+    private var running = false
+    private val paint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+    private val dst = Rect()
+
+    fun start() {
+        startTime = SystemClock.uptimeMillis()
+        running = true
+        invalidateSelf()
+    }
+
+    fun stop() {
+        running = false
+    }
+
+    override fun draw(canvas: Canvas) {
+        if (!running || frames.isEmpty()) return
+        var idx = ((SystemClock.uptimeMillis() - startTime) / frameMs).toInt()
+        if (idx >= frames.size) {
+            if (loop) {
+                idx %= frames.size
+            } else {
+                running = false
+                onEnd?.invoke()
+                return
+            }
+        }
+        val bmp = frames[idx]
+        val b = bounds
+        if (stretch) {
+            dst.set(b)
+        } else {
+            val sc = min(b.width().toFloat() / bmp.width, b.height().toFloat() / bmp.height)
+            val w = (bmp.width * sc).toInt()
+            val h = (bmp.height * sc).toInt()
+            val l = b.left + (b.width() - w) / 2
+            val t = b.top + (b.height() - h) / 2
+            dst.set(l, t, l + w, t + h)
+        }
+        canvas.drawBitmap(bmp, null, dst, paint)
+        if (loop) invalidateSelf()
+    }
+
+    override fun setAlpha(alpha: Int) {
+        paint.alpha = alpha
+    }
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {
+        paint.colorFilter = colorFilter
+    }
+
+    @Suppress("OVERRIDE_DEPRECATION")
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+
+    override fun getIntrinsicWidth(): Int = frames.firstOrNull()?.width ?: -1
+    override fun getIntrinsicHeight(): Int = frames.firstOrNull()?.height ?: -1
+}
+
+/** Settings for removing a solid background. tol and soft are 0..100. */
+class ChromaParams(var color: Int, var tol: Float, var soft: Float)
+
+/** Chroma-key import: turns a GIF / MP4 / image with a solid background into transparent frames. */
+object RasiChroma {
+    const val SCOPE_KEY = "key"
+    const val SCOPE_BG = "bg"
+    const val MAX_MS = 2000
+    const val FPS = 24
+
+    /** Set before navigating to the chroma screen. */
+    @JvmField var pendingScope = SCOPE_KEY
+    @JvmField var pendingTarget = RasiEffects.DEFAULT
+    @JvmField var pendingUri: Uri? = null
+
+    private val cache = HashMap<String, Array<Bitmap>>()
+
+    fun releaseCache() = cache.clear()
+
+    fun maxDim(scope: String) = if (scope == SCOPE_BG) 320 else 256
+
+    /** Loads a baked frames folder as a drawable (null when broken). */
+    fun loadFrames(dir: File): Drawable? = try {
+        val meta = File(dir, "meta.txt").readText().trim().lines()
+        val delay = meta[0].toLong().coerceAtLeast(16L)
+        val count = meta[1].toInt()
+        val key = dir.absolutePath
+        val arr = cache.getOrPut(key) {
+            Array(count) { i ->
+                BitmapFactory.decodeFile(File(dir, "f%04d.img".format(i)).absolutePath)
+                    ?: throw IllegalStateException("missing frame")
+            }
+        }
+        ChromaDrawable(arr, delay)
+    } catch (e: Throwable) {
+        cache.remove(dir.absolutePath)
+        null
+    }
+
+    /** A decoded source (GIF, MP4 or still image) that can give scaled frames. */
+    class Source(val file: File, val kind: Int) {
+        var width = 0
+        var height = 0
+        var durationMs = 0
+        private var movie: Movie? = null
+        private var mmr: MediaMetadataRetriever? = null
+        private var still: Bitmap? = null
+
+        val frameCount: Int
+            get() = if (durationMs <= 0) 1 else max(1, (min(durationMs, MAX_MS) * FPS / 1000))
+
+        fun frameTimeMs(i: Int) = i * 1000 / FPS
+
+        fun open(): Boolean {
+            try {
+                when (kind) {
+                    KIND_GIF -> {
+                        val m = Movie.decodeFile(file.absolutePath) ?: return false
+                        movie = m
+                        width = m.width()
+                        height = m.height()
+                        durationMs = m.duration()
+                    }
+                    KIND_VIDEO -> {
+                        val r = MediaMetadataRetriever()
+                        r.setDataSource(file.absolutePath)
+                        mmr = r
+                        var w = r.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH)?.toIntOrNull() ?: 0
+                        var h = r.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)?.toIntOrNull() ?: 0
+                        val rot = r.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION)?.toIntOrNull() ?: 0
+                        if (rot == 90 || rot == 270) { val t = w; w = h; h = t }
+                        width = w
+                        height = h
+                        durationMs = r.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toIntOrNull() ?: 0
+                    }
+                    else -> {
+                        val b = BitmapFactory.decodeFile(file.absolutePath) ?: return false
+                        still = b
+                        width = b.width
+                        height = b.height
+                        durationMs = 0
+                    }
+                }
+                return width > 0 && height > 0
+            } catch (e: Throwable) {
+                return false
+            }
+        }
+
+        /** Frame i scaled so the longest side is at most dim. Returns an ARGB_8888 bitmap. */
+        fun frame(i: Int, dim: Int, fast: Boolean = false): Bitmap? {
+            val sc = min(1f, dim.toFloat() / max(width, height))
+            val w = max(1, (width * sc).toInt())
+            val h = max(1, (height * sc).toInt())
+            return try {
+                when (kind) {
+                    KIND_GIF -> {
+                        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+                        val c = Canvas(bmp)
+                        c.scale(w.toFloat() / width, h.toFloat() / height)
+                        val m = movie!!
+                        m.setTime(if (m.duration() > 0) frameTimeMs(i) % m.duration() else 0)
+                        m.draw(c, 0f, 0f)
+                        bmp
+                    }
+                    KIND_VIDEO -> {
+                        val r = mmr!!
+                        val us = frameTimeMs(i) * 1000L
+                        val opt = if (fast) MediaMetadataRetriever.OPTION_CLOSEST_SYNC else MediaMetadataRetriever.OPTION_CLOSEST
+                        val raw = if (Build.VERSION.SDK_INT >= 27) r.getScaledFrameAtTime(us, opt, w, h) else r.getFrameAtTime(us, opt)
+                        if (raw == null) null
+                        else {
+                            val scaled = if (raw.width != w || raw.height != h) Bitmap.createScaledBitmap(raw, w, h, true) else raw
+                            scaled.copy(Bitmap.Config.ARGB_8888, true)
+                        }
+                    }
+                    else -> Bitmap.createScaledBitmap(still!!, w, h, true).copy(Bitmap.Config.ARGB_8888, true)
+                }
+            } catch (e: Throwable) {
+                null
+            }
+        }
+
+        fun close() {
+            try { mmr?.release() } catch (e: Throwable) {}
+            mmr = null
+            movie = null
+        }
+    }
+
+    const val KIND_GIF = 0
+    const val KIND_VIDEO = 1
+    const val KIND_IMAGE = 2
+
+    /** Copies the picked file into the cache and opens it. */
+    fun openSource(context: Context, uri: Uri): Source? {
+        val ctx = context.applicationContext
+        return try {
+            val mime = ctx.contentResolver.getType(uri) ?: ""
+            val kind = when {
+                mime.startsWith("video/") -> KIND_VIDEO
+                mime == "image/gif" -> KIND_GIF
+                else -> KIND_IMAGE
+            }
+            val f = File(ctx.cacheDir, "chroma_src_${System.currentTimeMillis()}.bin")
+            ctx.cacheDir.listFiles()?.filter { it.name.startsWith("chroma_src_") }?.forEach { it.delete() }
+            ctx.contentResolver.openInputStream(uri)?.use { i -> f.outputStream().use { i.copyTo(it) } } ?: return null
+            if (f.length() > 150_000_000L) {
+                f.delete()
+                return null
+            }
+            val s = Source(f, kind)
+            if (s.open()) s else null
+        } catch (e: Throwable) {
+            null
+        }
+    }
+
+    /** Average of the four corner pixels, a good first guess for the key color. */
+    fun guessKey(bmp: Bitmap): Int {
+        val pts = listOf(
+            0 to 0, bmp.width - 1 to 0, 0 to bmp.height - 1, bmp.width - 1 to bmp.height - 1
+        )
+        var r = 0; var g = 0; var b = 0
+        for ((x, y) in pts) {
+            val p = bmp.getPixel(x, y)
+            r += (p shr 16) and 255; g += (p shr 8) and 255; b += p and 255
+        }
+        return (0xFF shl 24) or ((r / 4) shl 16) or ((g / 4) shl 8) or (b / 4)
+    }
+
+    private fun lum(r: Int, g: Int, b: Int) = 0.299f * r + 0.587f * g + 0.114f * b
+
+    /**
+     * Makes the key color transparent. Distance is measured mostly in color (not brightness), so a
+     * shaded green screen still keys well; black keys by brightness. Edge pixels get a little
+     * despill so there is no green or colored fringe.
+     */
+    fun applyKey(src: Bitmap, p: ChromaParams): Bitmap {
+        val w = src.width
+        val h = src.height
+        val px = IntArray(w * h)
+        src.getPixels(px, 0, w, 0, 0, w, h)
+        val kr = (p.color shr 16) and 255
+        val kg = (p.color shr 8) and 255
+        val kb = p.color and 255
+        val ky = lum(kr, kg, kb)
+        val kcb = (kb - ky) * 0.564f
+        val kcr = (kr - ky) * 0.713f
+        val tol = p.tol / 100f * 0.6f
+        val soft = p.soft / 100f * 0.4f + 0.001f
+        val chromatic = max(kr, max(kg, kb)) - min(kr, min(kg, kb)) > 50
+        val dom = if (kg >= kr && kg >= kb) 1 else if (kb >= kr) 2 else 0
+        for (i in px.indices) {
+            val c = px[i]
+            val r = (c shr 16) and 255
+            val g = (c shr 8) and 255
+            val b = c and 255
+            val y = lum(r, g, b)
+            val dy = (y - ky) * 0.5f
+            val dcb = (b - y) * 0.564f - kcb
+            val dcr = (r - y) * 0.713f - kcr
+            val d = sqrt(dy * dy + dcb * dcb + dcr * dcr) / 255f
+            var a = ((d - tol) / soft).coerceIn(0f, 1f)
+            a = a * a * (3f - 2f * a)
+            if (a <= 0f) {
+                px[i] = 0
+                continue
+            }
+            var nr = r
+            var ng = g
+            var nb = b
+            if (chromatic && a < 1f) {
+                when (dom) {
+                    1 -> ng = min(g, max(r, b))
+                    2 -> nb = min(b, max(r, g))
+                    else -> nr = min(r, max(g, b))
+                }
+            }
+            px[i] = ((a * 255f).toInt() shl 24) or (nr shl 16) or (ng shl 8) or nb
+        }
+        val out = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+        out.setPixels(px, 0, w, 0, 0, w, h)
+        return out
+    }
+
+    /** Keys every frame and writes them to outDir. Run on a background thread. */
+    fun bake(src: Source, p: ChromaParams, scope: String, outDir: File, progress: (Float) -> Unit): Boolean {
+        return try {
+            outDir.mkdirs()
+            val n = src.frameCount
+            val dim = maxDim(scope)
+            for (i in 0 until n) {
+                val raw = src.frame(i, dim) ?: return false
+                val keyed = applyKey(raw, p)
+                File(outDir, "f%04d.img".format(i)).outputStream().use {
+                    val fmt = if (Build.VERSION.SDK_INT >= 30) Bitmap.CompressFormat.WEBP_LOSSLESS else Bitmap.CompressFormat.PNG
+                    keyed.compress(fmt, 100, it)
+                }
+                raw.recycle()
+                keyed.recycle()
+                progress((i + 1f) / n)
+            }
+            val delay = if (src.durationMs <= 0) 1500 else 1000 / FPS
+            File(outDir, "meta.txt").writeText("$delay\n$n\n")
+            true
+        } catch (e: Throwable) {
+            outDir.deleteRecursively()
+            false
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiCommaPopup.kt b/java/src/org/futo/inputmethod/latin/uix/RasiCommaPopup.kt
new file mode 100644
index 000000000..c16b22a2a
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiCommaPopup.kt
@@ -0,0 +1,164 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.drawable.Drawable
+import android.view.View
+import androidx.core.content.ContextCompat
+import org.futo.inputmethod.keyboard.Key
+import org.futo.inputmethod.latin.R
+import org.futo.inputmethod.latin.common.Constants
+import java.lang.ref.WeakReference
+
+/**
+ * Pill popup shown while the comma key is held: one-handed (left), emoji (centre), settings (right).
+ * Purely visual; PointerTracker decides the action on release. Colors are taken from the
+ * keyboard theme (letter key look for the pill, enter key look for the highlight).
+ */
+object RasiCommaPopup {
+    private var active = false
+    private var selected = 0 // -1 one-handed, 0 emoji, 1 settings
+    private var keyX = 0f
+    private var keyY = 0f
+    private var keyW = 0f
+    private var keyH = 0f
+    private var viewRef: WeakReference<View>? = null
+    private val icons = arrayOfNulls<Drawable>(3)
+    private var hintIcon: Drawable? = null
+    private val backdrop = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val fallbackHi = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = 0xFF9BD79F.toInt() }
+    private val rect = RectF()
+
+    // captured from the theme while keys are drawn (not while the popup is open)
+    private var keyBgSrc: Drawable? = null
+    private var keyTextColor = 0xFFE8EAE8.toInt()
+    private var enterBgSrc: Drawable? = null
+    private var enterTextColor = 0xFF10231A.toInt()
+
+    private fun isCommaWithActions(key: Key): Boolean {
+        if (key.code != ','.code) return false
+        val first = key.moreKeys.firstOrNull() ?: return false
+        return first.mCode >= Constants.CODE_ACTION_0 && first.mCode <= Constants.CODE_ACTION_MAX
+    }
+
+    @JvmStatic
+    fun capture(key: Key, background: Drawable?, textColor: Int) {
+        if (active || background == null) return
+        if (isCommaWithActions(key)) {
+            keyBgSrc = background
+            if (Color.alpha(textColor) > 0) keyTextColor = textColor
+        } else if (key.code == Constants.CODE_ENTER) {
+            enterBgSrc = background
+            if (Color.alpha(textColor) > 0) enterTextColor = textColor
+        }
+    }
+
+    /** Small emoji icon centred at the top of the comma key (canvas is already in key coordinates). */
+    @JvmStatic
+    fun drawKeyHint(context: Context, canvas: Canvas, key: Key, color: Int, size: Float, centerX: Float, top: Float, alpha: Int) {
+        if (!isCommaWithActions(key)) return
+        if (hintIcon == null) {
+            hintIcon = ContextCompat.getDrawable(context, R.drawable.smile)?.mutate()
+        }
+        val icon = hintIcon ?: return
+        val s = maxOf(size * 1.2f, key.height * 0.2f).toInt()
+        // the hint colour can be fully transparent on some themes, so fall back to the label colour
+        icon.setTint(if (Color.alpha(color) > 0) color else keyTextColor)
+        icon.setAlpha(if (alpha in 1..255) alpha else 255)
+        val l = (centerX - s / 2f).toInt()
+        val t = top.toInt()
+        icon.setBounds(l, t, l + s, t + s)
+        icon.draw(canvas)
+    }
+
+    @JvmStatic
+    fun show(key: Key) {
+        keyX = key.drawX.toFloat()
+        keyY = key.y.toFloat()
+        keyW = key.drawWidth.toFloat()
+        keyH = key.height.toFloat()
+        selected = 0
+        active = true
+        viewRef?.get()?.invalidate()
+    }
+
+    @JvmStatic
+    fun update(dx: Int, threshold: Int) {
+        if (!active) return
+        val s = if (dx <= -threshold) -1 else if (dx >= threshold) 1 else 0
+        if (s != selected) {
+            selected = s
+            viewRef?.get()?.invalidate()
+        }
+    }
+
+    @JvmStatic
+    fun hide() {
+        if (!active) return
+        active = false
+        viewRef?.get()?.invalidate()
+    }
+
+    private fun copyOf(d: Drawable?): Drawable? = d?.constantState?.newDrawable()?.mutate()
+
+    @JvmStatic
+    fun draw(view: View, canvas: Canvas) {
+        if (viewRef?.get() !== view) viewRef = WeakReference(view)
+        if (!active) return
+        val d = view.resources.displayMetrics.density
+        if (icons[0] == null) {
+            icons[0] = ContextCompat.getDrawable(view.context, R.drawable.keyboard_right_handed)?.mutate()
+            icons[1] = ContextCompat.getDrawable(view.context, R.drawable.smile)?.mutate()
+            icons[2] = ContextCompat.getDrawable(view.context, R.drawable.settings)?.mutate()
+        }
+        val slot = maxOf(keyW, 40f * d)
+        val pad = 6f * d
+        val pillW = slot * 3 + pad * 2
+        val pillH = maxOf(keyH * 1.15f, 48f * d)
+        val cx = view.paddingLeft + keyX + keyW / 2f
+        var left = cx - pillW / 2f
+        left = left.coerceIn(4f * d, maxOf(4f * d, view.width - pillW - 4f * d))
+        val top = maxOf(0f, view.paddingTop + keyY - pillH - 8f * d)
+        rect.set(left, top, left + pillW, top + pillH)
+
+        // opaque-ish backdrop so keys underneath do not show through, then the theme key look on top
+        val lightText = (Color.red(keyTextColor) * 299 + Color.green(keyTextColor) * 587 + Color.blue(keyTextColor) * 114) / 1000 > 128
+        backdrop.color = if (lightText) 0xF2101412.toInt() else 0xF2F2F4F2.toInt()
+        canvas.drawRoundRect(rect, pillH / 2f, pillH / 2f, backdrop)
+        copyOf(keyBgSrc)?.let {
+            it.setAlpha(255)
+            it.setBounds(rect.left.toInt(), rect.top.toInt(), rect.right.toInt(), rect.bottom.toInt())
+            it.draw(canvas)
+        }
+
+        val cy = top + pillH / 2f
+        val iconSize = (slot * 0.5f).toInt()
+        val hiSize = (pillH * 0.84f).toInt()
+        for (i in 0..2) {
+            val icx = left + pad + slot * (i + 0.5f)
+            val isSel = (i - 1) == selected
+            if (isSel) {
+                val eb = copyOf(enterBgSrc)
+                if (eb != null) {
+                    eb.setAlpha(255)
+                    eb.setBounds((icx - hiSize / 2f).toInt(), (cy - hiSize / 2f).toInt(),
+                        (icx + hiSize / 2f).toInt(), (cy + hiSize / 2f).toInt())
+                    eb.draw(canvas)
+                } else {
+                    canvas.drawCircle(icx, cy, hiSize / 2f, fallbackHi)
+                }
+            }
+            icons[i]?.let {
+                it.setTint(if (isSel) enterTextColor else keyTextColor)
+                it.setBounds(
+                    (icx - iconSize / 2f).toInt(), (cy - iconSize / 2f).toInt(),
+                    (icx + iconSize / 2f).toInt(), (cy + iconSize / 2f).toInt()
+                )
+                it.draw(canvas)
+            }
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiDictDownloader.kt b/java/src/org/futo/inputmethod/latin/uix/RasiDictDownloader.kt
