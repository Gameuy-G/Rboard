+    /** Sends a file into the text field; videos fall back to the share sheet if the app refuses them. */
+    fun sendFile(
+        context: Context,
+        manager: org.futo.inputmethod.latin.uix.KeyboardManagerForAction,
+        file: File
+    ) {
+        val mime = mimeOf(file)
+        val id = ClipboardProviderState.addRequest(
+            ClipboardPasteRequest(
+                file = file,
+                mimeType = mime,
+                expiration = System.currentTimeMillis() + 30L * 60L * 1000L
+            )
+        )
+        val uri = Uri.parse("content://${CLIPBOARD_AUTHORITY}/clip/$id")
+        val video = mime.startsWith("video/")
+        var ok = false
+        if (!video || manager.appSupportsImageInsertion(mime, true)) {
+            ok = manager.typeUri(uri, listOf(mime), true)
+        }
+        if (!ok && video) {
+            try {
+                val send = Intent(Intent.ACTION_SEND)
+                send.type = mime
+                send.putExtra(Intent.EXTRA_STREAM, uri)
+                send.clipData = android.content.ClipData.newRawUri("", uri)
+                send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                val chooser = Intent.createChooser(send, "Send video")
+                chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                context.startActivity(chooser)
+                android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
+                    manager.closeActionWindow()
+                    manager.getLatinIMEForDebug().requestHideSelf(0)
+                }, 150)
+            } catch (e: Exception) {
+            }
+        }
+        if (mime == "image/gif") {
+            // GIF sent: close the panel and hide the whole keyboard
+            android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
+                manager.closeActionWindow()
+                manager.getLatinIMEForDebug().requestHideSelf(0)
+            }, 150)
+        }
+    }
