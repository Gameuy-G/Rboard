+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.LinearGradientShader
+import androidx.compose.ui.graphics.Shader
+import androidx.compose.ui.graphics.ShaderBrush
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import androidx.navigation.NavHostController
+import androidx.navigation.compose.rememberNavController
+import com.google.android.material.color.utilities.DislikeAnalyzer
+import com.google.android.material.color.utilities.DynamicScheme
+import com.google.android.material.color.utilities.Hct
+import com.google.android.material.color.utilities.MathUtils
+import com.google.android.material.color.utilities.TemperatureCache
+import com.google.android.material.color.utilities.TonalPalette
+import com.google.android.material.color.utilities.Variant
+import org.futo.inputmethod.latin.R
+import org.futo.inputmethod.latin.uix.KeyboardColorScheme
+import org.futo.inputmethod.latin.uix.settings.pages.themes.GradientMath
+import org.futo.inputmethod.latin.uix.settings.pages.themes.LabeledSlider
+import org.futo.inputmethod.latin.uix.theme.UixThemeAuto
+import org.futo.inputmethod.latin.uix.theme.UixThemeWrapper
+import org.futo.inputmethod.latin.uix.theme.serialization.getColorSchemeFromDynamicScheme
+import org.futo.inputmethod.latin.uix.wrapDarkColorScheme
+import org.futo.inputmethod.latin.uix.wrapLightColorScheme
+
+/** Optional gradient painted behind the settings (null = the default themed glass gradient). */
+val LocalRasiSettingsBackground = androidx.compose.runtime.compositionLocalOf<Brush?> { null }
+
+object RasiSettingsThemePrefs {
+    const val NAME = "rasi_settings_theme"
+    fun prefs(context: Context): SharedPreferences =
+        context.applicationContext.getSharedPreferences(NAME, Context.MODE_PRIVATE)
+
+    fun gradientColors(p: SharedPreferences): List<Int> {
+        val n = p.getInt("grad_count", 2).coerceIn(2, 4)
+        val defaults = listOf(0xFF1B1B3A.toInt(), 0xFF3A1C71.toInt(), 0xFF6A2C70.toInt(), 0xFF8E3B78.toInt())
+        return List(n) { p.getInt("grad_$it", defaults[it]) }
+    }
+}
+
+private fun angledBrush(colors: List<Int>, angle: Float): Brush = object : ShaderBrush() {
+    override fun createShader(size: Size): Shader {
+        val e = GradientMath.endpoints(size.width, size.height, angle)
+        return LinearGradientShader(
+            Offset(e[0], e[1]),
+            Offset(e[2], e[3]),
+            colors.map { Color(it) }
+        )
+    }
+}
+
+@SuppressLint("RestrictedApi")
+private fun schemeFromAccent(accent: Int, dark: Boolean): KeyboardColorScheme {
+    val col = Hct.fromInt(accent)
+    val dynamicScheme = DynamicScheme(
+        col,
+        Variant.VIBRANT,
+        dark,
+        0.0,
+        TonalPalette.fromHueAndChroma(col.hue, col.chroma),
+        TonalPalette.fromHueAndChroma(
+            MathUtils.sanitizeDegreesDouble(col.hue + 15.0),
+            maxOf(col.chroma - 32.0, col.chroma * 0.5)
+        ),
+        TonalPalette.fromHct(
+            DislikeAnalyzer.fixIfDisliked(
+                TemperatureCache(col).getAnalogousColors(3, 6).get(2)
+            )
+        ),
+        TonalPalette.fromHueAndChroma(col.hue, col.chroma / 1.0),
+        TonalPalette.fromHueAndChroma(col.hue, col.chroma / 1.0 + 4.0),
+    )
+    val scheme = getColorSchemeFromDynamicScheme(dynamicScheme)
+    return if (dark) wrapDarkColorScheme(scheme) else wrapLightColorScheme(scheme)
+}
+
+/**
+ * Settings theme: follows the keyboard theme by default, or uses its own accent color,
+ * light/dark mode and optional gradient background.
+ */
+@Composable
+fun RasiSettingsThemeAuto(content: @Composable () -> Unit) {
+    val context = LocalContext.current
+    val prefs = remember { RasiSettingsThemePrefs.prefs(context) }
+    var version by remember { mutableIntStateOf(0) }
+
+    DisposableEffect(prefs) {
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ -> version++ }
+        prefs.registerOnSharedPreferenceChangeListener(listener)
+        onDispose { prefs.unregisterOnSharedPreferenceChangeListener(listener) }
+    }
+
+    if (version >= 0 && prefs.getInt("mode", 0) == 1) {
+        val accent = prefs.getInt("accent", 0xFF8E7CFF.toInt())
+        val dark = prefs.getBoolean("dark", true)
+        val scheme = remember(accent, dark) { schemeFromAccent(accent, dark) }
+
+        val gradientOn = prefs.getBoolean("grad_on", false)
+        val brush: Brush? = if (gradientOn) {
+            angledBrush(RasiSettingsThemePrefs.gradientColors(prefs), prefs.getFloat("grad_angle", 90f))
+        } else null
+
+        UixThemeWrapper(colorScheme = scheme) {
+            CompositionLocalProvider(LocalRasiSettingsBackground provides brush) {
+                content()
+            }
+        }
+    } else {
+        UixThemeAuto(content)
+    }
+}
+
+@Composable
+private fun HsvPicker(color: Int, resetKey: Any, onColor: (Int) -> Unit) {
+    val init = remember(resetKey) { FloatArray(3).also { android.graphics.Color.colorToHSV(color, it) } }
+    var h by remember(resetKey) { mutableFloatStateOf(init[0]) }
+    var s by remember(resetKey) { mutableFloatStateOf(init[1]) }
+    var v by remember(resetKey) { mutableFloatStateOf(init[2]) }
+    var hex by remember(resetKey, color) { mutableStateOf(String.format("#%06X", color and 0xFFFFFF)) }
+
+    val apply = { nh: Float, ns: Float, nv: Float ->
+        h = nh
+        s = ns
+        v = nv
+        onColor(android.graphics.Color.HSVToColor(floatArrayOf(nh.coerceIn(0f, 360f), ns.coerceIn(0f, 1f), nv.coerceIn(0f, 1f))))
+    }
+    val hueColor = Color(android.graphics.Color.HSVToColor(floatArrayOf(h.coerceIn(0f, 360f), 1f, 1f)))
+
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        LabeledSlider(
+            label = "Hue", value = h, valueRange = 0f..360f,
+            gradient = remember {
+                Brush.horizontalGradient((0..360 step 30).map { deg ->
+                    Color(android.graphics.Color.HSVToColor(floatArrayOf(deg.toFloat(), 1f, 1f)))
+                })
+            },
+            onValueChange = { apply(it, s, v) }
+        )
+        LabeledSlider(
+            label = "Saturation", value = s, valueRange = 0f..1f,
+            gradient = Brush.horizontalGradient(listOf(Color.White, hueColor)),
+            onValueChange = { apply(h, it, v) }
+        )
+        LabeledSlider(
+            label = "Brightness", value = v, valueRange = 0f..1f,
+            gradient = Brush.horizontalGradient(listOf(Color.Black, hueColor)),
+            onValueChange = { apply(h, s, it) }
+        )
+        OutlinedTextField(
+            value = hex,
+            onValueChange = { t ->
+                hex = t
+                if (t.length == 7 && t[0] == '#') {
+                    val c = runCatching { android.graphics.Color.parseColor(t) }.getOrNull()
+                    if (c != null) {
+                        val a = FloatArray(3)
+                        android.graphics.Color.colorToHSV(c, a)
+                        h = a[0]; s = a[1]; v = a[2]
+                        onColor(c)
+                    }
+                }
+            },
+            singleLine = true,
+            label = { Text(stringResource(R.string.rasi_key_color_hex)) },
+            modifier = Modifier.fillMaxWidth()
+        )
+    }
+}
+
+@Composable
+fun RasiSettingsThemeScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiSettingsThemePrefs.prefs(context) }
+
+    var mode by remember { mutableIntStateOf(prefs.getInt("mode", 0)) }
+    var dark by remember { mutableStateOf(prefs.getBoolean("dark", true)) }
+    var accent by remember { mutableIntStateOf(prefs.getInt("accent", 0xFF8E7CFF.toInt())) }
+    var gradOn by remember { mutableStateOf(prefs.getBoolean("grad_on", false)) }
+    var angle by remember { mutableFloatStateOf(prefs.getFloat("grad_angle", 90f)) }
+    val gradColors = remember { mutableStateListOfInts(RasiSettingsThemePrefs.gradientColors(prefs)) }
+    var selected by remember { mutableIntStateOf(0) }
+
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.rasi_settings_theme_title), showBack = true, navController)
+
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                val setMode = { m: Int ->
+                    mode = m
+                    prefs.edit().putInt("mode", m).apply()
+                }
+                if (mode == 0) {
+                    Button(onClick = { setMode(0) }) { Text(stringResource(R.string.rasi_settings_theme_follow)) }
+                    OutlinedButton(onClick = { setMode(1) }) { Text(stringResource(R.string.rasi_settings_theme_custom)) }
+                } else {
+                    OutlinedButton(onClick = { setMode(0) }) { Text(stringResource(R.string.rasi_settings_theme_follow)) }
+                    Button(onClick = { setMode(1) }) { Text(stringResource(R.string.rasi_settings_theme_custom)) }
+                }
+            }
+
+            if (mode == 1) {
+                Row(
+                    Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.SpaceBetween
+                ) {
+                    Text(stringResource(R.string.rasi_settings_theme_dark))
+                    Switch(checked = dark, onCheckedChange = {
+                        dark = it
+                        prefs.edit().putBoolean("dark", it).apply()
+                    })
+                }
+
+                Text(stringResource(R.string.rasi_settings_theme_accent))
+                HsvPicker(accent, "accent") {
+                    accent = it
+                    prefs.edit().putInt("accent", it).apply()
+                }
+
+                Row(
+                    Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.SpaceBetween
+                ) {
+                    Text(stringResource(R.string.rasi_settings_theme_gradient))
+                    Switch(checked = gradOn, onCheckedChange = {
+                        gradOn = it
+                        prefs.edit().putBoolean("grad_on", it).apply()
+                    })
+                }
+
+                if (gradOn) {
+                    Row(
+                        modifier = Modifier.horizontalScroll(rememberScrollState()),
+                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        gradColors.forEachIndexed { i, c ->
+                            Row(
+                                Modifier
+                                    .size(40.dp)
+                                    .clip(CircleShape)
+                                    .background(Color(c))
+                                    .border(if (i == selected) 3.dp else 1.dp, if (i == selected) Color.White else Color.Gray, CircleShape)
+                                    .clickable { selected = i }
+                            ) {}
+                        }
+                    }
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        if (gradColors.size < 4) {
+                            OutlinedButton(onClick = {
+                                gradColors.add(gradColors.last())
+                                selected = gradColors.size - 1
+                                saveGradient(prefs, gradColors, angle)
+                            }) { Text(stringResource(R.string.rasi_gradient_add)) }
+                        }
+                        if (gradColors.size > 2) {
+                            OutlinedButton(onClick = {
+                                gradColors.removeAt(selected.coerceIn(0, gradColors.size - 1))
+                                selected = 0
+                                saveGradient(prefs, gradColors, angle)
+                            }) { Text(stringResource(R.string.rasi_gradient_remove)) }
+                        }
+                    }
+
+                    val sel = selected.coerceIn(0, gradColors.size - 1)
+                    HsvPicker(gradColors[sel], sel to gradColors.size) {
+                        gradColors[sel] = it
+                        saveGradient(prefs, gradColors, angle)
+                    }
+
+                    Text(stringResource(R.string.rasi_gradient_angle))
+                    LabeledSlider(
+                        label = "Angle", value = angle.coerceIn(0f, 360f), valueRange = 0f..360f,
+                        gradient = Brush.horizontalGradient(listOf(Color(0xFF555555), Color(0xFFBBBBBB))),
+                        onValueChange = {
+                            angle = it
+                            saveGradient(prefs, gradColors, it)
+                        }
+                    )
+                }
+            }
+        }
+    }
+}
+
+private fun mutableStateListOfInts(list: List<Int>) =
+    androidx.compose.runtime.mutableStateListOf<Int>().also { it.addAll(list) }
+
+private fun saveGradient(prefs: SharedPreferences, colors: List<Int>, angle: Float) {
+    prefs.edit().apply {
+        putInt("grad_count", colors.size)
+        colors.forEachIndexed { i, c -> putInt("grad_$i", c) }
+        putFloat("grad_angle", angle)
+    }.apply()
+}
