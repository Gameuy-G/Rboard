@@ -0,0 +1,290 @@
+package org.futo.inputmethod.latin.uix.theme
+
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.FileProvider
+import kotlinx.coroutines.runBlocking
+import org.futo.inputmethod.latin.uix.KeyboardColorScheme
+import org.futo.inputmethod.latin.uix.RasiSounds
+import org.futo.inputmethod.latin.uix.THEME_KEY
+import org.futo.inputmethod.latin.uix.setSetting
+import org.futo.inputmethod.latin.uix.theme.serialization.SerializableJsonTheme
+import org.futo.inputmethod.latin.uix.theme.serialization.themeJson
+import org.json.JSONObject
+import java.io.File
+import java.io.InputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipFile
+import java.util.zip.ZipOutputStream
+
+/**
+ * Sharing themes as one .rboardtheme file (a zip: config.json, images, fonts and optionally sounds).
+ * Importing only ever reads data: nothing from the file is run, and file names inside the zip are
+ * never used as paths on disk.
+ */
+object RasiThemeShare {
+    const val EXT = "rboardtheme"
+    private const val CONFIG = "config.json"
+    private const val SOUND_PREFIX = "rboard_sounds/"
+    private const val MAX_FILE = 40L * 1024 * 1024
+    private const val MAX_ENTRY = 24L * 1024 * 1024
+    private const val MAX_TOTAL = 60L * 1024 * 1024
+    private const val MAX_ENTRIES = 300
+    private const val MAX_SOUND = 3L * 1024 * 1024
+
+    class Inspect(
+        val file: File,
+        val name: String,
+        val author: String,
+        val soundSlots: List<String>,
+        val scheme: KeyboardColorScheme?,
+        val error: String?
+    )
+
+    private fun cleanName(raw: String): String {
+        val c = raw.trim().replace(Regex("[^\\p{L}\\p{N} _.-]"), "").trim().trimEnd('_')
+        return if (c.length >= 3) c.take(40) else "Shared theme"
+    }
+
+    private fun soundEntry(slot: String) = "$SOUND_PREFIX$slot.snd"
+
+    private fun readCapped(zf: ZipFile, e: ZipEntry, limit: Long): ByteArray? {
+        zf.getInputStream(e).use { input ->
+            val out = java.io.ByteArrayOutputStream()
+            val buf = ByteArray(16384)
+            var total = 0L
+            while (true) {
+                val n = input.read(buf)
+                if (n < 0) break
+                total += n
+                if (total > limit) return null
+                out.write(buf, 0, n)
+            }
+            return out.toByteArray()
+        }
+    }
+
+    /** Sets name and id inside config.json so every shared theme has a usable name. */
+    private fun patchConfig(bytes: ByteArray, name: String): ByteArray = try {
+        val o = JSONObject(String(bytes, Charsets.UTF_8))
+        o.put("name", name)
+        o.put("id", name)
+        o.toString().toByteArray(Charsets.UTF_8)
+    } catch (e: Exception) {
+        bytes
+    }
+
+    // ---------------------------------------------------------------- export
+
+    fun exportFile(context: Context, theme: ZipThemes.ThemeFileName, includeSounds: Boolean): File? {
+        if (theme.location != ZipThemes.ThemeLocation.Custom) return null
+        val src = File(ZipThemes.customThemesDir(context), "${theme.name}.zip")
+        if (!src.isFile) return null
+        val dir = File(context.cacheDir, "shared_themes")
+        dir.mkdirs()
+        dir.listFiles()?.forEach { it.delete() }
+        val shown = cleanName(theme.name)
+        val dst = File(dir, "$shown.$EXT")
+        return try {
+            ZipFile(src).use { zf ->
+                ZipOutputStream(dst.outputStream().buffered()).use { zos ->
+                    val entries = zf.entries()
+                    while (entries.hasMoreElements()) {
+                        val e = entries.nextElement()
+                        if (e.isDirectory || e.name.startsWith(SOUND_PREFIX)) continue
+                        var bytes = zf.getInputStream(e).use { it.readBytes() }
+                        if (e.name == CONFIG) bytes = patchConfig(bytes, shown)
+                        zos.putNextEntry(ZipEntry(e.name))
+                        zos.write(bytes)
+                        zos.closeEntry()
+                    }
+                    if (includeSounds) {
+                        val soundDir = File(context.filesDir, "rasi_sounds")
+                        val slots = JSONObject()
+                        for (slot in RasiSounds.SLOTS) {
+                            val fn = RasiSounds.fileName(context, slot) ?: continue
+                            val f = File(soundDir, fn)
+                            if (!f.isFile || f.length() <= 0 || f.length() > MAX_SOUND) continue
+                            zos.putNextEntry(ZipEntry(soundEntry(slot)))
+                            zos.write(f.readBytes())
+                            zos.closeEntry()
+                            slots.put(slot, true)
+                        }
+                        if (slots.length() > 0) {
+                            zos.putNextEntry(ZipEntry("rboard_sounds.json"))
+                            zos.write(JSONObject().put("slots", slots).toString().toByteArray(Charsets.UTF_8))
+                            zos.closeEntry()
+                        }
+                    }
+                }
+            }
+            dst
+        } catch (e: Exception) {
+            dst.delete()
+            null
+        }
+    }
+
+    /** Opens the Android share sheet with the theme file. Returns false if the file could not be made. */
+    fun share(context: Context, theme: ZipThemes.ThemeFileName, includeSounds: Boolean): Boolean {
+        val f = exportFile(context, theme, includeSounds) ?: return false
+        return try {
+            val uri = FileProvider.getUriForFile(context, context.packageName + ".themeshare", f)
+            val send = Intent(Intent.ACTION_SEND)
+            send.type = "application/octet-stream"
+            send.putExtra(Intent.EXTRA_STREAM, uri)
+            send.putExtra(Intent.EXTRA_SUBJECT, f.name)
+            send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            val chooser = Intent.createChooser(send, null)
+            chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            context.startActivity(chooser)
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    // ---------------------------------------------------------------- import
+
+    /**
+     * Checks a file. Returns null when it is not a Rboard theme file at all (so other importers can
+     * look at it), otherwise an Inspect that has either a preview or an error message.
+     */
+    fun inspect(context: Context, input: InputStream): Inspect? {
+        val tmp = File(context.cacheDir, "rboard_theme_import.zip")
+        tmp.delete()
+        var total = 0L
+        try {
+            tmp.outputStream().use { out ->
+                val buf = ByteArray(16384)
+                while (true) {
+                    val n = input.read(buf)
+                    if (n < 0) break
+                    total += n
+                    if (total > MAX_FILE) {
+                        tmp.delete()
+                        return Inspect(tmp, "", "", emptyList(), null, "This file is too big to be a theme.")
+                    }
+                    out.write(buf, 0, n)
+                }
+            }
+        } catch (e: Exception) {
+            tmp.delete()
+            return null
+        }
+
+        val zf = try { ZipFile(tmp) } catch (e: Exception) { tmp.delete(); return null }
+        return zf.use { z ->
+            if (z.getEntry(CONFIG) == null) { return null }
+            fun fail(msg: String) = Inspect(tmp, "", "", emptyList(), null, msg)
+
+            var count = 0
+            var sum = 0L
+            val en = z.entries()
+            while (en.hasMoreElements()) {
+                val e = en.nextElement()
+                count++
+                if (count > MAX_ENTRIES) return fail("This theme file has too many files.")
+                val n = e.name
+                if (n.startsWith("/") || n.startsWith("\\") || n.contains("..")) {
+                    return fail("This theme file has an unsafe file name.")
+                }
+                if (e.isDirectory) continue
+                val bytes = readCapped(z, e, MAX_ENTRY) ?: return fail("This theme file has a file that is too big.")
+                sum += bytes.size
+                if (sum > MAX_TOTAL) return fail("This theme file is too big when unpacked.")
+            }
+
+            val cfgBytes = readCapped(z, z.getEntry(CONFIG), 2L * 1024 * 1024) ?: return fail("Theme settings are too big.")
+            val parsed: SerializableJsonTheme = try {
+                themeJson.decodeFromString<SerializableJsonTheme>(String(cfgBytes, Charsets.UTF_8))
+            } catch (e: Exception) {
+                return fail("The theme settings could not be read. The file may be damaged.")
+            }
+
+            val slots = ArrayList<String>()
+            if (z.getEntry("rboard_sounds.json") != null) {
+                for (slot in RasiSounds.SLOTS) {
+                    val se = z.getEntry(soundEntry(slot)) ?: continue
+                    if (se.size in 1..MAX_SOUND) slots.add(slot)
+                }
+            }
+
+            val scheme = try {
+                ZipThemes.rasiSchemeFromFile(context, tmp)
+            } catch (e: Throwable) {
+                return fail("The theme could not be loaded. It may be damaged or from a newer version.")
+            }
+
+            Inspect(
+                tmp,
+                cleanName(parsed.name ?: parsed.id ?: "Shared theme"),
+                parsed.author ?: "",
+                slots,
+                scheme,
+                null
+            )
+        }
+    }
+
+    private fun uniqueName(context: Context, base: String): String {
+        val dir = ZipThemes.customThemesDir(context)
+        var n = base
+        var i = 2
+        while (File(dir, "$n.zip").exists()) {
+            n = "$base $i"
+            i++
+        }
+        return n
+    }
+
+    /** Saves the theme as a NEW custom theme (never replaces one). Returns its name, or null on failure. */
+    fun install(context: Context, insp: Inspect, withSounds: Boolean, useNow: Boolean): String? {
+        if (insp.error != null) return null
+        val name = uniqueName(context, insp.name)
+        val dst = File(ZipThemes.customThemesDir(context), "$name.zip")
+        try {
+            ZipFile(insp.file).use { zf ->
+                ZipOutputStream(dst.outputStream().buffered()).use { zos ->
+                    val en = zf.entries()
+                    while (en.hasMoreElements()) {
+                        val e = en.nextElement()
+                        if (e.isDirectory || e.name.startsWith(SOUND_PREFIX) || e.name == "rboard_sounds.json") continue
+                        var bytes = zf.getInputStream(e).use { it.readBytes() }
+                        if (e.name == CONFIG) bytes = patchConfig(bytes, name)
+                        zos.putNextEntry(ZipEntry(e.name))
+                        zos.write(bytes)
+                        zos.closeEntry()
+                    }
+                }
+            }
+
+            if (withSounds && insp.soundSlots.isNotEmpty()) {
+                ZipFile(insp.file).use { zf ->
+                    val soundDir = File(context.filesDir, "rasi_sounds").also { it.mkdirs() }
+                    val prefs = RasiSounds.prefs(context)
+                    for (slot in insp.soundSlots) {
+                        val se = zf.getEntry(soundEntry(slot)) ?: continue
+                        val bytes = readCapped(zf, se, MAX_SOUND) ?: continue
+                        if (bytes.isEmpty()) continue
+                        RasiSounds.fileName(context, slot)?.let { File(soundDir, it).delete() }
+                        val fn = "${slot}_${System.currentTimeMillis()}.snd"
+                        File(soundDir, fn).writeBytes(bytes)
+                        prefs.edit().putString("file_$slot", fn).putBoolean("enabled", true).apply()
+                    }
+                }
+                RasiSounds.reload()
+            }
+
+            if (useNow) {
+                runBlocking { context.setSetting(THEME_KEY, ZipThemes.custom(name).toSetting()) }
+            }
+            ZipThemes.updateCount.intValue += 1
+            insp.file.delete()
+            return name
+        } catch (e: Exception) {
+            dst.delete()
+            return null
+        }
+    }
+}
