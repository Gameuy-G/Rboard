+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+
+private class BgKey(val label: String, val code: Int, val row: Int, val col: Int, val span: Int)
+
+private val BG_SAMPLE_KEYS: List<BgKey> = buildList {
+    val rows = listOf("qwertyu", "asdfghj", "zxcvbnm")
+    rows.forEachIndexed { r, str -> str.forEachIndexed { c, ch -> add(BgKey(ch.toString(), ch.code, r, c, 1)) } }
+    add(BgKey("DEL", Constants.CODE_DELETE, 3, 0, 1))
+    add(BgKey("SPACE", Constants.CODE_SPACE, 3, 1, 5))
+    add(BgKey("ENTER", Constants.CODE_ENTER, 3, 6, 1))
+}
+
+@Composable
+fun RasiBgEffectsScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiBgEffects.prefs(context) }
+
+    var enabled by remember { mutableStateOf(prefs.getBoolean("enabled", false)) }
+    var fill by remember { mutableStateOf(prefs.getString("mode", RasiBgEffects.MODE_BURST) == RasiBgEffects.MODE_FILL) }
+    var target by rememberSaveable { mutableStateOf(RasiEffects.DEFAULT) }
+    var tick by remember { mutableIntStateOf(0) }
+
+    var size by remember(target) { mutableFloatStateOf(prefs.getFloat(RasiEffects.k("size", target), 100f)) }
+    var alpha by remember(target) { mutableFloatStateOf(prefs.getFloat(RasiEffects.k("alpha", target), 100f)) }
+
+    val picker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) {
+            RasiBgEffects.importEffect(context, uri, target)
+            tick++
+        }
+    }
+
+    val chromaPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) {
+            RasiChroma.pendingUri = uri
+            RasiChroma.pendingScope = RasiChroma.SCOPE_BG
+            RasiChroma.pendingTarget = target
+            navController.navigate("rasiChroma")
+        }
+    }
+
+    val hasFile = if (tick >= 0) RasiBgEffects.effectFile(context, target) != null else false
+    val preview: Drawable? = remember(tick, target) { RasiBgEffects.decode(context, target) }
+
+    val chips = listOf(
+        RasiEffects.DEFAULT to stringResource(R.string.rasi_effects_all),
+        "group_letters" to stringResource(R.string.rasi_effects_letters),
+        "group_space" to stringResource(R.string.rasi_effects_space),
+        "group_delete" to stringResource(R.string.rasi_effects_delete),
+        "group_enter" to stringResource(R.string.rasi_effects_enter)
+    )
+
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.rasi_bg_title), showBack = true, navController)
+
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(stringResource(R.string.rasi_bg_hint))
+
+            Row(
+                Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.SpaceBetween
+            ) {
+                Text(stringResource(R.string.rasi_bg_enable))
+                Switch(checked = enabled, onCheckedChange = {
+                    enabled = it
+                    prefs.edit().putBoolean("enabled", it).apply()
+                    RasiBgEffects.reload()
+                })
+            }
+
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                val burstLabel = stringResource(R.string.rasi_bg_mode_burst)
+                val fillLabel = stringResource(R.string.rasi_bg_mode_fill)
+                if (!fill) Button(onClick = {}) { Text(burstLabel) }
+                else OutlinedButton(onClick = {
+                    fill = false
+                    prefs.edit().putString("mode", RasiBgEffects.MODE_BURST).apply()
+                }) { Text(burstLabel) }
+                if (fill) Button(onClick = {}) { Text(fillLabel) }
+                else OutlinedButton(onClick = {
+                    fill = true
+                    prefs.edit().putString("mode", RasiBgEffects.MODE_FILL).apply()
+                }) { Text(fillLabel) }
+            }
+
+            Text(stringResource(R.string.rasi_effects_pick_hint))
+            Row(
+                Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                chips.forEach { (id, label) ->
+                    if (target == id) Button(onClick = { target = id }) { Text(label) }
+                    else OutlinedButton(onClick = { target = id }) { Text(label) }
+                }
+            }
+
+            // Tap a key to give it its own background effect
+            val rowH = 40.dp
+            val gap = 5.dp
+            val pad = 8.dp
+            BoxWithConstraints(
+                Modifier
+                    .fillMaxWidth()
+                    .height(pad * 2 + rowH * 4 + gap * 3)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(MaterialTheme.colorScheme.onSurface.copy(alpha = 0.06f))
+            ) {
+                val keyColor = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.12f)
+                val ownColor = MaterialTheme.colorScheme.primary.copy(alpha = 0.18f)
+                val targetColor = MaterialTheme.colorScheme.primary.copy(alpha = 0.45f)
+                val cellW: Dp = (maxWidth - pad * 2 - gap * 6) / 7
+
+                fun inTarget(k: BgKey): Boolean = when {
+                    target == RasiEffects.DEFAULT -> false
+                    target.startsWith("key_") -> RasiEffects.keyTarget(k.code) == target
+                    else -> RasiEffects.groupFor(k.code) == target
+                }
+
+                BG_SAMPLE_KEYS.forEach { k ->
+                    val kx = pad + (cellW + gap) * k.col
+                    val ky = pad + (rowH + gap) * k.row
+                    val kw = cellW * k.span + gap * (k.span - 1)
+                    val own = if (tick >= 0) RasiBgEffects.effectFile(context, RasiEffects.keyTarget(k.code)) != null else false
+                    Box(
+                        Modifier
+                            .offset(kx, ky)
+                            .size(kw, rowH)
+                            .clip(RoundedCornerShape(10.dp))
+                            .background(if (inTarget(k)) targetColor else if (own) ownColor else keyColor)
+                            .clickable { target = RasiEffects.keyTarget(k.code) },
+                        contentAlignment = Alignment.Center
+                    ) {
+                        Text(k.label.uppercase(), textAlign = TextAlign.Center)
+                    }
+                }
+            }
+
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedButton(onClick = {
+                    picker.launch(arrayOf("image/gif", "image/webp", "image/png"))
+                }) { Text(stringResource(R.string.rasi_sounds_choose)) }
+                OutlinedButton(onClick = {
+                    chromaPicker.launch(arrayOf("video/*", "image/gif", "image/png", "image/jpeg", "image/webp"))
+                }) { Text(stringResource(R.string.rasi_chroma_import)) }
+                if (hasFile) {
+                    OutlinedButton(onClick = {
+                        RasiBgEffects.clear(context, target)
+                        tick++
+                    }) { Text(stringResource(R.string.rasi_sounds_clear)) }
+                }
+            }
+
+            if (!hasFile && target != RasiEffects.DEFAULT) {
+                Text(stringResource(R.string.rasi_effects_inherit))
+            }
+            if (hasFile && preview == null) {
+                Text(stringResource(R.string.rasi_effects_unsupported))
+            }
+
+            if (preview != null) {
+                Box(
+                    Modifier
+                        .fillMaxWidth()
+                        .height(160.dp)
+                        .clip(RoundedCornerShape(16.dp))
+                        .background(MaterialTheme.colorScheme.onSurface.copy(alpha = 0.10f))
+                ) {
+                    AndroidView(
+                        factory = { ctx -> ImageView(ctx).apply { scaleType = ImageView.ScaleType.FIT_CENTER } },
+                        update = { iv ->
+                            iv.setImageDrawable(preview)
+                            if (Build.VERSION.SDK_INT >= 28 && preview is AnimatedImageDrawable) {
+                                preview.repeatCount = AnimatedImageDrawable.REPEAT_INFINITE
+                                preview.start()
+                            } else if (preview is ChromaDrawable) {
+                                preview.loop = true
+                                preview.stretch = fill
+                                preview.start()
+                            }
+                        },
+                        modifier = Modifier.fillMaxSize()
+                    )
+                }
+
+                if (!fill) {
+                    Text(stringResource(R.string.rasi_bg_size))
+                    Slider(
+                        value = size,
+                        onValueChange = {
+                            size = it
+                            prefs.edit().putFloat(RasiEffects.k("size", target), it).apply()
+                        },
+                        valueRange = 30f..300f
+                    )
+                }
+                Text(stringResource(R.string.rasi_bg_opacity))
+                Slider(
+                    value = alpha,
+                    onValueChange = {
+                        alpha = it
+                        prefs.edit().putFloat(RasiEffects.k("alpha", target), it).apply()
+                    },
+                    valueRange = 10f..100f
+                )
+            }
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/settings/pages/RasiBorderGlowScreen.kt b/java/src/org/futo/inputmethod/latin/uix/settings/pages/RasiBorderGlowScreen.kt
