+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+
+/** Settings for the small popup that shows the letter when you press a key. */
+object RasiPopup {
+    private const val PREFS = "rasi_popup"
+    @Volatile private var ms = 0
+    @Volatile private var start = 0.75f
+
+    private fun prefs(c: Context) = c.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    @JvmStatic
+    fun init(context: Context) {
+        ms = prefs(context).getInt("ms", 0)
+        start = prefs(context).getFloat("start", 0.75f)
+    }
+
+    /** 0 means the normal built-in popup animation. */
+    @JvmStatic
+    fun durationMs(): Int = ms
+
+    @JvmStatic
+    fun startScale(): Float = start
+
+    fun set(context: Context, durationMs: Int, startScale: Float) {
+        ms = durationMs
+        start = startScale
+        prefs(context).edit().putInt("ms", durationMs).putFloat("start", startScale).apply()
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiPush.kt b/java/src/org/futo/inputmethod/latin/uix/RasiPush.kt
new file mode 100644
index 000000000..0cb8ba1be
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiPush.kt
@@ -0,0 +1,119 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.net.Uri
+import android.os.PowerManager
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+
+val RasiPushSetting = SettingsKey(booleanPreferencesKey("rasi_push"), true)
+
+/**
+ * Near-instant messages and update alerts without Google services: while the screen is on, the keyboard
+ * keeps one small stream open to an ntfy topic. Messages missed while the screen was off arrive when it
+ * turns on again. Nothing runs while the screen is off.
+ *
+ * Anyone who knows the topic name can send messages, so keep it private.
+ */
+object RasiPush {
+    const val SERVER = "https://ntfy.sh"
+    const val TOPIC = "rboard-9cfbacd2ea78769856b0"
+
+    private val lock = Object()
+    @Volatile private var awake = true
+    @Volatile private var conn: HttpURLConnection? = null
+    @Volatile private var thread: Thread? = null
+    private var receiverOn = false
+
+    fun start(context: Context) {
+        val app = context.applicationContext
+        try {
+            if (!rasiRead(app, RasiPushSetting.key, RasiPushSetting.default)) return
+        } catch (_: Throwable) { return }
+        if (!receiverOn) {
+            receiverOn = true
+            awake = (app.getSystemService(Context.POWER_SERVICE) as PowerManager).isInteractive
+            val f = IntentFilter().apply {
+                addAction(Intent.ACTION_SCREEN_ON)
+                addAction(Intent.ACTION_SCREEN_OFF)
+            }
+            androidx.core.content.ContextCompat.registerReceiver(app, object : BroadcastReceiver() {
+                override fun onReceive(c: Context?, i: Intent?) {
+                    if (i?.action == Intent.ACTION_SCREEN_ON) {
+                        synchronized(lock) { awake = true; lock.notifyAll() }
+                        c?.let { start(it) }
+                    } else {
+                        awake = false
+                        try { conn?.disconnect() } catch (_: Throwable) {}
+                    }
+                }
+            }, f, androidx.core.content.ContextCompat.RECEIVER_NOT_EXPORTED)
+        }
+        val t = thread
+        if (t != null && t.isAlive) return
+        thread = Thread({ loop(app) }, "rasi-push").apply { isDaemon = true; start() }
+    }
+
+    private fun prefs(app: Context) = app.getSharedPreferences("rasi_push", Context.MODE_PRIVATE)
+
+    private fun loop(app: Context) {
+        var backoff = 5000L
+        while (true) {
+            try {
+                if (!rasiRead(app, RasiPushSetting.key, RasiPushSetting.default)) return
+            } catch (_: Throwable) { return }
+            synchronized(lock) { while (!awake) lock.wait() }
+            try {
+                val p = prefs(app)
+                val since = p.getString("last_id", null) ?: (System.currentTimeMillis() / 1000L).toString()
+                val c = URL("$SERVER/$TOPIC/json?since=$since").openConnection() as HttpURLConnection
+                conn = c
+                c.connectTimeout = 15000
+                c.readTimeout = 120000 // the server sends a keepalive about every 45 seconds
+                c.setRequestProperty("User-Agent", "Rboard-push")
+                if (c.responseCode != 200) throw RuntimeException("http " + c.responseCode)
+                backoff = 5000L
+                c.inputStream.bufferedReader().use { r ->
+                    while (true) {
+                        val line = r.readLine() ?: break
+                        if (line.isBlank()) continue
+                        try {
+                            val o = JSONObject(line)
+                            if (o.optString("event") != "message") continue
+                            val id = o.optString("id")
+                            if (id.isNotBlank()) p.edit().putString("last_id", id).apply()
+                            handle(app, o)
+                        } catch (_: Throwable) {}
+                    }
+                }
+            } catch (_: Throwable) {
+            } finally {
+                try { conn?.disconnect() } catch (_: Throwable) {}
+                conn = null
+            }
+            if (!awake) continue
+            try { Thread.sleep(backoff) } catch (_: InterruptedException) {}
+            backoff = (backoff * 2).coerceAtMost(300000L)
+        }
+    }
+
+    private fun handle(app: Context, o: JSONObject) {
+        val tags = o.optJSONArray("tags")
+        var isUpdate = false
+        if (tags != null) for (i in 0 until tags.length()) if (tags.optString(i) == "update") isUpdate = true
+        val ok = if (isUpdate) rasiRead(app, RasiUpdateNotifySetting.key, RasiUpdateNotifySetting.default)
+                 else rasiRead(app, RasiNoticesSetting.key, RasiNoticesSetting.default)
+        if (!ok) return
+        val click = o.optString("click").ifBlank { if (isUpdate) RasiUpdate.APK_URL else "" }
+        val att = o.optJSONObject("attachment")?.optString("url") ?: ""
+        RasiNotice.show(
+            app, "push" + o.optString("id"),
+            o.optString("title"), o.optString("message"), click, att
+        )
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiRecentEmoji.kt b/java/src/org/futo/inputmethod/latin/uix/RasiRecentEmoji.kt
