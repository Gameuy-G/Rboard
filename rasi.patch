+    private val path = android.graphics.Path()
+    private val flamePath = android.graphics.Path()
+    private val srcR = android.graphics.Rect()
+    private val dstR = RectF()
+    private val artPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+
+    private fun drawCircular(
+        canvas: Canvas, p: android.content.SharedPreferences, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float
+    ) {
+        val count = p.getInt("viz_count", -1).let { if (it < 4) defaultCount(style) else it }
+        val mirror = p.getBoolean("viz_mirror", true)
+        val thick = p.getInt("viz_thick", 3) * dens
+        val r0 = minOf(w, h) / 2f * p.getInt("viz_size", 60) / 100f * 0.6f
+        val posMode = p.getString("viz_cpos", "center") ?: "center"
+        val cx = if (posMode == "custom") w * p.getInt("viz_cx", 50) / 100f else w / 2f
+        val cy = if (posMode == "custom") h * p.getInt("viz_cy", 50) / 100f else h / 2f
+        val now = col.now
+        val angle = if (p.getBoolean("viz_spin", false)) (now % 3600000L) / 1000f * p.getInt("viz_spin_speed", 30) else 0f
+        val pulse = 1f + 0.12f * (bass * sens).coerceIn(0f, 1f)
+
+        fun lv(j: Int, arr: FloatArray): Float {
+            val t = j / count.toFloat()
+            val sp = (if (mirror) Math.abs(2f * t - 1f) else t) * (N - 1)
+            return (at(arr, sp) * sens).coerceIn(0f, 1f)
+        }
+        // folded so the colors loop around the circle without a hard seam
+        fun ct(j: Int): Float = 1f - Math.abs(2f * (j / count.toFloat()) - 1f)
+
+        canvas.save()
+        canvas.rotate(angle, cx, cy)
+        paint.shader = null
+        when (style) {
+            "radial" -> {
+                paint.style = Paint.Style.STROKE
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.strokeWidth = thick
+                for (j in 0 until count) {
+                    val a = (j / count.toFloat()) * 2f * Math.PI.toFloat() - Math.PI.toFloat() / 2f
+                    val len = r0 * 0.9f * lv(j, disp) + thick
+                    val rin = r0 * pulse
+                    val ca = Math.cos(a.toDouble()).toFloat()
+                    val sa = Math.sin(a.toDouble()).toFloat()
+                    paint.color = col.at(ct(j)); paint.alpha = alpha
+                    canvas.drawLine(cx + ca * rin, cy + sa * rin, cx + ca * (rin + len), cy + sa * (rin + len), paint)
+                }
+            }
+            "ring" -> {
+                paint.style = Paint.Style.FILL
+                val c0 = col.at(0.5f)
+                paint.shader = RadialGradient(
+                    cx, cy, r0 * 1.6f,
+                    intArrayOf(AColor.argb(alpha / 3, AColor.red(c0), AColor.green(c0), AColor.blue(c0)),
+                        AColor.argb(0, AColor.red(c0), AColor.green(c0), AColor.blue(c0))),
+                    null, Shader.TileMode.CLAMP
+                )
+                canvas.drawCircle(cx, cy, r0 * 1.6f, paint)
+                paint.shader = null
+                for (j in 0 until count) {
+                    val a = (j / count.toFloat()) * 2f * Math.PI.toFloat() - Math.PI.toFloat() / 2f
+                    val ca = Math.cos(a.toDouble()).toFloat()
+                    val sa = Math.sin(a.toDouble()).toFloat()
+                    val c = col.at(ct(j))
+                    paint.color = c
+                    // inner ring: dots pushed outward by the sound
+                    val ri = r0 * pulse + r0 * 0.35f * lv(j, disp)
+                    paint.alpha = alpha
+                    canvas.drawCircle(cx + ca * ri, cy + sa * ri, thick * 0.6f, paint)
+                    // outer faint ring follows the peaks
+                    val ro = r0 * 1.4f + r0 * 0.25f * lv(j, peaks)
+                    paint.alpha = alpha / 2
+                    canvas.drawCircle(cx + ca * ro, cy + sa * ro, thick * 0.4f, paint)
+                }
+            }
+            else -> { // blob
+                val rr = FloatArray(count)
+                for (j in 0 until count) rr[j] = r0 * pulse * (0.85f + 0.55f * lv(j, disp))
+                val sweepCols = IntArray(9) { col.at(ct((it / 8f * count).toInt().coerceAtMost(count))) }
+                // layered: faint outer outline from the peaks, then the main blob
+                for (layer in 0..1) {
+                    path.reset()
+                    val pts = FloatArray(count * 2)
+                    for (j in 0 until count) {
+                        val a = (j / count.toFloat()) * 2f * Math.PI.toFloat() - Math.PI.toFloat() / 2f
+                        val rad = if (layer == 0) r0 * pulse * (1.0f + 0.7f * lv(j, peaks)) else rr[j]
+                        pts[2 * j] = cx + Math.cos(a.toDouble()).toFloat() * rad
+                        pts[2 * j + 1] = cy + Math.sin(a.toDouble()).toFloat() * rad
+                    }
+                    for (j in 0 until count) {
+                        val x1 = pts[2 * j]; val y1 = pts[2 * j + 1]
+                        val k = (j + 1) % count
+                        val mx = (x1 + pts[2 * k]) / 2f; val my = (y1 + pts[2 * k + 1]) / 2f
+                        if (j == 0) {
+                            val l = (count - 1)
+                            path.moveTo((pts[2 * l] + x1) / 2f, (pts[2 * l + 1] + y1) / 2f)
+                        }
+                        path.quadTo(x1, y1, mx, my)
+                    }
+                    path.close()
+                    val pos = FloatArray(9) { it / 8f }
+                    paint.shader = android.graphics.SweepGradient(cx, cy, sweepCols, pos)
+                    if (layer == 1) {
+                        paint.style = Paint.Style.FILL
+                        paint.alpha = alpha / 4
+                        canvas.drawPath(path, paint)
+                    }
+                    paint.style = Paint.Style.STROKE
+                    paint.strokeWidth = if (layer == 1) thick else thick * 0.5f
+                    paint.alpha = if (layer == 1) alpha else alpha / 2
+                    canvas.drawPath(path, paint)
+                    paint.shader = null
+                }
+            }
+        }
+        paint.style = Paint.Style.FILL
+        paint.shader = null
+        if (posMode == "cover") {
+            val art = RasiNowPlaying.track?.art
+            if (art != null && !art.isRecycled) {
+                val side = minOf(art.width, art.height)
+                srcR.set((art.width - side) / 2, (art.height - side) / 2, (art.width + side) / 2, (art.height + side) / 2)
+                val cr = r0 * 0.88f
+                dstR.set(cx - cr, cy - cr, cx + cr, cy + cr)
+                path.reset()
+                path.addCircle(cx, cy, cr, android.graphics.Path.Direction.CW)
+                canvas.save()
+                canvas.clipPath(path)
+                artPaint.alpha = 255
+                canvas.drawBitmap(art, srcR, dstR, artPaint)
+                canvas.restore()
+            }
+        }
+        canvas.restore()
+    }
+
+    /** The part of the visualizer below the keyboard, behind the navigation buttons. */
+    fun drawStrip(view: View, canvas: Canvas) {
+        try {
+            register(view)
+            navExt = view.height.toFloat()
+            drawFxStrip(view, canvas)
+            val p = RasiNowPlaying.live(view.context)
+            if (!p.getBoolean("mode_viz", false) || !p.getBoolean("viz_to_bottom", true)) return
+            if (RasiNowPlaying.track?.playing != true) return
+            val style = styleOf(p)
+            if (!anchored(style)) return
+            val w = view.width.toFloat()
+            val ext = view.height.toFloat()
+            val kh = kbH
+            if (w <= 0f || ext <= 0f || kh <= 0f) return
+            val alpha = (255 * p.getInt("viz_opacity", 55) / 100f).toInt().coerceIn(0, 255)
+            val sens = p.getInt("viz_sens", 70) / 100f * 1.6f
+            val col = colors(p, "viz_")
+            RasiMethods.init(view.context)
+            val aligned = RasiMethods.stripAligned && snapOk && kbW > 0f
+            var dx = 0f
+            var rw = w
+            var bBak = 0f
+            var pBak = 0f
+            if (aligned) {
+                // draw exactly what the keyboard drew: same width, same x, same sound values
+                view.getLocationOnScreen(locTmp)
+                dx = kbLeft - locTmp[0]
+                rw = kbW
+                System.arraycopy(disp, 0, bakDisp, 0, N)
+                System.arraycopy(peaks, 0, bakPeaks, 0, N)
+                bBak = bass
+                pBak = punch
+                punch = snapPunch
+                System.arraycopy(snapDisp, 0, disp, 0, N)
+                System.arraycopy(snapPeaks, 0, peaks, 0, N)
+                bass = snapBass
+            }
+            canvas.save()
+            canvas.clipRect(0f, 0f, w, ext)
+            canvas.translate(dx, -kh)
+            curExt = ext
+            noStep = true
+            try {
+                renderStyle(canvas, p, style, col, rw, kh + ext, alpha, sens, view.resources.displayMetrics.density, false)
+            } finally {
+                noStep = false
+                if (aligned) {
+                    System.arraycopy(bakDisp, 0, disp, 0, N)
+                    System.arraycopy(bakPeaks, 0, peaks, 0, N)
+                    bass = bBak
+                    punch = pBak
+                }
+            }
+            curExt = 0f
+            canvas.restore()
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "strip draw failed: " + t)
+        }
+    }
+
+    /** The small visualizer in the floating pill: bars or a ring, sized to the view. */
+    fun drawPill(view: View, canvas: Canvas) {
+        try {
+            register(view)
+            if (RasiNowPlaying.track?.playing != true) return
+            if (!running) kick()
+            val p = RasiNowPlaying.live(view.context)
+            val w = view.width.toFloat()
+            val h = view.height.toFloat()
+            if (w <= 0f || h <= 0f) return
+            val sens = p.getInt("pill_viz_sens", 70) / 100f * 1.6f
+            val alpha = (255 * p.getInt("pill_viz_opacity", 80) / 100f).toInt().coerceIn(0, 255)
+            val col = colors(p, "pill_viz_")
+            val dens = view.resources.displayMetrics.density
+            val count = p.getInt("pill_viz_count", 12).coerceIn(3, 48)
+            paint.shader = null
+            if ((p.getString("pill_viz_style", "bars") ?: "bars") == "circle") {
+                val cx = w / 2f
+                val cy = h / 2f
+                val half = minOf(w, h) / 2f
+                val r0 = half * 0.5f
+                val maxLen = half * 0.5f
+                paint.style = Paint.Style.STROKE
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.strokeWidth = maxOf(1.5f, half * 2f * 0.05f)
+                for (j in 0 until count) {
+                    val t = j / count.toFloat()
+                    val sp = Math.abs(2f * t - 1f) * (N - 1)
+                    val lv = (at(disp, sp) * sens).coerceIn(0f, 1f)
+                    val len = maxLen * lv + dens
+                    val ang = (t * 2.0 * Math.PI - Math.PI / 2.0).toFloat()
+                    val c = Math.cos(ang.toDouble()).toFloat()
+                    val s2 = Math.sin(ang.toDouble()).toFloat()
+                    paint.color = col.at(t)
+                    paint.alpha = alpha
+                    canvas.drawLine(cx + c * r0, cy + s2 * r0, cx + c * (r0 + len), cy + s2 * (r0 + len), paint)
+                }
+                paint.style = Paint.Style.FILL
+                paint.strokeCap = Paint.Cap.BUTT
+            } else {
+                paint.style = Paint.Style.FILL
+                val slot = w / count
+                val bw = (slot * 0.7f).coerceAtLeast(1f)
+                val maxH = h * 0.9f
+                for (j in 0 until count) {
+                    val t = if (count > 1) j / (count - 1f) else 0f
+                    val lv = (at(disp, t * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val bh = (maxH * lv).coerceAtLeast(2f * dens)
+                    val x = j * slot + (slot - bw) / 2f
+                    paint.color = col.at(t)
+                    paint.alpha = alpha
+                    canvas.drawRoundRect(RectF(x, h - bh, x + bw, h), bw / 2f, bw / 2f, paint)
+                }
+            }
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "pill draw failed: " + t)
+        }
+    }
