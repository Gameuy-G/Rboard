+/** One row of the @ menu: [key] is what is inserted after the @, [label] is the display name, [sub] the user name shown on the right. */
+internal class MentionOpt(val key: String, val label: String, val sub: String, val avatar: String, val color: Int, val uid: String = "")
+
+/** People whose name or user name starts with (or contains) what was typed after the @, plus Gemini when allowed. Empty input lists everybody. */
+internal fun mentionOptions(typed: String, people: List<MentionOpt>, gemini: Boolean): List<MentionOpt> {
+    val q = typed.lowercase()
+    val hit = people.filter { it.key.isNotBlank() && (q.isEmpty() || it.key.lowercase().contains(q) || it.label.lowercase().contains(q)) }
+        .sortedBy { if (it.key.lowercase().startsWith(q) || it.label.lowercase().startsWith(q)) 0 else 1 }
+    val g = if (gemini && "gemini".startsWith(q)) listOf(MentionOpt("gemini", "Gemini", "@gemini", "\u2726", 0xFF4285F4.toInt())) else emptyList()
+    return (hit + g).take(12)
+}
