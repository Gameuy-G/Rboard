+/** Image editor for a copied image: crop, rotate, draw, text. Pinch to zoom always works. */
+@Composable
+fun RasiImageEditor(file: File, onSave: (Bitmap) -> Unit, onCancel: () -> Unit) {
+    val first = remember(file) { loadEditable(file) }
+    if (first == null) {
+        Column(Modifier.fillMaxWidth().padding(8.dp)) {
+            Text("This image cannot be edited")
+            OutlinedButton(onClick = onCancel) { Text("Cancel") }
+        }
+        return
+    }
+    val ed = remember(file) { RasiEd(first) }
+    var tool by remember { mutableStateOf(ImgTool.View) }
+    val textField = remember { mutableStateOf("") }
+    val ver = ed.ver
+    val pad = PaddingValues(horizontal = 10.dp, vertical = 4.dp)
+
+    LaunchedEffect(ed.sel) {
+        val t = ed.st.texts.firstOrNull { it.id == ed.sel }
+        if (t != null && textField.value != t.text) textField.value = t.text
+    }
+    LaunchedEffect(textField.value) {
+        val id = ed.sel
+        val t = ed.st.texts.firstOrNull { it.id == id }
+        if (t != null && t.text != textField.value && textField.value.isNotEmpty()) {
+            val v = textField.value
+            ed.styleSel { it.copy(text = v) }
+        }
+    }
+
+    fun pick(t: ImgTool) {
+        val nt = if (tool == t) ImgTool.View else t
+        if (nt == ImgTool.Crop) ed.resetCrop()
+        if (nt == ImgTool.Rotate) { ed.ang = 0f; ed.resetView() }
+        if (nt != ImgTool.Text) ed.sel = -1
+        tool = nt
+    }
+
+    val rasiCompact = org.futo.inputmethod.latin.uix.rasiCompact()
+    @Composable
+    fun canvasBlock(canvasMod: Modifier) {
+        Box(
+            canvasMod
+                .onSizeChanged { ed.boxW = it.width.toFloat(); ed.boxH = it.height.toFloat() }
+                .clipToBounds()
+                .pointerInput(tool) {
+                    awaitEachGesture {
+                        val down = awaitFirstDown(requireUnconsumed = false)
+                        if (tool == ImgTool.Rotate) return@awaitEachGesture
+                        val th = 28.dp.toPx()
+                        var multi = false
+                        var mode = 0 // 0 pan, 1 draw, 2 crop, 3 text drag
+                        var cropHit = 0
+                        var pushed = false
+                        var last = down.position
+                        when (tool) {
+                            ImgTool.Draw -> { ed.beginStroke(down.position); mode = 1 }
+                            ImgTool.Crop -> {
+                                cropHit = ed.cropHit(down.position, th)
+                                mode = if (cropHit != 0) 2 else 0
+                            }
+                            ImgTool.Text -> {
+                                val id = ed.hitText(down.position)
+                                if (id >= 0) { ed.selectText(id); mode = 3 }
+                                else { ed.sel = -1; mode = 0 }
+                            }
+                            else -> mode = 0
+                        }
+                        do {
+                            val event = awaitPointerEvent()
+                            val pressed = event.changes.count { it.pressed }
+                            if (pressed >= 2) {
+                                if (!multi) { multi = true; mode = 0 }
+                                ed.applyTransform(event.calculateZoom(), event.calculatePan(), event.calculateCentroid(useCurrent = true))
+                                event.changes.forEach { it.consume() }
+                            } else if (!multi) {
+                                val ch = event.changes.firstOrNull { it.pressed } ?: event.changes.first()
+                                val pos = ch.position
+                                val d = pos - last
+                                when (mode) {
+                                    1 -> if (ch.pressed) ed.strokeTo(pos)
+                                    2 -> if (ch.pressed) ed.cropDrag(cropHit, pos, d)
+                                    3 -> if (d != Offset.Zero) {
+                                        if (!pushed) { ed.push(); pushed = true }
+                                        ed.moveText(d)
+                                    }
+                                    else -> ed.panBy(d)
+                                }
+                                last = pos
+                                ch.consume()
+                            }
+                        } while (event.changes.any { it.pressed })
+                    }
+                }
+        ) {
+            Canvas(Modifier.fillMaxSize()) {
+                val r0 = ed.rev
+                val stt = ed.st
+                val bw = stt.base.width.toFloat()
+                val bh = stt.base.height.toFloat()
+                val rotating = tool == ImgTool.Rotate
+                val sc: Float
+                if (rotating) {
+                    val rad = Math.toRadians(ed.ang.toDouble())
+                    val c = abs(cos(rad)).toFloat()
+                    val s = abs(sin(rad)).toFloat()
+                    sc = min(size.width / (bw * c + bh * s), size.height / (bw * s + bh * c))
+                } else sc = ed.scale()
+                val pn = if (rotating) Offset.Zero else ed.pan
+                val bmpPaint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+                val tp = Paint(Paint.ANTI_ALIAS_FLAG)
+                drawIntoCanvas { cv ->
+                    val n = cv.nativeCanvas
+                    n.save()
+                    n.translate(size.width / 2f + pn.x, size.height / 2f + pn.y)
+                    if (rotating) n.rotate(ed.ang)
+                    n.scale(sc, sc)
+                    n.translate(-bw / 2f, -bh / 2f)
+                    n.drawBitmap(stt.base, 0f, 0f, bmpPaint)
+                    n.drawBitmap(stt.draw, 0f, 0f, bmpPaint)
+                    stt.texts.forEach { drawTextItem(n, it, tp) }
+                    if (tool == ImgTool.Text) {
+                        val sl = stt.texts.firstOrNull { it.id == ed.sel }
+                        if (sl != null) {
+                            tp.reset()
+                            tp.typeface = typefaceFor(sl.font)
+                            tp.textSize = sl.sizePx
+                            val hw = tp.measureText(sl.text) / 2f + sl.sizePx * 0.25f
+                            val hh = sl.sizePx * 0.7f
+                            tp.style = Paint.Style.STROKE
+                            tp.strokeWidth = 2f / sc
+                            tp.color = android.graphics.Color.WHITE
+                            n.save()
+                            n.translate(sl.x, sl.y)
+                            n.rotate(sl.rot)
+                            n.drawRect(-hw, -hh, hw, hh, tp)
+                            n.restore()
+                        }
+                    }
+                    n.restore()
+                }
+                if (tool == ImgTool.Crop) {
+                    val ox = ed.ox()
+                    val oy = ed.oy()
+                    val cr = ed.crop
+                    val l = ox + cr.left * sc
+                    val rr = ox + cr.right * sc
+                    val t = oy + cr.top * sc
+                    val b = oy + cr.bottom * sc
+                    val ix1 = ox + bw * sc
+                    val iy1 = oy + bh * sc
+                    val dim = Color(0x99000000)
+                    drawRect(dim, Offset(ox, oy), Size(ix1 - ox, t - oy))
+                    drawRect(dim, Offset(ox, b), Size(ix1 - ox, iy1 - b))
+                    drawRect(dim, Offset(ox, t), Size(l - ox, b - t))
+                    drawRect(dim, Offset(rr, t), Size(ix1 - rr, b - t))
+                    val thin = 1.dp.toPx()
+                    drawRect(Color.White, Offset(l, t), Size(rr - l, b - t), style = Stroke(2.dp.toPx()))
+                    for (i in 1..2) {
+                        val gx = l + (rr - l) * i / 3f
+                        val gy = t + (b - t) * i / 3f
+                        drawLine(Color(0xAAFFFFFF), Offset(gx, t), Offset(gx, b), thin)
+                        drawLine(Color(0xAAFFFFFF), Offset(l, gy), Offset(rr, gy), thin)
+                    }
+                    val hl = 18.dp.toPx()
+                    val hw = 4.dp.toPx()
+                    fun corner(x: Float, y: Float, sx: Float, sy: Float) {
+                        drawLine(Color.White, Offset(x, y), Offset(x + sx * hl, y), hw)
+                        drawLine(Color.White, Offset(x, y), Offset(x, y + sy * hl), hw)
+                    }
+                    corner(l, t, 1f, 1f)
+                    corner(rr, t, -1f, 1f)
+                    corner(l, b, 1f, -1f)
+                    corner(rr, b, -1f, -1f)
+                }
+            }
+        }
+
+    }
+
+    @Composable
+    fun controlsBlock(controlsMod: Modifier) {
+        Column(
+            controlsMod,
+            verticalArrangement = Arrangement.spacedBy(6.dp)
+        ) {
+            when (tool) {
+                ImgTool.View -> Text("Pinch to zoom, drag to move. Pick a tool below.")
+                ImgTool.Crop -> {
+                    Row(
+                        Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                        horizontalArrangement = Arrangement.spacedBy(6.dp),
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        val ar = ed.cropAr
+                        EdChip("Custom", ar == null) { ed.setAspect(null, false) }
+                        EdChip("Original", ar != null && abs(ar - ed.st.base.width.toFloat() / ed.st.base.height) < 0.001f) { ed.setAspect(null, true) }
+                        listOf("1:1" to 1f, "4:3" to 4f / 3f, "3:4" to 3f / 4f, "16:9" to 16f / 9f, "9:16" to 9f / 16f).forEach { (n, v) ->
+                            EdChip(n, ar != null && abs(ar - v) < 0.001f) { ed.setAspect(v, false) }
+                        }
+                    }
+                    Button(contentPadding = pad, onClick = { ed.applyCrop() }) { Text("Apply crop") }
+                }
+                ImgTool.Rotate -> {
+                    Text("Angle: " + ed.ang.toInt() + " deg")
+                    Slider(value = ed.ang, onValueChange = { ed.ang = it }, valueRange = -180f..180f)
+                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalAlignment = Alignment.CenterVertically) {
+                        OutlinedButton(contentPadding = pad, onClick = { ed.ang = (ed.ang - 90f).let { if (it < -180f) it + 360f else it } }) { Text("-90") }
+                        OutlinedButton(contentPadding = pad, onClick = { ed.ang = (ed.ang + 90f).let { if (it > 180f) it - 360f else it } }) { Text("+90") }
+                        OutlinedButton(contentPadding = pad, onClick = { ed.ang = 0f }) { Text("Reset") }
+                        Button(contentPadding = pad, onClick = { ed.applyRotate() }) { Text("Apply") }
+                    }
+                }
+                ImgTool.Draw -> {
+                    Row(
+                        Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.spacedBy(6.dp),
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        EdChip("Brush", !ed.eraser) { ed.eraser = false }
+                        EdChip("Eraser", ed.eraser) { ed.eraser = true }
+                        OutlinedButton(contentPadding = pad, onClick = { ed.clearDrawing() }) { Text("Clear drawings") }
+                    }
+                    Text("Thickness")
+                    Slider(value = ed.brushSize, onValueChange = { ed.brushSize = it }, valueRange = 1f..40f)
+                    if (!ed.eraser) RasiColorPicker(ed.brushColor) { ed.brushColor = it }
+                }
+                ImgTool.Text -> {
+                    Box(Modifier.fillMaxWidth().height(44.dp)) {
+                        ActionTextEditor(textField, multiline = false, autocorrect = true, placeholder = "Type text")
+                    }
+                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalAlignment = Alignment.CenterVertically) {
+                        Button(contentPadding = pad, onClick = { ed.addText(textField.value) }) { Text("Add text") }
+                        OutlinedButton(contentPadding = pad, enabled = ed.sel >= 0, onClick = { ed.deleteSel() }) { Text("Delete") }
+                        OutlinedButton(contentPadding = pad, onClick = { ed.clearTexts() }) { Text("Clear text") }
+                    }
+                    Text("Tap a text to select it, drag to move it")
+                    Row(
+                        Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                        horizontalArrangement = Arrangement.spacedBy(6.dp),
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        FONT_NAMES.forEachIndexed { i, n -> EdChip(n, ed.tmpl.font == i) { ed.styleSel { it.copy(font = i) } } }
+                    }
+                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalAlignment = Alignment.CenterVertically) {
+                        EdChip(if (ed.tmpl.bg) "Background: on" else "Background: off", ed.tmpl.bg) { val v = !ed.tmpl.bg; ed.styleSel { it.copy(bg = v) } }
+                        EdChip(if (ed.tmpl.outline) "Outline: on" else "Outline: off", ed.tmpl.outline) { val v = !ed.tmpl.outline; ed.styleSel { it.copy(outline = v) } }
+                    }
+                    Text("Size")
+                    Slider(
+                        value = (ed.tmpl.sizePx / ed.minDim * 100f).coerceIn(2f, 30f),
+                        onValueChange = { v -> ed.styleSel { it.copy(sizePx = v / 100f * ed.minDim) } },
+                        valueRange = 2f..30f
+                    )
+                    var target by remember { mutableIntStateOf(0) }
+                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalAlignment = Alignment.CenterVertically) {
+                        Text("Color of:")
+                        EdChip("Text", target == 0) { target = 0 }
+                        EdChip("Background", target == 1) { target = 1 }
+                        EdChip("Outline", target == 2) { target = 2 }
+                    }
+                    val cur = when (target) { 0 -> ed.tmpl.color; 1 -> ed.tmpl.bgColor; else -> ed.tmpl.outlineColor }
+                    RasiColorPicker(cur) { c ->
+                        when (target) {
+                            0 -> ed.styleSel { it.copy(color = c) }
+                            1 -> ed.styleSel { it.copy(bgColor = c) }
+                            else -> ed.styleSel { it.copy(outlineColor = c) }
+                        }
+                    }
+                }
+            }
+        }
+
+    }
+
+    @Composable
+    fun tabsBlock(tabsMod: Modifier) {
+        Row(
+            tabsMod.horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            EdChip("Crop", tool == ImgTool.Crop) { pick(ImgTool.Crop) }
+            EdChip("Rotate", tool == ImgTool.Rotate) { pick(ImgTool.Rotate) }
+            EdChip("Draw", tool == ImgTool.Draw) { pick(ImgTool.Draw) }
+            EdChip("Text", tool == ImgTool.Text) { pick(ImgTool.Text) }
+        }
+    }
+
+    Column(Modifier.fillMaxSize().padding(4.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+        Row(
+            Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            OutlinedButton(contentPadding = pad, onClick = onCancel) { Text("Cancel") }
