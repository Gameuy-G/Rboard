@@ -0,0 +1,54 @@
+package org.futo.inputmethod.latin.rasi;
+
+/** RASI language: every letter swaps with the symbol/number on its Gboard key (both ways). */
+public final class RasiMap {
+    private RasiMap() {}
+
+    /** When true, typed keys are swapped to their RASI partner. */
+    public static volatile boolean enabled = false;
+
+    private static final String[] PAIRS = {
+        "q1", "w2", "e3", "r4", "t5", "y6", "u7", "i8", "o9", "p0",
+        "a@", "s#", "d$", "g&", "j+", "k(", "l)",
+        "z*", "x\"", "c'", "v:", "b;", "n!", "m?",
+        "h-", "f_"
+    };
+
+    private static final int[] MAP = new int[128];
+    static {
+        for (int i = 0; i < MAP.length; i++) MAP[i] = i;
+        for (String p : PAIRS) {
+            char a = p.charAt(0), b = p.charAt(1);
+            MAP[a] = b;
+            MAP[b] = a;
+            MAP[Character.toUpperCase(a)] = b;
+        }
+    }
+
+    /** Swaps one typed code point. Spaces, commas, periods and everything else are unchanged. */
+    public static int swap(final int codePoint) {
+        if (!enabled || codePoint <= 0 || codePoint >= MAP.length) return codePoint;
+        return MAP[codePoint];
+    }
+
+    /** The small hint shown on a letter key (its RASI partner), or null if not a RASI letter. */
+    public static String hintFor(final String label) {
+        if (label == null || label.length() != 1) return null;
+        final char c = Character.toLowerCase(label.charAt(0));
+        if (c < 'a' || c > 'z') return null;
+        final int m = MAP[c];
+        return m == c ? null : String.valueOf((char) m);
+    }
+
+    /** Translates a whole string (used by the translate panel). Fake symbols are deleted. */
+    public static String translate(final String in) {
+        final StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < in.length(); i++) {
+            final char c = in.charAt(i);
+            if (c == ' ' || c == ',' || c == '.' || c == '\n') { sb.append(c); continue; }
+            final char l = Character.toLowerCase(c);
+            if (l < 128 && MAP[l] != l) sb.append((char) MAP[l]);
+        }
+        return sb.toString();
+    }
+}
