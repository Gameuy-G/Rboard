--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiTextCodecs.kt
@@ -0,0 +1,33 @@
+package org.futo.inputmethod.latin.rasi
+
+/** Binary (UTF-8 bytes as 8-bit groups) and uwu text styles for the translator. */
+object RasiBinary {
+    fun encode(text: String): String =
+        text.toByteArray(Charsets.UTF_8).joinToString(" ") {
+            Integer.toBinaryString(it.toInt() and 0xFF).padStart(8, '0')
+        }
+
+    fun decode(text: String): String {
+        val bits = text.filter { it == '0' || it == '1' }
+        if (bits.length < 8) return ""
+        val n = bits.length / 8
+        val bytes = ByteArray(n) { i -> bits.substring(i * 8, i * 8 + 8).toInt(2).toByte() }
+        return String(bytes, Charsets.UTF_8)
+    }
+}
+
+object RasiUwu {
+    private val nVowel = Regex("([nN])([aeiouAEIOU])")
+
+    fun encode(text: String): String {
+        var t = text
+        t = nVowel.replace(t) { m ->
+            val n = m.groupValues[1]
+            val v = m.groupValues[2]
+            n + (if (v[0].isUpperCase() && n == "N") "Y" else "y") + v
+        }
+        t = t.replace("ove", "uv").replace("OVE", "UV")
+        t = t.replace('r', 'w').replace('l', 'w').replace('R', 'W').replace('L', 'W')
+        return t
+    }
+}
