+package org.futo.inputmethod.latin.rasi
+
+import android.app.SearchManager
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Handler
+import android.os.Bundle
+import android.os.Looper
+import android.os.SystemClock
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.provider.MediaStore
+import androidx.compose.runtime.mutableStateOf
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.ListenerRegistration
+import com.google.firebase.firestore.SetOptions
+
+/**
+ * Listen together rooms (Firebase, uses the internet). No audio is shared, only song status.
+ *   rooms/{code}                {owner, name, createdAt, access = "code" | "friends"}
+ *   rooms/{code}/members/{uid}  {username, name, avatar, avatarColor, joinedAt, sharing, title, artist, app, pkg,
+ *                                playing, posMs, posAt, updatedAt}
+ * Prefs (in "rasi_account"): rm_code, rm_share, rm_pause, rm_pos, rm_same_app, rm_open_pkg (what is shared reuses live_title/artist/app/paused/delay).
+ */
+object RasiRooms {
+    class Room(val code: String, val name: String, val owner: String, val access: String)
+    class Member(
+        val uid: String, val username: String, val name: String, val avatar: String, val avatarColor: Int,
+        val sharing: Boolean, val title: String, val artist: String, val app: String, val pkg: String,
+        val playing: Boolean, val posMs: Long, val posAt: Long, val updatedAt: Long
+    )
+
+    val room = mutableStateOf<Room?>(null)
+    val members = mutableStateOf<List<Member>>(emptyList())
+    val busy = mutableStateOf(false)
+    val message = mutableStateOf("")
+    /** The member whose song I follow (play, pause and position), or null. Not saved: a new app start stops it. */
+    val syncUid = mutableStateOf<String?>(null)
+    val syncStatus = mutableStateOf("")
+
+    private val h = Handler(Looper.getMainLooper())
+    private var reg: ListenerRegistration? = null
+    private var roomReg: ListenerRegistration? = null
+    private var lastKey: String? = null
+    private var pendingKey: String? = null
+    private var pendingRun: Runnable? = null
+    @Volatile private var cur: RasiNowPlaying.Track? = null
+    @Volatile private var ctx: Context? = null
+    private var lastOpenAt = 0L
+    private var lastCtlAt = 0L
+    private var lastSeekAt = 0L
+    private var sentPos = -1L
+    private var sentAt = 0L
+    private var sentPlaying = false
+    private var lastForceAt = 0L
+
+    private val engine = object : Runnable {
+        override fun run() {
+            try { engineStep() } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Room sync step skipped: " + t.javaClass.simpleName) }
+            if (room.value != null) h.postDelayed(this, 2000L)
+        }
+    }
+    private fun startEngine() { h.removeCallbacks(engine); h.postDelayed(engine, 2000L) }
+    private fun stopEngine() { h.removeCallbacks(engine); syncUid.value = null; syncStatus.value = "" }
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun me(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+    private fun prefs(c: Context) = RasiAccount.prefs(c)
+
+    private fun fail(t: Throwable?, what: String): String {
+        RasiLog.fallback("RasiRooms", what + ": " + (t?.javaClass?.simpleName ?: "unknown"))
+        val text = generateSequence(t) { it.cause }.take(5).joinToString(" ") { it.message ?: "" }
+        return if (text.contains("PERMISSION_DENIED")) "The server refused this. The new Firestore rules may not be published yet, or the room is friends-only"
+        else "Could not reach the server. Check your internet and try again"
+    }
+
+    private fun randomCode(): String {
+        val abc = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+        val r = java.security.SecureRandom()
+        return (1..6).map { abc[r.nextInt(abc.length)] }.joinToString("")
+    }
+
+    /** Opens the saved room again after the app restarted. */
+    fun restore(c: Context) {
+        ctx = c.applicationContext
+        if (room.value != null || me() == null) return
+        val code = prefs(c).getString("rm_code", "") ?: ""
+        if (code.isNotBlank()) enter(c, code, false)
+    }
+
+    fun create(c: Context, name: String, access: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        ctx = c.applicationContext
+        busy.value = true; message.value = ""
+        val code = randomCode()
+        val map = hashMapOf<String, Any>("owner" to id, "name" to name.trim().take(30).ifBlank { "My room" },
+            "createdAt" to System.currentTimeMillis(), "access" to (if (access == "friends") "friends" else "code"))
+        d.collection("rooms").document(code).set(map).addOnCompleteListener { t ->
+            if (t.isSuccessful) enter(c, code, true) else { busy.value = false; message.value = fail(t.exception, "Create room") }
+        }
+    }
+
+    fun join(c: Context, code: String) {
+        ctx = c.applicationContext
+        val q = code.trim().uppercase()
+        if (q.length != 6) { message.value = "A room code has 6 letters or digits"; return }
+        busy.value = true; message.value = ""
+        enter(c, q, true)
+    }
+
+    private fun enter(c: Context, code: String, writeMember: Boolean) {
+        val d = db(); val id = me()
+        if (d == null || id == null) { busy.value = false; return }
+        d.collection("rooms").document(code).get().addOnSuccessListener { s ->
+            if (!s.exists()) {
+                busy.value = false
+                message.value = "No room with that code"
+                prefs(c).edit().remove("rm_code").apply()
+                RasiRoomService.ensure(c)
+                return@addOnSuccessListener
+            }
+            val r = Room(code, s.getString("name") ?: "", s.getString("owner") ?: "", s.getString("access") ?: "code")
+            val start = {
+                prefs(c).edit().putString("rm_code", code).putString("rm_name", r.name).apply()
+                room.value = r; busy.value = false
+                listen(c, code, id)
+                lastKey = null
+                startEngine()
+                h.post { push() }
+                RasiRoomService.ensure(c)
+            }
+            if (!writeMember) {
+                d.collection("rooms").document(code).collection("members").document(id).get().addOnSuccessListener { m ->
+                    if (m.exists()) start() else { busy.value = false; prefs(c).edit().remove("rm_code").apply(); RasiRoomService.ensure(c) }
+                }.addOnFailureListener { busy.value = false }
+                return@addOnSuccessListener
+            }
+            val p = RasiAccount.profile.value
+            val map = hashMapOf<String, Any>(
+                "username" to (p?.username ?: ""), "name" to (p?.name ?: "").take(30), "avatar" to (p?.avatar ?: "").take(8),
+                "avatarColor" to ((p?.avatarColor ?: 0).toLong() and 0xFFFFFFFFL), "joinedAt" to System.currentTimeMillis(),
+                "sharing" to false, "playing" to false, "updatedAt" to System.currentTimeMillis()
+            )
+            d.collection("rooms").document(code).collection("members").document(id).set(map).addOnCompleteListener { t ->
+                if (t.isSuccessful) start() else { busy.value = false; message.value = fail(t.exception, "Join room") }
+            }
+        }.addOnFailureListener { busy.value = false; message.value = fail(it, "Find room") }
+    }
+
+    private fun listen(c: Context, code: String, myId: String) {
+        stopListening()
+        val d = db() ?: return
+        var seenMe = false
+        reg = d.collection("rooms").document(code).collection("members").addSnapshotListener { q, e ->
+            if (e != null) { exit(c, "You are no longer in this room", false); return@addSnapshotListener }
+            if (q == null) return@addSnapshotListener
+            val list = q.documents.map { s ->
+                Member(s.id, s.getString("username") ?: "", s.getString("name") ?: "", s.getString("avatar") ?: "",
+                    s.getLong("avatarColor")?.toInt() ?: 0, s.getBoolean("sharing") ?: false,
+                    s.getString("title") ?: "", s.getString("artist") ?: "", s.getString("app") ?: "", s.getString("pkg") ?: "",
+                    s.getBoolean("playing") ?: false, s.getLong("posMs") ?: -1L, s.getLong("posAt") ?: 0L, s.getLong("updatedAt") ?: 0L)
+            }
+            members.value = list
+            if (list.any { it.uid == myId }) seenMe = true
+            else if (seenMe && !q.metadata.isFromCache) { exit(c, "You were removed from the room", false) }
+        }
+        roomReg = d.collection("rooms").document(code).addSnapshotListener { s, e ->
+            if (e != null || s == null) return@addSnapshotListener
+            if (!s.exists() && !s.metadata.isFromCache) exit(c, "The room was closed", false)
+            else if (s.exists()) room.value = Room(code, s.getString("name") ?: "", s.getString("owner") ?: "", s.getString("access") ?: "code")
+        }
+    }
+
+    /** Called when the account signs out: forget the room on this phone (the server copy stays until you leave). */
+    fun localReset() {
+        stopListening(); cancelPending(); lastKey = null; stopEngine()
+        room.value = null; members.value = emptyList(); message.value = ""
+        ctx?.let { c -> try { c.stopService(Intent(c, RasiRoomService::class.java)) } catch (t: Throwable) { } }
+    }
+
+    private fun stopListening() {
+        reg?.remove(); reg = null
+        roomReg?.remove(); roomReg = null
+    }
+
+    private fun exit(c: Context, msg: String, deleteMine: Boolean) {
+        stopListening()
+        cancelPending(); lastKey = null; stopEngine()
+        val r = room.value; val id = me(); val d = db()
+        if (deleteMine && r != null && id != null && d != null) d.collection("rooms").document(r.code).collection("members").document(id).delete()
+        room.value = null; members.value = emptyList(); message.value = msg
+        prefs(c).edit().remove("rm_code").apply()
+        RasiRoomService.ensure(c)
+    }
+
+    /** Leaves the room. The owner leaving closes it for everyone. */
+    fun leave(c: Context) {
+        val r = room.value ?: return
+        val d = db(); val id = me()
+        if (d == null || id == null) return
+        if (r.owner == id) {
+            val ids = members.value.map { it.uid }
+            exit(c, "Room closed", false)
+            // also remove the newest chat messages (up to 250) so nothing is left behind
+            val ref = d.collection("rooms").document(r.code)
+            ref.collection("messages").limit(250).get().addOnCompleteListener { t ->
+                val b = d.batch()
+                val docs = if (t.isSuccessful) t.result?.documents else null
+                docs?.forEach { b.delete(it.reference) }
+                ids.forEach { b.delete(ref.collection("members").document(it)) }
+                b.delete(ref)
+                b.commit().addOnFailureListener { message.value = fail(it, "Close room") }
+            }
+        } else exit(c, "You left the room", true)
+    }
+
+    fun kick(uid: String) {
+        val r = room.value ?: return
+        val d = db() ?: return
+        d.collection("rooms").document(r.code).collection("members").document(uid).delete()
+            .addOnFailureListener { message.value = fail(it, "Remove member") }
+    }
+
+    fun setAccess(access: String) {
+        val r = room.value ?: return
+        val d = db() ?: return
+        d.collection("rooms").document(r.code).set(hashMapOf<String, Any>("access" to access), SetOptions.merge())
+            .addOnFailureListener { message.value = fail(it, "Change room access") }
+    }
+
+    // ---- sharing my song in the room ----
+    fun onTrack(c: Context, t: RasiNowPlaying.Track?) {
+        cur = t; ctx = c.applicationContext
+        h.post { push() }
+    }
+
+    fun refresh(c: Context) { ctx = c.applicationContext; h.post { push() } }
+
+    private fun cancelPending() {
+        pendingRun?.let { h.removeCallbacks(it) }
+        pendingRun = null; pendingKey = null
+    }
+
+    private fun push() {
+        val c = ctx ?: return
+        val r = room.value ?: return
+        try {
+            val d = db() ?: return
+            val id = me() ?: return
+            val p = prefs(c)
+            val t = cur
+            val allowed = p.getBoolean("rm_share", true) && !p.getBoolean("rm_pause", false)
+            val share = allowed && t != null && (t.playing || p.getBoolean("live_paused", false))
+            val ref = d.collection("rooms").document(r.code).collection("members").document(id)
+            if (!share || t == null) {
+                cancelPending()
+                if (lastKey != "off") {
+                    lastKey = "off"
+                    ref.set(hashMapOf<String, Any>("sharing" to false, "title" to "", "artist" to "", "app" to "", "pkg" to "",
+                        "playing" to false, "updatedAt" to System.currentTimeMillis()), SetOptions.merge())
+                        .addOnFailureListener { RasiLog.fallback("RasiRooms", "Could not update the room: " + it.javaClass.simpleName) }
+                }
+                return
+            }
+            val title = if (p.getBoolean("live_title", true)) t.title else ""
+            val artist = if (p.getBoolean("live_artist", true)) t.artist else ""
+            val app = if (p.getBoolean("live_app", true)) RasiNowPlaying.appLabel(c, t.pkg) else ""
+            val pkg = if (p.getBoolean("live_app", true)) t.pkg else ""
+            val playing = t.playing
+            val usePos = p.getBoolean("rm_pos", true)
+            val key = "$title|$artist|$app|$playing|$usePos"
+            if (key == lastKey || key == pendingKey) return
+            cancelPending()
+            pendingKey = key
+            val run = Runnable {
+                pendingRun = null; pendingKey = null
+                val now = System.currentTimeMillis()
+                val pos = if (usePos) myPos(playing) else -1L
+                val map = hashMapOf<String, Any>(
+                    "sharing" to true, "title" to title.take(120), "artist" to artist.take(120), "app" to app.take(40),
+                    "pkg" to pkg.take(120), "playing" to playing, "posMs" to pos,
+                    "posAt" to (if (pos >= 0) now else 0L), "updatedAt" to now
+                )
+                sentPos = pos; sentAt = now; sentPlaying = playing
+                ref.set(map, SetOptions.merge()).addOnSuccessListener { lastKey = key }
+                    .addOnFailureListener { RasiLog.fallback("RasiRooms", "Could not share the song in the room: " + it.javaClass.simpleName) }
+            }
+            pendingRun = run
+            h.postDelayed(run, p.getInt("rm_delay", 1) * 1000L)
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiRooms", "Room share skipped: " + t.javaClass.simpleName)
+        }
+    }
+
+    // ---- my position, epoch based (Long) ----
+    /** Where my player is right now in ms, or -1. The listener keeps the position and the elapsed-realtime moment it was read. */
+    fun myPos(playing: Boolean): Long {
+        val raw = RasiNowPlaying.posMs
+        if (raw < 0L) return -1L
+        if (!playing) return raw
+        val el = (SystemClock.elapsedRealtime() - RasiNowPlaying.posAt).coerceAtLeast(0L)
+        return raw + (el * RasiNowPlaying.posSpeed).toLong()
+    }
+
+    private fun norm(s: String) = s.lowercase().filter { it.isLetterOrDigit() }
+    private fun sameSong(a: String, b: String): Boolean {
+        val x = norm(a); val y = norm(b)
+        if (x.isBlank() || y.isBlank()) return false
+        return x == y || x.contains(y) || y.contains(x)
+    }
+
+    // ---- sync ----
+    fun startSync(c: Context, uid: String) {
+        ctx = c.applicationContext
+        lastOpenAt = 0L; lastSeekAt = 0L; lastCtlAt = 0L
+        syncUid.value = uid
+        syncStatus.value = "Syncing..."
+        h.post { try { engineStep() } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Sync start failed: " + t.javaClass.simpleName) } }
+    }
+
+    fun stopSync() { syncUid.value = null; syncStatus.value = "" }
+
+    private fun engineStep() {
+        val c = ctx ?: return
+        val p = prefs(c)
+        checkSeek(c, p)
+        val uid = syncUid.value ?: return
+        val t = members.value.firstOrNull { it.uid == uid }
+        if (t == null) { syncStatus.value = "They left the room"; syncUid.value = null; return }
+        val who = t.name.ifBlank { t.username }
+        if (!t.sharing || t.title.isBlank()) { syncStatus.value = "Waiting for $who to play a song"; return }
+        val now = System.currentTimeMillis()
+        val mine = RasiNowPlaying.track
+        if (mine == null || !sameSong(mine.title, t.title)) {
+            if (t.playing && p.getBoolean("rm_auto_open", true) && now - lastOpenAt > 20000L) {
+                lastOpenAt = now
+                syncStatus.value = openSong(c, t)
+            } else syncStatus.value = "Waiting for your player to show " + t.title
+            return
+        }
+        val ctl = RasiNowPlaying.activeCtl
+        if (ctl == null) { syncStatus.value = "No player session found. Check the music access in Music > Status"; return }
+        val tc = ctl.transportControls
+        if (p.getBoolean("rm_sync_pause", true) && now - lastCtlAt > 1500L) {
+            if (t.playing && !mine.playing) { tc.play(); lastCtlAt = now }
+            else if (!t.playing && mine.playing) { tc.pause(); lastCtlAt = now }
+        }
+        val target = if (t.posMs >= 0L && t.posAt > 0L)
+            t.posMs + (if (t.playing) (now - t.posAt).coerceAtLeast(0L) else 0L) + p.getInt("rm_offset", 0)
+        else -1L
+        var drift = 0L
+        if (target >= 0L) {
+            val my = myPos(mine.playing)
+            if (my >= 0L) {
+                drift = my - target
+                if (p.getBoolean("rm_sync_seek", true) && now - lastSeekAt > 8000L && Math.abs(drift) > p.getInt("rm_drift", 3) * 1000L) {
+                    tc.seekTo(target.coerceAtLeast(0L)); lastSeekAt = now
+                }
+            }
+        }
+        syncStatus.value = "Synced with $who" + (if (target >= 0L) " (off by " + (Math.abs(drift) / 100L / 10.0) + " s)" else " (no position shared)")
+    }
+
+    /** When I seek in my own player, tell the room soon instead of waiting for the next song or pause change. */
+    private fun checkSeek(c: Context, p: android.content.SharedPreferences) {
+        val t = cur ?: return
+        if (sentPos < 0L || !p.getBoolean("rm_pos", true) || !p.getBoolean("rm_share", true)) return
+        val now = System.currentTimeMillis()
+        if (now - lastForceAt < 3000L) return
+        val actual = myPos(t.playing)
+        if (actual < 0L) return
+        val expected = sentPos + (if (sentPlaying) now - sentAt else 0L)
+        if (Math.abs(actual - expected) > 2500L) { lastForceAt = now; lastKey = null; push() }
+    }
+
+    // ---- play what they play (opens the song in MY app, no audio is shared) ----
+    /** Tries your picked Music app first (Music apps picker / Room options), then their app, then the app your player last used. */
+    fun openSong(c: Context, m: Member, searchPageOnly: Boolean = false): String {
+        val q = (m.title + " " + m.artist).trim()
+        if (q.isBlank()) return "They are not sharing a song title"
+        val p = prefs(c)
+        val picked = p.getString("rm_open_pkg", "") ?: ""
+        val mineAuto = RasiNowPlaying.activeCtl?.packageName ?: ""
+        val theirsFirst = p.getBoolean("rm_prefer_theirs", false)
+        val order = (if (theirsFirst) listOf(m.pkg, picked, mineAuto) else listOf(picked, m.pkg, mineAuto)).filter { it.isNotBlank() }.distinct()
+        for (pkg in order) {
+            val label = RasiNowPlaying.appLabel(c, pkg)
+            // 1) ask the app's own media session to search and play (works without opening a screen)
+            if (!searchPageOnly) try {
+                val ctl = RasiNowPlaying.controllers.firstOrNull { it.packageName == pkg }
+                if (ctl != null) {
+                    val ex = Bundle().putAllSafe(m)
+                    ctl.transportControls.playFromSearch(q, ex)
+                    return "Searching and playing in $label"
+                }
+            } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Session search failed in " + pkg + ": " + t.javaClass.simpleName) }
+            // 2) the standard play-from-search screen of the app
+            if (!searchPageOnly) try {
+                val i = Intent(MediaStore.INTENT_ACTION_MEDIA_PLAY_FROM_SEARCH).setPackage(pkg)
+                    .putExtra(MediaStore.EXTRA_MEDIA_FOCUS, "vnd.android.cursor.item/*")
+                    .putExtra(MediaStore.EXTRA_MEDIA_TITLE, m.title).putExtra(MediaStore.EXTRA_MEDIA_ARTIST, m.artist)
+                    .putExtra(SearchManager.QUERY, q).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                c.startActivity(i)
+                return "Playing in $label"
+            } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Play from search failed in " + pkg + ": " + t.javaClass.simpleName) }
+            // 3) the app's search page
+            val link = when (pkg) {
+                "com.spotify.music" -> "spotify:search:" + Uri.encode(q)
+                "com.google.android.apps.youtube.music" -> "https://music.youtube.com/search?q=" + Uri.encode(q)
+                "com.google.android.youtube" -> "https://www.youtube.com/results?search_query=" + Uri.encode(q)
+                else -> ""
+            }
+            if (link.isNotBlank()) try {
+                c.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(link)).setPackage(pkg).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+                return "Opened the search in $label"
+            } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Search link failed in " + pkg + ": " + t.javaClass.simpleName) }
+            // 4) just open the app and copy the name so you can paste it in its search
+            try {
+                val li = c.packageManager.getLaunchIntentForPackage(pkg)
+                if (li != null) {
+                    try { (c.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager).setPrimaryClip(ClipData.newPlainText("Song", q)) } catch (t: Throwable) {}
+                    c.startActivity(li.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+                    return "Opened $label. The song name is copied, paste it in its search"
+                }
+            } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Could not open " + pkg + ": " + t.javaClass.simpleName) }
+        }
+        return try {
+            c.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse("https://www.youtube.com/results?search_query=" + Uri.encode(q))).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+            "Opened a web search (no music app worked, pick one in Room options)"
+        } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Web search failed: " + t.javaClass.simpleName); "Could not open the song" }
+    }
+
+    // ---- tap a friend's Listening to line: plays it in MY app, not synced ----
+    private var tapJob: Runnable? = null
+
+    /** Plays a friend's song (from their card) in your own app. It starts at their position once, then you are on your own. */
+    fun playFromCard(c: Context, name: String, title: String, artist: String, pkg: String, posMs: Long, at: Long, playing: Boolean): String {
+        val p = prefs(c)
+        val searchOnly = p.getBoolean("pf_search_only", false)
+        val m = Member("", name, name, "", 0, true, title, artist, "", pkg, playing, posMs, at, at)
+        val msg = openSong(c, m, searchOnly)
+        tapJob?.let { h.removeCallbacks(it) }
+        tapJob = null
+        if (p.getBoolean("pf_from_pos", true) && !searchOnly && posMs >= 0L && at > 0L) {
+            val until = SystemClock.elapsedRealtime() + p.getInt("pf_wait", 15) * 1000L
+            val r = object : Runnable {
+                override fun run() {
+                    try {
+                        val mine = RasiNowPlaying.track
+                        val ctl = RasiNowPlaying.activeCtl
+                        if (mine != null && ctl != null && mine.playing && sameSong(mine.title, title)) {
+                            val now = System.currentTimeMillis()
+                            val target = posMs + (if (playing) (now - at).coerceAtLeast(0L) else 0L) + p.getInt("pf_adjust", 0) * 1000L
+                            ctl.transportControls.seekTo(target.coerceAtLeast(0L))
+                            tapJob = null
+                            return
+                        }
+                    } catch (t: Throwable) { RasiLog.fallback("RasiRooms", "Start position failed: " + t.javaClass.simpleName) }
+                    if (SystemClock.elapsedRealtime() < until) h.postDelayed(this, 1000L) else tapJob = null
+                }
+            }
+            tapJob = r
+            h.postDelayed(r, 1500L)
+        }
+        return msg
+    }
+
+    private fun Bundle.putAllSafe(m: Member): Bundle {
+        putString(MediaStore.EXTRA_MEDIA_FOCUS, "vnd.android.cursor.item/*")
+        putString(MediaStore.EXTRA_MEDIA_TITLE, m.title)
+        putString(MediaStore.EXTRA_MEDIA_ARTIST, m.artist)
+        return this
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiSecret.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiSecret.kt
new file mode 100644
