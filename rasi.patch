+
+/** Accent colors and icons per settings category, picked from the header words. */
+internal fun rasiSectionLook(text: String): Pair<Color, ImageVector> {
+    val t = text.lowercase()
+    fun has(vararg w: String) = w.any { t.contains(it) }
+    return when {
+        has("music", "song", "beat", "viz", "play", "sound", "audio", "cover") -> Color(0xFFFF7A59) to Icons.Default.PlayArrow
+        has("message", "chat", "friend", "room", "notif", "ping", "recent", "shortcut") -> Color(0xFFFFA726) to Icons.Default.Email
+        has("account", "profile", "name", "sign", "badge") -> Color(0xFF4CD08A) to Icons.Default.Person
+        has("layer", "effect", "animation", "visual", "ambience", "glow", "shake") -> Color(0xFFEC6BA8) to Icons.Default.Star
+        has("look", "color", "theme", "style", "font", "shape", "size", "opacity") -> Color(0xFFA66BFF) to Icons.Default.Create
+        has("privacy", "root", "shizuku", "security", "permission", "access", "backup", "export", "import") -> Color(0xFF26C6DA) to Icons.Default.Lock
+        has("developer", "debug", "log", "advanced", "performance", "stats") -> Color(0xFF9E9E9E) to Icons.Default.Info
+        has("key", "layout", "typing", "suggest", "language", "symbol", "strip", "dictionary") -> Color(0xFF5B8DEF) to Icons.Default.Build
+        else -> Color(0xFF5B8DEF) to Icons.Default.Settings
+    }
+}
+
+/** A section header. Plain text normally; with "Colored section cards" on, a card with an icon and accent. */
+@Composable
+fun RasiSection(text: String, modifier: Modifier = Modifier) {
+    val ctx = LocalContext.current
+    remember { RasiUiStyle.init(ctx); 0 }
+    if (!RasiUiStyle.cards.value) {
+        Text(text, style = MaterialTheme.typography.titleSmall, modifier = modifier)
+        return
+    }
+    val look = rasiSectionLook(text)
+    val accent = look.first
+    Row(
+        modifier.fillMaxWidth().padding(vertical = 6.dp).clip(RoundedCornerShape(14.dp))
+            .background(accent.copy(alpha = 0.18f)).padding(end = 12.dp),
+        verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        Box(Modifier.width(4.dp).height(40.dp).background(accent))
+        Box(Modifier.size(28.dp).clip(CircleShape).background(accent.copy(alpha = 0.35f)), contentAlignment = Alignment.Center) {
+            Icon(look.second, contentDescription = null, tint = accent, modifier = Modifier.size(18.dp))
+        }
+        Text(text, style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.Bold)
+    }
+}
+
+/** A text button. With "Pressable styling" on it becomes a pill. */
+@Composable
+fun RasiTextButton(onClick: () -> Unit, modifier: Modifier = Modifier, enabled: Boolean = true, content: @Composable RowScope.() -> Unit) {
+    val ctx = LocalContext.current
+    remember { RasiUiStyle.init(ctx); 0 }
+    if (RasiUiStyle.press.value) {
+        FilledTonalButton(onClick = onClick, modifier = modifier, enabled = enabled, shape = RoundedCornerShape(50), content = content)
+    } else {
+        TextButton(onClick = onClick, modifier = modifier, enabled = enabled, content = content)
+    }
+}
+
+/** One-of-several choice. Each option is "Label|short description". */
+@Composable
+fun RasiPrefChoice(prefs: SharedPreferences, key: String, title: String, options: List<String>, def: Int) {
+    var sel by remember { mutableStateOf(prefs.getInt(key, def).coerceIn(0, options.size - 1)) }
+    Column {
+        Text(title)
+        options.forEachIndexed { i, o ->
+            val parts = o.split("|")
+            Row(Modifier.fillMaxWidth().clickable { sel = i; prefs.edit().putInt(key, i).apply() }.padding(vertical = 2.dp),
+                verticalAlignment = Alignment.CenterVertically) {
+                RadioButton(selected = sel == i, onClick = { sel = i; prefs.edit().putInt(key, i).apply() })
+                Column(Modifier.weight(1f)) {
+                    Text(parts[0])
+                    if (parts.size > 1) Text(parts[1], style = MaterialTheme.typography.bodySmall)
+                }
+            }
+        }
+    }
+}
+
+internal val RASI_SWATCHES = listOf(0xFF5B8DEF, 0xFFA66BFF, 0xFFEC6BA8, 0xFFFF7A59, 0xFFFFA726, 0xFF4CD08A, 0xFF26C6DA, 0xFFFFFFFF)
+
+/** A row of color circles to pick from. Stores the index. */
+@Composable
+fun RasiPrefSwatches(prefs: SharedPreferences, key: String, title: String, desc: String, def: Int) {
+    var sel by remember { mutableStateOf(prefs.getInt(key, def).coerceIn(0, RASI_SWATCHES.size - 1)) }
+    Column {
+        Text(title)
+        Text(desc, style = MaterialTheme.typography.bodySmall)
+        Row(Modifier.padding(top = 6.dp), horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+            RASI_SWATCHES.forEachIndexed { i, c ->
+                Box(
+                    Modifier.size(if (sel == i) 34.dp else 28.dp).clip(CircleShape).background(Color(c))
+                        .clickable { sel = i; prefs.edit().putInt(key, i).apply() }
+                )
+            }
+        }
+    }
+}
