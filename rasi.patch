+
+// kind: "ml" (ML Kit language), "auto", "rasi", "wing", "binary", "uwu"
+private class RasiLang(val name: String, val code: String?, val kind: String = "ml")
+
+// Secret languages come last. Auto detect is only valid as the From language.
+private val RASI_LANGS: List<RasiLang> = run {
+    val others = TranslateLanguage.getAllLanguages()
+        .filter { it != TranslateLanguage.ENGLISH }
+        .map { code ->
+            val name = Locale.forLanguageTag(code).getDisplayLanguage(Locale.ENGLISH)
+            RasiLang(if (name.isBlank()) code else name, code)
+        }
+        .sortedBy { it.name }
+    listOf(RasiLang("Auto detect", null, "auto"), RasiLang("English", TranslateLanguage.ENGLISH)) + others +
+        RasiLang("Rasi", null, "rasi") + RasiLang("Wingdings", null, "wing") +
+        RasiLang("uwu", null, "uwu") + RasiLang("Binary", null, "binary")
+}
+
+private fun langId(l: RasiLang): String = if (l.kind == "ml") l.code!! else l.kind
+
+// Secret languages (Rasi, Wingdings) only show when the Developer switch is on.
+private fun visibleLangs(): List<RasiLang> =
+    if (org.futo.inputmethod.latin.rasi.RasiMap.secret) RASI_LANGS else RASI_LANGS.filter { it.kind == "ml" || it.kind == "auto" }
+
+private fun mlKitTranslate(
+    text: String, from: String, to: String,
+    onDone: (String) -> Unit, onError: (String) -> Unit
+) {
+    val options = TranslatorOptions.Builder()
+        .setSourceLanguage(from)
+        .setTargetLanguage(to)
+        .build()
+    val translator = Translation.getClient(options)
+    translator.downloadModelIfNeeded(DownloadConditions.Builder().build())
+        .addOnSuccessListener {
+            translator.translate(text)
+                .addOnSuccessListener { onDone(it) }
+                .addOnFailureListener { e -> onError("Translation failed: " + e.message) }
+        }
+        .addOnFailureListener { e -> onError("Language download failed: " + e.message) }
+}
+
+private fun decodeLocal(l: RasiLang, text: String): String? = when (l.kind) {
+    "wing" -> org.futo.inputmethod.latin.rasi.RasiWingdings.decode(text)
+    "rasi" -> RasiMap.translate(text)
+    "binary" -> org.futo.inputmethod.latin.rasi.RasiBinary.decode(text)
+    "uwu" -> text
+    else -> null
+}
+
+private fun encodeLocal(l: RasiLang): ((String) -> String)? = when (l.kind) {
+    "wing" -> ({ t: String -> org.futo.inputmethod.latin.rasi.RasiWingdings.encode(t) })
+    "rasi" -> ({ t: String -> RasiMap.translate(t) })
+    "binary" -> ({ t: String -> org.futo.inputmethod.latin.rasi.RasiBinary.encode(t) })
+    "uwu" -> ({ t: String -> org.futo.inputmethod.latin.rasi.RasiUwu.encode(t) })
+    else -> null
+}
+
+private fun translateAny(
+    text: String, from: RasiLang, to: RasiLang,
+    onDetected: (String) -> Unit,
+    onDone: (String) -> Unit, onError: (String) -> Unit
+) {
+    if (text.isBlank()) { onDone(""); return }
+    if (from.kind == "auto") {
+        // On-device detection (nothing leaves the phone)
+        com.google.mlkit.nl.languageid.LanguageIdentification.getClient()
+            .identifyLanguage(text)
+            .addOnSuccessListener { tag ->
+                val found = RASI_LANGS.firstOrNull { it.kind == "ml" && it.code == tag }
+                    ?: RASI_LANGS.firstOrNull { it.kind == "ml" && tag.startsWith(it.code!! + "-") }
+                if (found == null) {
+                    onDetected("")
+                    onError("Could not detect the language")
+                } else {
+                    onDetected(found.name)
+                    translateAny(text, found, to, onDetected, onDone, onError)
+                }
+            }
+            .addOnFailureListener { e -> onError("Detection failed: " + e.message) }
+        return
+    }
+    // Step 1: get plain text in the "from" language (secret languages are decoded locally)
+    val srcText = decodeLocal(from, text) ?: text
+    val srcCode = from.code ?: TranslateLanguage.ENGLISH
+    val special = encodeLocal(to)
+    if (special != null) {
+        // Step 2 (to a secret language): go through English, then convert
+        if (srcCode == TranslateLanguage.ENGLISH) onDone(special(srcText))
+        else mlKitTranslate(srcText, srcCode, TranslateLanguage.ENGLISH,
+            { onDone(special(it)) }, onError)
+    } else if (to.kind != "ml") {
+        onDone(srcText)
+    } else if (srcCode == to.code) {
+        onDone(srcText)
+    } else {
+        mlKitTranslate(srcText, srcCode, to.code!!, onDone, onError)
+    }
+}
