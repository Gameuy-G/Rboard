+/**
+ * Reorder mode: the normal clipboard grid, but long-press an item and drag it to move it.
+ * [items] is in display order. Calls [onReorder] with the new display order when a drag ends.
+ */
+@Composable
+fun RasiReorderGrid(
+    items: List<ClipboardEntry>,
+    columns: StaggeredGridCells,
+    onReorder: (List<ClipboardEntry>) -> Unit
