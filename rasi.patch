+/** Pictures sent to or made by Gemini live in the keyboard's own storage. */
+object RasiGeminiImages {
+    /** Pictures attached to the message being written. */
+    val pending = androidx.compose.runtime.mutableStateListOf<String>()
+
+    fun dir(c: Context): File = File(c.applicationContext.filesDir, "gemini_img").apply { mkdirs() }
+    fun file(c: Context, name: String): File = File(dir(c), name)
+
+    fun mimeOf(name: String): String = when (name.substringAfterLast('.').lowercase()) {
+        "png" -> "image/png"
+        "webp" -> "image/webp"
+        "gif" -> "image/gif"
+        "mp4" -> "video/mp4"
+        "mov" -> "video/mov"
+        "webm" -> "video/webm"
+        "3gp" -> "video/3gpp"
+        "mpeg", "mpg" -> "video/mpeg"
+        "avi" -> "video/avi"
+        "flv" -> "video/x-flv"
+        "wmv" -> "video/wmv"
+        else -> "image/jpeg"
+    }
+
+    private val VIDEO_EXT = setOf("mp4", "mov", "webm", "3gp", "mpeg", "mpg", "avi", "flv", "wmv")
+
+    fun isVideo(name: String): Boolean = name.substringAfterLast('.').lowercase() in VIDEO_EXT
+
+    /** Videos up to this size are sent inline, bigger ones go through the Files API. */
+    const val INLINE_VIDEO_MAX = 10L * 1024 * 1024
+    private const val MAX_VIDEO = 150L * 1024 * 1024
+
+    private fun videoExt(mime: String): String? = when (mime.lowercase()) {
+        "video/mp4" -> "mp4"
+        "video/quicktime", "video/mov" -> "mov"
+        "video/webm" -> "webm"
+        "video/3gpp" -> "3gp"
+        "video/mpeg" -> "mpeg"
+        "video/avi", "video/x-msvideo" -> "avi"
+        "video/x-m4v" -> "mp4"
+        "video/x-flv" -> "flv"
+        "video/x-ms-wmv", "video/wmv" -> "wmv"
+        else -> null
+    }
+
+    private fun nameOf(c: Context, uri: android.net.Uri): String {
+        try {
+            c.contentResolver.query(uri, arrayOf(android.provider.OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+                if (it.moveToFirst()) return it.getString(0) ?: ""
+            }
+        } catch (e: Throwable) { }
+        return uri.lastPathSegment ?: ""
+    }
+
+    /** Video format of a file: from its type when it is a known one, otherwise from its file name. */
+    private fun videoExtOf(c: Context, uri: android.net.Uri): String? {
+        val type = try { c.contentResolver.getType(uri) ?: "" } catch (e: Throwable) { "" }
+        videoExt(type)?.let { return it }
+        val ext = nameOf(c, uri).substringAfterLast('.', "").lowercase()
+        return if (ext == "m4v") "mp4" else if (ext in VIDEO_EXT) ext else null
+    }
+
+    /** Copies a video into storage as it is (no re-encoding). Returns null if the format is not supported or it is too big. */
+    fun importVideoUri(c: Context, uri: android.net.Uri): String? {
+        var out: File? = null
+        try {
+            val ext = videoExtOf(c, uri) ?: return null
+            val name = "g" + System.nanoTime() + "." + ext
+            val f = file(c, name)
+            out = f
+            var total = 0L
+            val input = c.contentResolver.openInputStream(uri) ?: return null
+            input.use { i ->
+                f.outputStream().use { o ->
+                    val buf = ByteArray(65536)
+                    while (true) {
+                        val r = i.read(buf)
+                        if (r < 0) break
+                        total += r
+                        if (total > MAX_VIDEO) {
+                            o.close()
+                            f.delete()
+                            return null
+                        }
+                        o.write(buf, 0, r)
+                    }
+                }
+            }
+            return name
+        } catch (e: Throwable) {
+            out?.delete()
+            return null
+        }
+    }
+
+    /** Picture or video, decided by what the file says it is. */
+    fun importAny(c: Context, uri: android.net.Uri): String? {
+        val type = try { c.contentResolver.getType(uri) ?: "" } catch (e: Throwable) { "" }
+        return if (type.startsWith("video/") || videoExtOf(c, uri) != null) importVideoUri(c, uri) else importUri(c, uri)
+    }
+
+    fun saveBytes(c: Context, bytes: ByteArray, mime: String): String {
+        val ext = when (mime.lowercase()) {
+            "image/png" -> "png"
+            "image/webp" -> "webp"
+            "image/gif" -> "gif"
+            else -> "jpg"
+        }
+        val name = "g" + System.nanoTime() + "." + ext
+        file(c, name).writeBytes(bytes)
+        return name
+    }
+
+    /** Copies a picked or pasted picture into storage, shrunk to at most 1280 px. */
+    fun importUri(c: Context, uri: android.net.Uri): String? {
+        return try {
+            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            c.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
+            var sample = 1
+            while (maxOf(bounds.outWidth, bounds.outHeight) / sample > 2560) sample *= 2
+            val opts = BitmapFactory.Options().apply { inSampleSize = sample }
+            val bmp = c.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, opts) }
+                ?: return null
+            val big = maxOf(bmp.width, bmp.height)
+            val scaled = if (big > 1280) {
+                val f = 1280f / big
+                Bitmap.createScaledBitmap(
+                    bmp, (bmp.width * f).toInt().coerceAtLeast(1), (bmp.height * f).toInt().coerceAtLeast(1), true
+                )
+            } else bmp
+            val bos = java.io.ByteArrayOutputStream()
+            if (scaled.hasAlpha()) {
+                scaled.compress(Bitmap.CompressFormat.PNG, 100, bos)
+                saveBytes(c, bos.toByteArray(), "image/png")
+            } else {
+                scaled.compress(Bitmap.CompressFormat.JPEG, 88, bos)
+                saveBytes(c, bos.toByteArray(), "image/jpeg")
+            }
+        } catch (e: Throwable) {
+            null
+        }
+    }
+
+    /** Reads the phone clipboard: a picture is attached, text is returned. */
+    fun pasteFromClipboard(c: Context): String? {
+        val cm = c.getSystemService(Context.CLIPBOARD_SERVICE) as android.content.ClipboardManager
+        val clip = cm.primaryClip ?: return null
+        var text: String? = null
+        for (i in 0 until clip.itemCount) {
+            val item = clip.getItemAt(i)
+            val uri = item.uri
+            if (uri != null) {
+                val type = try { c.contentResolver.getType(uri) } catch (e: Throwable) { null }
+                if (type != null && type.startsWith("image/")) {
+                    if (pending.size < 4) importUri(c, uri)?.let { pending.add(it) }
+                    continue
+                }
+            }
+            if (uri == null && text == null) {
+                val t = item.coerceToText(c)?.toString()
+                if (!t.isNullOrBlank()) text = t
+            }
+        }
+        return text
+    }
+
+    /** A content link other apps can read this picture from (for copy and paste). */
+    fun shareUri(c: Context, name: String): android.net.Uri {
+        val id = ClipboardProviderState.addRequest(
+            ClipboardPasteRequest(
+                file = file(c, name),
+                mimeType = mimeOf(name),
+                expiration = System.currentTimeMillis() + 24L * 3600L * 1000L
+            )
+        )
+        return android.net.Uri.parse("content://${CLIPBOARD_AUTHORITY}/clip/$id")
+    }
+
+    fun decode(c: Context, name: String, maxPx: Int): Bitmap? {
+        if (isVideo(name)) {
+            return try {
+                val r = android.media.MediaMetadataRetriever()
+                try {
+                    r.setDataSource(file(c, name).absolutePath)
+                    val b = r.getFrameAtTime(0, android.media.MediaMetadataRetriever.OPTION_CLOSEST_SYNC) ?: return null
+                    val big = maxOf(b.width, b.height)
+                    if (big > maxPx) {
+                        val f = maxPx.toFloat() / big
+                        Bitmap.createScaledBitmap(b, (b.width * f).toInt().coerceAtLeast(1), (b.height * f).toInt().coerceAtLeast(1), true)
+                    } else b
+                } finally {
+                    r.release()
+                }
+            } catch (e: Throwable) {
+                null
+            }
+        }
+        return try {
+            val f = file(c, name)
+            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            BitmapFactory.decodeFile(f.absolutePath, bounds)
+            var sample = 1
+            while (maxOf(bounds.outWidth, bounds.outHeight) / (sample * 2) >= maxPx) sample *= 2
+            BitmapFactory.decodeFile(f.absolutePath, BitmapFactory.Options().apply { inSampleSize = sample })
+        } catch (e: Throwable) {
+            null
+        }
+    }
+
+    fun cleanup(c: Context, keep: Set<String>) {
+        try {
+            val now = System.currentTimeMillis()
+            dir(c).listFiles()?.forEach {
+                if (it.name !in keep && it.name !in pending && now - it.lastModified() > 60000L) it.delete()
+            }
+        } catch (e: Throwable) { }
+    }
+}
