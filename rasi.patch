+    // ---- batch 9: ten more styles (called from drawNew, shared by keyboard and previews) ----
+    fun isB9(style: String) = style == "piano" || style == "galaxy" || style == "matrix" || style == "dna" ||
+        style == "bounce" || style == "liquid" || style == "snow" || style == "kaleido" ||
+        style == "hexpulse" || style == "bubbles"
+
+    private val matrixSets: Array<CharArray> = arrayOf(
+        "01".toCharArray(),
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".toCharArray(),
+        "\uFF66\uFF71\uFF72\uFF73\uFF74\uFF75\uFF76\uFF77\uFF78\uFF79\uFF7A\uFF7B\uFF7C\uFF7D\uFF7E\uFF7F\uFF80\uFF81\uFF82\uFF83\uFF84\uFF85\uFF86\uFF87\uFF88\uFF89".toCharArray()
+    )
+    private val popCycle = IntArray(128) { -1 }
+    private val popAt = FloatArray(128)
+    private val popX = FloatArray(128)
+    private val popY = FloatArray(128)
+    private val popR = FloatArray(128)
+
+    private fun cos9(x: Float): Float = Math.cos(x.toDouble()).toFloat()
+
+    private fun drawB9(
+        canvas: Canvas, p: android.content.SharedPreferences, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float, count: Int, t: Float, size: Float, str: Float,
+        lo: Float, mid: Float, hi: Float, bv: Float, nowSec: Float
+    ) {
+        val pi = Math.PI.toFloat()
+        val pi2 = pi * 2f
+        val m = minOf(w, h)
+        when (style) {
+            "piano" -> {
+                val n = count.coerceIn(8, 52)
+                val gap = p.getInt("viz_ngap", 12) / 100f
+                val showPiano = p.getBoolean("viz_npiano", true)
+                val showBlack = p.getBoolean("viz_nblack", true)
+                val kw = w / n
+                val keyH = (h * 0.5f * size).coerceIn(h * 0.2f, h * 0.95f)
+                val top = h - keyH
+                val inset = kw * gap / 2f
+                fun press(i: Int): Float =
+                    ((at(disp, i / (n - 1f) * (N - 1)) * sens).coerceIn(0f, 1f) * str + bv * 0.12f * str).coerceIn(0f, 1f)
+                for (i in 0 until n) {
+                    val pv = press(i)
+                    val x0 = i * kw + inset
+                    val x1 = (i + 1) * kw - inset
+                    val c = col.at(i / (n - 1f))
+                    if (showPiano) {
+                        val dy = pv * keyH * 0.10f
+                        paint.color = withA(AColor.WHITE, (alpha * 0.82f).toInt())
+                        canvas.drawRoundRect(x0, top + dy, x1, h, 3f * dens, 3f * dens, paint)
+                        paint.color = withA(c, (alpha * (0.12f + 0.78f * pv)).toInt())
+                        canvas.drawRoundRect(x0, top + dy, x1, h, 3f * dens, 3f * dens, paint)
+                    } else {
+                        val bh = keyH * (0.04f + 0.96f * pv)
+                        paint.color = withA(c, alpha)
+                        canvas.drawRoundRect(x0, h - bh, x1, h, 3f * dens, 3f * dens, paint)
+                    }
+                }
+                if (showPiano && showBlack) {
+                    for (i in 0 until n - 1) {
+                        val k = i % 7
+                        if (k == 2 || k == 6) continue
+                        val pv = (press(i) + press(i + 1)) / 2f
+                        val bwid = kw * 0.58f
+                        val bx = (i + 1) * kw
+                        val bh = keyH * 0.6f
+                        val dy = pv * bh * 0.10f
+                        paint.color = withA(0xFF14141C.toInt(), (alpha * 0.95f).toInt())
+                        canvas.drawRoundRect(bx - bwid / 2f, top + dy, bx + bwid / 2f, top + bh + dy, 2f * dens, 2f * dens, paint)
+                        paint.color = withA(col.at((i + 1f) / n), (alpha * 0.9f * pv).toInt())
+                        canvas.drawRoundRect(bx - bwid / 2f, top + dy, bx + bwid / 2f, top + bh + dy, 2f * dens, 2f * dens, paint)
+                    }
+                }
+            }
+            "galaxy" -> {
+                val arms = p.getInt("viz_narms", 3).coerceIn(1, 8)
+                val n = count.coerceIn(arms, 200)
+                val per = maxOf(1, n / arms)
+                val cx = w / 2f
+                val cy = h / 2f
+                val sc = (0.5f + 0.5f * size).coerceAtMost(1.2f)
+                val rx = w * 0.48f * sc
+                val ry = h * 0.46f * sc
+                val spin = t * 0.25f // time only: effects do not follow the beat
+                val gr = minOf(rx, ry) * 0.5f * (0.6f + 0.8f * lo * str)
+                val gc = col.at(0f)
+                paint.shader = RadialGradient(
+                    cx, cy, gr.coerceAtLeast(2f),
+                    intArrayOf(withA(gc, (alpha * 0.55f).toInt()), withA(gc, 0)), null, Shader.TileMode.CLAMP
+                )
+                canvas.drawCircle(cx, cy, gr.coerceAtLeast(2f), paint)
+                paint.shader = null
+                for (i in 0 until n) {
+                    val arm = i % arms
+                    val k = i / arms
+                    val u = ((k + 1f) / per).coerceAtMost(1f)
+                    val ang = arm * pi2 / arms + u * 3.2f + spin * (1.2f - 0.6f * u) + (hash(i * 3 + 1) - 0.5f) * 0.35f
+                    val rad = u * (1f + 0.25f * lo * str + 0.3f * bv * str) + (hash(i * 3 + 2) - 0.5f) * 0.06f
+                    val x = cx + cos9(ang) * rad * rx
+                    val y = cy + sin(ang) * rad * ry
+                    val r = dens * (1.1f + 2.4f * size * (1f - 0.5f * u)) * (1f + 0.8f * bv * str)
+                    paint.color = withA(col.at(u), (alpha * (0.35f + 0.65f * (1f - u))).toInt())
+                    canvas.drawCircle(x, y, r, paint)
+                }
+            }
+            "matrix" -> {
+                val cols = count.coerceIn(6, 60)
+                val set = matrixSets[p.getInt("viz_nchars", 0).coerceIn(0, 2)]
+                val cw = w / cols
+                val ts = (cw * 0.9f).coerceIn(8f * dens, 22f * dens) * (0.7f + 0.3f * size)
+                val ch = ts * 1.1f
+                val rows = (h / ch).toInt() + 2
+                paint.textSize = ts
+                paint.textAlign = Paint.Align.CENTER
+                for (c in 0 until cols) {
+                    val hc = hash(c * 7 + 1)
+                    val trail = 6 + (8f * hash(c * 7 + 2)).toInt()
+                    val total = rows + trail
+                    val head = frac(t * 0.16f * (0.6f + hash(c * 7 + 3)) + hc) * total
+                    val lvl = (at(disp, c / (cols - 1f) * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val bright = (0.30f + 0.70f * (lvl * str + bv * 0.3f * str)).coerceIn(0f, 1f)
+                    val x = c * cw + cw / 2f
+                    val cc = col.at(c / (cols - 1f))
+                    val hd = head.toInt()
+                    for (j in 0..trail) {
+                        val row = hd - j
+                        if (row < 0 || row >= rows) continue
+                        val raw = row * 31 + c * 17 + (if (j == 0) (t * 9f).toInt() else 0)
+                        val idx = ((raw % set.size) + set.size) % set.size
+                        val f = 1f - j / (trail + 1f)
+                        paint.color = withA(if (j == 0) lerpC(cc, AColor.WHITE, 0.7f) else cc, (alpha * f * f * bright).toInt())
+                        canvas.drawText(set, idx, 1, x, (row + 1) * ch, paint)
+                    }
+                }
+                paint.textAlign = Paint.Align.LEFT
+            }
+            "dna" -> {
+                val pts = count.coerceIn(10, 80)
+                val twist = p.getInt("viz_ntwist", 100) / 100f
+                val cy = h / 2f
+                val amp = h * 0.34f * (0.5f + 0.5f * size).coerceAtMost(1.3f) * (0.7f + 0.5f * (lo * str + bv * 0.3f * str))
+                val ph = t * twist * 1.6f
+                val r0 = dens * (2f + 3f * size)
+                for (i in 0 until pts) {
+                    val u = i / (pts - 1f)
+                    val x = w * (0.03f + 0.94f * u)
+                    val a = u * pi * 5f + ph
+                    val sn = sin(a)
+                    val d = cos9(a)
+                    val y1 = cy + amp * sn
+                    val y2 = cy - amp * sn
+                    val lvl = (at(disp, u * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val c1 = col.at(u)
+                    val c2 = col.at(1f - u)
+                    paint.style = Paint.Style.STROKE
+                    paint.strokeWidth = dens * 1.2f
+                    paint.color = withA(lerpC(c1, c2, 0.5f), (alpha * (0.12f + 0.35f * lvl * str)).toInt())
+                    canvas.drawLine(x, y1, x, y2, paint)
+                    paint.style = Paint.Style.FILL
+                    fun dot(y: Float, depth: Float, c: Int) {
+                        val r = r0 * (1f + 0.45f * depth) * (1f + 0.5f * lvl * str)
+                        paint.color = withA(c, (alpha * (0.55f + 0.45f * (depth + 1f) / 2f)).toInt())
+                        canvas.drawCircle(x, y, r, paint)
+                    }
+                    if (d >= 0f) { dot(y2, -d, c2); dot(y1, d, c1) } else { dot(y1, d, c1); dot(y2, -d, c2) }
+                }
+            }
+            "bounce" -> {
+                val n = count.coerceIn(4, 40)
+                val grav = p.getInt("viz_ngrav", 100) / 100f
+                val slot = w / n
+                val rate = Math.sqrt(grav.toDouble()).toFloat()
+                for (i in 0 until n) {
+                    val lvl = (at(disp, i / (n - 1f) * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val ph = frac(nowSec * (0.5f + 0.6f * hash(i * 3 + 1)) * rate * (p.getInt("viz_nspeed", 100) / 100f) + hash(i * 3 + 2))
+                    val maxH = h * 0.8f * (0.15f + 0.85f * (lvl * str).coerceIn(0f, 1f))
+                    val hg = 4f * ph * (1f - ph) * maxH
+                    val r = minOf(slot * 0.4f, dens * (4f + 8f * size)) * (1f + 0.3f * bv * str)
+                    val x = (i + 0.5f) * slot
+                    paint.color = withA(col.at(i / (n - 1f)), alpha)
+                    if (hg < r * 0.4f) {
+                        canvas.drawOval(x - r * 1.15f, h - r * 1.5f, x + r * 1.15f, h, paint)
+                    } else {
+                        canvas.drawCircle(x, h - r - hg, r, paint)
+                    }
+                }
+            }
+            "liquid" -> {
+                val layers = count.coerceIn(1, 6)
+                val steps = 40
+                for (l in 0 until layers) {
+                    val tr = if (layers > 1) l / (layers - 1f) else 0f
+                    val lvl = when (l % 3) { 0 -> lo; 1 -> mid; else -> hi }
+                    val base = h * (0.42f + 0.40f * (l + 1f) / layers)
+                    val amp = h * 0.10f * size * (0.5f + 1.1f * lvl * str + 0.4f * bv * str)
+                    val dir = if (l % 2 == 0) 1f else -1f
+                    extraPath.reset()
+                    extraPath.moveTo(0f, h)
+                    for (i in 0..steps) {
+                        val u = i / steps.toFloat()
+                        val y = base + amp * sin(u * pi * (1.6f + 0.6f * l) + t * (0.9f + 0.3f * l) * dir) +
+                            amp * 0.45f * sin(u * pi * 3.3f - t * 1.3f * dir + l)
+                        extraPath.lineTo(w * u, y)
+                    }
+                    extraPath.lineTo(w, h)
+                    extraPath.close()
+                    paint.color = withA(col.at(tr), (alpha * 0.62f).toInt())
+                    canvas.drawPath(extraPath, paint)
+                }
+            }
+            "snow" -> {
+                val n = count.coerceIn(10, 150)
+                val wind = p.getInt("viz_nwind", 30) / 100f
+                for (i in 0 until n) {
+                    val hx = hash(i * 5 + 1); val hs = hash(i * 5 + 2); val hp = hash(i * 5 + 3)
+                    val fall = frac(t * 0.07f * (0.5f + hs) + hp)
+                    val y = fall * (h + 20f * dens) - 10f * dens
+                    val sway = sin(t * 0.8f + hp * 20f) * w * 0.015f
+                    val gust = fall * wind * w * 0.35f + bv * str * w * 0.05f * (0.5f + hs)
+                    val x = frac((hx * w + sway + gust) / w) * w
+                    val r = dens * (1f + 2.6f * size * (0.4f + 0.6f * hs)) * (1f + 0.4f * lo * str)
+                    paint.color = withA(lerpC(col.at(hash(i * 5 + 4)), AColor.WHITE, 0.6f), (alpha * (0.5f + 0.5f * hs)).toInt())
+                    canvas.drawCircle(x, y, r, paint)
+                }
+            }
+            "kaleido" -> {
+                val seg = p.getInt("viz_nseg", 8).coerceIn(3, 16)
+                val items = count.coerceIn(2, 20)
+                val cx = w / 2f
+                val cy = h / 2f
+                val sc = (0.5f + 0.5f * size).coerceAtMost(1.2f)
+                val rxMax = w * 0.48f * sc
+                val ryMax = h * 0.46f * sc
+                val rot = t * 0.3f + bv * 0.15f * str
+                for (k in 0 until items) {
+                    val u = (k + 1f) / items
+                    val lvl = (at(disp, u * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val rad = u * (0.55f + 0.45f * lvl * str + 0.12f * bv * str)
+                    val a0 = (0.08f + 0.84f * hash(k * 3 + 1)) * (pi2 / seg)
+                    val c = col.at(u)
+                    val rd = dens * (2f + 6f * size * (0.35f + 0.65f * lvl * str) + 3f * bv * str)
+                    for (sg in 0 until seg) {
+                        val ang = (if (sg % 2 == 0) sg * pi2 / seg + a0 else (sg + 1) * pi2 / seg - a0) + rot
+                        paint.color = withA(c, (alpha * (0.45f + 0.5f * lvl)).toInt())
+                        canvas.drawCircle(cx + cos9(ang) * rad * rxMax, cy + sin(ang) * rad * ryMax, rd, paint)
+                    }
+                }
+                paint.color = withA(col.at(0f), (alpha * 0.8f).toInt())
+                canvas.drawCircle(cx, cy, dens * (3f + 5f * size) * (1f + 0.6f * bv * str), paint)
+            }
+            "hexpulse" -> {
+                val rings = count.coerceIn(1, 5)
+                val cell = p.getInt("viz_ncell", 100) / 100f
+                val hr = dens * (6f + 16f * cell)
+                val dx = hr * 1.7320508f
+                val dy = hr * 1.5f
+                val rowsN = (h / dy).toInt() + 2
+                val colsN = (w / dx).toInt() + 2
+                val cx = w / 2f
+                val cy = h / 2f
+                val maxD = Math.sqrt((cx * cx + cy * cy).toDouble()).toFloat().coerceAtLeast(1f)
+                for (r in 0 until rowsN) {
+                    for (c in 0 until colsN) {
+                        val x = c * dx + (if (r % 2 == 1) dx / 2f else 0f)
+                        val y = r * dy
+                        val ddx = x - cx
+                        val ddy = y - cy
+                        val dn = Math.sqrt((ddx * ddx + ddy * ddy).toDouble()).toFloat() / maxD
+                        val wv = 0.5f + 0.5f * sin(dn * pi2 * rings - t * 1.6f)
+                        val lvl = (at(disp, (x / w).coerceIn(0f, 1f) * (N - 1)) * sens).coerceIn(0f, 1f)
+                        val lit = (wv * wv * wv * (0.25f + 0.75f * lo * str) + bv * str * (1f - dn).coerceAtLeast(0f) * 0.7f + lvl * str * 0.5f).coerceIn(0f, 1f)
+                        extraPath.reset()
+                        for (q in 0..5) {
+                            val a = pi / 6f + q * pi / 3f
+                            val px = x + cos9(a) * hr * 0.88f
+                            val py = y + sin(a) * hr * 0.88f
+                            if (q == 0) extraPath.moveTo(px, py) else extraPath.lineTo(px, py)
+                        }
+                        extraPath.close()
+                        paint.color = withA(col.at((x / w).coerceIn(0f, 1f)), (alpha * (0.07f + 0.85f * lit)).toInt())
+                        canvas.drawPath(extraPath, paint)
+                    }
+                }
+            }
+            "bubbles" -> {
+                val n = count.coerceIn(5, 100)
+                val pop = p.getBoolean("viz_npop", true)
+                for (i in 0 until n) {
+                    val hx = hash(i * 5 + 1); val hs = hash(i * 5 + 2); val hp = hash(i * 5 + 3)
+                    val prog = t * 0.06f * (0.5f + hs) + hp
+                    val cyc = Math.floor(prog.toDouble()).toInt()
+                    val rise = frac(prog)
+                    val r = dens * (3f + 11f * size * (0.4f + 0.6f * hs)) * (1f + 0.5f * lo * str)
+                    val x = w * (0.05f + 0.9f * hx) + w * 0.03f * sin(t * 1.1f + hp * 30f)
+                    val y = h + r - rise * (h + 2f * r)
+                    val c = col.at(hash(i * 5 + 4))
+                    if (pop && bv > 0.9f && popCycle[i] != cyc && hash(i * 7 + cyc) < 0.35f && y > 0f && y < h) {
+                        popCycle[i] = cyc; popAt[i] = nowSec; popX[i] = x; popY[i] = y; popR[i] = r
+                    }
+                    if (popCycle[i] == cyc) {
+                        val e = (nowSec - popAt[i]) / 0.3f
+                        if (e in 0f..1f) {
+                            paint.style = Paint.Style.STROKE
+                            paint.strokeWidth = dens * 1.5f
+                            paint.color = withA(c, (alpha * (1f - e)).toInt())
+                            canvas.drawCircle(popX[i], popY[i], popR[i] * (1f + 0.9f * e), paint)
+                            paint.style = Paint.Style.FILL
+                        }
+                        continue
+                    }
+                    paint.style = Paint.Style.FILL
+                    paint.color = withA(c, (alpha * 0.12f).toInt())
+                    canvas.drawCircle(x, y, r, paint)
+                    paint.style = Paint.Style.STROKE
+                    paint.strokeWidth = dens * 1.3f
+                    paint.color = withA(c, (alpha * 0.8f).toInt())
+                    canvas.drawCircle(x, y, r, paint)
+                    paint.style = Paint.Style.FILL
+                    paint.color = withA(AColor.WHITE, (alpha * 0.5f).toInt())
+                    canvas.drawCircle(x - r * 0.35f, y - r * 0.35f, r * 0.18f, paint)
+                }
+            }
+        }
+    }
+
+    private fun drawNew(
+        canvas: Canvas, p: android.content.SharedPreferences, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float
+    ): Boolean {
+        if (!isNew(style)) return false
+        val speed = p.getInt("viz_nspeed", 100) / 100f
+        val str = p.getInt("viz_nstr", 70) / 100f
+        val size = p.getInt("viz_nsize", 60) / 60f
+        val count = p.getInt("viz_count", -1).let { if (it < 3) defaultCount(style) else it }
+        val nowSec = (col.now % 6000000L) / 1000f
+        val t = nowSec * speed
+        val m = minOf(w, h)
+        val lo = band(0, 8, sens)
+        val mid = band(8, 28, sens)
+        val hi = band(28, N, sens * 1.6f)
+        val bv = if (previewMode) previewBeat else punch
+        val pi = Math.PI.toFloat()
+        val pi2 = pi * 2f
+        paint.shader = null
+        paint.style = Paint.Style.FILL
+        when (style) {
+            "fireflies" -> {
+                val trail = p.getInt("viz_ntrail", 3)
+                val r0 = dens * (2f + 3.5f * size)
+                for (i in 0 until count) {
+                    val hx = hash(i * 3 + 1); val hy = hash(i * 3 + 2); val hp = hash(i * 3 + 3)
+                    val c = col.at(hash(i * 3 + 4))
+                    val tw = 0.5f + 0.5f * sin(t * (0.9f + hp) + hp * 20f)
+                    val glowK = (0.35f + 0.65f * tw) * (0.45f + 0.55f * (lo * str + bv * 0.8f).coerceIn(0f, 1f))
+                    for (j in trail downTo 0) {
+                        val tt = t - j * 0.14f
+                        val x = w * (0.04f + 0.92f * hx) + w * 0.07f * sin(tt * 0.45f + hp * 30f)
+                        val y = h * (0.12f + 0.76f * hy) + h * 0.10f * Math.cos((tt * 0.38f + hp * 17f).toDouble()).toFloat()
+                        val f = if (j == 0) 1f else (1f - j / (trail + 1f)) * 0.45f
+                        val r = r0 * (1f + 1.6f * lo * str + 0.8f * bv * str) * (if (j == 0) 1f else 0.75f)
+                        paint.color = withA(c, (alpha * 0.22f * glowK * f).toInt())
+                        canvas.drawCircle(x, y, r * 3.2f, paint)
+                        paint.color = withA(c, (alpha * glowK * f).toInt())
+                        canvas.drawCircle(x, y, r, paint)
+                    }
+                }
+            }
+            "flames" -> {
+                // one flame per frequency band, rising from the bottom; louder band = taller flame
+                val n = count.coerceIn(6, 80)
+                val slot = w / n
+                val flick = p.getInt("viz_nflick", 60) / 100f
+                val embers = p.getBoolean("viz_nember", true)
+                val maxH = h * 0.95f
+                val fw0 = slot * (0.9f + 0.9f * size).coerceIn(0.6f, 2.2f)
+                fun tongue(cx: Float, fw: Float, fh: Float, sway: Float, color: Int, a: Int) {
+                    if (fh < 2f || a <= 0) return
+                    flamePath.rewind()
+                    flamePath.moveTo(cx - fw / 2f, h)
+                    flamePath.quadTo(cx - fw * 0.62f, h - fh * 0.5f, cx + sway, h - fh)
+                    flamePath.quadTo(cx + fw * 0.62f, h - fh * 0.5f, cx + fw / 2f, h)
+                    flamePath.close()
+                    paint.color = withA(color, a)
+                    canvas.drawPath(flamePath, paint)
+                }
+                for (i in 0 until n) {
+                    val tt = i / (n - 1f)
+                    val lv = (at(disp, tt * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val e = (lv * str + bv * 0.15f * str).coerceIn(0f, 1f)
+                    val fl = 1f - flick * 0.25f + flick * (0.15f * sin(t * 9f + i * 1.7f) + 0.10f * sin(t * 16f + i * 0.9f))
+                    val fh = maxH * (0.05f + 0.95f * e) * fl
+                    val cx = (i + 0.5f) * slot
+                    val sway = sin(t * 3f + i * 0.8f) * slot * (0.15f + 0.5f * flick) * e
+                    val c = col.at(tt)
+                    tongue(cx, fw0, fh, sway, c, (alpha * 0.55f).toInt())
+                    tongue(cx, fw0 * 0.7f, fh * 0.72f, sway * 0.8f, lerpC(c, AColor.WHITE, 0.3f), (alpha * 0.8f).toInt())
+                    tongue(cx, fw0 * 0.4f, fh * 0.45f, sway * 0.5f, lerpC(c, AColor.WHITE, 0.8f), alpha)
+                    if (embers && e > 0.25f && i % 2 == 0) {
+                        val ph = frac(t * 0.7f + hash(i * 7 + 1))
+                        val ey = h - fh - ph * h * 0.25f * e
+                        paint.color = withA(lerpC(c, AColor.WHITE, 0.5f), (alpha * (1f - ph)).toInt())
+                        canvas.drawCircle(cx + sway + sin(t * 4f + i) * slot * 0.3f, ey, dens * 1.6f * (1f - ph * 0.5f), paint)
+                    }
+                }
+            }
+            "lava" -> {
+                for (i in 0 until count) {
+                    val hx = hash(i * 5 + 1); val hs = hash(i * 5 + 2); val hp = hash(i * 5 + 3)
+                    val rise = frac(t * 0.045f * (0.5f + hs) + hp)
+                    val cy = h * (1.15f - rise * 1.3f)
+                    val cx = w * (0.08f + 0.84f * hx) + w * 0.07f * sin(t * 0.4f + i)
+                    val r = m * 0.22f * size * (0.55f + 0.6f * hs) * (0.8f + 0.9f * lo * str + 0.5f * bv * str) *
+                        (0.35f + 0.65f * sin(pi * rise))
+                    if (r < 2f) continue
+                    val c = col.at(hash(i * 5 + 4))
+                    paint.shader = RadialGradient(
+                        cx, cy, r,
+                        intArrayOf(withA(c, (alpha * 0.85f).toInt()), withA(c, (alpha * 0.5f).toInt()), withA(c, 0)),
+                        floatArrayOf(0f, 0.55f, 1f), Shader.TileMode.CLAMP
+                    )
+                    canvas.drawCircle(cx, cy, r, paint)
+                }
+                paint.shader = null
+            }
+            "lightning" -> {
+                val branches = p.getInt("viz_nbranch", 2)
+                val seed = if (previewMode) previewSeed else lastPunchAt.toInt()
+                val env = bv
+                if (env > 0.02f) {
+                    val segs = count.coerceIn(4, 40)
+                    val c = col.at(0.5f)
+                    paint.color = withA(c, (alpha * 0.10f * env * str).toInt())
+                    canvas.drawRect(0f, 0f, w, h, paint)
+                    var x = w * (0.2f + 0.6f * hash(seed))
+                    val dy = h / segs
+                    val px = FloatArray(segs + 1)
+                    val py = FloatArray(segs + 1)
+                    px[0] = x; py[0] = 0f
+                    for (s in 1..segs) {
+                        x += (hash(seed * 31 + s) - 0.5f) * w * 0.16f
+                        x = x.coerceIn(w * 0.05f, w * 0.95f)
+                        px[s] = x; py[s] = s * dy
+                    }
+                    drawBolt(canvas, px, py, segs, c, alpha, (env * str).coerceIn(0f, 1f), dens, size)
+                    for (b in 0 until branches) {
+                        val from = 2 + (hash(seed * 17 + b) * (segs - 4)).toInt()
+                        val bx = FloatArray(7)
+                        val by = FloatArray(7)
+                        var xx = px[from]
+                        var yy = py[from]
+                        val dir = if (hash(seed * 13 + b) > 0.5f) 1f else -1f
+                        bx[0] = xx; by[0] = yy
+                        for (s in 1..6) {
+                            xx += dir * w * 0.05f * (0.5f + hash(seed * 7 + b * 11 + s))
+                            yy += dy * 0.9f
+                            bx[s] = xx.coerceIn(0f, w); by[s] = yy
+                        }
+                        drawBolt(canvas, bx, by, 6, c, alpha, (env * str * 0.6f).coerceIn(0f, 1f), dens, size * 0.6f)
+                    }
+                }
+            }
+            "rain" -> {
+                paint.style = Paint.Style.STROKE
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.strokeWidth = dens * (1f + 1.5f * size)
+                val slant = 0.18f
+                for (i in 0 until count) {
+                    val hx = hash(i * 4 + 1); val hv = hash(i * 4 + 2); val hl = hash(i * 4 + 3)
+                    val len = h * 0.14f * size * (0.5f + hl) * (1f + hi * str * 1.6f)
+                    val ph = frac(t * 0.55f * (0.6f + hv) + hl * 7f)
+                    val y = ph * (h + len) - len
+                    val x = (w * hx + slant * y) % w
+                    val a = (0.35f + 0.65f * (hi * str + mid * 0.5f + bv * 0.6f).coerceIn(0f, 1f)) * (0.4f + 0.6f * hv)
+                    paint.color = withA(col.at(hx), (alpha * a).toInt())
+                    canvas.drawLine(x, y, x + len * slant, y + len, paint)
+                }
+            }
+            "heartbeat" -> {
+                val cycles = count.coerceIn(1, 12)
+                val amp = h * 0.38f * (0.35f + 0.65f * (lo * str * 0.6f + bv * 0.7f + 0.15f).coerceIn(0f, 1f))
+                val cy = h / 2f
+                val steps = 160
+                extraPath.reset()
+                for (i in 0..steps) {
+                    val u = i / steps.toFloat()
+                    val y = cy - amp * ecg(frac(u * cycles - t * 0.35f))
+                    if (i == 0) extraPath.moveTo(0f, y) else extraPath.lineTo(w * u, y)
+                }
+                val c1 = col.at(0f)
+                val c2 = col.at(1f)
+                paint.style = Paint.Style.STROKE
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.strokeJoin = Paint.Join.ROUND
+                paint.strokeWidth = dens * (1.5f + 2f * size)
+                paint.shader = android.graphics.LinearGradient(
+                    0f, 0f, w, 0f, intArrayOf(withA(c1, 0), withA(c1, alpha), withA(c2, alpha)),
+                    floatArrayOf(0f, 0.3f, 1f), Shader.TileMode.CLAMP
+                )
+                canvas.drawPath(extraPath, paint)
+                paint.shader = null
+                paint.style = Paint.Style.FILL
+                val tipY = cy - amp * ecg(frac(cycles - t * 0.35f))
+                paint.color = withA(c2, alpha)
+                canvas.drawCircle(w - dens * 4f, tipY, dens * (3f + 4f * size) * (1f + bv), paint)
+            }
+            "waterfall" -> {
+                val rows = count.coerceIn(4, 32)
+                val cols = 48
+                val down = p.getInt("viz_ndir", 0) == 1
+                val rh = h / rows
+                val cw = w / cols
+                for (r in 0 until rows) {
+                    val fade = 1f - r / rows.toFloat() * 0.75f
+                    val yTop = if (down) r * rh else h - (r + 1) * rh
+                    for (c in 0 until cols) {
+                        val v = (histVal(r, c * N / cols, nowSec) * sens * (0.8f + 0.4f * str)).coerceIn(0f, 1f)
+                        if (v < 0.05f) continue
+                        paint.color = withA(col.at(c / (cols - 1f)), (alpha * v * fade).toInt())
+                        canvas.drawRect(c * cw + cw * 0.08f, yTop + rh * 0.1f, (c + 1) * cw - cw * 0.08f, yTop + rh * 0.9f, paint)
+                    }
+                }
+            }
+            "fountain" -> {
+                val spread = p.getInt("viz_nspread", 50) / 50f
+                val r0 = dens * (2f + 3f * size)
+                val top = h * (0.30f + 0.65f * (lo * str + bv * 0.5f).coerceIn(0f, 1f))
+                for (i in 0 until count) {
+                    val hp = hash(i * 3 + 1); val hs = hash(i * 3 + 2); val hh = hash(i * 3 + 3)
+                    val ph = frac(t * 0.55f + hp)
+                    val y = h - top * (0.65f + 0.35f * hh) * 4f * ph * (1f - ph)
+                    val x = w / 2f + (hs - 0.5f) * 2f * w * 0.42f * spread * ph
+                    val r = r0 * (1f - 0.5f * ph) * (1f + 0.6f * lo * str)
+                    paint.color = withA(col.at(ph), (alpha * (1f - ph * ph)).toInt())
+                    canvas.drawCircle(x, y, r, paint)
+                }
+            }
+            "tunnel" -> {
+                val n = count.coerceIn(3, 24)
+                paint.style = Paint.Style.STROKE
+                paint.strokeJoin = Paint.Join.ROUND
+                val kick = 1f + 0.18f * bv * str + 0.10f * lo * str
+                for (j in 0 until n) {
+                    val z = frac(j / n.toFloat() + t * 0.12f)
+                    val s = z * z * kick
+                    val hw = w * 0.5f * s * 1.15f
+                    val hh = h * 0.5f * s * 1.15f
+                    if (hw < 2f) continue
+                    paint.strokeWidth = dens * (0.6f + 3.2f * z * size)
+                    paint.color = withA(col.at(z), (alpha * minOf(1f, z * 6f) * (0.55f + 0.45f * (hi * str + 0.3f).coerceIn(0f, 1f))).toInt())
+                    canvas.drawRoundRect(RectF(w / 2f - hw, h / 2f - hh, w / 2f + hw, h / 2f + hh), m * 0.06f * s, m * 0.06f * s, paint)
+                }
+            }
+            "fireworks" -> {
+                val burst = p.getInt("viz_nburst", 60) / 60f
+                val period = 1.25f
+                val n = count.coerceIn(8, 60)
+                for (sl in 0..2) {
+                    val tt = t / period + sl / 3f
+                    val idx = Math.floor(tt.toDouble()).toInt()
+                    val ph = frac(tt)
+                    val seed = idx * 3 + sl
+                    val cx = w * (0.18f + 0.64f * hash(seed * 7 + 1))
+                    val cy = h * (0.18f + 0.42f * hash(seed * 7 + 2))
+                    val c = col.at(hash(seed * 7 + 3))
+                    val launch = 0.14f
+                    if (ph < launch) {
+                        paint.color = withA(c, (alpha * 0.9f).toInt())
+                        canvas.drawCircle(cx, h - (h - cy) * (ph / launch), dens * (2f + 1.5f * size), paint)
+                        continue
+                    }
+                    val e = (ph - launch) / (1f - launch)
+                    val ease = 1f - (1f - e) * (1f - e)
+                    val rad = m * 0.55f * burst * (0.75f + 0.5f * (lo * str + bv * 0.6f).coerceIn(0f, 1f))
+                    for (j in 0 until n) {
+                        val ang = j / n.toFloat() * pi2 + hash(seed * 11 + j) * 0.3f
+                        val rr = rad * ease * (0.75f + 0.25f * hash(seed * 13 + j))
+                        val x = cx + Math.cos(ang.toDouble()).toFloat() * rr
+                        val y = cy + sin(ang) * rr + h * 0.18f * e * e
+                        paint.color = withA(c, (alpha * (1f - e) * (1f - e * 0.4f)).toInt())
+                        canvas.drawCircle(x, y, dens * (1.4f + 2f * size) * (1f - 0.6f * e), paint)
+                    }
+                }
+            }
+            "ribbons" -> {
+                val rc = count.coerceIn(1, 10)
+                paint.style = Paint.Style.STROKE
+                paint.strokeCap = Paint.Cap.ROUND
+                paint.strokeJoin = Paint.Join.ROUND
+                val steps = 48
+                for (r in 0 until rc) {
+                    val tr = if (rc > 1) r / (rc - 1f) else 0f
+                    val lvl = when (r % 3) { 0 -> lo; 1 -> mid; else -> hi }
+                    val amp = h * (0.10f + 0.30f * (lvl * str + bv * 0.25f).coerceIn(0f, 1f))
+                    val base = h * (0.5f + (tr - 0.5f) * 0.25f)
+                    val freq = 1.2f + 0.5f * r
+                    val phs = t * (0.7f + 0.25f * r) * (if (r % 2 == 0) 1f else -1f) + r
+                    extraPath.reset()
+                    for (i in 0..steps) {
+                        val u = i / steps.toFloat()
+                        val y = base + amp * sin(u * pi * freq + phs) * (0.6f + 0.4f * sin(u * pi))
+                        if (i == 0) extraPath.moveTo(0f, y) else extraPath.lineTo(w * u, y)
+                    }
+                    val c = col.at(tr)
+                    paint.strokeWidth = dens * (6f + 10f * size) * (0.7f + 0.6f * lvl)
+                    paint.color = withA(c, (alpha * 0.25f).toInt())
+                    canvas.drawPath(extraPath, paint)
+                    paint.strokeWidth = dens * (2f + 4f * size) * (0.7f + 0.6f * lvl)
+                    paint.color = withA(c, alpha)
+                    canvas.drawPath(extraPath, paint)
+                }
+            }
+            else -> drawB9(canvas, p, style, col, w, h, alpha, sens, dens, count, t, size, str, lo, mid, hi, bv, nowSec)
+        }
+        paint.shader = null
+        paint.style = Paint.Style.FILL
+        paint.strokeCap = Paint.Cap.BUTT
+        paint.strokeJoin = Paint.Join.MITER
+        paint.textAlign = Paint.Align.LEFT
+        return true
+    }
+
+    private fun drawExtra(
+        canvas: Canvas, p: android.content.SharedPreferences, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float
+    ): Boolean {
+        if (style != "mirror" && style != "dots" && style != "wave" && style != "blocks" &&
+            style != "glow" && style != "orbit" && style != "sparkle") return false
+        val count = p.getInt("viz_count", -1).let { if (it < 4) defaultCount(style) else it }
+        val fill = p.getInt("viz_barw", 70) / 100f
+        val maxH = h * p.getInt("viz_height", 75) / 100f
+        var pos = p.getString("viz_pos", "auto") ?: "auto"
+        if (pos == "auto") pos = if (style == "mirror") "center" else "bottom"
+        val base = when (pos) { "top" -> 0f; "center" -> h / 2f; else -> h }
+        val slot = w / count
+        fun lv(j: Int): Float {
+            val t = if (count > 1) j / (count - 1f) else 0f
+            val m = p.getBoolean("viz_mirror", false)
+            return (at(disp, (if (m) Math.abs(2f * t - 1f) else t) * (N - 1)) * sens).coerceIn(0f, 1f)
+        }
+        paint.shader = null
+        paint.style = Paint.Style.FILL
+        when (style) {
+            "mirror" -> {
+                val cy = when (pos) { "top" -> maxH / 2f; "bottom" -> h - maxH / 2f; else -> h / 2f }
+                val bw = (slot * fill).coerceAtLeast(1f)
+                for (j in 0 until count) {
+                    val t = if (count > 1) j / (count - 1f) else 0f
+                    paint.color = col.at(t); paint.alpha = alpha
+                    val bh = (maxH * lv(j)).coerceAtLeast(2f * dens)
+                    val x = j * slot + (slot - bw) / 2f
+                    val r = minOf(bw / 2f, 3f * dens)
+                    canvas.drawRoundRect(RectF(x, cy - bh / 2f, x + bw, cy + bh / 2f), r, r, paint)
+                }
+            }
+            "dots" -> {
+                val rad = minOf(slot * fill / 2f, 5f * dens).coerceAtLeast(1.5f * dens)
+                for (j in 0 until count) {
+                    val t = if (count > 1) j / (count - 1f) else 0f
+                    paint.color = col.at(t); paint.alpha = alpha
+                    val y = when (pos) {
+                        "top" -> rad + maxH * lv(j)
+                        "center" -> h / 2f - maxH * lv(j) / 2f
+                        else -> h - rad - maxH * lv(j)
+                    }
+                    canvas.drawCircle(j * slot + slot / 2f, y, rad, paint)
+                }
+            }
+            "wave" -> {
+                val dir = if (pos == "top") 1f else -1f
+                extraPath.reset()
+                var px = 0f
+                var py = base + dir * maxH * lv(0)
+                extraPath.moveTo(px, py)
+                for (j in 1 until count) {
+                    val x = j * w / (count - 1f)
+                    val y = base + dir * maxH * lv(j)
+                    extraPath.quadTo(px, py, (px + x) / 2f, (py + y) / 2f)
+                    px = x; py = y
+                }
+                extraPath.lineTo(w, py)
+                val c0 = col.at(0f); val c1 = col.at(1f)
+                val sh = android.graphics.LinearGradient(0f, 0f, w, 0f, c0, c1, Shader.TileMode.CLAMP)
+                paint.shader = sh
+                paint.style = Paint.Style.STROKE
+                paint.strokeWidth = 2.5f * dens
+                paint.alpha = alpha
+                canvas.drawPath(extraPath, paint)
+                extraPath.lineTo(w, base); extraPath.lineTo(0f, base); extraPath.close()
+                paint.style = Paint.Style.FILL
+                paint.alpha = alpha / 3
+                canvas.drawPath(extraPath, paint)
+                paint.shader = null
+            }
+            "blocks" -> {
+                val rows = 10
+                val bw = (slot * fill).coerceAtLeast(1f)
+                val cellH = maxH / rows
+                for (j in 0 until count) {
+                    val t = if (count > 1) j / (count - 1f) else 0f
+                    paint.color = col.at(t); paint.alpha = alpha
+                    val lit = (lv(j) * rows).toInt()
+                    val x = j * slot + (slot - bw) / 2f
+                    for (r in 0 until lit) {
+                        val top = if (pos == "top") r * cellH else base - (r + 1) * cellH
+                        canvas.drawRoundRect(RectF(x, top + cellH * 0.1f, x + bw, top + cellH * 0.9f), dens, dens, paint)
+                    }
+                }
+            }
+            "glow" -> {
+                val k = (0.25f + (bass * sens).coerceIn(0f, 1f) * 0.75f)
+                val gh = maxH * 0.8f * k
+                val c = col.at(0.5f)
+                val cc = AColor.argb(alpha, AColor.red(c), AColor.green(c), AColor.blue(c))
+                val c0 = AColor.argb(0, AColor.red(c), AColor.green(c), AColor.blue(c))
+                if (pos != "top") {
+                    paint.shader = android.graphics.LinearGradient(0f, h, 0f, h - gh, cc, c0, Shader.TileMode.CLAMP)
+                    canvas.drawRect(0f, h - gh, w, h, paint)
+                }
+                if (pos != "bottom") {
+                    paint.shader = android.graphics.LinearGradient(0f, 0f, 0f, gh, cc, c0, Shader.TileMode.CLAMP)
+                    canvas.drawRect(0f, 0f, w, gh, paint)
+                }
+                paint.shader = null
+            }
+            "orbit" -> {
+                val r0 = minOf(w, h) / 2f * p.getInt("viz_size", 60) / 100f * 0.6f
+                val posMode = p.getString("viz_cpos", "center") ?: "center"
+                val cx = if (posMode == "custom") w * p.getInt("viz_cx", 50) / 100f else w / 2f
+                val cy = if (posMode == "custom") h * p.getInt("viz_cy", 50) / 100f else h / 2f
+                val thick = p.getInt("viz_thick", 3) * dens
+                val spin = if (p.getBoolean("viz_spin", false)) (col.now % 3600000L) / 1000f * p.getInt("viz_spin_speed", 30) else 0f
+                val m = p.getBoolean("viz_mirror", true)
+                paint.style = Paint.Style.STROKE
+                paint.strokeWidth = dens
+                paint.color = col.at(0f); paint.alpha = alpha / 4
+                canvas.drawCircle(cx, cy, r0, paint)
+                paint.style = Paint.Style.FILL
+                for (j in 0 until count) {
+                    val t = j / count.toFloat()
+                    val l = (at(disp, (if (m) Math.abs(2f * t - 1f) else t) * (N - 1)) * sens).coerceIn(0f, 1f)
+                    val a = Math.toRadians((spin + 360.0 * t) - 90.0)
+                    val r = r0 * (1f + 0.9f * l)
+                    paint.color = col.at(1f - Math.abs(2f * t - 1f)); paint.alpha = alpha
+                    canvas.drawCircle(cx + (r * Math.cos(a)).toFloat(), cy + (r * Math.sin(a)).toFloat(), thick * (0.6f + l), paint)
+                }
+            }
+            "sparkle" -> {
+                val now = System.nanoTime()
+                val dt = if (sparkLast == 0L) 0.016f else ((now - sparkLast) / 1e9f).coerceIn(0.001f, 0.1f)
+                if (!noStep) sparkLast = now
+                var avg = 0f
+                for (i in 0 until N) avg += disp[i]
+                avg = (avg / N * sens).coerceIn(0f, 1f)
+                val spawn = ((bass * sens).coerceIn(0f, 1f) * 4f + avg * 3f)
+                var n = if (noStep) 0 else spawn.toInt() + (if (Math.random() < spawn - spawn.toInt()) 1 else 0)
+                while (n-- > 0 && sparks.size < count) {
+                    val t = Math.random().toFloat()
+                    sparks.add(Spark(t * w, base, (0.25f + Math.random().toFloat() * 0.6f) * maxH, 1f, (1.5f + Math.random().toFloat() * 2.5f) * dens, t))
+                }
+                val dir = if (pos == "top") 1f else -1f
+                val it = sparks.iterator()
+                while (it.hasNext()) {
+                    val sp = it.next()
+                    if (!noStep) {
+                        sp.y += dir * sp.vy * dt
+                        sp.life -= dt * 0.9f
+                        if (sp.life <= 0f) { it.remove(); continue }
+                    }
+                    paint.color = col.at(sp.t)
+                    paint.alpha = (alpha * sp.life).toInt().coerceIn(0, 255)
+                    canvas.drawCircle(sp.x, sp.y, sp.size * (0.5f + sp.life * 0.5f), paint)
+                }
+            }
+        }
+        paint.shader = null
+        paint.style = Paint.Style.FILL
+        return true
+    }
