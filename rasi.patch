+                                gradColors.removeAt(selected.coerceIn(0, gradColors.size - 1))
+                                selected = 0
+                                saveGradient(prefs, gradColors, angle)
+                            }) { Text(stringResource(R.string.rasi_gradient_remove)) }
+                        }
+                    }
+
+                    val sel = selected.coerceIn(0, gradColors.size - 1)
+                    HsvPicker(gradColors[sel], sel to gradColors.size) {
+                        gradColors[sel] = it
+                        saveGradient(prefs, gradColors, angle)
+                    }
+
+                    Text(stringResource(R.string.rasi_gradient_angle))
+                    LabeledSlider(
+                        label = "Angle", value = angle.coerceIn(0f, 360f), valueRange = 0f..360f,
+                        gradient = Brush.horizontalGradient(listOf(Color(0xFF555555), Color(0xFFBBBBBB))),
+                        onValueChange = {
+                            angle = it
+                            saveGradient(prefs, gradColors, it)
+                        }
+                    )
+                }
+            }
+        }
+    }
+}
+
+internal fun mutableStateListOfInts(list: List<Int>) =
+    androidx.compose.runtime.mutableStateListOf<Int>().also { it.addAll(list) }
+
+internal fun saveGradient(prefs: SharedPreferences, colors: List<Int>, angle: Float) {
+    prefs.edit().apply {
+        putInt("grad_count", colors.size)
+        colors.forEachIndexed { i, c -> putInt("grad_$i", c) }
+        putFloat("grad_angle", angle)
+    }.apply()
+}
