+/** Keyboard visual effects: cool visuals that do not need music. Off automatically in Performance mode. */
+@Composable
+fun RasiFxScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val base = remember { RasiNowPlaying.prefs(context) }
+    val prefs = remember { RasiFxPrefs.init(base); RasiFxPrefs.of(base) }
+
+    RasiScrollableWithKeyboardButton {
+        ScreenTitle("Keyboard visual effects", showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            RasiFxBody(base, prefs, false)
+        }
+    }
+}
+
+/**
+ * All options of a visual effect. With settings = true the same options control the effect behind the settings
+ * screens (base and prefs are then the same separate copy of the options).
+ */
+@Composable
+fun RasiFxBody(base: android.content.SharedPreferences, prefs: android.content.SharedPreferences, settings: Boolean, showToggle: Boolean = true) {
+    var style by remember { mutableStateOf(RasiFxPrefs.style(prefs)) }
+    var layer by remember { mutableStateOf(base.getString("fx_layer", "behind") ?: "behind") }
+    if (showToggle) RasiPrefSwitch(
+        base, "fx_on", if (settings) "Visual effect in the settings" else "Keyboard visual effects",
+        if (settings) "A moving effect behind the settings screens. It does not need music. Turned off automatically in Performance mode."
+        else "Cool visuals on the keyboard. They do not need music. Turned off automatically in Performance mode.", false
+    )
+    RasiSection("Effect")
+    RasiStylePreviewRows(prefs, RasiFxPrefs.STYLES, style) {
+        style = it; prefs.edit().putString("viz_style", it).apply(); RasiNowPlaying.notifyChanged()
+    }
+    RasiSection("Layer")
+    RasiOptionRows(
+        if (settings) listOf(
+            "behind" to "Under the settings visualizer (furthest back)",
+            "mid" to "Over the settings visualizer, under the settings content",
+            "over" to "Over the settings content (taps still go through)"
+        ) else listOf(
+            "behind" to "Under the keys, under the visualizer",
+            "mid" to "Under the keys, over the visualizer",
+            "over" to "Over the keys, under the visualizer (set the visualizer to over the keys too)",
+            "top" to "Over the keys and over the visualizer",
+            "both" to "Both (under and over the keys)"
+        ),
+        layer
+    ) { layer = it; base.edit().putString("fx_layer", it).apply(); RasiNowPlaying.notifyChanged() }
+
+    RasiSection("Look")
+    RasiPrefSlider(base, "fx_opacity", "Opacity (brightness of the effect)", " %", if (settings) 50 else 80, 10, 100)
+    RasiPrefSlider(base, "fx_size", "Size", " %", 100, 30, 300)
+    RasiPrefSlider(base, "fx_speed", "Speed", " %", 100, 10, 300)
+
+    RasiSection("Position and rotation")
+    RasiPrefSlider(base, "fx_x", "Move right (negative moves left)", " %", 0, -100, 100)
+    RasiPrefSlider(base, "fx_y", "Move up (negative moves down)", " %", 0, -100, 100)
+    RasiPrefSlider(base, "fx_rot", "Rotation", " deg", 0, -180, 180)
+    RasiPrefSlider(base, "fx_spin", "Spin (degrees per second, negative reverses)", "", 0, -90, 90)
+    RasiPrefSwitch(base, "fx_flip_h", "Flip horizontally", "Mirror the effect left to right.", false)
+    RasiPrefSwitch(base, "fx_flip_v", "Flip vertically", "Mirror the effect top to bottom.", false)
+
+    RasiColorSourceSection(prefs, "viz_")
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/settings/pages/RasiGeminiScreen.kt b/java/src/org/futo/inputmethod/latin/uix/settings/pages/RasiGeminiScreen.kt
