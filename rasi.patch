+@Composable
+private fun DrawerRow(text: String, enabled: Boolean = true, onClick: () -> Unit = {}) {
+    val pill = RasiUiStyle.press.value && enabled
+    val col = MaterialTheme.colorScheme.onSurface.copy(alpha = if (enabled) 1f else 0.5f)
+    if (!pill) {
+        Text(text, fontSize = 16.sp, color = col,
+            modifier = Modifier.fillMaxWidth().clickable(enabled = enabled) { onClick() }.padding(horizontal = 20.dp, vertical = 12.dp))
+        return
+    }
+    Row(Modifier.fillMaxWidth().padding(horizontal = 10.dp, vertical = 2.dp).clip(androidx.compose.foundation.shape.RoundedCornerShape(16.dp))
+        .background(MaterialTheme.colorScheme.onSurface.copy(alpha = 0.08f)).clickable { onClick() }.padding(horizontal = 14.dp, vertical = 10.dp),
+        verticalAlignment = Alignment.CenterVertically) {
+        Text(text, fontSize = 16.sp, color = col, modifier = Modifier.weight(1f))
+        Icon(androidx.compose.material.icons.Icons.Default.KeyboardArrowRight, contentDescription = null, tint = col)
+    }
+}
+
+@Composable
+private fun DrawerHeader(text: String) {
+    if (RasiUiStyle.cards.value) { RasiSection(text, Modifier.padding(horizontal = 12.dp, vertical = 4.dp)); return }
+    Text(text, fontSize = 18.sp, fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.primary,
+        modifier = Modifier.padding(start = 20.dp, end = 20.dp, top = 16.dp, bottom = 4.dp))
+}
+
+/** The line under my name: the playing song on a colored pill (or View profile when switched off). */
+@OptIn(androidx.compose.foundation.ExperimentalFoundationApi::class)
+@Composable
+private fun DrawerSongLine(p: SharedPreferences, signedIn: Boolean, perf: Boolean) {
+    val ctx = LocalContext.current
+    val tick = org.futo.inputmethod.latin.rasi.rememberNowPlayingTick()
+    val t = remember(tick) { org.futo.inputmethod.latin.rasi.RasiNowPlaying.track }
+    if (!signedIn) { Text("Sign in", fontSize = 14.sp); return }
+    if (!p.getBoolean("dr_song_on", true)) { Text("View profile", fontSize = 14.sp); return }
+    val dim = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.6f)
+    if (t == null) {
+        if (p.getBoolean("dr_song_idle", true)) Text("Nothing playing", fontSize = 14.sp, color = dim)
+        return
+    }
+    val dark = MaterialTheme.colorScheme.background.luminance() < 0.5f
+    val blobs = org.futo.inputmethod.latin.rasi.RasiSettingsAmbience.blobColors(ctx, dark, tick)
+    val fallback = MaterialTheme.colorScheme.primaryContainer
+    val own1 = Color(RASI_SWATCHES[p.getInt("dr_song_own", 0).coerceIn(0, RASI_SWATCHES.size - 1)])
+    val own2 = Color(RASI_SWATCHES[p.getInt("dr_song_own2", 2).coerceIn(0, RASI_SWATCHES.size - 1)])
+    val colors: List<Color> = when (p.getInt("dr_song_color", 0).coerceIn(0, 3)) {
+        0 -> if (blobs != null) listOf(blobs.first, blobs.second) else listOf(fallback, fallback)
+        1 -> listOf(own1, own1)
+        2 -> if (blobs != null) listOf(blobs.first, blobs.first) else listOf(fallback, fallback)
+        else -> listOf(own1, own2)
+    }
+    val lum = (colors[0].luminance() + colors[1].luminance()) / 2f
+    val textCol = if (lum > 0.45f) Color(0xFF111111) else Color.White
+    val label = t.title + (if (t.artist.isNotBlank()) " - " + t.artist else "")
