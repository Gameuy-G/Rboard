+import androidx.compose.ui.res.painterResource
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.delay
+import org.futo.inputmethod.latin.uix.actions.FavoriteActions
+import org.futo.inputmethod.latin.uix.actions.toActionList
+import org.futo.inputmethod.latin.uix.settings.useDataStoreValue
+
+const val RASI_TOP_MAX_ACTIONS = 6
+
+/** True while the text field is completely empty (Gboard shows the action row then). */
+@Composable
+fun rememberFieldEmpty(manager: KeyboardManagerForAction?): State<Boolean> {
+    val state = remember { mutableStateOf(false) }
+    LaunchedEffect(manager) {
+        var emptyStreak = 0
+        while (true) {
+            val ime = manager?.getLatinIMEForDebug()
+            val empty = try {
+                val ic = ime?.currentInputConnection
+                ime != null && !ime.isInputConnectionOverridden && ic != null &&
+                        ic.getTextBeforeCursor(1, 0).isNullOrEmpty() &&
+                        ic.getTextAfterCursor(1, 0).isNullOrEmpty()
+            } catch (e: Exception) {
+                false
+            }
+            // Only report "empty" after it stays empty for a moment, so a transient empty read
+            // (app switch, screenshot, text being replaced) never flashes the icon row.
+            if (empty) emptyStreak++ else emptyStreak = 0
+            val stable = empty && emptyStreak >= 3
+            if (state.value != stable) state.value = stable
+            delay(100)
+        }
+    }
+    return state
+}
+
+/** Your favourite actions in the suggestion bar while the field is empty. */
+@Composable
+fun RowScope.RasiEmptyFieldActions(onSelect: (Action) -> Unit) {
+    val favs = useDataStoreValue(FavoriteActions)
+    val list = remember(favs) {
+        favs.toActionList().toSet().toList().take(RASI_TOP_MAX_ACTIONS)
+    }
+    list.forEach { action ->
+        Box(
+            Modifier
+                .weight(1.0f)
+                .fillMaxHeight()
+                .clip(CircleShape)
+                .clickable { onSelect(action) },
+            contentAlignment = Alignment.Center
+        ) {
+            Icon(
+                painter = painterResource(id = action.icon),
+                contentDescription = stringResource(action.name),
+                tint = LocalKeyboardScheme.current.onBackground,
+                modifier = Modifier.size(24.dp)
+            )
+        }
+    }
+}
