+/** The song gradient, cover and visualizer behind the settings menu, on their own page. */
+@Composable
+fun RasiSettingsAmbienceScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiNowPlaying.prefs(context) }
+
+    @Composable
+    fun SwitchRow(title: String, hint: String, checked: Boolean, onChange: (Boolean) -> Unit) {
+        if (org.futo.inputmethod.latin.uix.settings.rasiRowHidden(title, hint)) return
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+            Column(Modifier.weight(1.0f)) {
+                Text(org.futo.inputmethod.latin.uix.settings.rasiHL(title))
+                Text(org.futo.inputmethod.latin.uix.settings.rasiHL(hint), style = MaterialTheme.typography.bodySmall)
+            }
+            Switch(checked = checked, onCheckedChange = onChange)
+        }
+    }
+
+    RasiScrollableWithKeyboardButton {
+        ScreenTitle("Settings ambience", showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            var setCover by remember { mutableStateOf(prefs.getBoolean("set_cover", true)) }
+            var setGrad by remember { mutableStateOf(prefs.getBoolean("set_gradient", true)) }
+            var setViz by remember { mutableStateOf(prefs.getBoolean("set_viz", true)) }
+            SwitchRow("Cover in the settings", "The blurred cover is the background of the settings menu while music plays.", setCover) {
+                setCover = it; prefs.edit().putBoolean("set_cover", it).apply(); RasiNowPlaying.notifyChanged()
+            }
+            SwitchRow("Song colors in the settings", "The settings background uses the cover colors as a gradient.", setGrad) {
+                setGrad = it; prefs.edit().putBoolean("set_gradient", it).apply(); RasiNowPlaying.notifyChanged()
+            }
+            SwitchRow("Visualizer in the settings", "The music visualizer moves behind the settings menu. Uses its own style below.", setViz) {
+                setViz = it; prefs.edit().putBoolean("set_viz", it).apply(); RasiNowPlaying.notifyChanged()
+            }
+
+            Text("Settings visualizer style", style = MaterialTheme.typography.titleMedium)
+            Text("Its own style, colors and size, separate from the keyboard.", style = MaterialTheme.typography.bodySmall)
+            RasiVizStyleSettings(org.futo.inputmethod.latin.rasi.RasiVizPrefs.settings(prefs), ambient = true)
+
+            // ---- border glow behind the settings (own copy of every glow option) ----
+            val glowPrefs = remember { org.futo.inputmethod.latin.rasi.RasiGlowPrefs.settings(prefs) }
+            Text("Border glow in the settings", style = MaterialTheme.typography.titleMedium)
+            Text("A colored glow along the edges of the whole screen. It has its own options, separate from the keyboard glow, and never blocks taps.", style = MaterialTheme.typography.bodySmall)
+            RasiPrefSwitch(glowPrefs, "gl_on", "Border glow in the settings", "Turns the glow behind the settings on or off. Turned off automatically in Performance mode.", false)
+            var glowOpen by remember { mutableStateOf(false) }
+            Row(Modifier.fillMaxWidth().clickable { glowOpen = !glowOpen }) {
+                Column(Modifier.weight(1.0f)) {
+                    RasiSection("Glow options")
+                    Text(if (glowOpen) "Tap to close" else "Tap for sides, size, strength, shape, colors, beat reaction and layer", style = MaterialTheme.typography.bodySmall)
+                }
+            }
+            if (glowOpen) RasiGlowBody(glowPrefs, true, showToggle = false)
+
+            // ---- visual effect behind the settings (own copy of every effect option) ----
+            val fxPrefs = remember { org.futo.inputmethod.latin.rasi.RasiFxPrefs.settingsOf(prefs) }
+            Text("Visual effect in the settings", style = MaterialTheme.typography.titleMedium)
+            Text("The keyboard visual effects (fireflies, galaxy, matrix rain and more) behind the settings. Own style, speed, size, colors and layer.", style = MaterialTheme.typography.bodySmall)
+            RasiPrefSwitch(fxPrefs, "fx_on", "Visual effect in the settings", "A moving effect behind the settings screens. It does not need music. Turned off automatically in Performance mode.", false)
+            var fxOpen by remember { mutableStateOf(false) }
+            Row(Modifier.fillMaxWidth().clickable { fxOpen = !fxOpen }) {
+                Column(Modifier.weight(1.0f)) {
+                    RasiSection("Effect options")
+                    Text(if (fxOpen) "Tap to close" else "Tap for the style, opacity, size, speed, position, colors and layer", style = MaterialTheme.typography.bodySmall)
+                }
+            }
+            if (fxOpen) RasiFxBody(fxPrefs, fxPrefs, true, showToggle = false)
+        }
+    }
+}
