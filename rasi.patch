@@ -0,0 +1,22 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.SharedPreferences
+
+/**
+ * What the music effects read. While the master switch ("music_master") is off, the effect switches
+ * look off here, but nothing is changed in the saved settings, so turning it back on restores everything.
+ */
+class RasiMasterPrefs(val base: SharedPreferences) : SharedPreferences by base {
+    companion object {
+        val gated = setOf(
+            "mode_viz", "mode_bg", "mode_dyn", "keys_follow",
+            "glass_all", "glass_bg", "glass_dyn", "glass_viz",
+            "set_viz", "set_cover", "set_gradient"
+        )
+    }
+
+    override fun getBoolean(key: String?, defValue: Boolean): Boolean {
+        if (key != null && key in gated && !base.getBoolean("music_master", true)) return false
+        return base.getBoolean(key, defValue)
+    }
+}
