+/**
+ * Finds what is playing. Rebuilt to be robust: it combines (1) the active media sessions and
+ * (2) the media notifications of music apps, and re-checks every few seconds, so a missed callback
+ * can never leave the detection stuck.
+ */
+class RasiNowPlayingService : NotificationListenerService() {
+    private var sm: MediaSessionManager? = null
+    private val comp by lazy { ComponentName(this, RasiNowPlayingService::class.java) }
+    private val main = Handler(Looper.getMainLooper())
+    private var overlay: RasiNowPlayingOverlay? = null
+    private var polling = false
+
+    // controllers we watch, by session token
+    private val watched = HashMap<android.media.session.MediaSession.Token, Pair<MediaController, MediaController.Callback>>()
+    // controllers built from media notifications, by package
+    private val fromNotifs = HashMap<String, MediaController>()
+
+    private val sessionsListener = MediaSessionManager.OnActiveSessionsChangedListener { refresh() }
+    private val prefListener = SharedPreferences.OnSharedPreferenceChangeListener { _, key ->
+        if (key == "only_music" || (key != null && key.startsWith("app_"))) refresh()
+        else overlay?.refresh(RasiNowPlaying.track)
+    }
+    // the master switch and the music toggle action call notifyChanged(): hide or show the pill at once
+    private val pillHook: () -> Unit = { overlay?.refresh(RasiNowPlaying.track) }
+    private val pollTick = object : Runnable {
+        override fun run() {
+            if (!polling) return
+            refresh()
+            overlay?.refresh(RasiNowPlaying.track)
+            main.postDelayed(this, 3000L)
+        }
+    }
+
+    private var sessionReceiverOn = false
+    private val sessionReceiver = object : BroadcastReceiver() {
+        override fun onReceive(c: Context?, i: Intent?) {
+            val intent = i ?: return
+            val pkg = intent.getStringExtra("android.media.extra.PACKAGE_NAME") ?: return
+            if (intent.action == "android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION") {
+                val sid = intent.getIntExtra("android.media.extra.AUDIO_SESSION", -1)
+                if (sid > 0) RasiNowPlaying.sessions[pkg] = sid
+            } else {
+                RasiNowPlaying.sessions.remove(pkg)
+            }
+        }
+    }
+
+    override fun onListenerConnected() {
+        super.onListenerConnected()
+        try { RasiFriendAlerts.ensure(applicationContext) } catch (t: Throwable) { }
+        RasiNowPlaying.connected = true
+        if (!sessionReceiverOn) {
+            try {
+                val f = IntentFilter()
+                f.addAction("android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION")
+                f.addAction("android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION")
+                if (android.os.Build.VERSION.SDK_INT >= 33) registerReceiver(sessionReceiver, f, Context.RECEIVER_EXPORTED)
+                else registerReceiver(sessionReceiver, f)
+                sessionReceiverOn = true
+            } catch (e: Throwable) { e.printStackTrace() }
+        }
+        try {
+            val m = getSystemService(MEDIA_SESSION_SERVICE) as MediaSessionManager
+            sm = m
+            m.addOnActiveSessionsChangedListener(sessionsListener, comp, main)
+        } catch (e: Throwable) { RasiNowPlaying.debug = "cannot listen to sessions: $e" }
+        if (overlay == null) overlay = RasiNowPlayingOverlay(applicationContext)
+        RasiNowPlaying.prefs(this).registerOnSharedPreferenceChangeListener(prefListener)
+        RasiNowPlaying.listeners.remove(pillHook)
+        RasiNowPlaying.listeners.add(pillHook)
+        // media notifications that are already showing
+        try {
+            for (sbn in activeNotifications ?: emptyArray()) takeNotification(sbn)
+        } catch (e: Throwable) { }
+        polling = true
+        main.removeCallbacks(pollTick)
+        main.post(pollTick)
+    }
+
+    override fun onListenerDisconnected() {
+        RasiNowPlaying.connected = false
+        release()
+        super.onListenerDisconnected()
+    }
+
+    override fun onDestroy() {
+        RasiNowPlaying.connected = false
+        release()
+        super.onDestroy()
+    }
+
+    override fun onNotificationPosted(sbn: android.service.notification.StatusBarNotification?) {
+        if (sbn != null && takeNotification(sbn)) refresh()
+    }
+
+    override fun onNotificationRemoved(sbn: android.service.notification.StatusBarNotification?) {
+        if (sbn != null && fromNotifs.remove(sbn.packageName) != null) refresh()
+    }
+
+    /** A media notification carries its session token, a second way to find the player. */
+    private fun takeNotification(sbn: android.service.notification.StatusBarNotification): Boolean {
+        return try {
+            val tok = sbn.notification.extras.getParcelable<android.media.session.MediaSession.Token>(
+                android.app.Notification.EXTRA_MEDIA_SESSION
+            ) ?: return false
+            fromNotifs[sbn.packageName] = MediaController(applicationContext, tok)
+            true
+        } catch (e: Throwable) { false }
+    }
+
+    private fun release() {
+        polling = false
+        main.removeCallbacks(pollTick)
+        if (sessionReceiverOn) { try { unregisterReceiver(sessionReceiver) } catch (e: Throwable) { }; sessionReceiverOn = false }
+        try { sm?.removeOnActiveSessionsChangedListener(sessionsListener) } catch (e: Throwable) { }
+        for ((_, v) in watched) try { v.first.unregisterCallback(v.second) } catch (e: Throwable) { }
+        watched.clear()
+        fromNotifs.clear()
+        try { RasiNowPlaying.prefs(this).unregisterOnSharedPreferenceChangeListener(prefListener) } catch (e: Throwable) { }
+        RasiNowPlaying.listeners.remove(pillHook)
+        overlay?.hide()
+        overlay = null
+        RasiNowPlaying.track = null
+        RasiNowPlaying.notifyChanged()
+    }
+
+    private fun refresh() {
+        try {
+            val all = ArrayList<MediaController>()
+            try { sm?.getActiveSessions(comp)?.let { all.addAll(it) } }
+            catch (e: Throwable) { RasiNowPlaying.debug = "cannot read sessions: $e" }
+            for ((pkg, c) in fromNotifs) {
+                if (all.none { it.sessionToken == c.sessionToken }) all.add(c)
+            }
+            // watch changes of every controller we know
+            val tokens = all.map { it.sessionToken }.toSet()
+            val gone = watched.keys.filter { it !in tokens }
+            for (k in gone) { try { watched[k]?.first?.unregisterCallback(watched[k]!!.second) } catch (e: Throwable) { }; watched.remove(k) }
+            for (c in all) {
+                if (watched.containsKey(c.sessionToken)) continue
+                val cb = object : MediaController.Callback() {
+                    override fun onMetadataChanged(metadata: MediaMetadata?) = refresh()
+                    override fun onPlaybackStateChanged(state: PlaybackState?) = refresh()
+                    override fun onSessionDestroyed() = refresh()
+                }
+                try { c.registerCallback(cb, main); watched[c.sessionToken] = Pair(c, cb) } catch (e: Throwable) { }
+            }
+            RasiNowPlaying.controllers = all.toList()
+            decide(all)
+        } catch (e: Throwable) {
+            RasiNowPlaying.debug = "detection error: $e"
+        }
+    }
+
+    private fun decide(list: List<MediaController>) {
+        for (x in list) {
+            if (x.playbackState?.state == PlaybackState.STATE_PLAYING || x.metadata?.getString(MediaMetadata.METADATA_KEY_TITLE) != null)
+                RasiNowPlaying.noteSeen(applicationContext, x.packageName ?: "")
+        }
+        // only apps that are switched on in Music apps (video apps are off by default)
+        val allowed = list.filter { RasiNowPlaying.isAllowed(applicationContext, it.packageName ?: "") }
+        RasiNowPlaying.debug = "sessions: " + (if (list.isEmpty()) "none" else list.joinToString(", ") {
+            (it.packageName ?: "?") + " state " + (it.playbackState?.state ?: -1) +
+                (if (it.metadata?.getString(MediaMetadata.METADATA_KEY_TITLE) == null) " no title" else "")
+        }) + "; allowed: " + allowed.size + " (3 = playing, 2 = paused)"
+        val playing = allowed.firstOrNull { it.playbackState?.state == PlaybackState.STATE_PLAYING }
+        val c = playing ?: allowed.firstOrNull { it.metadata?.getString(MediaMetadata.METADATA_KEY_TITLE) != null }
+        val md = c?.metadata
+        val ps = c?.playbackState
+        RasiNowPlaying.activeCtl = c
+        if (ps != null && ps.position >= 0L) {
+            RasiNowPlaying.posMs = ps.position
+            RasiNowPlaying.posAt = ps.lastPositionUpdateTime
+            RasiNowPlaying.posSpeed = if (ps.playbackSpeed > 0f) ps.playbackSpeed else 1f
+        } else RasiNowPlaying.posMs = -1L
+        RasiNowPlaying.durMs = md?.getLong(MediaMetadata.METADATA_KEY_DURATION)?.takeIf { it > 0L } ?: -1L
+        val title = md?.getString(MediaMetadata.METADATA_KEY_DISPLAY_TITLE)
+            ?: md?.getString(MediaMetadata.METADATA_KEY_TITLE)
+        val old = RasiNowPlaying.track
+        try { RasiStats.onTrack(applicationContext, title, md?.getString(MediaMetadata.METADATA_KEY_ARTIST) ?: md?.getString(MediaMetadata.METADATA_KEY_ALBUM_ARTIST) ?: "", playing != null && c != null) } catch (t: Throwable) { RasiLog.fallback("RasiStats", "Listening time not counted: " + t.javaClass.simpleName) }
+        val next = if (c == null || md == null || title.isNullOrBlank()) null else {
+            val artist = md.getString(MediaMetadata.METADATA_KEY_ARTIST)
+                ?: md.getString(MediaMetadata.METADATA_KEY_ALBUM_ARTIST)
+                ?: md.getString(MediaMetadata.METADATA_KEY_DISPLAY_SUBTITLE) ?: ""
+            val art = md.getBitmap(MediaMetadata.METADATA_KEY_ALBUM_ART)
+                ?: md.getBitmap(MediaMetadata.METADATA_KEY_ART)
+                ?: md.getBitmap(MediaMetadata.METADATA_KEY_DISPLAY_ICON)
+            RasiNowPlaying.Track(title, artist, art, playing != null, c.packageName ?: "")
+        }
+        // the 3 second re-check must not redraw everything when nothing changed
+        val same = old != null && next != null && old.title == next.title && old.artist == next.artist &&
+            old.playing == next.playing && old.pkg == next.pkg && (old.art != null) == (next.art != null)
+        RasiNowPlaying.track = next
+        if (!same || (old == null) != (next == null)) {
+            try { RasiSongLooks.onTrack(applicationContext, next) } catch (t: Throwable) {}
+            overlay?.refresh(next)
+            RasiNowPlaying.notifyChanged()
+            try { RasiLive.onTrack(applicationContext, next) } catch (t: Throwable) {}
+            try { RasiRooms.onTrack(applicationContext, next) } catch (t: Throwable) {}
+        }
+    }
+}
+
+/** The floating pill: a spinning round album cover and "Now playing: title". Draggable. */
+class RasiNowPlayingOverlay(private val ctx: Context) {
+    private val wm = ctx.getSystemService(Context.WINDOW_SERVICE) as WindowManager
+    private val prefs = RasiNowPlaying.prefs(ctx)
+    private var root: FrameLayout? = null
+    private var cover: ImageView? = null
+    private var label: TextView? = null
+    private var spin: ObjectAnimator? = null
+    private var lp: WindowManager.LayoutParams? = null
+    private var builtKey = ""
+
+    private fun dp(v: Float) = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, ctx.resources.displayMetrics)
+
+    fun refresh(t: RasiNowPlaying.Track?) {
+        val on = prefs.getBoolean("overlay_on", false) && RasiNowPlaying.masterOn(ctx)
+        if (!on || t == null || !t.playing || !RasiNowPlaying.canOverlay(ctx)) {
+            hide()
+            return
+        }
+        val size = prefs.getInt("ov_size", 40)
+        val key = size.toString() + "|" + prefs.getBoolean("pill_viz", false) + "|" +
+            prefs.getString("pill_viz_place", "text") + "|" + prefs.getBoolean("pill_viz_rotate", true) + "|" +
+            prefs.getBoolean("ov_text", true)
+        if (root == null || builtKey != key) {
+            hide()
+            build(size, key)
+        }
+        val r = root ?: return
+        cover?.setImageBitmap(t.art)
+        label?.text = "Now playing: " + t.title + if (t.artist.isNotBlank()) " - " + t.artist else ""
+        label?.visibility = if (prefs.getBoolean("ov_text", true)) View.VISIBLE else View.GONE
+        r.alpha = prefs.getInt("ov_opacity", 90) / 100f
+        if (spin?.isStarted == true) spin?.resume() else spin?.start()
+        if (r.parent == null) {
+            try { wm.addView(r, lp) } catch (e: Throwable) { e.printStackTrace() }
+            place(r)
+        } else {
+            try { wm.updateViewLayout(r, lp) } catch (e: Throwable) { }
+        }
+    }
+
+    fun hide() {
+        spin?.cancel()
+        spin = null
+        val r = root
+        if (r != null && r.parent != null) try { wm.removeView(r) } catch (e: Throwable) { }
+        root = null
+        cover = null
+        label = null
+        builtKey = ""
+    }
+
+    private fun screenW() = ctx.resources.displayMetrics.widthPixels
+    private fun screenH() = ctx.resources.displayMetrics.heightPixels
+
+    /** Puts the pill at its saved spot, or at the start side chosen in settings. */
+    private fun place(r: View) {
+        val l = lp ?: return
+        r.post {
+            val sx = prefs.getInt("ov_x", -1)
+            val sy = prefs.getInt("ov_y", -1)
+            if (sx >= 0 && sy >= 0) {
+                l.x = sx.coerceIn(0, (screenW() - r.width).coerceAtLeast(0))
+                l.y = sy.coerceIn(0, (screenH() - r.height).coerceAtLeast(0))
+            } else {
+                val margin = dp(8f).toInt()
+                l.x = if (prefs.getBoolean("ov_right", true)) (screenW() - r.width - margin).coerceAtLeast(0) else margin
+                l.y = dp(80f).toInt()
+            }
+            try { wm.updateViewLayout(r, l) } catch (e: Throwable) { }
+        }
+    }
+
+    private fun build(sizeDp: Int, key: String) {
+        builtKey = key
+        val px = dp(sizeDp.toFloat()).toInt()
+        val pad = dp(6f).toInt()
+
+        val img = ImageView(ctx).apply {
+            scaleType = ImageView.ScaleType.CENTER_CROP
+            outlineProvider = object : ViewOutlineProvider() {
+                override fun getOutline(view: View, outline: android.graphics.Outline) {
+                    outline.setOval(0, 0, view.width, view.height)
+                }
+            }
+            clipToOutline = true
+            // round shape, so the cover rotates like a record
+            val oval = GradientDrawable().apply { shape = GradientDrawable.OVAL; setColor(Color.DKGRAY) }
+            background = oval
+        }
+        val hole = View(ctx).apply {
+            background = GradientDrawable().apply { shape = GradientDrawable.OVAL; setColor(0xFF111111.toInt()) }
+        }
+        val holeSize = (px / 5).coerceAtLeast(4)
+        val vizOn = prefs.getBoolean("pill_viz", false)
+        val place = prefs.getString("pill_viz_place", "text") ?: "text"
+        val rotate = prefs.getBoolean("pill_viz_rotate", true)
+        val showText = prefs.getBoolean("ov_text", true)
+        fun newViz() = RasiPillVizView(ctx)
+        val disc = FrameLayout(ctx).apply {
+            addView(img, FrameLayout.LayoutParams(px, px))
+            if (vizOn && place == "cover" && rotate) addView(newViz(), FrameLayout.LayoutParams(px, px))
+            addView(hole, FrameLayout.LayoutParams(holeSize, holeSize, Gravity.CENTER))
+        }
+        val coverWrap = FrameLayout(ctx).apply {
+            addView(disc, FrameLayout.LayoutParams(px, px))
+            if (vizOn && place == "cover" && !rotate) addView(newViz(), FrameLayout.LayoutParams(px, px))
+        }
+        val txt = TextView(ctx).apply {
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            maxLines = 2
+            maxWidth = dp(220f).toInt()
+            setPadding(pad, 0, pad, 0)
+        }
+        val content = LinearLayout(ctx).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(pad, pad, pad, pad)
+            addView(coverWrap, LinearLayout.LayoutParams(px, px))
+            addView(txt, LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, LinearLayout.LayoutParams.WRAP_CONTENT))
+            if (vizOn && place == "text" && showText) {
+                addView(newViz(), LinearLayout.LayoutParams((px * 1.3f).toInt(), (px * 0.7f).toInt()).apply { rightMargin = pad })
+            }
+        }
+        val box = FrameLayout(ctx).apply {
+            background = GradientDrawable().apply {
+                cornerRadius = dp(40f)
+                setColor(0xCC1E1E1E.toInt())
+                setStroke(dp(1f).toInt(), 0x55FFFFFF)
+            }
+            outlineProvider = object : ViewOutlineProvider() {
+                override fun getOutline(view: View, outline: android.graphics.Outline) {
+                    outline.setRoundRect(0, 0, view.width, view.height, minOf(dp(40f), view.height / 2f))
+                }
+            }
+            clipToOutline = true
+            if (vizOn && place == "bg") {
+                addView(newViz(), FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
+            }
+            addView(content, FrameLayout.LayoutParams(FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.WRAP_CONTENT))
+        }
+
+        spin = ObjectAnimator.ofFloat(disc, View.ROTATION, 0f, 360f).apply {
+            duration = 9000
+            repeatCount = ObjectAnimator.INFINITE
+            interpolator = LinearInterpolator()
+        }
+
+        val params = WindowManager.LayoutParams(
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
+            PixelFormat.TRANSLUCENT
+        )
+        params.gravity = Gravity.TOP or Gravity.START
+        lp = params
+
+        // drag to move, the spot is saved when you let go
+        var downX = 0f; var downY = 0f; var startX = 0; var startY = 0
+        box.setOnTouchListener { v, e ->
+            val l = lp ?: return@setOnTouchListener false
+            when (e.action) {
+                MotionEvent.ACTION_DOWN -> { downX = e.rawX; downY = e.rawY; startX = l.x; startY = l.y; true }
+                MotionEvent.ACTION_MOVE -> {
+                    l.x = (startX + (e.rawX - downX)).toInt().coerceIn(0, (screenW() - v.width).coerceAtLeast(0))
+                    l.y = (startY + (e.rawY - downY)).toInt().coerceIn(0, (screenH() - v.height).coerceAtLeast(0))
+                    try { wm.updateViewLayout(v, l) } catch (ex: Throwable) { }
+                    true
+                }
+                MotionEvent.ACTION_UP -> {
+                    prefs.edit().putInt("ov_x", l.x).putInt("ov_y", l.y).apply()
+                    true
+                }
+                else -> false
+            }
+        }
+
+        root = box
+        cover = img
+        label = txt
+    }
+}
+
+/** Small visualizer inside the floating pill (bars or a ring of bars). Uses the pill_viz_ options. */
+class RasiPillVizView(c: Context) : View(c) {
+    init { tag = "rasi_pill_viz" }
+    override fun onDraw(canvas: android.graphics.Canvas) {
+        RasiNowPlayingViz.drawPill(this, canvas)
+    }
+}
