+/** One chat message: true = from the person, false = from Gemini. */
+private class GeminiMsg(val mine: Boolean, val text: String, val images: List<String> = emptyList())
+
+/** What Gemini answered: text and any pictures it made. */
+private class GeminiReply(val text: String, val images: List<Pair<String, ByteArray>>)
+
+/** A saved conversation, shown as a tab. */
+private class GeminiChat(val id: Long, title: String, val msgs: androidx.compose.runtime.snapshots.SnapshotStateList<GeminiMsg>, pinned: Boolean = false) {
+    val title = mutableStateOf(title)
+    val pinned = mutableStateOf(pinned)
+}
+
+private object GeminiChats {
+    private fun prefs(c: Context) = c.applicationContext.getSharedPreferences("rasi_gemini", Context.MODE_PRIVATE)
+
+    fun load(c: Context): List<GeminiChat> {
+        val out = ArrayList<GeminiChat>()
+        try {
+            val arr = JSONArray(prefs(c).getString("chats", "[]"))
+            for (i in 0 until arr.length()) {
+                val o = arr.getJSONObject(i)
+                val list = androidx.compose.runtime.mutableStateListOf<GeminiMsg>()
+                val ms = o.getJSONArray("m")
+                for (j in 0 until ms.length()) {
+                    val m = ms.getJSONObject(j)
+                    val imgs = ArrayList<String>()
+                    val ia = m.optJSONArray("i")
+                    if (ia != null) for (k in 0 until ia.length()) imgs.add(ia.getString(k))
+                    list.add(GeminiMsg(m.getBoolean("u"), m.getString("t"), imgs))
+                }
+                out.add(GeminiChat(o.getLong("id"), o.getString("title"), list, o.optBoolean("p", false)))
+            }
+        } catch (e: Exception) { }
+        return out
+    }
+
+    fun save(c: Context, chats: List<GeminiChat>) {
+        try {
+            val arr = JSONArray()
+            for (ch in chats.filter { it.pinned.value } + chats.filter { !it.pinned.value }.takeLast(30)) {
+                val ms = JSONArray()
+                for (m in ch.msgs.toList().takeLast(200)) {
+                    ms.put(JSONObject().put("u", m.mine).put("t", m.text).put("i", JSONArray(m.images)))
+                }
+                arr.put(JSONObject().put("id", ch.id).put("title", ch.title.value).put("p", ch.pinned.value).put("m", ms))
+            }
+            prefs(c).edit().putString("chats", arr.toString()).apply()
+            val keep = HashSet<String>()
+            for (ch in chats) for (m in ch.msgs.toList()) keep.addAll(m.images)
+            RasiGeminiImages.cleanup(c, keep)
+        } catch (e: Exception) { }
+    }
+}
+
+private fun askGemini(
+    context: Context, key: String, model: String, persona: String, history: List<GeminiMsg>, image: Boolean
+): GeminiReply {
+    val useModel = if (image) RasiGeminiStore.imageModel(key) else model
+    val hasVideo = history.any { m -> m.images.any { RasiGeminiImages.isVideo(it) } }
+    // only the newest few pictures are sent, to keep the request small
+    val allowed = HashSet<String>()
+    var n = 0
+    var videos = 0
+    for (m in history.asReversed()) for (f in m.images.asReversed()) {
+        if (n >= 4) continue
+        if (RasiGeminiImages.isVideo(f)) {
+            if (videos >= 1) continue
+            videos++
+        }
+        allowed.add(f)
+        n++
+    }
+    val contents = JSONArray()
+    for (m in history) {
+        val parts = JSONArray()
+        if (m.text.isNotBlank()) parts.put(JSONObject().put("text", m.text))
+        if (m.mine || image) {
+            for (f in m.images) {
+                if (f !in allowed) continue
+                val file = RasiGeminiImages.file(context, f)
+                if (!file.exists()) continue
+                if (RasiGeminiImages.isVideo(f)) {
+                    val mime = RasiGeminiImages.mimeOf(f)
+                    if (file.length() <= RasiGeminiImages.INLINE_VIDEO_MAX) {
+                        parts.put(
+                            JSONObject().put(
+                                "inlineData",
+                                JSONObject().put("mimeType", mime)
+                                    .put("data", android.util.Base64.encodeToString(file.readBytes(), android.util.Base64.NO_WRAP))
+                            )
+                        )
+                    } else {
+                        val uri = RasiGeminiFiles.upload(context, key, file, mime)
+                        parts.put(JSONObject().put("fileData", JSONObject().put("mimeType", mime).put("fileUri", uri)))
+                    }
+                    continue
+                }
+                parts.put(
+                    JSONObject().put(
+                        "inlineData",
+                        JSONObject().put("mimeType", RasiGeminiImages.mimeOf(f))
+                            .put("data", android.util.Base64.encodeToString(file.readBytes(), android.util.Base64.NO_WRAP))
+                    )
+                )
+            }
+        }
+        if (parts.length() == 0) parts.put(JSONObject().put("text", if (m.images.isNotEmpty()) "[picture or video]" else " "))
+        contents.put(JSONObject().put("role", if (m.mine) "user" else "model").put("parts", parts))
+    }
+    val bodyObj = JSONObject().put("contents", contents)
+    if (image) {
+        bodyObj.put(
+            "generationConfig",
+            JSONObject().put("responseModalities", JSONArray().put("TEXT").put("IMAGE"))
+        )
+    } else if (persona.isNotBlank()) {
+        bodyObj.put(
+            "systemInstruction",
+            JSONObject().put("parts", JSONArray().put(JSONObject().put("text", persona)))
+        )
+    }
+    val body = bodyObj.toString()
+    val conn = URL("https://generativelanguage.googleapis.com/v1beta/models/$useModel:generateContent")
+        .openConnection() as HttpURLConnection
+    try {
+        conn.requestMethod = "POST"
+        conn.connectTimeout = 15000
+        conn.readTimeout = if (image) 110000 else if (hasVideo) 150000 else 45000
+        conn.useCaches = false
+        conn.doOutput = true
+        conn.setRequestProperty("Content-Type", "application/json")
+        conn.setRequestProperty("x-goog-api-key", key)
+        conn.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+        val code = conn.responseCode
+        val stream = if (code in 200..299) conn.inputStream else conn.errorStream
+        val text = stream?.bufferedReader()?.use { it.readText() } ?: ""
+        if (code !in 200..299) {
+            val msg = try {
+                JSONObject(text).getJSONObject("error").getString("message")
+            } catch (e: Exception) {
+                text.take(200)
+            }
+            throw RuntimeException("Error $code: $msg")
+        }
+        val cands = JSONObject(text).optJSONArray("candidates")
+        if (cands == null || cands.length() == 0) {
+            throw RuntimeException("Gemini returned no answer: " + text.take(150))
+        }
+        val parts = cands.getJSONObject(0).optJSONObject("content")?.optJSONArray("parts")
+            ?: throw RuntimeException("Gemini returned an empty answer (it may have been blocked)")
+        val sb = StringBuilder()
+        val imgs = ArrayList<Pair<String, ByteArray>>()
+        for (i in 0 until parts.length()) {
+            val part = parts.getJSONObject(i)
+            sb.append(part.optString("text", ""))
+            val inl = part.optJSONObject("inlineData") ?: part.optJSONObject("inline_data")
+            if (inl != null) {
+                val data = inl.optString("data", "")
+                if (data.isNotEmpty()) {
+                    val mime = inl.optString("mimeType", inl.optString("mime_type", "image/png"))
+                    imgs.add(Pair(mime, android.util.Base64.decode(data, android.util.Base64.DEFAULT)))
+                }
+            }
+        }
+        val t = sb.toString().trim()
+        return GeminiReply(if (t.isEmpty() && imgs.isEmpty()) "No answer returned." else t, imgs)
+    } finally {
+        conn.disconnect()
+    }
+}
