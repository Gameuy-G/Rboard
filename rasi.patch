+@Composable
+fun RasiNowPlayingScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiNowPlaying.prefs(context) }
+
+    var listenerOk by remember { mutableStateOf(RasiNowPlaying.hasListenerAccess(context)) }
+    var overlayOk by remember { mutableStateOf(RasiNowPlaying.canOverlay(context)) }
+    var shTick by remember { mutableStateOf(0) }
+    val seenApps = remember { mutableStateListOf<String>().also { it.addAll(RasiNowPlaying.seenApps(context)) } }
+    val appOn = remember { mutableStateMapOf<String, Boolean>() }
+    fun refreshSeen() {
+        for (a in RasiNowPlaying.seenApps(context)) if (a !in seenApps) seenApps.add(a)
+        for (a in seenApps) if (!appOn.containsKey(a)) appOn[a] = RasiNowPlaying.isAllowed(context, a)
+    }
+    var onlyMusic by remember { mutableStateOf(prefs.getBoolean("only_music", true)) }
+    var pickerOpen by remember { mutableStateOf(false) }
+    var pickerQuery by remember { mutableStateOf("") }
+    DisposableEffect(context) {
+        val lc = (context as? androidx.lifecycle.LifecycleOwner)?.lifecycle
+        val obs = androidx.lifecycle.LifecycleEventObserver { _, e ->
+            if (e == androidx.lifecycle.Lifecycle.Event.ON_RESUME) {
+                listenerOk = RasiNowPlaying.hasListenerAccess(context)
+                RasiNowPlaying.ensureConnected(context)
+                overlayOk = RasiNowPlaying.canOverlay(context)
+                shTick++
+                refreshSeen()
+            }
+        }
+        lc?.addObserver(obs)
+        onDispose { lc?.removeObserver(obs) }
+    }
+
+    var overlayOn by remember { mutableStateOf(prefs.getBoolean("overlay_on", false)) }
+    var bgOn by remember { mutableStateOf(prefs.getBoolean("mode_bg", false)) }
+    var dynOn by remember { mutableStateOf(prefs.getBoolean("mode_dyn", false)) }
