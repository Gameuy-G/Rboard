+    fun fxWanted(ctx: android.content.Context): Boolean {
+        RasiMethods.init(ctx)
+        return RasiNowPlaying.prefs(ctx).getBoolean("fx_on", false) && !org.futo.inputmethod.latin.uix.RasiPerf.isOn() &&
