+private fun dayKey(ms: Long): Int {
+    val c = Calendar.getInstance()
+    c.timeInMillis = ms
+    return c.get(Calendar.YEAR) * 1000 + c.get(Calendar.DAY_OF_YEAR)
+}
+
+private fun ordinalOf(d: Int): String =
+    d.toString() + if (d in 11..13) "th" else when (d % 10) { 1 -> "st"; 2 -> "nd"; 3 -> "rd"; else -> "th" }
+
+private fun dayLabel(ms: Long): String {
+    val k = dayKey(ms)
+    val now = Calendar.getInstance()
+    if (k == dayKey(now.timeInMillis)) return "Today"
+    now.add(Calendar.DAY_OF_YEAR, -1)
+    if (k == dayKey(now.timeInMillis)) return "Yesterday"
+    val c = Calendar.getInstance()
+    c.timeInMillis = ms
+    val months = arrayOf("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
+    val base = months[c.get(Calendar.MONTH)] + " " + ordinalOf(c.get(Calendar.DAY_OF_MONTH))
+    return if (c.get(Calendar.YEAR) != Calendar.getInstance().get(Calendar.YEAR)) base + ", " + c.get(Calendar.YEAR) else base
+}
+
+private fun addDateGroups(
+    out: MutableList<MediaCell>, list: List<File>, oldestFirst: Boolean, prefix: String, source: String?,
+    m: RasiMedia.Meta, dateMode: String
+) {
+    fun d(f: File) = RasiMedia.dateOf(f, m, dateMode)
+    val groups = LinkedHashMap<Int, MutableList<File>>()
+    for (f in list) groups.getOrPut(dayKey(d(f))) { mutableListOf() }.add(f)
+    val keys = if (oldestFirst) groups.keys.sorted() else groups.keys.sortedDescending()
+    for (k in keys) {
+        val g = groups[k] ?: continue
+        out.add(MediaCell.Header("$prefix:d$k", dayLabel(d(g.first())), out.isNotEmpty()))
+        for (f in g) out.add(MediaCell.Item("$prefix:d$k:${f.name}", f, source))
+    }
+}
+
+/** Builds the headers and thumbnails for the current tab, sort, filter and grouping. */
+private fun buildCells(
+    allFiles: List<File>, m: RasiMedia.Meta, tab: String?, sort: String, filter: String, grouping: String, dateMode: String
+): List<MediaCell> {
+    val out = ArrayList<MediaCell>()
+    val oldest = sort == "oldest"
+    val files = if (tab == null) allFiles.filter { it.name !in m.hidden } else allFiles
+    if (tab != null) {
+        val set = (m.sections[tab] ?: emptyList()).toSet()
+        addDateGroups(out, RasiMedia.orderFiles(files.filter { it.name in set }, m, sort, filter, dateMode), oldest, "s", tab, m, dateMode)
+    } else if (grouping == "section" && m.sections.isNotEmpty()) {
+        val inAny = HashSet<String>()
+        for ((name, fl) in m.sections) {
+            val set = fl.toSet()
+            inAny.addAll(set)
+            val l = RasiMedia.orderFiles(files.filter { it.name in set }, m, sort, filter, dateMode)
+            if (l.isEmpty()) continue
+            out.add(MediaCell.Header("sec:$name", name, out.isNotEmpty()))
+            for (f in l) out.add(MediaCell.Item("sec:$name:${f.name}", f, name))
+        }
+        val rest = RasiMedia.orderFiles(files.filter { it.name !in inAny }, m, sort, filter, dateMode)
+        if (rest.isNotEmpty()) {
+            out.add(MediaCell.Header("sec:\u0000unsorted", "Unsorted", out.isNotEmpty()))
+            for (f in rest) out.add(MediaCell.Item("sec:\u0000unsorted:${f.name}", f, null))
+        }
+    } else {
+        addDateGroups(out, RasiMedia.orderFiles(files, m, sort, filter, dateMode), oldest, "a", null, m, dateMode)
+    }
+    return out
+}
