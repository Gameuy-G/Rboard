new file mode 100644
index 000000000..61512e09d
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiWingdings.kt
@@ -0,0 +1,58 @@
+package org.futo.inputmethod.latin.rasi
+
+/**
+ * Wingdings-style symbol alphabet. A few glyphs that most phones cannot draw were swapped for
+ * close symbols that every font has.
+ */
+object RasiWingdings {
+    private val UPPER = listOf(
+        "✌", "👌", "👍", "👎", "☜", "☞", "☝", "☟", "✋", "☺", "😐", "☹", "💣", "☠", "⚐", "⚑", "✈", "☼",
+        "💧", "❄", "✝", "✞", "✟", "✠", "✡", "☪"
+    )
+    private val LOWER = listOf(
+        "♋", "♌", "♍", "♎", "♏", "♐", "♑", "♒", "♓", "❧", "❦", "●", "◉", "■", "□", "◻", "❑", "❒", "♦",
+        "◊", "◆", "❖", "◈", "☒", "✗", "⌘"
+    )
+    private val DIGITS = listOf("📁", "📂", "📄", "📃", "📋", "🗄", "⌛", "⌨", "🖱", "🖲")
+
+    private val encodeMap: Map<Int, String> by lazy {
+        val m = HashMap<Int, String>()
+        for (i in 0 until 26) {
+            m['A'.code + i] = UPPER[i]
+            m['a'.code + i] = LOWER[i]
+        }
+        for (i in 0 until 10) m['0'.code + i] = DIGITS[i]
+        m
+    }
+
+    private val decodeMap: Map<String, Char> by lazy {
+        val m = HashMap<String, Char>()
+        for (i in 0 until 26) {
+            m[UPPER[i]] = 'A' + i
+            m[LOWER[i]] = 'a' + i
+        }
+        for (i in 0 until 10) m[DIGITS[i]] = '0' + i
+        m
+    }
+
+    fun encode(text: String): String {
+        val sb = StringBuilder()
+        text.codePoints().forEach { cp -> sb.append(encodeMap[cp] ?: String(Character.toChars(cp))) }
+        return sb.toString()
+    }
+
+    fun decode(text: String): String {
+        val sb = StringBuilder()
+        var i = 0
+        while (i < text.length) {
+            val cp = text.codePointAt(i)
+            val len = Character.charCount(cp)
+            var piece = text.substring(i, i + len)
+            i += len
+            // skip emoji/text variation selectors that follow a symbol
+            while (i < text.length && (text[i] == '\uFE0F' || text[i] == '\uFE0E')) i++
+            sb.append(decodeMap[piece]?.toString() ?: piece)
+        }
+        return sb.toString()
+    }
+}
