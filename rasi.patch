+private class SKey(val label: String, val code: Int, val row: Int, val col: Int, val span: Int)
+
+private val SAMPLE_KEYS: List<SKey> = buildList {
+    val rows = listOf("qwertyu", "asdfghj", "zxcvbnm")
+    rows.forEachIndexed { r, str -> str.forEachIndexed { c, ch -> add(SKey(ch.toString(), ch.code, r, c, 1)) } }
+    add(SKey("DEL", Constants.CODE_DELETE, 3, 0, 1))
+    add(SKey("SPACE", Constants.CODE_SPACE, 3, 1, 5))
+    add(SKey("ENTER", Constants.CODE_ENTER, 3, 6, 1))
+}
