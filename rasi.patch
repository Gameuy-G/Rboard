@@ -0,0 +1,38 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+
+/**
+ * Profile badges. They are worked out on the phone from your kept local stats and account age,
+ * and only the badge ids are stored in your profile. No typed text is involved.
+ */
+object RasiBadges {
+    class Badge(val id: String, val icon: String, val title: String, val desc: String)
+
+    val ALL = listOf(
+        Badge("member", "\u2B50", "Member", "Has an Rboard account"),
+        Badge("veteran", "\uD83D\uDCC5", "Veteran", "Account is older than 30 days"),
+        Badge("pic", "\uD83D\uDDBC\uFE0F", "Pictured", "Uses a profile picture"),
+        Badge("typist", "\u2328\uFE0F", "Typist", "10,000 keystrokes counted"),
+        Badge("wordsmith", "\u270D\uFE0F", "Wordsmith", "5,000 words counted"),
+        Badge("listener", "\uD83C\uDFB5", "Listener", "1 hour of music counted"),
+        Badge("melomaniac", "\uD83C\uDFA7", "Melomaniac", "10 hours of music counted"),
+    )
+
+    fun byId(id: String): Badge? = ALL.firstOrNull { it.id == id }
+
+    fun earned(c: Context, createdAt: Long, hasPicture: Boolean): List<String> {
+        val s = try { RasiStats.summary(c, -1, 1) } catch (t: Throwable) { null }
+        val out = ArrayList<String>()
+        out.add("member")
+        if (createdAt > 0L && System.currentTimeMillis() - createdAt > 30L * 24 * 3600 * 1000) out.add("veteran")
+        if (hasPicture) out.add("pic")
+        if (s != null) {
+            if (s.keys >= 10_000L) out.add("typist")
+            if (s.words >= 5_000L) out.add("wordsmith")
+            if (s.listenMs >= 3_600_000L) out.add("listener")
+            if (s.listenMs >= 36_000_000L) out.add("melomaniac")
+        }
+        return out
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiBeat.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiBeat.kt
new file mode 100644
index 000000000..ec28af8c4
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiBeat.kt
@@ -0,0 +1,76 @@
+package org.futo.inputmethod.latin.rasi
+
+import kotlin.math.max
+import kotlin.math.sqrt
+
+/**
+ * Shared beat detector. It looks for a sudden energy rise in the low and mid bands compared with the
+ * recent average (spectral flux with an adaptive threshold), so it fires on every kick and drum hit
+ * even when the song is not loud. Border glow, beat colors and shakes can all read the same result.
+ */
+object RasiBeat {
+    private const val LOW = 24
+    private var lastSeq = -1
+    private var prev: FloatArray? = null
+    private var fluxS = 0f
+    private var fluxPrev = 0f
+    private var avg = 0f
+    private var varr = 0f
+    private var peakRef = 0.05f
+    private var lastAt = 0L
+
+    /** 0..1 strength of the latest beat compared with the recent loudest beats (weak = low, strong = high). */
+    @Volatile var strength = 0f
+    /** Time of the latest beat in ms. */
+    @Volatile var lastBeatAt = 0L
+
+    fun reset() {
+        lastSeq = -1; prev = null; fluxS = 0f; fluxPrev = 0f; avg = 0f; varr = 0f; peakRef = 0.05f; strength = 0f
+    }
+
+    /**
+     * Call every tick with the raw band levels and a counter that grows when new levels arrive.
+     * sens, floor and smooth are 0..1, coolMs is the shortest time between two beats.
+     * Returns true on the tick a beat starts.
+     */
+    fun detect(levels: FloatArray, seq: Int, now: Long, sens: Float, coolMs: Int, floor: Float, smooth: Float): Boolean {
+        if (seq == lastSeq) return false
+        lastSeq = seq
+        val n = minOf(levels.size, LOW)
+        var p = prev
+        if (p == null || p.size != n) { p = FloatArray(n); System.arraycopy(levels, 0, p, 0, n); prev = p; return false }
+        var flux = 0f
+        var wsum = 0f
+        var low = 0f
+        for (i in 0 until n) {
+            val w = if (i < 4) 1f else if (i < 10) 0.6f else 0.25f
+            flux += w * max(0f, levels[i] - p[i])
+            wsum += w
+            if (i < 6) low += levels[i]
+            p[i] = levels[i]
+        }
+        flux /= wsum
+        low /= 6f
+        // light smoothing of the detector input (0 = raw)
+        val a = 1f - 0.6f * smooth
+        fluxS += (flux - fluxS) * a
+        val f = fluxS
+        val d = f - avg
+        avg += d * 0.10f
+        varr += (d * d - varr) * 0.10f
+        val std = sqrt(varr)
+        val c = 2.4f - 1.8f * sens
+        val thr = avg + c * std + 0.010f + 0.020f * (1f - sens)
+        // keep a slow reference of the strongest recent beats so weak and strong beats can be told apart
+        peakRef = max(f, peakRef * 0.995f).coerceAtLeast(0.03f)
+        val rising = f >= fluxPrev
+        fluxPrev = f
+        if (f > thr && rising && low > floor * 0.5f && now - lastAt > coolMs) {
+            lastAt = now
+            lastBeatAt = now
+            strength = (f / peakRef).coerceIn(0.15f, 1f)
+            return true
+        }
+        return false
+    }
+}
