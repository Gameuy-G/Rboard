+import kotlinx.coroutines.runBlocking
+import org.futo.inputmethod.latin.R
+import kotlin.concurrent.thread
+
+val RasiAutoUpdateSetting = SettingsKey(booleanPreferencesKey("rasi_auto_update"), true)
+val RasiUpdateNotifySetting = SettingsKey(booleanPreferencesKey("rasi_update_notify"), true)
+val RasiUpdateHoursSetting = SettingsKey(intPreferencesKey("rasi_update_hours"), 24)
+val RasiUpdateLastNotified = SettingsKey(stringPreferencesKey("rasi_update_last_notified"), "")
+val RasiUpdateLastCheck = SettingsKey(longPreferencesKey("rasi_update_last_check"), 0L)
+
+internal fun <T> rasiRead(c: Context, key: androidx.datastore.preferences.core.Preferences.Key<T>, default: T): T =
+    runBlocking { c.getSettingFlow(key, default).first() }
+
+/** Background update check (platform JobScheduler, no extra dependency) plus the notification. */
+object RasiUpdateNotifier {
+    const val JOB_ID = 7101
+    const val CHANNEL_ID = "rasi_updates"
+    private const val NOTIF_ID = 7101
+
+    /** Call when the keyboard starts and after changing the settings. */
+    fun schedule(context: Context) {
+        val app = context.applicationContext
+        val js = app.getSystemService(Context.JOB_SCHEDULER_SERVICE) as JobScheduler
+        val auto = rasiRead(app, RasiAutoUpdateSetting.key, RasiAutoUpdateSetting.default)
+        if (!auto) {
+            js.cancel(JOB_ID)
+            return
+        }
+        val hours = rasiRead(app, RasiUpdateHoursSetting.key, RasiUpdateHoursSetting.default)
+            .coerceIn(12, 168)
+        val info = JobInfo.Builder(JOB_ID, ComponentName(app, RasiUpdateJob::class.java))
+            .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
+            .setPeriodic(hours * 60L * 60L * 1000L)
+            .setPersisted(true)
+            .build()
+        // Do not reset the timer when an identical job is already scheduled.
+        val existing = js.getPendingJob(JOB_ID)
+        if (existing == null || existing.intervalMillis != info.intervalMillis) js.schedule(info)
+    }
+
+    /** Blocking. Checks GitHub and shows the notification if there is a new build. */
+    fun runCheck(context: Context) {
+        val app = context.applicationContext
+        runBlocking { app.setSetting(RasiUpdateLastCheck.key, System.currentTimeMillis()) }
+        val result = RasiUpdate.check()
+        if (result is RasiUpdate.Result.Available) maybeNotify(app)
+        try { RasiNotice.check(app) } catch (_: Throwable) {}
+    }
+
+    private fun maybeNotify(app: Context) {
+        if (!rasiRead(app, RasiUpdateNotifySetting.key, RasiUpdateNotifySetting.default)) return
+        // One notification per published build: the build is identified by the repo patch id.
+        val id = RasiUpdate.latestRepoId ?: return
+        if (rasiRead(app, RasiUpdateLastNotified.key, "") == id) return
+        if (Build.VERSION.SDK_INT >= 33 &&
+            app.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+        ) return
+
+        val nm = app.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        nm.createNotificationChannel(
+            NotificationChannel(CHANNEL_ID, app.getString(R.string.rasi_update_channel), NotificationManager.IMPORTANCE_DEFAULT)
+        )
+        val open = PendingIntent.getActivity(
+            app, 0,
+            Intent(Intent.ACTION_VIEW, Uri.parse(RasiUpdate.APK_URL)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        val n = NotificationCompat.Builder(app, CHANNEL_ID)
+            .setSmallIcon(R.mipmap.ic_launcher)
+            .setContentTitle(app.getString(R.string.rasi_update_notif_title))
+            .setContentText(app.getString(R.string.rasi_update_notif_text))
+            .setContentIntent(open)
+            .setAutoCancel(true)
+            .build()
+        NotificationManagerCompat.from(app).notify(NOTIF_ID, n)
+        runBlocking { app.setSetting(RasiUpdateLastNotified.key, id) }
+    }
+}
+
+class RasiUpdateJob : JobService() {
+    override fun onStartJob(params: JobParameters): Boolean {
+        thread(name = "rasi-update-check") {
+            try {
+                RasiUpdateNotifier.runCheck(this)
+            } catch (_: Throwable) {
+            }
+            jobFinished(params, false)
+        }
+        return true
+    }
+
+    override fun onStopJob(params: JobParameters): Boolean = true
+}
