+            label = stringResource(R.string.rasi_key_roundness),
+            value = roundness.coerceIn(0f, 3f),
+            valueRange = 0f..3f,
+            gradient = Brush.horizontalGradient(listOf(Color(0xFF555555), Color(0xFFBBBBBB))),
+            onValueChange = { onChange(it, borders) }
+        )
+    }
+}
+
+private val presetSwatches = listOf(
+    0xFF000000.toInt(), 0xFFFFFFFF.toInt(), 0xFF2B2B2B.toInt(), 0xFFE53935.toInt(),
+    0xFFFB8C00.toInt(), 0xFFFDD835.toInt(), 0xFF43A047.toInt(), 0xFF1E88E5.toInt(),
+    0xFF8E24AA.toInt(), 0xFFEC407A.toInt()
+)
+
+/**
+ * Color picker for key background and key text. Changes apply live to the preview
+ * because the editor rebuilds the theme whenever the colors change.
+ */
+@Composable
+internal fun KeyColorPicker(
+    currentKeyColor: Int,
+    currentTextColor: Int,
+    onKeyColor: (Int?) -> Unit,
+    onTextColor: (Int?) -> Unit
+) {
+    var editingText by remember { mutableStateOf(false) }
+    var tick by remember { mutableIntStateOf(0) }
+    val current = if (editingText) currentTextColor else currentKeyColor
+
+    val init = remember(editingText, tick) {
+        FloatArray(3).also { android.graphics.Color.colorToHSV(current, it) }
+    }
+    var h by remember(editingText, tick) { mutableFloatStateOf(init[0]) }
+    var s by remember(editingText, tick) { mutableFloatStateOf(init[1]) }
+    var v by remember(editingText, tick) { mutableFloatStateOf(init[2]) }
+    var hex by remember(editingText, tick, current) {
+        mutableStateOf(String.format("#%06X", current and 0xFFFFFF))
+    }
+
+    val emit = { c: Int ->
+        if (editingText) onTextColor(c) else onKeyColor(c)
+    }
+    val applyHsv = { nh: Float, ns: Float, nv: Float ->
+        h = nh
+        s = ns
+        v = nv
+        emit(android.graphics.Color.HSVToColor(floatArrayOf(nh.coerceIn(0f, 360f), ns.coerceIn(0f, 1f), nv.coerceIn(0f, 1f))))
+    }
+
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(16.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        Row(
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            if (!editingText) {
+                Button(onClick = { }) { Text(stringResource(R.string.rasi_key_color_keys)) }
+                OutlinedButton(onClick = { editingText = true }) { Text(stringResource(R.string.rasi_key_color_text)) }
+            } else {
+                OutlinedButton(onClick = { editingText = false }) { Text(stringResource(R.string.rasi_key_color_keys)) }
+                Button(onClick = { }) { Text(stringResource(R.string.rasi_key_color_text)) }
+            }
+
+            Row(Modifier.weight(1f)) {}
+
+            Row(
+                modifier = Modifier
+                    .size(36.dp)
+                    .clip(RoundedCornerShape(10.dp))
+                    .background(Color(current or 0xFF000000.toInt()))
+                    .border(1.dp, Color.Gray, RoundedCornerShape(10.dp))
+            ) {}
+
+            OutlinedButton(onClick = {
+                onKeyColor(null)
+                onTextColor(null)
+                tick++
+            }) { Text(stringResource(R.string.rasi_key_color_reset)) }
+        }
+
+        Row(
+            modifier = Modifier.horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            presetSwatches.forEach { c ->
+                Row(
+                    modifier = Modifier
+                        .size(32.dp)
+                        .clip(CircleShape)
+                        .background(Color(c))
+                        .border(1.dp, Color.Gray, CircleShape)
+                        .clickable {
+                            val a = FloatArray(3)
+                            android.graphics.Color.colorToHSV(c, a)
+                            h = a[0]
+                            s = a[1]
+                            v = a[2]
+                            emit(c)
+                        }
+                ) {}
+            }
+        }
+
+        val hueColor = Color(android.graphics.Color.HSVToColor(floatArrayOf(h.coerceIn(0f, 360f), 1f, 1f)))
+
+        LabeledSlider(
+            label = "Hue",
+            value = h,
+            valueRange = 0f..360f,
+            gradient = remember {
+                Brush.horizontalGradient(
+                    (0..360 step 30).map { deg ->
+                        Color(android.graphics.Color.HSVToColor(floatArrayOf(deg.toFloat(), 1f, 1f)))
+                    }
+                )
+            },
+            onValueChange = { applyHsv(it, s, v) }
+        )
+
+        LabeledSlider(
+            label = "Saturation",
+            value = s,
+            valueRange = 0f..1f,
+            gradient = Brush.horizontalGradient(listOf(Color.White, hueColor)),
+            onValueChange = { applyHsv(h, it, v) }
+        )
+
+        LabeledSlider(
+            label = "Brightness",
+            value = v,
+            valueRange = 0f..1f,
+            gradient = Brush.horizontalGradient(listOf(Color.Black, hueColor)),
+            onValueChange = { applyHsv(h, s, it) }
+        )
+
+        OutlinedTextField(
+            value = hex,
+            onValueChange = { t ->
+                hex = t
+                if (t.length == 7 && t[0] == '#') {
+                    val c = runCatching { android.graphics.Color.parseColor(t) }.getOrNull()
+                    if (c != null) {
+                        val a = FloatArray(3)
+                        android.graphics.Color.colorToHSV(c, a)
+                        h = a[0]
+                        s = a[1]
+                        v = a[2]
+                        emit(c)
+                    }
+                }
+            },
+            singleLine = true,
+            label = { Text(stringResource(R.string.rasi_key_color_hex)) },
+            modifier = Modifier.fillMaxWidth()
+        )
+    }
+}
