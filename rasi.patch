--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiVizPrefs.kt
@@ -0,0 +1,60 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.SharedPreferences
+
+/** Gives the settings-menu visualizer its own copy of the viz_ options (stored as sviz_). */
+class RasiMappedPrefs(private val base: SharedPreferences) : SharedPreferences by base {
+    private fun m(k: String?): String? = RasiVizPrefs.map(k)
+
+    override fun getString(key: String?, defValue: String?): String? = base.getString(m(key), defValue)
+    override fun getInt(key: String?, defValue: Int): Int = base.getInt(m(key), defValue)
+    override fun getBoolean(key: String?, defValue: Boolean): Boolean = base.getBoolean(m(key), defValue)
+    override fun getFloat(key: String?, defValue: Float): Float = base.getFloat(m(key), defValue)
+    override fun getLong(key: String?, defValue: Long): Long = base.getLong(m(key), defValue)
+    override fun contains(key: String?): Boolean = base.contains(m(key))
+    override fun edit(): SharedPreferences.Editor = MappedEditor(base.edit())
+
+    private class MappedEditor(private val e: SharedPreferences.Editor) : SharedPreferences.Editor by e {
+        override fun putString(key: String?, value: String?): SharedPreferences.Editor { e.putString(RasiVizPrefs.map(key), value); return this }
+        override fun putInt(key: String?, value: Int): SharedPreferences.Editor { e.putInt(RasiVizPrefs.map(key), value); return this }
+        override fun putBoolean(key: String?, value: Boolean): SharedPreferences.Editor { e.putBoolean(RasiVizPrefs.map(key), value); return this }
+        override fun putFloat(key: String?, value: Float): SharedPreferences.Editor { e.putFloat(RasiVizPrefs.map(key), value); return this }
+        override fun putLong(key: String?, value: Long): SharedPreferences.Editor { e.putLong(RasiVizPrefs.map(key), value); return this }
+        override fun remove(key: String?): SharedPreferences.Editor { e.remove(RasiVizPrefs.map(key)); return this }
+    }
+}
+
+object RasiVizPrefs {
+    /** Options that stay shared between the keyboard and the settings visualizer. */
+    private val shared = setOf("viz_source", "viz_root", "viz_sim_speed", "viz_smooth", "viz_bass_fix", "viz_punch_thr", "viz_punch_decay", "viz_beat_cool", "viz_beat_floor", "viz_beat_smooth", "viz_shake_on", "viz_shake_target", "viz_shake_style", "viz_shake_cmode", "viz_shake_int", "viz_shake_speed", "viz_shake_len", "viz_shake_thr", "viz_shake_every", "viz_shake_cevery")
+
+    @Volatile private var cached: RasiMappedPrefs? = null
+    @Volatile private var cachedBase: SharedPreferences? = null
+
+    fun map(k: String?): String? =
+        if (k != null && k.startsWith("viz_") && k !in shared) "s$k" else k
+
+    /** The settings visualizer's own options. First use copies the keyboard's current look. */
+    fun settings(base: SharedPreferences): SharedPreferences {
+        val c = cached
+        if (c != null && cachedBase === base) return c
+        if (!base.getBoolean("sviz_init", false)) {
+            val ed = base.edit()
+            for ((k, v) in base.all) {
+                if (!k.startsWith("viz_") || k in shared) continue
+                when (v) {
+                    is String -> ed.putString("s$k", v)
+                    is Int -> ed.putInt("s$k", v)
+                    is Boolean -> ed.putBoolean("s$k", v)
+                    is Float -> ed.putFloat("s$k", v)
+                    is Long -> ed.putLong("s$k", v)
+                }
+            }
+            ed.putBoolean("sviz_init", true).apply()
+        }
+        val n = RasiMappedPrefs(base)
+        cached = n
+        cachedBase = base
+        return n
+    }
+}
