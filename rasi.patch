+private fun gridActions(saved: String, all: List<Action>): List<Action> {
+    val byId = all.associateBy { ActionRegistry.actionToStringId(it) }
+    val order = (saved.split(",").map { it.trim() } + RasiGridDefaultFirst).filter { it.isNotEmpty() }
+    val out = mutableListOf<Action>()
+    for (id in order) {
+        val a = byId[id]
+        if (a != null && !out.contains(a)) out.add(a)
+    }
+    for (a in all) if (!out.contains(a)) out.add(a)
+    return out
