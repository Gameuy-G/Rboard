+
+/** The home settings list with a "Reorder" mode: drag the handle or use the arrows. The order is remembered. */
+@Composable
+fun RasiReorderableHome() {
+    val ctx = LocalContext.current
+    val prefs = remember { ctx.getSharedPreferences("rasi_home_order", Context.MODE_PRIVATE) }
+    val settings = HomeScreenLite.settings
+    val keyed = remember {
+        settings.map { s ->
+            val k = try { ctx.resources.getResourceEntryName(s.name) } catch (e: Exception) { s.name.toString() }
+            k to s
+        }.distinctBy { it.first }
+    }
+    val byKey = remember { keyed.toMap() }
+    val defaultOrder = remember { keyed.map { it.first } }
+    val order = remember {
+        val saved = (prefs.getString("order", "") ?: "").split(",").filter { it in byKey }.distinct()
+        mutableStateListOf<String>().apply {
+            val fresh = defaultOrder.filter { it !in saved }
+            // the friends strip is new: put it at the top the first time, the user can move it afterwards
+            val strip = fresh.filter { it == "rasi_home_friends_strip" }
+            addAll(strip + saved + fresh.filter { it !in strip })
+        }
+    }
+    var editing by remember { mutableStateOf(false) }
+    var dragKey by remember { mutableStateOf<String?>(null) }
+    var dragOffset by remember { mutableFloatStateOf(0f) }
+    val heights = remember { HashMap<String, Int>() }
+
+    val vis = ArrayList<String>()
+    for (k in order) {
+        val s = byKey[k] ?: continue
+        if (s.visibilityCheck?.invoke() != false) vis.add(k)
+    }
+    val visNow = rememberUpdatedState(vis)
+
+    fun save() { prefs.edit().putString("order", order.joinToString(",")).apply() }
+    fun swap(k: String, dir: Int): Boolean {
+        val v = visNow.value
+        val i = v.indexOf(k)
+        val j = i + dir
+        if (i < 0 || j < 0 || j >= v.size) return false
+        val a = order.indexOf(v[i])
+        val b = order.indexOf(v[j])
+        val t = order[a]; order[a] = order[b]; order[b] = t
+        return true
+    }
+
+    // Where the dragged row would land (index among visible rows). Rows are NOT reordered while
+    // dragging (moving nodes cancels the touch), only shifted visually; the move is committed on release.
+    fun targetIndex(): Int {
+        val dk = dragKey ?: return -1
+        val v = visNow.value
+        val i0 = v.indexOf(dk)
+        if (i0 < 0) return -1
+        val hs = v.map { (heights[it] ?: 0).toFloat() }
+        var top0 = 0f
+        for (j in 0 until i0) top0 += hs[j]
+        val c = top0 + hs[i0] / 2f + dragOffset
+        var t = 0
+        var top = 0f
+        for (j in v.indices) {
+            if (j != i0 && top + hs[j] / 2f < c) t++
+            top += hs[j]
+        }
+        return t
+    }
+    fun commitDrag() {
+        val dk = dragKey
+        if (dk != null) {
+            val t = targetIndex()
+            val others = visNow.value.filter { it != dk }
+            if (t >= 0) {
+                order.remove(dk)
+                val idx = when {
+                    others.isEmpty() -> order.size
+                    t <= 0 -> order.indexOf(others[0])
+                    else -> order.indexOf(others[minOf(t, others.size) - 1]) + 1
+                }
+                order.add(idx.coerceIn(0, order.size), dk)
+                save()
+            }
+        }
+        dragKey = null
+        dragOffset = 0f
+    }
+
+    Row(Modifier.fillMaxWidth().padding(horizontal = 8.dp), horizontalArrangement = Arrangement.End) {
+        if (editing) {
+            RasiTextButton(onClick = {
+                order.clear(); order.addAll(defaultOrder)
+                prefs.edit().remove("order").apply()
+            }) { Text("Reset order") }
+            RasiTextButton(onClick = { editing = false; dragKey = null; dragOffset = 0f }) { Text("Done") }
+        } else {
+            RasiTextButton(onClick = { editing = true }) { Text("Reorder sections") }
+        }
+    }
+
+    for (k in order.toList()) {
+        val s = byKey[k] ?: continue
+        key(k) {
+            if (s.visibilityCheck?.invoke() != false) {
+                if (!editing) {
+                    s.component()
+                } else {
+                    val dragging = dragKey == k
+                    val vNow = vis
+                    val myIdx = vNow.indexOf(k)
+                    val dIdx = dragKey?.let { vNow.indexOf(it) } ?: -1
+                    val tIdx = targetIndex()
+                    val h0 = (dragKey?.let { heights[it] } ?: 0).toFloat()
+                    val shift = when {
+                        dragKey == null || dragging || dIdx < 0 -> 0f
+                        myIdx > dIdx && myIdx <= tIdx -> -h0
+                        myIdx < dIdx && myIdx >= tIdx -> h0
+                        else -> 0f
+                    }
+                    val animShift by animateFloatAsState(shift, label = "reorderShift")
+                    Row(
+                        Modifier
+                            .fillMaxWidth()
+                            .zIndex(if (dragging) 1f else 0f)
+                            .graphicsLayer { translationY = if (dragging) dragOffset else animShift }
+                            .onSizeChanged { heights[k] = it.height },
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        Box(Modifier.weight(1.0f)) {
+                            s.component()
+                            // block taps so the row does not open while reordering
+                            Box(Modifier.matchParentSize().pointerInput(Unit) { detectTapGestures { } })
+                        }
+                        Column {
+                            IconButton(onClick = { if (swap(k, -1)) save() }, modifier = Modifier.size(36.dp)) {
+                                Icon(Icons.Default.KeyboardArrowUp, contentDescription = "Move up")
+                            }
+                            IconButton(onClick = { if (swap(k, 1)) save() }, modifier = Modifier.size(36.dp)) {
+                                Icon(Icons.Default.KeyboardArrowDown, contentDescription = "Move down")
+                            }
+                        }
+                        Box(
+                            Modifier
+                                .size(48.dp)
+                                .pointerInput(k) {
+                                    detectDragGestures(
+                                        onDragStart = { dragKey = k; dragOffset = 0f },
+                                        onDragEnd = { commitDrag() },
+                                        onDragCancel = { commitDrag() },
+                                        onDrag = { change, amount ->
+                                            change.consume()
+                                            dragOffset += amount.y
+                                        }
+                                    )
+                                },
+                            contentAlignment = Alignment.Center
+                        ) {
+                            Icon(Icons.Default.Menu, contentDescription = "Drag to reorder", tint = MaterialTheme.colorScheme.onBackground)
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
