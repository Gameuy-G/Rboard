+            color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+    gridItems(list, key = { "$title|$it" }, contentType = { "emoji" }) { e ->
+        Text(e, Modifier.fillMaxWidth().padding(2.dp).clip(RoundedCornerShape(12.dp)).clickable { onTap(e) }.padding(vertical = 6.dp), fontSize = 26.sp, textAlign = TextAlign.Center, maxLines = 1, softWrap = false)
+    }
