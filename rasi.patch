+/** Finds a player's audio session id with root (needs su). Parses the output of dumpsys audio. */
+object RasiRoot {
+    /** Who ran the last command: "Root" or "Shizuku". Used in the status notes. */
+    @Volatile var via = "Root"
+
+    private fun run(cmd: String): String? {
+        // Shizuku first when it is ready (fast, no prompt); otherwise su
+        if (RasiMethods.shizuku && RasiShizuku.granted()) {
+            val o = RasiShizuku.run(cmd)
+            if (!o.startsWith("failed:") && o.length > 20) { via = "Shizuku"; return o }
+        }
+        if (!RasiMethods.root) return null
+        via = "Root"
+        val proc = try { ProcessBuilder("su", "-c", cmd).redirectErrorStream(true).start() } catch (e: Throwable) { return null }
+        val sb = StringBuilder()
+        val reader = Thread {
+            try {
+                proc.inputStream.bufferedReader().use { r ->
+                    val buf = CharArray(8192)
+                    while (true) {
+                        val n = r.read(buf)
+                        if (n < 0) break
+                        if (sb.length < 2000000) sb.append(buf, 0, n)
+                    }
+                }
+            } catch (e: Throwable) { }
+        }
+        reader.start()
+        return try {
+            // first use can show a root permission prompt, so wait a while
+            if (!proc.waitFor(12, java.util.concurrent.TimeUnit.SECONDS)) { proc.destroy(); null }
+            else { reader.join(1500); sb.toString() }
+        } catch (e: Throwable) { try { proc.destroy() } catch (x: Throwable) { }; null }
+    }
+
+    /** Reads the audio_flinger track table (columns Client = process id, Session = session id) and returns the session of the player with one of [pids], preferring a started one. */
+    private fun sessionFromTracks(dump: String, pids: List<Pair<Int, Boolean>>): Int {
+        var ci = -1
+        var si = -1
+        var best = -1
+        var bestStarted = false
+        for (line in dump.lines()) {
+            val t = line.trim().split(Regex("\\s+"))
+            if (t.contains("Client") && t.contains("Session")) { ci = t.indexOf("Client"); si = t.indexOf("Session"); continue }
+            if (ci < 0 || t.size <= maxOf(ci, si)) continue
+            val pid = t[ci].toIntOrNull() ?: continue
+            val sid = t[si].toIntOrNull() ?: continue
+            if (sid <= 0) continue
+            val p = pids.firstOrNull { it.first == pid } ?: continue
+            if (best < 0 || (p.second && !bestStarted)) { best = sid; bestStarted = p.second }
+        }
+        return best
+    }
+
+    /** The audio session id of the newest (preferably started) playback of this app uid, or -1. */
+    fun sessionFor(uid: Int): Int {
+        val out = run("dumpsys audio")
+        if (out == null || out.isBlank()) {
+            RasiNowPlayingViz.rootNote = if (!RasiMethods.root) "Root is turned off in Developer settings and Shizuku is not ready"
+                else "Root: su failed or was denied, and Shizuku is not ready"
+            return -1
+        }
+        val fmt = RasiMethods.shzFmt
+        val lines = out.lines()
+        val reUid = Regex("u/pid:(\\d+)/")
+        val reUid2 = Regex("(?:^|[ (,])uid[:= ](\\d+)")
+        val reSid = Regex("session(?:Id)?[:= ]\\s*(\\d+)", RegexOption.IGNORE_CASE)
+        var sample = ""
+        // strict = Android 13+ style (session id on the same line). Loose = Android 10-12 style (looser line formats).
+        fun find(strict: Boolean): Int {
+            var best = -1
+            var bestStarted = false
+            for (i in lines.indices) {
+                val line = lines[i]
+                if (!line.contains("u/pid:") && (strict || !line.contains("uid", ignoreCase = true))) continue
+                val u = (reUid.find(line) ?: (if (strict) null else reUid2.find(line)))?.groupValues?.get(1)?.toIntOrNull() ?: continue
+                if (u != uid) continue
+                if (sample.isEmpty() || (line.contains("started", ignoreCase = true) && !sample.contains("started"))) sample = line.trim().take(300)
+                var sid = reSid.find(line)?.groupValues?.get(1)?.toIntOrNull()
+                var started = line.contains("started", ignoreCase = true)
+                if (!strict && sid == null) {
+                    var j = i + 1
+                    while (j < lines.size && j <= i + 3 && !lines[j].contains("u/pid:") && !lines[j].contains("AudioPlaybackConfiguration")) {
+                        if (sid == null) sid = reSid.find(lines[j])?.groupValues?.get(1)?.toIntOrNull()
+                        if (lines[j].contains("started", ignoreCase = true)) started = true
+                        j++
+                    }
+                }
+                if (sid == null || sid <= 0) continue
+                if (best < 0 || (started && !bestStarted) || started == bestStarted) { best = sid; bestStarted = started }
+            }
+            return best
+        }
+        var best = when (fmt) {
+            2 -> find(true)
+            1 -> find(false)
+            else -> find(true).let { if (it > 0) it else find(false) }
+        }
+        var fromTracks = false
+        if (best <= 0) {
+            // Android 11 and older (for example Samsung A20) do not print the session id in dumpsys audio.
+            // Match the player's process id in the audio_flinger track list instead.
+            val pids = mutableListOf<Pair<Int, Boolean>>()
+            val rePid = Regex("u/pid:(\\d+)/(\\d+)")
+            for (l in lines) {
+                val m = rePid.find(l) ?: continue
+                if (m.groupValues[1].toIntOrNull() != uid) continue
+                val p = m.groupValues[2].toIntOrNull() ?: continue
+                pids.add(p to l.contains("started", ignoreCase = true))
+            }
+            if (pids.isNotEmpty()) {
+                val fl = run("dumpsys media.audio_flinger")
+                val sid = if (fl == null) -1 else sessionFromTracks(fl, pids)
+                if (sid > 0) { best = sid; fromTracks = true }
+            }
+        }
+        val fmtName = when (fmt) { 1 -> "Android 10-12 format"; 2 -> "Android 13+ format"; else -> "auto format" }
+        RasiNowPlayingViz.rootNote = if (best > 0) via + ": session " + best + " found (" + fmtName + (if (fromTracks) ", from the track list" else "") + ")"
+            else if (sample.isNotEmpty()) via + ": found the app but no session id (" + fmtName + "). Try another format in the Shizuku section. Line: " + sample
+            else via + ": no active playback of this app found (" + fmtName + "; it may use offload or direct output)"
+        return best
+    }
+}
