+/** Draws a transparent-background text sticker in the colours of an emoji. */
+object RasiTextSticker {
+    private fun dominantColor(emoji: String): Int {
+        val s = 48
+        val bmp = Bitmap.createBitmap(s, s, Bitmap.Config.ARGB_8888)
+        val c = Canvas(bmp)
+        val p = Paint(Paint.ANTI_ALIAS_FLAG)
+        p.textSize = s * 0.85f
+        p.textAlign = Paint.Align.CENTER
+        c.drawText(emoji, s / 2f, s * 0.8f, p)
+        val px = IntArray(s * s)
+        bmp.getPixels(px, 0, s, 0, 0, s, s)
+        var r = 0.0
+        var g = 0.0
+        var b = 0.0
+        var wsum = 0.0
+        val hsv = FloatArray(3)
+        for (x in px) {
+            if ((x ushr 24) < 128) continue
+            android.graphics.Color.colorToHSV(x, hsv)
+            val w = 0.2 + hsv[1] * hsv[2]
+            r += android.graphics.Color.red(x) * w
+            g += android.graphics.Color.green(x) * w
+            b += android.graphics.Color.blue(x) * w
+            wsum += w
+        }
+        bmp.recycle()
+        if (wsum == 0.0) return 0xFF5B8DEF.toInt()
+        val avg = android.graphics.Color.rgb((r / wsum).toInt(), (g / wsum).toInt(), (b / wsum).toInt())
+        android.graphics.Color.colorToHSV(avg, hsv)
+        hsv[1] = hsv[1].coerceIn(0.45f, 1f)
+        hsv[2] = hsv[2].coerceIn(0.55f, 0.85f)
+        return android.graphics.Color.HSVToColor(hsv)
+    }
+
+    private var face: Typeface? = null
+    private fun typeface(context: Context): Typeface = face ?: (try {
+        Typeface.createFromAsset(context.assets, "fonts/DynaPuff-Bold.ttf")
+    } catch (e: Exception) {
+        Typeface.create("sans-serif-black", Typeface.BOLD)
+    }).also { face = it }
+
+    private val previewCache = android.util.LruCache<String, ImageBitmap>(48)
+    private fun keyOf(phrase: String, emoji: String) = "v2|" + phrase + "|" + emoji
+
+    /** Small preview for the suggestion bar; cached in memory. Call off the main thread. */
+    fun preview(context: Context, phrase: String, emoji: String): ImageBitmap? {
+        val k = keyOf(phrase, emoji)
+        previewCache.get(k)?.let { return it }
+        val b = try { render(context, phrase, emoji, 200).asImageBitmap() } catch (e: Exception) { return null }
+        previewCache.put(k, b)
+        return b
+    }
+
+    /** Full-size sticker as a transparent WebP, cached on disk. Call off the main thread. */
+    fun file(context: Context, phrase: String, emoji: String): File {
+        val dir = File(context.cacheDir, "rasi_kitchen")
+        dir.mkdirs()
+        val f = File(dir, "text_" + Integer.toHexString(keyOf(phrase, emoji).hashCode()) + ".webp")
+        if (f.exists() && f.length() > 0) return f
+        val bmp = render(context, phrase, emoji, 512)
+        val fmt = if (android.os.Build.VERSION.SDK_INT >= 30) Bitmap.CompressFormat.WEBP_LOSSLESS
+        else @Suppress("DEPRECATION") Bitmap.CompressFormat.WEBP
+        val tmp = File(dir, f.name + ".tmp")
+        tmp.outputStream().use { bmp.compress(fmt, 100, it) }
+        bmp.recycle()
+        tmp.renameTo(f)
+        // keep the cache from growing forever
+        dir.listFiles { x -> x.name.startsWith("text_") }?.sortedByDescending { it.lastModified() }
+            ?.drop(60)?.forEach { it.delete() }
+        return f
+    }
+
+    fun render(context: Context, phrase: String, emoji: String, size: Int): Bitmap {
+        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bmp)
+        val color = dominantColor(emoji)
+
+        val tp = TextPaint(Paint.ANTI_ALIAS_FLAG)
+        tp.typeface = typeface(context)
+        val maxW = (size * 0.74f).toInt()
+        var ts = size * 0.22f
+        var layout: StaticLayout
+        while (true) {
+            tp.textSize = ts
+            layout = StaticLayout(phrase, tp, maxW, Layout.Alignment.ALIGN_CENTER, 0.95f, 0f, false)
+            if (layout.height <= size * 0.56f || ts <= size * 0.05f) break
+            ts *= 0.9f
+        }
+
+        // Small emoji around the words
+        val ep = Paint(Paint.ANTI_ALIAS_FLAG)
+        ep.textAlign = Paint.Align.CENTER
+        val decor = listOf(
+            Triple(0.15f, 0.15f, 0.20f), Triple(0.84f, 0.17f, 0.13f), Triple(0.50f, 0.07f, 0.10f),
+            Triple(0.12f, 0.85f, 0.13f), Triple(0.87f, 0.83f, 0.20f), Triple(0.50f, 0.94f, 0.10f)
+        )
+        decor.forEachIndexed { idx, (fx, fy, fs) ->
+            ep.textSize = size * fs
+            canvas.save()
+            canvas.rotate(if (idx % 2 == 0) -12f else 12f, size * fx, size * fy)
+            canvas.drawText(emoji, size * fx, size * fy + ep.textSize * 0.35f, ep)
+            canvas.restore()
+        }
+
+        canvas.save()
+        canvas.translate((size - maxW) / 2f, (size - layout.height) / 2f)
+        // No background and no white outline: just a darker offset "puff" under coloured text.
+        val hsv = FloatArray(3)
+        android.graphics.Color.colorToHSV(color, hsv)
+        hsv[2] *= 0.6f
+        val dark = android.graphics.Color.HSVToColor(hsv)
+        tp.style = Paint.Style.FILL
+        tp.color = dark
+        canvas.save()
+        canvas.translate(0f, ts * 0.07f)
+        layout.draw(canvas)
+        canvas.restore()
+        tp.color = color
+        layout.draw(canvas)
+        canvas.restore()
+        return bmp
+    }
+}
+
+@Composable
+fun rememberRasiCtx(manager: KeyboardManagerForAction?, key: Any?): State<RasiCtx> {
+    val context = LocalContext.current
+    val state = remember { mutableStateOf(RasiCtx()) }
+    LaunchedEffect(key) {
+        delay(60)
+        while (true) {
+            val ime = manager?.getLatinIMEForDebug()
+            if (ime != null && ime.isInputConnectionOverridden) {
+                // A search box (etc.) has the input right now; its text isn't the user's message
+                delay(300)
+                continue
+            }
+            val text = try {
+                ime?.currentInputConnection?.getTextBeforeCursor(300, 0)?.toString() ?: ""
+            } catch (e: Exception) {
+                ""
+            }
+            val ctx = withContext(Dispatchers.Default) { RasiKitchen.analyze(context, text) }
+            if (ctx != state.value) state.value = ctx
+            if (ctx.combos.isEmpty() && ctx.lastEmoji == null) RasiBarState.open.value = false
+            delay(300)
+        }
+    }
+    return state
+}
+
+/** The mashup sticker (or an "Aa" chip) on the left of the suggestion bar. */
+@Composable
+fun RowScope.RasiKitchenLeading(ctx: RasiCtx) {
+    val context = LocalContext.current
+    val first = ctx.combos.firstOrNull()
+    val img by produceState<ImageBitmap?>(null, first?.key) {
+        value = if (first != null) RasiKitchen.loadImage(context, first) else null
+    }
+    val b = img
+    if (first != null && b != null) {
+        Box(
+            Modifier.width(52.dp).fillMaxHeight().clickable { RasiBarState.open.value = true },
+            contentAlignment = Alignment.Center
+        ) {
+            Image(b, null, Modifier.size(40.dp), contentScale = ContentScale.Fit)
+        }
+    } else if (first == null && ctx.phrase != null && ctx.lastEmoji != null) {
+        val phrase: String = ctx.phrase
+        val emoji: String = ctx.lastEmoji
+        // Debounced: restarts (cancelling the previous render) on every change
+        val pv by produceState<ImageBitmap?>(null, phrase, emoji) {
+            delay(250)
+            value = withContext(Dispatchers.Default) { RasiTextSticker.preview(context, phrase, emoji) }
+        }
+        Box(
+            Modifier.width(52.dp).fillMaxHeight().clickable { RasiBarState.open.value = true },
+            contentAlignment = Alignment.Center
+        ) {
+            val p = pv
+            if (p != null) Image(p, null, Modifier.size(44.dp), contentScale = ContentScale.Fit)
+            else Text("Aa", fontSize = 18.sp)
+        }
+    }
+}
+
+@Composable
+fun RowScope.RasiKitchenStrip(ctx: RasiCtx, manager: KeyboardManagerForAction?) {
+    Box(
+        Modifier.padding(horizontal = 6.dp).size(34.dp).clip(CircleShape)
+            .background(MaterialTheme.colorScheme.surfaceVariant)
+            .clickable { RasiBarState.open.value = false },
+        contentAlignment = Alignment.Center
+    ) { Text("\u2715", fontSize = 16.sp) }
+
+    val listState = rememberLazyListState()
+    LaunchedEffect(ctx.combos.firstOrNull()?.key, ctx.lastEmoji, ctx.prevEmoji, ctx.phrase) {
+        listState.scrollToItem(0)
+    }
+    LazyRow(
+        Modifier.weight(1.0f).fillMaxHeight(),
+        state = listState,
+        horizontalArrangement = Arrangement.spacedBy(6.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        val phrase = ctx.phrase
+        val emoji = ctx.lastEmoji
+        if (phrase != null && emoji != null) {
+            item(key = "rasi_text_sticker") { TextStickerItem(phrase, emoji, manager) }
+        }
+        items(ctx.combos, key = { it.key }) { combo -> KitchenItem(combo, manager, ctx) }
+    }
+}
+
+@Composable
+private fun KitchenItem(combo: KitchenCombo, manager: KeyboardManagerForAction?, ctx: RasiCtx) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val img by produceState<ImageBitmap?>(null, combo.key) {
+        value = RasiKitchen.loadImage(context, combo)
+    }
+    Box(
+        Modifier.fillMaxHeight().padding(vertical = 3.dp).aspectRatio(1f)
+            .clip(RoundedCornerShape(8.dp))
+            .clickable {
+                val m = manager ?: return@clickable
+                scope.launch {
+                    val f = withContext(Dispatchers.IO) { RasiKitchen.fetch(context, combo) }
+                    if (f != null) {
+                        RasiKitchen.deleteTyped(m, ctx, combo)
+                        RasiKitchen.sendFile(m, f)
+                        RasiKitchen.addRecent(context, combo)
+                    }
+                }
+            },
+        contentAlignment = Alignment.Center
+    ) {
+        val b = img
+        if (b != null) Image(b, null, Modifier.fillMaxSize(), contentScale = ContentScale.Fit)
+    }
+}
+
+@Composable
+private fun TextStickerItem(phrase: String, emoji: String, manager: KeyboardManagerForAction?) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val img by produceState<ImageBitmap?>(null, phrase, emoji) {
+        delay(250)
+        value = withContext(Dispatchers.Default) { RasiTextSticker.preview(context, phrase, emoji) }
+    }
+    Box(
+        Modifier.fillMaxHeight().padding(vertical = 3.dp).aspectRatio(1f)
+            .clip(RoundedCornerShape(8.dp))
+            .clickable {
+                val m = manager ?: return@clickable
+                scope.launch {
+                    val f = withContext(Dispatchers.IO) { RasiTextSticker.file(context, phrase, emoji) }
+                    RasiKitchen.sendFile(m, f, "image/webp")
+                }
+            },
+        contentAlignment = Alignment.Center
+    ) {
+        val b = img
+        if (b != null) Image(b, null, Modifier.fillMaxSize(), contentScale = ContentScale.Fit)
+    }
+}
