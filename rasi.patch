+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+
+@Composable
+fun RasiGlassScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiNowPlaying.prefs(context) }
+    var glassAll by remember { mutableStateOf(prefs.getBoolean("glass_all", false)) }
+    var glassBg by remember { mutableStateOf(prefs.getBoolean("glass_bg", false)) }
+    var glassDyn by remember { mutableStateOf(prefs.getBoolean("glass_dyn", false)) }
+    var glassViz by remember { mutableStateOf(prefs.getBoolean("glass_viz", false)) }
+    var glassStrength by remember { mutableFloatStateOf(prefs.getInt("glass_strength", 60).toFloat()) }
+
+    @Composable
+    fun SwitchRow(title: String, hint: String, checked: Boolean, onChange: (Boolean) -> Unit) {
+        if (org.futo.inputmethod.latin.uix.settings.rasiRowHidden(title, hint)) return
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+            Column(Modifier.weight(1.0f)) {
+                Text(org.futo.inputmethod.latin.uix.settings.rasiHL(title))
+                Text(org.futo.inputmethod.latin.uix.settings.rasiHL(hint), style = MaterialTheme.typography.bodySmall)
+            }
+            Switch(checked = checked, onCheckedChange = onChange)
+        }
+    }
+
+    ScrollableList {
+        ScreenTitle("Liquid glass keyboard", showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            SwitchRow(
+                "Liquid glass keyboard",
+                "Turns any theme into glass: see-through keys with bright edges over a soft glow. Works on its own.",
+                glassAll
+            ) { glassAll = it; prefs.edit().putBoolean("glass_all", it).apply(); RasiNowPlaying.notifyChanged() }
+            Text("Glass strength: " + glassStrength.toInt() + " %")
+            Slider(
+                value = glassStrength, onValueChange = { glassStrength = it }, valueRange = 10f..100f,
+                onValueChangeFinished = { prefs.edit().putInt("glass_strength", glassStrength.toInt()).apply(); RasiNowPlaying.notifyChanged() }
+            )
+            Text("Or turn glass on only while a Now playing mode is on:", style = MaterialTheme.typography.titleMedium)
+            SwitchRow("Glass with song background", "Glass keys while the cover background is on.", glassBg) {
+                glassBg = it; prefs.edit().putBoolean("glass_bg", it).apply(); RasiNowPlaying.notifyChanged()
+            }
+            SwitchRow("Glass with dynamic theme", "Glass keys while the dynamic theme is on.", glassDyn) {
+                glassDyn = it; prefs.edit().putBoolean("glass_dyn", it).apply(); RasiNowPlaying.notifyChanged()
+            }
+            SwitchRow("Glass with visualizer", "Glass keys while the visualizer is on.", glassViz) {
+                glassViz = it; prefs.edit().putBoolean("glass_viz", it).apply(); RasiNowPlaying.notifyChanged()
+            }
+        }
+    }
+}
