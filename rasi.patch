+import org.futo.inputmethod.latin.uix.theme.RasiThemeShare
+import org.futo.inputmethod.latin.uix.theme.selector.ThemePreview
+
+/** Shown when a .rboardtheme file is opened: preview first, nothing is applied until the person taps Import. */
+@Composable
+fun RasiThemeImportScreen(
+    insp: RasiThemeShare.Inspect,
+    onImport: (withSounds: Boolean, useNow: Boolean) -> Unit,
+    onCancel: () -> Unit
+) {
+    var withSounds by remember { mutableStateOf(true) }
+    var useNow by remember { mutableStateOf(true) }
+
+    ScrollableList {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(stringResource(R.string.rasi_theme_import_title))
+
+            val scheme = insp.scheme
+            if (insp.error != null || scheme == null) {
+                Text(insp.error ?: stringResource(R.string.rasi_theme_import_bad))
+                Button(onClick = onCancel) { Text(stringResource(R.string.rasi_theme_import_close)) }
+            } else {
+                Box(Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) {
+                    ThemePreview(
+                        colors = scheme,
+                        name = insp.name,
+                        loading = false,
+                        modifier = Modifier.width(240.dp)
+                    )
+                }
+                if (insp.author.isNotBlank()) Text(stringResource(R.string.rasi_theme_import_author, insp.author))
+                Text(stringResource(R.string.rasi_theme_import_safe))
+
+                if (insp.soundSlots.isNotEmpty()) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Checkbox(checked = withSounds, onCheckedChange = { withSounds = it })
+                        Text(stringResource(R.string.rasi_theme_import_sounds, insp.soundSlots.size))
+                    }
+                }
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Checkbox(checked = useNow, onCheckedChange = { useNow = it })
+                    Text(stringResource(R.string.rasi_theme_import_use))
+                }
+
+                Button(
+                    onClick = { onImport(withSounds && insp.soundSlots.isNotEmpty(), useNow) },
+                    modifier = Modifier.fillMaxWidth()
+                ) { Text(stringResource(R.string.rasi_theme_import_button)) }
+                OutlinedButton(onClick = onCancel, modifier = Modifier.fillMaxWidth()) {
+                    Text(stringResource(R.string.rasi_theme_import_cancel))
+                }
+            }
+        }
+    }
+}
