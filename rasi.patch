+/** Name and avatar of the author of the replied-to message. */
+private fun replyAuthor(c: ChatCtx, m: RasiChats.Msg, all: List<RasiChats.Msg>): Triple<String, Int, Pair<String, Int>> {
+    val from = m.replyFrom.ifBlank { all.firstOrNull { it.id == m.replyId }?.from ?: "" }
+    return if (from.isNotBlank() && from == c.uid) Triple(c.myName, c.myAccent, c.myAv to c.myAvColor)
+    else c.who?.invoke(from) ?: Triple(c.fName, c.fAccent, c.fAv to c.fAvColor)
+}
