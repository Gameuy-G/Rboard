+                }
+
+                fun equals() {
+                    if (expr.value.isBlank()) return
+                    try {
+                        val v = RasiCalcEngine.eval(expr.value, deg.value, ans.value, mem.value)
+                        val r = RasiCalcEngine.format(v)
+                        val entry = expr.value + " = " + r
+                        CalcHistory.add(context, entry)
+                        history.add(0, entry)
+                        ans.value = v
+                        result.value = r
+                        fresh.value = true
+                    } catch (e: Exception) {
+                        result.value = e.message ?: "Error"
+                        fresh.value = false
+                    }
+                }
+
+                fun memOp(sign: Int) {
+                    try {
+                        val v = if (result.value.isNotEmpty() && fresh.value) ans.value
+                        else RasiCalcEngine.eval(expr.value, deg.value, ans.value, mem.value)
+                        mem.value += sign * v
+                    } catch (e: Exception) { }
+                }
+
+                fun swapFraction() {
+                    try {
+                        val v = if (fresh.value && result.value.isNotEmpty()) ans.value
+                        else RasiCalcEngine.eval(expr.value, deg.value, ans.value, mem.value)
+                        result.value = if (result.value.contains('\u2044')) RasiCalcEngine.format(v)
+                        else (RasiCalcEngine.fraction(v) ?: RasiCalcEngine.format(v))
+                    } catch (e: Exception) { }
+                }
+
+                val s2 = second.value
+                val hp = hyp.value
+                fun trig(n: String): String = (if (s2) "a" else "") + n + (if (hp) "h" else "")
+
+                val modeRow = listOf(
+                    CalcKey(if (s2) "2nd *" else "2nd", 3) { second.value = !second.value },
+                    CalcKey(if (hp) "hyp *" else "hyp", 3) { hyp.value = !hyp.value },
+                    CalcKey(if (deg.value) "DEG" else "RAD", 3) { deg.value = !deg.value; preview() },
+                    CalcKey("MC", 3) { mem.value = 0.0 },
+                    CalcKey("MR", 3) { put("M") },
+                    CalcKey("M+", 3) { memOp(1) },
+                    CalcKey("M\u2212", 3) { memOp(-1) },
+                )
+                val sci = listOf(
+                    modeRow,
+                    listOf(
+                        CalcKey(trig("sin"), 1) { put(trig("sin") + "(") },
+                        CalcKey(trig("cos"), 1) { put(trig("cos") + "(") },
+                        CalcKey(trig("tan"), 1) { put(trig("tan") + "(") },
+                        CalcKey(if (s2) "10^x" else "log", 1) { put(if (s2) "10^(" else "log(") },
+                        CalcKey(if (s2) "e^x" else "ln", 1) { put(if (s2) "exp(" else "ln(") },
+                        CalcKey(if (s2) "\u221B" else "\u221A", 1) { put(if (s2) "\u221B(" else "\u221A(") },
+                        CalcKey(if (s2) "abs" else "S\u21D4D", 1) { if (s2) put("abs(") else swapFraction() },
+                    ),
+                    listOf(
+                        CalcKey(if (s2) "x\u00B3" else "x\u00B2", 1) { put(if (s2) "^3" else "^2") },
+                        CalcKey("x^y", 1) { put("^") },
+                        CalcKey("1/x", 1) { put("^(-1)") },
+                        CalcKey("n!", 1) { put("!") },
+                        CalcKey("nPr", 1) { put("P") },
+                        CalcKey("nCr", 1) { put("C") },
+                        CalcKey("%", 1) { put("%") },
+                    ),
+                    listOf(
+                        CalcKey("(", 1) { put("(") },
+                        CalcKey(")", 1) { put(")") },
+                        CalcKey("\u03C0", 1) { put("\u03C0") },
+                        CalcKey("e", 1) { put("e") },
+                        CalcKey("Ans", 1) { put("Ans") },
+                        CalcKey("EXP", 1) { put("\u00D710^(") },
+                        CalcKey("a/b", 1) { put("\u2044") },
+                    ),
+                )
+                val pad = listOf(
+                    listOf(
+                        CalcKey("7") { put("7") }, CalcKey("8") { put("8") }, CalcKey("9") { put("9") },
+                        CalcKey("\u00F7", 1) { put("\u00F7") }, CalcKey("DEL", 3) {
+                            if (fresh.value) { expr.value = ""; fresh.value = false }
+                            else expr.value = expr.value.dropLast(1)
+                            preview()
+                        },
+                    ),
+                    listOf(
+                        CalcKey("4") { put("4") }, CalcKey("5") { put("5") }, CalcKey("6") { put("6") },
+                        CalcKey("\u00D7", 1) { put("\u00D7") }, CalcKey("AC", 3) {
+                            expr.value = ""; result.value = ""; fresh.value = false
+                        },
+                    ),
+                    listOf(
+                        CalcKey("1") { put("1") }, CalcKey("2") { put("2") }, CalcKey("3") { put("3") },
+                        CalcKey("\u2212", 1) { put("\u2212") }, CalcKey("Hist", 3) { showHistory.value = !showHistory.value },
+                    ),
+                    listOf(
+                        CalcKey("0") { put("0") }, CalcKey(".") { put(".") }, CalcKey("\u00B1") { put("\u2212") },
+                        CalcKey("+", 1) { put("+") }, CalcKey("=", 2) { equals() },
+                    ),
+                )
+
+                BoxWithConstraints(Modifier.fillMaxSize()) {
+                    val landscape = maxWidth > maxHeight * 1.3f
+                    Column(Modifier.fillMaxSize().padding(horizontal = 4.dp)) {
+                        Column(Modifier.fillMaxWidth().padding(horizontal = 6.dp)) {
+                            Text(
+                                expr.value.ifEmpty { " " },
+                                fontSize = 18.sp,
+                                maxLines = 1,
+                                textAlign = TextAlign.End,
+                                modifier = Modifier.fillMaxWidth().horizontalScroll(rememberScrollState(Int.MAX_VALUE))
+                            )
+                            Row(verticalAlignment = Alignment.CenterVertically) {
+                                if (mem.value != 0.0) Text("M ", fontSize = 12.sp)
+                                Text(
+                                    result.value.ifEmpty { " " },
+                                    fontSize = 26.sp,
+                                    maxLines = 1,
+                                    textAlign = TextAlign.End,
+                                    modifier = Modifier.weight(1.0f)
+                                )
+                                if (result.value.isNotEmpty()) {
+                                    Surface(
+                                        shape = RoundedCornerShape(16.dp),
+                                        color = LocalKeyboardScheme.current.primary,
+                                        modifier = Modifier.padding(start = 8.dp).clickable {
+                                            val r = result.value
+                                            if (r.isNotEmpty() && r != "Math error" && r != "Syntax error") {
+                                                manager.typeText(r.replace('\u2044', '/'))
+                                            }
+                                        }
+                                    ) {
+                                        Text(
+                                            "Insert",
+                                            color = LocalKeyboardScheme.current.onPrimary,
+                                            modifier = Modifier.padding(horizontal = 12.dp, vertical = 6.dp)
+                                        )
+                                    }
+                                }
+                            }
+                        }
+                        if (showHistory.value) {
+                            Column(Modifier.weight(1.0f).fillMaxWidth()) {
+                                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                                    Text("History", modifier = Modifier.padding(6.dp))
+                                    Text("Clear", modifier = Modifier.padding(6.dp).clickable {
+                                        CalcHistory.clear(context); history.clear()
+                                    })
+                                    Text("Back", modifier = Modifier.padding(6.dp).clickable { showHistory.value = false })
+                                }
+                                LazyColumn(Modifier.weight(1.0f)) {
+                                    items(history.toList()) { h ->
+                                        Text(
+                                            h,
+                                            modifier = Modifier.fillMaxWidth().clickable {
+                                                val r = h.substringAfterLast(" = ")
+                                                put(r)
+                                                showHistory.value = false
+                                            }.padding(8.dp)
+                                        )
+                                    }
+                                }
+                            }
+                        } else if (landscape) {
+                            Row(Modifier.weight(1.0f).fillMaxWidth()) {
+                                CalcRows(sci, Modifier.weight(1.4f).fillMaxSize())
+                                CalcRows(pad, Modifier.weight(1.0f).fillMaxSize())
+                            }
+                        } else {
+                            CalcRows(sci, Modifier.weight(1.0f).fillMaxWidth())
+                            CalcRows(pad, Modifier.weight(1.1f).fillMaxWidth())
+                        }
+                    }
+                }
+            }
+        }
+    },
+)
