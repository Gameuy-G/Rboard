+/** Classic rounded bubble (the original look) with edited tag, mention highlight and tap-to-jump reply line. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+internal fun BubbleMsg(
+    c: ChatCtx, m: RasiChats.Msg, flash: Boolean, seen: Boolean, fg: Color, bg: Color, radius: Int,
+    longEnabled: Boolean, onJump: (String) -> Unit, onReact: (String) -> Unit, onLong: () -> Unit, menu: @Composable () -> Unit
+) {
+    val look = c.look
+    val isMine = m.from == c.uid
+    val pingMe = look.pingOn && m.ping && !isMine
+    val shape = RoundedCornerShape(radius.dp)
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = if (isMine) Arrangement.End else Arrangement.Start) {
+        Box {
+            Column(
+                Modifier.fillMaxWidth(0.8f).clip(shape)
+                    .background(if (flash) look.pingColor.copy(alpha = 0.45f) else bg)
+                    .then(if (pingMe && look.pingBar) Modifier.border(2.dp, look.pingColor, shape) else Modifier)
+                    .combinedClickable(enabled = longEnabled, onClick = {}, onLongClick = onLong)
+                    .padding(horizontal = 12.dp, vertical = 8.dp),
+                horizontalAlignment = if (isMine) Alignment.End else Alignment.Start
+            ) {
+                if (!isMine && c.who != null) Text(c.who.invoke(m.from).first, fontSize = (c.size - 3).coerceAtLeast(10).sp, fontWeight = FontWeight.Bold, color = fg.copy(alpha = 0.85f), maxLines = 1)
+                if (m.replyText.isNotBlank()) Text(m.replyText, fontSize = (c.size - 3).coerceAtLeast(10).sp, maxLines = 2, overflow = TextOverflow.Ellipsis,
+                    color = fg.copy(alpha = 0.7f),
+                    modifier = Modifier.padding(bottom = 4.dp).then(if (look.jump) Modifier.clickable { onJump(m.replyId) } else Modifier))
+                Text(mentionText(m.text, c, m, fg.copy(alpha = 0.7f)), fontSize = c.size.sp, color = fg)
+                ReactionRow(c, m, onReact)
+                if (c.showTime && m.at > 0L) Text(chatHm(m.at, true), fontSize = 10.sp, color = fg.copy(alpha = 0.7f))
+                if (seen) Text("Seen", fontSize = 10.sp, color = fg.copy(alpha = 0.7f))
+            }
+            menu()
