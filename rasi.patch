+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+import org.futo.inputmethod.updates.openURI
+
+@Composable
+fun RasiUpdateScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    var result by remember { mutableStateOf<RasiUpdate.Result?>(null) }
+    var round by remember { mutableIntStateOf(0) }
+
+    LaunchedEffect(round) {
+        result = null
+        result = withContext(Dispatchers.IO) { RasiUpdate.check() }
+    }
+
+    val scope = rememberCoroutineScope()
+    val hours by context.getSettingFlow(RasiUpdateHoursSetting.key, RasiUpdateHoursSetting.default)
+        .collectAsState(initial = RasiUpdateHoursSetting.default)
+    val auto by context.getSettingFlow(RasiAutoUpdateSetting.key, RasiAutoUpdateSetting.default)
+        .collectAsState(initial = RasiAutoUpdateSetting.default)
+    LaunchedEffect(auto) { withContext(Dispatchers.IO) { RasiUpdateNotifier.schedule(context) } }
+    val askNotif = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { }
+    LaunchedEffect(Unit) {
+        if (android.os.Build.VERSION.SDK_INT >= 33) askNotif.launch(android.Manifest.permission.POST_NOTIFICATIONS)
+    }
+
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.rasi_update_title), showBack = true, navController)
+        SettingToggleDataStore(title = stringResource(R.string.rasi_update_auto), setting = RasiAutoUpdateSetting)
+        SettingToggleDataStore(title = stringResource(R.string.rasi_update_notify), setting = RasiUpdateNotifySetting)
+        SettingToggleDataStore(title = stringResource(R.string.rasi_notice_setting), setting = RasiNoticesSetting)
+        SettingToggleDataStore(title = stringResource(R.string.rasi_push_setting), setting = org.futo.inputmethod.latin.uix.RasiPushSetting)
+        Row(
+            Modifier.fillMaxWidth().padding(horizontal = 16.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            Text(stringResource(R.string.rasi_update_interval), Modifier.padding(end = 4.dp))
+            listOf(12, 24, 48).forEach { h ->
+                val label = stringResource(R.string.rasi_update_hours_fmt, h)
+                OutlinedButton(onClick = {
+                    scope.launch {
+                        context.setSetting(RasiUpdateHoursSetting.key, h)
+                        RasiUpdateNotifier.schedule(context)
+                    }
+                }) { Text(if (hours == h) "\u2713 $label" else label) }
+            }
+        }
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            val r = result
+            if (r == null) {
+                Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                    CircularProgressIndicator()
+                    Text(stringResource(R.string.rasi_update_checking))
+                }
+            } else {
+                Text(
+                    when (r) {
+                        is RasiUpdate.Result.UpToDate -> stringResource(R.string.rasi_update_uptodate)
+                        is RasiUpdate.Result.Available -> stringResource(R.string.rasi_update_available)
+                        is RasiUpdate.Result.BuildPending -> stringResource(R.string.rasi_update_pending)
+                        is RasiUpdate.Result.UnknownBuild -> stringResource(R.string.rasi_update_unknown)
+                        is RasiUpdate.Result.Error -> stringResource(R.string.rasi_update_error, r.message)
+                    }
+                )
+                if (r is RasiUpdate.Result.Available) {
+                    Button(
+                        onClick = { context.openURI(RasiUpdate.APK_URL, newTask = true) },
+                        modifier = Modifier.fillMaxWidth()
+                    ) { Text(stringResource(R.string.rasi_update_download)) }
+                }
+                OutlinedButton(
+                    onClick = {
+                        scope.launch {
+                            val n = withContext(Dispatchers.IO) { RasiNotice.check(context) }
+                            android.widget.Toast.makeText(
+                                context,
+                                if (n > 0) R.string.rasi_notice_got else R.string.rasi_notice_none,
+                                android.widget.Toast.LENGTH_SHORT
+                            ).show()
+                        }
+                    },
+                    modifier = Modifier.fillMaxWidth()
+                ) { Text(stringResource(R.string.rasi_notice_now)) }
+                OutlinedButton(onClick = { round++ }, modifier = Modifier.fillMaxWidth()) {
+                    Text(stringResource(R.string.rasi_update_again))
+                }
+                OutlinedButton(
+                    onClick = { context.openURI(RasiUpdate.RELEASES_URL, newTask = true) },
+                    modifier = Modifier.fillMaxWidth()
+                ) { Text(stringResource(R.string.rasi_update_releases)) }
+            }
+            Text(stringResource(R.string.rasi_update_build, RasiUpdate.installedId().take(7)))
+        }
+    }
+}
