+/** Look of the Gemini panel: follows the keyboard theme, or its own colors, gradient, glass and roundness. */
+object RasiGeminiThemePrefs {
+    const val NAME = "rasi_gemini_theme"
+    fun prefs(context: Context): SharedPreferences =
+        context.applicationContext.getSharedPreferences(NAME, Context.MODE_PRIVATE)
+
+    fun gradientColors(p: SharedPreferences): List<Int> {
+        val n = p.getInt("grad_count", 2).coerceIn(2, 4)
+        val defaults = listOf(0xFF102A43.toInt(), 0xFF243B53.toInt(), 0xFF3E4C59.toInt(), 0xFF486581.toInt())
+        return List(n) { p.getInt("grad_$it", defaults[it]) }
+    }
+
+    @JvmField var glassOn: Boolean = true
+    @JvmField var meColor: Int = 0
+    @JvmField var aiColor: Int = 0
+
+    @JvmStatic fun refresh(c: Context) {
+        val p = prefs(c)
+        glassOn = p.getBoolean("glass_on", true)
+        meColor = p.getInt("bubble_me", 0)
+        aiColor = p.getInt("bubble_ai", 0)
+    }
+
+    fun bgFile(c: Context) = java.io.File(c.applicationContext.filesDir, "gemini_bg.jpg")
+
+    fun loadBackground(c: Context): android.graphics.Bitmap? {
+        if (!prefs(c).getBoolean("bg_on", false)) return null
+        val f = bgFile(c)
+        if (!f.exists()) return null
+        return try { android.graphics.BitmapFactory.decodeFile(f.absolutePath) } catch (e: Throwable) { null }
+    }
+
+    @JvmStatic fun glass(context: Context): Float = prefs(context).getFloat("glass", 1f).coerceIn(0.4f, 1.8f)
+    @JvmStatic fun round(context: Context): Float = prefs(context).getFloat("round", 20f).coerceIn(6f, 30f)
+}
+
+/** Wraps the Gemini panel in its own theme (and gradient background) when a custom one is chosen. */
+@Composable
+fun RasiGeminiThemeWrap(content: @Composable () -> Unit) {
+    val context = LocalContext.current
+    val prefs = remember { RasiGeminiThemePrefs.prefs(context) }
+    var version by remember { mutableIntStateOf(0) }
+    DisposableEffect(prefs) {
+        val l = SharedPreferences.OnSharedPreferenceChangeListener { _, _ -> version++ }
+        prefs.registerOnSharedPreferenceChangeListener(l)
+        onDispose { prefs.unregisterOnSharedPreferenceChangeListener(l) }
+    }
+    val bg = remember(version) { RasiGeminiThemePrefs.loadBackground(context) }
+    val dim = if (version >= 0) prefs.getFloat("bg_dim", 0.45f) else 0f
+    val blurDp = if (version >= 0 && !org.futo.inputmethod.latin.uix.RasiPerf.isOn()) prefs.getFloat("bg_blur", 0f) else 0f
+    val inner: @Composable () -> Unit = {
+        Box(Modifier.fillMaxSize()) {
+            if (bg != null) {
+                androidx.compose.foundation.Image(
+                    bg.asImageBitmap(), null,
+                    Modifier.fillMaxSize().blur(blurDp.dp, androidx.compose.ui.draw.BlurredEdgeTreatment.Unbounded),
+                    contentScale = androidx.compose.ui.layout.ContentScale.Crop
+                )
+                Box(Modifier.fillMaxSize().background(Color.Black.copy(alpha = dim.coerceIn(0f, 0.9f))))
+            }
+            content()
+        }
+    }
+    if (version >= 0 && prefs.getInt("mode", 0) == 1) {
+        val accent = prefs.getInt("accent", 0xFF4F8CFF.toInt())
+        val dark = prefs.getBoolean("dark", true)
+        val scheme = remember(accent, dark) { schemeFromAccent(accent, dark) }
+        val brush: Brush? = if (prefs.getBoolean("grad_on", false)) {
+            angledBrush(RasiGeminiThemePrefs.gradientColors(prefs), prefs.getFloat("grad_angle", 90f))
+        } else null
+        UixThemeWrapper(colorScheme = scheme) {
+            Box(Modifier.fillMaxSize().then(if (brush != null) Modifier.background(brush) else Modifier)) {
+                inner()
+            }
+        }
+    } else {
+        inner()
+    }
+}
+
+@Composable
+fun RasiGeminiThemeScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiGeminiThemePrefs.prefs(context) }
+
+    var mode by remember { mutableIntStateOf(prefs.getInt("mode", 0)) }
+    var dark by remember { mutableStateOf(prefs.getBoolean("dark", true)) }
+    var accent by remember { mutableIntStateOf(prefs.getInt("accent", 0xFF4F8CFF.toInt())) }
+    var gradOn by remember { mutableStateOf(prefs.getBoolean("grad_on", false)) }
+    var angle by remember { mutableFloatStateOf(prefs.getFloat("grad_angle", 90f)) }
+    var glass by remember { mutableFloatStateOf(prefs.getFloat("glass", 1f)) }
+    var round by remember { mutableFloatStateOf(prefs.getFloat("round", 20f)) }
+    val gradColors = remember { mutableStateListOfInts(RasiGeminiThemePrefs.gradientColors(prefs)) }
+    var selected by remember { mutableIntStateOf(0) }
+
+    fun saveGrad() {
+        prefs.edit().apply {
+            putInt("grad_count", gradColors.size)
+            gradColors.forEachIndexed { i, c -> putInt("grad_$i", c) }
+            putFloat("grad_angle", angle)
+        }.apply()
+    }
+
+    ScrollableList {
+        ScreenTitle("Gemini theme", showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                val setMode = { m: Int -> mode = m; prefs.edit().putInt("mode", m).apply() }
+                if (mode == 0) {
+                    Button(onClick = { setMode(0) }) { Text("Follow keyboard") }
+                    OutlinedButton(onClick = { setMode(1) }) { Text("Custom") }
+                } else {
+                    OutlinedButton(onClick = { setMode(0) }) { Text("Follow keyboard") }
+                    Button(onClick = { setMode(1) }) { Text("Custom") }
+                }
+            }
+
+            if (mode == 1) {
+                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.SpaceBetween) {
+                    Text("Dark mode")
+                    Switch(checked = dark, onCheckedChange = { dark = it; prefs.edit().putBoolean("dark", it).apply() })
+                }
+                Text("Accent color (your bubbles, buttons)")
+                HsvPicker(accent, "gaccent") { accent = it; prefs.edit().putInt("accent", it).apply() }
+
+                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.SpaceBetween) {
+                    Text("Gradient background")
+                    Switch(checked = gradOn, onCheckedChange = { gradOn = it; prefs.edit().putBoolean("grad_on", it).apply() })
+                }
+                if (gradOn) {
+                    Row(Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp),
+                        verticalAlignment = Alignment.CenterVertically) {
+                        gradColors.forEachIndexed { i, c ->
+                            Row(Modifier.size(40.dp).clip(CircleShape).background(Color(c))
+                                .border(if (i == selected) 3.dp else 1.dp, if (i == selected) Color.White else Color.Gray, CircleShape)
+                                .clickable { selected = i }) {}
+                        }
+                    }
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        if (gradColors.size < 4) OutlinedButton(onClick = {
+                            gradColors.add(gradColors.last()); selected = gradColors.size - 1; saveGrad()
+                        }) { Text("Add color") }
+                        if (gradColors.size > 2) OutlinedButton(onClick = {
+                            gradColors.removeAt(selected.coerceIn(0, gradColors.size - 1)); selected = 0; saveGrad()
+                        }) { Text("Remove color") }
+                    }
+                    val sel = selected.coerceIn(0, gradColors.size - 1)
+                    HsvPicker(gradColors[sel], sel to gradColors.size) { gradColors[sel] = it; saveGrad() }
+                    LabeledSlider(label = "Angle", value = angle.coerceIn(0f, 360f), valueRange = 0f..360f,
+                        gradient = Brush.horizontalGradient(listOf(Color(0xFF555555), Color(0xFFBBBBBB)))) {
+                        angle = it; saveGrad()
+                    }
+                }
+            }
+
+            // these two work in both modes
+            Text("Look")
+            var glassOn by remember { mutableStateOf(prefs.getBoolean("glass_on", true)) }
+            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.SpaceBetween) {
+                Text("Glass look (turn off for solid bubbles)")
+                Switch(checked = glassOn, onCheckedChange = { glassOn = it; prefs.edit().putBoolean("glass_on", it).apply() })
+            }
+            var meColor by remember { mutableIntStateOf(prefs.getInt("bubble_me", 0)) }
+            var aiColor by remember { mutableIntStateOf(prefs.getInt("bubble_ai", 0)) }
+            Text("Your bubble color" + if (meColor == 0) " (theme)" else "")
+            HsvPicker(if (meColor == 0) 0xFF4F8CFF.toInt() else meColor, "gme") { meColor = it; prefs.edit().putInt("bubble_me", it).apply() }
+            if (meColor != 0) OutlinedButton(onClick = { meColor = 0; prefs.edit().putInt("bubble_me", 0).apply() }) { Text("Use theme color") }
+            Text("Gemini bubble color" + if (aiColor == 0) " (theme)" else "")
+            HsvPicker(if (aiColor == 0) 0xFF9AA0A6.toInt() else aiColor, "gai") { aiColor = it; prefs.edit().putInt("bubble_ai", it).apply() }
+            if (aiColor != 0) OutlinedButton(onClick = { aiColor = 0; prefs.edit().putInt("bubble_ai", 0).apply() }) { Text("Use theme color") }
+
+            Text("Background picture")
+            var bgOn by remember { mutableStateOf(prefs.getBoolean("bg_on", false)) }
+            var bgDim by remember { mutableFloatStateOf(prefs.getFloat("bg_dim", 0.45f)) }
+            var bgBlur by remember { mutableFloatStateOf(prefs.getFloat("bg_blur", 0f)) }
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                Button(onClick = {
+                    val pi = android.content.Intent(context, org.futo.inputmethod.latin.uix.actions.RasiPickerActivity::class.java)
+                    pi.putExtra("kind", "geminibg")
+                    pi.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK)
+                    context.startActivity(pi)
+                }) { Text("Choose picture") }
+                if (bgOn) OutlinedButton(onClick = {
+                    bgOn = false; prefs.edit().putBoolean("bg_on", false).apply()
+                    RasiGeminiThemePrefs.bgFile(context).delete()
+                }) { Text("Remove") }
+            }
+            LabeledSlider(label = "Picture dimming", value = bgDim.coerceIn(0f, 0.9f), valueRange = 0f..0.9f,
+                gradient = Brush.horizontalGradient(listOf(Color(0xFFDDDDDD), Color(0xFF111111)))) {
+                bgDim = it; prefs.edit().putFloat("bg_dim", it).apply()
+            }
+            LabeledSlider(label = "Picture blur", value = bgBlur.coerceIn(0f, 25f), valueRange = 0f..25f,
+                gradient = Brush.horizontalGradient(listOf(Color(0xFF333333), Color(0xFFDDDDDD)))) {
+                bgBlur = it; prefs.edit().putFloat("bg_blur", it).apply()
+            }
+
+            Text("Message bubbles")
+            LabeledSlider(label = "Glass strength", value = glass.coerceIn(0.4f, 1.8f), valueRange = 0.4f..1.8f,
+                gradient = Brush.horizontalGradient(listOf(Color(0xFF333333), Color(0xFFDDDDDD)))) {
+                glass = it; prefs.edit().putFloat("glass", it).apply()
+            }
+            LabeledSlider(label = "Roundness", value = round.coerceIn(6f, 30f), valueRange = 6f..30f,
+                gradient = Brush.horizontalGradient(listOf(Color(0xFF333333), Color(0xFFDDDDDD)))) {
+                round = it; prefs.edit().putFloat("round", it).apply()
+            }
+        }
+    }
+}
