+import kotlinx.coroutines.launch
+
+/** True for real emoji; false for kaomoji / text faces like (¬_¬"). */
+fun isRealEmoji(s: String): Boolean {
+    if (s.isBlank()) return false
+    var hasEmoji = false
+    var i = 0
+    while (i < s.length) {
+        val cp = s.codePointAt(i)
+        i += Character.charCount(cp)
+        if (cp < 0x80 && !(cp in 0x30..0x39 || cp == 0x23 || cp == 0x2A)) return false
+        if (cp in 0x1F000..0x1FAFF || cp in 0x2600..0x27BF || cp in 0x2B00..0x2BFF ||
+            cp in 0x2300..0x23FF || cp == 0xA9 || cp == 0xAE || cp == 0x203C ||
+            cp == 0x2049 || cp == 0x2122 || cp in 0x2190..0x21FF) hasEmoji = true
+    }
+    return hasEmoji
+}
+
+/** Shown in the suggestion bar while the symbols (?123) screen is open, like Gboard. */
+@Composable
+fun RowScope.RecentEmojiStrip() {
+    val context = LocalContext.current
+    val manager = LocalManager.current
+    val scope = rememberCoroutineScope()
+    val recent = remember { mutableStateOf(listOf("😂", "❤️", "👍", "😭", "🔥", "🎉")) }
+
+    LaunchedEffect(Unit) {
+        val list = with(EmojiTracker) { context.getRecentEmojis() }
+            .filter { isRealEmoji(it) }
+        val defaults = listOf("😂", "❤️", "👍", "😭", "🔥", "🎉", "😊", "🥺")
+        recent.value = (list + defaults.filter { it !in list }).take(6)
+    }
+
+    recent.value.forEach { emoji ->
+        Box(
+            modifier = Modifier
+                .weight(1.0f)
+                .fillMaxHeight()
+                .clickable {
+                    manager.typeText(emoji)
+                    scope.launch { with(EmojiTracker) { context.useEmoji(emoji) } }
+                },
+            contentAlignment = Alignment.Center
+        ) {
+            Text(emoji, fontSize = 22.sp)
+        }
+    }
+}
+
+/** Emoji kept on the right of the suggestion bar after tapping an emoji suggestion. */
+@Composable
+fun RowScope.RasiStickyEmoji() {
+    val emojis = org.futo.inputmethod.latin.rasi.RasiState.stickyEmoji.value
+    if (emojis.isEmpty()) return
+    val manager = LocalManager.current
+    emojis.forEach { emoji ->
+        SuggestionSeparator()
+        Box(
+            modifier = Modifier
+                .weight(1.0f)
+                .fillMaxHeight()
+                .clickable {
+                    org.futo.inputmethod.latin.rasi.RasiEmojiLearn.noteTapped(emoji)
+                    manager.typeText(emoji)
+                },
+            contentAlignment = Alignment.Center
+        ) {
+            Text(emoji, fontSize = 22.sp)
+        }
+    }
+}
