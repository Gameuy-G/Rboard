diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiUpdate.kt b/java/src/org/futo/inputmethod/latin/uix/RasiUpdate.kt
new file mode 100644
index 000000000..ff308afc9
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiUpdate.kt
@@ -0,0 +1,86 @@
+package org.futo.inputmethod.latin.uix
+
+import org.futo.inputmethod.latin.BuildConfig
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.text.SimpleDateFormat
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * Tells you whether a newer Rboard build exists. Every build remembers a fingerprint of the
+ * rasi.patch it was made from. The check compares it with the rasi.patch now on GitHub, and also
+ * makes sure the build for it has actually been published.
+ */
+object RasiUpdate {
+    const val OWNER_REPO = "Gameuy-G/Rboard"
+    const val APK_URL = "https://github.com/Gameuy-G/Rboard/releases/download/latest/rasi-keyboard.apk"
+    const val RELEASES_URL = "https://github.com/Gameuy-G/Rboard/releases"
+
+    sealed class Result {
+        object UpToDate : Result()
+        object Available : Result()
+        /** The patch on GitHub changed but no newer build is published yet (still building, or failed). */
+        object BuildPending : Result()
+        object UnknownBuild : Result()
+        class Error(val message: String) : Result()
+    }
+
+    fun installedId(): String = BuildConfig.RASI_PATCH_ID
+
+    /** Patch id found on GitHub by the last check(); used to notify once per build. */
+    @Volatile var latestRepoId: String? = null
+
+    private fun get(url: String): String {
+        val c = URL(url).openConnection() as HttpURLConnection
+        try {
+            c.connectTimeout = 10000
+            c.readTimeout = 15000
+            c.setRequestProperty("Accept", "application/vnd.github+json")
+            c.setRequestProperty("User-Agent", "Rboard-update-check")
+            val code = c.responseCode
+            if (code == 403 || code == 429) throw IllegalStateException("GitHub is limiting requests right now. Try again in a few minutes.")
+            if (code != 200) throw IllegalStateException("GitHub answered with code $code")
+            return c.inputStream.bufferedReader().use { it.readText() }
+        } finally {
+            c.disconnect()
+        }
+    }
+
+    private fun parseTime(s: String): Long {
+        val f = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US)
+        f.timeZone = TimeZone.getTimeZone("UTC")
+        return f.parse(s)?.time ?: 0L
+    }
+
+    /** Blocking, call from a background thread. */
+    fun check(): Result {
+        val mine = installedId()
+        if (mine.isBlank() || mine == "dev") return Result.UnknownBuild
+        return try {
+            val tree = JSONObject(get("https://api.github.com/repos/$OWNER_REPO/git/trees/master"))
+            val items = tree.getJSONArray("tree")
+            var repoSha = ""
+            for (i in 0 until items.length()) {
+                val o = items.getJSONObject(i)
+                if (o.getString("path") == "rasi.patch") repoSha = o.getString("sha")
+            }
+            if (repoSha.isEmpty()) return Result.Error("rasi.patch was not found in the repository.")
+            latestRepoId = repoSha
+            if (repoSha == mine) return Result.UpToDate
+
+            val commits = JSONArray(get("https://api.github.com/repos/$OWNER_REPO/commits?path=rasi.patch&sha=master&per_page=1"))
+            val commitTime = if (commits.length() > 0)
+                parseTime(commits.getJSONObject(0).getJSONObject("commit").getJSONObject("committer").getString("date"))
+            else 0L
+
+            val release = JSONObject(get("https://api.github.com/repos/$OWNER_REPO/releases/tags/latest"))
+            val published = parseTime(release.getString("published_at"))
+            if (published > commitTime) Result.Available else Result.BuildPending
+        } catch (e: Throwable) {
+            Result.Error(e.message ?: "Could not check for updates.")
+        }
+    }
+}
