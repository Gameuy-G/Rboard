+            var pvStyle by remember { mutableStateOf(prefs.getString("pill_viz_style", "bars") ?: "bars") }
+            var pvRot by remember { mutableStateOf(prefs.getBoolean("pill_viz_rotate", true)) }
+            SwitchRow("Visualizer on the pill", "A small visualizer on the floating pill. It grows and shrinks with the pill size and stops when the pill hides.", pvOn) {
+                pvOn = it; prefs.edit().putBoolean("pill_viz", it).apply(); RasiNowPlaying.notifyChanged()
+            }
+            if (pvOn) {
+                RasiSection("Placement")
