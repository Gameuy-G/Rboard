diff --git a/java/assets/layouts_rasi/symbols.yaml b/java/assets/layouts_rasi/symbols.yaml
new file mode 100644
index 000000000..2d5254496
--- /dev/null
+++ b/java/assets/layouts_rasi/symbols.yaml
@@ -0,0 +1,33 @@
+name: "Symbols"
+attributes:
+  shiftable: false
+rows:
+  - letters: "1 2 3 4 5 6 7 8 9 0"
+    # Only show this row if number row is inactive on main layout
+    numRowMode: Hideable
+  - letters: "% \\ | = [ ] < > { }"
+    # Only show this row if number row is active on main layout
+    numRowMode: Filler
+  # Gboard ?123 page: @ # $ _ & - + ( ) /
+  - letters:
+      - "@"
+      - ["#", "\u2116"]
+      - "$"
+      - "_"
+      - "&"
+      - ["-", "_", "\u2013", "\u2014", "\u207B", "\u208B", "\u00B7"]
+      - ["+", "\u207A", "\u208A"]
+      - "("
+      - ")"
+      - "/"
+  - letters:
+      - "$shift"
+      - "*"
+      - "\""
+      - "'"
+      - ":"
+      - ";"
+      - "!"
+      - "?"
+      - "$delete"
+  - bottom: "$alphabet , $number $space . $enter"
diff --git a/java/assets/layouts_rasi/symbols_shift.yaml b/java/assets/layouts_rasi/symbols_shift.yaml
new file mode 100644
index 000000000..ec0dacabb
--- /dev/null
+++ b/java/assets/layouts_rasi/symbols_shift.yaml
@@ -0,0 +1,59 @@
+name: "Symbols (Shifted)"
+numberRowMode: UserConfigurable
+attributes:
+  shiftable: false
+rows:
+  # Gboard =\< page: ~ ` | \u2022 \u221A \u03C0 \u00F7 \u00D7 \u00A7 \u2206
+  - letters:
+      - type: base
+        spec: "~"
+      - type: base
+        spec: "`"
+      - type: base
+        spec: "|"
+      - type: base
+        spec: "\u2022"
+        moreKeys: "!text/morekeys_bullet"
+      - type: base
+        spec: "\u221A"
+      - type: base
+        spec: "\u03C0"
+        moreKeys: ["\u03A0", "\u03BC", "\u03A9"]
+      - type: base
+        spec: "\u00F7"
+      - type: base
+        spec: "\u00D7"
+      - type: base
+        spec: "\u00A7"
+        moreKeys: "\u00B6"
+      - type: base
+        spec: "\u2206"
+  # \u00A3 \u00A2 \u20AC \u00A5 ^ \u00B0 = { } \
+  - letters:
+      - "$currency1"
+      - "$currency2"
+      - "$currency3"
+      - "$currency4"
+      - type: base
+        spec: "^"
+        moreKeys: "\u2191,\u2193,\u2190,\u2192"
+      - type: base
+        spec: "\u00B0"
+        moreKeys: "\u2032,\u2033"
+      - type: base
+        spec: "="
+      - "!text/keyspec_left_curly_bracket"
+      - "!text/keyspec_right_curly_bracket"
+      - "\\"
+  # ?123 % \u00A9 \u00AE \u2122 \u2713 [ ]
+  - letters:
+      - "$shift"
+      - "%"
+      - "\u00A9"
+      - "\u00AE"
+      - "\u2122"
+      - "\u2713"
+      - "!text/keyspec_left_square_bracket"
+      - "!text/keyspec_right_square_bracket"
+      - "$delete"
+  - bottom: "$alphabet < $number $space > $enter"
