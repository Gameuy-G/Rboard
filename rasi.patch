+/** Text chat of the Listen together room. One live listener on the last N messages, only while this screen is open. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+fun RasiRoomChatScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    remember { RasiAccount.init(context); RasiPerf.init(context); 0 }
+    val uid by RasiAccount.uid
+    val myProf by RasiAccount.profile
+    val prefs = remember { RasiAccount.prefs(context) }
+    val room by RasiRooms.room
+    val members by RasiRooms.members
+    val msgs by RasiRoomChat.messages
+    val err by RasiRoomChat.message
+    var text by remember { mutableStateOf("") }
+    var menuFor by remember { mutableStateOf<String?>(null) }
+    var optMenu by remember { mutableStateOf(false) }
+    var songColor by remember { mutableIntStateOf(0) }
+    val code = room?.code ?: ""
+    val isOwner = room?.owner == uid
+    val limit = prefs.getInt("rc_limit", 50)
+    val maxLen = prefs.getInt("rc_max_len", 500)
+    val size = prefs.getInt("rc_text", 16)
+    val showTime = prefs.getBoolean("rc_time", true)
+    val h24 = prefs.getBoolean("rc_h24", false)
+    val showAv = prefs.getBoolean("rc_avatar", true)
+    val pingOn = prefs.getBoolean("rc_ping", true) && prefs.getBoolean("ch_ping_on", true)
+    var songOn by remember { mutableStateOf(prefs.getBoolean("rc_song", false)) }
+    val barOn = prefs.getBoolean("ch_bar_glass", true)
+    val barA = prefs.getInt("ch_bar_alpha", 70).coerceIn(0, 100) / 100f
+    val pingColor = Color(prefs.getInt("ch_ping_color", -10983950))
+    val perf = RasiPerf.isOn()
+    var muted by remember(code) { mutableStateOf(prefs.getBoolean("rm_mute_$code", false)) }
+    val state = rememberLazyListState()
+    val byId = remember(members) { members.associateBy { it.uid } }
+    val myNames = listOfNotNull(myProf?.username, myProf?.name)
+
+    DisposableEffect(uid, code) {
+        val stop = if (uid != null && code.isNotBlank()) RasiRoomChat.open(code, limit) else ({})
+        RasiMsgNotify.roomChatOpen = true
+        RasiMsgNotify.clearFor(context, "room_$code")
+        RasiRoomChat.unread.value = 0
+        if (RasiMsgNotify.popup.value?.other == "room") RasiMsgNotify.popup.value = null
+        onDispose {
+            stop()
+            RasiMsgNotify.roomChatOpen = false
+            RasiRoomChat.unread.value = 0
+        }
+    }
+    LaunchedEffect(room == null) { if (room == null) navController.popBackStack() }
+    LaunchedEffect(msgs.size) {
+        if (msgs.isNotEmpty()) { if (RasiPerf.isOn()) state.scrollToItem(msgs.size - 1) else state.animateScrollToItem(msgs.size - 1) }
+    }
+    LaunchedEffect(songOn) {
+        while (songOn) {
+            val art = RasiNowPlaying.track?.art
+            songColor = if (art != null) try { RasiNowPlayingTheme.swatches(art).firstOrNull() ?: 0 } catch (t: Throwable) { 0 } else 0
+            delay(if (RasiPerf.isOn()) 10000L else 3000L)
+        }
+        songColor = 0
+    }
+    val songTarget = if (songOn && songColor != 0) Color(songColor).copy(alpha = 0.6f) else Color.Transparent
+    val songTop by androidx.compose.animation.animateColorAsState(
+        songTarget, if (perf) androidx.compose.animation.core.snap() else androidx.compose.animation.core.tween(900), label = "roomSong")
+
+    Box(Modifier.fillMaxSize()) {
+        ChatBackground(null, 0f, songTop, Color.Transparent)
+        Column(Modifier.fillMaxSize()) {
+            ScreenTitle(room?.name?.ifBlank { "Room chat" } ?: "Room chat", showBack = true, navController)
+            if (uid == null || room == null) {
+                Text("Join a room first.", Modifier.padding(16.dp))
+                return@Column
+            }
+            Row(Modifier.fillMaxWidth().padding(horizontal = 16.dp), verticalAlignment = Alignment.CenterVertically) {
+                Text(members.size.toString() + " in the room", Modifier.weight(1f), fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                Box {
+                    RasiTextButton(onClick = { optMenu = true }) { Text("\u22EE", fontSize = 18.sp) }
+                    DropdownMenu(expanded = optMenu, onDismissRequest = { optMenu = false }) {
+                        DropdownMenuItem(text = { Text(if (muted) "Unmute room chat" else "Mute room chat") }, onClick = {
+                            muted = !muted; prefs.edit().putBoolean("rm_mute_$code", muted).apply(); optMenu = false
+                        })
+                        DropdownMenuItem(text = { Text(if (songOn) "Stop following my song color" else "Follow my song color") }, onClick = {
+                            songOn = !songOn; prefs.edit().putBoolean("rc_song", songOn).apply(); optMenu = false
+                        })
+                        DropdownMenuItem(text = { Text("Copy chat as text") }, onClick = {
+                            val df = java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.getDefault())
+                            val all = msgs.joinToString("\n") { m ->
+                                val b = byId[m.from]
+                                "[" + df.format(java.util.Date(m.at)) + "] " + (if (b == null) "Someone" else b.name.ifBlank { b.username }) + ": " + m.text
+                            }
+                            val cm = context.getSystemService(android.content.Context.CLIPBOARD_SERVICE) as android.content.ClipboardManager
+                            cm.setPrimaryClip(android.content.ClipData.newPlainText("room chat", all)); optMenu = false
+                        })
+                    }
+                }
+            }
+            if (err.isNotBlank()) Text(err, Modifier.padding(horizontal = 16.dp), fontWeight = FontWeight.Bold, color = Color(0xFFE57373))
+            LazyColumn(Modifier.weight(1f).fillMaxWidth().padding(horizontal = 10.dp), state = state, contentPadding = androidx.compose.foundation.layout.PaddingValues(bottom = 14.dp)) {
+                if (msgs.isEmpty()) item { Text("No messages yet. Say hi!", Modifier.padding(16.dp)) }
+                items(msgs, key = { it.id }) { m ->
+                    val i = msgs.indexOf(m)
+                    val prev = if (i > 0) msgs[i - 1] else null
+                    val header = prev == null || prev.from != m.from || m.at - prev.at > 5L * 60000L
+                    val mem = byId[m.from]
+                    val isMine = m.from == uid
+                    val who = if (mem == null) "Someone" else mem.name.ifBlank { mem.username }.ifBlank { "Someone" }
+                    val mention = pingOn && !isMine && pingsOf(m.text, myNames)
+                    Row(
+                        Modifier.fillMaxWidth()
+                            .then(if (mention) Modifier.clip(RoundedCornerShape(8.dp)).background(pingColor.copy(alpha = 0.18f)) else Modifier)
+                            .combinedClickable(onClick = { }, onLongClick = { menuFor = m.id })
+                            .padding(vertical = if (header) 4.dp else 1.dp, horizontal = 2.dp),
+                        horizontalArrangement = Arrangement.spacedBy(10.dp)
+                    ) {
+                        if (showAv) {
+                            if (header) ChatAv(mem?.avatar?.ifBlank { "\uD83D\uDE00" } ?: "\uD83D\uDE00", mem?.avatarColor ?: -12303292, 36, false, m.from)
+                            else Spacer(Modifier.size(36.dp))
+                        }
+                        Column(Modifier.weight(1f)) {
+                            if (header) Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                                Text(who + (if (m.from == room?.owner) " (host)" else ""), fontWeight = FontWeight.Bold, fontSize = size.sp,
