+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+
+/**
+ * Performance mode for slow phones. While on, Rboard skips the heavy extras: key press effects,
+ * background effects, blurs, glass blobs and settings animations. Typing itself is unchanged.
+ */
+object RasiPerf {
+    private const val PREFS = "rasi_perf"
+    @Volatile private var on = false
+    @Volatile private var loaded = false
+
+    private fun prefs(c: Context) = c.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    @JvmStatic
+    fun init(context: Context) {
+        on = prefs(context).getBoolean("on", false)
+        loaded = true
+    }
+
+    /** Cheap to call on every key press. */
+    @JvmStatic
+    fun isOn(): Boolean = on
+
+    fun isLoaded() = loaded
+
+    fun set(context: Context, value: Boolean) {
+        on = value
+        loaded = true
+        prefs(context).edit().putBoolean("on", value).apply()
+        RasiEffects.reload()
+        RasiBgEffects.reload()
+    }
+}
