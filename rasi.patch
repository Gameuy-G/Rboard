+                    if (typingSend && e == null) {
+                        val now = System.currentTimeMillis()
+                        if (text.isBlank()) { if (lastTypingWrite > 0L) { RasiGroupChat.setTyping(gid, cid, false); lastTypingWrite = 0L } }
+                        else if (now - lastTypingWrite > typingGap) { RasiGroupChat.setTyping(gid, cid, true); lastTypingWrite = now }
+                    }
+                }, Modifier.weight(1f), placeholder = { Text(if (e != null) "Edit message" else "Message") }, maxLines = 4)
+                Button(enabled = text.isNotBlank(), onClick = {
+                    if (e != null) {
+                        RasiGroupChat.edit(gid, cid, e, text, maxLen, msgs.lastOrNull()?.id == e.id)
+                        editing = null; text = ""
+                    } else if (gmOn && gemQuestion(text) != null) {
+                        val gq = gemQuestion(text) ?: ""
+                        if (gq.isBlank()) RasiGroupChat.message.value = "Write your question after @gemini"
+                        else {
+                            if (prefs.getBoolean("gm_send_q", false)) RasiGroupChat.send(gid, cid, text, maxLen, replyTo)
+                            askOrConfirm(gq)
+                            text = ""; replyTo = null
+                            if (typingSend && lastTypingWrite > 0L) { RasiGroupChat.setTyping(gid, cid, false); lastTypingWrite = 0L }
+                        }
+                    } else {
+                        RasiGroupChat.send(gid, cid, text, maxLen, replyTo)
+                        text = ""; replyTo = null
+                        if (typingSend && lastTypingWrite > 0L) { RasiGroupChat.setTyping(gid, cid, false); lastTypingWrite = 0L }
+                    }
+                }) { Text(if (e != null) "Save" else "Send") }
+            }
+        }
+    }
+    }
+}
