+package org.futo.inputmethod.latin.rasi
+
+import android.app.Activity
+import android.app.Application
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.app.job.JobInfo
+import android.app.job.JobParameters
+import android.app.job.JobScheduler
+import android.app.job.JobService
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.SharedPreferences
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import androidx.compose.runtime.mutableStateOf
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.core.app.Person
+import androidx.core.content.ContextCompat
+import androidx.core.graphics.drawable.IconCompat
+import com.google.android.gms.tasks.Tasks
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.DocumentSnapshot
+import com.google.firebase.firestore.DocumentChange
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.ListenerRegistration
+import org.futo.inputmethod.latin.uix.settings.SettingsActivity
+import org.futo.inputmethod.latin.uix.settings.pages.pingsOf
+import java.util.Calendar
+import java.util.concurrent.TimeUnit
+
+/**
+ * Message notifications (v2.5.07). Firestore only, no server (free plan).
+ *  - RasiMsgService: foreground service with ONE live listener on my chat meta docs (query members array-contains me).
+ *    A change of lastAt/lastFrom/lastMessage means a new message. Reads: one per chat at start, then one per changed chat doc.
+ *  - RasiMsgJob: a 15 minute polling fallback (one query) that only runs while the service is not running.
+ *  - Duplicates are prevented with the prefs key mn_n_<chatId> (last notified message time).
+ * Prefs live in RasiAccount.prefs (mn_*).
+ */
+object RasiMsgNotify {
+    const val CH_MSG = "rasi_messages"
+    const val CH_PING = "rasi_pings"
+    const val CH_SERVICE = "rasi_msg_service"
+    const val JOB_ID = 7102
+    private const val SERVICE_NOTIF = 7103
+
+    private val h = Handler(Looper.getMainLooper())
+
+    /** The uid of the friend whose chat screen is open right now ("" = none). Set by RasiChatScreen. */
+    @Volatile var openChat: String = ""
+    /** True while the Listen together room chat screen is open (set by RasiRoomChatScreen). */
+    @Volatile var roomChatOpen = false
+    /** "gid/cid" of the group channel screen that is open right now ("" = none). Set by RasiGroupChatScreen. */
+    @Volatile var groupChatOpen: String = ""
+    @Volatile var serviceRunning = false
+    @Volatile private var settingsOpen = 0
+    @Volatile private var hooked = false
+
+    class Popup(val other: String, val name: String, val text: String, val ping: Boolean, val stamp: Long)
+    /** Small in-app popup, drawn by RasiMsgPopupHost. */
+    val popup = mutableStateOf<Popup?>(null)
+
+    private class Person0(val name: String, val avatar: String, val color: Int)
+    private val lines = HashMap<String, MutableList<Pair<String, Long>>>()
+
+    private fun uid(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+
+    /** Counts open settings screens so we know if the app is on screen. */
+    private fun hook(app: Context) {
+        if (hooked) return
+        val a = app.applicationContext as? Application ?: return
+        hooked = true
+        a.registerActivityLifecycleCallbacks(object : Application.ActivityLifecycleCallbacks {
+            override fun onActivityStarted(activity: Activity) { if (activity is SettingsActivity) settingsOpen++ }
+            override fun onActivityStopped(activity: Activity) { if (activity is SettingsActivity && settingsOpen > 0) settingsOpen-- }
+            override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) {}
+            override fun onActivityResumed(activity: Activity) {}
+            override fun onActivityPaused(activity: Activity) {}
+            override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) {}
+            override fun onActivityDestroyed(activity: Activity) {}
+        })
+    }
+
+    val appOpen: Boolean get() = settingsOpen > 0
+
+    /** Starts or stops everything according to the settings. Safe to call often (keyboard start, boot, settings). */
+    @JvmStatic
+    fun ensure(c: Context) {
+        val app = c.applicationContext
+        try {
+            hook(app)
+            try { RasiAccount.init(app) } catch (t: Throwable) { }
+            val p = RasiAccount.prefs(app)
+            RasiRoomService.ensure(app)
+            val js = app.getSystemService(Context.JOB_SCHEDULER_SERVICE) as JobScheduler
+            if (!p.getBoolean("mn_on", false) || uid() == null) {
+                js.cancel(JOB_ID)
+                if (serviceRunning) app.stopService(Intent(app, RasiMsgService::class.java))
+                return
+            }
+            if (p.getBoolean("mn_poll", true)) {
+                if (js.getPendingJob(JOB_ID) == null) {
+                    js.schedule(JobInfo.Builder(JOB_ID, ComponentName(app, RasiMsgJob::class.java))
+                        .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
+                        .setPeriodic(15L * 60L * 1000L)
+                        .setPersisted(true)
+                        .build())
+                }
+            } else js.cancel(JOB_ID)
+            if (!serviceRunning) {
+                try { ContextCompat.startForegroundService(app, Intent(app, RasiMsgService::class.java)) }
+                catch (t: Throwable) { RasiLog.fallback("RasiMsgNotify", "Could not start the service: " + t.javaClass.simpleName) }
+            } else RasiMsgService.syncGroups()
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiMsgNotify", "Ensure failed: " + t.javaClass.simpleName)
+        }
+    }
+
+    fun enabled(c: Context): Boolean = try { NotificationManagerCompat.from(c).areNotificationsEnabled() } catch (t: Throwable) { false }
+
+    private fun inQuiet(p: SharedPreferences): Boolean {
+        if (!p.getBoolean("mn_quiet_on", false)) return false
+        val from = p.getInt("mn_quiet_from", 23)
+        val to = p.getInt("mn_quiet_to", 7)
+        val hr = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+        return if (from == to) false else if (from < to) hr in from until to else (hr >= from || hr < to)
+    }
+
+    /** Looks at chat meta docs and delivers one notification (or popup) for every unread message not yet announced. */
+    fun handle(c: Context, docs: List<DocumentSnapshot>) {
+        val app = c.applicationContext
+        val me = uid() ?: return
+        val p = RasiAccount.prefs(app)
+        if (!p.getBoolean("mn_on", false)) return
+        val now = System.currentTimeMillis()
+        for (m in docs) {
+            @Suppress("UNCHECKED_CAST")
+            val mem = m.get("members") as? List<String> ?: continue
+            val other = mem.firstOrNull { it != me } ?: continue
+            val from = m.getString("lastFrom") ?: continue
+            val at = m.getLong("lastAt") ?: continue
+            if (from == me || at <= 0L || now - at > 24L * 3600000L) continue
+            @Suppress("UNCHECKED_CAST")
+            val myRead = (m.get("read") as? Map<String, Any>)?.get(me) as? Long ?: 0L
+            if (at <= myRead) continue
+            if (at <= p.getLong("mn_n_" + m.id, 0L)) continue
+            p.edit().putLong("mn_n_" + m.id, at).apply()
+            deliver(app, p, other, m.getString("lastMessage") ?: "", at)
+        }
+    }
+
+    /** A new message in my Listen together room (called by RasiRoomChat.watch). Same rules as chats: mute, quiet hours, popup. */
+    fun handleRoom(c: Context, code: String, from: String, text: String, at: Long) {
+        val app = c.applicationContext
+        val p = RasiAccount.prefs(app)
+        if (!roomChatOpen) h.post { RasiRoomChat.unread.value = RasiRoomChat.unread.value + 1 }
+        if (!p.getBoolean("mn_room_on", true)) return
+        val inChat = roomChatOpen && appOpen
+        val prof = RasiAccount.profile.value
+        val ping = p.getBoolean("ch_ping_on", true) && pingsOf(text, listOfNotNull(prof?.username, prof?.name))
+        val muted = p.getBoolean("rm_mute_$code", false)
+        if (muted && !(ping && p.getBoolean("mn_ping_mute", false))) return
+        if (inQuiet(p)) return
+        if (inChat && !p.getBoolean("mn_pop_same", false)) return
+        val m = RasiRooms.members.value.firstOrNull { it.uid == from }
+        val who = if (m == null) "Someone" else m.name.ifBlank { m.username }.ifBlank { "Someone" }
+        val rname = (RasiRooms.room.value?.name ?: p.getString("rm_name", "") ?: "").ifBlank { "the room" }
+        val title = "$who in $rname"
+        if (appOpen && p.getBoolean("mn_pop_on", true)) {
+            val preview = if (p.getBoolean("mn_pop_preview", false) && p.getBoolean("mn_text", true)) text else ""
+            h.post { popup.value = Popup("room", title, preview, ping, System.currentTimeMillis()) }
+        } else if (!inChat) {
+            post(app, p, "room_$code", title, Person0(who, m?.avatar ?: "", m?.avatarColor ?: -12303292), text, at, ping)
+        }
+    }
+
+    /** A channel doc of one of my groups changed (lastFrom/lastAt/lastMessage). Same rules as chats: mute, quiet hours, popup. Off unless mn_grp_on. */
+    fun handleGroup(c: Context, gid: String, gname: String, docs: List<DocumentSnapshot>) {
+        val app = c.applicationContext
+        val me = uid() ?: return
+        val p = RasiAccount.prefs(app)
+        if (!p.getBoolean("mn_on", false) || !p.getBoolean("mn_grp_on", false)) return
+        val now = System.currentTimeMillis()
+        for (m in docs) {
+            val from = m.getString("lastFrom") ?: continue
+            val at = m.getLong("lastAt") ?: continue
+            if (from == me || at <= 0L || now - at > 24L * 3600000L) continue
+            val key = "mn_n_g_" + gid + "_" + m.id
+            if (at <= maxOf(p.getLong(key, 0L), p.getLong("mn_g_since_$gid", 0L))) continue
+            p.edit().putLong(key, at).apply()
+            deliverGroup(app, p, gid, gname, m.id, m.getString("name") ?: "", from, m.getString("lastMessage") ?: "", at)
+        }
+    }
+
+    /** Called when a group channel screen opens or closes: everything up to now counts as read. */
+    fun markGroupRead(c: Context, gid: String, cid: String) {
+        try {
+            RasiAccount.prefs(c).edit().putLong("mn_n_g_" + gid + "_" + cid, System.currentTimeMillis()).apply()
+            clearFor(c, "g_" + gid + "_" + cid)
+            if (popup.value?.other == "g/$gid/$cid") popup.value = null
+        } catch (t: Throwable) { }
+    }
+
+    private fun deliverGroup(c: Context, p: SharedPreferences, gid: String, gname: String, cid: String, cname: String, from: String, text: String, at: Long) {
+        val inChat = groupChatOpen == "$gid/$cid" && appOpen
+        val prof = RasiAccount.profile.value
+        val ping = p.getBoolean("ch_ping_on", true) && pingsOf(text, listOfNotNull(prof?.username, prof?.name))
+        val muted = p.getBoolean("gr_mute_$gid", false)
+        if (muted && !(ping && p.getBoolean("mn_ping_mute", false))) return
+        if (inQuiet(p)) return
+        if (inChat && !p.getBoolean("mn_pop_same", false)) return
+        groupPerson(p, gid, from) { who ->
+            val title = who.name + " in " + gname.ifBlank { "a group" } + (if (cname.isNotBlank()) " #" + cname else "")
+            if (appOpen && p.getBoolean("mn_pop_on", true)) {
+                val preview = if (p.getBoolean("mn_pop_preview", false) && p.getBoolean("mn_text", true)) text else ""
+                h.post { popup.value = Popup("g/$gid/$cid", title, preview, ping, System.currentTimeMillis()) }
+            } else if (!inChat) post(c, p, "g_" + gid + "_" + cid, title, who, text, at, ping, "rasiGroupChat/$gid/$cid")
+        }
+    }
+
+    /** Name and avatar of a group member: cached in prefs for a day, otherwise one read of groups/{gid}/members/{uid}. */
+    private fun groupPerson(p: SharedPreferences, gid: String, uid: String, cb: (Person0) -> Unit) {
+        val k = gid + "_" + uid
+        val t = p.getLong("mn_gt_$k", 0L)
+        val cached = p.getString("mn_gn_$k", null)
+        if (cached != null && System.currentTimeMillis() - t < 24L * 3600000L) {
+            cb(Person0(cached, p.getString("mn_ga_$k", "") ?: "", p.getInt("mn_gc_$k", -12303292))); return
+        }
+        val d = try { FirebaseFirestore.getInstance() } catch (e: Throwable) { cb(Person0(cached ?: "Someone", "", -12303292)); return }
+        d.collection("groups").document(gid).collection("members").document(uid).get().addOnCompleteListener { r ->
+            val s = r.result
+            if (!r.isSuccessful || s == null || !s.exists()) { cb(Person0(cached ?: "Someone", p.getString("mn_ga_$k", "") ?: "", p.getInt("mn_gc_$k", -12303292))); return@addOnCompleteListener }
+            val name = (s.getString("name") ?: "").ifBlank { s.getString("username") ?: "Someone" }
+            val av = s.getString("avatar") ?: ""
+            val col = (s.getLong("avatarColor") ?: 0xFF888888L).toInt()
+            p.edit().putString("mn_gn_$k", name).putString("mn_ga_$k", av).putInt("mn_gc_$k", col).putLong("mn_gt_$k", System.currentTimeMillis()).apply()
+            cb(Person0(name, av, col))
+        }
+    }
+
+    private fun deliver(c: Context, p: SharedPreferences, other: String, text: String, at: Long) {
+        val inChat = openChat == other && appOpen
+        val prof = RasiAccount.profile.value
+        val ping = p.getBoolean("ch_ping_on", true) && pingsOf(text, listOfNotNull(prof?.username, prof?.name))
+        val muted = p.getBoolean("ch_mute_" + other, false)
+        if (muted && !(ping && p.getBoolean("mn_ping_mute", false))) return
+        if (inQuiet(p)) return
+        if (inChat && !p.getBoolean("mn_pop_same", false)) return
+        person(c, p, other) { who ->
+            val name = if (p.getBoolean("ch_nick_on", true)) p.getString("ch_nick_" + other, "").orEmpty().ifBlank { who.name } else who.name
+            if (appOpen && p.getBoolean("mn_pop_on", true)) {
+                val preview = if (p.getBoolean("mn_pop_preview", false) && p.getBoolean("mn_text", true)) text else ""
+                h.post { popup.value = Popup(other, name, preview, ping, System.currentTimeMillis()) }
+            } else if (!inChat) post(c, p, other, name, who, text, at, ping)
+        }
+    }
+
+    /** Name and avatar of a friend: cached in prefs for a day, otherwise one read of users/{uid}. */
+    private fun person(c: Context, p: SharedPreferences, other: String, cb: (Person0) -> Unit) {
+        val t = p.getLong("mn_pt_$other", 0L)
+        val cachedName = p.getString("mn_pn_$other", null)
+        if (cachedName != null && System.currentTimeMillis() - t < 24L * 3600000L) {
+            cb(Person0(cachedName, p.getString("mn_pa_$other", "") ?: "", p.getInt("mn_pc_$other", -12303292)))
+            return
+        }
+        val d = try { FirebaseFirestore.getInstance() } catch (e: Throwable) { cb(Person0(cachedName ?: "A friend", "", -12303292)); return }
+        d.collection("users").document(other).get().addOnCompleteListener { r ->
+            val s = r.result
