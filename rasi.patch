+                    Text(stringResource(R.string.rasi_chroma_saving) + " " + (progress * 100).toInt() + "%")
+                } else {
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Button(onClick = {
+                            val src = source ?: return@Button
+                            saving = true
+                            val params = ChromaParams(color, tol, soft)
+                            scope.launch {
+                                val ok = withContext(Dispatchers.Default) {
+                                    val out = if (chromaScope == RasiChroma.SCOPE_BG) RasiBgEffects.newFramesDir(context, target)
+                                    else RasiEffects.newFramesDir(context, target)
+                                    val done = RasiChroma.bake(src, params, chromaScope, out) { progress = it }
+                                    if (done) {
+                                        if (chromaScope == RasiChroma.SCOPE_BG) RasiBgEffects.commitFrames(context, target, out)
+                                        else RasiEffects.commitFrames(context, target, out)
+                                    }
+                                    done
+                                }
+                                saving = false
+                                if (ok) {
+                                    navController.popBackStack()
+                                } else {
+                                    Toast.makeText(context, context.getString(R.string.rasi_chroma_error), Toast.LENGTH_LONG).show()
+                                }
+                            }
+                        }) { Text(stringResource(R.string.rasi_chroma_save)) }
+                        OutlinedButton(onClick = { navController.popBackStack() }) {
+                            Text(stringResource(R.string.rasi_chroma_cancel))
+                        }
+                    }
+                }
+            } else {
+                Text(stringResource(R.string.rasi_chroma_loading))
+            }
+        }
+    }
+}
