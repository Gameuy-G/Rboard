+/** Foreground service holding the single live listener. */
+class RasiMsgService : Service() {
+    private var reg: ListenerRegistration? = null
+    private var groupsReg: ListenerRegistration? = null
+    private val groupRegs = HashMap<String, ListenerRegistration>()
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    companion object {
+        @Volatile private var inst: RasiMsgService? = null
+        /** Starts or stops the group listeners according to the settings (mn_on and mn_grp_on). Safe to call often. */
+        fun syncGroups() { val s = inst ?: return; Handler(Looper.getMainLooper()).post { s.syncGroupsNow() } }
+    }
+
+    /** v2.5.13: when Group message notifications are on, one listener on my group list and one per group on its channel docs. */
+    private fun syncGroupsNow() {
+        val app = applicationContext
+        val p = RasiAccount.prefs(app)
+        val id = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+        val d = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+        if (!p.getBoolean("mn_on", false) || !p.getBoolean("mn_grp_on", false) || id == null || d == null) {
+            groupsReg?.remove(); groupsReg = null
+            groupRegs.values.forEach { it.remove() }; groupRegs.clear()
+            return
+        }
+        if (groupsReg != null) return
+        groupsReg = d.collection("users").document(id).collection("groups").addSnapshotListener { s, e ->
+            if (e != null) { RasiLog.fallback("RasiMsgService", "Groups listen: " + e.javaClass.simpleName); return@addSnapshotListener }
+            if (s == null) return@addSnapshotListener
+            val now = s.documents.associate { it.id to (it.getString("name") ?: "") }
+            groupRegs.keys.filter { it !in now.keys }.forEach { groupRegs.remove(it)?.remove() }
+            for ((gid, gname) in now) {
+                if (gid in groupRegs) continue
+                if (p.getLong("mn_g_since_$gid", 0L) == 0L) p.edit().putLong("mn_g_since_$gid", System.currentTimeMillis()).apply()
+                groupRegs[gid] = d.collection("groups").document(gid).collection("channels").addSnapshotListener { cs, ce ->
+                    if (ce != null) { RasiLog.fallback("RasiMsgService", "Channels listen: " + ce.javaClass.simpleName); groupRegs.remove(gid)?.remove(); return@addSnapshotListener }
+                    if (cs == null) return@addSnapshotListener
+                    RasiMsgNotify.handleGroup(app, gid, gname, cs.documentChanges.filter { it.type != DocumentChange.Type.REMOVED }.map { it.document })
+                }
+            }
+        }
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        try {
+            val n = RasiMsgNotify.serviceNotification(this)
+            if (Build.VERSION.SDK_INT >= 34) startForeground(RasiMsgNotify.serviceId(), n, android.content.pm.ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE)
+            else startForeground(RasiMsgNotify.serviceId(), n)
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiMsgService", "Foreground start failed: " + t.javaClass.simpleName)
+            stopSelf(); return START_NOT_STICKY
+        }
+        RasiMsgNotify.serviceRunning = true
+        inst = this
+        if (reg == null) listen()
+        syncGroupsNow()
+        return START_STICKY
+    }
+
+    private fun listen() {
+        val id = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+        if (id == null) { stopSelf(); return }
+        try { RasiAccount.init(applicationContext) } catch (t: Throwable) { }
+        val d = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { stopSelf(); return }
+        reg = d.collection("chats").whereArrayContains("members", id).addSnapshotListener { s, e ->
+            if (e != null) { RasiLog.fallback("RasiMsgService", "Listen: " + e.javaClass.simpleName); return@addSnapshotListener }
+            if (s == null) return@addSnapshotListener
+            RasiMsgNotify.handle(applicationContext, s.documentChanges.filter { it.type != DocumentChange.Type.REMOVED }.map { it.document })
+        }
+    }
+
+    override fun onDestroy() {
+        reg?.remove(); reg = null
+        groupsReg?.remove(); groupsReg = null
+        groupRegs.values.forEach { it.remove() }; groupRegs.clear()
+        if (inst === this) inst = null
+        RasiMsgNotify.serviceRunning = false
+        super.onDestroy()
+    }
+}
+
+/** 15 minute fallback: one query, only when the live service is not running. */
+class RasiMsgJob : JobService() {
+    override fun onStartJob(params: JobParameters): Boolean {
+        if (RasiMsgNotify.serviceRunning) return false
+        Thread {
+            try {
+                val id = FirebaseAuth.getInstance().currentUser?.uid
+                if (id != null) {
+                    try { RasiAccount.init(applicationContext) } catch (t: Throwable) { }
+                    val s = Tasks.await(FirebaseFirestore.getInstance().collection("chats").whereArrayContains("members", id).get(), 25, TimeUnit.SECONDS)
+                    RasiMsgNotify.handle(applicationContext, s.documents)
+                }
+            } catch (t: Throwable) {
+                RasiLog.fallback("RasiMsgJob", "Poll failed: " + t.javaClass.simpleName)
+            }
+            jobFinished(params, false)
+        }.start()
+        return true
+    }
+
+    override fun onStopJob(params: JobParameters): Boolean = true
+}
