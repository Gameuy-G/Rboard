+/** Gemini API key, model and personality, stored only on this device. */
+object RasiGeminiStore {
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("rasi_gemini", Context.MODE_PRIVATE)
+
+    const val DEFAULT_MODEL = "gemini-flash-latest"
+
+    fun key(context: Context): String = prefs(context).getString("api_key", "") ?: ""
+
+    fun model(context: Context): String {
+        val m = (prefs(context).getString("model", "") ?: "").trim()
+        // Blank or an old retired model falls back to the always-current alias
+        return if (m.isBlank() || m.startsWith("gemini-1") || m.startsWith("gemini-2")) DEFAULT_MODEL else m
+    }
+
+    fun setModel(context: Context, model: String) {
+        prefs(context).edit().putString("model", model.trim()).apply()
+    }
+
+    fun persona(context: Context): String = prefs(context).getString("persona", "") ?: ""
+
+    fun save(context: Context, key: String, model: String, persona: String) {
+        prefs(context).edit().putString("api_key", key.trim()).putString("model", model.trim())
+            .putString("persona", persona.trim()).apply()
+    }
+
+    /** Models that can answer questions, newest first, fetched from Google. */
+    fun listModels(key: String): List<String> {
+        val conn = URL("https://generativelanguage.googleapis.com/v1beta/models?pageSize=200")
+            .openConnection() as HttpURLConnection
+        try {
+            conn.connectTimeout = 15000
+            conn.readTimeout = 30000
+            conn.setRequestProperty("x-goog-api-key", key)
+            if (conn.responseCode !in 200..299) throw RuntimeException("Error " + conn.responseCode)
+            val text = conn.inputStream.bufferedReader().use { it.readText() }
+            val arr = JSONObject(text).getJSONArray("models")
+            val out = ArrayList<String>()
+            for (i in 0 until arr.length()) {
+                val m = arr.getJSONObject(i)
+                val name = m.getString("name").removePrefix("models/")
+                val methods = m.optJSONArray("supportedGenerationMethods")
+                var ok = false
+                if (methods != null) for (j in 0 until methods.length()) if (methods.getString(j) == "generateContent") ok = true
+                if (ok && name.startsWith("gemini")) out.add(name)
+            }
+            return out.sortedWith(compareByDescending<String> { versionOf(it) }.thenBy { it })
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    /** Newest model that can create pictures (falls back to the usual one). */
+    fun imageModel(key: String): String {
+        val found = runCatching { listModels(key) }.getOrDefault(emptyList())
+            .firstOrNull { it.contains("image") && !it.contains("imagen") }
+        return found ?: "gemini-2.5-flash-image"
+    }
+
+    private fun versionOf(name: String): Double {
+        val m = Regex("gemini-(\\d+(?:\\.\\d+)?)").find(name) ?: return 0.0
+        return m.groupValues[1].toDoubleOrNull() ?: 0.0
+    }
+}
