+import androidx.navigation.NavHostController
+import androidx.navigation.compose.rememberNavController
+import org.futo.inputmethod.latin.R
+import org.futo.inputmethod.latin.uix.RasiSounds
+import org.futo.inputmethod.latin.uix.settings.ScreenTitle
+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+
+@Composable
+fun RasiSoundsScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiSounds.prefs(context) }
+
+    var enabled by remember { mutableStateOf(prefs.getBoolean("enabled", false)) }
+    var volume by remember { mutableFloatStateOf(prefs.getFloat("volume", 0.8f)) }
+    var tick by remember { mutableIntStateOf(0) }
+    var pendingSlot by remember { mutableStateOf<String?>(null) }
+
+    val picker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        val slot = pendingSlot
+        pendingSlot = null
+        if (uri != null && slot != null) {
+            RasiSounds.importSound(context, slot, uri)
+            tick++
+        }
+    }
+
+    ScrollableList {
+        ScreenTitle(stringResource(R.string.rasi_sounds_title), showBack = true, navController)
+
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(stringResource(R.string.rasi_sounds_hint))
+
+            Row(
+                Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.SpaceBetween
+            ) {
+                Text(stringResource(R.string.rasi_sounds_enable))
+                Switch(checked = enabled, onCheckedChange = {
+                    enabled = it
+                    prefs.edit().putBoolean("enabled", it).apply()
+                    RasiSounds.reload()
+                })
+            }
+
+            Text(stringResource(R.string.rasi_sounds_volume))
+            Slider(
+                value = volume,
+                onValueChange = {
+                    volume = it
+                    prefs.edit().putFloat("volume", it).apply()
+                },
+                valueRange = 0f..1f
+            )
+
+            val slotNames = mapOf(
+                "letters" to R.string.rasi_sounds_letters,
+                "space" to R.string.rasi_sounds_space,
+                "delete" to R.string.rasi_sounds_delete,
+                "enter" to R.string.rasi_sounds_enter,
+            )
+
+            RasiSounds.SLOTS.forEach { slot ->
+                val name = if (tick >= 0) RasiSounds.fileName(context, slot) else null
+                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                    Text(stringResource(slotNames[slot]!!))
+                    Text(
+                        if (name == null) stringResource(R.string.rasi_sounds_none) else stringResource(R.string.rasi_sounds_custom_set),
+                    )
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        OutlinedButton(onClick = {
+                            pendingSlot = slot
+                            picker.launch(arrayOf("audio/*"))
+                        }) { Text(stringResource(R.string.rasi_sounds_choose)) }
+
+                        if (name != null) {
+                            OutlinedButton(onClick = { RasiSounds.playSlot(slot) }) {
+                                Text(stringResource(R.string.rasi_sounds_test))
+                            }
+                            OutlinedButton(onClick = {
+                                RasiSounds.clear(context, slot)
+                                tick++
+                            }) { Text(stringResource(R.string.rasi_sounds_clear)) }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
