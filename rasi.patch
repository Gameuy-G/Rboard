+    @Volatile var status = "Playback capture is off"
+
+    fun start(ctx: Context, code: Int, data: Intent) {
+        val i = Intent(ctx, RasiCaptureService::class.java)
+            .putExtra("code", code).putExtra("data", data)
+        if (Build.VERSION.SDK_INT >= 26) ctx.startForegroundService(i) else ctx.startService(i)
+    }
+
+    fun stop(ctx: Context) {
+        try { ctx.stopService(Intent(ctx, RasiCaptureService::class.java)) } catch (t: Throwable) { }
+        running = false
+        status = "Playback capture is off"
+    }
+}
+
+/**
+ * Captures the phone's media playback (no microphone) with AudioPlaybackCapture. Needs the one-time
+ * "start recording or casting" prompt. Players that block capture give silence.
+ */
+class RasiCaptureService : Service() {
+    @Volatile private var alive = false
+    private var projection: MediaProjection? = null
+    private var rec: AudioRecord? = null
+    private var worker: Thread? = null
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent?.action == "stop") { stopSelf(); return START_NOT_STICKY }
+        val code = intent?.getIntExtra("code", 0) ?: 0
+        @Suppress("DEPRECATION")
+        val data: Intent? = intent?.getParcelableExtra("data")
+        if (data == null) { stopSelf(); return START_NOT_STICKY }
+        startFg()
+        if (Build.VERSION.SDK_INT < 29) {
+            RasiCapture.status = "Playback capture needs Android 10 or newer"
+            stopSelf(); return START_NOT_STICKY
+        }
+        try {
+            val mpm = getSystemService(Context.MEDIA_PROJECTION_SERVICE) as MediaProjectionManager
+            val mp = mpm.getMediaProjection(code, data)
+            mp.registerCallback(object : MediaProjection.Callback() {
+                override fun onStop() { Handler(Looper.getMainLooper()).post { stopSelf() } }
+            }, Handler(Looper.getMainLooper()))
+            projection = mp
+            val cfg = AudioPlaybackCaptureConfiguration.Builder(mp)
+                .addMatchingUsage(AudioAttributes.USAGE_MEDIA)
+                .addMatchingUsage(AudioAttributes.USAGE_GAME)
+                .addMatchingUsage(AudioAttributes.USAGE_UNKNOWN)
+                .build()
+            val fmt = AudioFormat.Builder()
+                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                .setSampleRate(44100)
+                .setChannelMask(AudioFormat.CHANNEL_IN_MONO)
+                .build()
+            val min = AudioRecord.getMinBufferSize(44100, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+            val r = AudioRecord.Builder()
+                .setAudioFormat(fmt)
+                .setAudioPlaybackCaptureConfig(cfg)
+                .setBufferSizeInBytes(maxOf(min, 4096) * 2)
+                .build()
+            r.startRecording()
+            rec = r
+            alive = true
+            RasiCapture.running = true
+            RasiCapture.status = "Playback capture is running"
+            worker = Thread { loop(r) }.apply { isDaemon = true; start() }
+        } catch (t: Throwable) {
+            RasiCapture.running = false
+            RasiCapture.status = "Playback capture failed: " + t.message
+            stopSelf()
+        }
+        return START_NOT_STICKY
+    }
+
+    private fun startFg() {
+        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        if (Build.VERSION.SDK_INT >= 26) {
+            nm.createNotificationChannel(NotificationChannel("rasi_capture", "Music capture", NotificationManager.IMPORTANCE_LOW))
+        }
+        val stop = PendingIntent.getService(
+            this, 0, Intent(this, RasiCaptureService::class.java).setAction("stop"),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+        )
+        val n = (if (Build.VERSION.SDK_INT >= 26) Notification.Builder(this, "rasi_capture") else Notification.Builder(this))
+            .setSmallIcon(R.mipmap.ic_launcher)
+            .setContentTitle("Rboard is capturing music audio")
+            .setContentText("For the music visualizer. Tap Stop to end it.")
+            .setOngoing(true)
+            .addAction(Notification.Action.Builder(android.graphics.drawable.Icon.createWithResource(this, R.mipmap.ic_launcher), "Stop", stop).build())
+            .build()
+        if (Build.VERSION.SDK_INT >= 29) startForeground(4711, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION)
+        else startForeground(4711, n)
+    }
+
+    private fun loop(r: AudioRecord) {
+        val n = 1024
+        val pcm = ShortArray(n)
+        val re = FloatArray(n)
+        val im = FloatArray(n)
+        val win = FloatArray(n) { (0.5 - 0.5 * Math.cos(2.0 * Math.PI * it / (n - 1))).toFloat() }
+        val out = ByteArray(n)
+        while (alive) {
+            val got = r.read(pcm, 0, n)
+            if (got <= 0) { try { Thread.sleep(10) } catch (e: Throwable) { }; continue }
+            for (i in 0 until n) { re[i] = if (i < got) pcm[i] / 32768f * win[i] else 0f; im[i] = 0f }
+            fft(re, im)
+            var peak = 0
+            for (k in 0 until n / 2) {
+                val m = Math.hypot(re[k].toDouble(), im[k].toDouble()).toFloat() / (n / 4f)
+                val b = (m * 127f * 4f).toInt().coerceIn(0, 127)
+                out[2 * k] = b.toByte()
+                out[2 * k + 1] = 0
+                if (k > 0 && b > peak) peak = b
+            }
+            RasiNowPlayingViz.onCaptureFrame(out, peak)
+        }
+    }
+
+    /** In-place radix-2 FFT. */
+    private fun fft(re: FloatArray, im: FloatArray) {
+        val n = re.size
+        var j = 0
+        for (i in 1 until n) {
+            var bit = n shr 1
+            while (j and bit != 0) { j = j xor bit; bit = bit shr 1 }
+            j = j xor bit
+            if (i < j) { val a = re[i]; re[i] = re[j]; re[j] = a; val b = im[i]; im[i] = im[j]; im[j] = b }
+        }
+        var len = 2
+        while (len <= n) {
+            val ang = -2.0 * Math.PI / len
+            val wr = Math.cos(ang).toFloat()
+            val wi = Math.sin(ang).toFloat()
+            var i = 0
+            while (i < n) {
+                var cr = 1f
+                var ci = 0f
+                for (k in 0 until len / 2) {
+                    val ur = re[i + k]; val ui = im[i + k]
+                    val vr = re[i + k + len / 2] * cr - im[i + k + len / 2] * ci
+                    val vi = re[i + k + len / 2] * ci + im[i + k + len / 2] * cr
+                    re[i + k] = ur + vr; im[i + k] = ui + vi
+                    re[i + k + len / 2] = ur - vr; im[i + k + len / 2] = ui - vi
+                    val nr = cr * wr - ci * wi
+                    ci = cr * wi + ci * wr
+                    cr = nr
+                }
+                i += len
+            }
+            len = len shl 1
+        }
+    }
+
+    override fun onDestroy() {
+        alive = false
+        try { rec?.stop() } catch (t: Throwable) { }
+        try { rec?.release() } catch (t: Throwable) { }
+        try { projection?.stop() } catch (t: Throwable) { }
+        rec = null
+        projection = null
+        RasiCapture.running = false
+        if (!RasiCapture.status.startsWith("Playback capture failed")) RasiCapture.status = "Playback capture is off"
+        super.onDestroy()
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiChatGemini.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiChatGemini.kt
new file mode 100644
index 000000000..556abc2be
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiChatGemini.kt
@@ -0,0 +1,52 @@
+package org.futo.inputmethod.latin.rasi
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * "@gemini" in a chat (v2.5.09). Text only. Uses the user's OWN Gemini key (stored on this phone by Gemini settings).
+ * What is sent to Google: the question, and the last N chat messages as "Name: text" (N is set by the user, 0 = none).
+ * Never runs on its own: only when the user sends a message that starts with @gemini.
+ * Call from a background thread.
+ */
+object RasiChatGemini {
+    fun ask(key: String, model: String, system: String, history: String, question: String): String {
+        val prompt = (if (history.isNotBlank()) "Recent chat messages:\n$history\n\n" else "") + "Question: $question"
+        val body = JSONObject()
+            .put("contents", JSONArray().put(JSONObject().put("role", "user")
+                .put("parts", JSONArray().put(JSONObject().put("text", prompt)))))
+            .put("systemInstruction", JSONObject().put("parts", JSONArray().put(JSONObject().put("text", system))))
+            .toString()
+        val conn = URL("https://generativelanguage.googleapis.com/v1beta/models/$model:generateContent").openConnection() as HttpURLConnection
+        try {
+            conn.requestMethod = "POST"
+            conn.connectTimeout = 15000
+            conn.readTimeout = 45000
+            conn.useCaches = false
+            conn.doOutput = true
+            conn.setRequestProperty("Content-Type", "application/json")
+            conn.setRequestProperty("x-goog-api-key", key)
+            conn.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            val code = conn.responseCode
+            val text = (if (code in 200..299) conn.inputStream else conn.errorStream)?.bufferedReader()?.use { it.readText() } ?: ""
+            if (code !in 200..299) {
+                val msg = try { JSONObject(text).getJSONObject("error").getString("message") } catch (e: Exception) { text.take(160) }
+                throw RuntimeException(when (code) {
+                    429 -> "Gemini says the free limit is used up for now. Try again later"
+                    400, 401, 403 -> "Gemini refused the request. Check your key in Gemini settings. ($msg)"
+                    else -> "Error $code: $msg"
+                })
+            }
+            val parts = JSONObject(text).optJSONArray("candidates")?.optJSONObject(0)?.optJSONObject("content")?.optJSONArray("parts")
+                ?: throw RuntimeException("Gemini returned no answer (it may have been blocked)")
+            val sb = StringBuilder()
+            for (i in 0 until parts.length()) sb.append(parts.getJSONObject(i).optString("text", ""))
+            val t = sb.toString().trim()
+            return if (t.isEmpty()) "No answer returned." else t
+        } finally {
+            conn.disconnect()
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiChats.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiChats.kt
new file mode 100644
index 000000000..e569b22d1
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiChats.kt
@@ -0,0 +1,233 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import androidx.compose.runtime.mutableStateOf
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FieldValue
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.Query
+import com.google.firebase.firestore.SetOptions
+
+/**
+ * Direct messages between friends (Firebase, uses the internet).
+ * Firestore layout:
+ *   chats/{chatId}                 {members[2], lastMessage, lastFrom, lastAt, typing{uid:Long}, read{uid:Long}}
+ *   chats/{chatId}/messages/{id}   {from, text, createdAt, replyTo, replyText, replyFrom, ping, editedAt, reactions{uid:emoji}}
+ *   chats/{chatId}.pins {messageId: text} (max 5)
+ *   chats/{chatId}.theme {mode, cA, cB, bg1, bg2, radius, style, by, at} (shared look, both people see it; cA belongs to the first uid of the sorted pair, cB to the second; 0 = default)
+ * chatId = the two uids sorted and joined with "_".
+ * Free quota care: one live listener only while a chat screen is open, limited to the last N messages.
+ * The chat list reads the meta docs once (one query), never live.
+ */
+object RasiChats {
+    class Msg(val id: String, val from: String, val text: String, val at: Long, val replyId: String = "", val replyText: String = "",
+        val editedAt: Long = 0L, val ping: Boolean = false, val replyFrom: String = "", val reactions: Map<String, String> = emptyMap())
+    class Meta(val chatId: String, val other: String, val lastMessage: String, val lastFrom: String, val lastAt: Long, val myRead: Long)
+
+    val messages = mutableStateOf<List<Msg>>(emptyList())
+    val metas = mutableStateOf<List<Meta>>(emptyList())
+    val busy = mutableStateOf(false)
+    val message = mutableStateOf("")
+    /** Pinned messages of the open chat: message id -> short text. Filled by listenMeta. */
+    val pins = mutableStateOf<Map<String, String>>(emptyMap())
+
+    /** Shared chat look. Colors are ARGB ints, 0 means "not set". */
+    class Theme(val mode: String = "off", val cA: Int = 0, val cB: Int = 0, val bg1: Int = 0, val bg2: Int = 0,
+        val radius: Int = 18, val style: Int = 0, val by: String = "")
+    /** Theme of the open chat. Filled by listenMeta. */
+    val theme = mutableStateOf<Theme?>(null)
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun me(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+
+    fun chatId(a: String, b: String): String = listOf(a, b).sorted().joinToString("_")
+
+    private fun fail(t: Throwable?, what: String): String {
+        RasiLog.fallback("RasiChats", what + ": " + (t?.javaClass?.simpleName ?: "unknown"))
+        val text = generateSequence(t) { it.cause }.take(5).joinToString(" ") { it.message ?: "" }
+        return if (text.contains("PERMISSION_DENIED")) "The server refused this. The new Firestore rules may not be published yet, or you are no longer friends"
+        else "Could not reach the server. Check your internet and try again"
+    }
+
+    /** Starts the single live listener on the last [limit] messages. Returns a function that stops it. */
+    fun open(other: String, limit: Int): () -> Unit {
+        val d = db() ?: return {}
+        val id = me() ?: return {}
+        messages.value = emptyList()
+        message.value = ""
+        val reg = d.collection("chats").document(chatId(id, other)).collection("messages")
+            .orderBy("createdAt", Query.Direction.DESCENDING).limit(limit.toLong())
+            .addSnapshotListener { s, e ->
+                if (e != null) { message.value = fail(e, "Listen"); return@addSnapshotListener }
+                if (s == null) return@addSnapshotListener
+                messages.value = s.documents.mapNotNull { m ->
+                    val t = m.getString("text") ?: return@mapNotNull null
+                    Msg(m.id, m.getString("from") ?: "", t, m.getLong("createdAt") ?: 0L, m.getString("replyTo") ?: "", m.getString("replyText") ?: "",
+                        m.getLong("editedAt") ?: 0L, m.getBoolean("ping") ?: false, m.getString("replyFrom") ?: "",
+                        (m.get("reactions") as? Map<*, *>)?.entries?.mapNotNull { e -> val k = e.key as? String; val v = e.value as? String; if (k != null && v != null) k to v else null }?.toMap() ?: emptyMap())
+                }.reversed()
+            }
+        return { reg.remove(); messages.value = emptyList() }
+    }
+
+    fun send(c: Context, other: String, text0: String, maxLen: Int = 1000, reply: Msg? = null, ping: Boolean = false) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val text = text0.trim().take(maxLen)
+        if (text.isEmpty()) return
+        val now = System.currentTimeMillis()
+        val ref = d.collection("chats").document(chatId(id, other))
+        val b = d.batch()
+        b.set(ref, hashMapOf<String, Any>(
+            "members" to listOf(id, other).sorted(), "lastMessage" to text.take(100), "lastFrom" to id, "lastAt" to now
+        ), SetOptions.merge())
+        val fields = hashMapOf<String, Any>("from" to id, "text" to text, "createdAt" to now)
+        if (reply != null) { fields["replyTo"] = reply.id; fields["replyText"] = reply.text.take(100); fields["replyFrom"] = reply.from }
+        if (ping) fields["ping"] = true
+        b.set(ref.collection("messages").document(), fields)
+        b.commit().addOnCompleteListener { t ->
+            if (!t.isSuccessful) message.value = fail(t.exception, "Send") else message.value = ""
+        }
+    }
+
+    /** Edits the text of my own message (rules: only the sender, only text and editedAt). If it is the newest message the chat preview is updated too. */
+    fun edit(other: String, m: Msg, text0: String, maxLen: Int = 1000, isLast: Boolean = false) {
+        val d = db() ?: return
+        val id = me() ?: return
+        if (m.from != id) return
+        val text = text0.trim().take(maxLen)
+        if (text.isEmpty() || text == m.text) return
+        val ref = d.collection("chats").document(chatId(id, other))
+        val b = d.batch()
+        b.update(ref.collection("messages").document(m.id), mapOf<String, Any>("text" to text, "editedAt" to System.currentTimeMillis()))
+        if (isLast) b.set(ref, hashMapOf<String, Any>("members" to listOf(id, other).sorted(), "lastMessage" to text.take(100)), SetOptions.merge())
+        b.commit().addOnCompleteListener { t -> if (!t.isSuccessful) message.value = fail(t.exception, "Edit") }
+    }
+
+    /** Sets (emoji) or removes (null) MY reaction on a message. One reaction per person. */
+    fun react(other: String, m: Msg, emoji: String?) {
+        val d = db() ?: return
+        val id = me() ?: return
+        d.collection("chats").document(chatId(id, other)).collection("messages").document(m.id)
+            .update("reactions." + id, emoji ?: FieldValue.delete())
+            .addOnFailureListener { message.value = fail(it, "React") }
+    }
+
+    /** Pins or unpins a message for both people (stored in the chat doc, max 5). */
+    fun setPin(other: String, m: Msg, on: Boolean) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val ref = d.collection("chats").document(chatId(id, other))
+        val t = if (on) ref.set(hashMapOf<String, Any>(
+            "members" to listOf(id, other).sorted(),
+            "pins" to hashMapOf<String, Any>(m.id to m.text.take(100))
+        ), SetOptions.merge()) else ref.update("pins." + m.id, FieldValue.delete())
+        t.addOnFailureListener { message.value = fail(it, "Pin") }
+    }
+
+    /** Saves the shared theme (both people see it) or removes it (null). */
+    fun setTheme(other: String, t: Theme?) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val ref = d.collection("chats").document(chatId(id, other))
+        val mem = listOf(id, other).sorted()
+        fun u(c: Int): Long = c.toLong() and 0xFFFFFFFFL
+        val value: Any = if (t == null) FieldValue.delete() else hashMapOf<String, Any>(
+            "mode" to t.mode, "cA" to u(t.cA), "cB" to u(t.cB), "bg1" to u(t.bg1), "bg2" to u(t.bg2),
+            "radius" to t.radius.coerceIn(0, 30).toLong(), "style" to t.style.coerceIn(0, 2).toLong(), "by" to id, "at" to System.currentTimeMillis()
+        )
+        ref.set(hashMapOf<String, Any>("members" to mem, "theme" to value), SetOptions.merge())
+            .addOnFailureListener { message.value = fail(it, "Theme") }
+    }
+
+    /** Writes only my own key of the typing map (0 = not typing). Always includes members so a first write can create the doc. */
+    fun setTyping(other: String, on: Boolean) {
+        val d = db() ?: return
+        val id = me() ?: return
+        d.collection("chats").document(chatId(id, other)).set(hashMapOf<String, Any>(
+            "members" to listOf(id, other).sorted(),
+            "typing" to hashMapOf<String, Any>(id to (if (on) System.currentTimeMillis() else 0L))
+        ), SetOptions.merge()).addOnFailureListener { RasiLog.fallback("RasiChats", "Typing: " + it.javaClass.simpleName) }
+    }
+
+    /** Writes only my own key of the read map. */
+    fun markRead(other: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        d.collection("chats").document(chatId(id, other)).set(hashMapOf<String, Any>(
+            "members" to listOf(id, other).sorted(),
+            "read" to hashMapOf<String, Any>(id to System.currentTimeMillis())
+        ), SetOptions.merge()).addOnFailureListener { RasiLog.fallback("RasiChats", "Read: " + it.javaClass.simpleName) }
+    }
+
+    /** Live: the other person's typing time and read time. One extra listener, only while the chat is open. */
+    fun listenMeta(other: String, cb: (typing: Long, read: Long) -> Unit): () -> Unit {
+        val d = db() ?: return {}
+        val id = me() ?: return {}
+        val reg = d.collection("chats").document(chatId(id, other)).addSnapshotListener { s, e ->
+            if (e != null || s == null) return@addSnapshotListener
+            @Suppress("UNCHECKED_CAST")
+            val ty = (s.get("typing") as? Map<String, Any>)?.get(other) as? Long ?: 0L
+            @Suppress("UNCHECKED_CAST")
+            val rd = (s.get("read") as? Map<String, Any>)?.get(other) as? Long ?: 0L
+            cb(ty, rd)
+            theme.value = (s.get("theme") as? Map<*, *>)?.let { t ->
+                fun n(k: String): Int = ((t[k] as? Number)?.toLong() ?: 0L).toInt()
+                Theme(t["mode"] as? String ?: "off", n("cA"), n("cB"), n("bg1"), n("bg2"), (t["radius"] as? Number)?.toInt() ?: 18, n("style"), t["by"] as? String ?: "")
+            }
+            pins.value = (s.get("pins") as? Map<*, *>)?.entries?.mapNotNull { e -> val k = e.key as? String; if (k != null) k to (e.value?.toString() ?: "") else null }?.toMap() ?: emptyMap()
+        }
+        return { reg.remove(); pins.value = emptyMap(); theme.value = null }
+    }
+
+    /** Only the sender can delete a message. */
+    fun delete(other: String, m: Msg) {
+        val d = db() ?: return
+        val id = me() ?: return
+        if (m.from != id) return
+        d.collection("chats").document(chatId(id, other)).collection("messages").document(m.id).delete()
+            .addOnFailureListener { message.value = fail(it, "Delete") }
+    }
+
+    /** Deletes MY messages older than [days] (the rules only let the sender delete). At most once per 12 hours per chat, up to 100 per run. */
+    fun cleanup(c: Context, other: String, days: Int) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val cid = chatId(id, other)
+        val p = RasiAccount.prefs(c)
+        val now = System.currentTimeMillis()
+        if (now - p.getLong("ch_clean_" + cid, 0L) < 12L * 3600000L) return
+        p.edit().putLong("ch_clean_" + cid, now).apply()
+        val cutoff = now - days.toLong() * 86400000L
+        d.collection("chats").document(cid).collection("messages")
+            .whereLessThan("createdAt", cutoff).orderBy("createdAt").limit(100).get().addOnCompleteListener { t ->
+                val s = t.result
+                if (!t.isSuccessful || s == null) { RasiLog.fallback("RasiChats", "Cleanup: " + (t.exception?.javaClass?.simpleName ?: "unknown")); return@addOnCompleteListener }
+                val mine = s.documents.filter { it.getString("from") == id }
+                if (mine.isEmpty()) return@addOnCompleteListener
+                val b = d.batch()
+                mine.forEach { b.delete(it.reference) }
+                b.commit().addOnFailureListener { RasiLog.fallback("RasiChats", "Cleanup delete: " + it.javaClass.simpleName) }
+            }
+    }
+
+    /** One query for all my chats' meta docs (one read per existing chat). Not live. */
+    fun loadMetas() {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        d.collection("chats").whereArrayContains("members", id).get().addOnCompleteListener { t ->
+            busy.value = false
+            val s = t.result
+            if (!t.isSuccessful || s == null) { message.value = fail(t.exception, "Load chats"); return@addOnCompleteListener }
+            metas.value = s.documents.mapNotNull { m ->
+                @Suppress("UNCHECKED_CAST")
+                val mem = m.get("members") as? List<String> ?: return@mapNotNull null
+                val other = mem.firstOrNull { it != id } ?: return@mapNotNull null
+                @Suppress("UNCHECKED_CAST")
+                val rd = (m.get("read") as? Map<String, Any>)?.get(id) as? Long ?: 0L
+                Meta(m.id, other, m.getString("lastMessage") ?: "", m.getString("lastFrom") ?: "", m.getLong("lastAt") ?: 0L, rd)
+            }.sortedByDescending { it.lastAt }
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiEmojiWords.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiEmojiWords.kt
