@@ -0,0 +1,104 @@
+package org.futo.inputmethod.latin.uix.settings
+
+import android.os.Build
+import androidx.compose.foundation.background
+import androidx.compose.foundation.border
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.BoxScope
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.offset
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.shape.CircleShape
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.blur
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+
+/**
+ * "Liquid glass" look for the settings screens. Every colour comes from the keyboard theme
+ * (MaterialTheme), so it follows built-in and custom themes alike. Nothing here animates or
+ * runs in the background, so it costs nothing while idle.
+ */
+
+/** Translucent glass surface: soft gradient fill, bright top-left edge highlight. */
+@Composable
+fun Modifier.rasiGlass(shape: Shape = RoundedCornerShape(22.dp), strength: Float = 1f): Modifier {
+    val tint = MaterialTheme.colorScheme.onSurface
+    val accent = MaterialTheme.colorScheme.primary
+    return this
+        .clip(shape)
+        .background(
+            Brush.linearGradient(
+                listOf(
+                    tint.copy(alpha = 0.11f * strength),
+                    accent.copy(alpha = 0.05f * strength),
+                    tint.copy(alpha = 0.05f * strength)
+                )
+            ),
+            shape
+        )
+        .border(
+            1.dp,
+            Brush.linearGradient(
+                listOf(
+                    tint.copy(alpha = 0.34f * strength),
+                    tint.copy(alpha = 0.05f * strength),
+                    accent.copy(alpha = 0.18f * strength)
+                )
+            ),
+            shape
+        )
+}
+
+@Composable
+private fun Blob(color: Color, size: Dp, x: Dp, y: Dp, alpha: Float) {
+    Box(
+        Modifier
+            .offset(x, y)
+            .size(size)
+            .clip(CircleShape)
+            .background(Brush.radialGradient(listOf(color.copy(alpha = alpha), Color.Transparent)))
+    )
+}
+
+/** Themed gradient with soft colour blobs behind everything (blurred on Android 12+). */
+@Composable
+fun RasiGlassBackground(content: @Composable BoxScope.() -> Unit) {
+    val c = MaterialTheme.colorScheme
+    Box(
+        Modifier
+            .fillMaxSize()
+            .background(
+                LocalRasiSettingsBackground.current ?: Brush.verticalGradient(
+                    listOf(c.background, c.primary.copy(alpha = 0.10f).compositeOver(c.background), c.background)
+                )
+            )
+    ) {
+        val blurMod = if (Build.VERSION.SDK_INT >= 31) Modifier.blur(48.dp) else Modifier
+        Box(Modifier.fillMaxSize().then(blurMod)) {
+            Blob(c.primary, 340.dp, (-120).dp, (-80).dp, 0.42f)
+            Blob(c.tertiary, 300.dp, 200.dp, 260.dp, 0.34f)
+            Blob(c.secondary, 360.dp, (-140).dp, 560.dp, 0.30f)
+        }
+        content()
+    }
+}
+
+private fun Color.compositeOver(background: Color): Color {
+    val a = alpha
+    return Color(
+        red = red * a + background.red * (1 - a),
+        green = green * a + background.green * (1 - a),
+        blue = blue * a + background.blue * (1 - a),
+        alpha = 1f
+    )
+}
