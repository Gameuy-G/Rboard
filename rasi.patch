+/** Remembers the last settings menus you opened (stored on this phone only). Used by the side drawer. */
+object RasiRecent {
+    private val SKIP = setOf("home", "search", "rasiDrawer")
+
+    fun note(c: android.content.Context, route: String?) {
+        if (route == null || route in SKIP || route.contains('.') || route.contains('{') || route.contains('?') || route.contains('/')) return
+        val p = RasiAccount.prefs(c)
+        if (!p.getBoolean("dr_track", true)) return
+        val l = list(c).filter { it != route }.toMutableList()
+        l.add(0, route)
+        p.edit().putString("dr_recent", l.take(12).joinToString(",")).apply()
+    }
+
+    fun list(c: android.content.Context): List<String> =
+        (RasiAccount.prefs(c).getString("dr_recent", "") ?: "").split(",").filter { it.isNotBlank() }
+
+    fun clear(c: android.content.Context) { RasiAccount.prefs(c).edit().remove("dr_recent").apply() }
+}
+
+/** A readable name for a route, taken from the search index. */
+internal fun rasiRouteTitle(route: String): String =
+    RASI_SEARCH_INDEX.firstOrNull { it.route == route }?.screen ?: rasiPrettyRoute(route)
+
+/** Fallback title for a route that is not in the search index: musicMenu -> Music menu. */
+internal fun rasiPrettyRoute(route: String): String {
+    val base = route.substringBefore("/")
+    val words = base.replace(Regex("([a-z0-9])([A-Z])"), "\$1 \$2").trim()
+    if (words.isEmpty()) return route
+    val lower = words.lowercase()
+    return lower.replaceFirstChar { it.uppercase() }
+}
+
+internal val DRAWER_SECTIONS = listOf(
+    "profile" to "Profile", "recent" to "Recent menus", "messages" to "Messages", "shortcuts" to "Shortcuts"
+)
+
+internal fun rasiDrawerOrder(p: SharedPreferences): List<String> {
+    val saved = (p.getString("dr_order", "") ?: "").split(",").filter { id -> DRAWER_SECTIONS.any { it.first == id } }.distinct()
+    return saved + DRAWER_SECTIONS.map { it.first }.filter { it !in saved }
+}
+
+/** The 3-bar button for the main settings title row. */
+@Composable
+fun RasiDrawerButton(nav: NavHostController) {
+    val ctx = LocalContext.current
+    val p = RasiAccount.prefs(ctx)
+    if (!p.getBoolean("dr_on", true)) return
+    var open by remember { mutableStateOf(false) }
+    IconButton(onClick = { open = true }) { Icon(Icons.Default.Menu, contentDescription = "Open the side drawer") }
+    if (open) RasiDrawer(nav) { open = false }
+}
