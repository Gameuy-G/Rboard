+/** Lifts dark colors so text stays readable on the card. */
+internal fun rasiNowLift(c: Int, on: Boolean): Int {
+    if (!on) return c
+    val h = FloatArray(3); android.graphics.Color.colorToHSV(c, h)
+    h[2] = h[2].coerceAtLeast(0.78f)
+    return android.graphics.Color.HSVToColor(h)
+}
+
+/** The Listening to line. mode: none (normal text), gradient (song colors), song (first song color), manual (own color). */
+@Composable
+internal fun RasiNowLine(text: String, mode: String, manual: Int, c1: Int, c2: Int, lift: Boolean, accent: Int, modifier: Modifier = Modifier) {
+    val a = Color(rasiNowLift(accent or (0xFF shl 24), lift))
+    val s1 = if (c1 != 0) Color(rasiNowLift(c1 or (0xFF shl 24), lift)) else a
+    val s2 = if (c2 != 0) Color(rasiNowLift(c2 or (0xFF shl 24), lift)) else s1
+    val bold = FontWeight.Bold
+    when {
+        mode == "gradient" -> Text(text, modifier, style = androidx.compose.ui.text.TextStyle(brush = Brush.horizontalGradient(listOf(s1, s2)), fontWeight = bold))
+        mode == "song" -> Text(text, modifier, color = s1, fontWeight = bold)
+        mode == "manual" -> Text(text, modifier, color = Color(manual or (0xFF shl 24)), fontWeight = bold)
+        else -> Text(text, modifier, fontWeight = bold)
+    }
+}
