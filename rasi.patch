+                        ) {
+                            OutlinedButton(onClick = { picking.value = 1 }) { Text(if (from.value.kind == "auto" && detected.value.isNotEmpty()) "Auto: " + detected.value else from.value.name) }
+                            IconButton(onClick = {
+                                if (from.value.kind == "auto") return@IconButton
+                                val t = from.value
