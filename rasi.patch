+    /** Effects drawn after the visualizer (above it) instead of before it (under it). */
+    private fun fxAfter(ctx: android.content.Context): Boolean {
+        val l = RasiNowPlaying.prefs(ctx).getString("fx_layer", "behind") ?: "behind"
+        return l == "mid" || l == "top"
+    }
+
+    /** The same move, rotation and flip for the keyboard part and the strip part. */
+    private fun fxTransform(canvas: Canvas, base: android.content.SharedPreferences, ang: Double, w: Float, h: Float) {
+        val rad = Math.toRadians(ang)
+        val cs = Math.abs(Math.cos(rad)).toFloat()
+        val sn = Math.abs(Math.sin(rad)).toFloat()
+        val comp = maxOf((w * cs + h * sn) / w, (w * sn + h * cs) / h, 1f)
+        canvas.translate(w * base.getInt("fx_x", 0) / 100f, -h * base.getInt("fx_y", 0) / 100f)
+        canvas.rotate(ang.toFloat(), w / 2f, h / 2f)
+        canvas.scale(
+            comp * (if (base.getBoolean("fx_flip_h", false)) -1f else 1f),
+            comp * (if (base.getBoolean("fx_flip_v", false)) -1f else 1f),
+            w / 2f, h / 2f
+        )
+    }
+
+    private fun drawFx(view: View, canvas: Canvas, over: Boolean) {
+        try {
+            val ctx = view.context
+            if (!fxWanted(ctx)) return
+            val base = RasiNowPlaying.prefs(ctx)
+            RasiFxPrefs.init(base)
+            if (!over) {
+                register(view)
+                if (!running) kick()
+            }
+            val layer = base.getString("fx_layer", "behind") ?: "behind"
+            val overLayer = layer == "over" || layer == "top"
+            val behindLayer = layer == "behind" || layer == "mid"
+            if (over && !overLayer && layer != "both") return
+            if (!over && !behindLayer && layer != "both") return
+            val w = view.width.toFloat()
+            val h = view.height.toFloat()
+            if (w <= 0f || h <= 0f) return
+            val ext = navExt
+            val hT = h + ext
+            if (!over || layer == "over" || layer == "top") {
+                fxH = h
+                fxW = w
+                view.getLocationOnScreen(locTmp)
+                fxLeft = locTmp[0].toFloat()
+            }
+            val p = RasiFxPrefs.of(base)
+            val speed = base.getInt("fx_speed", 100) / 100f
+            val nowMs = System.currentTimeMillis()
+            if (fxLastMs != 0L && nowMs != fxLastMs) fxClock += (nowMs - fxLastMs).coerceIn(0L, 200L) * speed
+            fxLastMs = nowMs
+            val ang = base.getInt("fx_rot", 0) + base.getInt("fx_spin", 0) * (fxClock / 1000.0)
+            fxAng = ang
+            val dens = view.resources.displayMetrics.density * base.getInt("fx_size", 100) / 100f
+            val alpha = (255 * base.getInt("fx_opacity", 80) / 100f).toInt().coerceIn(0, 255)
+            val c0 = colors(p, "viz_", false)
+            val col = Colors(c0.src, c0.c1, c0.c2, fxClock.toLong(), c0.list)
+            col.beat = c0.beat
+            val style = RasiFxPrefs.style(p)
+            val saved = canvas.save()
+            try {
+                // the effect is laid out over the keyboard AND the navigation strip, this view shows the top part
+                fxTransform(canvas, base, ang, w, hT)
+                curExt = 0f
+                renderStyleCore(canvas, p, style, col, w, hT, alpha, p.getInt("viz_sens", 70) / 100f * 1.6f, dens, false)
+            } finally {
+                canvas.restoreToCount(saved)
+            }
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "fx draw failed: " + t)
+        }
+    }
