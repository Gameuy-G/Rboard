+            .clip(RoundedCornerShape(18.dp))
+            .background(bg)
+            .then(if (isSelected) Modifier.border(1.5.dp, scheme.primary, RoundedCornerShape(18.dp)) else Modifier)
+            .clickable { onClick() }
+            .padding(horizontal = 16.dp),
+        contentAlignment = Alignment.Center
+    ) {
+        Text(label, color = scheme.onKeyboardContainer, maxLines = 1)
