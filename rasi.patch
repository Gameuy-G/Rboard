+    /** One time: put every look option of the keyboard visualizer back to the defaults the previews use. */
+    private fun migrate(ctx: Context) {
+        if (migrated) return
+        migrated = true
+        try {
+            val b = RasiNowPlaying.prefs(ctx)
+            if (b.getBoolean("viz_reset_v3", false)) return
+            val e = b.edit()
+            for (k in listOf("viz_height", "viz_yoff", "viz_pos", "viz_barw", "viz_count", "viz_mirror", "viz_thick",
+                "viz_size", "viz_cpos", "viz_cx", "viz_cy", "viz_spin", "viz_spin_speed", "viz_layer", "viz_to_bottom")) e.remove(k)
+            e.putInt("viz_opacity", 78).putInt("viz_sens", 70).putBoolean("viz_reset_v3", true).apply()
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "migrate failed: " + t)
+        }
+    }
