+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.graphics.Canvas
+import android.graphics.Color as AColor
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffXfermode
+import android.graphics.RadialGradient
+import android.graphics.Region
+import android.graphics.Shader
+import android.util.Log
+import android.view.View
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawBehind
+import androidx.compose.ui.draw.drawWithContent
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.layout.positionInWindow
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.ui.graphics.drawscope.drawIntoCanvas
+import androidx.compose.ui.graphics.nativeCanvas
+import androidx.compose.ui.platform.LocalView
+import kotlinx.coroutines.delay
+
+/**
+ * Border glow: colored light along the 4 sides and 4 corners of the WHOLE keyboard (suggestion/actions bar, keys and
+ * the strip behind the navigation buttons) as ONE shape. Every side and corner has its own on/off, size, strength,
+ * shape and color, or all of them share one set (Sync). Layers: "under_viz", "over_viz" (both under the keys) and
+ * "all" (over everything). The shape is always computed for the full keyboard rectangle; each part of the keyboard
+ * (bar, keys, nav strip) only draws the piece that falls inside it, so the pieces line up without seams.
+ * Off in Performance mode. Preferences use the gl_ prefix in the rasi_nowplaying file.
+ */
+object RasiBorderGlow {
+    val SIDES = listOf("t" to "Top", "b" to "Bottom", "l" to "Left", "r" to "Right")
+    val CORNERS = listOf("tl" to "Top left corner", "tr" to "Top right corner", "bl" to "Bottom left corner", "br" to "Bottom right corner")
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val maskPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { xfermode = PorterDuffXfermode(PorterDuff.Mode.DST_IN) }
+
+    fun wanted(ctx: Context, p: SharedPreferences = RasiNowPlaying.prefs(ctx)): Boolean {
+        if (!p.getBoolean("gl_on", false)) return false
+        if (!RasiNowPlaying.masterOn(ctx)) return false
+        if (org.futo.inputmethod.latin.uix.RasiPerf.isOn()) return false
+        if (p.getBoolean("gl_only_play", true) && RasiNowPlaying.track?.playing != true) return false
+        return true
+    }
+
+    /** True when the colors move by themselves (needs a redraw every frame). */
+    fun animated(ctx: Context, p: SharedPreferences = RasiNowPlaying.prefs(ctx)): Boolean {
+        if (!wanted(ctx, p)) return false
+        return p.getString("gl_color_src", "song") == "rgb" || p.getBoolean("gl_beat_on", true) ||
+            p.getInt("gl_breath", 0) > 0 || p.getInt("gl_cycle", 0) > 0 || p.getInt("gl_cycle_beat", 0) > 0
+    }
+
+    /** True when the glow wants the real audio levels (so the music visualizer does not have to be on). */
+    fun reactive(ctx: Context, p: SharedPreferences = RasiNowPlaying.prefs(ctx)): Boolean = wanted(ctx, p) && p.getBoolean("gl_beat_on", true)
+
+    fun layerOf(p: SharedPreferences): String {
+        val l = p.getString("gl_layer", "over_viz") ?: "over_viz"
+        return if (l == "over_keys") "all" else l // the old "over the keys, under the bar" layer no longer exists
+    }
+
+    // The whole keyboard (bar + keys + nav strip) and the key rows, in window coordinates
+    @Volatile var fullX = 0f
+    @Volatile var fullY = 0f
+    @Volatile var fullW = 0f
+    @Volatile var fullH = 0f
+    @Volatile var keysX = 0f
+    @Volatile var keysY = 0f
+    @Volatile var keysW = 0f
+    @Volatile var keysH = 0f
+    private val loc = IntArray(2)
+
+    fun setFull(x: Float, y: Float, w: Float, h: Float) { fullX = x; fullY = y; fullW = w; fullH = h }
+
+    /** The key rows report where they are, so the other pieces can leave that area to them. */
+    fun noteKeys(view: View) {
+        view.getLocationInWindow(loc)
+        keysX = loc[0].toFloat(); keysY = loc[1].toFloat(); keysW = view.width.toFloat(); keysH = view.height.toFloat()
+    }
+
+    /** Draws the part of the one big keyboard glow that lies inside [view]. */
+    fun drawPiece(view: View, canvas: Canvas, layer: String) {
+        if (fullW <= 0f || fullH <= 0f) {
+            draw(view, canvas, layer, view.width.toFloat(), view.height.toFloat())
+            return
+        }
+        view.getLocationInWindow(loc)
+        val saved = canvas.save()
+        canvas.translate(fullX - loc[0], fullY - loc[1])
+        draw(view, canvas, layer, fullW, fullH)
+        canvas.restoreToCount(saved)
+    }
+
+    private class El(val sizePx: Float, val a: Int, val sharp: Boolean, val colors: RasiNowPlayingViz.Colors, val stretch: Float, val hue: Float, val white: Float)
+
+    /** Called from the keyboard view for the layers inside it. */
+    fun drawView(view: View, canvas: Canvas, layer: String) =
+        draw(view, canvas, layer, view.width.toFloat(), view.height.toFloat())
+
+    fun draw(view: View, canvas: Canvas, layer: String, w: Float, h: Float) {
+        val p = RasiNowPlaying.prefs(view.context)
+        if (!p.getBoolean("gl_on", false)) return
+        // so the view is redrawn when the song or the play state changes
+        RasiNowPlayingViz.registerView(view)
+        if (!wanted(view.context, p)) return
+        if (layerOf(p) != layer) return
+        drawCore(view, canvas, p, RasiGlowBeat, w, h, 100)
+    }
+
+    /** Draws the glow with the given options and beat state (the keyboard glow and the settings glow each have their own). */
+    fun drawCore(view: View, canvas: Canvas, p: SharedPreferences, beat: GlowBeatState, w: Float, h: Float, defOpacity: Int) {
+        try {
+            if (w <= 0f || h <= 0f) return
+            val dens = view.resources.displayMetrics.density
+            val sync = p.getBoolean("gl_sync", true)
+            val grad = p.getBoolean("gl_grad", true)
+            val opacity = p.getInt("gl_opacity", defOpacity) / 100f
+            val inset = p.getInt("gl_inset", 0) * dens
+            val now = System.currentTimeMillis()
+            val shared = RasiNowPlayingViz.baseColors(p, "gl_", false)
+            val bOn = p.getBoolean("gl_beat_on", true)
+            val gSrc = p.getString("gl_beat_src", "beat") ?: "beat"
+            val react = p.getInt("gl_react", 100) / 100f
+            val sizeReact = p.getInt("gl_size_react", 20) / 100f
+            val flash = p.getInt("gl_flash", 25) / 100f
+            val pale = p.getInt("gl_pale", 0) / 100f
+            val breathSpeed = p.getInt("gl_breath", 0)
+            var idleLvl = p.getInt("gl_idle", 35) / 100f
+            if (breathSpeed > 0) idleLvl *= 0.7f + 0.3f * Math.sin(now / 1000.0 * breathSpeed / 20.0).toFloat()
+            val hue = (p.getInt("gl_cycle", 0) * (now % 3600000L) / 1000f + p.getInt("gl_cycle_beat", 0) * beat.beatCount) % 360f
+            val pulse = if (bOn) beat.pulse else 0f
+
+            fun el(id: String, corner: Boolean): El? {
+                if (!p.getBoolean("gl_" + id + "_on", true)) return null
+                val own = if (sync) "all" else id
+                val baseSize = p.getInt("gl_" + own + "_size", 28)
+                val src0 = p.getString("gl_" + id + "_src", "global") ?: "global"
+                val src = if (src0 == "global") gSrc else src0
+                val lvl = if (!bOn || src == "none") -1f else beat.level(src)
+                val f = if (lvl < 0f) 1f else idleLvl + (1f - idleLvl) * (lvl * react).coerceIn(0f, 1f)
+                val size = (if (corner && sync) baseSize * 2.5f else if (corner) p.getInt("gl_" + own + "_size", 70).toFloat() else baseSize.toFloat()) *
+                    dens * (1f + sizeReact * Math.max(lvl, 0f))
+                val str = p.getInt("gl_" + own + "_str", 80) / 100f
+                val a = (255f * str * opacity * f).toInt().coerceIn(0, 255)
+                val white = (flash * pulse + pale * (1f - RasiBeat.strength) * Math.max(lvl, 0f)).coerceIn(0f, 0.9f)
+                if (a <= 0 || size <= 0f) return null
+                val sharp = p.getString("gl_" + own + "_shape", "soft") == "sharp"
+                val stretch = p.getInt("gl_" + own + "_stretch", 100) / 100f
+                var colors = shared
+                if (!sync) {
+                    val cm = p.getString("gl_" + id + "_cm", "shared") ?: "shared"
+                    if (cm == "solid") {
+                        val c1 = p.getInt("gl_" + id + "_c1", 0xFF7CF29C.toInt())
+                        colors = RasiNowPlayingViz.Colors("solid", c1, c1, now)
+                    } else if (cm == "gradient") {
+                        colors = RasiNowPlayingViz.Colors("gradient", p.getInt("gl_" + id + "_c1", 0xFF7CF29C.toInt()), p.getInt("gl_" + id + "_c2", 0xFF4F8CFF.toInt()), now)
+                    }
+                }
+                return El(size, a, sharp, colors, stretch, hue, white)
+            }
+
+            val saved = canvas.save()
+            try {
+                canvas.clipRect(0f, 0f, w, h)
+                el("t", false)?.let { band(canvas, 0, w, h, inset, it, grad) }
+                el("b", false)?.let { band(canvas, 1, w, h, inset, it, grad) }
+                el("l", false)?.let { band(canvas, 2, w, h, inset, it, grad) }
+                el("r", false)?.let { band(canvas, 3, w, h, inset, it, grad) }
+                el("tl", true)?.let { corner(canvas, inset, inset, 0f, it, grad) }
+                el("tr", true)?.let { corner(canvas, w - inset, inset, 0.25f, it, grad) }
+                el("br", true)?.let { corner(canvas, w - inset, h - inset, 0.5f, it, grad) }
+                el("bl", true)?.let { corner(canvas, inset, h - inset, 0.75f, it, grad) }
+            } finally {
+                canvas.restoreToCount(saved)
+            }
+        } catch (t: Throwable) {
+            RasiLog.w("RasiGlow", "glow draw failed: " + t)
+        }
+    }
+
+    // fall-off from the edge to the inside: positions and strength
+    private val SOFT_P = floatArrayOf(0f, 0.35f, 0.7f, 1f)
+    private val SOFT_A = floatArrayOf(1f, 0.55f, 0.18f, 0f)
+    private val SHARP_P = floatArrayOf(0f, 0.55f, 0.62f, 1f)
+    private val SHARP_A = floatArrayOf(1f, 1f, 0f, 0f)
+
+    private fun withA(c: Int, a: Float): Int = AColor.argb((a.coerceIn(0f, 1f) * 255f).toInt(), AColor.red(c), AColor.green(c), AColor.blue(c))
+
+    /** The colors go around the keyboard as one ring and come back to the start, so there is no seam. */
+    private val hv = FloatArray(3)
+
+    private fun ring(e: El, s: Float): Int {
+        var c = e.colors.at(1f - Math.abs(2f * s - 1f))
+        if (e.hue != 0f) {
+            AColor.colorToHSV(c, hv)
+            hv[0] = (hv[0] + e.hue) % 360f
+            c = (c and (0xFF shl 24)) or (AColor.HSVToColor(hv) and 0xFFFFFF)
+        }
+        if (e.white > 0f) c = androidx.core.graphics.ColorUtils.blendARGB(c, AColor.WHITE, e.white)
+        return c
+    }
+
+    private fun band(canvas: Canvas, edge: Int, w: Float, h: Float, inset: Float, e: El, grad: Boolean) {
+        val sz = e.sizePx
+        val l: Float; val t: Float; val r: Float; val b: Float
+        val x0: Float; val y0: Float; val x1: Float; val y1: Float
+        val sa: Float; val sb: Float
+        when (edge) {
+            0 -> { l = 0f; r = w; t = inset; b = inset + sz; x0 = 0f; y0 = t; x1 = 0f; y1 = b; sa = 0f; sb = 0.25f }
+            1 -> { l = 0f; r = w; t = h - inset - sz; b = h - inset; x0 = 0f; y0 = b; x1 = 0f; y1 = t; sa = 0.75f; sb = 0.5f }
+            2 -> { l = inset; r = inset + sz; t = 0f; b = h; x0 = l; y0 = 0f; x1 = r; y1 = 0f; sa = 1f; sb = 0.75f }
+            else -> { l = w - inset - sz; r = w - inset; t = 0f; b = h; x0 = r; y0 = 0f; x1 = l; y1 = 0f; sa = 0.25f; sb = 0.5f }
+        }
+        val pos = if (e.sharp) SHARP_P else SOFT_P
+        val al = if (e.sharp) SHARP_A else SOFT_A
+        val a = e.a / 255f
+        if (!grad) {
+            val c = ring(e, 0f)
+            paint.shader = LinearGradient(x0, y0, x1, y1, IntArray(pos.size) { withA(c, al[it] * a) }, pos, Shader.TileMode.CLAMP)
+            canvas.drawRect(l, t, r, b, paint)
+            paint.shader = null
+            return
+        }
+        // color along the edge, then the fall-off as a mask
+        val n = 9
+        val cols = IntArray(n) { ring(e, sa + (sb - sa) * (it / (n - 1f))) or (0xFF shl 24) }
+        val cp = FloatArray(n) { it / (n - 1f) }
+        val horizontal = edge < 2
+        val layer = canvas.saveLayer(l, t, r, b, null)
+        paint.shader = if (horizontal) LinearGradient(l, 0f, r, 0f, cols, cp, Shader.TileMode.CLAMP)
+            else LinearGradient(0f, t, 0f, b, cols, cp, Shader.TileMode.CLAMP)
+        canvas.drawRect(l, t, r, b, paint)
+        paint.shader = null
+        maskPaint.shader = LinearGradient(x0, y0, x1, y1, IntArray(pos.size) { withA(AColor.WHITE, al[it] * a) }, pos, Shader.TileMode.CLAMP)
+        canvas.drawRect(l, t, r, b, maskPaint)
+        maskPaint.shader = null
+        canvas.restoreToCount(layer)
+    }
+
+    private fun corner(canvas: Canvas, cx: Float, cy: Float, s: Float, e: El, grad: Boolean) {
+        val pos = if (e.sharp) SHARP_P else SOFT_P
+        val al = if (e.sharp) SHARP_A else SOFT_A
+        val a = e.a / 255f
+        val c = ring(e, if (grad) s else 0f)
+        val rad = e.sizePx
+        val saved = canvas.save()
+        canvas.translate(cx, cy)
+        canvas.scale(e.stretch, 1f)
+        paint.shader = RadialGradient(0f, 0f, rad, IntArray(pos.size) { withA(c, al[it] * a) }, pos, Shader.TileMode.CLAMP)
+        canvas.drawRect(-rad, -rad, rad, rad, paint)
+        paint.shader = null
+        canvas.restoreToCount(saved)
+    }
+}
+
+/** Beat state for a glow, updated once per visualizer tick. */
+open class GlowBeatState {
+    @Volatile var bass = 0f
+    @Volatile var mid = 0f
+    @Volatile var treble = 0f
+    /** 1 right after a beat (scaled by how strong it was), easing back to 0. */
+    @Volatile var pulse = 0f
+    @Volatile var beatCount = 0
+
+    fun level(src: String): Float = when (src) {
+        "bass" -> bass
+        "mid" -> mid
+        "treble" -> treble
+        "loud" -> (bass + mid + treble) / 3f
+        else -> pulse
+    }
+
+    private fun env(cur: Float, target: Float, up: Float, down: Float): Float =
+        cur + (target - cur) * (if (target > cur) up else down)
+
+    /** disp = smoothed band levels (0..1), k = frame length scale used by the visualizer. */
+    fun update(p: SharedPreferences, disp: FloatArray, beat: Boolean, strength: Float, k: Float) {
+        if (!p.getBoolean("gl_on", false)) return
+        val sens = p.getInt("gl_sens", 100) / 100f * 1.6f
+        fun avg(a: Int, b: Int): Float {
+            var t = 0f
+            val e = minOf(b, disp.size)
+            for (i in a until e) t += disp[i]
+            return (t / maxOf(1, e - a) * sens).coerceIn(0f, 1f)
+        }
+        val up = 1f - Math.pow(1.0 - (0.15 + 0.8 * p.getInt("gl_attack", 70) / 100.0), k.toDouble()).toFloat()
+        val down = 1f - Math.pow(0.95 - 0.35 * (1.0 - p.getInt("gl_decay", 50) / 100.0) - 0.0, k.toDouble()).toFloat()
+        bass = env(bass, avg(0, 6), up, down)
+        mid = env(mid, avg(6, 24), up, down)
+        treble = env(treble, avg(24, 64), up, down)
+        if (beat) {
+            pulse = maxOf(pulse, (0.45f + 0.55f * strength * sens / 1.6f).coerceIn(0f, 1f))
+            beatCount++
+        } else {
+            pulse *= Math.pow(0.55 + 0.38 * p.getInt("gl_decay", 50) / 100.0, k.toDouble()).toFloat()
+            if (pulse < 0.01f) pulse = 0f
+        }
+    }
+}
+
+/** Beat state of the keyboard glow. */
+object RasiGlowBeat : GlowBeatState()
+
+/** Beat state of the glow behind the settings screens (its own sensitivity, smoothing and decay). */
+object RasiSetGlowBeat : GlowBeatState()
+
+/** Gives one set of options its own copy under other key names, for example gl_ becomes sgl_. */
+class RasiRemapPrefs(private val base: SharedPreferences, private val map: (String?) -> String?) : SharedPreferences by base {
+    override fun getString(key: String?, defValue: String?): String? = base.getString(map(key), defValue)
+    override fun getInt(key: String?, defValue: Int): Int = base.getInt(map(key), defValue)
+    override fun getBoolean(key: String?, defValue: Boolean): Boolean = base.getBoolean(map(key), defValue)
+    override fun getFloat(key: String?, defValue: Float): Float = base.getFloat(map(key), defValue)
+    override fun getLong(key: String?, defValue: Long): Long = base.getLong(map(key), defValue)
+    override fun contains(key: String?): Boolean = base.contains(map(key))
+    override fun edit(): SharedPreferences.Editor = RemapEditor(base.edit(), map)
+
+    private class RemapEditor(private val e: SharedPreferences.Editor, private val map: (String?) -> String?) : SharedPreferences.Editor by e {
+        override fun putString(key: String?, value: String?): SharedPreferences.Editor { e.putString(map(key), value); return this }
+        override fun putInt(key: String?, value: Int): SharedPreferences.Editor { e.putInt(map(key), value); return this }
+        override fun putBoolean(key: String?, value: Boolean): SharedPreferences.Editor { e.putBoolean(map(key), value); return this }
+        override fun putFloat(key: String?, value: Float): SharedPreferences.Editor { e.putFloat(map(key), value); return this }
+        override fun putLong(key: String?, value: Long): SharedPreferences.Editor { e.putLong(map(key), value); return this }
+        override fun remove(key: String?): SharedPreferences.Editor { e.remove(map(key)); return this }
+    }
+}
+
+/** The glow behind the settings screens keeps its own copy of every gl_ option (stored as sgl_). */
+object RasiGlowPrefs {
+    @Volatile private var cached: SharedPreferences? = null
+    @Volatile private var cachedBase: SharedPreferences? = null
+
+    fun settings(base: SharedPreferences): SharedPreferences {
+        val c = cached
+        if (c != null && cachedBase === base) return c
+        val n = RasiRemapPrefs(base) { k -> if (k != null && k.startsWith("gl_")) "s$k" else k }
+        cached = n
+        cachedBase = base
+        return n
+    }
+}
+
+/**
+ * Modifier that draws the glow over everything inside (keys and suggestion bar). It only draws, so touches pass through.
+ * Redraws when the song or the play state changes, and every frame while the colors are animated.
+ */
+@Composable
+fun rasiGlowOverlayModifier(): Modifier {
+    val view = LocalView.current
+    var tick by remember { mutableIntStateOf(0) }
+    val pos = remember { FloatArray(2) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        RasiNowPlaying.listeners.add(l)
+        onDispose { RasiNowPlaying.listeners.remove(l) }
+    }
+    LaunchedEffect(Unit) {
+        while (true) {
+            val p = RasiNowPlaying.prefs(view.context)
+            if (RasiBorderGlow.layerOf(p) == "all" && RasiBorderGlow.animated(view.context)) {
+                androidx.compose.runtime.withFrameNanos { }
+                tick++
+            } else delay(400)
+        }
+    }
+    return Modifier.onGloballyPositioned {
+        val o = it.positionInWindow()
+        pos[0] = o.x; pos[1] = o.y
+    }.drawWithContent {
+        drawContent()
+        val t = tick // read so the glow is redrawn when this changes
+        if (t >= 0) drawIntoCanvas {
+            val n = it.nativeCanvas
+            val saved = n.save()
+            n.clipRect(0f, 0f, size.width, size.height)
+            if (RasiBorderGlow.fullW > 0f && RasiBorderGlow.fullH > 0f) {
+                // the glow of the whole keyboard, shifted so this part lines up with the rest
+                n.translate(RasiBorderGlow.fullX - pos[0], RasiBorderGlow.fullY - pos[1])
+                RasiBorderGlow.draw(view, n, "all", RasiBorderGlow.fullW, RasiBorderGlow.fullH)
+            } else {
+                RasiBorderGlow.draw(view, n, "all", size.width, size.height)
+            }
+            n.restoreToCount(saved)
+        }
+    }
+}
+
+/**
+ * Sits behind the whole keyboard. It reports the keyboard rectangle (so every piece of the glow lines up) and draws the
+ * glow for the layers under the keys in the areas the key rows do not cover: the suggestion/actions bar and, for
+ * "under the visualizer", the strip behind the navigation buttons (for "over the visualizer" that strip draws itself).
+ */
+@Composable
+fun RasiGlowBackdrop(modifier: Modifier = Modifier) {
+    val view = LocalView.current
+    var tick by remember { mutableIntStateOf(0) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        RasiNowPlaying.listeners.add(l)
+        onDispose { RasiNowPlaying.listeners.remove(l) }
+    }
+    LaunchedEffect(Unit) {
+        while (true) {
+            val p = RasiNowPlaying.prefs(view.context)
+            val lay = RasiBorderGlow.layerOf(p)
+            if (lay != "all" && RasiBorderGlow.animated(view.context)) {
+                androidx.compose.runtime.withFrameNanos { }
+                tick++
+            } else delay(400)
+        }
+    }
+    Box(modifier.onGloballyPositioned {
+        val o = it.positionInWindow()
+        RasiBorderGlow.setFull(o.x, o.y, it.size.width.toFloat(), it.size.height.toFloat())
+    }.drawBehind {
+        val t = tick
+        if (t < 0) return@drawBehind
+        val lay = RasiBorderGlow.layerOf(RasiNowPlaying.prefs(view.context))
+        if (lay == "all") return@drawBehind
+        drawIntoCanvas {
+            val n = it.nativeCanvas
+            val saved = n.save()
+            if (RasiBorderGlow.keysW > 0f && RasiBorderGlow.keysH > 0f) {
+                val kx = RasiBorderGlow.keysX - RasiBorderGlow.fullX
+                val ky = RasiBorderGlow.keysY - RasiBorderGlow.fullY
+                n.clipRect(kx, ky, kx + RasiBorderGlow.keysW, ky + RasiBorderGlow.keysH, Region.Op.DIFFERENCE)
+            }
+            if (lay == "over_viz" && RasiNowPlayingViz.navExt > 0f) {
+                n.clipRect(0f, size.height - RasiNowPlayingViz.navExt, size.width, size.height, Region.Op.DIFFERENCE)
+            }
+            RasiBorderGlow.draw(view, n, lay, size.width, size.height)
+            n.restoreToCount(saved)
+        }
+    })
+}
