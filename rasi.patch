@@ -0,0 +1,204 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import org.futo.inputmethod.latin.SuggestedWords
+import org.futo.inputmethod.latin.SuggestedWords.SuggestedWordInfo
+import org.futo.inputmethod.latin.RASI_SECOND_EMOJI
+import org.futo.inputmethod.latin.uix.actions.PersistentEmojiState
+import org.json.JSONArray
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+
+/**
+ * Suggestion bar candidates for phonetic typing (Bangla / Hindi):
+ * typed English letters, the converted word, words you picked before for these letters,
+ * words from the language dictionary, spelling variants, and (only as a backup when the
+ * dictionary has little) online suggestions.
+ */
+object RasiPhoneticBar {
+    private const val LEARN = "rasi_phonetic_learn"
+    private const val SEP = "\u001F"
+    private const val MAX = 24
+
+    private val main = Handler(Looper.getMainLooper())
+    private var lastDict: List<String> = emptyList()
+    private var lastRaw = ""
+
+    private class Net(val script: String, val raw: String, val native: List<String>, val english: List<String>)
+    @Volatile private var net: Net? = null
+    @Volatile private var pending: String = ""
+
+    // ---- learned picks
+    private fun learnPrefs(c: Context) = c.applicationContext.getSharedPreferences(LEARN, Context.MODE_PRIVATE)
+
+    fun learn(c: Context, script: String, raw: String, word: String) {
+        val key = script + "_" + raw.lowercase()
+        val p = learnPrefs(c)
+        val map = LinkedHashMap<String, Int>()
+        (p.getString(key, "") ?: "").split(SEP).filter { it.contains("=") }.forEach {
+            val i = it.lastIndexOf('=')
+            map[it.substring(0, i)] = it.substring(i + 1).toIntOrNull() ?: 1
+        }
+        map[word] = (map[word] ?: 0) + 1
+        val top = map.entries.sortedByDescending { it.value }.take(4)
+        p.edit().putString(key, top.joinToString(SEP) { it.key + "=" + it.value }).apply()
+    }
+
+    private fun learned(c: Context, script: String, raw: String): List<String> {
+        val key = script + "_" + raw.lowercase()
+        val out = ArrayList<Pair<String, Int>>()
+        (learnPrefs(c).getString(key, "") ?: "").split(SEP).filter { it.contains("=") }.forEach {
+            val i = it.lastIndexOf('=')
+            out.add(it.substring(0, i) to (it.substring(i + 1).toIntOrNull() ?: 1))
+        }
+        return out.sortedByDescending { it.second }.map { it.first }
+    }
+
+    // ---- spelling variants (one change at a time, like Avro alternatives)
+    private val swaps = listOf(
+        "a" to "o", "o" to "O", "i" to "ii", "u" to "uu", "e" to "oi", "t" to "T", "d" to "D",
+        "n" to "N", "s" to "sh", "z" to "j", "r" to "R"
+    )
+
+    private fun variants(script: RasiPhonetic.Script?, raw: String): List<String> {
+        if (script == null) return emptyList()
+        val out = LinkedHashSet<String>()
+        for ((from, to) in swaps) {
+            var idx = raw.indexOf(from)
+            var guard = 0
+            while (idx >= 0 && guard < 4) {
+                val v = raw.substring(0, idx) + to + raw.substring(idx + from.length)
+                out.add(RasiPhonetic.transliterate(script, v))
+                idx = raw.indexOf(from, idx + 1)
+                guard++
+            }
+        }
+        return out.toList()
+    }
+
+    // ---- online backup
+    private fun httpText(url: String): String? = try {
+        val conn = URL(url).openConnection() as HttpURLConnection
+        try {
+            conn.connectTimeout = 4000
+            conn.readTimeout = 4000
+            conn.setRequestProperty("User-Agent", "RasiKeyboard")
+            if (conn.responseCode != 200) null else conn.inputStream.bufferedReader().use { it.readText() }
+        } finally { conn.disconnect() }
+    } catch (t: Throwable) { null }
+
+    private fun fetchNet(script: String, raw: String): Net {
+        val enc = URLEncoder.encode(raw, "UTF-8")
+        val itc = script + "-t-i0-und"
+        val native = ArrayList<String>()
+        val english = ArrayList<String>()
+        try {
+            val t = httpText("https://inputtools.google.com/request?text=$enc&itc=$itc&num=10&cp=0&cs=1&ie=utf-8&oe=utf-8&app=rboard")
+            if (t != null) {
+                val root = JSONArray(t)
+                if (root.optString(0) == "SUCCESS") {
+                    val arr = root.getJSONArray(1).getJSONArray(0).getJSONArray(1)
+                    for (i in 0 until arr.length()) native.add(arr.getString(i))
+                }
+            }
+        } catch (t: Throwable) { }
+        if (raw.length >= 2) {
+            try {
+                val t = httpText("https://api.datamuse.com/sug?s=$enc&max=6")
+                if (t != null) {
+                    val arr = JSONArray(t)
+                    for (i in 0 until arr.length()) english.add(arr.getJSONObject(i).getString("word"))
+                }
+            } catch (t: Throwable) { }
+        }
+        return Net(script, raw, native, english)
+    }
+
+    private fun requestNet(script: String, raw: String, done: () -> Unit) {
+        if (pending == script + raw) return
+        pending = script + raw
+        Thread {
+            try {
+                Thread.sleep(250)
+                if (pending != script + raw) return@Thread
+                val r = fetchNet(script, raw)
+                net = r
+                main.post { try { done() } catch (t: Throwable) { } }
+            } catch (t: Throwable) { }
+        }.start()
+    }
+
+    /** Up to 2 emoji for the English letters being typed (shown in the last 2 slots, even when converted). */
+    private fun emojisFor(c: Context, raw: String): List<String> = try {
+        if (!(raw.length > 2 || raw.all { it.isUpperCase() })) emptyList() else {
+            RasiEmojiWords.ensureLoaded(c)
+            val lower = raw.lowercase()
+            val found = ArrayList<String>(4)
+            RasiEmojiLearn.learnedFor(lower).forEach { if (it !in found) found.add(it) }
+            RasiEmojiWords.lookup(lower).forEach { if (it !in found) found.add(it) }
+            if (found.isEmpty()) RasiEmojiWords.lookupPrefix(lower).forEach { if (it !in found) found.add(it) }
+            PersistentEmojiState.getShortcut(java.util.Locale.ENGLISH, lower)?.let { if (it !in found) found.add(it) }
+            RASI_SECOND_EMOJI[lower]?.let { if (it !in found) found.add(it) }
+            found.take(2).map { PersistentEmojiState.transformEmojiToLastSkinTone(it) }
+        }
+    } catch (t: Throwable) { emptyList() }
+
+    /**
+     * Builds the candidate list for the word being typed. [words] are the language dictionary's
+     * suggestions (null to reuse the last ones, e.g. when online results arrive later).
+     * [onNet] is called on the main thread when online results are ready.
+     */
+    fun build(c: Context, words: SuggestedWords?, onNet: () -> Unit): SuggestedWords? {
+        if (!RasiPhonetic.inConversion()) return null
+        val raw = RasiPhonetic.rawWord()
+        val conv = RasiPhonetic.shown()
+        if (raw.isEmpty() || conv.isEmpty()) return null
+        val script = RasiPhonetic.scriptNow()
+
+        if (words != null) {
+            lastRaw = raw
+            lastDict = words.mSuggestedWordInfoList
+                .filter { it.kind != SuggestedWordInfo.KIND_TYPED && it.kind != SuggestedWordInfo.KIND_EMOJI_SUGGESTION }
+                .map { it.mWord }
+                .filter { it.isNotBlank() && it != conv && it != raw }
+        } else if (lastRaw != raw) {
+            lastDict = emptyList()
+        }
+        val dict = lastDict
+
+        val all = LinkedHashSet<String>()
+        all.add(raw)
+        all.add(conv)
+        learned(c, script, raw).forEach { all.add(it) }
+        dict.forEach { all.add(it) }
+
+        val sc = RasiPhonetic.scriptObj(script)
+        variants(sc, raw).forEach { all.add(it) }
+
+        // Online results are only a backup when the dictionary offers little
+        val n = net
+        if (n != null && n.script == script && n.raw == raw) {
+            n.native.forEach { all.add(it) }
+            n.english.forEach { all.add(it) }
+        } else if (dict.size < 3 && RasiPhonetic.netEnabled(c)) {
+            requestNet(script, raw, onNet)
+        }
+
+        val infos = ArrayList<SuggestedWordInfo>()
+        val typed = SuggestedWordInfo(conv, "", 1_000_000, SuggestedWordInfo.KIND_TYPED, null, 0, 0)
+        infos.add(typed)
+        var score = 900_000
+        for (w in all) {
+            if (infos.size > MAX) break
+            infos.add(SuggestedWordInfo(w, "", score--, SuggestedWordInfo.KIND_CORRECTION, null, 0, 0))
+        }
+        // emoji for the English word go last; the bar pins them in 2 fixed slots next to the arrow
+        emojisFor(c, raw).forEachIndexed { i, e ->
+            infos.add(SuggestedWordInfo(e, "", 100_000 - i, SuggestedWordInfo.KIND_EMOJI_SUGGESTION, null, 0, 0))
+        }
+        return SuggestedWords(infos, infos, typed, false, false, false, SuggestedWords.INPUT_STYLE_TYPING, 0)
+    }
+}
