+@Composable
+private fun LkSlider(label: String, unit: String, init: Int, min: Int, max: Int, onDone: (Int) -> Unit) {
+    var v by remember { mutableFloatStateOf(init.toFloat()) }
+    Text(label + ": " + v.toInt() + unit)
+    Slider(value = v, onValueChange = { v = it }, valueRange = min.toFloat()..max.toFloat(), onValueChangeFinished = { onDone(v.toInt()) })
+}
+
+@Composable
+private fun LkColor(label: String, init: Int, onDone: (Int) -> Unit) {
+    val hsv = FloatArray(3)
+    android.graphics.Color.colorToHSV(init, hsv)
+    var hue by remember { mutableFloatStateOf(hsv[0]) }
+    var bri by remember { mutableFloatStateOf(hsv[2].coerceIn(0.3f, 1f)) }
+    val color = android.graphics.Color.HSVToColor(floatArrayOf(hue, if (hsv[1] < 0.05f && hue == hsv[0]) 0f else 0.85f, bri))
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        Text(label)
+        Row(Modifier.size(28.dp).clip(CircleShape).background(androidx.compose.ui.graphics.Color(color))) {}
+    }
+    Slider(value = hue, onValueChange = { hue = it }, valueRange = 0f..360f, onValueChangeFinished = { onDone(color) })
+    Slider(value = bri, onValueChange = { bri = it }, valueRange = 0.3f..1f, onValueChangeFinished = { onDone(color) })
+}
