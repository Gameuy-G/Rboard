+/**
+ * Reorder mode: the normal clipboard grid, but long-press an item and drag it to move it.
+ * [items] is in display order. Calls [onReorder] with the new display order when a drag ends.
+ */
+@Composable
+fun RasiReorderGrid(
+    items: List<ClipboardEntry>,
+    columns: StaggeredGridCells,
+    onReorder: (List<ClipboardEntry>) -> Unit
+) {
+    val order = remember(items) { mutableStateListOf<ClipboardEntry>().apply { addAll(items) } }
+    val gridState = rememberLazyStaggeredGridState()
+    var draggingKey by remember { mutableStateOf<String?>(null) }
+    var dragX by remember { mutableFloatStateOf(0f) }
+    var dragY by remember { mutableFloatStateOf(0f) }
+
+    Column(Modifier.fillMaxWidth()) {
+        Text("Long-press an item, then drag it", modifier = Modifier.padding(horizontal = 8.dp))
+        LazyVerticalStaggeredGrid(
+            state = gridState,
+            modifier = Modifier.fillMaxWidth(),
+            columns = columns,
+            contentPadding = androidx.compose.foundation.layout.PaddingValues(bottom = 56.dp),
+            verticalItemSpacing = 4.dp,
+            horizontalArrangement = Arrangement.spacedBy(4.dp),
+        ) {
+            items(order.size, key = { rowKey(order[it]) }) { idx ->
+                val entry = order[idx]
+                val k = rowKey(entry)
+                val isDragging = draggingKey == k
+                Box(
+                    Modifier
+                        .then(if (isDragging) Modifier else Modifier.animateItem(
+                            placementSpec = androidx.compose.animation.core.spring(
+                                dampingRatio = 0.8f, stiffness = 400f)))
+                        .zIndex(if (isDragging) 1f else 0f)
+                        .graphicsLayer {
+                            translationX = if (isDragging) dragX else 0f
+                            translationY = if (isDragging) dragY else 0f
+                            val sc = if (isDragging) 1.05f else 1f
+                            scaleX = sc
+                            scaleY = sc
+                            shadowElevation = if (isDragging) 24f else 0f
+                            alpha = if (isDragging) 0.95f else 1f
+                        }
+                ) {
+                    ClipboardEntryView(
+                        modifier = Modifier,
+                        clipboardEntry = entry,
+                        onPaste = { },
+                        onRemove = { },
+                        onPin = { }
+                    )
+                    Box(
+                        Modifier
+                            .matchParentSize()
+                            .pointerInput(k) {
+                                detectDragGesturesAfterLongPress(
+                                    onDragStart = {
+                                        draggingKey = k
+                                        dragX = 0f
+                                        dragY = 0f
+                                    },
+                                    onDrag = { change, amount ->
+                                        change.consume()
+                                        dragX += amount.x
+                                        dragY += amount.y
+                                        val visible = gridState.layoutInfo.visibleItemsInfo
+                                        val me = visible.firstOrNull { it.key == k }
+                                        if (me != null) {
+                                            val cx = me.offset.x + me.size.width / 2f + dragX
+                                            val cy = me.offset.y + me.size.height / 2f + dragY
+                                            val target = visible.firstOrNull {
+                                                it.key != k &&
+                                                        cx >= it.offset.x && cx <= it.offset.x + it.size.width &&
+                                                        cy >= it.offset.y && cy <= it.offset.y + it.size.height
+                                            }
+                                            if (target != null) {
+                                                val from = order.indexOfFirst { rowKey(it) == k }
+                                                val to = order.indexOfFirst { rowKey(it) == target.key }
+                                                if (from >= 0 && to >= 0 && from != to) {
+                                                    order.add(to, order.removeAt(from))
+                                                    dragX -= (target.offset.x - me.offset.x)
+                                                    dragY -= (target.offset.y - me.offset.y)
+                                                }
+                                            }
+                                        }
+                                    },
+                                    onDragEnd = {
+                                        draggingKey = null
+                                        dragX = 0f
+                                        dragY = 0f
+                                        onReorder(order.toList())
+                                    },
+                                    onDragCancel = {
+                                        draggingKey = null
+                                        dragX = 0f
+                                        dragY = 0f
+                                        onReorder(order.toList())
+                                    }
+                                )
+                            }
+                    )
+                }
+            }
+        }
+    }
+}
