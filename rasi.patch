+import org.futo.inputmethod.latin.rasi.RasiEmojiLearn
+import org.futo.inputmethod.latin.rasi.RasiLearnedItem
+import org.futo.inputmethod.latin.rasi.RasiWordMemory
+import org.futo.inputmethod.latin.uix.settings.ScreenTitle
+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+
+private const val MAX_SHOWN = 150
+
+/** Lets you see and delete what Rboard learned on this phone (words, next-word pairs, typo fixes, emoji). */
+@Composable
+fun RasiLearnedListScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    remember { RasiWordMemory.init(context); RasiEmojiLearn.init(context); 0 }
+    var kind by remember { mutableIntStateOf(0) }
+    var query by remember { mutableStateOf("") }
+    var refresh by remember { mutableIntStateOf(0) }
+
+    val all: List<RasiLearnedItem> = remember(kind, refresh) {
+        when (kind) {
+            0 -> RasiWordMemory.listWords()
+            1 -> RasiWordMemory.listPairs()
+            2 -> RasiWordMemory.listFixes()
+            else -> RasiEmojiLearn.listAll()
+        }
+    }
+    val q = query.trim().lowercase()
+    val matches = remember(all, q) {
+        if (q.isEmpty()) all else all.filter { it.a.lowercase().contains(q) || it.b.lowercase().contains(q) }
+    }
+    val shown = matches.take(MAX_SHOWN)
+
+    ScrollableList {
+        ScreenTitle("What was learned", showBack = true, navController)
+        Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text("Everything here lives only on this phone. Tap Delete to make Rboard forget one item. Most used first.")
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(2.dp)) {
+                listOf("Words", "Next word", "Typo fixes", "Emoji").forEachIndexed { idx, name ->
+                    RasiTextButton(onClick = { kind = idx }) {
+                        Text(name, fontWeight = if (kind == idx) FontWeight.Bold else FontWeight.Normal)
+                    }
+                }
+            }
+            OutlinedTextField(
+                value = query,
+                onValueChange = { query = it },
+                singleLine = true,
+                label = { Text("Search") },
+                modifier = Modifier.fillMaxWidth()
+            )
+            Text(
+                if (matches.size > shown.size) "Showing the first ${shown.size} of ${matches.size}. Search to find others"
+                else "${matches.size} items"
+            )
+        }
+        shown.forEach { item ->
+            Row(
+                Modifier.fillMaxWidth().padding(horizontal = 16.dp),
+                horizontalArrangement = Arrangement.SpaceBetween,
+                verticalAlignment = androidx.compose.ui.Alignment.CenterVertically
+            ) {
+                Column(Modifier.weight(1f)) {
+                    Text(
+                        when (kind) {
+                            0 -> item.a
+                            1 -> "${item.a}  \u2192  ${item.b}"
+                            2 -> "${item.a}  \u2192  ${item.b}"
+                            else -> "${item.a}  \u2192  ${item.b}"
+                        },
+                        style = MaterialTheme.typography.bodyLarge
+                    )
+                    Text("used ${item.n}x", style = MaterialTheme.typography.bodySmall)
+                }
+                RasiTextButton(onClick = {
+                    when (kind) {
+                        0 -> RasiWordMemory.deleteWord(item.a)
+                        1 -> RasiWordMemory.deletePair(item.a, item.b)
+                        2 -> RasiWordMemory.deleteFix(item.a, item.b)
+                        else -> RasiEmojiLearn.delete(item.a, item.b)
+                    }
+                    refresh++
+                }) { Text("Delete") }
+            }
+        }
+    }
+}
