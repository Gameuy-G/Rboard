@@ -0,0 +1,46 @@
+package org.futo.inputmethod.latin.uix
+
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import androidx.datastore.preferences.core.stringPreferencesKey
+
+/** Key size overrides, saved as "gap;roundness;text;hint". They sit on top of the current theme. */
+val RasiKeySizeSetting = SettingsKey(stringPreferencesKey("rasi_key_sizes"), "")
+
+/** The small marks under suggested words (hidden by default). */
+val RasiSuggestionMarksSetting = SettingsKey(booleanPreferencesKey("rasi_suggestion_marks"), false)
+
+/** On = plain Gboard-style settings (no glass, no themed background). Music effects are not touched. */
+val RasiGboardLookSetting = SettingsKey(booleanPreferencesKey("rasi_gboard_look"), false)
+
+object RasiKeySizes {
+    data class Values(
+        val gap: Float = 1f,
+        /** Negative means follow the theme. */
+        val round: Float = -1f,
+        val text: Float = 1f,
+        val hint: Float = 1f,
+        /** Live blur of the theme background picture, 0 (off) to 1. */
+        val blur: Float = 0f,
+        /** Opacity of the key buttons, 0.1 to 1. */
+        val keyAlpha: Float = 1f,
+        /** Opacity of the key text, hints and icons, 0.1 to 1. */
+        val textAlpha: Float = 1f
+    ) {
+        fun encode(): String = "$gap;$round;$text;$hint;$blur;$keyAlpha;$textAlpha"
+    }
+
+    @Volatile var current: Values = Values()
+    @Volatile var suggestionMarks: Boolean = false
+
+    /** Observed by Compose so the background re-blurs as soon as the slider moves. */
+    val blurLevel = androidx.compose.runtime.mutableFloatStateOf(0f)
+
+    fun parse(s: String): Values {
+        val p = s.split(";").mapNotNull { it.toFloatOrNull() }
+        return when {
+            p.size >= 7 -> Values(p[0], p[1], p[2], p[3], p[4].coerceIn(0f, 1f), p[5].coerceIn(0.1f, 1f), p[6].coerceIn(0.1f, 1f))
+            p.size == 4 -> Values(p[0], p[1], p[2], p[3])
+            else -> Values()
+        }
+    }
+}
