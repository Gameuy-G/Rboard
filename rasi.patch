+private fun typefaceFor(i: Int): Typeface = when (i) {
+    0 -> Typeface.create("sans-serif", Typeface.NORMAL)
+    1 -> Typeface.create("serif", Typeface.NORMAL)
+    2 -> Typeface.create("monospace", Typeface.NORMAL)
+    3 -> Typeface.create("cursive", Typeface.NORMAL)
+    4 -> Typeface.create("casual", Typeface.NORMAL)
+    5 -> Typeface.create("sans-serif-condensed", Typeface.NORMAL)
+    6 -> Typeface.create("sans-serif-black", Typeface.NORMAL)
+    else -> Typeface.create("sans-serif-light", Typeface.NORMAL)
+}
+
+private fun drawTextItem(c: AndroidCanvas, t: TextItem, p: Paint) {
+    p.reset()
+    p.isAntiAlias = true
+    p.typeface = typefaceFor(t.font)
+    p.textSize = t.sizePx
+    p.textAlign = Paint.Align.CENTER
+    val w = p.measureText(t.text)
+    val fm = p.fontMetrics
+    val baseline = -(fm.ascent + fm.descent) / 2f
+    c.save()
+    c.translate(t.x, t.y)
+    c.rotate(t.rot)
+    if (t.bg) {
+        val pad = t.sizePx * 0.25f
+        p.style = Paint.Style.FILL
+        p.color = t.bgColor
+        c.drawRoundRect(-w / 2f - pad, fm.ascent + baseline - pad / 2f, w / 2f + pad, fm.descent + baseline + pad / 2f, pad, pad, p)
+    }
+    if (t.outline) {
+        p.style = Paint.Style.STROKE
+        p.strokeWidth = t.sizePx * 0.12f
+        p.strokeJoin = Paint.Join.ROUND
+        p.color = t.outlineColor
+        c.drawText(t.text, 0f, baseline, p)
+    }
+    p.style = Paint.Style.FILL
+    p.color = t.color
+    c.drawText(t.text, 0f, baseline, p)
+    c.restore()
+}
+
+private fun loadEditable(file: File): Bitmap? {
+    val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+    BitmapFactory.decodeFile(file.absolutePath, bounds)
+    var sample = 1
+    while (max(bounds.outWidth, bounds.outHeight) / sample > 1600) sample *= 2
+    val opts = BitmapFactory.Options().apply { inSampleSize = sample }
+    val src = BitmapFactory.decodeFile(file.absolutePath, opts) ?: return null
+    return src.copy(Bitmap.Config.ARGB_8888, true)
+}
+
+private class RasiEd(first: Bitmap) {
+    var st by mutableStateOf(EdState(first, Bitmap.createBitmap(first.width, first.height, Bitmap.Config.ARGB_8888), emptyList()))
+    val undo = ArrayList<EdState>()
+    val redo = ArrayList<EdState>()
+    var ver by mutableIntStateOf(0)
+    var rev by mutableIntStateOf(0)
+    var boxW by mutableFloatStateOf(0f)
+    var boxH by mutableFloatStateOf(0f)
+    var zoom by mutableFloatStateOf(1f)
+    var pan by mutableStateOf(Offset.Zero)
+    var ang by mutableFloatStateOf(0f)
+    var crop by mutableStateOf(RectF(0f, 0f, first.width.toFloat(), first.height.toFloat()))
+    var cropAr by mutableStateOf<Float?>(null)
+    var brushColor by mutableIntStateOf(android.graphics.Color.RED)
+    var brushSize by mutableFloatStateOf(8f)
+    var eraser by mutableStateOf(false)
+    var sel by mutableIntStateOf(-1)
+    var tmpl by mutableStateOf(
+        TextItem(-1, "", 0f, 0f, min(first.width, first.height) * 0.08f, android.graphics.Color.WHITE, 0,
+            false, android.graphics.Color.BLACK, true, android.graphics.Color.BLACK, 0f)
+    )
+    private var nextId = 1
+    private var lastKey: Any? = null
+    private var lastPt = Offset.Zero
+    private val sp = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val mp = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val clearMode = PorterDuffXfermode(PorterDuff.Mode.CLEAR)
+
+    val minDim: Float get() = min(st.base.width, st.base.height).toFloat()
+
+    fun push(key: Any? = null) {
+        if (key != null && key == lastKey) return
+        lastKey = key
+        undo.add(st)
+        if (undo.size > 8) undo.removeAt(0)
+        redo.clear()
+        ver++
+    }
+
+    fun doUndo() {
+        if (undo.isEmpty()) return
+        redo.add(st)
+        st = undo.removeAt(undo.size - 1)
+        lastKey = null
+        afterHistory()
+    }
+
+    fun doRedo() {
+        if (redo.isEmpty()) return
+        undo.add(st)
+        st = redo.removeAt(redo.size - 1)
+        lastKey = null
+        afterHistory()
+    }
+
+    private fun afterHistory() {
+        if (st.texts.none { it.id == sel }) sel = -1
+        resetCrop()
+        ver++
+        rev++
+    }
+
+    // ---- view ----
+    fun fit(): Float {
+        val bw = st.base.width.toFloat()
+        val bh = st.base.height.toFloat()
+        return if (boxW > 0f && boxH > 0f) min(boxW / bw, boxH / bh) else 1f
+    }
+    fun scale() = fit() * zoom
+    fun ox() = boxW / 2f + pan.x - st.base.width * scale() / 2f
+    fun oy() = boxH / 2f + pan.y - st.base.height * scale() / 2f
+    fun toBmp(p: Offset): Offset {
+        val s = scale()
+        return Offset((p.x - ox()) / s, (p.y - oy()) / s)
+    }
+    fun resetView() { zoom = 1f; pan = Offset.Zero }
+
+    private fun clampPan(p: Offset, s: Float): Offset {
+        val mx = max(0f, (st.base.width * s - boxW) / 2f)
+        val my = max(0f, (st.base.height * s - boxH) / 2f)
+        return Offset(p.x.coerceIn(-mx, mx), p.y.coerceIn(-my, my))
+    }
+
+    fun applyTransform(z: Float, pn: Offset, c: Offset) {
+        val nz = (zoom * z).coerceIn(1f, 10f)
+        val eff = nz / zoom
+        val p = Offset(c.x - boxW / 2f, c.y - boxH / 2f)
+        val np = p - (p - pan) * eff + pn
+        zoom = nz
+        pan = clampPan(np, fit() * nz)
+    }
+
+    fun panBy(d: Offset) { pan = clampPan(pan + d, scale()) }
+
+    // ---- draw ----
+    fun beginStroke(pos: Offset) {
+        push()
+        st = st.copy(draw = st.draw.copy(Bitmap.Config.ARGB_8888, true))
+        lastPt = toBmp(pos)
+        paintTo(lastPt, lastPt)
+    }
+
+    fun strokeTo(pos: Offset) {
+        val b = toBmp(pos)
+        paintTo(lastPt, b)
+        lastPt = b
+    }
+
+    private fun paintTo(a: Offset, b: Offset) {
+        sp.reset()
+        sp.isAntiAlias = true
+        sp.style = Paint.Style.STROKE
+        sp.strokeCap = Paint.Cap.ROUND
+        sp.strokeJoin = Paint.Join.ROUND
+        sp.strokeWidth = max(1.5f, brushSize * minDim / 400f)
+        sp.color = brushColor
+        if (eraser) sp.xfermode = clearMode
+        AndroidCanvas(st.draw).drawLine(a.x, a.y, b.x, b.y, sp)
+        rev++
+    }
+
+    fun clearDrawing() {
+        push()
+        st = st.copy(draw = Bitmap.createBitmap(st.base.width, st.base.height, Bitmap.Config.ARGB_8888))
+        rev++
+    }
+
+    // ---- text ----
+    private fun extents(t: TextItem): Pair<Float, Float> {
+        mp.reset()
+        mp.typeface = typefaceFor(t.font)
+        mp.textSize = t.sizePx
+        val w = mp.measureText(t.text)
+        return Pair(w / 2f + t.sizePx * 0.25f, t.sizePx * 0.7f)
+    }
+
+    fun hitText(pos: Offset): Int {
+        val b = toBmp(pos)
+        val slack = 14f / scale()
+        for (t in st.texts.asReversed()) {
+            val dx = b.x - t.x
+            val dy = b.y - t.y
+            val r = Math.toRadians(t.rot.toDouble())
+            val c = cos(r).toFloat()
+            val s = sin(r).toFloat()
+            val lx = dx * c + dy * s
+            val ly = -dx * s + dy * c
+            val (hw, hh) = extents(t)
+            if (abs(lx) <= hw + slack && abs(ly) <= hh + slack) return t.id
+        }
+        return -1
+    }
+
+    fun selectText(id: Int) {
+        sel = id
+        val t = st.texts.firstOrNull { it.id == id }
+        if (t != null) tmpl = t.copy(id = -1)
+    }
+
+    fun addText(text: String) {
+        push()
+        val id = nextId++
+        val c = toBmp(Offset(boxW / 2f, boxH / 2f))
+        val x = c.x.coerceIn(0f, st.base.width.toFloat())
+        val y = c.y.coerceIn(0f, st.base.height.toFloat())
+        val t = tmpl.copy(id = id, text = text.ifBlank { "Text" }, x = x, y = y, rot = 0f)
+        st = st.copy(texts = st.texts + t)
+        sel = id
+        rev++
+    }
+
+    fun styleSel(f: (TextItem) -> TextItem) {
+        tmpl = f(tmpl).copy(id = -1)
+        val id = sel
+        if (id >= 0 && st.texts.any { it.id == id }) {
+            push("t$id")
+            st = st.copy(texts = st.texts.map { if (it.id == id) f(it) else it })
+            rev++
+        }
+    }
+
+    fun moveText(d: Offset) {
+        val id = sel
+        val s = scale()
+        st = st.copy(texts = st.texts.map { if (it.id == id) it.copy(x = it.x + d.x / s, y = it.y + d.y / s) else it })
+        rev++
+    }
+
+    fun deleteSel() {
+        val id = sel
+        if (id < 0) return
+        push()
+        st = st.copy(texts = st.texts.filter { it.id != id })
+        sel = -1
+        rev++
+    }
+
+    fun clearTexts() {
+        push()
+        st = st.copy(texts = emptyList())
+        sel = -1
+        rev++
+    }
+
+    // ---- crop ----
+    fun resetCrop() {
+        crop = RectF(0f, 0f, st.base.width.toFloat(), st.base.height.toFloat())
+        cropAr = null
+    }
+
+    fun setAspect(ar: Float?, original: Boolean) {
+        val w = st.base.width.toFloat()
+        val h = st.base.height.toFloat()
+        if (original) { cropAr = w / h; crop = RectF(0f, 0f, w, h); return }
+        cropAr = ar
+        if (ar == null) return
+        val nw = min(w, h * ar)
+        val nh = nw / ar
+        val cx = ((crop.left + crop.right) / 2f).coerceIn(nw / 2f, w - nw / 2f)
+        val cy = ((crop.top + crop.bottom) / 2f).coerceIn(nh / 2f, h - nh / 2f)
+        crop = RectF(cx - nw / 2f, cy - nh / 2f, cx + nw / 2f, cy + nh / 2f)
+    }
+
+    /** 1 TL, 2 TR, 3 BL, 4 BR, 5 L, 6 R, 7 T, 8 B, 9 inside, 0 outside */
+    fun cropHit(pos: Offset, th: Float): Int {
+        val s = scale()
+        val l = ox() + crop.left * s
+        val r = ox() + crop.right * s
+        val t = oy() + crop.top * s
+        val b = oy() + crop.bottom * s
+        fun near(a: Float, c: Float) = abs(a - c) < th
+        val nl = near(pos.x, l); val nr = near(pos.x, r); val nt = near(pos.y, t); val nb = near(pos.y, b)
+        if (nl && nt) return 1
+        if (nr && nt) return 2
+        if (nl && nb) return 3
+        if (nr && nb) return 4
+        if (cropAr == null) {
+            val inX = pos.x in l..r
+            val inY = pos.y in t..b
+            if (nl && inY) return 5
+            if (nr && inY) return 6
+            if (nt && inX) return 7
+            if (nb && inX) return 8
+        }
+        if (pos.x in l..r && pos.y in t..b) return 9
+        return 0
+    }
+
+    fun cropDrag(hit: Int, pos: Offset, d: Offset) {
+        val w = st.base.width.toFloat()
+        val h = st.base.height.toFloat()
+        val s = scale()
+        val r = crop
+        val minS = 16f
+        if (hit == 9) {
+            val dx = d.x / s
+            val dy = d.y / s
+            val nl = (r.left + dx).coerceIn(0f, w - r.width())
+            val nt = (r.top + dy).coerceIn(0f, h - r.height())
+            crop = RectF(nl, nt, nl + r.width(), nt + r.height())
+            return
+        }
+        val p = toBmp(pos)
+        val tx = p.x.coerceIn(0f, w)
+        val ty = p.y.coerceIn(0f, h)
+        when (hit) {
+            1, 2, 3, 4 -> {
+                val ax = if (hit == 1 || hit == 3) r.right else r.left
+                val ay = if (hit == 1 || hit == 2) r.bottom else r.top
+                var nw = abs(tx - ax)
+                var nh = abs(ty - ay)
+                val ar = cropAr
+                if (ar != null) {
+                    if (nw / max(nh, 1f) > ar) nw = nh * ar else nh = nw / ar
+                }
+                val availW = if (tx >= ax) w - ax else ax
+                val availH = if (ty >= ay) h - ay else ay
+                if (nw > availW) { nw = availW; if (ar != null) nh = nw / ar }
+                if (nh > availH) { nh = availH; if (ar != null) nw = nh * ar }
+                nw = max(nw, minS)
+                nh = max(nh, minS)
+                val nl = if (tx >= ax) ax else ax - nw
+                val nt = if (ty >= ay) ay else ay - nh
+                crop = RectF(nl, nt, nl + nw, nt + nh)
+            }
+            5 -> crop = RectF(tx.coerceIn(0f, r.right - minS), r.top, r.right, r.bottom)
+            6 -> crop = RectF(r.left, r.top, tx.coerceIn(r.left + minS, w), r.bottom)
+            7 -> crop = RectF(r.left, ty.coerceIn(0f, r.bottom - minS), r.right, r.bottom)
+            8 -> crop = RectF(r.left, r.top, r.right, ty.coerceIn(r.top + minS, h))
+        }
+    }
+
+    fun applyCrop() {
+        val r = crop
+        val x0 = r.left.toInt().coerceIn(0, st.base.width - 1)
+        val y0 = r.top.toInt().coerceIn(0, st.base.height - 1)
+        val x1 = r.right.toInt().coerceIn(x0 + 1, st.base.width)
+        val y1 = r.bottom.toInt().coerceIn(y0 + 1, st.base.height)
+        if (x1 - x0 < 8 || y1 - y0 < 8) return
+        if (x0 == 0 && y0 == 0 && x1 == st.base.width && y1 == st.base.height) return
+        push()
+        val nb = Bitmap.createBitmap(st.base, x0, y0, x1 - x0, y1 - y0)
+        val nd = Bitmap.createBitmap(st.draw, x0, y0, x1 - x0, y1 - y0)
+        val nt = st.texts.map { it.copy(x = it.x - x0, y = it.y - y0) }
+        st = EdState(nb, nd, nt)
+        resetView()
+        resetCrop()
+        rev++
+    }
+
+    // ---- rotate ----
+    fun applyRotate() {
+        val a = ang
+        if (abs(a) < 0.01f) return
+        val bw = st.base.width.toFloat()
+        val bh = st.base.height.toFloat()
+        val rad = Math.toRadians(a.toDouble())
+        val c = abs(cos(rad)).toFloat()
+        val s = abs(sin(rad)).toFloat()
+        val nw = ceil(bw * c + bh * s).toInt().coerceAtLeast(8)
+        val nh = ceil(bw * s + bh * c).toInt().coerceAtLeast(8)
+        val m = Matrix().apply {
+            postTranslate(-bw / 2f, -bh / 2f)
+            postRotate(a)
+            postTranslate(nw / 2f, nh / 2f)
+        }
+        val pt = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+        fun xf(src: Bitmap): Bitmap {
+            val o = Bitmap.createBitmap(nw, nh, Bitmap.Config.ARGB_8888)
+            AndroidCanvas(o).drawBitmap(src, m, pt)
+            return o
+        }
+        val texts = st.texts.map {
+            val pts = floatArrayOf(it.x, it.y)
+            m.mapPoints(pts)
+            it.copy(x = pts[0], y = pts[1], rot = it.rot + a)
+        }
+        push()
+        st = EdState(xf(st.base), xf(st.draw), texts)
+        ang = 0f
+        resetView()
+        resetCrop()
+        rev++
+    }
+
+    fun flatten(): Bitmap {
+        val out = st.base.copy(Bitmap.Config.ARGB_8888, true)
+        val c = AndroidCanvas(out)
+        c.drawBitmap(st.draw, 0f, 0f, null)
+        val p = Paint(Paint.ANTI_ALIAS_FLAG)
+        st.texts.forEach { drawTextItem(c, it, p) }
+        return out
+    }
+}
