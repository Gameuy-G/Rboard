+    /** Draws one style. Shared by the live view and the style previews. */
+    /** Adds the beat punch (jump, grow, brighter) around any style. */
+    private fun renderStyle(
+        canvas: Canvas, p: android.content.SharedPreferences, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float, force: Boolean
+    ) {
+        if (!previewMode && RasiShake.toViz && RasiShake.amp > 0f) {
+            canvas.save()
+            RasiShake.apply(canvas, w, h)
+            renderPunchStyle(canvas, p, style, col, w, h, alpha, sens, dens, force)
+            canvas.restore()
+        } else renderPunchStyle(canvas, p, style, col, w, h, alpha, sens, dens, force)
+    }
+
+    private fun renderPunchStyle(
+        canvas: Canvas, p: android.content.SharedPreferences, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float, force: Boolean
+    ) {
+        val pu = punch
+        val str = p.getInt("viz_punch", 60) / 100f
+        if (pu < 0.01f || str <= 0f || !p.getBoolean("viz_punch_on", true) ||
+            org.futo.inputmethod.latin.uix.RasiPerf.isOn()) {
+            renderStyleCore(canvas, p, style, col, w, h, alpha, sens, dens, force)
+            return
+        }
+        val k = pu * str
+        val anch = anchored(style)
+        canvas.save()
+        canvas.scale(1f + (if (anch) 0.04f else 0.14f) * k, 1f + 0.14f * k, w / 2f, if (anch) h else h / 2f)
+        renderStyleCore(canvas, p, style, col, w, h, (alpha * (1f + 0.45f * k)).toInt().coerceIn(0, 255), sens * (1f + 0.7f * k), dens, force)
+        canvas.restore()
+    }
+
+    private fun renderStyleCore(
+        canvas: Canvas, p: android.content.SharedPreferences, style: String, col: Colors,
+        w: Float, h: Float, alpha: Int, sens: Float, dens: Float, force: Boolean
+    ) {
+        paint.shader = null
+        paint.style = Paint.Style.FILL
+
+        if (style == "pulse") {
+            val r = (minOf(w, h) * (0.35f + 0.65f * (bass * sens).coerceIn(0f, 1f)) * 1.2f).coerceAtLeast(10f)
+            val c = col.at(0f)
+            paint.shader = RadialGradient(
+                w / 2f, h / 2f, r,
+                intArrayOf(AColor.argb(alpha, AColor.red(c), AColor.green(c), AColor.blue(c)),
+                    AColor.argb(0, AColor.red(c), AColor.green(c), AColor.blue(c))),
+                null, Shader.TileMode.CLAMP
+            )
+            canvas.drawCircle(w / 2f, h / 2f, r, paint)
+            paint.shader = null
+            return
+        }
+
+        if (drawMore(canvas, style, col, w, h, alpha, sens, dens)) return
+        if (drawExtra(canvas, p, style, col, w, h, alpha, sens, dens)) return
+        if (drawNew(canvas, p, style, col, w, h, alpha, sens, dens)) return
+        if (isCircular(style)) {
+            drawCircular(canvas, p, style, col, w, h, alpha, sens, dens)
+            return
+        }
+        val count = p.getInt("viz_count", -1).let { if (it < 4) defaultCount(style) else it }
+        val fill = p.getInt("viz_barw", if (style == "chunky") 80 else 70) / 100f
+        val mirror = p.getBoolean("viz_mirror", style == "peakspec")
+        val maxH = h * p.getInt("viz_height", 75) / 100f
+        var pos = p.getString("viz_pos", "auto") ?: "auto"
+        if (pos == "auto") pos = if (style == "line") "center" else "bottom"
+        val slot = w / count
+        val bw = (slot * fill).coerceAtLeast(1f)
+        val dens = dens
+        // bars continue into the strip under the keyboard (behind the navigation bar)
+        val toBottom = curExt > 0f && pos == "bottom"
+        val cy = when (pos) { "top" -> maxH / 2f; "center" -> h / 2f; else -> h - maxH / 2f }
+        paint.alpha = alpha
+
+        for (j in 0 until count) {
+            val t = if (count > 1) j / (count - 1f) else 0f
+            val sp = (if (mirror) Math.abs(2f * t - 1f) else t) * (N - 1)
+            val lv = (at(disp, sp) * sens).coerceIn(0f, 1f)
+            val x = j * slot + (slot - bw) / 2f
+            paint.color = col.at(t)
+            paint.alpha = alpha
+            if (style == "line") {
+                val dot = 1.3f * dens
+                canvas.drawCircle(x + bw / 2f, cy, dot, paint)
+                val bh = maxH * lv
+                if (bh > dot * 2f) {
+                    val tw = minOf(bw, 3f * dens)
+                    val xx = x + (bw - tw) / 2f
+                    canvas.drawRoundRect(RectF(xx, cy - bh / 2f, xx + tw, cy + bh / 2f), tw / 2f, tw / 2f, paint)
+                }
+                continue
+            }
+            val bh = (maxH * lv).coerceAtLeast(2f * dens)
+            val rad = if (style == "chunky") bw / 4f else minOf(bw / 2f, 2f * dens)
+            val top: Float
+            val bottom: Float
+            when (pos) {
+                "top" -> { top = 0f; bottom = bh }
+                "center" -> { top = h / 2f - bh / 2f; bottom = h / 2f + bh / 2f }
+                else -> { top = h - bh; bottom = if (toBottom) h + rad else h }
+            }
+            canvas.drawRoundRect(RectF(x, top, x + bw, bottom), rad, rad, paint)
+            if (style == "spectrum" || style == "peakspec") {
+                val pk = (at(peaks, sp) * sens).coerceIn(0f, 1f) * maxH
+                if (pk > bh + 2f * dens) {
+                    val capH = 2f * dens
+                    when (pos) {
+                        "top" -> canvas.drawRect(x, pk, x + bw, pk + capH, paint)
+                        "center" -> {
+                            canvas.drawRect(x, h / 2f - pk / 2f - capH, x + bw, h / 2f - pk / 2f, paint)
+                            canvas.drawRect(x, h / 2f + pk / 2f, x + bw, h / 2f + pk / 2f + capH, paint)
+                        }
+                        else -> canvas.drawRect(x, h - pk - capH, x + bw, h - pk, paint)
+                    }
+                }
+            }
+        }
+    }
+
+    private object DefPrefs : android.content.SharedPreferences {
+        override fun getAll(): MutableMap<String, *> = HashMap<String, Any>()
+        override fun getString(k: String?, d: String?) = d
+        override fun getStringSet(k: String?, d: MutableSet<String>?) = d
+        override fun getInt(k: String?, d: Int) = d
+        override fun getLong(k: String?, d: Long) = d
+        override fun getFloat(k: String?, d: Float) = d
+        override fun getBoolean(k: String?, d: Boolean) = d
+        override fun contains(k: String?) = false
+        override fun edit(): android.content.SharedPreferences.Editor = throw UnsupportedOperationException()
+        override fun registerOnSharedPreferenceChangeListener(l: android.content.SharedPreferences.OnSharedPreferenceChangeListener?) {}
+        override fun unregisterOnSharedPreferenceChangeListener(l: android.content.SharedPreferences.OnSharedPreferenceChangeListener?) {}
+    }
+    private val previewSparks = ArrayList<Spark>()
+
+    /** Draws [style] with fake music so it can be previewed without a song playing. Main thread only. */
+    fun drawPreview(canvas: Canvas, style: String, col: Colors, w: Float, h: Float, dens: Float, timeMs: Long) {
+        val dBak = disp.copyOf(); val pBak = peaks.copyOf(); val bBak = bass; val puBak = punch
+        punch = 0f
+        previewMode = true
+        previewBeat = (1f - ((timeMs % 900L) / 900f) * 2.2f).coerceAtLeast(0f)
+        previewSeed = (timeMs / 900L).toInt()
+        val sBak = sparks; val lBak = sparkLast; val rBak = ripples; val rlBak = rippleLast
+        col.beat?.let {
+            val strongBeat = previewSeed % 2 == 0
+            val env = previewBeat * (if (strongBeat) 1f else 0.4f)
+            it.mix = mixOf(env, it.thr, it.curve)
+            it.flash = if (strongBeat) previewBeat * 0.6f else 0f
+        }
+        try {
+            val t = timeMs / 1000f
+            for (i in 0 until N) {
+                val f = i / N.toFloat()
+                if (style == "spectrum" || style == "line") {
+                    // what the real keyboard shows: strong bass on the left, decaying to the right
+                    val dec = Math.pow((1f - f).toDouble(), 2.2).toFloat()
+                    val v = 0.05f + 0.9f * dec * (0.72f + 0.28f * sin(t * 3.1f + i * 0.45f)) * (0.85f + 0.15f * sin(t * 1.3f))
+                    disp[i] = v.coerceIn(0f, 1f)
+                    peaks[i] = (v + 0.07f + 0.05f * Math.abs(sin(t * 2f + i * 0.7f))).coerceIn(0f, 1f)
+                } else {
+                    val v = (0.25f + 0.75f * Math.abs(sin(t * 3f + i * 0.35f))) * (1f - f * 0.55f) * (0.55f + 0.45f * sin(t * 1.7f + i * 0.12f))
+                    disp[i] = v.coerceIn(0f, 1f); peaks[i] = (v * 1.15f).coerceIn(0f, 1f)
+                }
+            }
+            bass = (0.5f + 0.5f * sin(t * 5f)).coerceIn(0f, 1f)
+            sparks = previewSparks
+            ripples = previewRipples
+            canvas.save()
+            canvas.clipRect(0f, 0f, w, h)
+            renderStyle(canvas, DefPrefs, style, col, w, h, 200, 1.1f, dens, true)
+            canvas.restore()
+        } catch (e: Throwable) {
+            RasiLog.w("RasiViz", "preview failed: " + e)
+        } finally {
+            System.arraycopy(dBak, 0, disp, 0, N); System.arraycopy(pBak, 0, peaks, 0, N)
+            previewMode = false
+            bass = bBak; punch = puBak; sparks = sBak; sparkLast = lBak; ripples = rBak; rippleLast = rlBak
+        }
+    }
+
+    private fun drawLayerInner(view: View, canvas: Canvas, over: Boolean, force: Boolean, p: android.content.SharedPreferences) {
+        try {
+            if (!force) migrate(view.context)
+            val vizOn = if (force) p.getBoolean("set_viz", true) else p.getBoolean("mode_viz", false)
+            if (!vizOn) return
+            if (!over) {
+                register(view)
+                if (RasiNowPlaying.track?.playing != true) return
+                if (!running) kick()
+            } else if (RasiNowPlaying.track?.playing != true) return
+            val layer = p.getString("viz_layer", "behind") ?: "behind"
+            if (!force && over && layer == "behind") return
+            if (!force && !over && layer == "over") return
+
+            val w = view.width.toFloat()
+            val h = view.height.toFloat()
+            if (w <= 0f || h <= 0f) return
+            val sens = p.getInt("viz_sens", 70) / 100f * 1.6f
+            val alpha = (255 * p.getInt("viz_opacity", 55) / 100f).toInt().coerceIn(0, 255)
+            val style = styleOf(p)
+            val col = colors(p, "viz_")
+            val ext = if (!force && p.getBoolean("viz_to_bottom", true) && anchored(style)) navExt else 0f
+            if (!force) {
+                kbH = h
+                kbW = w
+                view.getLocationOnScreen(locTmp)
+                kbLeft = locTmp[0].toFloat()
+                System.arraycopy(disp, 0, snapDisp, 0, N)
+                System.arraycopy(peaks, 0, snapPeaks, 0, N)
+                snapBass = bass
+                snapPunch = punch
+                snapOk = true
+            }
+            curExt = ext
+            if (force) {
+                // settings background: draw into a band (not the whole tall screen) so nothing sits cut off in the middle
+                val aPos = p.getString("viz_area_pos", "bottom") ?: "bottom"
+                val bandH = if (aPos == "full") h else h * p.getInt("viz_area_h", 45).coerceIn(15, 100) / 100f
+                val top = when (aPos) { "top" -> 0f; "center" -> (h - bandH) / 2f; "full" -> 0f; else -> h - bandH }
+                val sv = canvas.save()
+                try {
+                    canvas.translate(0f, top)
+                    renderStyle(canvas, p, style, col, w, bandH, alpha, sens, view.resources.displayMetrics.density, force)
+                } finally {
+                    canvas.restoreToCount(sv)
+                }
+            } else {
+                renderStyle(canvas, p, style, col, w, h + ext, alpha, sens, view.resources.displayMetrics.density, force)
+            }
+            curExt = 0f
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "draw failed: " + t)
+        }
+    }
+}
