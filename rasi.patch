+/** Vibration intensity (how hard the motor pushes). Lives in Keyboard > Sound and vibration. */
+@Composable
+fun RasiVibrationIntensitySetting() {
+    val context = LocalContext.current
+    val prefs = remember { RasiSounds.prefs(context) }
+    var strength by remember { mutableFloatStateOf(prefs.getInt("vibration_strength", 0).toFloat()) }
+    Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp)) {
+        Text(
+            if (strength.toInt() <= 0) "Vibration intensity: phone default"
+            else "Vibration intensity: " + (strength / 255f * 100f).toInt() + "%"
+        )
+        Text("How hard the motor pushes on each key press. Left end = the phone default. Only works on phones that support it. The Vibration strength slider above sets how long it buzzes")
+        Slider(
+            value = strength,
+            onValueChange = {
+                strength = it
+                prefs.edit().putInt("vibration_strength", it.toInt()).apply()
+            },
+            onValueChangeFinished = {
+                try {
+                    org.futo.inputmethod.latin.AudioAndHapticFeedbackManager.getInstance().vibrate(30)
+                } catch (e: Exception) {
+                }
+            },
+            valueRange = 0f..255f
+        )
+    }
+}
+
+/** Keep key vibration working in battery saver. Lives in Keyboard > Sound and vibration. */
+@Composable
+fun RasiVibrationSaverSetting() {
+    val context = LocalContext.current
+    val prefs = remember { RasiSounds.prefs(context) }
+    var on by remember { mutableStateOf(prefs.getBoolean("vibrate_battery_saver", false)) }
+    SettingToggleRaw(
+        title = "Keep key vibration working in battery saver",
+        subtitle = "On: key presses still vibrate when the phone is in battery saver. Off: the system may turn key vibration off to save power",
+        enabled = on,
+        setValue = {
+            on = it
+            prefs.edit().putBoolean("vibrate_battery_saver", it).apply()
+        }
+    )
+}
