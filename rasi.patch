+/** Reads the text field now (selection, any text, clipboard). Unknown counts as available. */
+private fun readEditState(manager: KeyboardManagerForAction): TextEditState {
+    var hasText = true
+    var hasSel = false
+    try {
+        val ic = manager.getLatinIMEForDebug().currentInputConnection
+        if (ic != null) {
+            val before = ic.getTextBeforeCursor(1, 0)
+            val after = ic.getTextAfterCursor(1, 0)
+            val selected = ic.getSelectedText(0)
+            hasSel = !selected.isNullOrEmpty()
+            hasText = before == null || after == null || before.isNotEmpty() || after.isNotEmpty() || hasSel
+        }
+    } catch (e: Throwable) { }
+    val hasClip = try {
+        (manager.getContext().getSystemService(android.content.Context.CLIPBOARD_SERVICE) as? android.content.ClipboardManager)
+            ?.hasPrimaryClip() ?: true
+    } catch (e: Throwable) { true }
+    return TextEditState(hasText, hasSel, hasClip)
+}
