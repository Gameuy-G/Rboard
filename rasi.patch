--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/actions/RasiPickerActivity.kt
@@ -0,0 +1,169 @@
+package org.futo.inputmethod.latin.uix.actions
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+
+/**
+ * Invisible helper screen: opens the phone's file picker, copies the chosen images/GIFs into the
+ * keyboard's own storage, then closes.
+ */
+class RasiPickerActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val pick = Intent(Intent.ACTION_OPEN_DOCUMENT)
+        pick.addCategory(Intent.CATEGORY_OPENABLE)
+        pick.type = "*/*"
+        if (intent.getStringExtra("kind") == "dictionary") {
+            // Gboard export is a .zip (dictionary.txt inside) or a plain .txt
+            pick.putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("application/zip", "text/plain", "application/octet-stream"))
+        } else if (intent.getStringExtra("kind") == "geminibg") {
+            pick.putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("image/*"))
+        } else if (intent.getStringExtra("kind") == "gemini") {
+            pick.putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("image/*", "video/*"))
+            pick.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true)
+        } else {
+            pick.putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("image/*", "video/*"))
+            pick.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true)
+        }
+        startActivityForResult(pick, 1)
+    }
+
+    @Deprecated("Deprecated in Java")
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResult(requestCode, resultCode, data)
+        if (resultCode == RESULT_OK && data != null) {
+            val kind = intent.getStringExtra("kind") ?: "stickers"
+            if (kind == "geminibg") {
+                val u = data.data
+                if (u != null) {
+                    RasiGeminiImages.importUri(this, u)?.let { n ->
+                        try {
+                            val src = RasiGeminiImages.file(this, n)
+                            src.copyTo(org.futo.inputmethod.latin.uix.settings.RasiGeminiThemePrefs.bgFile(this), overwrite = true)
+                            src.delete()
+                            org.futo.inputmethod.latin.uix.settings.RasiGeminiThemePrefs.prefs(this).edit().putBoolean("bg_on", true).apply()
+                        } catch (e: Exception) { e.printStackTrace() }
+                    }
+                }
+                finish()
+                return
+            }
+            if (kind == "gemini") {
+                val gu = ArrayList<Uri>()
+                data.data?.let { gu.add(it) }
+                val gc = data.clipData
+                if (gc != null) for (i in 0 until gc.itemCount) gu.add(gc.getItemAt(i).uri)
+                var failed = 0
+                for (u in gu) {
+                    if (RasiGeminiImages.pending.size >= 4) break
+                    val n = RasiGeminiImages.importAny(this, u)
+                    if (n != null) RasiGeminiImages.pending.add(n) else failed++
+                }
+                if (failed > 0) {
+                    android.widget.Toast.makeText(
+                        this,
+                        "Could not attach " + failed + " item(s). A video may be over 150 MB or in an unsupported format.",
+                        android.widget.Toast.LENGTH_LONG
+                    ).show()
+                }
+                finish()
+                return
+            }
+            if (kind == "send") {
+                val su = ArrayList<Uri>()
+                data.data?.let { su.add(it) }
+                val sc = data.clipData
+                if (sc != null) for (i in 0 until sc.itemCount) su.add(sc.getItemAt(i).uri)
+                val dir = java.io.File(cacheDir, "rasi_send").also { it.mkdirs() }
+                val cutoff = System.currentTimeMillis() - 3L * 60L * 60L * 1000L
+                dir.listFiles()?.forEach { if (it.lastModified() < cutoff) it.delete() }
+                val files = ArrayList<java.io.File>()
+                for (u in su) {
+                    try {
+                        val type = contentResolver.getType(u) ?: ""
+                        val ext = android.webkit.MimeTypeMap.getSingleton().getExtensionFromMimeType(type)
+                            ?: (if (type.startsWith("video/")) "mp4" else "jpg")
+                        val f = java.io.File(dir, "s" + System.nanoTime() + "." + ext)
+                        contentResolver.openInputStream(u)?.use { i -> f.outputStream().use { o -> i.copyTo(o) } }
+                        if (f.length() > 0) files.add(f)
+                    } catch (e: Exception) { e.printStackTrace() }
+                }
+                RasiFileSend.deliver(applicationContext, files)
+                finish()
+                return
+            }
+            if (kind == "dictionary") {
+                val uri = data.data
+                var msg = "Could not read that file"
+                if (uri != null) {
+                    try {
+                        contentResolver.openInputStream(uri)?.use {
+                            org.futo.inputmethod.latin.rasi.RasiWordMemory.init(this)
+                            val n = org.futo.inputmethod.latin.rasi.RasiWordMemory.importGboard(it)
+                            msg = "Imported $n entries"
+                        }
+                    } catch (e: Exception) { e.printStackTrace() }
+                }
+                android.widget.Toast.makeText(this, msg, android.widget.Toast.LENGTH_LONG).show()
+                finish()
+                return
+            }
+            val uris = ArrayList<Uri>()
+            data.data?.let { uris.add(it) }
+            val clip = data.clipData
+            if (clip != null) {
+                for (i in 0 until clip.itemCount) {
+                    uris.add(clip.getItemAt(i).uri)
+                }
+            }
+            for (u in uris) {
+                RasiMedia.importFile(this, kind, u, intent.getStringExtra("section"))
+            }
+        }
+        finish()
+    }
+}
+
+/** Remembers the keyboard that asked for a file and sends the picked files once the app has focus again. */
+object RasiFileSend {
+    @Volatile var manager: org.futo.inputmethod.latin.uix.KeyboardManagerForAction? = null
+
+    /** Copies gallery items to the cache in the background, then sends them into the text field one by one. */
+    fun deliverUris(ctx: android.content.Context, m: org.futo.inputmethod.latin.uix.KeyboardManagerForAction, uris: List<Uri>) {
+        val app = ctx.applicationContext
+        Thread {
+            val dir = java.io.File(app.cacheDir, "rasi_send").also { it.mkdirs() }
+            val cutoff = System.currentTimeMillis() - 3L * 60L * 60L * 1000L
+            dir.listFiles()?.forEach { if (it.lastModified() < cutoff) it.delete() }
+            val files = ArrayList<java.io.File>()
+            for (u in uris) {
+                try {
+                    val type = app.contentResolver.getType(u) ?: ""
+                    val ext = android.webkit.MimeTypeMap.getSingleton().getExtensionFromMimeType(type)
+                        ?: (if (type.startsWith("video/")) "mp4" else "jpg")
+                    val f = java.io.File(dir, "s" + System.nanoTime() + "." + ext)
+                    app.contentResolver.openInputStream(u)?.use { i -> f.outputStream().use { o -> i.copyTo(o) } }
+                    if (f.length() > 0) files.add(f)
+                } catch (e: Exception) { e.printStackTrace() }
+            }
+            val h = android.os.Handler(android.os.Looper.getMainLooper())
+            files.forEachIndexed { i, f ->
+                h.postDelayed({
+                    try { RasiMedia.sendFile(app, m, f) } catch (t: Throwable) { t.printStackTrace() }
+                }, 200L + i * 700L)
+            }
+        }.start()
+    }
+
+    fun deliver(ctx: android.content.Context, files: List<java.io.File>) {
+        val m = manager ?: return
+        val h = android.os.Handler(android.os.Looper.getMainLooper())
+        files.forEachIndexed { i, f ->
+            h.postDelayed({
+                try { RasiMedia.sendFile(ctx, m, f) } catch (t: Throwable) { t.printStackTrace() }
+            }, 700L + i * 700L)
+        }
+    }
+}
