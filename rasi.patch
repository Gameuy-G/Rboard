index 000000000..b3ec03e92
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiDictDownloader.kt
@@ -0,0 +1,121 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import androidx.compose.runtime.mutableStateOf
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.futo.inputmethod.engine.GlobalIMEMessage
+import org.futo.inputmethod.engine.IMEMessage
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.Locale
+
+/**
+ * Downloads a suggestion dictionary (.dict, AOSP format) for a language from the public AOSP
+ * dictionaries repository and installs it exactly like a manually imported dictionary.
+ */
+object RasiDictDownloader {
+    private const val BASE = "https://codeberg.org/Helium314/aosp-dictionaries/raw/branch/main/"
+    private val FOLDERS = listOf("dictionaries/", "dictionaries_experimental/")
+    private const val MAX_BYTES = 80L * 1024L * 1024L
+    private const val PREFS = "rasi_dict_download"
+
+    /** Locale strings that are downloading right now. */
+    val downloading = mutableStateOf<Set<String>>(emptySet())
+
+    private fun aliases(lang: String): List<String> = when (lang) {
+        "iw", "he" -> listOf("iw", "he")
+        "in", "id" -> listOf("id", "in")
+        "ji", "yi" -> listOf("yi", "ji")
+        else -> listOf(lang)
+    }
+
+    private fun candidateNames(locale: Locale): List<String> {
+        val out = ArrayList<String>()
+        if (locale.country.isNotEmpty()) {
+            aliases(locale.language).forEach { out.add("main_${it}_${locale.country}.dict") }
+        }
+        aliases(locale.language).forEach { out.add("main_$it.dict") }
+        return out.distinct()
+    }
+
+    private fun fetch(url: String, out: File): Boolean {
+        var conn: HttpURLConnection? = null
+        return try {
+            conn = (URL(url).openConnection() as HttpURLConnection).apply {
+                connectTimeout = 15000
+                readTimeout = 30000
+                instanceFollowRedirects = true
+                setRequestProperty("User-Agent", "RasiKeyboard")
+            }
+            if (conn.responseCode != 200) return false
+            if (conn.contentLengthLong > MAX_BYTES) return false
+            var total = 0L
+            conn.inputStream.use { input ->
+                out.outputStream().use { output ->
+                    val buf = ByteArray(16 * 1024)
+                    while (true) {
+                        val n = input.read(buf)
+                        if (n < 0) break
+                        total += n
+                        if (total > MAX_BYTES) return false
+                        output.write(buf, 0, n)
+                    }
+                }
+            }
+            total > 0
+        } catch (e: Exception) {
+            false
+        } finally {
+            conn?.disconnect()
+        }
+    }
+
+    fun wasTried(context: Context, locale: Locale): Boolean =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getBoolean(locale.toString(), false)
+
+    private fun markTried(context: Context, locale: Locale) {
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putBoolean(locale.toString(), true).apply()
+    }
+
+    /** Returns true if a dictionary was downloaded and installed for this language. */
+    suspend fun download(context: Context, locale: Locale): Boolean = withContext(Dispatchers.IO) {
+        val app = context.applicationContext
+        val key = locale.toString()
+        if (key in downloading.value) return@withContext false
+        downloading.value = downloading.value + key
+        markTried(app, locale)
+        val tmp = File(app.cacheDir, "rasi_dict_download.tmp")
+        try {
+            val dir = app.getExternalFilesDir(null) ?: return@withContext false
+            for (folder in FOLDERS) {
+                for (name in candidateNames(locale)) {
+                    if (!fetch(BASE + folder + name, tmp)) continue
+                    val info = tmp.inputStream().use { determineFileKind(it) }
+                    if (info.kind != FileKind.Dictionary) continue
+
+                    val outName = "${FileKind.Dictionary.name.lowercase()}_${key.replace("#", "H")}" +
+                            FileKind.Dictionary.extension()
+                    tmp.copyTo(File(dir, outName), overwrite = true)
+
+                    app.setSetting(FileKind.Dictionary.preferenceKeyFor(key), outName)
+                    app.setSetting(
+                        FileKind.Dictionary.namePreferenceKeyFor(key),
+                        info.name ?: "${locale.displayLanguage} (downloaded)"
+                    )
+                    GlobalIMEMessage.tryEmit(IMEMessage.ReloadResources)
+                    return@withContext true
+                }
+            }
+            false
+        } catch (e: Exception) {
+            false
+        } finally {
+            tmp.delete()
+            downloading.value = downloading.value - key
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiEffects.kt b/java/src/org/futo/inputmethod/latin/uix/RasiEffects.kt
new file mode 100644
index 000000000..a5aa50152
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiEffects.kt
@@ -0,0 +1,264 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.ImageDecoder
+import android.graphics.drawable.Animatable2
+import android.graphics.drawable.AnimatedImageDrawable
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.view.View
+import androidx.annotation.RequiresApi
+import org.futo.inputmethod.keyboard.Key
+import java.io.File
+
+/**
+ * Key press effect: a transparent animated image (GIF, animated WebP/PNG) played over the pressed key.
+ * Size and offset are edited with the visual editor in settings.
+ */
+object RasiEffects {
+    const val PREFS = "rasi_effects"
+    private const val POOL = 4
+    private const val STATIC_MS = 500L
+
+    private class Slot(val drawable: Drawable, val target: String) {
+        var cx = 0f
+        var cy = 0f
+        var start = 0L
+        var running = false
+    }
+
+    private val pools = HashMap<String, ArrayList<Slot>>()
+    private val nextIdx = HashMap<String, Int>()
+    private val failed = HashSet<String>()
+    private val files = HashMap<String, String>()
+    private var filesLoaded = false
+
+    const val DEFAULT = "default"
+    val GROUPS = listOf("group_letters", "group_space", "group_delete", "group_enter")
+
+    /** Pref key suffix: the default target keeps the old unsuffixed keys. */
+    fun k(base: String, target: String) = if (target == DEFAULT) base else "${base}_$target"
+
+    fun keyTarget(code: Int) = "key_$code"
+
+    fun groupFor(code: Int): String? = when {
+        code == org.futo.inputmethod.latin.common.Constants.CODE_SPACE -> "group_space"
+        code == org.futo.inputmethod.latin.common.Constants.CODE_DELETE -> "group_delete"
+        code == org.futo.inputmethod.latin.common.Constants.CODE_ENTER -> "group_enter"
+        code > 0 && Character.isLetter(code) -> "group_letters"
+        else -> null
+    }
+
+    fun prefs(context: Context) = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun dir(context: Context) = File(context.applicationContext.filesDir, "rasi_effects").also { it.mkdirs() }
+
+    fun effectFile(context: Context, target: String = DEFAULT): File? {
+        val name = prefs(context).getString(k("file", target), null) ?: return null
+        val f = File(dir(context), name)
+        return if (f.exists()) f else null
+    }
+
+    fun isEnabled(context: Context) = prefs(context).getBoolean("enabled", false) && effectFile(context) != null
+
+    private fun loadFiles(context: Context) {
+        if (filesLoaded) return
+        filesLoaded = true
+        files.clear()
+        val all = prefs(context).all
+        for ((key, v) in all) {
+            if (v !is String) continue
+            val target = when {
+                key == "file" -> DEFAULT
+                key.startsWith("file_") -> key.removePrefix("file_")
+                else -> continue
+            }
+            if (File(dir(context), v).exists()) files[target] = v
+        }
+    }
+
+    /** Picks the most specific configured target for a key: exact key, then its group, then default. */
+    private fun resolve(context: Context, code: Int): String? {
+        loadFiles(context)
+        val exact = keyTarget(code)
+        if (files.containsKey(exact)) return exact
+        val g = groupFor(code)
+        if (g != null && files.containsKey(g)) return g
+        return if (files.containsKey(DEFAULT)) DEFAULT else null
+    }
+
+    fun reload() {
+        for (list in pools.values) for (s in list) {
+            if (Build.VERSION.SDK_INT >= 28) stopDrawable(s.drawable)
+        }
+        pools.clear()
+        RasiChroma.releaseCache()
+        nextIdx.clear()
+        failed.clear()
+        files.clear()
+        filesLoaded = false
+    }
+
+    @RequiresApi(28)
+    private fun stopDrawable(d: Drawable) {
+        if (d is AnimatedImageDrawable) d.stop()
+        if (d is ChromaDrawable) d.stop()
+    }
+
+    fun importEffect(context: Context, uri: android.net.Uri, target: String = DEFAULT): Boolean {
+        val ctx = context.applicationContext
+        return try {
+            val name = "effect_${target}_${System.currentTimeMillis()}.bin"
+            val out = File(dir(ctx), name)
+            ctx.contentResolver.openInputStream(uri)?.use { input ->
+                out.outputStream().use { input.copyTo(it) }
+            } ?: return false
+            if (out.length() > 8_000_000L) {
+                out.delete()
+                android.widget.Toast.makeText(ctx, "Effect is too large, use a smaller file (under 8 MB)", android.widget.Toast.LENGTH_LONG).show()
+                return false
+            }
+            effectFile(ctx, target)?.deleteRecursively()
+            prefs(ctx).edit().putString(k("file", target), name).apply()
+            reload()
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    fun clear(context: Context, target: String = DEFAULT) {
+        effectFile(context, target)?.deleteRecursively()
+        prefs(context).edit().remove(k("file", target)).apply()
+        reload()
+    }
+
+    fun resetPosition(context: Context, target: String) {
+        prefs(context).edit().remove(k("offx", target)).remove(k("offy", target)).apply()
+    }
+
+    /** Decodes the file of one target. Returns null when unsupported (needs Android 9+) or unreadable. */
+    fun decode(context: Context, target: String = DEFAULT): Drawable? {
+        if (Build.VERSION.SDK_INT < 28) return null
+        val f = effectFile(context, target) ?: return null
+        return decodeFile(f)
+    }
+
+    @RequiresApi(28)
+    private fun decodeFile(f: File): Drawable? = try {
+        if (f.isDirectory) RasiChroma.loadFrames(f) else ImageDecoder.decodeDrawable(ImageDecoder.createSource(f))
+    } catch (e: Exception) {
+        null
+    }
+
+    /** Folder for baked chroma-key frames of a target; commit it with [commitFrames]. */
+    fun newFramesDir(context: Context, target: String): File =
+        File(dir(context.applicationContext), "chroma_${target}_${System.currentTimeMillis()}.frames")
+
+    fun commitFrames(context: Context, target: String, frames: File) {
+        val ctx = context.applicationContext
+        effectFile(ctx, target)?.deleteRecursively()
+        prefs(ctx).edit().putString(k("file", target), frames.name).apply()
+        reload()
+    }
+
+    private fun poolFor(context: Context, target: String): ArrayList<Slot>? {
+        pools[target]?.let { return it }
+        if (failed.contains(target)) return null
+        if (Build.VERSION.SDK_INT < 28) return null
+        val f = effectFile(context, target)
+        if (f == null) {
+            failed.add(target)
+            return null
+        }
+        val list = ArrayList<Slot>()
+        repeat(POOL) {
+            val d = decodeFile(f) ?: return@repeat
+            list.add(Slot(d, target))
+        }
+        if (list.isEmpty()) {
+            failed.add(target)
+            return null
+        }
+        pools[target] = list
+        return list
+    }
+
+    /** Called when a key is pressed on the main keyboard view. */
+    @JvmStatic
+    fun spawn(view: View, key: Key) {
+        if (RasiPerf.isOn()) return
+        val ctx = view.context
+        if (!prefs(ctx).getBoolean("enabled", false)) return
+        val target = resolve(ctx, key.code) ?: return
+        val list = poolFor(ctx, target) ?: return
+        val n = nextIdx[target] ?: 0
+        nextIdx[target] = n + 1
+        val slot = list[n % list.size]
+        slot.cx = key.x + key.width / 2f + view.paddingLeft
+        slot.cy = key.y + key.height / 2f + view.paddingTop
+        slot.start = System.currentTimeMillis()
+        slot.running = true
+        if (Build.VERSION.SDK_INT >= 28) startDrawable(slot)
+        view.postInvalidateOnAnimation()
+    }
+
+    @RequiresApi(28)
+    private fun startDrawable(slot: Slot) {
+        val d = slot.drawable
+        if (d is AnimatedImageDrawable) {
+            d.stop()
+            d.repeatCount = 0
+            d.clearAnimationCallbacks()
+            d.registerAnimationCallback(object : Animatable2.AnimationCallback() {
+                override fun onAnimationEnd(drawable: Drawable?) {
+                    slot.running = false
+                }
+            })
+            d.start()
+        } else if (d is ChromaDrawable) {
+            d.loop = false
+            d.onEnd = { slot.running = false }
+            d.start()
+        }
+    }
+
+    /** Draws active effects on top of the keyboard. */
+    @JvmStatic
+    fun draw(view: View, canvas: Canvas) {
+        if (pools.isEmpty()) return
+        val p = prefs(view.context)
+        val density = view.resources.displayMetrics.density
+        val now = System.currentTimeMillis()
+        var any = false
+
+        for (list in pools.values) for (s in list) {
+            if (!s.running) continue
+            val size = (p.getFloat(k("size", s.target), 72f) * density).toInt().coerceAtLeast(8)
+            val offX = p.getFloat(k("offx", s.target), 0f) * density
+            val offY = p.getFloat(k("offy", s.target), 0f) * density
+            val animated = Build.VERSION.SDK_INT >= 28 && isAnimated(s.drawable)
+            var scale = 1f
+            if (!animated) {
+                val t = (now - s.start).toFloat() / STATIC_MS
+                if (t >= 1f) {
+                    s.running = false
+                    continue
+                }
+                s.drawable.alpha = (255 * (1f - t)).toInt()
+                scale = 0.8f + 0.4f * t
+            }
+            val half = (size * scale / 2f).toInt()
+            val cx = (s.cx + offX).toInt()
+            val cy = (s.cy + offY).toInt()
+            s.drawable.setBounds(cx - half, cy - half, cx + half, cy + half)
+            s.drawable.draw(canvas)
+            any = true
+        }
+        if (any) view.postInvalidateOnAnimation()
+    }
+
+    @RequiresApi(28)
+    private fun isAnimated(d: Drawable) = d is AnimatedImageDrawable || d is ChromaDrawable
+}
