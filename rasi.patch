+    /** Starts the animation loop (used by the effects behind the settings screens). */
+    fun wake() { kick() }
+
+    fun settingsFxWanted(ctx: android.content.Context): Boolean =
+        RasiNowPlaying.prefs(ctx).getBoolean("sfx_on", false) && !org.futo.inputmethod.latin.uix.RasiPerf.isOn()
+
+    private var sFxClock = 0.0
+    private var sFxLast = 0L
+
+    /** The visual effect behind (or over) the settings screens: its own style, colors, speed, size and layer. */
+    fun drawSettingsFx(view: View, canvas: Canvas, w: Float, h: Float) {
+        try {
+            val ctx = view.context
+            if (!settingsFxWanted(ctx) || w <= 0f || h <= 0f) return
+            val base = RasiFxPrefs.settingsOf(RasiNowPlaying.prefs(ctx))
+            register(view)
+            val speed = base.getInt("fx_speed", 100) / 100f
+            val nowMs = System.currentTimeMillis()
+            if (sFxLast != 0L && nowMs != sFxLast) sFxClock += (nowMs - sFxLast).coerceIn(0L, 200L) * speed
+            sFxLast = nowMs
+            val ang = base.getInt("fx_rot", 0) + base.getInt("fx_spin", 0) * (sFxClock / 1000.0)
+            val dens = view.resources.displayMetrics.density * base.getInt("fx_size", 100) / 100f
+            val alpha = (255 * base.getInt("fx_opacity", 50) / 100f).toInt().coerceIn(0, 255)
+            val c0 = colors(base, "viz_", false)
+            val col = Colors(c0.src, c0.c1, c0.c2, sFxClock.toLong(), c0.list)
+            col.beat = c0.beat
+            val style = RasiFxPrefs.style(base)
+            val saved = canvas.save()
+            val oldNoStep = noStep
+            val oldExt = curExt
+            try {
+                canvas.clipRect(0f, 0f, w, h)
+                fxTransform(canvas, base, ang, w, h)
+                curExt = 0f
+                noStep = false
+                renderStyleCore(canvas, base, style, col, w, h, alpha, base.getInt("viz_sens", 70) / 100f * 1.6f, dens, false)
+            } finally {
+                noStep = oldNoStep
+                curExt = oldExt
+                canvas.restoreToCount(saved)
+            }
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "settings fx draw failed: " + t)
+        }
+    }
+
+    /** The lower part of the keyboard effect, behind the navigation buttons. */
+    private fun drawFxStrip(view: View, canvas: Canvas) {
+        try {
+            val ctx = view.context
+            if (!fxWanted(ctx)) return
+            val base = RasiNowPlaying.prefs(ctx)
+            val w = fxW
+            val kh = fxH
+            val ext = view.height.toFloat()
+            if (w <= 0f || kh <= 0f || ext <= 0f) return
+            val p = RasiFxPrefs.of(base)
+            view.getLocationOnScreen(locTmp)
+            val dx = fxLeft - locTmp[0]
+            val dens = view.resources.displayMetrics.density * base.getInt("fx_size", 100) / 100f
+            val alpha = (255 * base.getInt("fx_opacity", 80) / 100f).toInt().coerceIn(0, 255)
+            val c0 = colors(p, "viz_", false)
+            val col = Colors(c0.src, c0.c1, c0.c2, fxClock.toLong(), c0.list)
+            col.beat = c0.beat
+            val style = RasiFxPrefs.style(p)
+            val saved = canvas.save()
+            val oldNoStep = noStep
+            try {
+                canvas.clipRect(0f, 0f, view.width.toFloat(), ext)
+                canvas.translate(dx, -kh)
+                fxTransform(canvas, base, fxAng, w, kh + ext)
+                curExt = 0f
+                noStep = true
+                renderStyleCore(canvas, p, style, col, w, kh + ext, alpha, p.getInt("viz_sens", 70) / 100f * 1.6f, dens, false)
+            } finally {
+                noStep = oldNoStep
+                canvas.restoreToCount(saved)
+            }
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "fx strip draw failed: " + t)
+        }
+    }
+
+    private fun drawLayer(view: View, canvas: Canvas, over: Boolean, force: Boolean = false) {
+        val fxLate = !force && fxAfter(view.context)
+        if (!force && !fxLate) drawFx(view, canvas, over)
+        val p0 = RasiNowPlaying.live(view.context)
+        val p = if (force) RasiVizPrefs.settings(p0) else p0
+        val yoff = if (force) view.height * p.getInt("viz_yoff", 0) / 100f else 0f
+        val saved = canvas.save()
+        try {
+            if (yoff != 0f) canvas.translate(0f, -yoff)
+            drawLayerInner(view, canvas, over, force, p)
+        } finally {
+            canvas.restoreToCount(saved)
+        }
+        if (fxLate) drawFx(view, canvas, over)
+    }
