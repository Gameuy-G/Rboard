+/** Your KLIPY API key. A built-in default is used unless you save a different one. */
+private object GiphyKey {
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("rasi_klipy", Context.MODE_PRIVATE)
+
+    fun get(context: Context): String =
+        (prefs(context).getString("api_key", "") ?: "").ifBlank { KLIPY_DEFAULT_KEY }
+
+    fun set(context: Context, key: String) {
+        prefs(context).edit().putString("api_key", key.trim()).apply()
+    }
+
+    fun customerId(context: Context): String {
+        val p = prefs(context)
+        var id = p.getString("customer_id", "") ?: ""
+        if (id.isEmpty()) {
+            id = java.util.UUID.randomUUID().toString()
+            p.edit().putString("customer_id", id).apply()
+        }
+        return id
+    }
+}
