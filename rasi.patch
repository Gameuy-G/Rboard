+import org.futo.inputmethod.latin.rasi.RasiNowPlaying
+import org.futo.inputmethod.latin.rasi.RasiSongLooks
+
+/** Now playing > Song looks: custom gradient colors and saving a look for the playing song. */
+@Composable
+fun RasiSongLookSection(prefs: SharedPreferences, onOpenList: () -> Unit = {}) {
+    val ctx = LocalContext.current
+    var tick by remember { mutableIntStateOf(0) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        RasiNowPlaying.listeners.add(l)
+        onDispose { RasiNowPlaying.listeners.remove(l) }
+    }
+    val unused = tick
+    val t = RasiNowPlaying.track
+    val saved = RasiSongLooks.hasLook(ctx, t)
+    val applied = RasiSongLooks.currentKey != null
+    var cg by remember { mutableStateOf(prefs.getBoolean("sl_cg", false)) }
+    var msg by remember { mutableStateOf("") }
+
+    Text("Song looks", style = MaterialTheme.typography.titleMedium)
+    Text(
+        "Save a look for one song (its gradient colors, visualizer colors and cover background). It is applied by itself whenever that song plays. Your normal options stay untouched. Needs no internet.",
+        style = MaterialTheme.typography.bodySmall
+    )
+    RasiPrefSwitch(prefs, "sl_on", "Use song looks", "Master switch. Off = saved looks are ignored but kept.", true)
+    RasiPrefSwitch(prefs, "sl_auto", "Apply automatically", "Apply the saved look as soon as its song starts. Off = only with the Apply button below.", true)
+
+    RasiPrefSwitch(prefs, "sl_cg", "Custom gradient colors", "Dynamic theme uses the two colors below instead of the cover colors (needs Dynamic theme on). Saved looks can keep their own pair.", false)
+    cg = prefs.getBoolean("sl_cg", false)
+    RasiColorPick(prefs, "sl_c1", "Gradient color 1", 0xFF7CF29C.toInt())
+    RasiColorPick(prefs, "sl_c2", "Gradient color 2", 0xFF4F8CFF.toInt())
+
+    RasiSection("What a saved look keeps")
+    RasiPrefSwitch(prefs, "sl_s_grad", "Gradient", "Gradient on/off and the custom gradient pair (if that switch is on).", true)
+    RasiPrefSwitch(prefs, "sl_s_viz", "Visualizer colors", "Color source, thumbnail color options and the two picked colors of the keyboard visualizer.", true)
+    RasiPrefSwitch(prefs, "sl_s_bg", "Cover background", "Blur, darken and strength of the song background.", true)
+
+    Text(
+        if (t == null) "Nothing is playing. Start a song to save a look for it."
+        else "Playing: " + t.title + (if (t.artist.isNotBlank()) " - " + t.artist else "") +
+            (if (saved) (if (applied) "\nA saved look is applied now." else "\nThis song has a saved look.") else "\nNo saved look yet."),
+        style = MaterialTheme.typography.bodySmall
+    )
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        Button(enabled = t != null, onClick = {
+            msg = if (RasiSongLooks.saveCurrent(ctx)) "Saved for this song." else "Nothing to save: turn on at least one part above."
+            tick++
+        }) { Text(if (saved) "Update look" else "Save look") }
+        if (saved) {
+            OutlinedButton(onClick = { RasiSongLooks.deleteFor(ctx, t); msg = "Deleted."; tick++ }) { Text("Delete") }
+        }
+    }
+    if (saved && !applied) {
+        OutlinedButton(onClick = { msg = if (RasiSongLooks.applyNow(ctx)) "Applied until the song changes." else "Could not apply."; tick++ }) { Text("Apply now") }
+    }
+    Text(
+        "Saved looks: " + RasiSongLooks.count(ctx) + (if (msg.isNotEmpty()) "\n" + msg else ""),
+        style = MaterialTheme.typography.bodySmall
+    )
+    OutlinedButton(onClick = onOpenList) { Text("Manage saved looks") }
+}
