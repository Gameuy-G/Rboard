+        val horrorDecos = listOf("☠", "🕷", "🦇", "🩸", "👻", "⚰", "🕸", "💀", "🔪", "🎃")
+        val horrorBases = listOf("Fraktur" to gothic, "Bold Fraktur" to fraktur, "Plain" to normal)
+        for (d in horrorDecos) for ((bn, b) in horrorBases) add("$bn $d", "Horror", b, 0, d)
+
+        // Glitch: real zalgo text with stacked combining marks
+        val zalgoBases = listOf("Plain" to normal, "Bold" to bold, "Italic" to italic, "Script" to script,
+            "Fraktur" to gothic, "Mono" to mono, "Double" to double, "Sans" to sans)
+        val zalgoLevels = listOf(
+            "Light" to intArrayOf(1, 0, 1), "Medium" to intArrayOf(2, 1, 2), "Heavy" to intArrayOf(4, 2, 4),
+            "Extreme" to intArrayOf(7, 3, 7), "Up only" to intArrayOf(3, 0, 0), "Down only" to intArrayOf(0, 0, 3),
+            "Middle" to intArrayOf(0, 3, 0)
+        )
+        for ((ln, z) in zalgoLevels) for ((bn, b) in zalgoBases) {
+            add(if (bn == "Plain") "Glitch $ln" else "$bn Glitch $ln", "Glitch", b, 0, "", z[0], z[1], z[2])
+        }
+
+        // Lines: one combining mark over several alphabets
+        val marks = listOf(
+            0x0336 to "Strikethrough", 0x0332 to "Underline", 0x0333 to "Double Underline", 0x0305 to "Overline",
+            0x0338 to "Slash", 0x0307 to "Dotted", 0x0308 to "Umlaut", 0x0303 to "Tilde", 0x030A to "Ring",
+            0x0330 to "Wavy Underline", 0x0353 to "Cross Below", 0x034D to "Arrows Below"
+        )
+        val markBases = listOf("Normal" to normal, "Bold" to bold, "Italic" to italic, "Script" to script,
+            "Double" to double, "Mono" to mono)
+        for ((cp, mn) in marks) for ((bn, b) in markBases) {
+            add(if (bn == "Normal") mn else "$bn $mn", "Lines", b, 0, mark(cp))
+        }
+
+        // Wrappers
+        val enclosers = listOf(0x20DD to "Circle", 0x20DE to "Box", 0x20DF to "Diamond", 0x20E0 to "Forbidden",
+            0x20E2 to "Screen", 0x20E3 to "Keycap", 0x20E4 to "Triangle")
+        val boxBases = listOf("Normal" to normal, "Bold" to bold, "Script" to script, "Mono" to mono, "Sans" to sans)
+        for ((cp, en) in enclosers) for ((bn, b) in boxBases) {
+            add(if (bn == "Normal") "$en Wrap" else "$bn $en Wrap", "Cool", b, 0, mark(cp))
+        }
+
+        // Letter cases
+        add("UPPERCASE", "Cases", normal, 1)
+        add("lowercase", "Cases", normal, 2)
+        add("aLtErNaTiNg", "Cases", normal, 3)
+        val caseBases = listOf("Bold" to bold, "Script" to script, "Double" to double,
+            "Sans" to sans, "Mono" to mono, "Small" to smallCaps, "Wide" to wide)
+        for ((bn, b) in caseBases) {
+            add("$bn UPPER", "Cases", b, 1)
+            add("$bn lower", "Cases", b, 2)
+            add("$bn aLt", "Cases", b, 3)
+        }
+
+        // Symbol text: decoration after every character
+        val symbols = listOf(
+            "♥", "♡", "★", "☆", "✿", "❀", "✧", "✦", "♪", "☾", "☁", "⚡", "☘", "❄", "☂", "✈", "♛",
+            "☯", "✌", "⚘", "❁", "❃", "✺", "❖", "◆", "◇", "●", "○", "■", "□", "▲", "△", "♣", "♠", "♦"
+        )
+        for (sy in symbols) {
+            add("Plain $sy", "Symbols", normal, 0, sy)
+            add("Bold $sy", "Symbols", bold, 0, sy)
+            add("Script $sy", "Symbols", script, 0, sy)
+        }
+        val seps = listOf("\u200A", "\u2009", "·", "•", "-", "_", "/", "|", "~", ".", ":", "˙", "∙", "°", "ˑ")
+        val sepBases = listOf("Plain" to normal, "Bold" to bold, "Wide" to wide, "Mono" to mono, "Sans" to sans)
+        for (sp in seps) for ((bn, b) in sepBases) {
+            val shown = if (sp.length == 1 && sp[0].code > 0x2000 && sp[0].code < 0x2010) "thin" else sp
+            add("$bn spaced $shown", "Symbols", b, 0, sp)
+        }
+        val mixBases = listOf("Small Caps" to smallCaps, "Tiny" to tiny, "Cool" to cool, "Festival" to festival,
+            "Cyrillic" to cyrillic, "Greek" to greek, "Currency" to currency, "Runic" to runic, "Asian" to cjk)
+        val decos = listOf("♥", "✧", "·", "★", "✿", "☾", "~")
+        for ((bn, b) in mixBases) for (d in decos) add("$bn $d", "Symbols", b, 0, d)
+
+
+        // v2.4.26 sections: each base alphabet combined with decorations (names that already exist are skipped)
+        val seen = all.map { it.name }.toHashSet()
+        fun addNew(name: String, tag: String, b: (Int) -> Int, cm: Int = 0, suffix: String = "") {
+            if (seen.add(name)) all.add(RasiFontStyle(name, tag, b, cm, suffix))
+        }
+        val line3 = listOf("" to "", "\u2726" to "\u2726", "\u2605" to "\u2605", "\u00B7" to "\u00B7", "~" to "~",
+            "\u2665" to "\u2665", "\u263E" to "\u263E", "\u2020" to "\u2020",
+            "Underline" to mark(0x0332), "Strike" to mark(0x0336), "Overline" to mark(0x0305))
+        fun combo(tag: String, bases: List<Pair<String, (Int) -> Int>>, decos: List<Pair<String, String>>) {
+            for ((bn, b) in bases) for ((dn, d) in decos) addNew(if (dn.isEmpty()) bn else "$bn $dn", tag, b, 0, d)
+        }
+        combo("Ancient", listOf("Old Italic" to oldItalic, "Ulfilas" to ulfilas, "Braille" to braille,
+            "Elder Runes" to runic, "Asian Block" to cjk), line3)
+        combo("Emblems", listOf("Flag Letters" to flagLetters, "Black Circle" to blackBubble, "Black Box" to blackSquare,
+            "Circle Letters" to bubble, "Box Letters" to square), line3)
+        combo("Kawaii", listOf("Kawaii Caps" to smallCaps, "Kawaii Tiny" to tiny, "Kawaii Cool" to cool,
+            "Kawaii Greek" to greek, "Kawaii Festival" to festival, "Kawaii Circle" to bubble),
+            listOf("\u2661" to "\u2661", "\u2740" to "\u2740", "\u02DA" to "\u02DA", "\u207A" to "\u207A",
+                "\u208A" to "\u208A", "\u1D54" to "\u1D54", "\u2765" to "\u2765", "\u266B" to "\u266B",
+                "\u02D9" to "\u02D9", "\u2727\u02DA" to "\u2727\u02DA", "\u00B7\u00B7" to "\u00B7\u00B7"))
+        combo("Neon", listOf("Neon" to sansBoldItalic, "Neon Bold" to sansBold, "Neon Slant" to sansItalic,
+            "Neon Clean" to sans, "Neon Mono" to mono, "Neon Double" to double),
+            listOf("" to "", "\u26A1" to "\u26A1", "\u2605" to "\u2605", "\u266A" to "\u266A", "\u27E1" to "\u27E1",
+                "\u00BB" to "\u00BB", "\u00AB" to "\u00AB", "\u2726" to "\u2726", "Underline" to mark(0x0332),
+                "Overline" to mark(0x0305)))
+        combo("Aesthetic", listOf("Vapor Wide" to wide, "Vapor Caps" to vaporCaps, "Vapor Tiny" to tiny,
+            "Vapor Small" to smallCaps, "Vapor Cool" to cool),
+            listOf("" to "", "wide" to "\u3000", "dot" to "\uFF65", "ring" to "\uFF9F", "stop" to "\uFF61",
+                "dash" to "\uFF0D", "bar" to "\uFF5C", "wave" to "\uFF5E", "slash" to "\uFF0F",
+                "star" to "\uFF0A", "plus" to "\uFF0B"))
+        for ((bn, b) in listOf("Leet" to leet, "Phonetic" to phonetic, "Braille Tech" to braille,
+            "Currency Tech" to currency, "Asian Tech" to cjk)) {
+            for ((cn, cm) in listOf("" to 0, "UPPER" to 1, "lower" to 2)) {
+                for ((dn, d) in listOf("" to "", "dot" to "\u00B7", "tilde" to "~", "spark" to "\u2726")) {
+                    addNew(listOf(bn, cn, dn).filter { it.isNotEmpty() }.joinToString(" "), "Tech", b, cm, d)
+                }
+            }
+        }
+        combo("Royal", listOf("Royal Script" to script, "Royal Thin Script" to scriptThin, "Royal Fraktur" to fraktur,
+            "Royal Gothic" to gothic, "Royal Double" to double),
+            listOf("" to "", "\u265B" to "\u265B", "\u2655" to "\u2655", "\u265A" to "\u265A", "\u269C" to "\u269C",
+                "\u2766" to "\u2766", "\u2767" to "\u2767", "\u2619" to "\u2619", "\u2654" to "\u2654",
+                "\u2727" to "\u2727", "\u2756" to "\u2756"))
+        val overlays = listOf(0x0335 to "Short Stroke", 0x0337 to "Short Slash", 0x0334 to "Tilde Overlay",
+            0x0346 to "Bridge Above", 0x0347 to "Equals Below", 0x0348 to "Double Vertical Below",
+            0x0349 to "Left Angle Below", 0x035E to "Double Macron", 0x0360 to "Double Tilde",
+            0x0361 to "Double Arch", 0x0310 to "Candrabindu")
+        combo("Marks", listOf("Plain" to normal, "Bold" to bold, "Sans" to sans, "Sans Bold" to sansBold,
+            "Small Caps" to smallCaps), overlays.map { (cp, n) -> n to mark(cp) })
+
+        val order = listOf("Cool", "Fancy", "Cursive", "Small", "Bold", "Gothic", "Horror", "Glitch", "Lines", "Cases", "Symbols",
+            "Ancient", "Emblems", "Kawaii", "Neon", "Aesthetic", "Tech", "Royal", "Marks")
+        val labels = mapOf("Cases" to "Letter cases", "Symbols" to "Symbol text")
+        val out = ArrayList<RasiFontCategory>()
+        out.add(RasiFontCategory("All", all))
+        for (t in order) out.add(RasiFontCategory(labels[t] ?: t, all.filter { it.tag == t }))
+        out
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiFriendAlerts.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiFriendAlerts.kt
new file mode 100644
index 000000000..0225a5c88
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiFriendAlerts.kt
@@ -0,0 +1,140 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.SharedPreferences
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import com.google.firebase.firestore.DocumentSnapshot
+import com.google.firebase.firestore.FirebaseFirestore
+import java.util.Calendar
+
+/**
+ * Notifies you when a chosen friend starts a song. There is no server (free plan), so this checks on a timer
+ * while the Rboard process is alive: one small read per chosen friend per check. Prefs live in RasiAccount.prefs.
+ */
+object RasiFriendAlerts {
+    private const val CH = "rasi_friend_song"
+    private val h = Handler(Looper.getMainLooper())
+    private var running = false
+    private var ctx: Context? = null
+    private var baseline = true
+    private val seen = HashMap<String, String>()
+    private val lastAt = HashMap<String, Long>()
+
+    private val tick = object : Runnable {
+        override fun run() {
+            val c = ctx
+            if (c == null) { running = false; return }
+            val p = RasiAccount.prefs(c)
+            if (!p.getBoolean("fa_on", false)) { running = false; return }
+            try { poll(c, p) } catch (t: Throwable) { RasiLog.fallback("RasiFriendAlerts", "Check failed: " + t.javaClass.simpleName) }
+            h.postDelayed(this, p.getInt("fa_interval", 5).coerceIn(2, 30) * 60000L)
+        }
+    }
+
+    /** Starts the timer when alerts are on. Safe to call often. */
+    fun ensure(c: Context) {
+        ctx = c.applicationContext
+        if (running) return
+        try { RasiAccount.init(c.applicationContext) } catch (t: Throwable) { }
+        if (!RasiAccount.prefs(c.applicationContext).getBoolean("fa_on", false)) return
+        running = true
+        h.postDelayed(tick, 8000L)
+    }
+
+    /** Applies changed settings (new interval, on/off). */
+    fun restart(c: Context) {
+        h.removeCallbacks(tick)
+        running = false
+        baseline = true
+        ensure(c)
+    }
+
+    private fun inQuiet(p: SharedPreferences): Boolean {
+        if (!p.getBoolean("fa_quiet_on", false)) return false
+        val from = p.getInt("fa_quiet_from", 23)
+        val to = p.getInt("fa_quiet_to", 7)
+        val hr = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+        return if (from == to) false else if (from < to) hr in from until to else (hr >= from || hr < to)
+    }
+
+    fun chosen(p: SharedPreferences, list: List<RasiFriends.Friend>): List<RasiFriends.Friend> {
+        val all = p.getBoolean("fa_all", false)
+        return list.filter { all || p.getBoolean("fa_f_" + it.uid, false) }.take(p.getInt("fa_max", 10).coerceIn(1, 20))
+    }
+
+    private fun poll(c: Context, p: SharedPreferences) {
+        if (RasiAccount.uid.value == null) return
+        if (inQuiet(p)) return
+        val fl = RasiFriends.friends.value
+        if (fl.isEmpty()) { RasiFriends.refresh(c); return }
+        val list = chosen(p, fl)
+        val wasBaseline = baseline
+        baseline = false
+        val d = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { return }
+        for (f in list) {
+            d.collection("users").document(f.uid).collection("shared").document("now").get()
+                .addOnSuccessListener { s -> handle(c, p, f, s, wasBaseline) }
+                .addOnFailureListener {
+                    seen.remove(f.uid)
+                    // a friend who hides their song from you answers with permission denied: that is normal
+                    if (!(it.message ?: "").contains("PERMISSION_DENIED")) RasiLog.fallback("RasiFriendAlerts", "Could not read a friend song: " + it.javaClass.simpleName)
+                }
+        }
+    }
+
+    private fun handle(c: Context, p: SharedPreferences, f: RasiFriends.Friend, s: DocumentSnapshot, wasBaseline: Boolean) {
+        if (!s.exists()) { seen.remove(f.uid); return }
+        val title = s.getString("title") ?: ""
+        val artist = s.getString("artist") ?: ""
+        val app = s.getString("app") ?: ""
+        val playing = s.getBoolean("playing") ?: true
+        val at = s.getLong("updatedAt") ?: 0L
+        if (title.isBlank()) return
+        if (p.getBoolean("fa_only_playing", true) && !playing) { if (!p.getBoolean("fa_same", true)) seen.remove(f.uid); return }
+        val window = maxOf(10, p.getInt("fa_interval", 5) * 2) * 60000L
+        if (at <= 0L || System.currentTimeMillis() - at > window) return
+        val key = title + "|" + artist
+        if (seen[f.uid] == key) return
+        seen[f.uid] = key
+        if (wasBaseline) return
+        val cool = p.getInt("fa_cooldown", 10) * 60000L
+        val now = System.currentTimeMillis()
+        if (cool > 0L && now - (lastAt[f.uid] ?: 0L) < cool) return
+        lastAt[f.uid] = now
+        val name = f.p.name.ifBlank { f.p.username }
+        val song = if (artist.isBlank()) title else "$title - $artist"
+        val text = song + (if (p.getBoolean("fa_show_app", true) && app.isNotBlank()) " on $app" else "")
+        post(c, f.uid.hashCode(), name + " is listening to", text)
+    }
+
+    fun enabled(c: Context): Boolean = try { NotificationManagerCompat.from(c).areNotificationsEnabled() } catch (t: Throwable) { false }
+
+    fun test(c: Context) { post(c, 4242, "Song alerts work", "This is how a friend's song will look") }
+
+    private fun post(c: Context, id: Int, title: String, text: String) {
+        try {
+            if (!enabled(c)) { RasiLog.fallback("RasiFriendAlerts", "Notifications are off for Rboard"); return }
+            val nm = c.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+            if (Build.VERSION.SDK_INT >= 26) nm.createNotificationChannel(NotificationChannel(CH, "Friend songs", NotificationManager.IMPORTANCE_DEFAULT))
+            val launch = c.packageManager.getLaunchIntentForPackage(c.packageName)
+            val b = NotificationCompat.Builder(c, CH)
+                .setSmallIcon(android.R.drawable.ic_media_play)
+                .setContentTitle(title)
+                .setContentText(text)
+                .setAutoCancel(true)
+                .setPriority(NotificationCompat.PRIORITY_DEFAULT)
+            if (launch != null) b.setContentIntent(PendingIntent.getActivity(c, 0, launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK), PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT))
+            nm.notify(id, b.build())
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiFriendAlerts", "Could not show the notification: " + t.javaClass.simpleName)
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiFriends.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiFriends.kt
new file mode 100644
index 000000000..47d67b979
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiFriends.kt
@@ -0,0 +1,258 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import androidx.compose.runtime.mutableStateOf
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FirebaseFirestore
+
+/**
+ * Friends (Firebase, uses the internet). Only profiles and the totals people chose to share are read.
+ * Firestore layout:
+ *   friendRequests/{from}_{to}  {from, to, createdAt}   (deleted when accepted, declined or cancelled)
+ *   users/{uid}/friends/{friendUid} {since}              (written on both sides when a request is accepted)
+ *   users/{uid}/blocks/{otherUid}   {at}                 (owner only)
+ */
+object RasiFriends {
+    class Friend(val uid: String, val p: RasiAccount.Profile)
+    class Now(val title: String, val artist: String, val app: String, val playing: Boolean, val at: Long, val c1: Int = 0, val c2: Int = 0,
+                val posMs: Long = -1L, val pkg: String = "", val durMs: Long = -1L)
+    class FriendStats(val keys: Long, val words: Long, val listenMs: Long, val top: List<String>)
+
+    val friends = mutableStateOf<List<Friend>>(emptyList())
+    val incoming = mutableStateOf<List<Friend>>(emptyList())
+    val outgoing = mutableStateOf<List<Friend>>(emptyList())
+    val blocked = mutableStateOf<List<Friend>>(emptyList())
+    val found = mutableStateOf<Friend?>(null)
+    val busy = mutableStateOf(false)
+    val message = mutableStateOf("")
+    private var lastRefresh = 0L
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun me(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+
+    private fun fail(t: Throwable?, what: String): String {
+        RasiLog.fallback("RasiFriends", what + ": " + (t?.javaClass?.simpleName ?: "unknown"))
+        val text = generateSequence(t) { it.cause }.take(5).joinToString(" ") { it.message ?: "" }
+        return if (text.contains("PERMISSION_DENIED")) "The server refused this. The new Firestore rules may not be published yet, or that person is not accepting requests"
+        else "Could not reach the server. Check your internet and try again"
+    }
+
+    /** Loads the public profile of every uid (one read each) and returns them in the same order. */
+    private fun loadUsers(ids: List<String>, cb: (List<Friend>) -> Unit) {
+        val d = db()
+        if (d == null || ids.isEmpty()) { cb(emptyList()); return }
+        val out = arrayOfNulls<Friend>(ids.size)
+        var left = ids.size
+        ids.forEachIndexed { i, id ->
+            d.collection("users").document(id).get().addOnCompleteListener { t ->
+                val s = t.result
+                if (t.isSuccessful && s != null && s.exists()) out[i] = Friend(id, RasiAccount.parse(s))
+                left--
+                if (left == 0) cb(out.filterNotNull())
+            }
+        }
+    }
+
+    /** Refreshes friends, requests and blocks. Skipped when the last refresh is newer than the cache slider. */
+    fun refresh(c: Context, force: Boolean = false) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val mins = RasiAccount.prefs(c).getInt("fr_cache_min", 5)
+        val now = System.currentTimeMillis()
+        if (!force && now - lastRefresh < mins * 60000L) return
+        lastRefresh = now
+        busy.value = true
+        var pending = 4
+        fun fin() { pending--; if (pending == 0) busy.value = false }
+        d.collection("users").document(id).collection("friends").get().addOnSuccessListener { q ->
+            loadUsers(q.documents.map { it.id }) { friends.value = it.sortedBy { f -> f.p.username }; fin() }
+        }.addOnFailureListener { message.value = fail(it, "Load friends"); fin() }
+        d.collection("friendRequests").whereEqualTo("to", id).get().addOnSuccessListener { q ->
+            loadUsers(q.documents.mapNotNull { it.getString("from") }) { incoming.value = it; fin() }
+        }.addOnFailureListener { message.value = fail(it, "Load requests"); fin() }
+        d.collection("friendRequests").whereEqualTo("from", id).get().addOnSuccessListener { q ->
+            loadUsers(q.documents.mapNotNull { it.getString("to") }) { outgoing.value = it; fin() }
+        }.addOnFailureListener { message.value = fail(it, "Load sent requests"); fin() }
+        d.collection("users").document(id).collection("blocks").get().addOnSuccessListener { q ->
+            loadUsers(q.documents.map { it.id }) { blocked.value = it; fin() }
+        }.addOnFailureListener { message.value = fail(it, "Load blocks"); fin() }
+    }
+
+    fun clear() {
+        friends.value = emptyList(); incoming.value = emptyList(); outgoing.value = emptyList()
+        blocked.value = emptyList(); found.value = null; message.value = ""; lastRefresh = 0L
+    }
+
+    val suggestions = mutableStateOf<List<Friend>>(emptyList())
+    val suggestBusy = mutableStateOf(false)
+    private var suggestSeq = 0
+
+    /** Username prefix search (one query, at most max reads). Newer calls cancel older answers. */
+    fun suggest(prefix: String, max: Int) {
+        val d = db() ?: return
+        val q = prefix.trim().removePrefix("@").lowercase()
+        val seq = ++suggestSeq
+        if (q.isEmpty()) { suggestions.value = emptyList(); suggestBusy.value = false; return }
+        suggestBusy.value = true
+        d.collection("users").orderBy("username").startAt(q).endAt(q + "\uf8ff").limit(max.coerceIn(1, 10).toLong()).get()
+            .addOnSuccessListener { r ->
+                if (seq != suggestSeq) return@addOnSuccessListener
+                val mine = me()
+                val skip = blocked.value.map { it.uid }.toSet()
+                suggestions.value = r.documents.filter { it.id != mine && it.id !in skip }.map { Friend(it.id, RasiAccount.parse(it)) }
+                suggestBusy.value = false
+            }
+            .addOnFailureListener { t ->
+                if (seq != suggestSeq) return@addOnFailureListener
+                suggestBusy.value = false
+                suggestions.value = emptyList()
+                RasiLog.fallback("RasiFriends", "Username search failed: " + t.javaClass.simpleName)
+            }
+    }
+
+    fun clearSuggestions() { suggestSeq++; suggestions.value = emptyList(); suggestBusy.value = false }
+
+    /** Looks a person up by friend code (8 letters/digits) or exact username. Nothing is sent yet. */
+    fun find(query: String) {
+        val d = db() ?: return
+        val q = query.trim().removePrefix("@")
+        found.value = null
+        if (q.length < 3) { message.value = "Type a friend code or an exact username"; return }
+        message.value = ""; busy.value = true
+        val isCode = q.length == 8 && q.uppercase() == q && q.any { it.isDigit() || it.isUpperCase() } && !q.contains('.') && !q.contains('_')
+        val ref = if (isCode) d.collection("codes").document(q.uppercase()) else d.collection("usernames").document(q.lowercase())
+        ref.get().addOnSuccessListener { s ->
+            val target = s.getString("uid")
+            if (target == null) { busy.value = false; message.value = "Nobody found with that code or username"; return@addOnSuccessListener }
+            loadUsers(listOf(target)) { r ->
+                busy.value = false
+                if (r.isEmpty()) message.value = "Nobody found with that code or username" else found.value = r[0]
+            }
+        }.addOnFailureListener { busy.value = false; message.value = "Nobody found with that code or username" }
+    }
+
+    fun sendRequest(c: Context, target: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        when {
+            target == id -> { message.value = "That is you"; return }
+            friends.value.any { it.uid == target } -> { message.value = "You are already friends"; return }
+            blocked.value.any { it.uid == target } -> { message.value = "You blocked this person. Unblock them first"; return }
+            incoming.value.any { it.uid == target } -> { accept(c, target); return }
+            outgoing.value.any { it.uid == target } -> { message.value = "You already sent a request"; return }
+        }
+        busy.value = true
+        val map = hashMapOf<String, Any>("from" to id, "to" to target, "createdAt" to System.currentTimeMillis())
+        d.collection("friendRequests").document(id + "_" + target).set(map).addOnCompleteListener { t ->
+            busy.value = false
+            if (t.isSuccessful) { message.value = "Request sent"; found.value = null; refresh(c, true) }
+            else message.value = fail(t.exception, "Send request")
+        }
+    }
+
+    private fun done(c: Context, t: com.google.android.gms.tasks.Task<Void>, ok: String, what: String) {
+        busy.value = false
+        if (t.isSuccessful) { message.value = ok; refresh(c, true) } else message.value = fail(t.exception, what)
+    }
+
+    fun accept(c: Context, from: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        val b = d.batch()
+        val since = hashMapOf<String, Any>("since" to System.currentTimeMillis())
+        b.set(d.collection("users").document(id).collection("friends").document(from), since)
+        b.set(d.collection("users").document(from).collection("friends").document(id), since)
+        b.delete(d.collection("friendRequests").document(from + "_" + id))
+        b.commit().addOnCompleteListener { done(c, it, "You are now friends", "Accept") }
+    }
+
+    fun decline(c: Context, from: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        d.collection("friendRequests").document(from + "_" + id).delete().addOnCompleteListener { done(c, it, "Request declined", "Decline") }
+    }
+
+    fun cancel(c: Context, to: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        d.collection("friendRequests").document(id + "_" + to).delete().addOnCompleteListener { done(c, it, "Request cancelled", "Cancel") }
+    }
+
+    fun remove(c: Context, other: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        val b = d.batch()
+        b.delete(d.collection("users").document(id).collection("friends").document(other))
+        b.delete(d.collection("users").document(other).collection("friends").document(id))
+        b.commit().addOnCompleteListener { done(c, it, "Friend removed", "Remove friend") }
+    }
+
+    /** Blocking also removes the friendship and any pending requests, and stops new requests from that person. */
+    fun block(c: Context, other: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        val b = d.batch()
+        b.set(d.collection("users").document(id).collection("blocks").document(other), hashMapOf<String, Any>("at" to System.currentTimeMillis()))
+        b.delete(d.collection("users").document(id).collection("friends").document(other))
+        b.delete(d.collection("users").document(other).collection("friends").document(id))
+        b.delete(d.collection("friendRequests").document(other + "_" + id))
+        b.delete(d.collection("friendRequests").document(id + "_" + other))
+        b.commit().addOnCompleteListener { done(c, it, "Blocked", "Block") }
+    }
+
+    fun unblock(c: Context, other: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        d.collection("users").document(id).collection("blocks").document(other).delete().addOnCompleteListener { done(c, it, "Unblocked", "Unblock") }
+    }
+
+    /** Server side switch: when off, nobody can send you new requests. */
+    fun setAllowRequests(on: Boolean) {
+        val d = db() ?: return
+        val id = me() ?: return
+        d.collection("users").document(id).set(hashMapOf<String, Any>("allowRequests" to on), com.google.firebase.firestore.SetOptions.merge())
+            .addOnSuccessListener { RasiAccount.loadProfile() }
+            .addOnFailureListener { message.value = fail(it, "Allow requests") }
+    }
+
+    /** A friend's shared totals (only readable when you are friends and they share). */
+    fun fetchStats(uid: String, cb: (FriendStats?) -> Unit) {
+        val d = db()
+        if (d == null) { cb(null); return }
+        d.collection("users").document(uid).collection("shared").document("stats").get().addOnSuccessListener { s ->
+            if (!s.exists()) { cb(null); return@addOnSuccessListener }
+            val top = (s.get("top") as? List<*>)?.mapNotNull { m ->
+                val mm = m as? Map<*, *> ?: return@mapNotNull null
+                val t = mm["title"] as? String ?: return@mapNotNull null
+                val a = mm["artist"] as? String ?: ""
+                if (a.isBlank()) t else "$t - $a"
+            } ?: emptyList()
+            cb(FriendStats(s.getLong("keys") ?: 0L, s.getLong("words") ?: 0L, s.getLong("listenMs") ?: 0L, top))
+        }.addOnFailureListener { RasiLog.fallback("RasiFriends", "Could not read friend stats: " + it.javaClass.simpleName); cb(null) }
+    }
+
+    /** Text for a friend's live song, e.g. "Song - Artist on Spotify". */
+    fun nowText(n: Now): String {
+        val song = if (n.title.isBlank()) "something" else if (n.artist.isBlank()) n.title else n.title + " - " + n.artist
+        return song + (if (n.app.isNotBlank()) " on " + n.app else "") + (if (!n.playing) " (paused)" else "")
+    }
+
+    /** Live updates of a friend's current song while a card is on screen. Returns a function that stops listening. */
+    fun listenNow(uid: String, cb: (Now?) -> Unit): () -> Unit {
+        val d = db() ?: return {}
+        val reg = d.collection("users").document(uid).collection("shared").document("now").addSnapshotListener { s, e ->
+            if (e != null || s == null || !s.exists()) { cb(null); return@addSnapshotListener }
+            cb(Now(s.getString("title") ?: "", s.getString("artist") ?: "", s.getString("app") ?: "",
+                s.getBoolean("playing") ?: true, s.getLong("updatedAt") ?: 0L,
+                s.getLong("c1")?.toInt() ?: 0, s.getLong("c2")?.toInt() ?: 0,
+                s.getLong("posMs") ?: -1L, s.getString("pkg") ?: "", s.getLong("durMs") ?: -1L))
+        }
+        return { reg.remove() }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiFxPrefs.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiFxPrefs.kt
new file mode 100644
index 000000000..1a75440fb
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiFxPrefs.kt
@@ -0,0 +1,88 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.SharedPreferences
+
+/** Gives the keyboard visual effects their own copy of the viz_ options (stored as fxviz_). */
+class RasiFxMappedPrefs(private val base: SharedPreferences) : SharedPreferences by base {
+    private fun m(k: String?): String? = RasiFxPrefs.map(k)
+
+    override fun getString(key: String?, defValue: String?): String? = base.getString(m(key), defValue)
+    override fun getInt(key: String?, defValue: Int): Int = base.getInt(m(key), defValue)
+    override fun getBoolean(key: String?, defValue: Boolean): Boolean = base.getBoolean(m(key), defValue)
+    override fun getFloat(key: String?, defValue: Float): Float = base.getFloat(m(key), defValue)
+    override fun getLong(key: String?, defValue: Long): Long = base.getLong(m(key), defValue)
+    override fun contains(key: String?): Boolean = base.contains(m(key))
+    override fun edit(): SharedPreferences.Editor = MappedEditor(base.edit())
+
+    private class MappedEditor(private val e: SharedPreferences.Editor) : SharedPreferences.Editor by e {
+        override fun putString(key: String?, value: String?): SharedPreferences.Editor { e.putString(RasiFxPrefs.map(key), value); return this }
+        override fun putInt(key: String?, value: Int): SharedPreferences.Editor { e.putInt(RasiFxPrefs.map(key), value); return this }
+        override fun putBoolean(key: String?, value: Boolean): SharedPreferences.Editor { e.putBoolean(RasiFxPrefs.map(key), value); return this }
+        override fun putFloat(key: String?, value: Float): SharedPreferences.Editor { e.putFloat(RasiFxPrefs.map(key), value); return this }
+        override fun putLong(key: String?, value: Long): SharedPreferences.Editor { e.putLong(RasiFxPrefs.map(key), value); return this }
+        override fun remove(key: String?): SharedPreferences.Editor { e.remove(RasiFxPrefs.map(key)); return this }
+    }
+}
+
+/** Keyboard visual effects: cool visuals that do not need music (moved out of the music visualizer list). */
+object RasiFxPrefs {
+    val STYLES: List<Pair<String, String>> = listOf(
+        "fireflies" to "Fireflies", "lava" to "Lava blobs", "lightning" to "Lightning", "rain" to "Rain",
+        "waterfall" to "Waterfall", "fountain" to "Fountain", "tunnel" to "Neon tunnel",
+        "fireworks" to "Fireworks", "ribbons" to "Ribbons",
+        "galaxy" to "Galaxy spiral", "matrix" to "Matrix rain", "dna" to "DNA helix",
+        "bounce" to "Bouncing balls", "liquid" to "Liquid layers", "snow" to "Snowfall", "kaleido" to "Kaleidoscope",
+        "hexpulse" to "Hex pulse", "bubbles" to "Bubbles"
+    )
+    val KEYS: Set<String> = STYLES.map { it.first }.toSet()
+
+    @Volatile private var cached: RasiFxMappedPrefs? = null
+    @Volatile private var cachedBase: SharedPreferences? = null
+
+    fun map(k: String?): String? = if (k != null && k.startsWith("viz_")) "fx$k" else k
+
+    fun of(base: SharedPreferences): SharedPreferences {
+        val c = cached
+        if (c != null && cachedBase === base) return c
+        val n = RasiFxMappedPrefs(base)
+        cached = n
+        cachedBase = base
+        return n
+    }
+
+    @Volatile private var sCached: SharedPreferences? = null
+    @Volatile private var sBase: SharedPreferences? = null
+
+    /** The effects behind the settings screens: own copy of every fx_ and viz_ option (sfx_ and sfxviz_). */
+    fun settingsOf(base: SharedPreferences): SharedPreferences {
+        val c = sCached
+        if (c != null && sBase === base) return c
+        val n = RasiRemapPrefs(base) { k ->
+            if (k == null) null else if (k.startsWith("viz_")) "sfx$k" else if (k.startsWith("fx_")) "s$k" else k
+        }
+        sCached = n
+        sBase = base
+        return n
+    }
+
+    fun style(p: SharedPreferences): String {
+        val s = p.getString("viz_style", "fireflies") ?: "fireflies"
+        return if (s in KEYS) s else "fireflies"
+    }
+
+    /** First run: a moved style that was selected in the music list carries over, and colors start as a gradient. */
+    fun init(base: SharedPreferences) {
+        if (base.getBoolean("fx_init", false)) return
+        val ed = base.edit()
+        val s = base.getString("viz_style", null)
+        val ss = base.getString("sviz_style", null)
+        if (s != null && s in KEYS) {
+            ed.putString("fxviz_style", s)
+            ed.putString("viz_style", "spectrum")
+            if (base.getBoolean("mode_viz", false)) ed.putBoolean("fx_on", true)
+        }
+        if (ss != null && ss in KEYS) ed.putString("sviz_style", "spectrum")
+        if (!base.contains("fxviz_color_src")) ed.putString("fxviz_color_src", "gradient")
+        ed.putBoolean("fx_init", true).apply()
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiGoogleSuggest.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiGoogleSuggest.kt
new file mode 100644
index 000000000..9ffc72338
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiGoogleSuggest.kt
@@ -0,0 +1,400 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.NetworkCapabilities
+import android.os.Handler
+import android.os.Looper
+import android.text.InputType
+import android.widget.Toast
+import org.futo.inputmethod.latin.R
+import org.futo.inputmethod.latin.uix.PreferenceUtils
+import android.view.inputmethod.EditorInfo
+import org.futo.inputmethod.latin.InputAttributes
+import org.json.JSONArray
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+import java.util.concurrent.Executors
+
+/**
+ * Google suggestions, network layer (batch 13C-2). Nothing here touches the suggestion bar yet;
+ * 13C-3 calls request(). Only the typed word plus the optional context words are ever sent.
+ * Never used in password, email, URL, number or incognito fields, nor in Performance mode.
+ */
+object RasiGoogleSuggest {
+    private const val CACHE_MAX = 200
+    private const val CACHE_TTL_MS = 6L * 60L * 60L * 1000L
+    private const val FAIL_PAUSE_MS = 60_000L
+    private const val FAIL_LIMIT = 3
+
+    private class Entry(val at: Long, val words: List<String>)
+
+    private val cache = object : LinkedHashMap<String, Entry>(64, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, Entry>?): Boolean = size > CACHE_MAX
+    }
+    private val exec = Executors.newSingleThreadExecutor()
+    private val main = Handler(Looper.getMainLooper())
+
+    // Level 2: is this word real? Only the one typed word is sent, nothing else.
+    private class Verdict(val at: Long, val known: Boolean, val matches: Int = if (known) 99 else 1)
+    private const val VERDICT_TTL_MS = 24L * 60L * 60L * 1000L
+    private val verdicts = object : LinkedHashMap<String, Verdict>(64, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, Verdict>?): Boolean = size > 1000
+    }
+    @Volatile private var checkOn = false
+    private var checkTask: Runnable? = null
+    @Volatile private var lastFallbackLog = 0L
+    @Volatile private var ctxRef: Context? = null
+    @Volatile private var blockedNow = true
+    @Volatile private var glideOn = false
+
+    @Volatile private var generation = 0
+    @Volatile private var failures = 0
+    @Volatile private var pausedUntil = 0L
+    private var pendingTask: Runnable? = null
+
+    /** True when this text field must never be sent anywhere. */
+    @JvmStatic
+    fun isBlockedField(info: EditorInfo?): Boolean {
+        if (info == null) return true
+        if ((info.imeOptions and EditorInfo.IME_FLAG_NO_PERSONALIZED_LEARNING) != 0) return true
+        val cls = info.inputType and InputType.TYPE_MASK_CLASS
+        val variation = info.inputType and InputType.TYPE_MASK_VARIATION
+        if (cls != InputType.TYPE_CLASS_TEXT) return true
+        return when (variation) {
+            InputType.TYPE_TEXT_VARIATION_PASSWORD,
+            InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD,
+            InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD,
+            InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS,
+            InputType.TYPE_TEXT_VARIATION_WEB_EMAIL_ADDRESS,
+            InputType.TYPE_TEXT_VARIATION_URI -> true
+            else -> false
+        }
+    }
+
+    /** Same rule using the keyboard's own field attributes. */
+    @JvmStatic
+    fun isBlockedAttrs(a: InputAttributes): Boolean =
+        a.mNoLearning || a.mIsPasswordField || a.mIsEmailField || a.mIsUriField ||
+            a.mIsCodeField || !a.mIsGeneralTextInput
+
+    private fun networkAllowed(c: Context, wifiOnly: Boolean): Boolean = try {
+        val cm = c.applicationContext.getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager
+        val caps = cm.getNetworkCapabilities(cm.activeNetwork)
+        when {
+            caps == null -> false
+            !caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) -> false
+            wifiOnly -> caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) ||
+                caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)
+            else -> true
+        }
+    } catch (t: Throwable) { false }
+
+    private fun buildQuery(cfg: RasiGoogleSuggestPrefs.Config, context: List<String>, word: String): String {
+        val ctx = if (cfg.useContext) context.takeLast(cfg.contextWords) else emptyList()
+        return (ctx + word).joinToString(" ").trim()
+    }
+
+    private fun fetch(query: String): List<String>? = try {
+        val url = "https://suggestqueries.google.com/complete/search?client=firefox&q=" +
+            URLEncoder.encode(query, "UTF-8")
+        val conn = URL(url).openConnection() as HttpURLConnection
+        try {
+            conn.connectTimeout = 3000
+            conn.readTimeout = 3000
+            conn.setRequestProperty("User-Agent", "RasiKeyboard")
+            if (conn.responseCode != 200) {
+                RasiLog.net("RasiGoogle", "suggestion service answered HTTP " + conn.responseCode)
+                null
+            }
+            else {
+                val root = JSONArray(conn.inputStream.bufferedReader().use { it.readText() })
+                val arr = root.getJSONArray(1)
+                (0 until arr.length()).map { arr.getString(it) }
+            }
+        } finally { conn.disconnect() }
+    } catch (t: Throwable) {
+        RasiLog.net("RasiGoogle", "suggestion request failed: " + t)
+        null
+    }
+
+    /** Words after the context part, e.g. query "see you to" + result "see you tomorrow" -> "tomorrow". */
+    private fun lastWords(results: List<String>, query: String, word: String, max: Int): List<String> {
+        val skip = query.trim().split(' ').size - 1
+        val out = LinkedHashSet<String>()
+        for (r in results) {
+            val parts = r.trim().split(' ')
+            if (parts.size <= skip) continue
+            val w = parts[skip].lowercase()
+            if (w.length >= word.length && w.startsWith(word.lowercase()) && w != word.lowercase()) out.add(w)
+            if (out.size >= max) break
+        }
+        return out.toList()
+    }
+
+    /** Words that follow [ctx] in the search results, e.g. ctx "see you" + result "see you tomorrow" -> "tomorrow". */
+    private fun nextWordsOf(results: List<String>, ctx: List<String>, max: Int): List<String> {
+        val out = LinkedHashSet<String>()
+        val low = ctx.map { it.lowercase() }
+        for (r in results) {
+            val parts = r.trim().lowercase().split(' ')
+            if (parts.size <= low.size || parts.take(low.size) != low) continue
+            val w = parts[low.size]
+            if (w.length in 1..20 && w.all { it.isLetter() || it == '\'' }) out.add(w)
+            if (out.size >= max) break
+        }
+        return out.toList()
+    }
+
+    /**
+     * Level 3. Next-word guesses: sends the last sentence (up to the set number of words) to Google and
+     * returns the words that usually come next. Calls [onResult] on the main thread if still current.
+     */
+    fun requestNext(c: Context, blocked: Boolean, sentence: List<String>, onResult: (List<String>) -> Unit): Boolean {
+        val cfg = RasiGoogleSuggestPrefs.load(c)
+        if (!cfg.nextEnabled || blocked) return false
+        val ctx = sentence.takeLast(cfg.sentenceWords)
+        if (ctx.isEmpty()) return false
+        if (System.currentTimeMillis() < pausedUntil) return false
+        val query = ctx.joinToString(" ") + " "
+        val key = "n:" + query.lowercase()
+        synchronized(cache) {
+            val hit = cache[key]
+            if (hit != null && System.currentTimeMillis() - hit.at < CACHE_TTL_MS) {
+                val words = nextWordsOf(hit.words, ctx, cfg.nextResults)
+                main.post { onResult(words) }
+                return true
+            }
+        }
+        if (!networkAllowed(c, cfg.wifiOnly)) { fallbackLog("next-word help skipped, no usable network: using on-device guesses only"); return false }
+        noticeOnce(c, RasiGoogleSuggestPrefs.KEY_NOTICE3_SEEN, R.string.rasi_gs_first_notice3)
+        cancel()
+        val gen = generation
+        val task = Runnable {
+            if (gen != generation) return@Runnable
+            exec.execute {
+                if (gen != generation) return@execute
+                val res = fetch(query)
+                if (res == null) {
+                    if (++failures >= FAIL_LIMIT) { pausedUntil = System.currentTimeMillis() + FAIL_PAUSE_MS; failures = 0 }
+                    fallbackLog("next-word request failed: using on-device guesses only")
+                    return@execute
+                }
+                failures = 0
+                synchronized(cache) { cache[key] = Entry(System.currentTimeMillis(), res) }
+                if (gen != generation) return@execute
+                val words = nextWordsOf(res, ctx, cfg.nextResults)
+                main.post { if (gen == generation) onResult(words) }
+            }
+        }
+        pendingTask = task
+        main.postDelayed(task, cfg.delayMs)
+        return true
+    }
+
+    @JvmStatic
+    fun cancel() {
+        generation++
+        pendingTask?.let { main.removeCallbacks(it) }
+        pendingTask = null
+    }
+
+    @JvmStatic
+    fun cancelCheck() {
+        checkTask?.let { main.removeCallbacks(it) }
+        checkTask = null
+    }
+
+    /** Cheap, no network: true when Google already confirmed [word] is a real word. */
+    @JvmStatic
+    fun isKnownWord(word: String?, inDictionary: Boolean): Boolean {
+        if (!checkOn || word.isNullOrEmpty() || inDictionary) return false
+        synchronized(verdicts) {
+            val v = verdicts[word.lowercase()] ?: return false
+            return v.known && System.currentTimeMillis() - v.at < VERDICT_TTL_MS
+        }
+    }
+
+    /** Called by the keyboard whenever suggestions change, so the glide code (which has no Context) can reach the settings. */
+    @JvmStatic
+    fun attach(c: Context, blocked: Boolean) {
+        ctxRef = c.applicationContext
+        blockedNow = blocked
+        glideOn = try { RasiGoogleSuggestPrefs.load(c).glideChecks } catch (t: Throwable) { false }
+    }
+
+    /**
+     * Glide typing: moves candidates that Google already confirmed as real words up, and candidates it
+     * clearly does not know down. Uses only answers already remembered, so the swipe is never delayed.
+     */
+    @JvmStatic
+    fun glideReorder(list: ArrayList<org.futo.inputmethod.latin.SuggestedWords.SuggestedWordInfo>) {
+        val c = ctxRef ?: return
+        if (!glideOn || list.size < 2) return
+        val spots = try { RasiGoogleSuggestPrefs.load(c).glideSpots } catch (t: Throwable) { return }
+        val now = System.currentTimeMillis()
+        val keyed = list.mapIndexed { i, info ->
+            var k = i.toDouble()
+            val v = synchronized(verdicts) { verdicts[info.mWord.lowercase()] }
+            if (v != null && now - v.at < VERDICT_TTL_MS) {
+                if (v.known) k -= spots
+                else if (v.matches == 0 && info.mSourceDict?.mDictType != org.futo.inputmethod.latin.Dictionary.TYPE_USER_HISTORY) k += spots
+            }
+            Triple(k, i, info)
+        }.sortedWith(compareBy({ it.first }, { it.second }))
+        list.clear()
+        for (t in keyed) list.add(t.third)
+    }
+
+    /** After a finished swipe: asks Google about the top candidates that are not remembered yet. Words only. */
+    @JvmStatic
+    fun prefetchGlide(words: List<String>) {
+        val c = ctxRef ?: return
+        val cfg = try { RasiGoogleSuggestPrefs.load(c) } catch (t: Throwable) { return }
+        if (!cfg.glideChecks || blockedNow) return
+        if (System.currentTimeMillis() < pausedUntil) return
+        val now = System.currentTimeMillis()
+        val todo = words.map { it.lowercase() }
+            .filter { w -> w.length >= 3 && w.length <= 30 && w.all { it.isLetter() || it == '\'' } }
+            .distinct().take(cfg.glideCount)
+            .filter { w -> synchronized(verdicts) { val v = verdicts[w]; v == null || now - v.at >= VERDICT_TTL_MS } }
+        if (todo.isEmpty()) return
+        exec.execute {
+            if (!networkAllowed(c, cfg.wifiOnly)) {
+                fallbackLog("glide check skipped, no usable network: using on-device swipe ranking only")
+                return@execute
+            }
+            noticeOnce(c, RasiGoogleSuggestPrefs.KEY_NOTICE4_SEEN, R.string.rasi_gs_first_notice4)
+            for (w in todo) {
+                val res = fetch(w)
+                if (res == null) {
+                    if (++failures >= FAIL_LIMIT) { pausedUntil = System.currentTimeMillis() + FAIL_PAUSE_MS; failures = 0 }
+                    fallbackLog("glide check failed: using on-device swipe ranking only")
+                    return@execute
+                }
+                failures = 0
+                val matches = res.count { it.trim().lowercase().substringBefore(' ') == w }
+                synchronized(verdicts) { verdicts[w] = Verdict(System.currentTimeMillis(), matches >= cfg.checkMatches, matches) }
+            }
+        }
+    }
+
+    private fun fallbackLog(msg: String) {
+        val now = System.currentTimeMillis()
+        if (now - lastFallbackLog < 60_000L) return
+        lastFallbackLog = now
+        RasiLog.fallback("RasiGoogle", msg)
+    }
+
+    /** Shows what is sent, once, right before the first request ever goes out. */
+    private fun noticeOnce(c: Context, key: String = RasiGoogleSuggestPrefs.KEY_NOTICE_SEEN, text: Int = R.string.rasi_gs_first_notice) {
+        try {
+            val p = PreferenceUtils.getDefaultSharedPreferences(c.applicationContext)
+            if (p.getBoolean(key, false)) return
+            p.edit().putBoolean(key, true).apply()
+            main.post {
+                Toast.makeText(c.applicationContext, text, Toast.LENGTH_LONG).show()
+            }
+        } catch (t: Throwable) { }
+    }
+
+    /**
+     * Level 2. When the dictionary does not know [word], asks Google once (after a short pause) whether
+     * it is a real word. Calls [onKnown] on the main thread if it is. Only the lowercase word is sent.
+     */
+    fun checkWord(c: Context, blocked: Boolean, word: String, inDictionary: Boolean, onKnown: () -> Unit) {
+        val cfg = RasiGoogleSuggestPrefs.load(c)
+        checkOn = cfg.checkWords
+        cancelCheck()
+        if (!cfg.checkWords || blocked || inDictionary) return
+        val key = word.lowercase()
+        if (key.length < 3 || key.length > 30 || !key.all { it.isLetter() || it == '\'' }) return
+        synchronized(verdicts) {
+            val v = verdicts[key]
+            if (v != null && System.currentTimeMillis() - v.at < VERDICT_TTL_MS) {
+                if (v.known) main.post(onKnown)
+                return
+            }
+        }
+        if (System.currentTimeMillis() < pausedUntil) return
+        val task = Runnable {
+            if (!networkAllowed(c, cfg.wifiOnly)) {
+                fallbackLog("word check skipped, no usable network: using on-device learning only")
+                return@Runnable
+            }
+            noticeOnce(c)
+            exec.execute {
+                val res = fetch(key)
+                if (res == null) {
+                    if (++failures >= FAIL_LIMIT) { pausedUntil = System.currentTimeMillis() + FAIL_PAUSE_MS; failures = 0 }
+                    fallbackLog("word check failed: using on-device learning only")
+                    return@execute
+                }
+                failures = 0
+                val matches = res.count { it.trim().lowercase().substringBefore(' ') == key }
+                val known = matches >= cfg.checkMatches
+                synchronized(verdicts) { verdicts[key] = Verdict(System.currentTimeMillis(), known, matches) }
+                if (known) main.post(onKnown)
+            }
+        }
+        checkTask = task
+        main.postDelayed(task, cfg.delayMs + 250L)
+    }
+
+    @JvmStatic
+    fun clearCache() { synchronized(cache) { cache.clear() }; synchronized(verdicts) { verdicts.clear() } }
+
+    /**
+     * Asks for completions of [word] after [contextWords]. Calls [onResult] on the main thread
+     * only if the result is still current. Returns false when nothing will be sent.
+     */
+    fun request(
+        c: Context,
+        blocked: Boolean,
+        contextWords: List<String>,
+        word: String,
+        onResult: (List<String>) -> Unit
+    ): Boolean {
+        val cfg = RasiGoogleSuggestPrefs.load(c)
+        if (!cfg.enabled || blocked) return false
+        if (word.length < cfg.minLetters || word.any { it.isDigit() }) return false
+        if (System.currentTimeMillis() < pausedUntil) return false
+        val query = buildQuery(cfg, contextWords, word)
+        val key = query.lowercase()
+
+        synchronized(cache) {
+            val hit = cache[key]
+            if (hit != null && System.currentTimeMillis() - hit.at < CACHE_TTL_MS) {
+                val words = lastWords(hit.words, query, word, cfg.maxResults)
+                main.post { onResult(words) }
+                return true
+            }
+        }
+        if (!networkAllowed(c, cfg.wifiOnly)) { fallbackLog("suggestions skipped, no usable network: using on-device suggestions only"); return false }
+        noticeOnce(c)
+
+        cancel()
+        val gen = generation
+        val task = Runnable {
+            if (gen != generation) return@Runnable
+            exec.execute {
+                if (gen != generation) return@execute
+                val res = fetch(query)
+                if (res == null) {
+                    if (++failures >= FAIL_LIMIT) { pausedUntil = System.currentTimeMillis() + FAIL_PAUSE_MS; failures = 0 }
+                    fallbackLog("suggestion request failed: using on-device suggestions only")
+                    return@execute
+                }
+                failures = 0
+                synchronized(cache) { cache[key] = Entry(System.currentTimeMillis(), res) }
+                if (gen != generation) return@execute
+                val words = lastWords(res, query, word, cfg.maxResults)
+                main.post { if (gen == generation) onResult(words) }
+            }
+        }
+        pendingTask = task
+        main.postDelayed(task, cfg.delayMs)
+        return true
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiGoogleSuggestPrefs.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiGoogleSuggestPrefs.kt
new file mode 100644
index 000000000..84bfb721b
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiGoogleSuggestPrefs.kt
@@ -0,0 +1,74 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import org.futo.inputmethod.latin.uix.PreferenceUtils
+import org.futo.inputmethod.latin.uix.RasiPerf
+
+/**
+ * Settings for Google suggestions (batch 13C). Part 1 only stores the settings; the network layer
+ * (13C-2) and the suggestion bar (13C-3) read them from here. Everything is off while Performance mode is on.
+ */
+object RasiGoogleSuggestPrefs {
+    const val KEY_ENABLED = "rasi_gs_enabled"
+    const val KEY_CONTEXT = "rasi_gs_context"
+    const val KEY_CONTEXT_WORDS = "rasi_gs_ctx_words"
+    const val KEY_MIN_LETTERS = "rasi_gs_min_letters"
+    const val KEY_MAX_RESULTS = "rasi_gs_max_results"
+    const val KEY_WEAK_ONLY = "rasi_gs_weak_only"
+    const val KEY_WIFI_ONLY = "rasi_gs_wifi_only"
+    const val KEY_DELAY_MS = "rasi_gs_delay_ms"
+    const val KEY_CHECK = "rasi_gs_check_words"
+    const val KEY_CHECK_MATCHES = "rasi_gs_check_matches"
+    const val KEY_NOTICE_SEEN = "rasi_gs_notice_seen"
+    const val KEY_NEXT = "rasi_gs_next"
+    const val KEY_NEXT_WORDS = "rasi_gs_next_words"
+    const val KEY_NEXT_RESULTS = "rasi_gs_next_results"
+    const val KEY_NOTICE3_SEEN = "rasi_gs_notice3_seen"
+    const val KEY_GLIDE = "rasi_gs_glide"
+    const val KEY_GLIDE_COUNT = "rasi_gs_glide_count"
+    const val KEY_GLIDE_SPOTS = "rasi_gs_glide_spots"
+    const val KEY_NOTICE4_SEEN = "rasi_gs_notice4_seen"
+
+    data class Config(
+        val enabled: Boolean,
+        val useContext: Boolean,
+        val contextWords: Int,
+        val minLetters: Int,
+        val maxResults: Int,
+        val onlyWhenWeak: Boolean,
+        val wifiOnly: Boolean,
+        val delayMs: Long,
+        val checkWords: Boolean,
+        val checkMatches: Int,
+        val nextEnabled: Boolean,
+        val sentenceWords: Int,
+        val nextResults: Int,
+        val glideChecks: Boolean,
+        val glideCount: Int,
+        val glideSpots: Int
+    )
+
+    @JvmStatic
+    fun load(context: Context): Config {
+        val p = PreferenceUtils.getDefaultSharedPreferences(context.applicationContext)
+        val on = p.getBoolean(KEY_ENABLED, true) && !RasiPerf.isOn()
+        return Config(
+            enabled = on,
+            useContext = p.getBoolean(KEY_CONTEXT, true),
+            contextWords = p.getInt(KEY_CONTEXT_WORDS, 2).coerceIn(1, 2),
+            minLetters = p.getInt(KEY_MIN_LETTERS, 2).coerceIn(1, 5),
+            maxResults = p.getInt(KEY_MAX_RESULTS, 2).coerceIn(1, 3),
+            onlyWhenWeak = p.getBoolean(KEY_WEAK_ONLY, true),
+            wifiOnly = p.getBoolean(KEY_WIFI_ONLY, false),
+            delayMs = p.getInt(KEY_DELAY_MS, 150).coerceIn(50, 500).toLong(),
+            checkWords = p.getBoolean(KEY_CHECK, true) && !RasiPerf.isOn(),
+            checkMatches = p.getInt(KEY_CHECK_MATCHES, 4).coerceIn(2, 8),
+            nextEnabled = p.getBoolean(KEY_NEXT, true) && !RasiPerf.isOn(),
+            sentenceWords = p.getInt(KEY_NEXT_WORDS, 8).coerceIn(3, 12),
+            nextResults = p.getInt(KEY_NEXT_RESULTS, 2).coerceIn(1, 3),
+            glideChecks = p.getBoolean(KEY_GLIDE, true) && !RasiPerf.isOn(),
+            glideCount = p.getInt(KEY_GLIDE_COUNT, 4).coerceIn(2, 5),
+            glideSpots = p.getInt(KEY_GLIDE_SPOTS, 2).coerceIn(1, 4)
+        )
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiGroupChat.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiGroupChat.kt
new file mode 100644
index 000000000..e14eb6d61
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiGroupChat.kt
@@ -0,0 +1,194 @@
+package org.futo.inputmethod.latin.rasi
+
+import androidx.compose.runtime.mutableStateOf
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.DocumentSnapshot
+import com.google.firebase.firestore.FieldValue
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.Query
+
+/**
+ * Group chat, text only (Firebase, uses the internet). Free quota care: channels are read once, one live listener on the
+ * last N messages and one on the channel doc only while a channel screen is open.
+ *   groups/{gid}/channels/{cid}                 {name, createdAt, createdBy, lastMessage, lastFrom, lastAt, typing{uid:Long}, pins{messageId:text}}
+ *   groups/{gid}/channels/{cid}/messages/{id}   {from, text, createdAt, replyTo, replyText, replyFrom, editedAt, reactions{uid:emoji}}
+ * Every group gets a channel called "general" (created by the owner). The owner and admins can add channels.
+ */
+object RasiGroupChat {
+    class Channel(val id: String, val name: String, val lastMessage: String, val lastFrom: String, val lastAt: Long)
+
+    val channels = mutableStateOf<List<Channel>>(emptyList())
+    val messages = mutableStateOf<List<RasiChats.Msg>>(emptyList())
+    val pins = mutableStateOf<Map<String, String>>(emptyMap())
+    /** uid -> last typing time of the OTHER members in the open channel. */
+    val typing = mutableStateOf<Map<String, Long>>(emptyMap())
+    val channelName = mutableStateOf("")
+    val busy = mutableStateOf(false)
+    val message = mutableStateOf("")
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun me(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+    private fun chRef(d: FirebaseFirestore, gid: String, cid: String) =
+        d.collection("groups").document(gid).collection("channels").document(cid)
+
+    private fun fail(t: Throwable?, what: String): String {
+        RasiLog.fallback("RasiGroupChat", what + ": " + (t?.javaClass?.simpleName ?: "unknown"))
+        val text = generateSequence(t) { it.cause }.take(5).joinToString(" ") { it.message ?: "" }
+        return if (text.contains("PERMISSION_DENIED")) "The server refused this. The new Firestore rules may not be published yet, or you are not allowed to do this in the group"
+        else "Could not reach the server. Check your internet and try again"
+    }
+
+    private fun parse(m: DocumentSnapshot): RasiChats.Msg? {
+        val t = m.getString("text") ?: return null
+        return RasiChats.Msg(m.id, m.getString("from") ?: "", t, m.getLong("createdAt") ?: 0L, m.getString("replyTo") ?: "", m.getString("replyText") ?: "",
+            m.getLong("editedAt") ?: 0L, false, m.getString("replyFrom") ?: "",
+            (m.get("reactions") as? Map<*, *>)?.entries?.mapNotNull { e -> val k = e.key as? String; val v = e.value as? String; if (k != null && v != null) k to v else null }?.toMap() ?: emptyMap())
+    }
+
+    /** Reads the channels once. The owner's first read also creates "general" when the group has no channel yet. */
+    fun loadChannels(gid: String, isOwner: Boolean) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true
+        d.collection("groups").document(gid).collection("channels").get().addOnCompleteListener { t ->
+            val s = t.result
+            if (!t.isSuccessful || s == null) { busy.value = false; message.value = fail(t.exception, "Load channels"); return@addOnCompleteListener }
+            if (s.isEmpty && isOwner) {
+                chRef(d, gid, "general").set(hashMapOf<String, Any>("name" to "general", "createdAt" to System.currentTimeMillis(), "createdBy" to id))
+                    .addOnCompleteListener { t2 ->
+                        busy.value = false
+                        if (t2.isSuccessful) channels.value = listOf(Channel("general", "general", "", "", 0L)) else message.value = fail(t2.exception, "Create general")
+                    }
+                return@addOnCompleteListener
+            }
+            busy.value = false
+            channels.value = s.documents.map {
+                Channel(it.id, it.getString("name") ?: it.id, it.getString("lastMessage") ?: "", it.getString("lastFrom") ?: "", it.getLong("lastAt") ?: 0L)
+            }.sortedWith(compareBy<Channel>({ if (it.id == "general") 0 else 1 }, { it.name.lowercase() }))
+        }
+    }
+
+    fun createChannel(gid: String, name: String, isOwner: Boolean) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val n = name.trim().take(30)
+        if (n.isEmpty()) { message.value = "Write a channel name first"; return }
+        val cid = java.util.UUID.randomUUID().toString().replace("-", "").take(10)
+        chRef(d, gid, cid).set(hashMapOf<String, Any>("name" to n, "createdAt" to System.currentTimeMillis(), "createdBy" to id)).addOnCompleteListener { t ->
+            if (t.isSuccessful) loadChannels(gid, isOwner) else message.value = fail(t.exception, "Create channel")
+        }
+    }
+
+    fun renameChannel(gid: String, cid: String, name: String, isOwner: Boolean) {
+        val d = db() ?: return
+        val n = name.trim().take(30)
+        if (n.isEmpty()) { message.value = "Write a channel name first"; return }
+        chRef(d, gid, cid).update("name", n).addOnCompleteListener { t ->
+            if (t.isSuccessful) loadChannels(gid, isOwner) else message.value = fail(t.exception, "Rename channel")
+        }
+    }
+
+    /** Deletes all messages of a channel (400 at a time), then the channel. [done] gets true when everything is gone. */
+    fun deleteChannel(gid: String, cid: String, done: (Boolean) -> Unit) {
+        val d = db()
+        if (d == null) { done(false); return }
+        val ref = chRef(d, gid, cid)
+        fun step() {
+            ref.collection("messages").limit(400).get().addOnCompleteListener { t ->
+                val s = t.result
+                if (!t.isSuccessful || s == null) { message.value = fail(t.exception, "Delete channel"); done(false); return@addOnCompleteListener }
+                if (s.isEmpty) {
+                    ref.delete().addOnCompleteListener { t2 -> if (!t2.isSuccessful) message.value = fail(t2.exception, "Delete channel"); done(t2.isSuccessful) }
+                    return@addOnCompleteListener
+                }
+                val b = d.batch()
+                s.documents.forEach { b.delete(it.reference) }
+                b.commit().addOnCompleteListener { t3 -> if (t3.isSuccessful) step() else { message.value = fail(t3.exception, "Delete channel"); done(false) } }
+            }
+        }
+        step()
+    }
+
+    /** Live listener on the last [limit] messages of one channel. Returns a function that stops it. */
+    fun open(gid: String, cid: String, limit: Int): () -> Unit {
+        val d = db() ?: return {}
+        messages.value = emptyList(); message.value = ""
+        val reg = chRef(d, gid, cid).collection("messages").orderBy("createdAt", Query.Direction.DESCENDING).limit(limit.toLong())
+            .addSnapshotListener { s, e ->
+                if (e != null) { message.value = fail(e, "Listen"); return@addSnapshotListener }
+                if (s == null) return@addSnapshotListener
+                messages.value = s.documents.mapNotNull { parse(it) }.reversed()
+            }
+        return { reg.remove(); messages.value = emptyList() }
+    }
+
+    /** Live: typing of the others and the pins of the channel. */
+    fun listenMeta(gid: String, cid: String): () -> Unit {
+        val d = db() ?: return {}
+        val id = me() ?: return {}
+        val reg = chRef(d, gid, cid).addSnapshotListener { s, e ->
+            if (e != null || s == null) return@addSnapshotListener
+            channelName.value = s.getString("name") ?: ""
+            typing.value = (s.get("typing") as? Map<*, *>)?.entries?.mapNotNull { x ->
+                val k = x.key as? String; val v = (x.value as? Number)?.toLong()
+                if (k != null && v != null && k != id) k to v else null
+            }?.toMap() ?: emptyMap()
+            pins.value = (s.get("pins") as? Map<*, *>)?.entries?.mapNotNull { x -> val k = x.key as? String; if (k != null) k to (x.value?.toString() ?: "") else null }?.toMap() ?: emptyMap()
+        }
+        return { reg.remove(); pins.value = emptyMap(); typing.value = emptyMap(); channelName.value = "" }
+    }
+
+    fun send(gid: String, cid: String, text0: String, maxLen: Int = 1000, reply: RasiChats.Msg? = null) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val text = text0.trim().take(maxLen)
+        if (text.isEmpty()) return
+        val now = System.currentTimeMillis()
+        val ref = chRef(d, gid, cid)
+        val b = d.batch()
+        b.update(ref, mapOf<String, Any>("lastMessage" to text.take(100), "lastFrom" to id, "lastAt" to now))
+        val f = hashMapOf<String, Any>("from" to id, "text" to text, "createdAt" to now)
+        if (reply != null) { f["replyTo"] = reply.id; f["replyText"] = reply.text.take(100); f["replyFrom"] = reply.from }
+        b.set(ref.collection("messages").document(), f)
+        b.commit().addOnCompleteListener { t -> message.value = if (t.isSuccessful) "" else fail(t.exception, "Send") }
+    }
+
+    fun edit(gid: String, cid: String, m: RasiChats.Msg, text0: String, maxLen: Int = 1000, isLast: Boolean = false) {
+        val d = db() ?: return
+        val id = me() ?: return
+        if (m.from != id) return
+        val text = text0.trim().take(maxLen)
+        if (text.isEmpty() || text == m.text) return
+        val ref = chRef(d, gid, cid)
+        val b = d.batch()
+        b.update(ref.collection("messages").document(m.id), mapOf<String, Any>("text" to text, "editedAt" to System.currentTimeMillis()))
+        if (isLast) b.update(ref, mapOf<String, Any>("lastMessage" to text.take(100)))
+        b.commit().addOnCompleteListener { t -> if (!t.isSuccessful) message.value = fail(t.exception, "Edit") }
+    }
+
+    fun react(gid: String, cid: String, m: RasiChats.Msg, emoji: String?) {
+        val d = db() ?: return
+        val id = me() ?: return
+        chRef(d, gid, cid).collection("messages").document(m.id).update("reactions." + id, emoji ?: FieldValue.delete())
+            .addOnFailureListener { message.value = fail(it, "React") }
+    }
+
+    fun setPin(gid: String, cid: String, m: RasiChats.Msg, on: Boolean) {
+        val d = db() ?: return
+        chRef(d, gid, cid).update("pins." + m.id, if (on) m.text.take(100) else FieldValue.delete())
+            .addOnFailureListener { message.value = fail(it, "Pin") }
+    }
+
+    fun setTyping(gid: String, cid: String, on: Boolean) {
+        val d = db() ?: return
+        val id = me() ?: return
+        chRef(d, gid, cid).update("typing." + id, if (on) System.currentTimeMillis() else 0L)
+            .addOnFailureListener { RasiLog.fallback("RasiGroupChat", "Typing: " + it.javaClass.simpleName) }
+    }
+
+    /** The sender can delete their message; the group owner and admins can delete any (the rules decide). */
+    fun delete(gid: String, cid: String, m: RasiChats.Msg) {
+        val d = db() ?: return
+        chRef(d, gid, cid).collection("messages").document(m.id).delete().addOnFailureListener { message.value = fail(it, "Delete") }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiGroups.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiGroups.kt
new file mode 100644
index 000000000..39d25b983
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiGroups.kt
@@ -0,0 +1,306 @@
+package org.futo.inputmethod.latin.rasi
+
+import androidx.compose.runtime.mutableStateOf
+import android.content.Context
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FieldValue
+import com.google.firebase.firestore.FirebaseFirestore
+
+/**
+ * Groups, part 1 (Firebase, uses the internet, text only, everything is read once and on Refresh, no live listeners).
+ *   groups/{gid}                  {owner, name, createdAt, access = "code" | "invite", theme{mode,cA,cB,bg1,bg2,radius,style,by,at}}   gid = 8 letters or digits
+ *   groups/{gid}/members/{uid}    {username, name, avatar, avatarColor, joinedAt, role = "owner" | "admin" | "member"}
+ *   users/{uid}/groups/{gid}      {name, joinedAt}      my own list of groups
+ *   users/{uid}/invites/{gid}     {name, from, fromName, at}   written by a friend who is in the group
+ */
+object RasiGroups {
+    class Mine(val id: String, val name: String, val joinedAt: Long)
+    class Group(val id: String, val name: String, val owner: String, val access: String, val theme: RasiChats.Theme? = null)
+    class Member(val uid: String, val username: String, val name: String, val avatar: String, val avatarColor: Int, val role: String)
+    class Invite(val gid: String, val name: String, val from: String, val fromName: String, val at: Long)
+
+    val mine = mutableStateOf<List<Mine>>(emptyList())
+    val invites = mutableStateOf<List<Invite>>(emptyList())
+    val current = mutableStateOf<Group?>(null)
+    val members = mutableStateOf<List<Member>>(emptyList())
+    val busy = mutableStateOf(false)
+    val message = mutableStateOf("")
+    private var loadedAt = 0L
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun me(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+
+    private fun fail(t: Throwable?, what: String): String {
+        RasiLog.fallback("RasiGroups", what + ": " + (t?.javaClass?.simpleName ?: "unknown"))
+        val text = generateSequence(t) { it.cause }.take(5).joinToString(" ") { it.message ?: "" }
+        return if (text.contains("PERMISSION_DENIED")) "The server refused this. The new Firestore rules may not be published yet, or the group is invite only"
+        else "Could not reach the server. Check your internet and try again"
+    }
+
+    private fun randomId(): String {
+        val abc = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+        val r = java.security.SecureRandom()
+        return (1..8).map { abc[r.nextInt(abc.length)] }.joinToString("")
+    }
+
+    /** Reads my groups and my invites once. Skipped when the last load is under 30 seconds old, unless forced. */
+    fun load(c: Context, force: Boolean = false) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val now = System.currentTimeMillis()
+        if (!force && now - loadedAt < 30000L) return
+        loadedAt = now
+        d.collection("users").document(id).collection("groups").get().addOnSuccessListener { q ->
+            mine.value = q.documents.map { Mine(it.id, it.getString("name") ?: "", it.getLong("joinedAt") ?: 0L) }.sortedBy { it.name.lowercase() }
+        }.addOnFailureListener { message.value = fail(it, "Load groups") }
+        d.collection("users").document(id).collection("invites").get().addOnSuccessListener { q ->
+            invites.value = q.documents.map {
+                Invite(it.id, it.getString("name") ?: "", it.getString("from") ?: "", it.getString("fromName") ?: "", it.getLong("at") ?: 0L)
+            }.sortedByDescending { it.at }
+        }.addOnFailureListener { message.value = fail(it, "Load invites") }
+    }
+
+    fun create(c: Context, name: String, access: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        busy.value = true; message.value = ""
+        val gid = randomId()
+        val gname = name.trim().take(30).ifBlank { "My group" }
+        val map = hashMapOf<String, Any>("owner" to id, "name" to gname, "createdAt" to System.currentTimeMillis(),
+            "access" to (if (access == "invite") "invite" else "code"))
+        d.collection("groups").document(gid).set(map).addOnCompleteListener { t ->
+            if (!t.isSuccessful) { busy.value = false; message.value = fail(t.exception, "Create group"); return@addOnCompleteListener }
+            addSelf(c, gid, gname, "owner") { ok -> if (ok) open(c, gid) else busy.value = false }
+        }
+    }
+
+    private fun addSelf(c: Context, gid: String, gname: String, role: String, done: (Boolean) -> Unit) {
+        val d = db(); val id = me()
+        if (d == null || id == null) { done(false); return }
+        val p = RasiAccount.profile.value
+        val now = System.currentTimeMillis()
+        val m = hashMapOf<String, Any>("username" to (p?.username ?: ""), "name" to (p?.name ?: "").take(30), "avatar" to (p?.avatar ?: "").take(8),
+            "avatarColor" to ((p?.avatarColor ?: 0).toLong() and 0xFFFFFFFFL), "joinedAt" to now, "role" to role)
+        d.collection("groups").document(gid).collection("members").document(id).set(m).addOnCompleteListener { t ->
+            if (!t.isSuccessful) { message.value = fail(t.exception, "Join group"); done(false); return@addOnCompleteListener }
+            d.collection("users").document(id).collection("groups").document(gid)
+                .set(hashMapOf<String, Any>("name" to gname, "joinedAt" to now)).addOnCompleteListener { t2 ->
+                    if (!t2.isSuccessful) message.value = fail(t2.exception, "Save group")
+                    load(c, true)
+                    done(true)
+                }
+        }
+    }
+
+    fun join(c: Context, code: String) {
+        val d = db() ?: return
+        val gid = code.trim().uppercase()
+        if (gid.length != 8) { message.value = "A group code has 8 letters or digits"; return }
+        busy.value = true; message.value = ""
+        d.collection("groups").document(gid).get().addOnSuccessListener { s ->
+            if (!s.exists()) { busy.value = false; message.value = "No group with that code"; return@addOnSuccessListener }
+            val gname = s.getString("name") ?: ""
+            val invited = invites.value.any { it.gid == gid }
+            if ((s.getString("access") ?: "code") == "invite" && !invited) {
+                busy.value = false; message.value = "This group is invite only. Ask a member to invite you"; return@addOnSuccessListener
+            }
+            addSelf(c, gid, gname, "member") { ok ->
+                if (ok) { removeInvite(gid); open(c, gid) } else busy.value = false
+            }
+        }.addOnFailureListener { busy.value = false; message.value = fail(it, "Find group") }
+    }
+
+    fun accept(c: Context, inv: Invite) = join(c, inv.gid)
+
+    fun removeInvite(gid: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        d.collection("users").document(id).collection("invites").document(gid).delete()
+        invites.value = invites.value.filter { it.gid != gid }
+    }
+
+    /** Opens a group page: reads the group and its members once. */
+    fun open(c: Context, gid: String) {
+        val d = db() ?: return
+        busy.value = true
+        d.collection("groups").document(gid).get().addOnSuccessListener { s ->
+            if (!s.exists()) {
+                busy.value = false; message.value = "This group does not exist any more"
+                val id = me()
+                if (id != null) d.collection("users").document(id).collection("groups").document(gid).delete()
+                mine.value = mine.value.filter { it.id != gid }
+                return@addOnSuccessListener
+            }
+            val th = (s.get("theme") as? Map<*, *>)?.let { t ->
+                fun n(k: String): Int = ((t[k] as? Number)?.toLong() ?: 0L).toInt()
+                RasiChats.Theme(t["mode"] as? String ?: "off", n("cA"), n("cB"), n("bg1"), n("bg2"), (t["radius"] as? Number)?.toInt() ?: 18, n("style"), t["by"] as? String ?: "")
+            }
+            val g = Group(gid, s.getString("name") ?: "", s.getString("owner") ?: "", s.getString("access") ?: "code", th)
+            val id = me()
+            if (id == null) { busy.value = false; return@addOnSuccessListener }
+            d.collection("groups").document(gid).collection("members").document(id).get().addOnSuccessListener { mm ->
+                if (!mm.exists()) {
+                    busy.value = false; message.value = "You are not in this group any more"
+                    d.collection("users").document(id).collection("groups").document(gid).delete()
+                    mine.value = mine.value.filter { it.id != gid }
+                } else { current.value = g; loadMembers() }
+            }.addOnFailureListener { busy.value = false; message.value = fail(it, "Open group") }
+        }.addOnFailureListener { busy.value = false; message.value = fail(it, "Open group") }
+    }
+
+    fun loadMembers() {
+        val d = db() ?: return
+        val g = current.value ?: return
+        busy.value = true
+        d.collection("groups").document(g.id).collection("members").get().addOnSuccessListener { q ->
+            members.value = q.documents.map {
+                Member(it.id, it.getString("username") ?: "", it.getString("name") ?: "", it.getString("avatar") ?: "",
+                    (it.getLong("avatarColor") ?: 0L).toInt(), it.getString("role") ?: "member")
+            }.sortedWith(compareBy<Member>({ when (it.role) { "owner" -> 0; "admin" -> 1; else -> 2 } }, { it.username.lowercase() }))
+            busy.value = false
+        }.addOnFailureListener { busy.value = false; message.value = fail(it, "Load members") }
+    }
+
+    fun close() { current.value = null; members.value = emptyList() }
+
+    fun invite(friendUid: String, friendName: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val g = current.value ?: return
+        val p = RasiAccount.profile.value
+        val map = hashMapOf<String, Any>("name" to g.name.take(30), "from" to id,
+            "fromName" to (p?.username ?: "").take(30), "at" to System.currentTimeMillis())
+        d.collection("users").document(friendUid).collection("invites").document(g.id).set(map).addOnCompleteListener { t ->
+            message.value = if (t.isSuccessful) "Invite sent to $friendName" else fail(t.exception, "Invite")
+        }
+    }
+
+    fun leave(c: Context) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val g = current.value ?: return
+        if (g.owner == id) { message.value = "The owner cannot leave. Hand the group to another member first, or delete it"; return }
+        busy.value = true
+        d.collection("groups").document(g.id).collection("members").document(id).delete().addOnCompleteListener { t ->
+            if (!t.isSuccessful) { busy.value = false; message.value = fail(t.exception, "Leave group"); return@addOnCompleteListener }
+            d.collection("users").document(id).collection("groups").document(g.id).delete().addOnCompleteListener {
+                busy.value = false
+                mine.value = mine.value.filter { it.id != g.id }
+                close()
+            }
+        }
+    }
+
+    /** Owner: sets a member to admin or member. */
+    fun setRole(uid: String, role: String) {
+        val d = db() ?: return
+        val g = current.value ?: return
+        if (role != "admin" && role != "member") return
+        d.collection("groups").document(g.id).collection("members").document(uid).update("role", role).addOnCompleteListener { t ->
+            if (t.isSuccessful) loadMembers() else message.value = fail(t.exception, "Change role")
+        }
+    }
+
+    /** Owner and admins: removes a member (admins can only remove plain members). */
+    fun kick(uid: String) {
+        val d = db() ?: return
+        val g = current.value ?: return
+        d.collection("groups").document(g.id).collection("members").document(uid).delete().addOnCompleteListener { t ->
+            if (t.isSuccessful) { message.value = "Member removed"; loadMembers() } else message.value = fail(t.exception, "Remove member")
+        }
+    }
+
+    /** Owner: hands the group to another member. You become an admin. One atomic batch. */
+    fun transfer(c: Context, newOwner: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val g = current.value ?: return
+        if (g.owner != id || newOwner == id) return
+        val gr = d.collection("groups").document(g.id)
+        val b = d.batch()
+        b.update(gr, "owner", newOwner)
+        b.update(gr.collection("members").document(newOwner), "role", "owner")
+        b.update(gr.collection("members").document(id), "role", "admin")
+        busy.value = true
+        b.commit().addOnCompleteListener { t ->
+            busy.value = false
+            if (t.isSuccessful) { message.value = "Group handed over"; open(c, g.id) } else message.value = fail(t.exception, "Hand over")
+        }
+    }
+
+    /** Owner: renames the group and sets who can join. */
+    fun update(name: String, access: String) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val g = current.value ?: return
+        val n = name.trim().take(30)
+        if (n.isEmpty()) { message.value = "Write a group name first"; return }
+        val a = if (access == "invite") "invite" else "code"
+        d.collection("groups").document(g.id).update(mapOf<String, Any>("name" to n, "access" to a)).addOnCompleteListener { t ->
+            if (!t.isSuccessful) { message.value = fail(t.exception, "Save group"); return@addOnCompleteListener }
+            current.value = Group(g.id, n, g.owner, a, g.theme)
+            d.collection("users").document(id).collection("groups").document(g.id).update("name", n)
+            mine.value = mine.value.map { if (it.id == g.id) Mine(it.id, n, it.joinedAt) else it }
+            message.value = "Saved"
+        }
+    }
+
+    /** Owner and admins: saves the group theme, or removes it (null). */
+    fun setTheme(t: RasiChats.Theme?) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val g = current.value ?: return
+        fun u(c: Int): Long = c.toLong() and 0xFFFFFFFFL
+        val value: Any = if (t == null) FieldValue.delete() else hashMapOf<String, Any>(
+            "mode" to t.mode, "cA" to u(t.cA), "cB" to u(t.cB), "bg1" to u(t.bg1), "bg2" to u(t.bg2),
+            "radius" to t.radius.coerceIn(0, 30).toLong(), "style" to t.style.coerceIn(0, 2).toLong(), "by" to id, "at" to System.currentTimeMillis()
+        )
+        d.collection("groups").document(g.id).update("theme", value).addOnCompleteListener { r ->
+            if (r.isSuccessful) current.value = Group(g.id, g.name, g.owner, g.access, if (t == null) null else RasiChats.Theme(t.mode, t.cA, t.cB, t.bg1, t.bg2, t.radius, t.style, id))
+            else message.value = fail(r.exception, "Save theme")
+        }
+    }
+
+    /** Owner: deletes the whole group (messages, channels, members). Runs in steps and may take a moment. */
+    fun deleteGroup(c: Context) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val g = current.value ?: return
+        if (g.owner != id) return
+        busy.value = true; message.value = "Deleting the group..."
+        val gr = d.collection("groups").document(g.id)
+        fun finish() {
+            gr.delete().addOnCompleteListener {
+                d.collection("users").document(id).collection("groups").document(g.id).delete()
+                mine.value = mine.value.filter { it.id != g.id }
+                busy.value = false; message.value = "Group deleted"; close()
+            }
+        }
+        fun members() {
+            gr.collection("members").get().addOnCompleteListener { t ->
+                val s = t.result
+                if (!t.isSuccessful || s == null) { busy.value = false; message.value = fail(t.exception, "Delete group"); return@addOnCompleteListener }
+                val b = d.batch()
+                s.documents.filter { it.id != id }.forEach { b.delete(it.reference) }
+                b.commit().addOnCompleteListener { t2 ->
+                    if (!t2.isSuccessful) { busy.value = false; message.value = fail(t2.exception, "Delete group"); return@addOnCompleteListener }
+                    gr.collection("members").document(id).delete().addOnCompleteListener { finish() }
+                }
+            }
+        }
+        gr.collection("channels").get().addOnCompleteListener { t ->
+            val s = t.result
+            if (!t.isSuccessful || s == null) { busy.value = false; message.value = fail(t.exception, "Delete group"); return@addOnCompleteListener }
+            val ids = s.documents.map { it.id }
+            fun next(i: Int) {
+                if (i >= ids.size) { members(); return }
+                RasiGroupChat.deleteChannel(g.id, ids[i]) { ok ->
+                    if (ok) next(i + 1) else { busy.value = false; message.value = "Could not delete everything. Try again" }
+                }
+            }
+            next(0)
+        }
+    }
+
+    fun localReset() { mine.value = emptyList(); invites.value = emptyList(); current.value = null; members.value = emptyList(); message.value = ""; loadedAt = 0L }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiLearn.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiLearn.kt
