@@ -0,0 +1,188 @@
+package org.futo.inputmethod.latin.uix.settings.pages
+
+import android.content.SharedPreferences
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Switch
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import androidx.navigation.NavHostController
+import androidx.navigation.compose.rememberNavController
+import org.futo.inputmethod.latin.rasi.RasiBorderGlow
+import org.futo.inputmethod.latin.rasi.RasiNowPlaying
+import org.futo.inputmethod.latin.uix.settings.ScreenTitle
+
+private val GLOW_SOURCES = listOf(
+    "global" to "Same as the main setting",
+    "beat" to "Beats (kicks and drums)",
+    "bass" to "Bass",
+    "mid" to "Mids",
+    "treble" to "Treble",
+    "loud" to "Overall loudness",
+    "none" to "Nothing (always the same)"
+)
+
+/** One side or corner: on/off and, when Sync is off, its own size, strength, shape and color. */
+@Composable
+private fun GlowElement(prefs: SharedPreferences, id: String, label: String, corner: Boolean, sync: Boolean) {
+    var open by remember { mutableStateOf(false) }
+    var on by remember { mutableStateOf(prefs.getBoolean("gl_" + id + "_on", true)) }
+    Row(
+        Modifier.fillMaxWidth().clickable { open = !open },
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Column(Modifier.weight(1.0f)) {
+            Text(label, style = MaterialTheme.typography.titleSmall)
+            Text(
+                if (open) "Tap to close" else if (sync) "Tap to choose what it reacts to" else "Tap for beat source, size, strength, shape and color",
+                style = MaterialTheme.typography.bodySmall
+            )
+        }
+        Switch(checked = on, onCheckedChange = {
+            on = it; prefs.edit().putBoolean("gl_" + id + "_on", it).apply(); RasiNowPlaying.notifyChanged()
+        })
+    }
+    if (!open || !on) return
+    var src by remember { mutableStateOf(prefs.getString("gl_" + id + "_src", "global") ?: "global") }
+    Text("Reacts to", style = MaterialTheme.typography.bodySmall)
+    RasiOptionRows(GLOW_SOURCES, src) {
+        src = it; prefs.edit().putString("gl_" + id + "_src", it).apply(); RasiNowPlaying.notifyChanged()
+    }
+    if (sync) return
+    var shape by remember { mutableStateOf(prefs.getString("gl_" + id + "_shape", "soft") ?: "soft") }
+    var cm by remember { mutableStateOf(prefs.getString("gl_" + id + "_cm", "shared") ?: "shared") }
+    RasiPrefSlider(prefs, "gl_" + id + "_size", "Size", " dp", if (corner) 70 else 28, 4, if (corner) 260 else 140)
+    RasiPrefSlider(prefs, "gl_" + id + "_str", "Strength", " %", 80, 0, 100)
+    if (corner) RasiPrefSlider(prefs, "gl_" + id + "_stretch", "Stretch (100 = round, more = wider, less = taller)", " %", 100, 40, 250)
+    RasiOptionRows(listOf("soft" to "Soft glow", "sharp" to "Sharp band"), shape) {
+        shape = it; prefs.edit().putString("gl_" + id + "_shape", it).apply(); RasiNowPlaying.notifyChanged()
+    }
+    RasiOptionRows(listOf("shared" to "Use the shared colors", "solid" to "Own solid color", "gradient" to "Own gradient"), cm) {
+        cm = it; prefs.edit().putString("gl_" + id + "_cm", it).apply(); RasiNowPlaying.notifyChanged()
+    }
+    if (cm != "shared") RasiColorPick(prefs, "gl_" + id + "_c1", if (cm == "solid") "Color" else "Color 1", 0xFF7CF29C.toInt())
+    if (cm == "gradient") RasiColorPick(prefs, "gl_" + id + "_c2", "Color 2", 0xFF4F8CFF.toInt())
+}
+
+/** Music > Border glow. */
+@Composable
+fun RasiBorderGlowScreen(navController: NavHostController = rememberNavController()) {
+    val context = LocalContext.current
+    val prefs = remember { RasiNowPlaying.prefs(context) }
+
+    RasiScrollableWithKeyboardButton {
+        ScreenTitle("Border glow", showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            RasiGlowBody(prefs, false)
+        }
+    }
+}
+
+/**
+ * All options of the border glow. With settings = true they control the glow behind the settings screens
+ * (prefs is then its own copy of the options).
+ */
+@Composable
+fun RasiGlowBody(prefs: SharedPreferences, settings: Boolean, showToggle: Boolean = true) {
+    Text(
+        if (settings) "One colored glow along the edges of the whole screen behind the settings. It follows the song and has its own options, separate from the keyboard glow. Turned off automatically in Performance mode."
+        else "One colored glow along the sides and corners of the whole keyboard (actions bar, keys and the strip behind the navigation buttons) that follows the song. Turned off automatically in Performance mode.",
+        style = MaterialTheme.typography.bodySmall
+    )
+    if (showToggle) RasiPrefSwitch(prefs, "gl_on", if (settings) "Border glow in the settings" else "Border glow", "Turns the whole glow on or off.", false)
+    RasiPrefSwitch(prefs, "gl_only_play", "Only while a song is playing", "Hides the glow when no music plays.", true)
+
+    var layer by remember { mutableStateOf(if (settings) (prefs.getString("gl_layer", "behind") ?: "behind") else RasiBorderGlow.layerOf(prefs)) }
+    RasiSection("Layer")
+    RasiOptionRows(
+        if (settings) listOf(
+            "behind" to "Behind the settings content",
+            "over" to "Over the settings content (taps still go through)"
+        ) else listOf(
+            "all" to "Over everything (keys, visualizer and suggestion bar)",
+            "over_viz" to "Over the visualizer, under the keys",
+            "under_viz" to "Under the visualizer"
+        ),
+        layer
+    ) { layer = it; prefs.edit().putString("gl_layer", it).apply(); RasiNowPlaying.notifyChanged() }
+
+    RasiSection("Look")
+    RasiPrefSlider(prefs, "gl_opacity", "Overall opacity (brightness of the glow)", " %", if (settings) 60 else 100, 5, 100)
+    RasiPrefSlider(prefs, "gl_inset", "Move the glow inward (negative moves it outside)", " dp", 0, -30, 60)
+    RasiPrefSwitch(prefs, "gl_grad", "Gradient along the edges", "The colors flow around the keyboard. Off = one flat color per glow.", true)
+
+    if (!settings) {
+        RasiSection("Suggestions bar")
+        RasiPrefSlider(prefs, "bar_trans", "Suggestions bar transparency (same setting as in Now playing)", " %", 60, 0, 100)
+        Text("It only applies while a song is playing, so the glow shows through the bar.", style = MaterialTheme.typography.bodySmall)
+    }
+
+    RasiColorSourceSection(prefs, "gl_")
+
+    var bOn by remember { mutableStateOf(prefs.getBoolean("gl_beat_on", true)) }
+    var bSrc by remember { mutableStateOf(prefs.getString("gl_beat_src", "beat") ?: "beat") }
+    RasiSection("Beat reaction")
+    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+        Column(Modifier.weight(1.0f)) {
+            Text("React to the music")
+            Text("The glow gets stronger on the beat. Off = a steady glow.", style = MaterialTheme.typography.bodySmall)
+        }
+        Switch(checked = bOn, onCheckedChange = {
+            bOn = it; prefs.edit().putBoolean("gl_beat_on", it).apply(); RasiNowPlaying.notifyChanged()
+        })
+    }
+    if (bOn) {
+        RasiOptionRows(GLOW_SOURCES.filter { it.first != "global" && it.first != "none" }, bSrc) {
+            bSrc = it; prefs.edit().putString("gl_beat_src", it).apply(); RasiNowPlaying.notifyChanged()
+        }
+        RasiPrefSlider(prefs, "gl_idle", "Idle brightness (glow between beats)", " %", 35, 0, 100)
+        RasiPrefSlider(prefs, "gl_react", "Reaction strength", " %", 100, 20, 200)
+        RasiPrefSlider(prefs, "gl_sens", "Sensitivity", " %", 100, 20, 200)
+        RasiPrefSlider(prefs, "gl_attack", "Rise speed", " %", 70, 0, 100)
+        RasiPrefSlider(prefs, "gl_decay", "Fade-out length", " %", 50, 0, 100)
+        RasiPrefSlider(prefs, "gl_size_react", "Grow on the beat (0 = off)", " %", 20, 0, 100)
+        RasiPrefSlider(prefs, "gl_flash", "Beat flash toward white (0 = off)", " %", 25, 0, 100)
+        RasiPrefSlider(prefs, "gl_pale", "Pale on weak beats (0 = off)", " %", 0, 0, 100)
+    }
+    RasiPrefSlider(prefs, "gl_breath", "Slow breathing of the idle glow (0 = off)", "", 0, 0, 100)
+    RasiPrefSlider(prefs, "gl_cycle", "Color cycling speed (0 = off)", " deg/s", 0, 0, 120)
+    RasiPrefSlider(prefs, "gl_cycle_beat", "Shift the colors on every beat (0 = off)", " deg", 0, 0, 120)
+
+    var sync by remember { mutableStateOf(prefs.getBoolean("gl_sync", true)) }
+    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+        Column(Modifier.weight(1.0f)) {
+            Text("Sync all sides and corners")
+            Text("On: one size, strength and shape for everything. Off: set each side and corner on its own.", style = MaterialTheme.typography.bodySmall)
+        }
+        Switch(checked = sync, onCheckedChange = {
+            sync = it; prefs.edit().putBoolean("gl_sync", it).apply(); RasiNowPlaying.notifyChanged()
+        })
+    }
+    if (sync) {
+        var shape by remember { mutableStateOf(prefs.getString("gl_all_shape", "soft") ?: "soft") }
+        RasiPrefSlider(prefs, "gl_all_size", "Side size (corners are 2.5 times bigger)", " dp", 28, 4, 140)
+        RasiPrefSlider(prefs, "gl_all_str", "Strength", " %", 80, 0, 100)
+        RasiPrefSlider(prefs, "gl_all_stretch", "Corner stretch (100 = round)", " %", 100, 40, 250)
+        RasiOptionRows(listOf("soft" to "Soft glow", "sharp" to "Sharp band"), shape) {
+            shape = it; prefs.edit().putString("gl_all_shape", it).apply(); RasiNowPlaying.notifyChanged()
+        }
+    }
+
+    RasiSection("Sides")
+    for ((id, label) in RasiBorderGlow.SIDES) GlowElement(prefs, id, label, false, sync)
+    RasiSection("Corners")
+    for ((id, label) in RasiBorderGlow.CORNERS) GlowElement(prefs, id, label, true, sync)
+}
