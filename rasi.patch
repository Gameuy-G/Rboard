+import kotlin.math.roundToInt
+
+private fun clampOff(fw: Float, fh: Float, bw: Int, bh: Int, zoom: Float, off: Offset): Offset {
+    if (fw <= 0f || fh <= 0f) return off
+    val s = max(fw / bw, fh / bh) * zoom
+    val maxX = max(0f, (bw * s - fw) / 2f)
+    val maxY = max(0f, (bh * s - fh) / 2f)
+    return Offset(off.x.coerceIn(-maxX, maxX), off.y.coerceIn(-maxY, maxY))
+}
+
+/** Source crop rectangle (x, y, w, h) for a frame of fw x fh showing the bitmap zoomed and moved. */
+private fun cropRect(fw: Float, fh: Float, bw: Int, bh: Int, zoom: Float, off: Offset): IntArray {
+    if (fw <= 0f || fh <= 0f) return intArrayOf(0, 0, bw, bh)
+    val s = max(fw / bw, fh / bh) * zoom
+    val maxX = max(0f, (bw * s - fw) / 2f)
+    val maxY = max(0f, (bh * s - fh) / 2f)
+    val ox = off.x.coerceIn(-maxX, maxX)
+    val oy = off.y.coerceIn(-maxY, maxY)
+    val cw = fw / s
+    val ch = fh / s
+    val x = (bw / 2f - (fw / 2f + ox) / s).coerceIn(0f, max(0f, bw - cw)).roundToInt()
+    val y = (bh / 2f - (fh / 2f + oy) / s).coerceIn(0f, max(0f, bh - ch)).roundToInt()
+    return intArrayOf(x, y, cw.roundToInt().coerceIn(1, bw - x), ch.roundToInt().coerceIn(1, bh - y))
+}
+
+/** Crop and zoom screen. Drag to move, pinch or use the slider to zoom. aspect = width / height. */
+@Composable
+fun RasiCropDialog(bitmap: Bitmap, aspect: Float, title: String, onCancel: () -> Unit, onDone: (Bitmap, IntArray) -> Unit) {
+    Dialog(onDismissRequest = onCancel, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        Surface(Modifier.fillMaxSize()) {
+            var zoom by remember { mutableFloatStateOf(1f) }
+            var off by remember { mutableStateOf(Offset.Zero) }
+            var frame by remember { mutableStateOf(IntSize.Zero) }
+            val img = remember(bitmap) { bitmap.asImageBitmap() }
+            Column(Modifier.fillMaxSize().padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Text(title)
+                Text("Drag to move, pinch or use the slider to zoom.")
+                Column(Modifier.fillMaxWidth().aspectRatio(aspect).clip(RoundedCornerShape(12.dp))
+                    .onSizeChanged { frame = it }
+                    .pointerInput(bitmap) {
+                        detectTransformGestures { _, pan, z, _ ->
+                            zoom = (zoom * z).coerceIn(1f, 5f)
+                            off = clampOff(frame.width.toFloat(), frame.height.toFloat(), bitmap.width, bitmap.height, zoom, off + pan)
+                        }
+                    }) {
+                    Canvas(Modifier.fillMaxSize()) {
+                        val r = cropRect(size.width, size.height, bitmap.width, bitmap.height, zoom, off)
+                        drawImage(img, srcOffset = IntOffset(r[0], r[1]), srcSize = IntSize(r[2], r[3]),
+                            dstOffset = IntOffset.Zero, dstSize = IntSize(size.width.toInt(), size.height.toInt()))
+                    }
+                }
+                Text("Zoom")
+                Slider(zoom, {
+                    zoom = it
+                    off = clampOff(frame.width.toFloat(), frame.height.toFloat(), bitmap.width, bitmap.height, it, off)
+                }, valueRange = 1f..5f)
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    RasiTextButton(onClick = onCancel) { Text("Cancel") }
+                    Button(onClick = {
+                        val r = cropRect(frame.width.toFloat(), frame.height.toFloat(), bitmap.width, bitmap.height, zoom, off)
+                        onDone(Bitmap.createBitmap(bitmap, r[0], r[1], r[2], r[3]), r)
+                    }) { Text("Use this picture") }
+                }
+            }
+        }
+    }
+}
+
+/** Shows a picture. GIFs play here, unless animation is switched off or Performance mode is on (then the first frame). */
+@Composable
+fun RasiAnimPicture(pic: RasiAnimPic, modifier: Modifier, contentScale: ContentScale = ContentScale.Crop) {
+    val ctx = LocalContext.current
+    val animate = pic.frames.size > 1 && RasiPictures.animationAllowed(ctx)
+    var idx by remember(pic) { mutableIntStateOf(0) }
+    if (animate) LaunchedEffect(pic) {
+        while (true) {
+            delay(pic.delays.getOrElse(idx) { 100 }.toLong().coerceAtLeast(40L))
+            idx = (idx + 1) % pic.frames.size
+        }
+    }
+    Image(pic.frames[if (animate) idx.coerceIn(0, pic.frames.size - 1) else 0], null, modifier, contentScale = contentScale)
+}
