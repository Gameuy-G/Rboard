--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiRoomChat.kt
@@ -0,0 +1,217 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.IBinder
+import androidx.compose.runtime.mutableStateOf
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.ListenerRegistration
+import com.google.firebase.firestore.Query
+import org.futo.inputmethod.latin.uix.settings.SettingsActivity
+
+/**
+ * Listen together room chat (v2.5.08). Firestore only, text only.
+ *   rooms/{code}/messages/{id}  {from, text, createdAt}
+ * Reads stay low: the chat screen has ONE live listener on the last N messages while it is open.
+ * The background service (RasiRoomService) has ONE listener on the newest message of the active room, only while the lobby runs.
+ */
+object RasiRoomChat {
+    class Msg(val id: String, val from: String, val text: String, val at: Long)
+
+    val messages = mutableStateOf<List<Msg>>(emptyList())
+    val message = mutableStateOf("")
+    /** Messages from others that arrived while the room chat screen was closed. */
+    val unread = mutableStateOf(0)
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun me(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+
+    private fun fail(t: Throwable?, what: String): String {
+        RasiLog.fallback("RasiRoomChat", what + ": " + (t?.javaClass?.simpleName ?: "unknown"))
+        val text = generateSequence(t) { it.cause }.take(5).joinToString(" ") { it.message ?: "" }
+        return if (text.contains("PERMISSION_DENIED")) "The server refused this. The new Firestore rules may not be published yet, or you are no longer in the room"
+        else "Could not reach the server. Check your internet and try again"
+    }
+
+    /** Live listener on the last [limit] messages of the room. Returns a function that stops it. */
+    fun open(code: String, limit: Int): () -> Unit {
+        val d = db() ?: return {}
+        if (me() == null || code.isBlank()) return {}
+        messages.value = emptyList()
+        message.value = ""
+        val reg = d.collection("rooms").document(code).collection("messages")
+            .orderBy("createdAt", Query.Direction.DESCENDING).limit(limit.toLong())
+            .addSnapshotListener { s, e ->
+                if (e != null) { message.value = fail(e, "Listen"); return@addSnapshotListener }
+                if (s == null) return@addSnapshotListener
+                messages.value = s.documents.mapNotNull { m ->
+                    val t = m.getString("text") ?: return@mapNotNull null
+                    Msg(m.id, m.getString("from") ?: "", t, m.getLong("createdAt") ?: 0L)
+                }.reversed()
+            }
+        return { reg.remove(); messages.value = emptyList() }
+    }
+
+    fun send(code: String, text0: String, maxLen: Int = 500) {
+        val d = db() ?: return
+        val id = me() ?: return
+        val text = text0.trim().take(maxLen.coerceIn(1, 500))
+        if (text.isEmpty() || code.isBlank()) return
+        val fields = hashMapOf<String, Any>("from" to id, "text" to text, "createdAt" to System.currentTimeMillis())
+        d.collection("rooms").document(code).collection("messages").document().set(fields)
+            .addOnCompleteListener { t -> message.value = if (t.isSuccessful) "" else fail(t.exception, "Send") }
+    }
+
+    /** The sender or the room owner can delete a message (rules). */
+    fun delete(code: String, m: Msg) {
+        val d = db() ?: return
+        d.collection("rooms").document(code).collection("messages").document(m.id).delete()
+            .addOnFailureListener { message.value = fail(it, "Delete") }
+    }
+
+    /**
+     * Background watcher: one listener on the newest message of the room, used by RasiRoomService.
+     * Each message is announced once (pref rm_n_<code> keeps the last announced time).
+     */
+    fun watch(c: Context, code: String): ListenerRegistration? {
+        val d = db() ?: return null
+        val app = c.applicationContext
+        var first = true
+        return d.collection("rooms").document(code).collection("messages")
+            .orderBy("createdAt", Query.Direction.DESCENDING).limit(1)
+            .addSnapshotListener { s, e ->
+                if (e != null) { RasiLog.fallback("RasiRoomChat", "Watch: " + e.javaClass.simpleName); return@addSnapshotListener }
+                val doc = s?.documents?.firstOrNull() ?: return@addSnapshotListener
+                val from = doc.getString("from") ?: return@addSnapshotListener
+                val text = doc.getString("text") ?: ""
+                val at = doc.getLong("createdAt") ?: 0L
+                val isFirst = first
+                first = false
+                val p = RasiAccount.prefs(app)
+                val key = "rm_n_$code"
+                if (at <= p.getLong(key, 0L)) return@addSnapshotListener
+                p.edit().putLong(key, at).apply()
+                if (from == me()) return@addSnapshotListener
+                if (isFirst && System.currentTimeMillis() - at > 10L * 60000L) return@addSnapshotListener
+                RasiMsgNotify.handleRoom(app, code, from, text, at)
+            }
+    }
+}
+
+/**
+ * Keeps the Listen together lobby alive in the background (foreground service) until the room is left or closed.
+ * Holds the new-message watcher for the room chat. Turn it off in Listen together > Room options.
+ */
+class RasiRoomService : Service() {
+    private var reg: ListenerRegistration? = null
+    private var watching = ""
+
+    companion object {
+        @Volatile var running = false
+        @Volatile private var inst: RasiRoomService? = null
+        const val CH = "rasi_room_service"
+        const val NOTIF = 7104
+        const val ACT_LEAVE = "org.futo.inputmethod.latin.rasi.ROOM_LEAVE"
+
+        /** Starts or stops the service according to: saved room, background option, signed in. Safe to call often. */
+        @JvmStatic
+        fun ensure(c: Context) {
+            val app = c.applicationContext
+            try {
+                val p = RasiAccount.prefs(app)
+                val signed = try { FirebaseAuth.getInstance().currentUser != null } catch (t: Throwable) { false }
+                val want = signed && p.getBoolean("rm_bg", true) && !(p.getString("rm_code", "") ?: "").isBlank()
+                if (want) {
+                    if (running) inst?.rewatch()
+                    else ContextCompat.startForegroundService(app, Intent(app, RasiRoomService::class.java))
+                } else if (running) app.stopService(Intent(app, RasiRoomService::class.java))
+            } catch (t: Throwable) {
+                RasiLog.fallback("RasiRoomService", "Ensure failed: " + t.javaClass.simpleName)
+            }
+        }
+
+        private fun channel(c: Context) {
+            if (Build.VERSION.SDK_INT < 26) return
+            val nm = c.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+            nm.createNotificationChannel(NotificationChannel(CH, "Listen together lobby", NotificationManager.IMPORTANCE_MIN)
+                .apply { description = "The small always-on notice while your Listen together room is kept open in the background." })
+        }
+
+        fun notification(c: Context): Notification {
+            channel(c)
+            val p = RasiAccount.prefs(c)
+            val name = (RasiRooms.room.value?.name ?: p.getString("rm_name", "") ?: "").ifBlank { "your room" }
+            val open = PendingIntent.getActivity(c, 7104,
+                Intent(c, SettingsActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP).putExtra("navDest", "rasiRooms"),
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+            val leave = PendingIntent.getService(c, 7105,
+                Intent(c, RasiRoomService::class.java).setAction(ACT_LEAVE),
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+            return NotificationCompat.Builder(c, CH)
+                .setSmallIcon(android.R.drawable.stat_notify_chat)
+                .setContentTitle("Listen together: $name")
+                .setContentText("The lobby stays open. Tap to open it.")
+                .setOngoing(true).setPriority(NotificationCompat.PRIORITY_MIN)
+                .setContentIntent(open)
+                .addAction(0, "Leave room", leave)
+                .build()
+        }
+    }
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent?.action == ACT_LEAVE) {
+            try {
+                if (RasiRooms.room.value != null) RasiRooms.leave(this)
+                else RasiAccount.prefs(this).edit().remove("rm_code").apply()
+            } catch (t: Throwable) { RasiLog.fallback("RasiRoomService", "Leave failed: " + t.javaClass.simpleName) }
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        try {
+            val n = notification(this)
+            if (Build.VERSION.SDK_INT >= 34) startForeground(NOTIF, n, android.content.pm.ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE)
+            else startForeground(NOTIF, n)
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiRoomService", "Foreground start failed: " + t.javaClass.simpleName)
+            stopSelf(); return START_NOT_STICKY
+        }
+        inst = this
+        running = true
+        try { RasiAccount.init(applicationContext) } catch (t: Throwable) { }
+        try { RasiRooms.restore(applicationContext) } catch (t: Throwable) { RasiLog.fallback("RasiRoomService", "Restore failed: " + t.javaClass.simpleName) }
+        rewatch()
+        return START_STICKY
+    }
+
+    /** Points the watcher at the room saved in the prefs (a new room, or none = stop). */
+    fun rewatch() {
+        val p = RasiAccount.prefs(applicationContext)
+        val code = p.getString("rm_code", "") ?: ""
+        if (code.isBlank()) { stopSelf(); return }
+        try {
+            (getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager).notify(NOTIF, notification(this))
+        } catch (t: Throwable) { }
+        if (code == watching && reg != null) return
+        reg?.remove(); reg = null
+        watching = code
+        reg = RasiRoomChat.watch(applicationContext, code)
+    }
+
+    override fun onDestroy() {
+        reg?.remove(); reg = null; watching = ""
+        running = false
+        if (inst === this) inst = null
+        super.onDestroy()
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiRooms.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiRooms.kt
