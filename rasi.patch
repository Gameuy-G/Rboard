+                        Modifier
+                            .offset {
+                                IntOffset(
+                                    (centerX + offX.dp - sizeDp / 2).toPx().roundToInt(),
+                                    (centerY + offY.dp - sizeDp / 2).toPx().roundToInt()
+                                )
+                            }
+                            .size(sizeDp)
+                    ) {
+                        AndroidView(
+                            factory = { ctx -> ImageView(ctx).apply { scaleType = ImageView.ScaleType.FIT_CENTER } },
+                            update = { iv ->
+                                iv.setImageDrawable(preview)
+                                if (Build.VERSION.SDK_INT >= 28) startPreview(preview)
+                            },
+                            modifier = Modifier.fillMaxSize()
+                        )
+                    }
+                }
+            }
+
+            if (preview != null) {
+                Text(stringResource(R.string.rasi_effects_size))
+                Slider(
+                    value = size,
+                    onValueChange = {
+                        size = it
+                        prefs.edit().putFloat(RasiEffects.k("size", target), it).apply()
+                    },
+                    valueRange = 24f..200f
+                )
+
+                OutlinedButton(onClick = {
+                    offX = 0f
+                    offY = 0f
+                    RasiEffects.resetPosition(context, target)
+                }) { Text(stringResource(R.string.rasi_effects_reset)) }
+            }
+        }
+    }
+}
