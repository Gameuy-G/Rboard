+private fun klipyUrl(file: JSONObject?, size: String): String =
+    file?.optJSONObject(size)?.optJSONObject("gif")?.optString("url").orEmpty()
+
+/** How sharp GIF thumbnails are: 0 = small and fast, 1 = medium, 2 = full quality (what gets sent). */
+object RasiGifQuality {
+    private fun prefs(c: Context) = c.applicationContext.getSharedPreferences("rasi_klipy", Context.MODE_PRIVATE)
+    @JvmStatic fun get(c: Context): Int = prefs(c).getInt("preview_quality", 0).coerceIn(0, 2)
+    @JvmStatic fun set(c: Context, q: Int) { prefs(c).edit().putInt("preview_quality", q.coerceIn(0, 2)).apply() }
+    @Volatile var current = 0
+}
+
+private fun klipyFmt(file: JSONObject?, size: String, fmt: String): String =
+    file?.optJSONObject(size)?.optJSONObject(fmt)?.optString("url").orEmpty()
+
+private fun giphyFetch(key: String, customerId: String, query: String, quality: Int): List<GiphyItem> {
+    val base = "https://api.klipy.com/api/v1/" + URLEncoder.encode(key, "UTF-8").replace("+", "%20") + "/gifs/"
+    val common = "page=1&per_page=24&customer_id=" + URLEncoder.encode(customerId, "UTF-8")
+    val url = if (query.isBlank()) {
+        base + "trending?" + common
+    } else {
+        base + "search?q=" + URLEncoder.encode(query, "UTF-8") + "&" + common
+    }
+    val root = JSONObject(httpGet(url))
+    val dataObj = root.optJSONObject("data")
+    val data = dataObj?.optJSONArray("data") ?: root.optJSONArray("data")
+        ?: return emptyList()
+    val out = ArrayList<GiphyItem>()
+    for (i in 0 until data.length()) {
+        val o = data.optJSONObject(i) ?: continue
+        val file = o.optJSONObject("file") ?: continue
+        // quality from settings: 0 tiny and fast, 1 medium, 2 full (the same file that gets sent)
+        val preview = when (quality) {
+            2 -> klipyUrl(file, "md").ifEmpty { klipyUrl(file, "hd") }
+            1 -> klipyFmt(file, "sm", "webp").ifEmpty { klipyUrl(file, "sm") }.ifEmpty { klipyUrl(file, "md") }
+            else -> klipyFmt(file, "xs", "webp").ifEmpty { klipyUrl(file, "xs") }
+                .ifEmpty { klipyFmt(file, "sm", "webp") }.ifEmpty { klipyUrl(file, "sm") }
+                .ifEmpty { klipyUrl(file, "md") }
+        }
+        val gif = klipyUrl(file, "md").ifEmpty { klipyUrl(file, "hd") }
+            .ifEmpty { klipyUrl(file, "sm") }
+        if (preview.isNotEmpty() && gif.isNotEmpty()) {
+            val id = o.optString("slug", "").ifEmpty { o.optString("id", gif.hashCode().toString()) }
+            val dims = file.optJSONObject("md")?.optJSONObject("gif")
+                ?: file.optJSONObject("sm")?.optJSONObject("gif")
+            val w = dims?.optDouble("width", 0.0) ?: 0.0
+            val h = dims?.optDouble("height", 0.0) ?: 0.0
+            val ratio = if (w > 0.0 && h > 0.0) (w / h).toFloat().coerceIn(0.4f, 2.5f) else 1.0f
+            if (out.none { it.id == id }) out.add(GiphyItem(id, preview, gif, ratio))
+        }
+    }
+    return out
+}
+
+private fun downloadGif(context: Context, item: GiphyItem): File {
+    val file = File(context.cacheDir, "klipy_" + item.id + ".gif")
+    if (!file.exists() || file.length() == 0L) {
+        val conn = URL(item.gifUrl).openConnection() as HttpURLConnection
+        conn.connectTimeout = 10000
+        conn.readTimeout = 30000
+        try {
+            conn.inputStream.use { input -> file.outputStream().use { input.copyTo(it) } }
+        } finally {
+            conn.disconnect()
+        }
+    }
+    return file
+}
+
+/** Downloads a GIF and decodes it as an animated drawable (static on very old Android). */
+@Suppress("DEPRECATION")
+private fun loadDrawable(url: String): Drawable? {
+    val bytes = URL(url).openStream().use { it.readBytes() }
+    if (Build.VERSION.SDK_INT >= 28) {
+        return ImageDecoder.decodeDrawable(ImageDecoder.createSource(ByteBuffer.wrap(bytes))) { decoder, info, _ ->
+            // grid thumbnails never need more than ~320px wide
+            val w = info.size.width
+            if (RasiGifQuality.current == 0 && w > 320) decoder.setTargetSampleSize(Math.max(1, w / 320))
+        }
+    }
+    val bmp = BitmapFactory.decodeByteArray(bytes, 0, bytes.size) ?: return null
+    return BitmapDrawable(bmp)
+}
