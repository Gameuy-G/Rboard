+object RasiSettingsThemePrefs {
+    const val NAME = "rasi_settings_theme"
+    fun prefs(context: Context): SharedPreferences =
+        context.applicationContext.getSharedPreferences(NAME, Context.MODE_PRIVATE)
+
+    fun gradientColors(p: SharedPreferences): List<Int> {
+        val n = p.getInt("grad_count", 2).coerceIn(2, 4)
+        val defaults = listOf(0xFF1B1B3A.toInt(), 0xFF3A1C71.toInt(), 0xFF6A2C70.toInt(), 0xFF8E3B78.toInt())
+        return List(n) { p.getInt("grad_$it", defaults[it]) }
+    }
+}
+
+internal fun angledBrush(colors: List<Int>, angle: Float): Brush = object : ShaderBrush() {
+    override fun createShader(size: Size): Shader {
+        val e = GradientMath.endpoints(size.width, size.height, angle)
+        return LinearGradientShader(
+            Offset(e[0], e[1]),
+            Offset(e[2], e[3]),
+            colors.map { Color(it) }
+        )
+    }
+}
+
+@SuppressLint("RestrictedApi")
+internal fun schemeFromAccent(accent: Int, dark: Boolean): KeyboardColorScheme {
+    val col = Hct.fromInt(accent)
+    val dynamicScheme = DynamicScheme(
+        col,
+        Variant.VIBRANT,
+        dark,
+        0.0,
+        TonalPalette.fromHueAndChroma(col.hue, col.chroma),
+        TonalPalette.fromHueAndChroma(
+            MathUtils.sanitizeDegreesDouble(col.hue + 15.0),
+            maxOf(col.chroma - 32.0, col.chroma * 0.5)
+        ),
+        TonalPalette.fromHct(
+            DislikeAnalyzer.fixIfDisliked(
+                TemperatureCache(col).getAnalogousColors(3, 6).get(2)
+            )
+        ),
+        TonalPalette.fromHueAndChroma(col.hue, col.chroma / 1.0),
+        TonalPalette.fromHueAndChroma(col.hue, col.chroma / 1.0 + 4.0),
+    )
+    val scheme = getColorSchemeFromDynamicScheme(dynamicScheme)
+    return if (dark) wrapDarkColorScheme(scheme) else wrapLightColorScheme(scheme)
+}
+
+/**
+ * Settings theme: follows the keyboard theme by default, or uses its own accent color,
+ * light/dark mode and optional gradient background.
+ */
+@Composable
+fun RasiSettingsThemeAuto(content: @Composable () -> Unit) {
+    val context = LocalContext.current
+    val prefs = remember { RasiSettingsThemePrefs.prefs(context) }
+    var version by remember { mutableIntStateOf(0) }
+
+    DisposableEffect(prefs) {
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ -> version++ }
+        prefs.registerOnSharedPreferenceChangeListener(listener)
+        onDispose { prefs.unregisterOnSharedPreferenceChangeListener(listener) }
+    }
+
+    if (version >= 0 && prefs.getInt("mode", 0) == 1) {
+        val accent = prefs.getInt("accent", 0xFF8E7CFF.toInt())
+        val dark = prefs.getBoolean("dark", true)
+        val scheme = remember(accent, dark) { schemeFromAccent(accent, dark) }
+
+        val gradientOn = prefs.getBoolean("grad_on", false)
+        val brush: Brush? = if (gradientOn) {
+            angledBrush(RasiSettingsThemePrefs.gradientColors(prefs), prefs.getFloat("grad_angle", 90f))
+        } else null
+
+        UixThemeWrapper(colorScheme = scheme) {
+            CompositionLocalProvider(LocalRasiSettingsBackground provides brush) {
+                content()
+            }
+        }
+    } else {
+        UixThemeAuto(content)
+    }
+}
