+/** Messages > Chat settings > Message notifications. */
+@Composable
+fun RasiMsgNotifySettings(prefs: SharedPreferences) {
+    val context = LocalContext.current
+    var on by remember { mutableStateOf(prefs.getBoolean("mn_on", false)) }
+    val perm = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { }
+    DisposableEffect(Unit) { onDispose { RasiMsgNotify.ensure(context) } }
+    RasiSection("Message notifications")
+    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+        Column(Modifier.weight(1f)) {
+            Text("Message notifications")
+            Text("Shows a notification when a friend writes to you, even when the app is closed. Keeps a small always-on notice and one live connection to the server (Firebase only).", style = MaterialTheme.typography.bodySmall)
+        }
+        Switch(checked = on, onCheckedChange = { v ->
+            on = v
+            prefs.edit().putBoolean("mn_on", v).apply()
+            if (v && Build.VERSION.SDK_INT >= 33 && context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
+                perm.launch(Manifest.permission.POST_NOTIFICATIONS)
+            }
+            RasiMsgNotify.ensure(context)
+        })
+    }
+    Text("Battery and data: one open connection that only wakes when a chat changes. If the system closes it, a check every 15 minutes (one small read) still brings your messages.", fontSize = 12.sp)
+    RasiPrefSwitch(prefs, "mn_poll", "15 minute backup check", "If the live connection is closed by the system, checks for new messages about every 15 minutes. Needs no extra notice.", true)
+    RasiPrefSwitch(prefs, "mn_grp_on", "Group message notifications", "Also notifies you about new messages in your groups. Uses one more live connection per group; at start it reads each channel once, after that only channels that change. Needs the switch above. Off by default. Mute single groups on the group page.", false)
+    RasiPrefSwitch(prefs, "mn_text", "Show message text", "Off: notifications only say New message, the text stays private on the lock screen.", true)
+    RasiPrefSlider(prefs, "mn_lines", "Messages kept in one card", "", 3, 1, 6)
+    RasiPrefSwitch(prefs, "mn_ping_loud", "Mentions notify louder", "Messages that @mention you use a separate Mentions channel with high priority, so you can give it its own sound in the system settings.", true)
+    RasiPrefSwitch(prefs, "mn_ping_mute", "Mentions break through mute", "A mention still notifies you in a chat you muted. Off: muted chats stay quiet, always.", false)
+    RasiPrefSwitch(prefs, "mn_quiet_on", "Quiet hours", "No notifications and no popups between the two hours below. Messages are still there when you open the chat.", false)
+    RasiPrefSlider(prefs, "mn_quiet_from", "Quiet from hour", "", 23, 0, 23)
+    RasiPrefSlider(prefs, "mn_quiet_to", "Quiet until hour", "", 7, 0, 23)
+    RasiSection("In-app popup")
+    Text("While Rboard settings are on screen you get a small popup instead of a system notification.", fontSize = 12.sp)
+    RasiPrefSwitch(prefs, "mn_pop_on", "Show the popup", "Off: you get a normal system notification even while the app is open (except inside the same chat).", true)
+    RasiPrefSwitch(prefs, "mn_pop_same", "Also in the same chat", "Shows the popup even when that friend's chat is the screen you are looking at.", false)
+    RasiPrefSwitch(prefs, "mn_pop_preview", "Show a text preview", "Adds the first lines of the message under You received a message from.", false)
+    RasiPrefChoice(prefs, "mn_pop_pos", "Position", listOf("Top|Near the top of the screen", "Bottom|Near the bottom of the screen"), 0)
+    RasiPrefChoice(prefs, "mn_pop_align", "Side", listOf("Left|Sticks to the left edge", "Center|In the middle", "Right|Sticks to the right edge"), 1)
+    RasiPrefChoice(prefs, "mn_pop_anim", "Animation", listOf("Slide|Slides in and out from the edge", "Fade|Fades in and out", "None|Appears and disappears at once"), 0)
+    Text("Animations are always off in Performance mode.", fontSize = 12.sp)
+    RasiPrefSlider(prefs, "mn_pop_size", "Popup text size", "sp", 14, 11, 22)
+    RasiPrefSlider(prefs, "mn_pop_secs", "Popup duration", " s", 4, 2, 12)
+    Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+        RasiTextButton(onClick = { RasiMsgNotify.test(context) }) { Text("Test notification") }
+        RasiTextButton(onClick = { RasiMsgNotify.testPopup(context) }) { Text("Test popup") }
+    }
+    RasiTextButton(onClick = {
+        context.startActivity(Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS).putExtra(Settings.EXTRA_APP_PACKAGE, context.packageName).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    }) { Text(if (RasiMsgNotify.enabled(context)) "Notification settings" else "Allow notifications") }
+}
