+                        val scheme = LocalKeyboardScheme.current
+                        // While dragging a new action over the row, leave a gap (null) where it will land
+                        val shown: List<Action?> = remember(st.favs.toList(), dragged, overTop, st.finger.value) {
+                            val base = st.favs.toList()
