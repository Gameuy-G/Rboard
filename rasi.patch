+                val sortMode = remember { mutableStateOf(ui.getString("sort", "custom") ?: "custom") }
+                val filterMode = remember { mutableStateOf(ui.getString("filter", "all") ?: "all") }
+                val grouping = remember { mutableStateOf(ui.getString("all_grouping", "section") ?: "section") }
