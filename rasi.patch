+/**
+ * Friends strip on the main settings screen: friends' pictures with a progress ring (or a mini bar) in the color of the song
+ * they listen to. Live listeners only exist while this strip is on screen. Options live in Friends > Friends strip.
+ */
+@Composable
+fun RasiFriendsStrip() {
+    val ctx = LocalContext.current
+    remember { RasiAccount.init(ctx); 0 }
+    val uid by RasiAccount.uid
+    val p = RasiAccount.prefs(ctx)
+    androidx.compose.runtime.LaunchedEffect(Unit) { org.futo.inputmethod.latin.rasi.RasiFriendAlerts.ensure(ctx) }
+    if (uid.isNullOrBlank() || !p.getBoolean("fs_on", true)) return
+    LaunchedEffect(uid) { RasiFriends.refresh(ctx) }
+    val all by RasiFriends.friends
+    val nows = remember { mutableStateMapOf<String, RasiFriends.Now?>() }
+    val staleMs = p.getInt("fr_stale_min", 120) * 60000L
+    val count = p.getInt("fs_count", 12)
+    val shown = all.filter { it.p.showNow || !p.getBoolean("fs_only_live", false) }.take(count)
+    val key = shown.joinToString(",") { it.uid }
+    DisposableEffect(key) {
+        val stops = shown.filter { it.p.showNow }.map { f -> RasiFriends.listenNow(f.uid) { nows[f.uid] = it } }
+        onDispose { stops.forEach { it() } }
+    }
+    remember { RasiPerf.init(ctx) }
+    val perf = RasiPerf.isOn()
+    var tick by remember { mutableLongStateOf(System.currentTimeMillis()) }
+    LaunchedEffect(perf) {
+        while (true) { delay(if (perf) 5000L else 1000L); tick = System.currentTimeMillis() }
+    }
+    val live = if (p.getBoolean("fs_only_live", false)) shown.filter { f -> nows[f.uid]?.let { tick - it.at < staleMs } == true } else shown
+    if (live.isEmpty()) return
+    val picsOn = p.getBoolean("fr_pics", true)
+    val size = p.getInt("fs_size", 64).dp
+    val gap = p.getInt("fs_gap", 10).dp
+    var open by remember { mutableStateOf<RasiFriends.Friend?>(null) }
+    // my own song color (used instead of theirs while I listen, when the switch is on)
+    val my = RasiNowPlaying.track
+    val mySw = remember(my?.art) { my?.art?.let { try { RasiNowPlayingTheme.swatches(it) } catch (e: Throwable) { IntArray(0) } } ?: IntArray(0) }
+    val mine = if (p.getBoolean("fs_mine", true) && my != null && my.playing && mySw.isNotEmpty()) mySw[0] else 0
+
+    val left = p.getBoolean("fs_left", true)
+    val edge = p.getInt("fs_pad", 16).dp
+    LazyRow(Modifier.fillMaxWidth().padding(vertical = 8.dp), contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = edge),
+        horizontalArrangement = if (left) Arrangement.spacedBy(gap) else Arrangement.spacedBy(gap, Alignment.CenterHorizontally)) {
+        items(live, key = { it.uid }) { f ->
+            val n = nows[f.uid]?.takeIf { tick - it.at < staleMs && it.title.isNotBlank() }
+            StripItem(f, n, tick, size, picsOn, mine, p.getBoolean("fs_bar", false), p.getInt("fs_ring_w", 3), p.getBoolean("fs_track", true),
+                p.getBoolean("fs_names", false), p.getBoolean("now_lift", true)) { open = f }
+        }
+    }
+    val nav = org.futo.inputmethod.latin.uix.LocalNavController.current
+    open?.let { f ->
+        Dialog(onDismissRequest = { open = null }) {
+            val bgOn = p.getBoolean("fs_bg", true)
+            Surface(shape = RoundedCornerShape(24.dp), color = if (bgOn) androidx.compose.ui.graphics.Color.Transparent else MaterialTheme.colorScheme.surface) {
+                val dimC = MaterialTheme.colorScheme.surface.copy(alpha = p.getInt("fs_dim", 35).coerceIn(0, 100) / 100f)
+                Column((if (bgOn) Modifier.background(rasiDialogBrush()).background(dimC) else Modifier).padding(vertical = 8.dp)) {
+                    FriendCard(f, true, picsOn, true, staleMs.toInt() / 60000, startOpen = true) {
+                        RasiTextButton(onClick = {
+                            val target = f.uid
+                            open = null
+                            try { nav?.navigate("rasiChat/" + target) } catch (t: Throwable) { RasiLog.fallback("RasiFriendsStrip", "Could not open chat: " + t.javaClass.simpleName) }
+                        }, enabled = nav != null) { Text("Message") }
+                        RasiTextButton(onClick = { open = null }) { Text("Close") }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun StripItem(f: RasiFriends.Friend, n: RasiFriends.Now?, tick: Long, size: androidx.compose.ui.unit.Dp, picsOn: Boolean,
+                      mine: Int, bar: Boolean, ringW: Int, track: Boolean, names: Boolean, lift: Boolean, onTap: () -> Unit) {
+    val ctx = LocalContext.current
+    var av by remember(f.uid, f.p.avatarPicV, f.p.avatarUsePic, picsOn) { mutableStateOf<RasiAnimPic?>(null) }
+    LaunchedEffect(f.uid, f.p.avatarPicV, f.p.avatarUsePic, picsOn) {
+        if (picsOn && f.p.avatarUsePic && f.p.avatarPicV > 0L) RasiPictures.fetch(ctx, f.uid, RasiPictures.AVATAR, f.p.avatarPicV) { av = it }
+    }
+    val base = if (mine != 0) mine else if (n != null && n.c1 != 0) n.c1 else f.p.accent
+    val col = Color(rasiNowLift(base or (0xFF shl 24), lift))
+    val progress: Float? = if (n == null) null else if (n.posMs >= 0L && n.durMs > 0L)
+        ((n.posMs + (if (n.playing) (tick - n.at).coerceAtLeast(0L) else 0L)).toFloat() / n.durMs.toFloat()).coerceIn(0f, 1f) else 1f
+    val ringPad = if (bar) 0.dp else (ringW + 3).dp
+    Column(Modifier.width(size + 8.dp).clickable { onTap() }, horizontalAlignment = Alignment.CenterHorizontally) {
+        Box(Modifier.size(size), contentAlignment = Alignment.Center) {
+            Box(Modifier.fillMaxSize().padding(ringPad).clip(CircleShape).background(Color(f.p.avatarColor)), contentAlignment = Alignment.Center) {
+                val a = av
+                if (a != null) RasiAnimPicture(a, Modifier.fillMaxSize(), ContentScale.Crop)
+                else Text(f.p.avatar, fontSize = (size.value * 0.42f).sp)
+            }
+            if (!bar) Canvas(Modifier.fillMaxSize()) {
+                val w = ringW.dp.toPx()
+                val s = Size(this.size.width - w, this.size.height - w)
+                if (track) drawArc(col.copy(alpha = 0.2f), 0f, 360f, false, Offset(w / 2f, w / 2f), s, style = Stroke(w))
+                if (progress != null) drawArc(col, -90f, 360f * progress, false, Offset(w / 2f, w / 2f), s, style = Stroke(w, cap = StrokeCap.Round))
+            }
+        }
+        if (bar) Box(Modifier.padding(top = 3.dp).width(size).height(4.dp).clip(RoundedCornerShape(2.dp)).background(col.copy(alpha = if (track) 0.2f else 0f))) {
+            if (progress != null) Box(Modifier.fillMaxSize().padding(end = size * (1f - progress)).background(col))
+        }
+        if (names) Text(f.p.name.ifBlank { f.p.username }, fontSize = 11.sp, maxLines = 1, overflow = TextOverflow.Ellipsis)
+    }
+}
