+private fun shadeToColor(hue: Float, shade: Float): Int {
+    val s = if (shade < 0.5f) shade * 2f else 1f
+    val v = if (shade < 0.5f) 1f else 1f - (shade - 0.5f) * 2f
+    return android.graphics.Color.HSVToColor(floatArrayOf(hue, s, v))
+}
+
+@Composable
+private fun RasiColorPicker(color: Int, onColor: (Int) -> Unit) {
+    var hue by remember { mutableFloatStateOf(0f) }
+    var shade by remember { mutableFloatStateOf(0.5f) }
+    LaunchedEffect(color) {
+        if (shadeToColor(hue, shade) != color) {
+            val hsv = FloatArray(3)
+            android.graphics.Color.colorToHSV(color, hsv)
+            if (hsv[1] > 0.05f) hue = hsv[0]
+            shade = if (hsv[2] < 1f) 0.5f + (1f - hsv[2]) * 0.5f else hsv[1] * 0.5f
+        }
+    }
+    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+        Row(
+            Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            listOf(
+                Color.Red, Color(0xFFFF9800), Color.Yellow, Color.Green, Color(0xFF2196F3),
+                Color(0xFF9C27B0), Color(0xFFFF4081), Color.White, Color.Gray, Color.Black
+            ).forEach { c ->
+                Box(
+                    Modifier
+                        .size(26.dp)
+                        .background(c, CircleShape)
+                        .border(if (c.toArgb() == color) 3.dp else 1.dp, Color.Gray, CircleShape)
+                        .clickable { onColor(c.toArgb()) }
+                )
+            }
+        }
+        ColorBar(
+            Brush.horizontalGradient(listOf(Color.Red, Color.Yellow, Color.Green, Color.Cyan, Color.Blue, Color.Magenta, Color.Red)),
+            hue / 360f
+        ) { hue = it * 360f; onColor(shadeToColor(hue, shade)) }
+        ColorBar(
+            Brush.horizontalGradient(listOf(Color.White, Color.hsv(hue, 1f, 1f), Color.Black)),
+            shade
+        ) { shade = it; onColor(shadeToColor(hue, shade)) }
+    }
+}
