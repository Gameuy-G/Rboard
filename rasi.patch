+/**
+ * Small arrow at the top right of every settings screen while a Listen together room is open.
+ * Tap it to jump back to the Listen together tab. Hidden on the Listen together screens themselves.
+ */
+@Composable
+fun RasiRoomArrow(navController: NavHostController) {
+    val c = LocalContext.current
+    val p = remember { RasiAccount.prefs(c) }
+    val room by RasiRooms.room
+    val unread by RasiRoomChat.unread
+    val entry by navController.currentBackStackEntryAsState()
+    val route = entry?.destination?.route ?: ""
+    if (room == null || !p.getBoolean("rm_arrow", true)) return
+    if (route == "rasiRooms" || route == "rasiRoomChat") return
+    val size = p.getInt("rm_arrow_size", 36).coerceIn(28, 56)
+    Box(Modifier.fillMaxSize().padding(top = 6.dp, end = 6.dp), contentAlignment = Alignment.TopEnd) {
+        Surface(
+            shape = CircleShape, color = MaterialTheme.colorScheme.primaryContainer, contentColor = MaterialTheme.colorScheme.onPrimaryContainer,
+            shadowElevation = 4.dp, modifier = Modifier.size(size.dp).clickable { try { navController.navigate("rasiRooms") } catch (_: Throwable) { } }
+        ) {
+            Box(contentAlignment = Alignment.Center) {
+                Text("\u2192", fontSize = (size * 0.5f).sp, fontWeight = FontWeight.Bold)
+                if (unread > 0 && p.getBoolean("rm_arrow_badge", true)) Box(
+                    Modifier.align(Alignment.TopEnd).padding(3.dp).size(10.dp).clip(CircleShape).background(Color(0xFFE53935))
+                )
+            }
+        }
+    }
+}
