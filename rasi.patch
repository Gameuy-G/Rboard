+                                    }
+                                }
+                            }
+                        }
+
+                        val d = st.dragging.value
+                        if (d != null && st.topBounds.contains(st.finger.value)) {
+                            Box(
+                                Modifier
+                                    .offset {
+                                        IntOffset(
+                                            (st.finger.value.x - st.topBounds.left).roundToInt() - 20.dp.roundToPx(),
+                                            (st.finger.value.y - st.topBounds.top).roundToInt() - 20.dp.roundToPx()
