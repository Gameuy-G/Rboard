+/** Discord style long-press sheet: quick reactions with a More tile, then rounded cards of actions. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun MessageSheet(
+    prefs: SharedPreferences, quick: List<String>, mineE: String?, canReact: Boolean,
+    groups: List<List<MsgAct>>, onReact: (String) -> Unit, onDismiss: () -> Unit
+) {
+    var picker by remember { mutableStateOf(false) }
+    if (picker) { EmojiPickerSheet(prefs, onReact, onDismiss); return }
+    ModalBottomSheet(onDismissRequest = onDismiss) {
+        Column(Modifier.fillMaxWidth().verticalScroll(rememberScrollState()).padding(horizontal = 16.dp, vertical = 4.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {
+            if (canReact) Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                (quick.take(5)).forEach { e ->
+                    Box(Modifier.weight(1f).height(52.dp).clip(RoundedCornerShape(12.dp))
+                        .background(if (e == mineE) MaterialTheme.colorScheme.primary.copy(alpha = 0.3f) else MaterialTheme.colorScheme.surfaceContainerHigh)
+                        .clickable { pushRecent(prefs, e); onReact(e) }, contentAlignment = Alignment.Center) { Text(e, fontSize = 26.sp) }
+                }
+                Box(Modifier.weight(1f).height(52.dp).clip(RoundedCornerShape(12.dp)).background(MaterialTheme.colorScheme.surfaceContainerHigh)
+                    .clickable { picker = true }, contentAlignment = Alignment.Center) { Text("\uD83D\uDE00+", fontSize = 20.sp) }
+            }
+            groups.filter { it.isNotEmpty() }.forEach { g ->
+                Column(Modifier.fillMaxWidth().clip(RoundedCornerShape(16.dp)).background(MaterialTheme.colorScheme.surfaceContainerHigh)) {
+                    g.forEachIndexed { i, a ->
+                        Row(Modifier.fillMaxWidth().clickable { a.onClick() }.padding(horizontal = 16.dp, vertical = 14.dp), verticalAlignment = Alignment.CenterVertically) {
+                            Box(Modifier.width(34.dp)) { androidx.compose.material3.Icon(a.icon, null, Modifier.size(22.dp)) }
+                            Text(a.label, fontSize = 18.sp)
+                        }
+                        if (i < g.size - 1) Box(Modifier.fillMaxWidth().padding(start = 50.dp).height(1.dp).background(MaterialTheme.colorScheme.onSurface.copy(alpha = 0.1f)))
+                    }
+                }
+            }
+            Spacer(Modifier.height(16.dp))
+        }
+    }
+}
