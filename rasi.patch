+import androidx.compose.runtime.mutableStateListOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.mutableStateMapOf
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.SolidColor
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import org.futo.inputmethod.latin.uix.ActionTextEditor
+import org.futo.inputmethod.latin.uix.LocalKeyboardScheme
+
+/**
+ * Named sections for the clipboard. Stored in their own small preferences file, separate from
+ * FUTO's clipboard data, so they can never corrupt the clipboard history.
+ */
+object RasiSections {
+    val names = mutableStateListOf<String>()
+    private val assignments = mutableStateMapOf<String, String>()
+    private val hiddenInAll = mutableStateMapOf<String, Boolean>()
+    private var prefs: SharedPreferences? = null
+    private const val SEP = "\u001F"
+
+    /** Setting: items that are in a section are hidden from the All tab. Default OFF. */
+    val hideFromAll = mutableStateOf(false)
+
+    fun setHideFromAll(context: Context, v: Boolean) {
+        init(context)
+        hideFromAll.value = v
+        prefs?.edit()?.putBoolean("hide_from_all", v)?.apply()
+    }
+
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences("rasi_clip_sections", Context.MODE_PRIVATE)
+        prefs = p
+        hideFromAll.value = p.getBoolean("hide_from_all", false)
+        names.clear()
+        names.addAll((p.getString("names", "") ?: "").split(SEP).filter { it.isNotBlank() })
+        hiddenInAll.clear()
+        (p.getStringSet("hidden_in_all", emptySet()) ?: emptySet()).forEach { hiddenInAll[it] = true }
+        assignments.clear()
+        for ((k, v) in p.all) {
+            if (k.startsWith("item_") && v is String) {
+                assignments[k.removePrefix("item_")] = v
+            }
+        }
+    }
+
+    private fun save() {
+        prefs?.edit()?.putString("names", names.joinToString(SEP))?.apply()
+    }
+
+    fun keyOf(entry: ClipboardEntry): String =
+        entry.backingFile ?: ("t" + (entry.text ?: "").toFNV1aHash().toString())
+
+    fun sectionOf(entry: ClipboardEntry): String? = assignments[keyOf(entry)]
+
+    fun inSection(entry: ClipboardEntry, section: String): Boolean =
+        if (section.isEmpty()) !(hideFromAll.value && assignments.containsKey(keyOf(entry))) && !hiddenInAll.containsKey(keyOf(entry))
+        else assignments[keyOf(entry)] == section
+
+    private fun saveHidden() {
+        prefs?.edit()?.putStringSet("hidden_in_all", hiddenInAll.keys.toSet())?.apply()
+    }
+
+    /** Deleting an item from All / Recent: hide it there but keep it in its section. */
+    fun hideFromAllView(entry: ClipboardEntry) {
+        hiddenInAll[keyOf(entry)] = true
+        saveHidden()
+    }
+
+    fun unhideFromAllView(entry: ClipboardEntry) {
+        if (hiddenInAll.remove(keyOf(entry)) != null) saveHidden()
+    }
+
+    fun assign(entry: ClipboardEntry, section: String?) {
+        val k = keyOf(entry)
+        if (section == null) {
+            if (hiddenInAll.remove(k) != null) saveHidden()
+            assignments.remove(k)
+            prefs?.edit()?.remove("item_$k")?.apply()
+        } else {
+            assignments[k] = section
+            prefs?.edit()?.putString("item_$k", section)?.apply()
+        }
+    }
+
+    fun addSection(name: String) {
+        val n = name.trim()
+        if (n.isNotEmpty() && !names.contains(n)) {
+            names.add(n)
+            save()
+        }
+    }
+
+    fun removeSection(name: String) {
+        names.remove(name)
+        save()
+    }
+}
+
+/** Gboard-style tab: filled with the accent color when selected, soft container otherwise. */
+@Composable
+private fun RasiPill(label: String, isSelected: Boolean, onClick: () -> Unit) {
+    val scheme = LocalKeyboardScheme.current
+    val bg by androidx.compose.animation.animateColorAsState(
+        if (isSelected) scheme.primary else scheme.keyboardContainer, label = "secPill"
+    )
+    Box(
+        Modifier
+            .height(36.dp)
+            .clip(RoundedCornerShape(18.dp))
+            .background(bg)
+            .clickable { onClick() }
+            .padding(horizontal = 16.dp),
+        contentAlignment = Alignment.Center
+    ) {
+        Text(label, color = if (isSelected) scheme.onPrimary else scheme.onKeyboardContainer, maxLines = 1)
+    }
+}
+
+/** Round toggle button that lights up when on. */
+@Composable
+private fun RasiToggleButton(on: Boolean, onClick: () -> Unit, content: @Composable (androidx.compose.ui.graphics.Color) -> Unit) {
+    val scheme = LocalKeyboardScheme.current
+    val bg by androidx.compose.animation.animateColorAsState(
+        if (on) scheme.primary else scheme.keyboardContainer, label = "secToggle"
+    )
+    Box(
+        Modifier
+            .size(36.dp)
+            .clip(androidx.compose.foundation.shape.CircleShape)
+            .background(bg)
+            .clickable { onClick() },
+        contentAlignment = Alignment.Center
+    ) {
+        content(if (on) scheme.onPrimary else scheme.onKeyboardContainer)
+    }
+}
+
+/**
+ * Top bar: section tabs on the left (like the GIF menu), and a "+" and a pencil (reorder) toggle on
+ * the right. "+" opens a small form to add a clipboard item or a section.
+ */
+@Composable
+fun RasiSectionsBar(
+    selected: MutableState<String>,
+    reorder: MutableState<Boolean>? = null,
+    modifier: Modifier = Modifier,
+    onAddItem: (String, String) -> Unit = { _, _ -> }
+) {
+    val context = LocalContext.current
+    RasiSections.init(context)
+    val adding = remember { mutableStateOf(false) }
+    val addItem = remember { mutableStateOf(true) }
+    val newText = remember { mutableStateOf("") }
+    val scheme = LocalKeyboardScheme.current
+
+    Column(modifier.fillMaxWidth().background(scheme.keyboardSurface)) {
+        Row(
+            Modifier
+                .fillMaxWidth()
+                .padding(horizontal = 8.dp, vertical = 6.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            Row(
+                Modifier
+                    .weight(1.0f)
+                    .horizontalScroll(rememberScrollState()),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                RasiPill("All", selected.value.isEmpty()) { selected.value = "" }
+                RasiSections.names.forEach { n ->
+                    RasiPill(n, selected.value == n) { selected.value = n }
+                }
+                if (selected.value.isNotEmpty()) {
+                    RasiPill("Delete section", false) {
+                        RasiSections.removeSection(selected.value)
+                        selected.value = ""
+                    }
+                }
+            }
+            Spacer(Modifier.width(8.dp))
+            RasiClipImport.init(context)
+            RasiPill(if (RasiClipImport.modeOn.value) "Import: ON" else "Import", RasiClipImport.modeOn.value) {
+                RasiClipImport.setMode(context, !RasiClipImport.modeOn.value)
+            }
+            Spacer(Modifier.width(8.dp))
+            RasiToggleButton(adding.value, {
+                adding.value = !adding.value
+                newText.value = ""
+            }) { c -> Text("+", color = c, style = androidx.compose.material3.MaterialTheme.typography.titleLarge) }
+            if (reorder != null) {
+                Spacer(Modifier.width(8.dp))
+                RasiToggleButton(reorder.value, { reorder.value = !reorder.value }) { c ->
+                    androidx.compose.material3.Icon(
+                        androidx.compose.ui.res.painterResource(org.futo.inputmethod.latin.R.drawable.edit_text),
+                        contentDescription = "Reorder",
+                        tint = c,
+                        modifier = Modifier.size(20.dp)
+                    )
+                }
+            }
+        }
+        if (adding.value) {
+            val compact = org.futo.inputmethod.latin.uix.rasiCompact()
+            @Composable
+            fun typePills() {
+                RasiPill("Item", addItem.value) { addItem.value = true }
+                Spacer(Modifier.width(8.dp))
+                RasiPill("Section", !addItem.value) { addItem.value = false }
+            }
+            @Composable
+            fun editor(m: Modifier) {
+                Surface(
+                    color = scheme.surface,
+                    border = BorderStroke(1.dp, SolidColor(scheme.outline)),
+                    shape = RoundedCornerShape(8.dp),
+                    modifier = m.heightIn(min = if (compact) 40.dp else 48.dp, max = if (compact) 64.dp else 120.dp),
+                ) {
+                    Box(Modifier.padding(8.dp), contentAlignment = Alignment.CenterStart) {
+                        ActionTextEditor(
+                            newText,
+                            multiline = addItem.value,
+                            autocorrect = false,
+                            placeholder = if (addItem.value) "Text to add to clipboard" else "Section name"
+                        )
+                    }
+                }
+            }
+            @Composable
+            fun saveButton() {
+                Button(
+                    onClick = {
+                        if (addItem.value) onAddItem(newText.value, selected.value)
+                        else RasiSections.addSection(newText.value)
+                        adding.value = false
+                        newText.value = ""
+                    },
+                    enabled = newText.value.isNotBlank()
+                ) { Text(if (addItem.value) "Save" else "Add") }
+            }
+            if (compact) {
+                // sideways: everything on one row so the form stays short
+                Row(
+                    Modifier.fillMaxWidth().padding(horizontal = 8.dp, vertical = 4.dp),
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    typePills()
+                    Spacer(Modifier.width(8.dp))
+                    editor(Modifier.weight(1.0f))
+                    Spacer(Modifier.width(8.dp))
+                    saveButton()
+                }
+            } else {
+                Row(Modifier.fillMaxWidth().padding(horizontal = 8.dp), verticalAlignment = Alignment.CenterVertically) {
+                    typePills()
+                }
+                Row(
+                    Modifier.fillMaxWidth().padding(8.dp),
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    editor(Modifier.weight(1.0f))
+                    Spacer(Modifier.width(8.dp))
+                    saveButton()
+                }
+            }
+        }
+    }
+}
