+import androidx.navigation.NavHostController
+import androidx.navigation.compose.rememberNavController
+import org.futo.inputmethod.latin.uix.RasiKeySizeSetting
+import org.futo.inputmethod.latin.uix.RasiKeySizes
+import org.futo.inputmethod.latin.uix.settings.ScreenTitle
+import org.futo.inputmethod.latin.uix.settings.ScrollableList
+import org.futo.inputmethod.latin.uix.settings.useDataStore
+
+/** Adjusts the key sizes and shape of whatever theme is active. */
+@Composable
+fun RasiKeySizesScreen(navController: NavHostController = rememberNavController()) {
+    val store = useDataStore(RasiKeySizeSetting)
+    val start = remember { RasiKeySizes.parse(store.value) }
+    var gap by remember { mutableFloatStateOf(start.gap) }
+    var round by remember { mutableFloatStateOf(if (start.round < 0f) 1f else start.round) }
+    var followTheme by remember { mutableStateOf(start.round < 0f) }
+    var text by remember { mutableFloatStateOf(start.text) }
+    var hint by remember { mutableFloatStateOf(start.hint) }
+    var blur by remember { mutableFloatStateOf(start.blur) }
+    var keyAlpha by remember { mutableFloatStateOf(start.keyAlpha) }
+    var textAlpha by remember { mutableFloatStateOf(start.textAlpha) }
+    var preview by remember { mutableStateOf("") }
+    val popupContext = androidx.compose.ui.platform.LocalContext.current
+    remember { org.futo.inputmethod.latin.uix.RasiPopup.init(popupContext) }
+    var popupMs by remember { mutableFloatStateOf(org.futo.inputmethod.latin.uix.RasiPopup.durationMs().toFloat()) }
+    var popupStart by remember { mutableFloatStateOf(org.futo.inputmethod.latin.uix.RasiPopup.startScale()) }
+
+    fun save() {
+        store.setValue(RasiKeySizes.Values(gap, if (followTheme) -1f else round, text, hint, blur, keyAlpha, textAlpha).encode())
+    }
+
+    @Composable
+    fun row(label: String, value: Float, range: ClosedFloatingPointRange<Float>, onChange: (Float) -> Unit) {
+        Column {
+            Text(label + ": " + (Math.round(value * 100) / 100f))
+            Slider(value = value, onValueChange = onChange, valueRange = range, onValueChangeFinished = { save() })
+        }
+    }
+
+    ScrollableList {
+        ScreenTitle("Key sizes and shape", showBack = true, navController)
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text("These changes sit on top of your current theme and keep working if you switch themes. Tap the box at the bottom to see the keyboard.")
+            row("Space between keys", gap, 0f..3f) { gap = it }
+            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                Switch(checked = followTheme, onCheckedChange = { followTheme = it; save() })
+                Text("Use the theme's key roundness")
+            }
+            if (!followTheme) row("Key roundness", round, 0f..2.5f) { round = it }
+            row("Letter size", text, 0.6f..1.6f) { text = it }
+            row("Hint size (small symbols)", hint, 0.5f..2f) { hint = it }
+            Text("Key popup (the letter bubble when you press a key)")
+            Column {
+                Text(
+                    if (popupMs.toInt() <= 0) "Popup animation speed: default"
+                    else "Popup animation time: " + popupMs.toInt() + " ms (lower is faster)"
+                )
+                Slider(
+                    value = popupMs, onValueChange = { popupMs = it },
+                    valueRange = 0f..400f,
+                    onValueChangeFinished = {
+                        org.futo.inputmethod.latin.uix.RasiPopup.set(popupContext, popupMs.toInt(), popupStart)
+                    }
+                )
+            }
+            Column {
+                Text("Popup start size: " + Math.round(popupStart * 100) + "%")
+                Slider(
+                    value = popupStart, onValueChange = { popupStart = it },
+                    valueRange = 0.3f..1f,
+                    onValueChangeFinished = {
+                        org.futo.inputmethod.latin.uix.RasiPopup.set(popupContext, popupMs.toInt(), popupStart)
+                    }
+                )
+            }
+            Text("Move the time slider to the left end for the normal popup. The popup grows from the start size to full size in that time.")
+            Text("Look")
+            row("Background blur (theme picture)", blur, 0f..1f) { blur = it }
+            row("Key button opacity", keyAlpha, 0.1f..1f) { keyAlpha = it }
+            row("Key text opacity", textAlpha, 0.1f..1f) { textAlpha = it }
+            OutlinedButton(
+                onClick = {
+                    gap = 1f; round = 1f; followTheme = true; text = 1f; hint = 1f
+                    blur = 0f; keyAlpha = 1f; textAlpha = 1f
+                    popupMs = 0f; popupStart = 0.75f
+                    org.futo.inputmethod.latin.uix.RasiPopup.set(popupContext, 0, 0.75f)
+                    store.setValue(RasiKeySizes.Values().encode())
+                },
+                modifier = Modifier.fillMaxWidth()
+            ) { Text("Reset to the theme's defaults") }
+            OutlinedTextField(
+                value = preview, onValueChange = { preview = it },
+                label = { Text("Tap here to preview the keyboard") },
+                modifier = Modifier.fillMaxWidth()
+            )
+        }
+    }
+}
