+package org.futo.inputmethod.latin.rasi
+
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+
+/**
+ * One fancy font: a base alphabet, an optional case change and an optional suffix
+ * (combining marks, separators or decorations) added after every letter or digit.
+ * caseMode: 0 as typed, 1 UPPER, 2 lower, 3 aLtErNaTiNg.
+ */
+class RasiFontStyle(
+    val name: String,
+    val tag: String,
+    val base: (Int) -> Int,
+    val caseMode: Int = 0,
+    val suffix: String = "",
+    val zUp: Int = 0,
+    val zMid: Int = 0,
+    val zDown: Int = 0
+) {
+    fun apply(text: String): String {
+        val sb = StringBuilder()
+        var i = 0
+        text.codePoints().forEach { cp ->
+            sb.append(styled(cp, i % 2 == 0) ?: String(Character.toChars(cp)))
+            i++
+        }
+        return sb.toString()
+    }
+
+    fun styled(cp: Int, altUpper: Boolean): String? {
+        val isLetter = (cp in 'A'.code..'Z'.code) || (cp in 'a'.code..'z'.code)
+        val isDigit = cp in '0'.code..'9'.code
+        if (!isLetter && !isDigit) return null
+        var c = cp
+        if (isLetter) {
+            c = when (caseMode) {
+                1 -> Character.toUpperCase(cp)
+                2 -> Character.toLowerCase(cp)
+                3 -> if (altUpper) Character.toUpperCase(cp) else Character.toLowerCase(cp)
+                else -> cp
+            }
+        }
+        val out = StringBuilder()
+        out.appendCodePoint(base(c))
+        out.append(suffix)
+        if (zUp + zMid + zDown > 0) {
+            repeat(rnd(zUp)) { out.appendCodePoint(ZALGO_UP.random()) }
+            repeat(rnd(zMid)) { out.appendCodePoint(ZALGO_MID.random()) }
+            repeat(rnd(zDown)) { out.appendCodePoint(ZALGO_DOWN.random()) }
+        }
+        return out.toString()
+    }
+}
+
