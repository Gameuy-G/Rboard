+/** Scientific expression evaluator (recursive descent). */
+object RasiCalcEngine {
+    class CalcError(msg: String) : Exception(msg)
+
+    private val funcs = listOf(
+        "asinh", "acosh", "atanh", "asin", "acos", "atan", "sinh", "cosh", "tanh",
+        "sin", "cos", "tan", "log", "ln", "abs", "exp", "\u221A", "\u221B"
+    )
+
+    fun format(v: Double): String {
+        if (v.isNaN() || v.isInfinite()) throw CalcError("Math error")
+        if (v == 0.0) return "0"
+        val a = Math.abs(v)
+        if (a >= 1e10 || a < 1e-9) {
+            var s = String.format(java.util.Locale.US, "%.9e", v)
+            val idx = s.indexOf('e')
+            var mant = s.substring(0, idx).trimEnd('0').trimEnd('.')
+            val exp = s.substring(idx + 1).toInt()
+            return mant + "E" + exp
+        }
+        val bd = java.math.BigDecimal(v).round(java.math.MathContext(12))
+        var s = bd.stripTrailingZeros().toPlainString()
+        return s
+    }
+
+    /** The value as a fraction like 3\u20444 (null when it is a whole number or no small fraction fits). */
+    fun fraction(v: Double): String? {
+        if (v.isNaN() || v.isInfinite()) return null
+        val a = Math.abs(v)
+        if (a >= 1e9 || a == Math.floor(a)) return null
+        var h1 = 1L; var h0 = 0L; var k1 = 0L; var k0 = 1L
+        var x = a
+        for (n in 0 until 24) {
+            val ai = Math.floor(x).toLong()
+            val h2 = ai * h1 + h0
+            val k2 = ai * k1 + k0
+            if (k2 > 100000L) return null
+            h0 = h1; h1 = h2; k0 = k1; k1 = k2
+            if (Math.abs(a - h1.toDouble() / k1.toDouble()) < 1e-11 * Math.max(1.0, a)) {
+                return (if (v < 0) "\u2212" else "") + h1 + "\u2044" + k1
+            }
+            val frac = x - Math.floor(x)
+            if (frac < 1e-12) return null
+            x = 1.0 / frac
+        }
+        return null
+    }
+
+    fun eval(expr: String, deg: Boolean, ans: Double, mem: Double): Double {
+        val p = Parser(expr, deg, ans, mem)
+        val r = p.parse()
+        if (r.isNaN() || r.isInfinite()) throw CalcError("Math error")
+        return r
+    }
+
+    private class Parser(val s: String, val deg: Boolean, val ans: Double, val mem: Double) {
+        var i = 0
+
+        fun parse(): Double {
+            val v = add()
+            if (i < s.length) throw CalcError("Syntax error")
+            return v
+        }
+
+        fun peek(): Char = if (i < s.length) s[i] else '\u0000'
+
+        fun add(): Double {
+            var v = mul()
+            while (true) {
+                val c = peek()
+                if (c == '+') { i++; v += mul() }
+                else if (c == '\u2212' || c == '-') { i++; v -= mul() }
+                else return v
+            }
+        }
+
+        fun startsPrimary(): Boolean {
+            val c = peek()
+            if (c.isDigit() || c == '.' || c == '(' || c == '\u03C0' || c == 'e' || c == 'M') return true
+            if (c == '\u221A' || c == '\u221B') return true
+            if (s.startsWith("Ans", i)) return true
+            return funcs.any { s.startsWith(it, i) }
+        }
+
+        fun mul(): Double {
+            var v = unary()
+            while (true) {
+                val c = peek()
+                if (c == '\u00D7' || c == '*') { i++; v *= unary() }
+                else if (c == '\u00F7' || c == '/') {
+                    i++
+                    val d = unary()
+                    if (d == 0.0) throw CalcError("Cannot divide by zero")
+                    v /= d
+                } else if (startsPrimary()) v *= unary()
+                else return v
+            }
+        }
+
+        fun unary(): Double {
+            val c = peek()
+            if (c == '-' || c == '\u2212') { i++; return -unary() }
+            if (c == '+') { i++; return unary() }
+            return pc()
+        }
+
+        fun pc(): Double {
+            var v = pow()
+            while (true) {
+                val c = peek()
+                if (c == 'P') {
+                    i++; val r = pow()
+                    v = fact(v) / fact(v - r)
+                } else if (c == 'C') {
+                    i++; val r = pow()
+                    v = fact(v) / (fact(r) * fact(v - r))
+                } else return v
+            }
+        }
+
+        fun pow(): Double {
+            val base = post()
+            if (peek() == '^') {
+                i++
+                val e = unary()
+                return Math.pow(base, e)
+            }
+            return base
+        }
+
+        fun post(): Double {
+            var v = primary()
+            while (true) {
+                val c = peek()
+                if (c == '\u2044') {
+                    // fraction key: a/b binds tighter than x and /, like a real calculator
+                    i++
+                    val d = primary()
+                    if (d == 0.0) throw CalcError("Cannot divide by zero")
+                    v /= d
+                }
+                else if (c == '!') { i++; v = fact(v) }
+                else if (c == '%') { i++; v /= 100.0 }
+                else return v
+            }
+        }
+
+        fun fact(n: Double): Double {
+            if (n < 0 || n != Math.floor(n) || n > 170) throw CalcError("Math error")
+            var r = 1.0
+            for (k in 2..n.toInt()) r *= k
+            return r
+        }
+
+        fun primary(): Double {
+            val c = peek()
+            if (c == '(') {
+                i++
+                val v = add()
+                if (peek() == ')') i++
+                return v
+            }
+            if (c.isDigit() || c == '.') {
+                val st = i
+                while (peek().isDigit() || peek() == '.') i++
+                if (peek() == 'E') {
+                    val save = i
+                    i++
+                    if (peek() == '-' || peek() == '+') i++
+                    if (peek().isDigit()) { while (peek().isDigit()) i++ } else i = save
+                }
+                return s.substring(st, i).toDoubleOrNull() ?: throw CalcError("Syntax error")
+            }
+            if (c == '\u03C0') { i++; return PI }
+            if (s.startsWith("Ans", i)) { i += 3; return ans }
+            if (c == 'M') { i++; return mem }
+            for (f in funcs) {
+                if (s.startsWith(f, i)) {
+                    i += f.length
+                    val arg: Double
+                    if (peek() == '(') {
+                        i++
+                        arg = add()
+                        if (peek() == ')') i++
+                    } else arg = pow()
+                    return apply(f, arg)
+                }
+            }
+            if (c == 'e') { i++; return E }
+            throw CalcError("Syntax error")
+        }
+
+        fun toRad(x: Double) = if (deg) Math.toRadians(x) else x
+        fun fromRad(x: Double) = if (deg) Math.toDegrees(x) else x
+
+        fun apply(f: String, x: Double): Double = when (f) {
+            "sin" -> { val r = Math.sin(toRad(x)); if (Math.abs(r) < 1e-15) 0.0 else r }
+            "cos" -> { val r = Math.cos(toRad(x)); if (Math.abs(r) < 1e-15) 0.0 else r }
+            "tan" -> {
+                if (deg && Math.abs(x % 180.0) == 90.0) throw CalcError("Math error")
+                val r = Math.tan(toRad(x)); if (Math.abs(r) < 1e-15) 0.0 else r
+            }
+            "asin" -> { if (x < -1 || x > 1) throw CalcError("Math error"); fromRad(Math.asin(x)) }
+            "acos" -> { if (x < -1 || x > 1) throw CalcError("Math error"); fromRad(Math.acos(x)) }
+            "atan" -> fromRad(Math.atan(x))
+            "sinh" -> Math.sinh(x)
+            "cosh" -> Math.cosh(x)
+            "tanh" -> Math.tanh(x)
+            "asinh" -> Math.log(x + Math.sqrt(x * x + 1))
+            "acosh" -> { if (x < 1) throw CalcError("Math error"); Math.log(x + Math.sqrt(x * x - 1)) }
+            "atanh" -> { if (x <= -1 || x >= 1) throw CalcError("Math error"); 0.5 * Math.log((1 + x) / (1 - x)) }
+            "log" -> { if (x <= 0) throw CalcError("Math error"); Math.log10(x) }
+            "ln" -> { if (x <= 0) throw CalcError("Math error"); Math.log(x) }
+            "abs" -> Math.abs(x)
+            "exp" -> Math.exp(x)
+            "\u221A" -> { if (x < 0) throw CalcError("Math error"); Math.sqrt(x) }
+            "\u221B" -> Math.cbrt(x)
+            else -> throw CalcError("Syntax error")
+        }
+    }
+}
