+import androidx.compose.ui.unit.dp
+
+/**
+ * "Liquid glass" look for the settings screens. Every colour comes from the keyboard theme
+ * (MaterialTheme), so it follows built-in and custom themes alike. Nothing here animates or
+ * runs in the background, so it costs nothing while idle.
+ */
+
+/** Translucent glass surface: soft gradient fill, bright top-left edge highlight. */
+@Composable
+fun Modifier.rasiGlass(shape: Shape = RoundedCornerShape(22.dp), strength: Float = 1f): Modifier {
+    if (useDataStoreValue(org.futo.inputmethod.latin.uix.RasiGboardLookSetting)) return this.clip(shape)
+    val tint = MaterialTheme.colorScheme.onSurface
+    val accent = MaterialTheme.colorScheme.primary
+    return this
+        .clip(shape)
+        .background(
+            Brush.linearGradient(
+                listOf(
+                    tint.copy(alpha = 0.11f * strength),
+                    accent.copy(alpha = 0.05f * strength),
+                    tint.copy(alpha = 0.05f * strength)
+                )
+            ),
+            shape
+        )
+        .border(
+            1.dp,
+            Brush.linearGradient(
+                listOf(
+                    tint.copy(alpha = 0.34f * strength),
+                    tint.copy(alpha = 0.05f * strength),
+                    accent.copy(alpha = 0.18f * strength)
+                )
+            ),
+            shape
+        )
+}
+
+@Composable
+private fun Blob(color: Color, size: Dp, x: Dp, y: Dp, alpha: Float) {
+    Box(
+        Modifier
+            .offset(x, y)
+            .size(size)
+            .clip(CircleShape)
+            .background(Brush.radialGradient(listOf(color.copy(alpha = alpha), Color.Transparent)))
+    )
+}
+
+/** Themed gradient with soft colour blobs behind everything (blurred on Android 12+). */
+@Composable
+fun RasiGlassBackground(content: @Composable BoxScope.() -> Unit) {
+    val c = MaterialTheme.colorScheme
+    val actx = androidx.compose.ui.platform.LocalContext.current
+    val tick = org.futo.inputmethod.latin.rasi.rememberNowPlayingTick()
+    val darkBg = c.background.luminance() < 0.5f
+    val songBrush = org.futo.inputmethod.latin.rasi.RasiSettingsAmbience.brush(actx, darkBg, tick)
+    val songBlobs = org.futo.inputmethod.latin.rasi.RasiSettingsAmbience.blobColors(actx, darkBg, tick)
+    val plain = useDataStoreValue(org.futo.inputmethod.latin.uix.RasiGboardLookSetting)
+    Box(
+        Modifier
+            .fillMaxSize()
+            .background(
+                if (plain) Brush.verticalGradient(listOf(c.background, c.background))
+                else songBrush ?: LocalRasiSettingsBackground.current ?: Brush.verticalGradient(
+                    listOf(c.background, c.primary.copy(alpha = 0.10f).compositeOver(c.background), c.background)
+                )
+            )
+    ) {
+        if (!plain) org.futo.inputmethod.latin.uix.RasiAnimatedBackground(
+            org.futo.inputmethod.latin.uix.RasiAnimBg.SETTINGS, Modifier.fillMaxSize()
+        )
+        if (!plain && !RasiPerf.isOn()) {
+            org.futo.inputmethod.latin.rasi.RasiSettingsCover(Modifier.fillMaxSize(), tick)
+            val blurMod = if (Build.VERSION.SDK_INT >= 31) Modifier.blur(48.dp) else Modifier
+            Box(Modifier.fillMaxSize().then(blurMod)) {
+                Blob(songBlobs?.first ?: c.primary, 340.dp, (-120).dp, (-80).dp, 0.42f)
+                Blob(songBlobs?.second ?: c.tertiary, 300.dp, 200.dp, 260.dp, 0.34f)
+                Blob(songBlobs?.third ?: c.secondary, 360.dp, (-140).dp, 560.dp, 0.30f)
+            }
+        }
+        if (!plain) org.futo.inputmethod.latin.rasi.RasiSettingsEffects("behind", Modifier.fillMaxSize())
+        org.futo.inputmethod.latin.rasi.RasiSettingsViz(Modifier.fillMaxSize(), withFx = !plain)
+        if (!plain) org.futo.inputmethod.latin.rasi.RasiSettingsEffects("mid", Modifier.fillMaxSize())
+        content()
+        // draw-only, so taps still reach the settings below
+        if (!plain) org.futo.inputmethod.latin.rasi.RasiSettingsEffects("over", Modifier.fillMaxSize())
+    }
+}
+
+private fun Color.compositeOver(background: Color): Color {
+    val a = alpha
+    return Color(
+        red = red * a + background.red * (1 - a),
+        green = green * a + background.green * (1 - a),
+        blue = blue * a + background.blue * (1 - a),
+        alpha = 1f
+    )
+}
