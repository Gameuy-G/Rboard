+/** Moves the Kitchen row up exactly as far as the grid is scrolled, so it scrolls like part of the list. */
+private fun updateKitchenHeaderOffset(rv: RecyclerView) {
+    val h = rv.paddingTop
+    if (h <= 0) {
+        if (RasiEmojiNav.headerOffset.value != 0) RasiEmojiNav.headerOffset.value = 0
+        return
+    }
+    val lm = rv.layoutManager as? GridLayoutManager ?: return
+    val first = lm.findFirstVisibleItemPosition()
+    val off = if (first == 0) {
+        val c = lm.findViewByPosition(0)
+        if (c != null) (c.top - h).coerceIn(-h, 0) else -h
+    } else if (first < 0) 0 else -h
+    if (RasiEmojiNav.headerOffset.value != off) RasiEmojiNav.headerOffset.value = off
+    val top = off == 0
+    if (RasiEmojiNav.atTop.value != top) RasiEmojiNav.atTop.value = top
+}
