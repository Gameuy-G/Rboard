+
+/** Learned words panel: import a Gboard dictionary, see how many words are remembered, or clear them. */
+val RasiWordsAction = Action(
+    icon = R.drawable.rasi_words,
+    name = R.string.rasi_words,
+    simplePressImpl = null,
+    windowImpl = { manager, _ ->
+        val words = mutableStateOf(0)
+        val shortcuts = mutableStateOf(0)
+        val confirmClear = mutableStateOf(false)
+
+        object : ActionWindow() {
+            override val showCloseButton: Boolean
+                get() = true
+
+            override val positionIsUserManagable: Boolean
+                get() = false
+
+            @Composable
+            override fun windowName(): String = stringResource(R.string.rasi_words)
+
+            @Composable
+            override fun WindowContents(keyboardShown: Boolean) {
+                val context = LocalContext.current
+                LaunchedEffect(Unit) {
+                    RasiWordMemory.init(context)
+                    while (true) {
+                        words.value = RasiWordMemory.wordCount()
+                        shortcuts.value = RasiWordMemory.shortcutCount()
+                        delay(1000)
+                    }
+                }
+                Column(Modifier.fillMaxWidth().padding(8.dp)) {
+                    Text("Remembered words: ${words.value}   Shortcuts: ${shortcuts.value}")
+                    Text("Stored only on this phone.")
+                    Spacer(Modifier.height(8.dp))
+                    Button(
+                        onClick = {
+                            val i = Intent(context, RasiPickerActivity::class.java)
+                            i.putExtra("kind", "dictionary")
+                            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                            context.startActivity(i)
+                        },
+                        modifier = Modifier.fillMaxWidth()
+                    ) { Text("Import Gboard dictionary (.zip or .txt)") }
+                    Spacer(Modifier.height(6.dp))
+                    OutlinedButton(
+                        onClick = {
+                            if (confirmClear.value) {
+                                RasiWordMemory.clearAll()
+                                confirmClear.value = false
+                            } else confirmClear.value = true
+                        },
+                        modifier = Modifier.fillMaxWidth()
+                    ) { Text(if (confirmClear.value) "Tap again to clear all remembered words" else "Clear remembered words") }
+                }
+            }
+
+            override fun close(): org.futo.inputmethod.latin.uix.CloseResult =
+                org.futo.inputmethod.latin.uix.CloseResult.Default
+        }
+    }
+)
