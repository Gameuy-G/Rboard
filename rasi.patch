+    /** Best guess of when the photo or video was originally made. */
+    private fun takenDate(context: Context, uri: Uri, mime: String): Long? {
+        if (mime.startsWith("image/")) {
+            try {
+                context.contentResolver.openInputStream(uri)?.use { s ->
+                    val e = android.media.ExifInterface(s)
+                    val d = e.getAttribute(android.media.ExifInterface.TAG_DATETIME_ORIGINAL)
+                        ?: e.getAttribute(android.media.ExifInterface.TAG_DATETIME)
+                    if (d != null) {
+                        val t = java.text.SimpleDateFormat("yyyy:MM:dd HH:mm:ss", java.util.Locale.US).parse(d)?.time
+                        if (t != null && t > 0) return t
+                    }
+                }
+            } catch (e: Exception) {
+            }
+        }
+        try {
+            context.contentResolver.query(uri, null, null, null, null)?.use { c ->
+                if (c.moveToFirst()) {
+                    for (col in listOf("datetaken", "last_modified", "date_modified")) {
+                        val i = c.getColumnIndex(col)
+                        if (i >= 0 && !c.isNull(i)) {
+                            var v = c.getLong(i)
+                            if (col == "date_modified") v *= 1000L
+                            if (v > 0) return v
+                        }
+                    }
+                }
+            }
+        } catch (e: Exception) {
+        }
+        return null
+    }
