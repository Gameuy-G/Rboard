+/**
+ * Small in-app popup "You received a message from NAME". Shown while a settings screen is open
+ * (the app is on screen) instead of a system notification. Tap opens the chat.
+ */
+@Composable
+fun RasiMsgPopupHost(onOpen: (String) -> Unit) {
+    val c = LocalContext.current
+    val p = remember { RasiAccount.prefs(c) }
+    remember { RasiPerf.init(c); 0 }
+    val shown by RasiMsgNotify.popup
+    var last by remember { mutableStateOf<RasiMsgNotify.Popup?>(null) }
+    if (shown != null) last = shown
+    val perf = RasiPerf.isOn()
+    val top = p.getInt("mn_pop_pos", 0) == 0
+    val align = p.getInt("mn_pop_align", 1).coerceIn(0, 2)
+    val anim = if (perf) 2 else p.getInt("mn_pop_anim", 0).coerceIn(0, 2)
+    val sizeSp = p.getInt("mn_pop_size", 14).coerceIn(11, 22)
+    val secs = p.getInt("mn_pop_secs", 4).coerceIn(2, 12)
+    LaunchedEffect(shown?.stamp) {
+        val s = shown
+        if (s != null) {
+            delay(secs * 1000L)
+            if (RasiMsgNotify.popup.value === s) RasiMsgNotify.popup.value = null
+        }
+    }
+    val enter: EnterTransition = when (anim) {
+        0 -> slideInVertically { if (top) -it else it } + fadeIn()
+        1 -> fadeIn()
+        else -> EnterTransition.None
+    }
+    val exit: ExitTransition = when (anim) {
+        0 -> slideOutVertically { if (top) -it else it } + fadeOut()
+        1 -> fadeOut()
+        else -> ExitTransition.None
+    }
+    val pos = when {
+        top && align == 0 -> Alignment.TopStart
+        top && align == 1 -> Alignment.TopCenter
+        top -> Alignment.TopEnd
+        align == 0 -> Alignment.BottomStart
+        align == 1 -> Alignment.BottomCenter
+        else -> Alignment.BottomEnd
+    }
+    Box(Modifier.fillMaxSize().padding(12.dp), contentAlignment = pos) {
+        AnimatedVisibility(visible = shown != null, enter = enter, exit = exit) {
+            val pp = last
+            if (pp != null) {
+                val bg = if (pp.ping) MaterialTheme.colorScheme.tertiaryContainer else MaterialTheme.colorScheme.primaryContainer
+                val fg = if (pp.ping) MaterialTheme.colorScheme.onTertiaryContainer else MaterialTheme.colorScheme.onPrimaryContainer
+                Surface(
+                    shape = RoundedCornerShape(16.dp), color = bg, contentColor = fg, shadowElevation = 6.dp,
+                    modifier = Modifier.clickable {
+                        if (pp.other.isNotBlank()) onOpen(pp.other)
+                        RasiMsgNotify.popup.value = null
+                    }
+                ) {
+                    Column(Modifier.padding(horizontal = 14.dp, vertical = 10.dp)) {
+                        Text("You received a message from " + pp.name, fontSize = sizeSp.sp, fontWeight = FontWeight.Bold)
+                        if (pp.text.isNotBlank()) Text(pp.text, fontSize = (sizeSp - 2).coerceAtLeast(10).sp, maxLines = 2, overflow = TextOverflow.Ellipsis)
+                    }
+                }
+            }
+        }
+    }
+}
