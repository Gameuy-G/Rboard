+private object CalcHistory {
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("rasi_calc", Context.MODE_PRIVATE)
+
+    fun load(context: Context): List<String> =
+        (prefs(context).getString("history", "") ?: "").split("\n").filter { it.isNotBlank() }
+
+    fun add(context: Context, entry: String) {
+        val list = (listOf(entry) + load(context)).take(40)
+        prefs(context).edit().putString("history", list.joinToString("\n")).apply()
+    }
+
+    fun clear(context: Context) = prefs(context).edit().remove("history").apply()
+}
