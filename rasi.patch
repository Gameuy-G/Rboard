+/** User id of the author of the replied-to message (empty when unknown in a direct chat: the friend). */
+private fun replyUid(c: ChatCtx, m: RasiChats.Msg, all: List<RasiChats.Msg>): String {
+    val from = m.replyFrom.ifBlank { all.firstOrNull { it.id == m.replyId }?.from ?: "" }
+    return if (from.isNotBlank()) from else c.fUid
+}
