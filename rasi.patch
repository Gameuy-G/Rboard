+
+/** Font category tabs and style chips shown above the suggestion bar while the Fancy fonts action is on. */
+@Composable
+fun RasiFontBar() {
+    val visible = RasiFonts.barVisibleState.value
+    AnimatedVisibility(
+        visible = visible,
+        enter = expandVertically(androidx.compose.animation.core.spring(dampingRatio = 0.85f, stiffness = 420f)) + fadeIn(tween(200)),
+        exit = shrinkVertically(tween(180)) + fadeOut(tween(140))
+    ) {
+        val scheme = LocalKeyboardScheme.current
+        val categories = RasiFonts.categories
+        val catIdx = RasiFonts.categoryState.intValue.coerceIn(0, categories.size - 1)
+        val selected = RasiFonts.selectedState.value
+        var searchMode by remember { mutableStateOf(false) }
+        var letter by remember { mutableStateOf("") }
+        val textQuery = remember { mutableStateOf("") }
+
+        Column(Modifier.fillMaxWidth().padding(horizontal = 6.dp, vertical = 2.dp)) {
+            // Category tabs + close
+            Row(
+                Modifier.fillMaxWidth().height(38.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                Row(
+                    Modifier.weight(1f).horizontalScroll(rememberScrollState()),
+                    horizontalArrangement = Arrangement.spacedBy(6.dp),
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    Box(
+                        Modifier
+                            .height(30.dp)
+                            .clip(RoundedCornerShape(16.dp))
+                            .background(
+                                if (searchMode) scheme.base.primary.copy(alpha = 0.25f)
+                                else scheme.extended.keyboardContainer
+                            )
+                            .clickable { searchMode = !searchMode; letter = ""; textQuery.value = "" }
+                            .padding(horizontal = 12.dp),
+                        contentAlignment = Alignment.Center
+                    ) {
+                        Row(verticalAlignment = Alignment.CenterVertically) {
+                            androidx.compose.material3.Icon(
+                                androidx.compose.ui.res.painterResource(org.futo.inputmethod.latin.R.drawable.rasi_search),
+                                contentDescription = null,
+                                tint = scheme.extended.onKeyboardContainer,
+                                modifier = Modifier.size(18.dp)
+                            )
+                            androidx.compose.foundation.layout.Spacer(Modifier.padding(start = 6.dp))
+                            Text("Search", color = scheme.extended.onKeyboardContainer, fontSize = 13.sp, maxLines = 1)
+                        }
+                    }
+                    categories.forEachIndexed { i, cat ->
+                        val shape = RoundedCornerShape(16.dp)
+                        Box(
+                            Modifier
+                                .height(30.dp)
+                                .clip(shape)
+                                .background(
+                                    if (i == catIdx) scheme.base.primary.copy(alpha = 0.25f)
+                                    else scheme.extended.keyboardContainer
+                                )
+                                .clickable { RasiFonts.categoryState.intValue = i }
+                                .padding(horizontal = 12.dp),
+                            contentAlignment = Alignment.Center
+                        ) {
+                            Text(
+                                cat.name,
+                                color = scheme.extended.onKeyboardContainer,
+                                fontSize = 13.sp,
+                                maxLines = 1
+                            )
+                        }
+                    }
+                }
+                Box(
+                    Modifier
+                        .padding(start = 6.dp)
+                        .size(32.dp)
+                        .clip(CircleShape)
+                        .clickable { RasiFonts.closeBar() },
+                    contentAlignment = Alignment.Center
+                ) {
+                    androidx.compose.material3.Icon(RasiIcons.Close, null, Modifier.size(18.dp), tint = scheme.extended.onKeyboardContainer)
+                }
+            }
+
+            // Style chips for the selected category
+            if (searchMode) {
+                ActionHeaderSearch(
+                    textQuery,
+                    Modifier.fillMaxWidth().height(44.dp),
+                    placeholder = "Search fonts"
+                )
+                val letters = remember { ('A'..'Z').map { it.toString() } + listOf("0-9") }
+                LazyRow(
+                    Modifier.fillMaxWidth().height(34.dp),
+                    horizontalArrangement = Arrangement.spacedBy(6.dp),
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    items(letters) { l ->
+                        Box(
+                            Modifier
+                                .height(30.dp)
+                                .clip(RoundedCornerShape(15.dp))
+                                .background(
+                                    if (letter == l) scheme.base.primary.copy(alpha = 0.25f)
+                                    else scheme.extended.keyboardContainer
+                                )
+                                .clickable { letter = if (letter == l) "" else l }
+                                .padding(horizontal = 12.dp),
+                            contentAlignment = Alignment.Center
+                        ) {
+                            Text(l, color = scheme.extended.onKeyboardContainer, fontSize = 13.sp, maxLines = 1)
+                        }
+                    }
+                }
+            }
+            val allStyles = remember { categories.flatMap { it.styles }.distinctBy { it.name } }
+            val styles = if (searchMode) {
+                val q = textQuery.value.trim()
+                val byLetter = if (letter.isEmpty()) allStyles
+                else allStyles.filter {
+                    val c = it.name.firstOrNull()?.uppercaseChar()
+                    if (letter == "0-9") c != null && !c.isLetter() else c?.toString() == letter
+                }
+                if (q.isEmpty()) byLetter
+                else byLetter.filter { it.name.contains(q, ignoreCase = true) }
+            } else categories[catIdx].styles
+            LazyRow(
+                Modifier.fillMaxWidth().height(54.dp),
+                horizontalArrangement = Arrangement.spacedBy(6.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                item(key = "normal") {
+                    FontChip("Normal", "Normal", selected == null, scheme) { RasiFonts.selectedState.value = null }
+                }
+                items(styles) { style ->
+                    val label = remember(style) { style.apply("Abc") }
+                    FontChip(style.name, label, selected === style, scheme) { RasiFonts.selectedState.value = style }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun FontChip(name: String, label: String, isSelected: Boolean, scheme: KeyboardColorScheme, onClick: () -> Unit) {
+    val shape = RoundedCornerShape(20.dp)
+    val interaction = androidx.compose.runtime.remember { androidx.compose.foundation.interaction.MutableInteractionSource() }
+    val pressed = interaction.collectIsPressedAsState().value
+    val scale = androidx.compose.animation.core.animateFloatAsState(
+        if (pressed) 0.92f else if (isSelected) 1.05f else 1f,
+        androidx.compose.animation.core.spring(dampingRatio = 0.55f, stiffness = 500f), label = "chip"
+    ).value
+    val borderColor = androidx.compose.animation.animateColorAsState(
+        if (isSelected) scheme.base.primary else androidx.compose.ui.graphics.Color.Transparent,
+        tween(200), label = "chipBorder"
+    ).value
+    Box(
+        Modifier
+            .height(50.dp)
+            .graphicsLayer { scaleX = scale; scaleY = scale }
+            .clip(shape)
+            .background(scheme.extended.keyboardContainer)
+            .border(2.dp, borderColor, shape)
+            .clickable(interactionSource = interaction, indication = null, onClick = onClick)
+            .padding(horizontal = 14.dp),
+        contentAlignment = Alignment.Center
+    ) {
+        Column(horizontalAlignment = Alignment.CenterHorizontally) {
+            Text(name, color = scheme.extended.onKeyboardContainer.copy(alpha = 0.65f), fontSize = 10.sp, maxLines = 1)
+            Text(label, color = scheme.extended.onKeyboardContainer, fontSize = 16.sp, maxLines = 1)
+        }
+    }
+}
