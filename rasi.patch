+internal const val GEM_PREFIX = "Gemini: "
+internal val GEM_COLOR: Int = 0xFF4285F4.toInt()
+
+internal fun buildRows(msgs: List<RasiChats.Msg>, discord: Boolean, look: ChatLook): List<ChatRow> {
+    val out = ArrayList<ChatRow>(msgs.size + 8)
+    val groupMs = look.dcGroupMin * 60000L
+    var prev: RasiChats.Msg? = null
+    for (m in msgs) {
+        val newDay = prev == null || dayKey(prev.at) != dayKey(m.at)
+        if (newDay && m.at > 0L && look.dcDates) {
+            out.add(ChatRow.Day(dayKey(m.at), java.text.SimpleDateFormat("MMMM d, yyyy", java.util.Locale.getDefault()).format(java.util.Date(m.at))))
+        }
+        val header = !discord || newDay || groupMs == 0L || prev!!.from != m.from || m.at - prev.at > groupMs || m.replyId.isNotBlank() || m.text.startsWith(GEM_PREFIX) || prev.text.startsWith(GEM_PREFIX)
+        out.add(ChatRow.M(m, header))
+        prev = m
+    }
+    return out
+}
