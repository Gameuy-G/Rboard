+
+/** Two emojis slide together, a "poof" puff appears, then the mashup pops out with a bounce. */
+@Composable
+private fun CombineSlot(
+    prev: String,
+    last: String,
+    combo: KitchenCombo,
+    manager: KeyboardManagerForAction?,
+    size: Dp
+) {
+    val progress = remember(combo.key) { Animatable(0f) }
+    LaunchedEffect(combo.key) {
+        progress.snapTo(0f)
+        progress.animateTo(1f, tween(900, easing = LinearEasing))
+    }
+    val p = progress.value
+    Box(Modifier.size(size), contentAlignment = Alignment.Center) {
+        if (p < 0.4f) {
+            val t = FastOutSlowInEasing.transform(p / 0.4f)
+            val d = (24f * (1f - t)).dp
+            val sc = 1f + 0.2f * t
+            Text(prev, fontSize = 26.sp, modifier = Modifier.offset(x = -d).scale(sc))
+            Text(last, fontSize = 26.sp, modifier = Modifier.offset(x = d).scale(sc))
+        } else if (p < 0.75f) {
+            val t = (p - 0.4f) / 0.35f
+            Canvas(Modifier.fillMaxSize()) {
+                val m = this.size.minDimension
+                val a = (1f - t).coerceIn(0f, 1f)
+                val c = Offset(this.size.width / 2f, this.size.height / 2f)
+                drawCircle(Color.White.copy(alpha = a * 0.9f), m * (0.15f + 0.25f * t), c)
+                for (i in 0 until 8) {
+                    val ang = i * (PI.toFloat() / 4f)
+                    val dist = m * 0.42f * t
+                    val r = m * 0.12f * (1f - 0.5f * t)
+                    drawCircle(
+                        Color(0xFFFFE9A8).copy(alpha = a),
+                        r,
+                        Offset(c.x + cos(ang) * dist, c.y + sin(ang) * dist)
+                    )
+                }
+            }
+        }
+        if (p >= 0.5f) {
+            val t = ((p - 0.5f) / 0.5f).coerceIn(0f, 1f)
+            val sc = 0.3f + 0.7f * t + 0.18f * sin(PI.toFloat() * t)
+            SendableCombo(
+                combo, manager,
+                Modifier.size(size).scale(sc)
+            )
+        }
+    }
+}
+
+/** The "Emoji Kitchen" row shown at the top of the emoji tab. */
+@Composable
+fun RasiKitchenSection(manager: KeyboardManagerForAction?) {
+    val context = LocalContext.current
+    val ctx by rememberRasiCtx(manager, Unit)
+    LaunchedEffect(Unit) { RasiKitchen.loadRecents(context) }
+    val recents by RasiKitchen.recents
+    val labelColor = LocalKeyboardScheme.current.onKeyboardContainer
+    val slot = 52.dp
+
+    val pair = ctx.pairCombo
+    val tapped by RasiKitchenPanelState.lastTapped
+    val tappedCombos = remember(tapped) {
+        tapped?.let { RasiKitchen.combosForEmoji(context, it) } ?: emptyList()
+    }
+    val useTapped = tappedCombos.isNotEmpty()
+    val list: List<KitchenCombo> =
+        ((if (useTapped) tappedCombos else ctx.combos).filter { it.key != pair?.key } + recents).distinctBy { it.key }
+
+    // Snap back to the first item whenever the suggestions change, so a new combo is visible
+    val listState = rememberLazyListState()
+    LaunchedEffect(pair?.key, tapped, ctx.lastEmoji, ctx.prevEmoji) {
+        listState.scrollToItem(0)
+    }
+
+    Column(Modifier.fillMaxWidth().padding(top = 2.dp)) {
+        Text(
+            "Emoji Kitchen",
+            fontSize = 13.sp,
+            color = labelColor,
+            modifier = Modifier.padding(start = 12.dp, bottom = 2.dp)
+        )
+        Row(Modifier.fillMaxWidth().height(slot + 6.dp), verticalAlignment = Alignment.CenterVertically) {
+            LazyRow(
+                Modifier.weight(1.0f),
+                state = listState,
+                horizontalArrangement = Arrangement.spacedBy(6.dp),
+                verticalAlignment = Alignment.CenterVertically,
+                contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = 8.dp)
+            ) {
+                if (pair != null && ctx.prevEmoji != null && ctx.lastEmoji != null) {
+                    item(key = "pair_" + pair.key) {
+                        CombineSlot(ctx.prevEmoji!!, ctx.lastEmoji!!, pair, manager, slot)
+                    }
+                    item(key = "pair_divider") {
+                        Box(Modifier.width(1.dp).height(36.dp).background(labelColor.copy(alpha = 0.3f)))
+                    }
+                }
+                items(list, key = { it.key }) { combo ->
+                    SendableCombo(combo, manager, Modifier.size(slot))
+                }
+            }
+            Box(
+                Modifier.padding(horizontal = 8.dp).size(40.dp).clip(CircleShape)
+                    .background(labelColor.copy(alpha = 0.12f))
+                    .clickable {
+                        RasiKitchenPanelState.tab.value = 0
+                        RasiKitchenPanelState.browse.value = true
+                    },
+                contentAlignment = Alignment.Center
+            ) {
+                Icon(
+                    painterResource(R.drawable.rasi_pencil),
+                    contentDescription = "All combos",
+                    tint = labelColor,
+                    modifier = Modifier.size(20.dp)
+                )
+            }
+        }
+    }
+}
+
+/** Full list of every kitchen sticker for the typed emoji (or emoji pair). */
+@Composable
+fun RasiKitchenBrowse(manager: KeyboardManagerForAction?, modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    val ctx by rememberRasiCtx(manager, Unit)
+    LaunchedEffect(Unit) { RasiKitchen.loadRecents(context); RasiKitchen.loadLiked(context) }
+    val recents by RasiKitchen.recents
+    val likedList by RasiKitchen.liked
+    val tab by RasiKitchenPanelState.tab
+    val labelColor = LocalKeyboardScheme.current.onKeyboardContainer
+
+    val picked by RasiKitchenPanelState.picked
+    val all = remember(picked, ctx.lastEmoji, ctx.prevEmoji) {
+        when {
+            picked.isNotEmpty() -> RasiKitchen.allFor(picked.last(), picked.getOrNull(picked.size - 2))
+            ctx.lastEmoji != null -> RasiKitchen.allFor(ctx.lastEmoji, ctx.prevEmoji)
+            else -> emptyList()
+        }
+    }
+    val shown = when (tab) {
+        1 -> recents
+        2 -> likedList
+        else -> if (all.isNotEmpty()) all else recents
+    }
+
+    Box(modifier) {
+    Column(Modifier.fillMaxSize()) {
+        LazyVerticalGrid(
+            columns = GridCells.Fixed(4),
+            modifier = Modifier.fillMaxWidth().weight(1.0f),
+            contentPadding = androidx.compose.foundation.layout.PaddingValues(start = 6.dp, end = 6.dp, top = 6.dp, bottom = 76.dp),
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+            verticalArrangement = Arrangement.spacedBy(6.dp)
+        ) {
+            items(shown, key = { it.key }) { combo ->
+                SendableCombo(
+                    combo, manager, Modifier.fillMaxWidth().aspectRatio(1f), allowLike = true,
+                    deleteCtx = if (tab == 0 && picked.isEmpty() && ctx.lastEmoji != null) ctx else null
+                )
+            }
+        }
+        if (tab == 2 && likedList.isEmpty()) {
+            Text(
+                "Long-press a sticker to like it",
+                fontSize = 13.sp,
+                color = labelColor.copy(alpha = 0.7f),
+                modifier = Modifier.padding(start = 12.dp, bottom = 6.dp)
+            )
+        }
+    }
+    val chip = if (picked.isNotEmpty()) picked.joinToString(" ") else ""
+    Row(
+        Modifier
+            .align(Alignment.BottomEnd)
+            .padding(end = 12.dp, bottom = 12.dp)
+            .clip(RoundedCornerShape(24.dp))
+            .background(LocalKeyboardScheme.current.keyboardContainer)
+            .clickable { RasiKitchenPanelState.pickerOpen.value = true }
+            .padding(horizontal = 18.dp, vertical = 12.dp),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        Icon(painterResource(R.drawable.smile), null, tint = labelColor, modifier = Modifier.size(24.dp))
+        Text(if (chip.isNotEmpty()) chip else "Pick emoji", fontSize = 18.sp, color = labelColor)
+        if (chip.isNotEmpty()) {
+            Text(
+                "\u2715", fontSize = 16.sp, color = labelColor,
+                modifier = Modifier.clickable { RasiKitchenPanelState.picked.value = emptyList() }
+            )
+        }
+    }
+    }
+}
