+            Spacer(Modifier.weight(1f))
+            OutlinedButton(contentPadding = pad, enabled = ed.redo.isNotEmpty(), onClick = { ed.doRedo() }) {
+                androidx.compose.material3.Icon(org.futo.inputmethod.latin.uix.RasiIcons.Redo, null, Modifier.size(22.dp))
+            }
+            OutlinedButton(contentPadding = pad, enabled = ed.undo.isNotEmpty(), onClick = { ed.doUndo() }) {
+                androidx.compose.material3.Icon(org.futo.inputmethod.latin.uix.RasiIcons.Undo, null, Modifier.size(22.dp))
+            }
+        }
+
+        if (!rasiCompact) {
+            canvasBlock(Modifier.weight(1f).heightIn(min = 110.dp).fillMaxWidth())
+            controlsBlock(Modifier.fillMaxWidth().heightIn(max = 190.dp).verticalScroll(rememberScrollState()))
+            tabsBlock(Modifier.fillMaxWidth())
+        } else {
+            Row(Modifier.weight(1f).fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                canvasBlock(Modifier.weight(1.2f).fillMaxHeight())
+                Column(
+                    Modifier.weight(0.8f).fillMaxHeight().verticalScroll(rememberScrollState()),
+                    verticalArrangement = Arrangement.spacedBy(4.dp)
+                ) {
+                    controlsBlock(Modifier.fillMaxWidth())
+                    tabsBlock(Modifier.fillMaxWidth())
+                }
+            }
+        }
+    }
