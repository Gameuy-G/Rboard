+
+class GalleryItem(
+    val id: Long,
+    val uri: Uri,
+    val video: Boolean,
+    val durationMs: Long,
+    val size: Long
+)
+
+/** Reads the phone gallery (photos and videos) for the mini picker inside the Gemini panel. */
+object RasiGallery {
+    /** Permissions to request from a settings screen (a keyboard cannot show the permission prompt). */
+    fun permissions(): Array<String> = when {
+        Build.VERSION.SDK_INT >= 34 -> arrayOf(
+            Manifest.permission.READ_MEDIA_IMAGES,
+            Manifest.permission.READ_MEDIA_VIDEO,
+            "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
+        )
+        Build.VERSION.SDK_INT >= 33 -> arrayOf(
+            Manifest.permission.READ_MEDIA_IMAGES,
+            Manifest.permission.READ_MEDIA_VIDEO
+        )
+        else -> arrayOf(Manifest.permission.READ_EXTERNAL_STORAGE)
+    }
+
+    private fun granted(c: Context, p: String) =
+        ContextCompat.checkSelfPermission(c, p) == PackageManager.PERMISSION_GRANTED
+
+    /** True when at least some photos or videos can be read (full or partial access). */
+    fun hasAccess(c: Context): Boolean = when {
+        Build.VERSION.SDK_INT >= 34 ->
+            granted(c, Manifest.permission.READ_MEDIA_IMAGES) ||
+                granted(c, Manifest.permission.READ_MEDIA_VIDEO) ||
+                granted(c, "android.permission.READ_MEDIA_VISUAL_USER_SELECTED")
+        Build.VERSION.SDK_INT >= 33 ->
+            granted(c, Manifest.permission.READ_MEDIA_IMAGES) || granted(c, Manifest.permission.READ_MEDIA_VIDEO)
+        else -> granted(c, Manifest.permission.READ_EXTERNAL_STORAGE)
+    }
+
+    /** True when videos can be read (full video access, or a partial pick on Android 14+). */
+    fun hasVideoAccess(c: Context): Boolean = when {
+        Build.VERSION.SDK_INT >= 34 ->
+            granted(c, Manifest.permission.READ_MEDIA_VIDEO) ||
+                granted(c, "android.permission.READ_MEDIA_VISUAL_USER_SELECTED")
+        Build.VERSION.SDK_INT >= 33 -> granted(c, Manifest.permission.READ_MEDIA_VIDEO)
+        else -> granted(c, Manifest.permission.READ_EXTERNAL_STORAGE)
+    }
+
+    /** True when ALL videos can be read (not just a partial pick). */
+    fun hasFullVideoAccess(c: Context): Boolean = when {
+        Build.VERSION.SDK_INT >= 33 -> granted(c, Manifest.permission.READ_MEDIA_VIDEO)
+        else -> granted(c, Manifest.permission.READ_EXTERNAL_STORAGE)
+    }
+
+    private fun queryOne(c: Context, video: Boolean, limit: Int): List<Pair<Long, GalleryItem>> {
+        val out = ArrayList<Pair<Long, GalleryItem>>()
+        try {
+            val base = if (video) MediaStore.Video.Media.EXTERNAL_CONTENT_URI else MediaStore.Images.Media.EXTERNAL_CONTENT_URI
+            val projection = if (video)
+                arrayOf("_id", "_size", "date_added", "duration")
+            else
+                arrayOf("_id", "_size", "date_added")
+            c.contentResolver.query(base, projection, null, null, "date_added DESC")?.use {
+                val iId = it.getColumnIndexOrThrow("_id")
+                val iSize = it.getColumnIndexOrThrow("_size")
+                val iDate = it.getColumnIndexOrThrow("date_added")
+                val iDur = it.getColumnIndex("duration")
+                var n = 0
+                while (it.moveToNext() && n < limit) {
+                    val id = it.getLong(iId)
+                    out.add(
+                        it.getLong(iDate) to GalleryItem(
+                            id, ContentUris.withAppendedId(base, id), video,
+                            if (iDur >= 0 && !it.isNull(iDur)) it.getLong(iDur) else 0L,
+                            it.getLong(iSize)
+                        )
+                    )
+                    n++
+                }
+            }
+        } catch (e: Throwable) {
+        }
+        return out
+    }
+
+    /** filter: 0 all, 1 photos, 2 videos. Newest first. Photos and videos are read from their own collections. */
+    fun query(c: Context, filter: Int, limit: Int = 240): List<GalleryItem> {
+        val all = ArrayList<Pair<Long, GalleryItem>>()
+        if (filter != 2) all.addAll(queryOne(c, false, limit))
+        if (filter != 1) all.addAll(queryOne(c, true, limit))
+        return all.sortedByDescending { it.first }.take(limit).map { it.second }
+    }
+
+    @Suppress("DEPRECATION")
+    fun thumbnail(c: Context, item: GalleryItem, px: Int): Bitmap? = try {
+        if (Build.VERSION.SDK_INT >= 29) {
+            c.contentResolver.loadThumbnail(item.uri, Size(px, px), null)
+        } else if (item.video) {
+            MediaStore.Video.Thumbnails.getThumbnail(c.contentResolver, item.id, MediaStore.Video.Thumbnails.MINI_KIND, null)
+        } else {
+            MediaStore.Images.Thumbnails.getThumbnail(c.contentResolver, item.id, MediaStore.Images.Thumbnails.MINI_KIND, null)
+        }
+    } catch (e: Throwable) {
+        null
+    }
+
+    fun duration(ms: Long): String {
+        val s = (ms / 1000).toInt()
+        return (s / 60).toString() + ":" + (s % 60).toString().padStart(2, '0')
+    }
+}
+
+/** A grid of gallery photos and videos that lives inside the Gemini panel, so the keyboard stays open. */
+@Composable
+fun RasiGalleryPicker(maxPick: Int, onClose: () -> Unit, onAttach: (List<GalleryItem>) -> Unit, fallbackKind: String = "gemini") {
+    val context = LocalContext.current
+    val sch = LocalKeyboardScheme.current
+    var filter by remember { mutableIntStateOf(0) }
+    var items by remember { mutableStateOf<List<GalleryItem>?>(null) }
+    val selected = remember { mutableStateListOf<GalleryItem>() }
+
+    LaunchedEffect(filter) {
+        items = null
+        items = withContext(Dispatchers.IO) { RasiGallery.query(context, filter) }
+    }
+
+    Surface(
+        color = sch.keyboardContainer,
+        contentColor = sch.onKeyboardContainer,
+        shape = RoundedCornerShape(20.dp),
+        modifier = Modifier.fillMaxSize()
+    ) {
+        Column(Modifier.padding(8.dp)) {
+            Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.fillMaxWidth()) {
+                val labels = listOf("All", "Photos", "Videos")
+                labels.forEachIndexed { i, label ->
+                    val on = filter == i
+                    Box(
+                        Modifier
+                            .clip(RoundedCornerShape(14.dp))
+                            .background(if (on) sch.primary else sch.onKeyboardContainer.copy(alpha = 0.12f))
+                            .clickable { filter = i }
+                            .padding(horizontal = 12.dp, vertical = 6.dp)
+                    ) {
+                        Text(label, fontSize = 13.sp, color = if (on) sch.onPrimary else sch.onKeyboardContainer)
+                    }
+                    Spacer(Modifier.size(6.dp))
+                }
+                Spacer(Modifier.weight(1f))
+                Button(
+                    enabled = selected.isNotEmpty(),
+                    onClick = { onAttach(selected.toList()) }
+                ) { Text("Attach (" + selected.size + ")") }
+                Spacer(Modifier.size(6.dp))
+                Box(
+                    Modifier.size(36.dp).clip(RoundedCornerShape(18.dp)).clickable { onClose() },
+                    contentAlignment = Alignment.Center
+                ) { androidx.compose.material3.Icon(org.futo.inputmethod.latin.uix.RasiIcons.Close, null, Modifier.size(20.dp)) }
+            }
+
+            val list = items
+            if (list == null) {
+                Text("Loading...", modifier = Modifier.padding(16.dp))
+            } else if (list.isEmpty()) {
+                Column(Modifier.padding(16.dp)) {
+                    Text(
+                        if (filter != 1 && !RasiGallery.hasVideoAccess(context))
+                            "Videos are not shown because only some photos were allowed. Use the button below to pick a video from files."
+                        else
+                            "No photos or videos found. If you only allowed some photos, allow more in the phone settings."
+                    )
+                    Spacer(Modifier.size(8.dp))
+                    Button(onClick = {
+                        val pi = android.content.Intent(context, RasiPickerActivity::class.java)
+                        pi.putExtra("kind", fallbackKind)
+                        pi.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK)
+                        context.startActivity(pi)
+                        onClose()
+                    }) { Text("Pick from files") }
+                }
+            } else {
+                LazyVerticalGrid(
+                    columns = GridCells.Adaptive(84.dp),
+                    horizontalArrangement = Arrangement.spacedBy(4.dp),
+                    verticalArrangement = Arrangement.spacedBy(4.dp),
+                    modifier = Modifier.fillMaxSize().padding(top = 6.dp)
+                ) {
+                    items(list, key = { it.uri.toString() }) { item ->
+                        val thumb by produceState<Bitmap?>(null, item) {
+                            value = withContext(Dispatchers.IO) { RasiGallery.thumbnail(context, item, 256) }
+                        }
+                        val idx = selected.indexOfFirst { it.id == item.id && it.video == item.video }
+                        Box(
+                            Modifier
+                                .aspectRatio(1f)
+                                .clip(RoundedCornerShape(8.dp))
+                                .background(sch.onKeyboardContainer.copy(alpha = 0.1f))
+                                .then(
+                                    if (idx >= 0) Modifier.border(3.dp, sch.primary, RoundedCornerShape(8.dp)) else Modifier
+                                )
+                                .clickable {
+                                    if (idx >= 0) selected.removeAt(idx)
+                                    else if (selected.size < maxPick) selected.add(item)
+                                }
+                        ) {
+                            val b = thumb
+                            if (b != null) {
+                                Image(b.asImageBitmap(), null, Modifier.fillMaxSize(), contentScale = ContentScale.Crop)
+                            }
+                            if (item.video) {
+                                Box(
+                                    Modifier.align(Alignment.BottomStart).padding(4.dp)
+                                        .clip(RoundedCornerShape(6.dp))
+                                        .background(Color.Black.copy(alpha = 0.6f))
+                                        .padding(horizontal = 5.dp, vertical = 1.dp)
+                                ) {
+                                    Text(
+                                        "\u25B6 " + (if (item.durationMs > 0) RasiGallery.duration(item.durationMs) else ""),
+                                        fontSize = 11.sp, color = Color.White
+                                    )
+                                }
+                            }
+                            if (idx >= 0) {
+                                Box(
+                                    Modifier.align(Alignment.TopEnd).padding(4.dp).size(22.dp)
+                                        .clip(RoundedCornerShape(11.dp)).background(sch.primary),
+                                    contentAlignment = Alignment.Center
+                                ) { Text((idx + 1).toString(), fontSize = 12.sp, color = sch.onPrimary) }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
