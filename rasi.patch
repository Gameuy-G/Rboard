+    /** Rewrites the order of the given entries (ascending history order) inside the history. */
+    fun rasiApplyOrder(oldVisible: List<ClipboardEntry>, newVisible: List<ClipboardEntry>) {
+        if(oldVisible.size != newVisible.size) return
+        val slots = oldVisible.map { clipboardHistory.indexOf(it) }.sorted()
+        if(slots.any { it < 0 } || slots.toSet().size != slots.size) return
+        slots.forEachIndexed { n, slot -> clipboardHistory[slot] = newVisible[n] }
+        saveClipboard()
+    }
+
+    fun rasiEditText(item: ClipboardEntry, newText: String) {
+        if(item.text == null || newText.isEmpty() || newText == item.text) return
+        val idx = clipboardHistory.indexOf(item)
+        if(idx < 0) return
+        val section = RasiSections.sectionOf(item)
+        val updated = item.copy(text = newText)
+        clipboardHistory[idx] = updated
+        if(section != null) {
+            RasiSections.assign(item, null)
+            RasiSections.assign(updated, section)
+        }
+        saveClipboard()
+    }
