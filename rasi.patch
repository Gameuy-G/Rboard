+        "m" to "\u03BC", "n" to "\u03BD", "x" to "\u03BE", "o" to "\u03BF", "p" to "\u03C0", "r" to "\u03C1",
+        "s" to "\u03C3", "t" to "\u03C4", "u" to "\u03C5", "y" to "\u03C5", "f" to "\u03C6", "w" to "\u03C9",
+        "q" to "\u03B8", "c" to "\u03BA", "j" to "\u03BE"
+    )
+
+    private val arabicBase = arrayOf(
+        "sh" to "\u0634", "kh" to "\u062E", "gh" to "\u063A", "th" to "\u062B", "dh" to "\u0630",
+        "aa" to "\u0622", "a" to "\u0627", "b" to "\u0628", "t" to "\u062A", "j" to "\u062C", "H" to "\u062D",
+        "d" to "\u062F", "r" to "\u0631", "z" to "\u0632", "s" to "\u0633", "S" to "\u0635", "D" to "\u0636",
+        "T" to "\u0637", "Z" to "\u0638", "E" to "\u0639", "g" to "\u063A", "f" to "\u0641", "q" to "\u0642",
+        "k" to "\u0643", "l" to "\u0644", "m" to "\u0645", "n" to "\u0646", "h" to "\u0647", "w" to "\u0648",
+        "y" to "\u064A", "i" to "\u064A", "u" to "\u0648", "o" to "\u0648", "e" to "\u064A", "x" to "\u0643\u0633",
+        "c" to "\u0643", "v" to "\u0641", "p" to "\u0628"
+    )
+    private val arabic = alphabet("ar", false, *arabicBase)
+    private val urdu = alphabet("ur", false, *(arabicBase + arrayOf(
+        "ch" to "\u0686", "zh" to "\u0698", "p" to "\u067E", "g" to "\u06AF", "k" to "\u06A9", "h" to "\u06C1",
+        "y" to "\u06CC", "i" to "\u06CC", "e" to "\u06D2", "N" to "\u06BA", "R" to "\u0691", "T" to "\u0679",
+        "D" to "\u0688", "v" to "\u0648", "c" to "\u0633"
+    )))
+
+    private val scripts: List<Script> = listOf(
+        bangla, hindi,
+        Script("as", bangla.cons, bangla.vowels, bangla.signs, bangla.virama, bangla.ra),
+        derive("mr", hindi, 0), derive("ne", hindi, 0),
+        derive("gu", hindi, 0x180), derive("pa", hindi, 0x100), derive("or", hindi, 0x200),
+        derive("ta", hindi, 0x280), derive("te", hindi, 0x300), derive("kn", hindi, 0x380), derive("ml", hindi, 0x400),
+        russian, ukrainian, greek, arabic, urdu
+    )
+
+    class Lang(val id: String, val label: String, val nativeName: String)
+
+    @JvmField
+    val langs: List<Lang> = listOf(
+        Lang("bn", "Bangla", "\u09AC\u09BE\u0982\u09B2\u09BE"),
+        Lang("hi", "Hindi", "\u0939\u093F\u0928\u094D\u0926\u0940"),
+        Lang("as", "Assamese", "\u0985\u09B8\u09AE\u09C0\u09AF\u09BC\u09BE"),
+        Lang("mr", "Marathi", "\u092E\u0930\u093E\u0920\u0940"),
+        Lang("ne", "Nepali", "\u0928\u0947\u092A\u093E\u0932\u0940"),
+        Lang("gu", "Gujarati", "\u0A97\u0AC1\u0A9C\u0AB0\u0ABE\u0AA4\u0AC0"),
+        Lang("pa", "Punjabi", "\u0A2A\u0A70\u0A1C\u0A3E\u0A2C\u0A40"),
+        Lang("or", "Odia", "\u0B13\u0B21\u0B3C\u0B3F\u0B06"),
+        Lang("ta", "Tamil", "\u0BA4\u0BAE\u0BBF\u0BB4\u0BCD"),
+        Lang("te", "Telugu", "\u0C24\u0C46\u0C32\u0C41\u0C17\u0C41"),
+        Lang("kn", "Kannada", "\u0C95\u0CA8\u0CCD\u0CA8\u0CA1"),
+        Lang("ml", "Malayalam", "\u0D2E\u0D32\u0D2F\u0D3E\u0D33\u0D02"),
+        Lang("ru", "Russian", "\u0420\u0443\u0441\u0441\u043A\u0438\u0439"),
+        Lang("uk", "Ukrainian", "\u0423\u043A\u0440\u0430\u0457\u043D\u0441\u044C\u043A\u0430"),
+        Lang("el", "Greek", "\u0395\u03BB\u03BB\u03B7\u03BD\u03B9\u03BA\u03AC"),
+        Lang("ar", "Arabic", "\u0627\u0644\u0639\u0631\u0628\u064A\u0629"),
+        Lang("ur", "Urdu", "\u0627\u0631\u062F\u0648")
+    )
+
+    @JvmStatic fun supports(lang: String) = langs.any { it.id == lang }
+    @JvmStatic fun nativeName(lang: String) = langs.firstOrNull { it.id == lang }?.nativeName ?: lang
+    @JvmStatic fun isAbcLayout(lang: String, layout: String) = layout == "qwerty" && supports(lang)
+
+    private const val PREFS = "rasi_phonetic"
+
+    @Volatile private var enabled = false
+    @Volatile private var scriptId = "bn"
+    @Volatile private var loaded = false
+    @Volatile private var broken = false
+
+    private fun prefs(c: Context) = c.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    @JvmStatic
+    fun reload(c: Context) {
+        val p = prefs(c)
+        enabled = p.getBoolean("enabled", false)
+        scriptId = p.getString("script", "bn") ?: "bn"
+        loaded = true
+        clear()
+    }
+
+    @JvmStatic fun setEnabled(c: Context, on: Boolean) { prefs(c).edit().putBoolean("enabled", on).apply(); reload(c) }
+    @JvmStatic fun setScript(c: Context, id: String) { prefs(c).edit().putString("script", id).apply(); reload(c) }
+    fun isEnabledPref(c: Context) = prefs(c).getBoolean("enabled", false)
+    fun scriptPref(c: Context) = prefs(c).getString("script", "bn") ?: "bn"
+
+    /** Phonetic code never crashes the keyboard: the error is saved (shown in its settings page) and phonetic pauses. */
+    @JvmStatic
+    fun fail(c: Context, t: Throwable) {
+        broken = true
+        try {
+            val top = t.stackTrace.take(6).joinToString("\n") { it.toString() }
+            prefs(c).edit().putString("last_error", t.toString() + "\n" + top).apply()
+        } catch (e: Throwable) { }
+        try { clear() } catch (e: Throwable) { }
+    }
+
+    fun lastError(c: Context): String = prefs(c).getString("last_error", "") ?: ""
+    fun clearError(c: Context) { prefs(c).edit().remove("last_error").apply(); broken = false }
+
+    private fun subtypeLang(): String? = try {
+        val st = RichInputMethodManager.getInstance().currentSubtype
+        val l = st.locale.language
+        if (isAbcLayout(l, st.keyboardLayoutSetName)) l else null
+    } catch (e: Throwable) { null }
+
+    @JvmStatic
+    fun active(c: Context): Boolean {
+        if (broken) return false
+        return try {
+            if (!loaded) reload(c)
+            enabled || subtypeLang() != null
+        } catch (t: Throwable) { fail(c, t); false }
+    }
+
+    fun scriptObj(id: String): Script? = scripts.firstOrNull { it.id == id }
+
+    private fun script(): Script = scripts.firstOrNull { it.id == (subtypeLang() ?: scriptId) } ?: bangla
+
+    // ---- state of the word being typed
+    private val buffer = StringBuilder()   // the English letters
+    private var shown = ""                 // what the text box currently shows
+    private var english = false            // true after backspace: the word is plain English
+    private var lastRaw = ""
+    private var lastConv = ""
+
+    /** The English letters of the word being typed (empty when no word). */
+    @JvmStatic fun rawWord(): String = buffer.toString()
+    /** True while the word on screen is the converted script (not plain English after a backspace). */
+    @JvmStatic fun inConversion(): Boolean = buffer.isNotEmpty() && !english
+    @JvmStatic fun scriptNow(): String = script().id
+
+    @JvmStatic fun netEnabled(c: Context) = prefs(c).getBoolean("net", true)
+    @JvmStatic fun setNet(c: Context, on: Boolean) { prefs(c).edit().putBoolean("net", on).apply() }
+
+    /** A suggestion was tapped: remember the pick and finish the word. */
+    @JvmStatic
+    fun onPicked(c: Context, word: String) {
+        if (buffer.isEmpty()) return
+        val raw = buffer.toString()
+        val isEmoji = word.isNotEmpty() && Character.getType(word.codePointAt(0)) == Character.OTHER_SYMBOL.toInt()
+        if (isEmoji) {
+            clearLast()
+        } else if (!english && word != raw) {
+            try { RasiPhoneticBar.learn(c, script().id, raw, word) } catch (t: Throwable) { }
+            lastRaw = raw; lastConv = word
+        } else clearLast()
+        buffer.setLength(0); shown = ""; english = false
+    }
+
+    @JvmStatic fun accepts(cp: Int) = (cp in 65..90) || (cp in 97..122) || (buffer.isNotEmpty() && (cp == '^'.code || cp == ':'.code))
+    @JvmStatic fun hasBuffer() = buffer.isNotEmpty()
+    @JvmStatic fun shown(): String = shown
+    @JvmStatic fun clear() { buffer.setLength(0); shown = ""; english = false }
+    @JvmStatic fun clearLast() { lastRaw = ""; lastConv = "" }
+
+    private fun render(): String = when {
+        buffer.isEmpty() -> ""
+        english -> buffer.toString()
+        else -> transliterate(script(), buffer.toString())
+    }
+
+    @JvmStatic
+    fun append(cp: Int): String {
+        if (buffer.isEmpty()) { english = false; clearLast() }
+        buffer.appendCodePoint(cp)
+        shown = render()
+        return shown
+    }
+
+    /** First backspace turns the word back into English letters, later ones delete letters. */
+    @JvmStatic
+    fun backspace(): String {
+        if (!english) {
+            english = true
+        } else if (buffer.isNotEmpty()) {
+            buffer.setLength(buffer.length - 1)
+        }
+        shown = render()
+        return shown
+    }
+
+    /** A non-letter key ended the word. Remembers it when it was converted and ended with a space. */
+    @JvmStatic
+    fun endWord(bySpace: Boolean) {
+        if (bySpace && !english && shown.isNotEmpty() && shown != buffer.toString()) {
+            lastRaw = buffer.toString(); lastConv = shown
+        } else clearLast()
+        buffer.setLength(0); shown = ""; english = false
+    }
+
+    @JvmStatic fun canRevert() = lastConv.isNotEmpty()
+    @JvmStatic fun lastConv(): String = lastConv
+
+    /** Backspace right after a converted word plus space: bring the English letters back for editing. */
+    @JvmStatic
+    fun revert(): String {
+        buffer.setLength(0); buffer.append(lastRaw)
+        english = true
+        shown = lastRaw
+        clearLast()
+        return shown
+    }
+
+    fun transliterate(s: Script, input: String): String {
+        val out = StringBuilder()
+        var lastCons = false
+        var lastRa = false
+        var i = 0
+        while (i < input.length) {
+            var matched = false
+            var len = minOf(s.maxLen, input.length - i)
+            while (len >= 1) {
+                val tok = input.substring(i, i + len)
+                // a capital letter with no meaning of its own (A, K, Ami at a sentence start) acts like lowercase
+                val low = tok.lowercase()
+                val hasExact = s.cons.containsKey(tok) || s.vowels.containsKey(tok) || s.signs.containsKey(tok)
+                val key = if (hasExact) tok else low
+                val c = s.cons[key]
+                val v = s.vowels[key]
+                val g = s.signs[key]
+                val upper = s.caseMap && !hasExact && tok[0].isUpperCase()
+                if (g != null) {
+                    out.append(g); lastCons = false
+                } else if (c != null) {
+                    if (lastCons && !lastRa) out.append(s.virama)
+                    out.append(if (upper) c.uppercase() else c); lastCons = true; lastRa = (c == s.ra)
+                } else if (v != null) {
+                    out.append(if (lastCons) v.second else v.first); lastCons = false
+                } else { len--; continue }
+                i += len; matched = true; break
+            }
+            if (!matched) { out.append(input[i]); lastCons = false; i++ }
+        }
+        return out.toString()
+    }
+}
