+internal fun DiscordMsg(
+    c: ChatCtx, m: RasiChats.Msg, all: List<RasiChats.Msg>, header: Boolean, flash: Boolean, seen: Boolean,
+    onJump: (String) -> Unit, onReact: (String) -> Unit, onLong: () -> Unit, menu: @Composable () -> Unit
+) {
+    val look = c.look
+    val isMine = m.from == c.uid
+    val pingMe = look.pingOn && m.ping && !isMine
+    val gem = m.text.startsWith(GEM_PREFIX)
+    val shown = if (gem) m.text.removePrefix(GEM_PREFIX) else m.text
+    val sender = if (isMine) null else c.who?.invoke(m.from)
+    val name = if (gem) "Gemini" else if (isMine) c.myName else sender?.first ?: c.fName
+    val accent = if (gem) GEM_COLOR else if (isMine) c.myAccent else sender?.second ?: c.fAccent
+    val nameColor = if (gem) Color(GEM_COLOR) else if (look.dcNameAccent || c.forceAccent) Color(accent) else MaterialTheme.colorScheme.primary
+    val soft = LocalContentColor.current.copy(alpha = 0.6f)
+    val tint = if (flash) look.pingColor.copy(alpha = 0.28f) else if (pingMe) look.pingColor.copy(alpha = look.pingTint) else Color.Transparent
+    Box(Modifier.fillMaxWidth()) {
+        Column(
+            Modifier.fillMaxWidth().padding(top = if (header) look.dcSpace.dp else 1.dp)
+                .then(if (look.dcCard) Modifier.clip(RoundedCornerShape(8.dp)).background(Color.Black.copy(alpha = look.dcCardA)) else Modifier)
+                .background(tint)
+                .then(if (pingMe && look.pingBar) Modifier.drawBehind { drawRect(look.pingColor, size = Size(3.dp.toPx(), size.height)) } else Modifier)
+                .combinedClickable(onClick = {}, onLongClick = onLong)
+                .padding(horizontal = 6.dp, vertical = 2.dp)
+        ) {
+            if (m.replyText.isNotBlank()) {
+                val a = replyAuthor(c, m, all)
+                ReplyPreviewDc(a.first, if (look.dcNameAccent || c.forceAccent) Color(a.second) else MaterialTheme.colorScheme.primary, m.replyText,
+                    a.third, replyUid(c, m, all), if (look.dcAvatar) look.dcAvSize / 2 else 0, if (look.jump) ({ onJump(m.replyId) }) else null)
+            }
+            Row {
+                if (look.dcAvatar) {
+                    if (header) ChatAv(if (gem) "\u2726" else if (isMine) c.myAv else sender?.third?.first ?: c.fAv, if (gem) GEM_COLOR else if (isMine) c.myAvColor else sender?.third?.second ?: c.fAvColor, look.dcAvSize, look.dcSquare,
+                        if (gem) null else if (isMine) c.uid else if (c.who != null) m.from else c.fUid)
+                    else Spacer(Modifier.size(look.dcAvSize.dp))
+                    Spacer(Modifier.width(10.dp))
+                }
+                Column(Modifier.weight(1f)) {
+                    if (header) Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Text(name, color = nameColor, fontWeight = FontWeight.Bold, fontSize = (c.size - 1).coerceAtLeast(11).sp, maxLines = 1, overflow = TextOverflow.Ellipsis, modifier = Modifier.weight(1f, fill = false))
+                        if (c.showTime && m.at > 0L) Text(chatStamp(m.at, look.dc24), fontSize = 12.sp, color = soft)
+                    }
+                    Text(mentionText(shown, c, m, soft), fontSize = c.size.sp)
+                    ReactionRow(c, m, onReact)
+                    if (seen) Text("Seen", fontSize = 10.sp, color = soft)
+                }
+            }
+        }
+        menu()
+    }
+}
