index 000000000..af185bf25
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/settings/pages/RasiGoogleSuggest.kt
@@ -0,0 +1,118 @@
+package org.futo.inputmethod.latin.uix.settings.pages
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.res.stringResource
+import org.futo.inputmethod.latin.R
+import org.futo.inputmethod.latin.rasi.RasiGoogleSuggestPrefs as P
+import org.futo.inputmethod.latin.uix.settings.SettingSliderSharedPrefsInt
+import org.futo.inputmethod.latin.uix.settings.SettingToggleSharedPrefs
+import org.futo.inputmethod.latin.uix.settings.Tip
+import org.futo.inputmethod.latin.uix.settings.UserSetting
+import org.futo.inputmethod.latin.uix.settings.UserSettingsMenu
+import org.futo.inputmethod.latin.uix.settings.useSharedPrefsBool
+import org.futo.inputmethod.latin.uix.settings.userSettingDecorationOnly
+
+private val gsEnabledCheck: @Composable () -> Boolean = {
+    useSharedPrefsBool(P.KEY_ENABLED, true).value
+}
+
+private val gsAnyCheck: @Composable () -> Boolean = {
+    val l1 = useSharedPrefsBool(P.KEY_ENABLED, true).value
+    val l2 = useSharedPrefsBool(P.KEY_CHECK, true).value
+    val l3 = useSharedPrefsBool(P.KEY_NEXT, true).value
+    val gl = useSharedPrefsBool(P.KEY_GLIDE, true).value
+    l1 || l2 || l3 || gl
+}
+
+private val gsGlideOnCheck: @Composable () -> Boolean = {
+    useSharedPrefsBool(P.KEY_GLIDE, true).value
+}
+
+private val gsNextOnCheck: @Composable () -> Boolean = {
+    useSharedPrefsBool(P.KEY_NEXT, true).value
+}
+
+private val gsCheckOnCheck: @Composable () -> Boolean = {
+    useSharedPrefsBool(P.KEY_CHECK, true).value
+}
+
+private val gsContextCheck: @Composable () -> Boolean = {
+    useSharedPrefsBool(P.KEY_ENABLED, true).value &&
+        useSharedPrefsBool(P.KEY_CONTEXT, true).value
+}
+
+private fun gsToggle(
+    title: Int, sub: Int, key: String, default: Boolean, needsEnabled: Boolean = true,
+    check: (@Composable () -> Boolean)? = null
+) =
+    UserSetting(
+        name = title,
+        subtitle = sub,
+        component = {
+            SettingToggleSharedPrefs(
+                title = stringResource(title),
+                subtitle = stringResource(sub),
+                key = key,
+                default = default
+            )
+        },
+        visibilityCheck = check ?: if (needsEnabled) gsEnabledCheck else null
+    )
+
+private fun gsSlider(
+    title: Int, key: String, default: Int, min: Int, max: Int, steps: Int,
+    unit: String, check: (@Composable () -> Boolean)? = null
+) = UserSetting(
+    name = title,
+    component = {
+        SettingSliderSharedPrefsInt(
+            title = stringResource(title),
+            key = key,
+            default = default,
+            range = min.toFloat()..max.toFloat(),
+            transform = { it.toInt() },
+            indicator = { "$it$unit" },
+            steps = steps
+        )
+    },
+    visibilityCheck = check ?: gsEnabledCheck
+)
+
+val RasiGoogleSuggestMenu = UserSettingsMenu(
+    title = R.string.rasi_gs_title,
+    navPath = "googleSuggest", registerNavPath = true,
+    settings = listOf(
+        userSettingDecorationOnly { Tip(stringResource(R.string.rasi_gs_notice)) },
+
+        gsToggle(R.string.rasi_gs_enable, R.string.rasi_gs_enable_sub, P.KEY_ENABLED, true, needsEnabled = false),
+        gsToggle(R.string.rasi_gs_context, R.string.rasi_gs_context_sub, P.KEY_CONTEXT, true),
+        UserSetting(
+            name = R.string.rasi_gs_ctx_words,
+            component = {
+                SettingSliderSharedPrefsInt(
+                    title = stringResource(R.string.rasi_gs_ctx_words),
+                    key = P.KEY_CONTEXT_WORDS,
+                    default = 2,
+                    range = 1.0f..2.0f,
+                    transform = { it.toInt() },
+                    indicator = { "$it" },
+                    steps = 0
+                )
+            },
+            visibilityCheck = gsContextCheck
+        ),
+        gsSlider(R.string.rasi_gs_min_letters, P.KEY_MIN_LETTERS, 2, 1, 5, 3, ""),
+        gsSlider(R.string.rasi_gs_max_results, P.KEY_MAX_RESULTS, 2, 1, 3, 1, ""),
+        gsToggle(R.string.rasi_gs_weak_only, R.string.rasi_gs_weak_only_sub, P.KEY_WEAK_ONLY, true),
+        gsToggle(R.string.rasi_gs_check, R.string.rasi_gs_check_sub, P.KEY_CHECK, true, needsEnabled = false),
+        gsSlider(R.string.rasi_gs_check_matches, P.KEY_CHECK_MATCHES, 4, 2, 8, 5, "", gsCheckOnCheck),
+        gsToggle(R.string.rasi_gs_next, R.string.rasi_gs_next_sub, P.KEY_NEXT, true, needsEnabled = false),
+        gsSlider(R.string.rasi_gs_next_words, P.KEY_NEXT_WORDS, 8, 3, 12, 8, "", gsNextOnCheck),
+        gsSlider(R.string.rasi_gs_next_results, P.KEY_NEXT_RESULTS, 2, 1, 3, 1, "", gsNextOnCheck),
+        gsToggle(R.string.rasi_gs_glide, R.string.rasi_gs_glide_sub, P.KEY_GLIDE, true, needsEnabled = false),
+        gsSlider(R.string.rasi_gs_glide_count, P.KEY_GLIDE_COUNT, 4, 2, 5, 2, "", gsGlideOnCheck),
+        gsSlider(R.string.rasi_gs_glide_spots, P.KEY_GLIDE_SPOTS, 2, 1, 4, 2, "", gsGlideOnCheck),
+        gsToggle(R.string.rasi_gs_wifi, R.string.rasi_gs_wifi_sub, P.KEY_WIFI_ONLY, false, check = gsAnyCheck),
+        gsSlider(R.string.rasi_gs_delay, P.KEY_DELAY_MS, 150, 50, 500, 8, " ms", gsAnyCheck)
+    )
