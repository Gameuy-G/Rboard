+    /** Names, pinned items, custom order and user sections, saved next to the media files. */
+    data class Meta(
+        val names: Map<String, String> = emptyMap(),
+        val pinned: Set<String> = emptySet(),
+        val order: List<String> = emptyList(),
+        /** Section name -> file names in it (insertion order = tab order). */
+        val sections: Map<String, List<String>> = emptyMap(),
+        /** Files hidden from the All tab (they were moved into a section). */
+        val hidden: Set<String> = emptySet(),
+        /** File name -> original photo/video date in ms (when known). */
+        val taken: Map<String, Long> = emptyMap()
+    ) {
+        fun hide(fileNames: List<String>): Meta = copy(hidden = hidden + fileNames)
+
+        /** A hidden file that is in no section any more returns to All. */
+        fun dropOrphanHidden(): Meta {
+            val inAny = sections.values.flatten().toSet()
+            return copy(hidden = hidden.filter { it in inAny }.toSet())
+        }
+
+        fun addTo(section: String, fileNames: List<String>): Meta {
+            val cur = sections[section] ?: emptyList()
+            return copy(sections = sections + (section to (cur + fileNames.filter { it !in cur })))
+        }
+
+        fun removeFrom(section: String, fileName: String): Meta {
+            val cur = sections[section] ?: return this
+            return copy(sections = sections + (section to cur.filter { it != fileName }), hidden = hidden - fileName)
+        }
+
+        /** Forget a file completely (after it was deleted from the library). */
+        fun forget(fileName: String): Meta = copy(
+            names = names - fileName,
+            pinned = pinned - fileName,
+            order = order - fileName,
+            hidden = hidden - fileName,
+            taken = taken - fileName,
+            sections = sections.mapValues { e -> e.value.filter { it != fileName } }
+        )
+    }
+
+    private fun metaFile(context: Context, kind: String) =
+        File(dir(context, kind).parentFile, "meta_$kind.json")
+
+    fun loadMeta(context: Context, kind: String): Meta {
+        try {
+            val f = metaFile(context, kind)
+            if (!f.exists()) return Meta()
+            val o = org.json.JSONObject(f.readText())
+            val names = HashMap<String, String>()
+            val n = o.optJSONObject("names")
+            if (n != null) {
+                val it = n.keys()
+                while (it.hasNext()) {
+                    val k = it.next()
+                    names[k] = n.optString(k)
+                }
+            }
+            val pinned = LinkedHashSet<String>()
+            val p = o.optJSONArray("pinned")
+            if (p != null) for (i in 0 until p.length()) pinned.add(p.getString(i))
+            val order = ArrayList<String>()
+            val ord = o.optJSONArray("order")
+            if (ord != null) for (i in 0 until ord.length()) order.add(ord.getString(i))
+            val sections = LinkedHashMap<String, List<String>>()
+            val sa = o.optJSONArray("sections")
+            if (sa != null) for (i in 0 until sa.length()) {
+                val so = sa.getJSONObject(i)
+                val fl = ArrayList<String>()
+                val fa = so.optJSONArray("files")
+                if (fa != null) for (j in 0 until fa.length()) fl.add(fa.getString(j))
+                sections[so.getString("name")] = fl
+            }
+            val hidden = LinkedHashSet<String>()
+            val h = o.optJSONArray("hidden")
+            if (h != null) for (i in 0 until h.length()) hidden.add(h.getString(i))
+            val taken = HashMap<String, Long>()
+            val t = o.optJSONObject("taken")
+            if (t != null) {
+                val ti = t.keys()
+                while (ti.hasNext()) {
+                    val k = ti.next()
+                    taken[k] = t.optLong(k)
+                }
+            }
+            return Meta(names, pinned, order, sections, hidden, taken)
+        } catch (e: Exception) {
+            return Meta()
+        }
+    }
+
+    fun saveMeta(context: Context, kind: String, m: Meta) {
+        try {
+            val o = org.json.JSONObject()
+            val n = org.json.JSONObject()
+            for ((k, v) in m.names) n.put(k, v)
+            o.put("names", n)
+            o.put("pinned", org.json.JSONArray(m.pinned.toList()))
+            o.put("order", org.json.JSONArray(m.order))
+            o.put("hidden", org.json.JSONArray(m.hidden.toList()))
+            val tk = org.json.JSONObject()
+            for ((k, v) in m.taken) tk.put(k, v)
+            o.put("taken", tk)
+            val sa = org.json.JSONArray()
+            for ((name, fl) in m.sections) {
+                val so = org.json.JSONObject()
+                so.put("name", name)
+                so.put("files", org.json.JSONArray(fl))
+                sa.put(so)
+            }
+            o.put("sections", sa)
+            metaFile(context, kind).writeText(o.toString())
+        } catch (e: Exception) {
+            // Ignore
+        }
+    }
+
+    /** Pinned first, then your custom order; newly added files come first. */
+    fun sorted(context: Context, kind: String, m: Meta): List<File> {
+        val files = list(context, kind)
+        val byName = files.associateBy { it.name }
+        val known = m.order.mapNotNull { byName[it] }
+        val unknown = files.filter { it.name !in m.order }
+        val all = unknown + known
+        return all.filter { it.name in m.pinned } + all.filter { it.name !in m.pinned }
+    }
+
+    /** Copies a file into the library. If [section] exists, it is also added to that section. */
+    fun importFile(context: Context, kind: String, uri: Uri, section: String? = null) {
+        try {
+            val mime = context.contentResolver.getType(uri) ?: "image/png"
+            val ext = MimeTypeMap.getSingleton().getExtensionFromMimeType(mime) ?: "png"
+            val out = File(dir(context, kind), UUID.randomUUID().toString() + "." + ext)
+            context.contentResolver.openInputStream(uri)?.use { input ->
+                out.outputStream().use { output -> input.copyTo(output) }
+            }
+            val label = try {
+                context.contentResolver.query(
+                    uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null
+                )?.use { c -> if (c.moveToFirst()) c.getString(0) else null }
+            } catch (e: Exception) {
+                null
+            }
+            var m = loadMeta(context, kind)
+            if (!label.isNullOrBlank()) {
+                m = m.copy(names = m.names + (out.name to label.substringBeforeLast('.')))
+            }
+            val tk = takenDate(context, uri, mime)
+            if (tk != null) m = m.copy(taken = m.taken + (out.name to tk))
+            if (section != null && m.sections.containsKey(section)) {
+                m = m.addTo(section, listOf(out.name))
+            }
+            saveMeta(context, kind, m)
+        } catch (e: Exception) {
+            // Ignore files that can't be read
+        }
+    }
+
+    /** Applies the type filter and sort mode. Pins only matter in "custom" order. */
+    fun orderFiles(files: List<File>, m: Meta, sort: String, filter: String, dateMode: String = "added"): List<File> {
+        fun d(f: File) = dateOf(f, m, dateMode)
+        val l = when (filter) {
+            "photos" -> files.filter { !isVideo(it) }
+            "videos" -> files.filter { isVideo(it) }
+            else -> files
+        }
+        return when (sort) {
+            "newest" -> l.sortedByDescending { d(it) }
+            "oldest" -> l.sortedBy { d(it) }
+            "name" -> l.sortedBy { (m.names[it.name] ?: it.name).lowercase() }
+            "videos" -> l.sortedWith(compareByDescending<File> { isVideo(it) }.thenByDescending { d(it) })
+            "photos" -> l.sortedWith(compareBy<File> { isVideo(it) }.thenByDescending { d(it) })
+            else -> l
+        }
+    }
+}
