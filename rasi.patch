+    /** live = false for previews and effects, so the beat shake color change only touches the real visualizer. */
+    fun colors(p: android.content.SharedPreferences, prefix: String, live: Boolean = true): Colors {
+        val sh = live && prefix == "viz_" && RasiShake.toViz
+        val base = baseColors(p, prefix, sh)
+        val c = if (p.getBoolean("viz_bc_on", false)) withBeat(base, p, prefix, sh) else base
+        if (sh && RasiShake.gray) c.gray = true
+        return c
+    }
