+
+@Composable
+fun RasiStylePreviewRows(
+    prefs: SharedPreferences, options: List<Pair<String, String>>, selected: String, onSelect: (String) -> Unit
+) {
+    var t by remember { mutableStateOf(0L) }
+    // only previews that are on screen animate; with none visible the timer sleeps
+    val vis = remember { androidx.compose.runtime.mutableStateMapOf<String, Boolean>() }
+    androidx.compose.runtime.LaunchedEffect(Unit) {
+        var last = 0L
+        while (true) {
+            if (vis.values.any { it }) {
+                androidx.compose.runtime.withFrameNanos { n ->
+                    val ms = n / 1_000_000L
+                    if (ms - last >= 33L) { last = ms; t = ms }
+                }
+            } else {
+                kotlinx.coroutines.delay(150L)
+            }
+        }
+    }
+    val dens = androidx.compose.ui.platform.LocalDensity.current.density
+    for ((key, label) in options) {
+        Row(
+            Modifier.fillMaxWidth().clickable { onSelect(key) }.padding(vertical = 3.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            RadioButton(selected = selected == key, onClick = { onSelect(key) })
+            Text(label, Modifier.width(104.dp))
+            androidx.compose.foundation.Canvas(
+                Modifier.weight(1f).height(56.dp)
+                    .clip(RoundedCornerShape(10.dp))
+                    .background(androidx.compose.ui.graphics.Color.Black.copy(alpha = 0.25f))
+                    .onGloballyPositioned { c ->
+                        val b = c.boundsInRoot()
+                        val v = b.bottom > 0f && b.top < c.findRootCoordinates().size.height
+                        if (vis[key] != v) vis[key] = v
+                    }
+            ) {
+                if (vis[key] != true) return@Canvas
+                val now = t
+                RasiNowPlayingViz.drawPreview(
+                    drawContext.canvas.nativeCanvas, key, RasiNowPlayingViz.colors(prefs, "viz_", false),
+                    size.width, size.height, dens, now
+                )
+            }
+        }
+    }
+}
+
+@Composable
+fun RasiOptionRows(options: List<Pair<String, String>>, selected: String, onSelect: (String) -> Unit) {
+    for ((key, label) in options) {
+        if (org.futo.inputmethod.latin.uix.settings.rasiRowHidden(label, null)) continue
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+            RadioButton(selected = selected == key, onClick = { onSelect(key) })
+            Text(org.futo.inputmethod.latin.uix.settings.rasiHL(label))
+        }
+    }
+}
+
+@Composable
+fun RasiPrefSlider(prefs: SharedPreferences, key: String, label: String, unit: String, def: Int, min: Int, max: Int) {
+    if (org.futo.inputmethod.latin.uix.settings.rasiRowHidden(label, null)) return
+    var v by remember { mutableFloatStateOf(prefs.getInt(key, def).toFloat()) }
+    val hlLabel = org.futo.inputmethod.latin.uix.settings.rasiHL(label)
+    Text(androidx.compose.ui.text.buildAnnotatedString {
+        append(hlLabel)
+        append(": " + v.toInt() + unit)
+    })
+    Slider(
+        value = v, onValueChange = { v = it }, valueRange = min.toFloat()..max.toFloat(),
+        onValueChangeFinished = { prefs.edit().putInt(key, v.toInt()).apply(); RasiNowPlaying.notifyChanged() }
+    )
+}
+
+@Composable
+fun RasiColorPick(prefs: SharedPreferences, key: String, label: String, def: Int) {
+    if (org.futo.inputmethod.latin.uix.settings.rasiRowHidden(label, null)) return
+    val start = prefs.getInt(key, def)
+    val hsv = FloatArray(3)
+    android.graphics.Color.colorToHSV(start, hsv)
+    var hue by remember { mutableFloatStateOf(hsv[0]) }
+    var bri by remember { mutableFloatStateOf(hsv[2].coerceIn(0.3f, 1f)) }
+    val color = android.graphics.Color.HSVToColor(floatArrayOf(hue, if (hsv[1] < 0.05f && hue == hsv[0]) 0f else 0.85f, bri))
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        Text(label)
+        Spacer(Modifier.size(4.dp))
+        Spacer(
+            Modifier.size(28.dp).clip(CircleShape)
+                .background(androidx.compose.ui.graphics.Color(color))
+        )
+    }
+    fun save() { prefs.edit().putInt(key, color).apply(); RasiNowPlaying.notifyChanged() }
+    Slider(value = hue, onValueChange = { hue = it }, valueRange = 0f..360f, onValueChangeFinished = { save() })
+    Slider(value = bri, onValueChange = { bri = it }, valueRange = 0.3f..1f, onValueChangeFinished = { save() })
+}
