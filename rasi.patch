+/** One person as a profile card. Friends can be tapped to open the full card and their shared totals. */
+@Composable
+internal fun FriendCard(f: RasiFriends.Friend, expandable: Boolean, picsOn: Boolean, liveList: Boolean = false, staleMin: Int = 120, startOpen: Boolean = false, actions: @Composable () -> Unit) {
+    val ctx = LocalContext.current
+    var open by remember(f.uid) { mutableStateOf(startOpen) }
+    var av by remember(f.uid, f.p.avatarPicV, f.p.avatarUsePic, picsOn) { mutableStateOf<RasiAnimPic?>(null) }
+    var bn by remember(f.uid, f.p.bannerPicV, f.p.bannerUsePic, picsOn) { mutableStateOf<RasiAnimPic?>(null) }
+    var st by remember(f.uid) { mutableStateOf<RasiFriends.FriendStats?>(null) }
+    var nowRaw by remember(f.uid) { mutableStateOf<RasiFriends.Now?>(null) }
+    DisposableEffect(f.uid, expandable, liveList, open) {
+        var stop: (() -> Unit)? = null
+        if (expandable && f.p.showNow && (open || liveList)) stop = RasiFriends.listenNow(f.uid) { nowRaw = it }
+        onDispose { stop?.invoke() }
+    }
+    val nr = nowRaw
+    val tapOn = RasiAccount.prefs(ctx).getBoolean("pf_tap", true)
+    val nowTxt0: String? = nowRaw?.let { n ->
+        if (System.currentTimeMillis() - n.at < staleMin * 60000L) RasiFriends.nowText(n) else null
+    }
+    val nowTxt = nowTxt0
+    val playNow: (() -> Unit)? = if (tapOn && nr != null && nowTxt != null && nr.title.isNotBlank()) ({
+        val msg = RasiRooms.playFromCard(ctx, f.p.name.ifBlank { f.p.username }, nr.title, nr.artist, nr.pkg, nr.posMs, nr.at, nr.playing)
+        android.widget.Toast.makeText(ctx, msg, android.widget.Toast.LENGTH_SHORT).show()
+    }) else null
+    LaunchedEffect(f.uid, f.p.avatarPicV, f.p.avatarUsePic, picsOn) {
+        if (picsOn && f.p.avatarUsePic && f.p.avatarPicV > 0L) RasiPictures.fetch(ctx, f.uid, RasiPictures.AVATAR, f.p.avatarPicV) { av = it }
+    }
+    LaunchedEffect(open, picsOn) {
+        if (open) {
+            if (picsOn && f.p.bannerUsePic && f.p.bannerPicV > 0L) RasiPictures.fetch(ctx, f.uid, RasiPictures.BANNER, f.p.bannerPicV) { bn = it }
+            RasiFriends.fetchStats(f.uid) { st = it }
+        }
+    }
+    Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 4.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+        Column(Modifier.clickable(enabled = expandable) { open = !open }) {
+            ProfileCardPreview(
+                f.p.name, f.p.username, f.p.avatar, f.p.avatarColor, f.p.bannerColor1, f.p.bannerColor2,
+                compact = f.p.cardStyle == "compact", avatarImg = av, bannerImg = if (open) bn else null,
+                pronouns = f.p.pronouns, status = f.p.status, bio = f.p.bio, accent = f.p.accent, small = !open,
+                badges = if (open && f.p.showBadges) f.p.badges.mapNotNull { RasiBadges.byId(it) } else emptyList(),
+                top = if (open && f.p.showTop) (st?.top ?: emptyList()).take(3) else emptyList(),
+                now = if (open) nowTxt else null,
+                nowMode = f.p.nowColorMode, nowManual = f.p.nowColor, nowC1 = nowRaw?.c1 ?: 0, nowC2 = nowRaw?.c2 ?: 0,
+                onNowClick = playNow
+            )
+        }
+        if (!open && nowTxt != null) {
+            val liftOn = remember { RasiAccount.prefs(ctx).getBoolean("now_lift", true) }
+            RasiNowLine("\u266A " + nowTxt, f.p.nowColorMode, f.p.nowColor, nowRaw?.c1 ?: 0, nowRaw?.c2 ?: 0, liftOn, f.p.accent,
+                if (playNow != null) Modifier.clickable { playNow() } else Modifier)
+            if (playNow != null) Text("Tap the song to play it in your music app", fontSize = 12.sp)
+        }
+        if (open) {
+            val s = st
+            Text(if (s == null) "No shared totals (they may not share, or the rules are not updated)"
+                else "Keys ${s.keys}, words ${s.words}, listening ${s.listenMs / 60000L} min")
+        }
+        if (expandable && !open) Text("Tap the card to open it", fontSize = 12.sp)
+        Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) { actions() }
+    }
+}
