+    private fun shiftStr(str: String, offset: Int, allowFallback: Boolean): String? {
+        if (offset == 0) return str
+        val sb = StringBuilder()
+        var i = 0
+        while (i < str.length) {
+            var cp = str.codePointAt(i)
+            i += Character.charCount(cp)
+            if (cp in 0x0900..0x097F) {
+                var t = cp + offset
+                if (!Character.isDefined(t) && allowFallback) {
+                    val f = devaFallback[cp]
+                    if (f != null) t = f + offset
+                }
+                if (!Character.isDefined(t)) return null
+                cp = t
+            }
+            sb.appendCodePoint(cp)
+        }
+        return sb.toString()
+    }
+
+    private fun derive(id: String, base: Script, offset: Int): Script {
+        val cons = LinkedHashMap<String, String>()
+        base.cons.forEach { (k, v) -> shiftStr(v, offset, true)?.let { cons[k] = it } }
+        val vowels = LinkedHashMap<String, Pair<String, String>>()
+        base.vowels.forEach { (k, v) ->
+            val a = shiftStr(v.first, offset, false)
+            val b = shiftStr(v.second, offset, false)
+            if (a != null && b != null) vowels[k] = Pair(a, b)
+        }
+        val signs = LinkedHashMap<String, String>()
+        base.signs.forEach { (k, v) -> shiftStr(v, offset, false)?.let { signs[k] = it } }
+        return Script(id, cons, vowels, signs, shiftStr(base.virama, offset, false) ?: base.virama,
+            shiftStr(base.ra, offset, false) ?: base.ra)
+    }
