+@Composable
+private fun ColorBar(brush: Brush, t: Float, onT: (Float) -> Unit) {
+    var w by remember { mutableFloatStateOf(1f) }
+    val cb = rememberUpdatedState(onT)
+    Box(
+        Modifier
+            .fillMaxWidth()
+            .height(26.dp)
+            .clip(RoundedCornerShape(13.dp))
+            .background(brush)
+            .onSizeChanged { w = it.width.toFloat().coerceAtLeast(1f) }
+            .pointerInput(Unit) {
+                awaitEachGesture {
+                    val d = awaitFirstDown(requireUnconsumed = false)
+                    cb.value((d.position.x / w).coerceIn(0f, 1f))
+                    d.consume()
+                    do {
+                        val e = awaitPointerEvent()
+                        val c = e.changes.first()
+                        cb.value((c.position.x / w).coerceIn(0f, 1f))
+                        c.consume()
+                    } while (e.changes.any { it.pressed })
+                }
+            }
+    ) {
+        Box(
+            Modifier
+                .offset { IntOffset((t * w - 10.dp.toPx()).toInt(), 0) }
+                .size(20.dp, 26.dp)
+                .border(3.dp, Color.White, RoundedCornerShape(10.dp))
+        )
+    }
+}
