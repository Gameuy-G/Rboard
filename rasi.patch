+/** The line above a reply: hook, mini avatar, @name and a one-line snippet. Tap jumps to the original. */
+@Composable
+private fun ReplyPreviewDc(name: String, nameColor: Color, snippet: String, av: Pair<String, Int>?, avUid: String?, hookStart: Int, onClick: (() -> Unit)?) {
+    val line = LocalContentColor.current.copy(alpha = 0.4f)
+    Row(
+        Modifier.fillMaxWidth().then(if (onClick != null) Modifier.clickable { onClick() } else Modifier).padding(start = hookStart.dp, bottom = 2.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Box(Modifier.padding(top = 8.dp).size(width = 22.dp, height = 10.dp).drawBehind {
+            val s = 2.dp.toPx()
+            drawLine(line, Offset(0f, size.height), Offset(0f, size.height / 2f), s)
+            drawLine(line, Offset(0f, size.height / 2f), Offset(size.width, size.height / 2f), s)
+        })
+        Spacer(Modifier.width(4.dp))
+        if (av != null) { ChatAv(av.first, av.second, 16, false, avUid); Spacer(Modifier.width(4.dp)) }
+        Text("@$name", color = nameColor, fontSize = 13.sp, fontWeight = FontWeight.Bold, maxLines = 1)
+        Spacer(Modifier.width(6.dp))
+        Text(snippet, Modifier.weight(1f), fontSize = 13.sp, maxLines = 1, overflow = TextOverflow.Ellipsis, color = LocalContentColor.current.copy(alpha = 0.75f))
+    }
+}
