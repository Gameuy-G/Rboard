@@ -0,0 +1,290 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import org.futo.inputmethod.latin.Dictionary
+import org.futo.inputmethod.latin.NgramContext
+import org.futo.inputmethod.latin.common.ComposedData
+import org.futo.inputmethod.latin.settings.SettingsValuesForSuggestion
+import java.util.Locale
+import org.futo.inputmethod.latin.SuggestedWords.SuggestedWordInfo
+import org.futo.inputmethod.latin.utils.SuggestionResults
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.InputStream
+import java.util.zip.ZipInputStream
+
+/** Marks suggestions that come from the Rasi word memory, so the typed word counts as a known word. */
+class RasiMemoryDictionary : Dictionary("rasi_memory", Locale.ROOT) {
+    override fun getNextValidCodePoints(composedData: ComposedData?): ArrayList<Int?>? = arrayListOf()
+
+    override fun getSuggestions(
+        composedData: ComposedData?, ngramContext: NgramContext?, proximityInfoHandle: Long,
+        settingsValuesForSuggestion: SettingsValuesForSuggestion?, sessionId: Int,
+        weightForLocale: Float, inOutWeightOfLangModelVsSpatialModel: FloatArray?
+    ): ArrayList<SuggestedWordInfo?>? = arrayListOf()
+
+    override fun isInDictionary(word: String?): Boolean = false
+}
+
+private val MEM_DICT = RasiMemoryDictionary()
+
+/** Learns which emoji you tap for each word (offline, on-device) and ranks those first. */
+object RasiEmojiLearn {
+    private var prefs: SharedPreferences? = null
+    private val counts = HashMap<String, HashMap<String, Int>>()
+    private val shown = HashMap<String, String>() // emoji -> word it was offered for
+    private val totals = HashMap<String, Int>()   // emoji -> times tapped overall
+    private val handler = Handler(Looper.getMainLooper())
+
+    @JvmStatic
+    @Synchronized
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences("rasi_emoji_learn", Context.MODE_PRIVATE)
+        prefs = p
+        try {
+            val obj = JSONObject(p.getString("map", "{}") ?: "{}")
+            for (w in obj.keys()) {
+                val inner = obj.getJSONObject(w)
+                val m = HashMap<String, Int>()
+                for (e in inner.keys()) m[e] = inner.getInt(e)
+                counts[w] = m
+            }
+            val t = JSONObject(p.getString("totals", "{}") ?: "{}")
+            for (e in t.keys()) totals[e] = t.getInt(e)
+        } catch (e: Exception) { e.printStackTrace() }
+    }
+
+    /** How often this emoji was tapped overall; used to put your favourites on the right. */
+    @JvmStatic
+    @Synchronized
+    fun usage(emoji: String): Int = totals[emoji] ?: 0
+
+    @Synchronized
+    private fun save() {
+        val tObj = JSONObject()
+        for ((e, c) in totals) tObj.put(e, c)
+        prefs?.edit()?.putString("totals", tObj.toString())?.apply()
+        val obj = JSONObject()
+        for ((w, m) in counts) {
+            val inner = JSONObject()
+            for ((e, c) in m) inner.put(e, c)
+            obj.put(w, inner)
+        }
+        prefs?.edit()?.putString("map", obj.toString())?.apply()
+    }
+
+    /** Called by the emoji lookup so a later tap knows which word the emoji was offered for. */
+    @JvmStatic
+    @Synchronized
+    fun noteShown(word: String, emoji: List<String>) {
+        if (shown.size > 64) shown.clear()
+        emoji.forEach { shown[it] = word }
+    }
+
+    /** Called when an emoji suggestion is tapped. */
+    @JvmStatic
+    @Synchronized
+    fun noteTapped(emoji: String) {
+        totals[emoji] = (totals[emoji] ?: 0) + 1
+        handler.removeCallbacks(saveTask)
+        handler.postDelayed(saveTask, 3000)
+        val word = shown[emoji] ?: return
+        // Teach the whole word and its prefixes (3+ letters) so the emoji shows up earlier next time
+        for (n in 3..word.length) {
+            val key = word.substring(0, n)
+            val m = counts.getOrPut(key) { HashMap() }
+            m[emoji] = (m[emoji] ?: 0) + (if (n == word.length) 2 else 1)
+        }
+        if (word.length < 3) {
+            val m = counts.getOrPut(word) { HashMap() }
+            m[emoji] = (m[emoji] ?: 0) + 2
+        }
+        while (counts.size > 20000) {
+            counts.entries.minByOrNull { it.value.values.sum() }?.let { counts.remove(it.key) } ?: break
+        }
+        handler.removeCallbacks(saveTask)
+        handler.postDelayed(saveTask, 3000)
+    }
+
+    private val saveTask = Runnable { save() }
+
+    /** Emoji you picked for this word, most-tapped first. */
+    @JvmStatic
+    @Synchronized
+    fun learnedFor(word: String): List<String> =
+        counts[word]?.entries?.sortedByDescending { it.value }?.map { it.key } ?: emptyList()
+}
+
+/**
+ * Remembers words you commit (names, slang, anything the dictionary lacks) and words imported
+ * from a Gboard dictionary file, and offers them right after the first use.
+ */
+object RasiWordMemory {
+    private const val MAX_WORDS = 20000
+    private var prefs: SharedPreferences? = null
+    private val words = HashMap<String, IntArray>()      // lowercase -> [count, lastUsedSeconds]
+    private val display = HashMap<String, String>()      // lowercase -> best capitalisation
+    private val shortcuts = HashMap<String, String>()    // lowercase shortcut -> phrase
+    private val handler = Handler(Looper.getMainLooper())
+    @Volatile private var loaded = false
+
+    @JvmStatic
+    @Synchronized
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences("rasi_word_memory", Context.MODE_PRIVATE)
+        prefs = p
+        try {
+            val obj = JSONObject(p.getString("data", "{}") ?: "{}")
+            val w = obj.optJSONObject("w")
+            if (w != null) for (k in w.keys()) {
+                val a = w.getJSONArray(k)
+                words[k.lowercase()] = intArrayOf(a.getInt(1), a.getInt(2))
+                display[k.lowercase()] = a.getString(0)
+            }
+            val s = obj.optJSONObject("s")
+            if (s != null) for (k in s.keys()) shortcuts[k] = s.getString(k)
+        } catch (e: Exception) { e.printStackTrace() }
+        loaded = true
+    }
+
+    private val saveTask = Runnable { save() }
+
+    private fun scheduleSave() {
+        handler.removeCallbacks(saveTask)
+        handler.postDelayed(saveTask, 5000)
+    }
+
+    @Synchronized
+    fun save() {
+        val w = JSONObject()
+        for ((k, v) in words) w.put(display[k] ?: k, JSONArray(listOf(display[k] ?: k, v[0], v[1])))
+        val s = JSONObject()
+        for ((k, v) in shortcuts) s.put(k, v)
+        val obj = JSONObject().put("w", w).put("s", s)
+        prefs?.edit()?.putString("data", obj.toString())?.apply()
+    }
+
+    private fun ok(word: String) =
+        word.length in 2..30 && word.all { it.isLetter() || it == '\'' || it == '-' } && word.any { it.isLetter() }
+
+    /** Called whenever a word is committed in a field that allows learning. */
+    @JvmStatic
+    @Synchronized
+    fun learn(word: String?) {
+        if (word == null || !ok(word)) return
+        val key = word.lowercase()
+        val e = words.getOrPut(key) { intArrayOf(0, 0) }
+        e[0] = e[0] + 1
+        e[1] = (System.currentTimeMillis() / 1000L).toInt()
+        // keep the capitalisation you used, but prefer one with capitals (names)
+        val old = display[key]
+        if (old == null || word != word.lowercase() || old == old.lowercase()) display[key] = word
+        if (words.size > MAX_WORDS) {
+            words.entries.minByOrNull { it.value[0] * 1_000_000L + it.value[1] / 1000 }?.let {
+                words.remove(it.key); display.remove(it.key)
+            }
+        }
+        scheduleSave()
+    }
+
+    @Synchronized fun wordCount() = words.size
+    @Synchronized fun shortcutCount() = shortcuts.size
+
+    @Synchronized
+    fun clearAll() {
+        words.clear(); display.clear(); shortcuts.clear(); save()
+    }
+
+    /** Add suggestions from memory to the typing results. Words need 2+ uses to be protected from autocorrect. */
+    @JvmStatic
+    @Synchronized
+    fun addTo(results: SuggestionResults, typed: String?) {
+        if (!loaded || typed.isNullOrEmpty() || typed.length > 30) return
+        val lower = typed.lowercase()
+        val top = if (results.isEmpty()) 1_000_000 else results.first().mScore
+        val have = HashSet<String>()
+        for (r in results) have.add(r.mWord.lowercase())
+
+        // Exact match you've used before: treat as a valid word so it isn't autocorrected away
+        val exact = words[lower]
+        if (exact != null && (exact[0] >= 2 || exact[0] >= 1 && lower in importedKeys)) {
+            results.add(SuggestedWordInfo(typed, "", top + 1, SuggestedWordInfo.KIND_TYPED,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+            have.add(lower)
+        }
+
+        // Shortcut expansion (from imported Gboard shortcuts)
+        shortcuts[lower]?.let {
+            results.add(SuggestedWordInfo(it, "", top - 1, SuggestedWordInfo.KIND_COMPLETION,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+        }
+
+        if (lower.length < 2) return
+        var added = 0
+        val matches = words.entries.filter { it.key.startsWith(lower) && it.key != lower && it.key !in have }
+            .sortedWith(compareByDescending<Map.Entry<String, IntArray>> { it.value[0] }.thenByDescending { it.value[1] })
+        for (m in matches) {
+            if (added >= 3) break
+            results.add(SuggestedWordInfo(display[m.key] ?: m.key, "", top - 1 - added, SuggestedWordInfo.KIND_COMPLETION,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+            added++
+        }
+    }
+
+    private val importedKeys = HashSet<String>()
+
+    /**
+     * Imports a Gboard personal-dictionary export (a .zip holding dictionary.txt, or the .txt itself).
+     * Lines are tab separated: shortcut, word, locale. Returns how many entries were added.
+     */
+    @JvmStatic
+    @Synchronized
+    fun importGboard(input: InputStream): Int {
+        val lines = ArrayList<String>()
+        val bytes = input.readBytes()
+        val isZip = bytes.size > 3 && bytes[0] == 'P'.code.toByte() && bytes[1] == 'K'.code.toByte()
+        if (isZip) {
+            ZipInputStream(bytes.inputStream()).use { z ->
+                var e = z.nextEntry
+                while (e != null) {
+                    if (!e.isDirectory && e.name.endsWith(".txt")) {
+                        lines.addAll(String(z.readBytes(), Charsets.UTF_8).lines())
+                    }
+                    e = z.nextEntry
+                }
+            }
+        } else {
+            lines.addAll(String(bytes, Charsets.UTF_8).lines())
+        }
+        var n = 0
+        for (raw in lines) {
+            val line = raw.trim('\uFEFF', '\r')
+            if (line.isBlank() || line.startsWith("#")) continue
+            val parts = line.split('\t')
+            val shortcut = if (parts.size >= 2) parts[0].trim() else ""
+            val phrase = (if (parts.size >= 2) parts[1] else parts[0]).trim()
+            if (phrase.isEmpty()) continue
+            if (shortcut.isNotEmpty() && !shortcut.equals(phrase, ignoreCase = true)) {
+                shortcuts[shortcut.lowercase()] = phrase
+                n++
+            }
+            // single words become known words straight away
+            if (ok(phrase)) {
+                val key = phrase.lowercase()
+                val e = words.getOrPut(key) { intArrayOf(0, 0) }
+                if (e[0] < 2) e[0] = 2
+                e[1] = (System.currentTimeMillis() / 1000L).toInt()
+                display[key] = phrase
+                importedKeys.add(key)
+                n++
+            }
+        }
+        scheduleSave()
+        return n
+    }
+}
