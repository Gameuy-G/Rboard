+/** Bottom bar: fixed "+" to add a section, then the section tabs. "All" shows everything. */
+@Composable
+fun RasiSectionsBar(
+    selected: MutableState<String>,
+    reorder: MutableState<Boolean>? = null,
+    modifier: Modifier = Modifier,
+    undoPending: Any? = null,
+    onUndo: () -> Unit = {},
+    onUndoExpire: () -> Unit = {}
+) {
+    val context = LocalContext.current
+    RasiSections.init(context)
+    val adding = remember { mutableStateOf(false) }
+    val newName = remember { mutableStateOf("") }
+
+    Column(modifier.fillMaxWidth().background(LocalKeyboardScheme.current.keyboardSurface)) {
+        val lastPending = remember { mutableStateOf<Any?>(null) }
+        if (undoPending != null) lastPending.value = undoPending
+        androidx.compose.animation.AnimatedVisibility(
+            visible = undoPending != null,
+            enter = androidx.compose.animation.fadeIn() +
+                androidx.compose.animation.slideInVertically { it / 2 },
+            exit = androidx.compose.animation.fadeOut() +
+                androidx.compose.animation.slideOutVertically { it / 2 }
+        ) {
+            val p = lastPending.value
+            if (p != null) {
+                Box(Modifier.fillMaxWidth().padding(top = 6.dp), contentAlignment = Alignment.Center) {
+                    RasiUndoSnackbar(p, Modifier, onUndo, onUndoExpire)
+                }
+            }
+        }
+        if (adding.value) {
+            Row(
+                Modifier
+                    .fillMaxWidth()
+                    .padding(4.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                Surface(
+                    color = LocalKeyboardScheme.current.surface,
+                    border = BorderStroke(1.dp, SolidColor(LocalKeyboardScheme.current.outline)),
+                    shape = RoundedCornerShape(8.dp),
+                    modifier = Modifier
+                        .weight(1.0f)
+                        .height(48.dp),
+                ) {
+                    Box(Modifier.padding(8.dp), contentAlignment = Alignment.CenterStart) {
+                        ActionTextEditor(
+                            newName,
+                            multiline = false,
+                            autocorrect = false,
+                            placeholder = "Section name"
+                        )
+                    }
+                }
+                Spacer(Modifier.width(8.dp))
+                Button(
+                    onClick = {
+                        RasiSections.addSection(newName.value)
+                        adding.value = false
+                        newName.value = ""
+                    },
+                    enabled = newName.value.isNotBlank()
+                ) { Text("Add") }
+            }
+        }
+        Row(
+            Modifier
+                .fillMaxWidth()
+                .padding(horizontal = 8.dp, vertical = 6.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            RasiPill(if (adding.value) "\u2715" else "+", adding.value) {
+                adding.value = !adding.value
+                newName.value = ""
+            }
+            Spacer(Modifier.width(8.dp))
+            Row(
+                Modifier
+                    .weight(1.0f)
+                    .horizontalScroll(rememberScrollState()),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                SectionChip("All", selected.value.isEmpty()) { selected.value = "" }
+                RasiSections.names.forEach { n ->
+                    SectionChip(n, selected.value == n) { selected.value = n }
+                }
+                if (reorder != null) {
+                    RasiPill(if (reorder.value) "Done" else "Reorder", reorder.value) { reorder.value = !reorder.value }
+                }
+                if (selected.value.isNotEmpty()) {
+                    Spacer(Modifier.width(8.dp))
+                    RasiPill("Delete section", false) {
+                        RasiSections.removeSection(selected.value)
+                        selected.value = ""
+                    }
+                }
+            }
+        }
+    }
+}
