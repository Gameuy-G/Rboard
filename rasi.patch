diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiAnimBg.kt b/java/src/org/futo/inputmethod/latin/uix/RasiAnimBg.kt
new file mode 100644
index 000000000..afce9e20c
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiAnimBg.kt
@@ -0,0 +1,144 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import android.graphics.BitmapFactory
+import android.graphics.ImageDecoder
+import android.graphics.drawable.AnimatedImageDrawable
+import android.graphics.drawable.Animatable
+import android.graphics.drawable.BitmapDrawable
+import android.graphics.drawable.Drawable
+import android.net.Uri
+import android.os.Build
+import android.widget.ImageView
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.viewinterop.AndroidView
+import java.io.File
+
+/**
+ * An animated picture (GIF or animated WebP) behind the keyboard or behind the settings pages.
+ * It sits on top of the theme and does not change the theme colors.
+ */
+object RasiAnimBg {
+    const val KEYBOARD = "keyboard"
+    const val SETTINGS = "settings"
+    private const val MAX_BYTES = 20L * 1024 * 1024
+    private const val MAX_SIDE = 720
+
+    /** Bumped whenever something changes so the screens redraw. */
+    val version = mutableIntStateOf(0)
+
+    fun prefs(c: Context) = c.applicationContext.getSharedPreferences("rasi_animbg", Context.MODE_PRIVATE)
+
+    private fun dir(c: Context) = File(c.applicationContext.filesDir, "rasi_animbg").also { it.mkdirs() }
+    fun file(c: Context, target: String) = File(dir(c), "$target.bin")
+
+    fun has(c: Context, target: String): Boolean = file(c, target).let { it.isFile && it.length() > 0 }
+    fun enabled(c: Context, target: String) = has(c, target) && prefs(c).getBoolean("on_$target", true)
+    fun opacity(c: Context, target: String) = prefs(c).getFloat("alpha_$target", 1f)
+    fun dim(c: Context, target: String) = prefs(c).getFloat("dim_$target", 0.25f)
+
+    fun set(c: Context, target: String, on: Boolean? = null, opacity: Float? = null, dim: Float? = null) {
+        val e = prefs(c).edit()
+        if (on != null) e.putBoolean("on_$target", on)
+        if (opacity != null) e.putFloat("alpha_$target", opacity)
+        if (dim != null) e.putFloat("dim_$target", dim)
+        e.apply()
+        version.intValue++
+    }
+
+    fun clear(c: Context, target: String) {
+        file(c, target).delete()
+        version.intValue++
+    }
+
+    /** Copies the picked picture in (max 20 MB) and checks that it can be shown. Returns false if not. */
+    fun importFile(c: Context, uri: Uri, target: String): Boolean {
+        val tmp = File(dir(c), "$target.tmp")
+        return try {
+            var total = 0L
+            c.contentResolver.openInputStream(uri)?.use { input ->
+                tmp.outputStream().use { out ->
+                    val buf = ByteArray(16384)
+                    while (true) {
+                        val n = input.read(buf)
+                        if (n < 0) break
+                        total += n
+                        if (total > MAX_BYTES) throw IllegalStateException("too big")
+                        out.write(buf, 0, n)
+                    }
+                }
+            } ?: return false
+            if (decode(tmp) == null) {
+                tmp.delete()
+                return false
+            }
+            val dst = file(c, target)
+            dst.delete()
+            if (!tmp.renameTo(dst)) {
+                tmp.copyTo(dst, overwrite = true)
+                tmp.delete()
+            }
+            prefs(c).edit().putBoolean("on_$target", true).apply()
+            version.intValue++
+            true
+        } catch (e: Throwable) {
+            tmp.delete()
+            false
+        }
+    }
+
+    /** Animated on Android 9+, a still first frame on older phones. */
+    fun decode(f: File): Drawable? = try {
+        if (Build.VERSION.SDK_INT >= 28) {
+            val d = ImageDecoder.decodeDrawable(ImageDecoder.createSource(f)) { dec, info, _ ->
+                val w = info.size.width
+                val h = info.size.height
+                val big = maxOf(w, h)
+                if (big > MAX_SIDE) {
+                    val s = MAX_SIDE / big.toFloat()
+                    dec.setTargetSize((w * s).toInt().coerceAtLeast(1), (h * s).toInt().coerceAtLeast(1))
+                }
+            }
+            if (d is AnimatedImageDrawable) d.repeatCount = AnimatedImageDrawable.REPEAT_INFINITE
+            d
+        } else {
+            val bmp = BitmapFactory.decodeFile(f.absolutePath)
+            if (bmp != null) BitmapDrawable(bmp) else null
+        }
+    } catch (e: Throwable) {
+        null
+    }
+}
+
+@Composable
+fun RasiAnimatedBackground(target: String, modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    val v = RasiAnimBg.version.intValue
+    if (RasiPerf.isOn() || !RasiAnimBg.enabled(context, target)) return
+    val drawable = remember(v, target) { RasiAnimBg.decode(RasiAnimBg.file(context, target)) } ?: return
+    DisposableEffect(drawable) {
+        (drawable as? Animatable)?.start()
+        onDispose { (drawable as? Animatable)?.stop() }
+    }
+    val alpha = RasiAnimBg.opacity(context, target).coerceIn(0f, 1f)
+    val dim = RasiAnimBg.dim(context, target).coerceIn(0f, 0.9f)
+    Box(modifier) {
+        AndroidView(
+            factory = { c -> ImageView(c).apply { scaleType = ImageView.ScaleType.CENTER_CROP } },
+            update = {
+                it.setImageDrawable(drawable)
+                it.alpha = alpha
+            },
+            modifier = Modifier.matchParentSize()
+        )
+        if (dim > 0f) Box(Modifier.matchParentSize().background(Color.Black.copy(alpha = dim)))
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiBackupParts.kt b/java/src/org/futo/inputmethod/latin/uix/RasiBackupParts.kt
new file mode 100644
index 000000000..4a628ae6e
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiBackupParts.kt
@@ -0,0 +1,129 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import org.futo.inputmethod.latin.uix.theme.ZipThemes
+import org.futo.inputmethod.latin.xlm.ModelPaths
+import java.io.File
+
+/** The pieces a settings backup is made of, so export and import can pick them one by one. */
+object RasiBackupParts {
+    class Part(
+        val id: String,
+        val title: String,
+        val desc: String,
+        val group: Int,           // 0 keyboard, 1 rasi settings, 2 files, 3 personal data and themes
+        val shareSafe: Boolean,   // fine to give to a friend
+        val sensitive: Boolean = false // holds keys or account data
+    )
+
+    const val CORE = "core"
+    const val PREF = "pref:"
+    const val FILES = "files:"
+    const val THEMES = "themes"
+    const val DICT = "dict"
+    const val CLIP = "clipboard"
+    const val TYPING = "typing"
+    const val EXT = "ext"
+    const val MODELS = "models"
+
+    val groupNames = listOf("Keyboard", "Rasi settings", "Files", "Personal data and themes")
+
+    /** Folders inside the app files folder that settings point to (title, description, safe to share). */
+    val fileDirs: Map<String, Triple<String, String, Boolean>> = linkedMapOf(
+        "rasi_effects" to Triple("Keyboard effect files", "The images and GIFs your keyboard effects use.", true),
+        "rasi_bgeffects" to Triple("Settings effect files", "The images and GIFs used by settings background effects.", true),
+        "rasi_animbg" to Triple("Animated background files", "The GIFs or videos used as animated backgrounds.", true),
+        "rasi_sounds" to Triple("Theme and key sounds", "Sound files that your themes play.", true),
+        "rasi_media" to Triple("Media library", "Your saved stickers, GIFs and files in the media panel. Can be big.", false)
+    )
+
+    private val prefInfo: Map<String, Pair<String, String>> = mapOf(
+        "rasi_nowplaying" to ("Music and Now playing" to "Pill, visualizers, song background, dynamic theme, beat shakes, saved song looks switches."),
+        "rasi_songlooks" to ("Saved song looks" to "The looks you saved for single songs."),
+        "rasi_media_ui" to ("Media panel layout" to "How the media panel is arranged."),
+        "rasi_kitchen_prefs" to ("Emoji Kitchen" to "Emoji Kitchen options."),
+        "rasi_home_order" to ("Settings home order" to "The order of the settings home page."),
+        "rasi_calc" to ("Calculator" to "Calculator options."),
+        "rasi_bpm" to ("BPM tapper" to "BPM tapper options."),
+        "rasi_animbg" to ("Animated background options" to "Sliders and switches of the animated background."),
+        "rasi_dev" to ("Developer settings" to "Everything in Developer settings."),
+        "rasi_clip_sections" to ("Clipboard sections" to "Your clipboard sections and their order."),
+        "rasi_clip_import" to ("Clipboard import options" to "Clipboard import choices."),
+        "rasi_emoji_learn" to ("Emoji learning" to "What the keyboard learned about your emoji."),
+        "rasi_word_memory" to ("Learned words" to "Words Rasi learned from your typing."),
+        "rasi_swipe_memory" to ("Swipe memory" to "Swipe corrections Rasi learned."),
+        "rasi_stats" to ("Local stats" to "Your keystroke, word and listening counters."),
+        "rasi_gemini" to ("AI assistant" to "Holds your AI API key."),
+        "rasi_gemini_files" to ("AI assistant files" to "The list of files given to the AI assistant."),
+        "rasi_klipy" to ("GIF search" to "Holds your GIF search key."),
+        "rasi_push" to ("Push options" to "Notification options and tokens."),
+        "rasi_account" to ("Online account" to "Your account profile cache and online options.")
+    )
+    private val sensitiveNames = setOf("rasi_gemini", "rasi_klipy", "rasi_push", "rasi_account")
+    private val personalWords = listOf("learn", "memory", "clip", "files", "stats")
+    private val hiddenPrefs = setOf("rasi_share_tmp", "rasi_log")
+
+    private fun pretty(name: String): String =
+        name.removePrefix("rasi_").replace('_', ' ').replaceFirstChar { it.uppercase() }
+
+    fun available(context: Context): List<Part> {
+        val out = ArrayList<Part>()
+        out.add(Part(CORE, "Keyboard settings", "Layout, themes choice, typing options, actions and all the normal Rboard settings.", 0, true))
+        val dir = File(context.applicationInfo.dataDir, "shared_prefs")
+        (dir.listFiles() ?: emptyArray())
+            .map { it.name }
+            .filter { it.startsWith("rasi") && it.endsWith(".xml") }
+            .map { it.removeSuffix(".xml") }
+            .filter { it !in hiddenPrefs }
+            .sorted()
+            .forEach { n ->
+                val info = prefInfo[n]
+                val sens = n in sensitiveNames
+                val safe = !sens && personalWords.none { n.contains(it) }
+                out.add(Part(PREF + n, info?.first ?: pretty(n), info?.second ?: "Options saved in $n.", 1, safe, sens))
+            }
+        for ((d, t) in fileDirs) {
+            if (File(context.filesDir, d).let { it.isDirectory && (it.list()?.isNotEmpty() == true) }) {
+                out.add(Part(FILES + d, t.first, t.second, 2, t.third))
+            }
+        }
+        out.add(Part(EXT, "Language files", "Dictionaries and other language resources you imported. Can be big.", 2, false))
+        out.add(Part(MODELS, "Transformer models", "Downloaded or imported prediction models. Can be very big.", 2, false))
+        out.add(Part(THEMES, "Custom themes", "Themes you made or imported.", 3, true))
+        out.add(Part(DICT, "Personal dictionary", "Words you added yourself.", 3, false))
+        out.add(Part(CLIP, "Clipboard history", "Saved clips and clipboard files. Private data.", 3, false))
+        out.add(Part(TYPING, "Typing history", "What the keyboard learned from you, including Japanese and Chinese history.", 3, false))
+        return out
+    }
+
+    /** Describes any part id, also ones from another phone that do not exist here. */
+    fun forId(context: Context, id: String): Part {
+        available(context).firstOrNull { it.id == id }?.let { return it }
+        if (id.startsWith(PREF)) {
+            val n = id.removePrefix(PREF)
+            val info = prefInfo[n]
+            val sens = n in sensitiveNames
+            return Part(id, info?.first ?: pretty(n), info?.second ?: "Options saved in $n.", 1, !sens, sens)
+        }
+        if (id.startsWith(FILES)) {
+            val t = fileDirs[id.removePrefix(FILES)]
+            return Part(id, t?.first ?: id.removePrefix(FILES), t?.second ?: "Files used by your settings.", 2, t?.third ?: false)
+        }
+        return Part(id, id, "", 3, false)
+    }
+
+    fun defaultSelection(parts: List<Part>, shareOnly: Boolean): Set<String> =
+        parts.filter { !it.sensitive && (!shareOnly || it.shareSafe) }.map { it.id }.toSet()
+
+    /** Rough size in bytes of a file based part, or -1 when it is not file based. */
+    fun sizeOf(context: Context, id: String): Long {
+        fun walk(f: File?): Long = if (f == null || !f.exists()) 0L else f.walkTopDown().filter { it.isFile }.sumOf { it.length() }
+        return when {
+            id.startsWith(FILES) -> walk(File(context.filesDir, id.removePrefix(FILES)))
+            id == EXT -> walk(context.getExternalFilesDir(null))
+            id == MODELS -> walk(ModelPaths.getModelDirectory(context))
+            id == THEMES -> walk(ZipThemes.customThemesDir(context))
+            else -> -1L
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiBgEffects.kt b/java/src/org/futo/inputmethod/latin/uix/RasiBgEffects.kt
new file mode 100644
index 000000000..3a6a239b2
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/uix/RasiBgEffects.kt
@@ -0,0 +1,271 @@
+package org.futo.inputmethod.latin.uix
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.ImageDecoder
+import android.graphics.drawable.Animatable2
+import android.graphics.drawable.AnimatedImageDrawable
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.view.View
+import androidx.annotation.RequiresApi
+import org.futo.inputmethod.keyboard.Key
+import java.io.File
+
+/**
+ * Background effects: a transparent animated image (GIF, animated WebP/PNG) drawn BEHIND the keys,
+ * over the keyboard background, whenever you type. It can burst out from the pressed key (like an
+ * expanding shockwave) or fill the whole keyboard. Different effects can be set per key or group.
+ */
+object RasiBgEffects {
+    const val PREFS = "rasi_bgeffects"
+    const val MODE_BURST = "burst"
+    const val MODE_FILL = "fill"
+    private const val POOL = 2
+    private const val STATIC_MS = 700L
+    private const val MAX_DECODE = 720
+
+    private class Slot(val drawable: Drawable, val target: String) {
+        var cx = 0f
+        var cy = 0f
+        var start = 0L
+        var running = false
+    }
+
+    private val pools = HashMap<String, ArrayList<Slot>>()
+    private val nextIdx = HashMap<String, Int>()
+    private val failed = HashSet<String>()
+    private val files = HashMap<String, String>()
+    private var filesLoaded = false
+
+    fun prefs(context: Context) = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun dir(context: Context) = File(context.applicationContext.filesDir, "rasi_bgeffects").also { it.mkdirs() }
+
+    fun effectFile(context: Context, target: String = RasiEffects.DEFAULT): File? {
+        val name = prefs(context).getString(RasiEffects.k("file", target), null) ?: return null
+        val f = File(dir(context), name)
+        return if (f.exists()) f else null
+    }
+
+    private fun loadFiles(context: Context) {
+        if (filesLoaded) return
+        filesLoaded = true
+        files.clear()
+        for ((key, v) in prefs(context).all) {
+            if (v !is String) continue
+            val target = when {
+                key == "file" -> RasiEffects.DEFAULT
+                key.startsWith("file_") -> key.removePrefix("file_")
+                else -> continue
+            }
+            if (File(dir(context), v).exists()) files[target] = v
+        }
+    }
+
+    /** Exact key first, then its group, then "all keys". */
+    private fun resolve(context: Context, code: Int): String? {
+        loadFiles(context)
+        val exact = RasiEffects.keyTarget(code)
+        if (files.containsKey(exact)) return exact
+        val g = RasiEffects.groupFor(code)
+        if (g != null && files.containsKey(g)) return g
+        return if (files.containsKey(RasiEffects.DEFAULT)) RasiEffects.DEFAULT else null
+    }
+
+    fun reload() {
+        for (list in pools.values) for (s in list) {
+            if (Build.VERSION.SDK_INT >= 28) stopDrawable(s.drawable)
+        }
+        pools.clear()
+        RasiChroma.releaseCache()
+        nextIdx.clear()
+        failed.clear()
+        files.clear()
+        filesLoaded = false
+    }
+
+    @RequiresApi(28)
+    private fun stopDrawable(d: Drawable) {
+        if (d is AnimatedImageDrawable) d.stop()
+        if (d is ChromaDrawable) d.stop()
+    }
+
+    fun importEffect(context: Context, uri: android.net.Uri, target: String = RasiEffects.DEFAULT): Boolean {
+        val ctx = context.applicationContext
+        return try {
+            val name = "bg_${target}_${System.currentTimeMillis()}.bin"
+            val out = File(dir(ctx), name)
+            ctx.contentResolver.openInputStream(uri)?.use { input ->
+                out.outputStream().use { input.copyTo(it) }
+            } ?: return false
+            if (out.length() > 12_000_000L) {
+                out.delete()
+                android.widget.Toast.makeText(ctx, "File is too large, use one under 12 MB", android.widget.Toast.LENGTH_LONG).show()
+                return false
+            }
+            effectFile(ctx, target)?.deleteRecursively()
+            prefs(ctx).edit().putString(RasiEffects.k("file", target), name).apply()
+            reload()
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /** Folder for baked chroma-key frames of a target; commit it with [commitFrames]. */
+    fun newFramesDir(context: Context, target: String): File =
+        File(dir(context.applicationContext), "chroma_${target}_${System.currentTimeMillis()}.frames")
+
+    fun commitFrames(context: Context, target: String, frames: File) {
+        val ctx = context.applicationContext
+        effectFile(ctx, target)?.deleteRecursively()
+        prefs(ctx).edit().putString(RasiEffects.k("file", target), frames.name).apply()
+        reload()
+    }
+
+    fun clear(context: Context, target: String = RasiEffects.DEFAULT) {
+        effectFile(context, target)?.deleteRecursively()
+        prefs(context).edit().remove(RasiEffects.k("file", target)).apply()
+        reload()
+    }
+
+    fun decode(context: Context, target: String = RasiEffects.DEFAULT): Drawable? {
+        if (Build.VERSION.SDK_INT < 28) return null
+        val f = effectFile(context, target) ?: return null
+        return decodeFile(f)
+    }
+
+    // Big images are scaled down while decoding so they stay smooth and light on memory
+    @RequiresApi(28)
+    private fun decodeFile(f: File): Drawable? = try {
+        if (f.isDirectory) RasiChroma.loadFrames(f) else ImageDecoder.decodeDrawable(
+            ImageDecoder.createSource(f),
+            ImageDecoder.OnHeaderDecodedListener { decoder, info, _ ->
+                val w = info.size.width
+                val h = info.size.height
+                val m = maxOf(w, h)
+                if (m > MAX_DECODE) {
+                    val sc = MAX_DECODE.toFloat() / m
+                    decoder.setTargetSize((w * sc).toInt().coerceAtLeast(1), (h * sc).toInt().coerceAtLeast(1))
+                }
+            }
+        )
+    } catch (e: Throwable) {
+        null
+    }
+
+    private fun poolFor(context: Context, target: String): ArrayList<Slot>? {
+        pools[target]?.let { return it }
+        if (failed.contains(target)) return null
+        if (Build.VERSION.SDK_INT < 28) return null
+        val f = effectFile(context, target)
+        if (f == null) {
+            failed.add(target)
+            return null
+        }
+        val list = ArrayList<Slot>()
+        repeat(POOL) {
+            val d = decodeFile(f) ?: return@repeat
+            list.add(Slot(d, target))
+        }
+        if (list.isEmpty()) {
+            failed.add(target)
+            return null
+        }
+        pools[target] = list
+        return list
+    }
+
+    /** Called when a key is pressed on the main keyboard view. */
+    @JvmStatic
+    fun spawn(view: View, key: Key) {
+        if (RasiPerf.isOn()) return
+        try {
+            val ctx = view.context
+            if (!prefs(ctx).getBoolean("enabled", false)) return
+            val target = resolve(ctx, key.code) ?: return
+            val list = poolFor(ctx, target) ?: return
+            val n = nextIdx[target] ?: 0
+            nextIdx[target] = n + 1
+            val slot = list[n % list.size]
+            slot.cx = key.x + key.width / 2f + view.paddingLeft
+            slot.cy = key.y + key.height / 2f + view.paddingTop
+            slot.start = System.currentTimeMillis()
+            slot.running = true
+            if (Build.VERSION.SDK_INT >= 28) startDrawable(slot)
+            view.postInvalidateOnAnimation()
+        } catch (t: Throwable) {
+        }
+    }
+
+    @RequiresApi(28)
+    private fun startDrawable(slot: Slot) {
+        val d = slot.drawable
+        if (d is AnimatedImageDrawable) {
+            d.stop()
+            d.repeatCount = 0
+            d.clearAnimationCallbacks()
+            d.registerAnimationCallback(object : Animatable2.AnimationCallback() {
+                override fun onAnimationEnd(drawable: Drawable?) {
+                    slot.running = false
+                }
+            })
+            d.start()
+        } else if (d is ChromaDrawable) {
+            d.loop = false
+            d.onEnd = { slot.running = false }
+            d.start()
+        }
+    }
+
+    /** Draws active effects. Called from the keyboard view after its background and before the keys. */
+    @JvmStatic
+    fun draw(view: View, canvas: Canvas) {
+        if (pools.isEmpty()) return
+        try {
+            val p = prefs(view.context)
+            val fill = p.getString("mode", MODE_BURST) == MODE_FILL
+            val w = view.width.toFloat()
+            val h = view.height.toFloat()
+            val now = System.currentTimeMillis()
+            var any = false
+
+            for (list in pools.values) for (s in list) {
+                if (!s.running) continue
+                val opacity = (p.getFloat(RasiEffects.k("alpha", s.target), 100f) / 100f).coerceIn(0f, 1f)
+                val animated = Build.VERSION.SDK_INT >= 28 && isAnimated(s.drawable)
+                var fade = 1f
+                var grow = 1f
+                if (!animated) {
+                    val t = (now - s.start).toFloat() / STATIC_MS
+                    if (t >= 1f) {
+                        s.running = false
+                        continue
+                    }
+                    fade = 1f - t
+                    grow = 0.3f + 0.7f * t
+                }
+                s.drawable.alpha = (255 * opacity * fade).toInt()
+                (s.drawable as? ChromaDrawable)?.stretch = fill
+                if (fill) {
+                    s.drawable.setBounds(0, 0, w.toInt(), h.toInt())
+                } else {
+                    val scale = p.getFloat(RasiEffects.k("size", s.target), 100f) / 100f
+                    val half = (maxOf(w, h) * scale * grow).toInt()
+                    s.drawable.setBounds(
+                        (s.cx - half).toInt(), (s.cy - half).toInt(),
+                        (s.cx + half).toInt(), (s.cy + half).toInt()
+                    )
+                }
+                s.drawable.draw(canvas)
+                any = true
+            }
+            if (any) view.postInvalidateOnAnimation()
+        } catch (t: Throwable) {
+        }
+    }
+
+    @RequiresApi(28)
+    private fun isAnimated(d: Drawable) = d is AnimatedImageDrawable || d is ChromaDrawable
+}
diff --git a/java/src/org/futo/inputmethod/latin/uix/RasiChroma.kt b/java/src/org/futo/inputmethod/latin/uix/RasiChroma.kt
