+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiEmojiWords.kt
@@ -0,0 +1,96 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import org.futo.inputmethod.latin.R
+
+/** Offline word -> best emoji index (built from Unicode/emojibase keywords plus hand-picked slang). */
+object RasiEmojiWords {
+    @Volatile
+    private var map: HashMap<String, List<String>>? = null
+    @Volatile
+    private var sortedKeys: Array<String>? = null
+
+    @JvmStatic
+    fun ensureLoaded(context: Context) {
+        if (map != null) return
+        synchronized(this) {
+            if (map != null) return
+            val m = HashMap<String, List<String>>(8192)
+            try {
+                context.applicationContext.resources.openRawResource(R.raw.rasi_emoji_words)
+                    .bufferedReader(Charsets.UTF_8).useLines { lines ->
+                        lines.forEach { line ->
+                            val t = line.indexOf('\t')
+                            if (t > 0) m[line.substring(0, t)] = line.substring(t + 1).trim().split(' ').filter { it.isNotEmpty() }
+                        }
+                    }
+            } catch (e: Exception) {
+                // keep whatever loaded
+            }
+            sortedKeys = m.keys.sorted().toTypedArray()
+            map = m
+        }
+    }
+
+    /**
+     * For a half-typed word ("ple"), vote among the words that start with it ("plead", "please",
+     * "pleading"...) and return the emoji they agree on. Nothing is returned for weak matches.
+     */
+    @JvmStatic
+    fun lookupPrefix(prefix: String): List<String> {
+        val m = map ?: return emptyList()
+        val keys = sortedKeys ?: return emptyList()
+        val p = prefix.lowercase()
+        if (p.length < 3 || p.length > 12) return emptyList()
+        var lo = 0
+        var hi = keys.size
+        while (lo < hi) {
+            val mid = (lo + hi) ushr 1
+            if (keys[mid] < p) lo = mid + 1 else hi = mid
+        }
+        val score = HashMap<String, Double>()
+        var seen = 0
+        var close = false
+        var i = lo
+        while (i < keys.size && keys[i].startsWith(p) && seen < 60) {
+            val w = keys[i]
+            val extra = w.length - p.length
+            if (extra in 1..3) close = true
+            val weight = 1.0 / (1 + extra)
+            m[w]?.forEachIndexed { idx, e ->
+                if (idx < 3) score[e] = (score[e] ?: 0.0) + weight / (1 + idx)
+            }
+            seen++
+            i++
+        }
+        if (!close) return emptyList()
+        val threshold = if (p.length == 3) 1.0 else 0.4 // short prefixes need strong agreement
+        return score.entries.filter { it.value >= threshold }
+            .sortedByDescending { it.value }.take(2).map { it.key }
+    }
+
+    /** Up to 3 emoji for a word, best first. Tries simple plural/verb endings. */
+    @JvmStatic
+    fun lookup(word: String): List<String> {
+        val m = map ?: return emptyList()
+        val w = word.lowercase()
+        m[w]?.let { return it }
+        val variants = ArrayList<String>(6)
+        if (w.endsWith("ies") && w.length > 4) variants.add(w.dropLast(3) + "y")
+        if (w.endsWith("ing") && w.length > 5) {
+            val s = w.dropLast(3)
+            variants.add(s); variants.add(s + "e")
+            if (s.length > 2 && s[s.length - 1] == s[s.length - 2]) variants.add(s.dropLast(1))
+        }
+        if (w.endsWith("ed") && w.length > 4) {
+            val s = w.dropLast(2)
+            variants.add(s); variants.add(s + "e")
+            if (s.length > 2 && s[s.length - 1] == s[s.length - 2]) variants.add(s.dropLast(1))
+        }
+        if (w.endsWith("es") && w.length > 4) variants.add(w.dropLast(2))
+        if (w.endsWith("s") && w.length > 3) variants.add(w.dropLast(1))
+        if (w.endsWith("ly") && w.length > 4) variants.add(w.dropLast(2))
+        for (v in variants) m[v]?.let { return it }
+        return emptyList()
+    }
+}
