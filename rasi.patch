+
+private fun fmtSize(b: Long): String =
+    if (b >= 1024L * 1024L) (b / (1024L * 1024L)).toString() + " MB" else if (b >= 1024L) (b / 1024L).toString() + " KB" else "$b B"
+
+/** Choose which settings and data go into the backup file. [share] starts with the safe-to-share choice. */
+@Composable
+fun RasiExportPickScreen(navController: NavHostController = rememberNavController(), share: Boolean = false) {
+    val ctx = LocalContext.current
+    val parts = remember { RasiBackupParts.available(ctx) }
+    val chosen = remember { mutableStateMapOf<String, Boolean>().also { m ->
+        val d = RasiBackupParts.defaultSelection(parts, share)
+        parts.forEach { m[it.id] = it.id in d }
+    } }
+    var strip by remember { mutableStateOf(share) }
+    val sizes = remember { mutableStateMapOf<String, Long>() }
+    LaunchedEffect(Unit) {
+        withContext(Dispatchers.IO) {
+            parts.forEach { p -> val s = RasiBackupParts.sizeOf(ctx, p.id); if (s >= 0) sizes[p.id] = s }
+        }
+    }
+    val count = chosen.values.count { it }
+
+    ScrollableList {
+        ScreenTitle(if (share) "Share settings" else "Export configuration", showBack = true, navController)
+        Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text(
+                "Pick what goes into the backup file. Parts that hold keys or your account start switched off. Nothing leaves your phone: you save the file yourself.",
+                style = MaterialTheme.typography.bodySmall
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedButton(onClick = { val d = RasiBackupParts.defaultSelection(parts, false); parts.forEach { chosen[it.id] = it.id in d } }) { Text("Everything") }
+                OutlinedButton(onClick = { val d = RasiBackupParts.defaultSelection(parts, true); parts.forEach { chosen[it.id] = it.id in d } }) { Text("Safe to share") }
+                OutlinedButton(onClick = { parts.forEach { chosen[it.id] = false } }) { Text("None") }
+            }
+        }
+        SettingToggleRaw(
+            "Leave out device-specific values", strip, { strip = it },
+            subtitle = "Skips API keys, the pill position and other things that only fit this phone. Also makes importing gentler: nothing existing is wiped."
+        )
+        for (g in 0..3) {
+            val gp = parts.filter { it.group == g }
+            if (gp.isEmpty()) continue
+            Text(
+                RasiBackupParts.groupNames[g], style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.Bold,
+                modifier = Modifier.padding(16.dp, 12.dp, 16.dp, 0.dp)
+            )
+            gp.forEach { p ->
+                val size = sizes[p.id]
+                val sub = p.desc +
+                    (if (p.sensitive) " Contains keys or account data: only for your own backup." else "") +
+                    (if (size != null) " (" + fmtSize(size) + ")" else "")
+                SettingToggleRaw(p.title, chosen[p.id] == true, { chosen[p.id] = it }, subtitle = sub)
+            }
+        }
+        Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text(count.toString() + " of " + parts.size + " parts chosen", style = MaterialTheme.typography.bodySmall)
+            Button(enabled = count > 0, onClick = {
+                SettingsExporter.selectionNext = chosen.filter { it.value }.keys.toSet()
+                navController.navigate(if (strip) "exportingcfgsmall" else "exportingcfg")
+            }) { Text("Export chosen parts") }
+        }
+    }
+}
