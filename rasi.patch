+    <string name="rasi_ac_protect">Protect short words from autocorrect</string>
+    <string name="rasi_ac_protect_sub">Slang like uwu and short words such as it are left alone. Undo an autocorrect once and that word is remembered</string>
+    <string name="rasi_ac_protect_len">Protect words up to this many letters</string>
+    <string name="rasi_next_fallback">Next-word suggestions from your typing</string>
+    <string name="rasi_next_fallback_sub">When a language has no next-word data, the bar shows words you often type, so it never goes empty. Works offline. Different from Personalized suggestions (learns your words) and Google suggestions (online)</string>
+    <string name="rasi_glide_boost">Favor my words when swiping</string>
+    <string name="rasi_glide_boost_sub">Words you use often move up in the swipe suggestions</string>
+    <string name="rasi_glide_strength">How much to favor my words</string>
+    <string name="rasi_glide_demote">Demote one-off learned words</string>
+    <string name="rasi_glide_demote_sub">Odd words that were learned only once drop down so they stop showing up as random suggestions</string>
+    <string name="rasi_gs_title">Google suggestions</string>
+    <string name="rasi_gs_subtitle">Niche words and names from Google while you type (uses the internet). Different from the offline options: it sends the word you are typing and up to 2 previous words to Google</string>
+    <string name="rasi_gs_notice">What is sent to Google: Level 1 sends the word you are typing and up to 2 words before it. Level 2 sends only one unknown word, to check that it is real. Level 3 sends the last sentence (up to the set number of words) to guess your next word. Glide checks send the top few swipe candidate words after a swipe. Text with an at sign or a long number is never sent. No account or ID is attached, but Google still sees your IP address. Your learned words never leave the phone. Never in password, email, web address or number fields, or in incognito mode. Off automatically in Performance mode.</string>
+    <string name="rasi_gs_enable">Enable Google suggestions</string>
+    <string name="rasi_gs_enable_sub">Level 1. Ask Google for extra suggestions. They join the bar after your normal ones</string>
+    <string name="rasi_gs_context">Use context</string>
+    <string name="rasi_gs_context_sub">Also send the previous words so niche phrases can match</string>
+    <string name="rasi_gs_ctx_words">Context words sent</string>
+    <string name="rasi_gs_min_letters">Minimum letters</string>
+    <string name="rasi_gs_max_results">Max Google results</string>
+    <string name="rasi_gs_weak_only">Only when local suggestions are weak</string>
+    <string name="rasi_gs_weak_only_sub">Skip Google when your own suggestions are already good</string>
+    <string name="rasi_gs_wifi">Wi-Fi only</string>
+    <string name="rasi_gs_wifi_sub">Do not use mobile data for Google suggestions or word checks</string>
+    <string name="rasi_gs_check">Check unknown words</string>
+    <string name="rasi_gs_check_sub">Level 2. When the dictionary does not know a word you typed and autocorrect wants to change it, ask Google if it is a real word so autocorrect leaves it alone. Only that one word is sent. If there is no internet, your on-device learning protects words instead</string>
+    <string name="rasi_gs_check_matches">Google matches needed to trust a word (higher is stricter)</string>
+    <string name="rasi_gs_first_notice">Rboard asks Google for help while you type. It sends only the word you are typing, plus up to 2 words before it. No account or ID is attached, but Google sees your IP address. Never in password, email, web address, number or incognito fields. Turn it off in Text Prediction, Google suggestions.</string>
+    <string name="rasi_gs_next">Next-word help from context</string>
+    <string name="rasi_gs_next_sub">Level 3. After you press space, sends the last sentence to Google to guess the next word. Sends more text than Levels 1 and 2. Without internet, your on-device next-word habits are used</string>
+    <string name="rasi_gs_next_words">Sentence words sent (Level 3)</string>
+    <string name="rasi_gs_next_results">Next-word results from Google</string>
+    <string name="rasi_gs_first_notice3">Next-word help is on: after a space, Rboard sends the last sentence you typed (up to 8 words) to Google to guess the next word. Never anything with an at sign or a long number, and never in password, email, web address, number or incognito fields. Turn it off in Text Prediction, Google suggestions.</string>
+    <string name="rasi_gs_glide">Check swipe candidates</string>
+    <string name="rasi_gs_glide_sub">After a swipe, asks Google if the top candidate words are real. Confirmed words move up in later swipes, unknown ones move down. The swipe itself is never delayed, and it gets better the more you swipe. Only the candidate words are sent</string>
+    <string name="rasi_gs_glide_count">Swipe candidates checked</string>
+    <string name="rasi_gs_glide_spots">How far Google can move a candidate</string>
+    <string name="rasi_gs_first_notice4">Swipe checks are on: after a swipe, Rboard sends the top few candidate words (no sentence) to Google to see which are real words. No account or ID is attached, but Google sees your IP address. Never in password, email, web address, number or incognito fields. Turn it off in Text Prediction, Google suggestions.</string>
+    <string name="rasi_gs_delay">Delay before asking</string>
+    <string name="rasi_learn_title">On-device learning</string>
+    <string name="rasi_learn_subtitle">Rboard learns your words, corrections, next-word habits and emoji on this phone only. Nothing is sent anywhere. Different from Google suggestions, which use the internet</string>
+    <string name="rasi_learn_notice">Learning stays on this phone in a private file. It never learns in password, email, web address or number fields or in incognito mode, and the learned list never leaves the phone.</string>
+    <string name="rasi_learn_master">Learn from my typing</string>
+    <string name="rasi_learn_master_sub">Master switch for everything below. Turning it off stops new learning but keeps what was already learned</string>
+    <string name="rasi_learn_words">Words, names and slang</string>
+    <string name="rasi_learn_words_sub">Remembers words the dictionary does not know, so they are suggested and not autocorrected away</string>
+    <string name="rasi_learn_corrections">My corrections</string>
+    <string name="rasi_learn_corrections_sub">When you undo an autocorrect, the word you really typed is protected from then on. Also remembers which suggestion you tap to fix a typo</string>
+    <string name="rasi_learn_pairs">Next-word habits</string>
+    <string name="rasi_learn_pairs_sub">Remembers which word usually follows which, to guess your next word</string>
+    <string name="rasi_learn_emoji">Emoji habits</string>
+    <string name="rasi_learn_emoji_sub">Remembers which emoji you pick for which word and shows those first</string>
+    <string name="rasi_use_protect">Protect words I use often</string>
+    <string name="rasi_use_protect_sub">Autocorrect leaves alone any word you typed at least the number of times set below, even slang like uwu, so it never turns into another word</string>
+    <string name="rasi_use_fixes">Autocorrect with my typo fixes</string>
+    <string name="rasi_use_fixes_sub">If you picked the same fix for a typo twice or more, autocorrect uses it next time. Words you use often are never changed</string>
+    <string name="rasi_use_pairs">Rank next words from my habits</string>
+    <string name="rasi_use_pairs_sub">After you type a word, the words you usually write next are moved to the front of the suggestion bar. Needs Next-word habits to be on</string>
+    <string name="rasi_use_pairs_max">Guesses from my habits</string>
+    <string name="rasi_use_pairs_max_sub">The most next-word guesses from your habits that can jump to the front. A word must have followed at least as many times as the trusted number below</string>
+    <string name="rasi_use_emoji">Emoji from my habits</string>
+    <string name="rasi_use_emoji_sub">Emoji suggestions start with the emoji you picked before for that word, most used first. Needs the Emoji suggestions option to be on</string>
+    <string name="rasi_use_emoji_taps">Taps before an emoji is suggested</string>
+    <string name="rasi_use_emoji_taps_sub">How many times you must pick an emoji for a word before it is suggested from your habits. Higher means fewer wrong guesses</string>
+    <string name="rasi_learn_trust">Uses before a word is trusted</string>
+    <string name="rasi_learn_trust_sub">A learned word is protected from autocorrect after you use it this many times. Lower learns faster, higher avoids saving typos</string>
+    <string name="rasi_learn_forget">Forget unused things after</string>
+    <string name="rasi_learn_forget_sub">Rarely used words are dropped, and next-word, typo-fix and emoji counts fade by half, after this long. Never keeps everything</string>
+    <string name="rasi_learn_view">What was learned</string>
+    <string name="rasi_learn_view_sub">See the words, next-word pairs, typo fixes and emoji Rboard learned, and delete single items</string>
+    <string name="rasi_learn_reset">Reset all learning</string>
+    <string name="rasi_learn_reset_sub">Deletes learned words, shortcuts, next-word habits, typo fixes and emoji habits from this phone. This cannot be undone</string>
+    <string name="rasi_friends_title">Friends</string>
+    <string name="rasi_friends_subtitle">Add friends by friend code or username, approve requests, block people (uses the internet)</string>
