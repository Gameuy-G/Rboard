+                    if (v.containsKey("bg_blur")) {
+                        Text("Cover background", fontWeight = FontWeight.Bold)
+                        LkSlider("Blur", " %", v["bg_blur"] as? Int ?: 40, 0, 100) { n -> RasiSongLooks.setValue(ctx, k, "bg_blur", n) }
+                        LkSlider("Darken", " %", v["bg_dim"] as? Int ?: 35, 0, 80) { n -> RasiSongLooks.setValue(ctx, k, "bg_dim", n) }
+                        LkSlider("Strength", " %", v["bg_opacity"] as? Int ?: 80, 10, 100) { n -> RasiSongLooks.setValue(ctx, k, "bg_opacity", n) }
+                    }
+                }
+            }
+            if (items.isNotEmpty()) {
+                OutlinedButton(onClick = { delAll = true }) { Text("Delete all saved looks") }
+            }
+        }
+    }
+
+    if (exportDlg) {
+        AlertDialog(
+            onDismissRequest = { exportDlg = false },
+            title = { Text("Export which looks?") },
+            text = {
+                Column(Modifier.verticalScroll(rememberScrollState())) {
+                    Row {
+                        RasiTextButton(onClick = { items.forEach { x -> chosen[x.key] = true } }) { Text("All") }
+                        RasiTextButton(onClick = { items.forEach { x -> chosen[x.key] = false } }) { Text("None") }
+                    }
+                    items.forEach { x ->
+                        Row(verticalAlignment = Alignment.CenterVertically) {
+                            Checkbox(checked = chosen[x.key] == true, onCheckedChange = { b -> chosen[x.key] = b })
+                            Text(if (x.name.isNotBlank()) x.name else x.title, style = MaterialTheme.typography.bodyMedium)
+                        }
+                    }
+                }
+            },
+            confirmButton = {
+                RasiTextButton(enabled = chosen.values.any { b -> b }, onClick = {
+                    pendingKeys = chosen.filter { e -> e.value }.keys.toSet()
+                    exportDlg = false
+                    saver.launch("rboard-song-looks.json")
+                }) { Text("Save file") }
+            },
+            dismissButton = { RasiTextButton(onClick = { exportDlg = false }) { Text("Cancel") } }
+        )
+    }
+    parsed?.let { list ->
+        AlertDialog(
+            onDismissRequest = { parsed = null },
+            title = { Text("Import " + list.size + " look(s)?") },
+            text = {
+                Column {
+                    Text("Looks for songs you already have are skipped, unless you switch the option below on.")
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Checkbox(checked = overwrite, onCheckedChange = { b -> overwrite = b })
+                        Text("Replace my looks for the same songs")
+                    }
+                }
+            },
+            confirmButton = {
+                RasiTextButton(onClick = {
+                    val r = RasiSongLooks.importParsed(ctx, list, overwrite)
+                    msg = "Added " + r.first + ", skipped " + r.second + "."
+                    parsed = null; refresh++
+                }) { Text("Import") }
+            },
+            dismissButton = { RasiTextButton(onClick = { parsed = null }) { Text("Cancel") } }
+        )
+    }
+
+    if (delKey != null) {
+        AlertDialog(
+            onDismissRequest = { delKey = null },
+            title = { Text("Delete this look?") },
+            text = { Text("The song goes back to your normal options.") },
+            confirmButton = { RasiTextButton(onClick = { RasiSongLooks.deleteKey(ctx, delKey!!); if (open == delKey) open = null; delKey = null; refresh++ }) { Text("Delete") } },
+            dismissButton = { RasiTextButton(onClick = { delKey = null }) { Text("Cancel") } }
+        )
+    }
+    if (delAll) {
+        AlertDialog(
+            onDismissRequest = { delAll = false },
+            title = { Text("Delete all saved looks?") },
+            text = { Text("This removes every saved look. It cannot be undone.") },
+            confirmButton = { RasiTextButton(onClick = { RasiSongLooks.clearAll(ctx); open = null; delAll = false; refresh++ }) { Text("Delete all") } },
+            dismissButton = { RasiTextButton(onClick = { delAll = false }) { Text("Cancel") } }
+        )
+    }
+}
