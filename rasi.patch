+/**
+ * Key shape presets (rounded, pill, square, borderless, flat) plus a roundness slider.
+ */
+@Composable
+internal fun KeyShapePicker(
+    roundness: Float,
+    borders: Boolean,
+    onChange: (roundness: Float, borders: Boolean) -> Unit
+) {
+    val presets = remember {
+        listOf(
+            ShapePreset(R.string.rasi_key_shape_rounded, 1f, true),
+            ShapePreset(R.string.rasi_key_shape_pill, 2.5f, true),
+            ShapePreset(R.string.rasi_key_shape_square, 0f, true),
+            ShapePreset(R.string.rasi_key_shape_borderless, null, false),
+            ShapePreset(R.string.rasi_key_shape_flat, 0f, false),
+        )
+    }
+
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(16.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        Row(
+            modifier = Modifier.horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            presets.forEach { p ->
+                val selected = p.borders == borders && (
+                        p.roundness?.let { abs(it - roundness) < 0.01f } ?: (roundness > 0.01f)
+                        )
+                val click = {
+                    val r = p.roundness ?: (if (roundness > 0.01f) roundness else 1f)
+                    onChange(r, p.borders)
+                }
+                if (selected) {
+                    Button(onClick = click) { Text(stringResource(p.label)) }
+                } else {
+                    OutlinedButton(onClick = click) { Text(stringResource(p.label)) }
+                }
+            }
+        }
