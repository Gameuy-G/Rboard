+/** Permanently deletes the online account (batch 6). Needs the password and the typed username. */
+@Composable
+fun RasiDeleteAccountScreen(navController: NavHostController = rememberNavController()) {
+    val ctx = LocalContext.current
+    val signedIn = RasiAccount.uid.value != null
+    val expected = RasiAccount.profile.value?.username ?: "delete"
+    var pass by remember { mutableStateOf("") }
+    var typed by remember { mutableStateOf("") }
+    var resetLocal by remember { mutableStateOf(true) }
+    val busy = RasiAccountDelete.busy.value
+    val status = RasiAccountDelete.status.value
+    val finished = RasiAccountDelete.done.value
+
+    ScrollableList {
+        ScreenTitle("Delete my account", showBack = true, navController)
+        Column(Modifier.padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            if (finished || !signedIn) {
+                Text(if (finished) "Your account was deleted." else "You are not signed in, so there is no account to delete here.", fontWeight = FontWeight.Bold)
+                Text("Your keyboard settings on this phone were not touched.", style = MaterialTheme.typography.bodySmall)
+                RasiTextButton(onClick = { RasiAccountDelete.done.value = false; RasiAccountDelete.status.value = ""; navController.popBackStack() }) { Text("Back") }
+            } else {
+                Text("This permanently deletes your online account. It cannot be undone.", fontWeight = FontWeight.Bold)
+                Text(
+                    "Removed: your profile and pictures, username and friend code, friend links on both sides, friend requests, " +
+                        "the chat messages you sent, your shared song and stats, your block list, and the sign-in itself. " +
+                        "A room you own is closed.",
+                    style = MaterialTheme.typography.bodySmall
+                )
+                Text(
+                    "Stays: messages your friends sent to you in their own chats, and your keyboard settings on this phone. " +
+                        "Your username becomes free for anyone to take.",
+                    style = MaterialTheme.typography.bodySmall
+                )
+                Text(
+                    "Needs the internet. If it stops half way, press delete again: finished steps are skipped.",
+                    style = MaterialTheme.typography.bodySmall
+                )
+                OutlinedTextField(
+                    pass, { pass = it }, label = { Text("Your password") }, singleLine = true,
+                    visualTransformation = PasswordVisualTransformation(), enabled = !busy, modifier = Modifier.fillMaxWidth()
+                )
+                OutlinedTextField(
+                    typed, { typed = it.trim().lowercase() },
+                    label = { Text("Type " + expected + " to confirm") }, singleLine = true,
+                    enabled = !busy, modifier = Modifier.fillMaxWidth()
+                )
+                SettingToggleRaw(
+                    "Also reset online options on this phone", resetLocal, { resetLocal = it },
+                    subtitle = "Clears live listening, alerts and cache choices kept for the account. Off keeps them for your next account"
+                )
+                Button(
+                    enabled = !busy && pass.isNotEmpty() && typed == expected,
+                    onClick = { RasiAccountDelete.start(ctx, pass, resetLocal) }
+                ) { Text(if (busy) "Deleting..." else "Delete my account forever") }
+                if (status.isNotBlank()) Text(status, style = MaterialTheme.typography.bodySmall, fontWeight = FontWeight.Bold)
+            }
+        }
+    }
+}
