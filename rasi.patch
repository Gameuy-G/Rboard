+      - type: base
+        spec: "~"
+      - type: base
+        spec: "`"
+      - type: base
+        spec: "|"
+      - type: base
+        spec: "\u2022"
+        moreKeys: "!text/morekeys_bullet"
+      - type: base
+        spec: "\u221A"
+      - type: base
+        spec: "\u03C0"
+        moreKeys: ["\u03A0", "\u03BC", "\u03A9"]
+      - type: base
+        spec: "\u00F7"
+      - type: base
+        spec: "\u00D7"
