+
+/** Preset colors for the chat theme (ARGB). */
+private val THEME_COLORS: List<Int> = listOf(
+    0xFFE53935, 0xFFFF7A59, 0xFFFFA726, 0xFFFFD54F, 0xFF4CD08A, 0xFF26C6DA, 0xFF5B8DEF, 0xFF7E57C2,
+    0xFFA66BFF, 0xFFEC6BA8, 0xFF8D6E63, 0xFF455A64, 0xFF263238, 0xFF000000, 0xFFFFFFFF, 0xFF9E9E9E
+).map { it.toInt() }
+
+/** Black or white, whichever is readable on this color. */
+internal fun chatContrast(c: Color): Color = if (c.red * 0.299f + c.green * 0.587f + c.blue * 0.114f > 0.6f) Color.Black else Color.White
+
+// ---- local background picture (only on this phone, never uploaded) ----
+
+private fun chatBgFile(c: Context, other: String) = java.io.File(c.filesDir, "chatbg_$other.jpg")
+
+internal fun hasChatBg(c: Context, other: String): Boolean = chatBgFile(c, other).exists()
+
+internal fun loadChatBg(c: Context, other: String): ImageBitmap? = try {
+    val f = chatBgFile(c, other)
+    if (f.exists()) BitmapFactory.decodeFile(f.path)?.asImageBitmap() else null
+} catch (t: Throwable) { null }
+
+internal fun removeChatBg(c: Context, other: String) { try { chatBgFile(c, other).delete() } catch (t: Throwable) { } }
+
+/** Copies the picked picture into the app, scaled so the longest side is at most about 1600 px. */
+private fun saveChatBg(c: Context, other: String, uri: Uri): Boolean {
+    try {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        c.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
+        var sample = 1
+        while (maxOf(bounds.outWidth, bounds.outHeight) / sample > 1600) sample *= 2
+        val opts = BitmapFactory.Options().apply { inSampleSize = sample }
+        val bmp = c.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, opts) } ?: return false
+        java.io.FileOutputStream(chatBgFile(c, other)).use { bmp.compress(Bitmap.CompressFormat.JPEG, 85, it) }
+        return true
+    } catch (t: Throwable) {
+        RasiLog.fallback("RasiChatTheme", "Background: " + t.javaClass.simpleName)
+        return false
+    }
+}
+
+/** Drawn behind the whole chat: a picture (with dimming) or a vertical gradient. Transparent colors draw nothing. */
+@Composable
+internal fun ChatBackground(pic: ImageBitmap?, dim: Float, top: Color, bottom: Color) {
+    Box(Modifier.fillMaxSize()) {
+        if (pic != null) {
+            Image(pic, null, Modifier.fillMaxSize(), contentScale = ContentScale.Crop)
+            if (dim > 0f) Box(Modifier.fillMaxSize().background(Color.Black.copy(alpha = dim)))
+        } else if (top.alpha > 0f || bottom.alpha > 0f) {
+            Box(Modifier.fillMaxSize().background(Brush.verticalGradient(listOf(top, bottom))))
+        }
+    }
+}
+
+@Composable
+private fun SwatchRow(title: String, desc: String, value: Int, noneLabel: String, onPick: (Int) -> Unit) {
+    Column(Modifier.padding(top = 10.dp)) {
+        Text(title, fontWeight = FontWeight.Bold, fontSize = 14.sp)
+        Text(desc, fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        Row(Modifier.padding(top = 4.dp).horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.CenterVertically) {
+            Text(noneLabel, Modifier.clip(RoundedCornerShape(10.dp))
+                .border(if (value == 0) 2.dp else 1.dp, if (value == 0) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.outline, RoundedCornerShape(10.dp))
+                .clickable { onPick(0) }.padding(horizontal = 10.dp, vertical = 6.dp), fontSize = 12.sp)
+            THEME_COLORS.forEach { c ->
+                Box(Modifier.size(30.dp).clip(CircleShape).background(Color(c))
+                    .border(if (value == c) 3.dp else 1.dp, if (value == c) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.outline, CircleShape)
+                    .clickable { onPick(c) })
+            }
+        }
+    }
+}
+
+@Composable
+private fun SwitchLine(title: String, desc: String, on: Boolean, onChange: (Boolean) -> Unit) {
+    Row(Modifier.fillMaxWidth().padding(top = 10.dp), verticalAlignment = Alignment.CenterVertically) {
+        Column(Modifier.weight(1f)) {
+            Text(title, fontWeight = FontWeight.Bold, fontSize = 14.sp)
+            Text(desc, fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+        Switch(checked = on, onCheckedChange = onChange)
+    }
+}
+
+/**
+ * Chat theme editor. "Shared" part is saved into the chat document (both people see it).
+ * "Only me" part (song color, background picture) stays on this phone.
+ */
+@Composable
+internal fun ChatThemeDialog(
+    other: String, myUid: String, current: RasiChats.Theme?, myIsA: Boolean, prefs: SharedPreferences,
+    songOn: Boolean, onSong: (Boolean) -> Unit, onPicChanged: () -> Unit, onClose: () -> Unit
+) {
+    val context = LocalContext.current
+    var on by remember { mutableStateOf(current?.mode == "custom") }
+    var mine by remember { mutableIntStateOf(if (current == null) 0 else if (myIsA) current.cA else current.cB) }
+    var theirs by remember { mutableIntStateOf(if (current == null) 0 else if (myIsA) current.cB else current.cA) }
+    var bg1 by remember { mutableIntStateOf(current?.bg1 ?: 0) }
+    var bg2 by remember { mutableIntStateOf(current?.bg2 ?: 0) }
+    var radius by remember { mutableFloatStateOf((current?.radius ?: 18).toFloat()) }
+    var style by remember { mutableIntStateOf(current?.style ?: 0) }
+    var dim by remember { mutableFloatStateOf(prefs.getInt("ch_bgdim_$other", 35).toFloat()) }
+    var hasPic by remember { mutableStateOf(hasChatBg(context, other)) }
+    var song by remember { mutableStateOf(songOn) }
+    val picker = rememberLauncherForActivityResult(ActivityResultContracts.GetContent()) { uri ->
+        if (uri != null) Thread {
+            val ok = saveChatBg(context, other, uri)
+            android.os.Handler(android.os.Looper.getMainLooper()).post { if (ok) { hasPic = true; onPicChanged() } }
+        }.start()
+    }
+    AlertDialog(
+        onDismissRequest = onClose,
+        title = { Text("Chat theme") },
+        text = {
+            Column(Modifier.verticalScroll(rememberScrollState())) {
+                Text("Shared with your friend", fontWeight = FontWeight.Bold, fontSize = 16.sp)
+                if (current != null && current.by.isNotBlank()) Text(
+                    if (current.by == myUid) "Last changed by you" else "Last changed by your friend",
+                    fontSize = 11.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                SwitchLine("Use a shared theme", "Both of you see the same colors in this chat. Either of you can change or reset it.", on) { on = it }
+                if (on) {
+                    SwatchRow("My bubbles", "Color of your messages (and your name in Discord style).", mine, "Default") { mine = it }
+                    SwatchRow("Their bubbles", "Color of your friend's messages.", theirs, "Default") { theirs = it }
+                    SwatchRow("Background top", "Top color of the chat background.", bg1, "None") { bg1 = it }
+                    SwatchRow("Background bottom", "Bottom color. Pick the same color as the top for a flat background.", bg2, "None") { bg2 = it }
+                    Text("Bubble roundness: " + radius.toInt(), Modifier.padding(top = 10.dp), fontSize = 14.sp, fontWeight = FontWeight.Bold)
+                    Text("How round the bubbles are (Bubbles style).", fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    Slider(value = radius, onValueChange = { radius = it }, valueRange = 0f..30f)
+                    Text("Message style for this chat", fontWeight = FontWeight.Bold, fontSize = 14.sp)
+                    Text("Both of you get this style here, unless someone picked their own with the Style button.", fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    Row(Modifier.padding(top = 4.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        listOf("Each own", "Discord", "Bubbles").forEachIndexed { i, label ->
+                            Text(label, Modifier.clip(RoundedCornerShape(10.dp))
+                                .border(if (style == i) 2.dp else 1.dp, if (style == i) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.outline, RoundedCornerShape(10.dp))
+                                .clickable { style = i }.padding(horizontal = 10.dp, vertical = 6.dp), fontSize = 13.sp)
+                        }
+                    }
+                }
+                Text("Only on this phone", Modifier.padding(top = 18.dp), fontWeight = FontWeight.Bold, fontSize = 16.sp)
+                SwitchLine("Follow my song color", "The background and your bubbles take the color of the song you are playing. Only you see it. Updates slowly in Performance mode.", song) { song = it; onSong(it) }
+                Text("Background picture", Modifier.padding(top = 10.dp), fontWeight = FontWeight.Bold, fontSize = 14.sp)
+                Text("A picture behind this chat. It stays on this phone, nothing is uploaded, your friend does not see it.", fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                    RasiTextButton(onClick = { picker.launch("image/*") }) { Text(if (hasPic) "Change picture" else "Choose picture") }
+                    if (hasPic) RasiTextButton(onClick = { removeChatBg(context, other); hasPic = false; onPicChanged() }) { Text("Remove") }
+                }
+                if (hasPic) {
+                    Text("Picture dimming: " + dim.toInt() + " %", fontSize = 14.sp, fontWeight = FontWeight.Bold)
+                    Text("Darkens the picture so the text stays readable.", fontSize = 12.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    Slider(value = dim, onValueChange = { dim = it }, valueRange = 0f..80f,
+                        onValueChangeFinished = { prefs.edit().putInt("ch_bgdim_$other", dim.toInt()).apply(); onPicChanged() })
