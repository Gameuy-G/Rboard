+package org.futo.inputmethod.latin.uix.actions.clipboard
+
+import androidx.compose.material3.ExperimentalMaterial3Api
+import androidx.compose.material3.SwipeToDismissBox
+import androidx.compose.material3.SwipeToDismissBoxValue
+import androidx.compose.material3.rememberSwipeToDismissBoxState
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.graphicsLayer
+
+/** Swipe a clipboard item sideways to delete it. Pinned items are not swipeable. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun RasiSwipeToDelete(
+    modifier: Modifier,
+    enabled: Boolean,
+    onDelete: () -> Unit,
+    content: @Composable () -> Unit
+) {
+    // The saveable swipe state used to be restored (still "dismissed") for a re-inserted item,
+    // which made it vanish again right after Undo. A per-composition key gives it a fresh state.
+    val nonce = androidx.compose.runtime.remember { System.nanoTime() }
+    androidx.compose.runtime.key(nonce) {
+    val fired = androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf(false) }
+    val state = rememberSwipeToDismissBoxState(
+        confirmValueChange = { value ->
+            if (value != SwipeToDismissBoxValue.Settled && !fired.value) {
+                // delete the moment the swipe is released, so rapid swipes never wait on the animation
+                fired.value = true
+                onDelete()
+            }
+            value != SwipeToDismissBoxValue.Settled
+        }
+    )
+
+    // Only delete after we have seen the row settled once, so a stale state can never delete.
+    val armed = androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf(false) }
+    androidx.compose.runtime.LaunchedEffect(Unit) {
+        if (state.currentValue != SwipeToDismissBoxValue.Settled) {
+            try { state.snapTo(SwipeToDismissBoxValue.Settled) } catch (e: Exception) { }
+        }
+    }
+    androidx.compose.runtime.LaunchedEffect(state.currentValue) {
+        if (state.currentValue == SwipeToDismissBoxValue.Settled) armed.value = true
+        else if (armed.value && !fired.value) { fired.value = true; onDelete() }
+    }
+
+    SwipeToDismissBox(
+        state = state,
+        modifier = modifier,
+        enableDismissFromStartToEnd = enabled,
+        enableDismissFromEndToStart = enabled,
+        gesturesEnabled = enabled,
+        backgroundContent = { }
+    ) {
+        androidx.compose.foundation.layout.Box(
+            Modifier.graphicsLayer {
+                val off = try { state.requireOffset() } catch (e: Exception) { 0f }
+                alpha = (1f - kotlin.math.abs(off) / size.width.coerceAtLeast(1f) * 1.3f).coerceIn(0f, 1f)
+            }
+        ) {
+            content()
+        }
+    }
+    }
+}
