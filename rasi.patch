+package org.futo.inputmethod.latin.uix.actions.clipboard
+
+import android.content.Context
+import android.content.SharedPreferences
+import androidx.compose.runtime.mutableStateOf
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * Moving a Gboard clipboard into Rboard. Two ways: paste many items at once (bulk import), or
+ * "import mode", which saves every item you copy into a section of the Rboard clipboard.
+ */
+object RasiClipImport {
+    const val DEFAULT_SECTION = "Imported"
+    const val SPLIT_BLANK = "blank"
+    const val SPLIT_LINE = "line"
+
+    /** Live state so the clipboard panel button updates at once. */
+    val modeOn = mutableStateOf(false)
+    private var loaded = false
+
+    fun prefs(c: Context): SharedPreferences =
+        c.applicationContext.getSharedPreferences("rasi_clip_import", Context.MODE_PRIVATE)
+
+    fun init(c: Context) {
+        if (loaded) return
+        loaded = true
+        modeOn.value = prefs(c).getBoolean("mode_on", false)
+    }
+
+    fun setMode(c: Context, on: Boolean) {
+        modeOn.value = on
+        prefs(c).edit().putBoolean("mode_on", on).apply()
+    }
+
+    fun skipDupes(c: Context) = prefs(c).getBoolean("skip_dupes", true)
+    fun saveImages(c: Context) = prefs(c).getBoolean("save_images", false)
+    fun splitMode(c: Context) = prefs(c).getString("split", SPLIT_BLANK) ?: SPLIT_BLANK
+
+    /** Items without a section disappear after 15 minutes, so imports always get a section. */
+    fun section(c: Context): String =
+        (prefs(c).getString("section", DEFAULT_SECTION) ?: DEFAULT_SECTION).trim().ifEmpty { DEFAULT_SECTION }
+
+    fun splitItems(text: String, mode: String): List<String> {
+        val t = text.replace("\r\n", "\n").replace('\r', '\n')
+        val parts = if (mode == SPLIT_LINE) t.split("\n") else t.split(Regex("\n\\s*\n"))
+        return parts.map { it.trim() }.filter { it.isNotEmpty() }
+    }
+
+    // ---- bulk import queue (kept on disk until the clipboard is ready) ----
+
+    private fun readPending(c: Context): JSONArray =
+        try { JSONArray(prefs(c).getString("pending", "[]")) } catch (e: Exception) { JSONArray() }
+
+    /** Returns how many items were queued. They are added right away if the clipboard is loaded. */
+    fun queue(c: Context, items: List<String>, section: String): Int {
+        val sec = section.trim().ifEmpty { DEFAULT_SECTION }
+        val arr = readPending(c)
+        for (i in items) arr.put(JSONObject().put("t", i).put("s", sec))
+        prefs(c).edit().putString("pending", arr.toString()).apply()
+        ClipboardHistoryManager.rasiInstance?.let { if (it.clipboardLoaded) drain(c, it) }
+        return items.size
+    }
+
+    fun pendingCount(c: Context): Int = readPending(c).length()
+
+    fun drain(c: Context, m: ClipboardHistoryManager) {
+        val arr = readPending(c)
+        if (arr.length() == 0) return
+        prefs(c).edit().remove("pending").apply()
+        val skip = skipDupes(c)
+        for (i in 0 until arr.length()) {
+            val o = arr.optJSONObject(i) ?: continue
+            m.rasiImportText(o.optString("t"), o.optString("s"), skip)
+        }
+    }
+}
