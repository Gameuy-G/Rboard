+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import org.futo.inputmethod.latin.rasi.RasiFonts
+
+/** Font style chips shown above the suggestion bar while the Fonts action is on. */
+@Composable
+fun RasiFontBar() {
+    val visible = RasiFonts.barVisibleState.value
+    AnimatedVisibility(
+        visible = visible,
+        enter = expandVertically(tween(180)) + fadeIn(tween(180)),
+        exit = shrinkVertically(tween(150)) + fadeOut(tween(150))
+    ) {
+        val scheme = LocalKeyboardScheme.current
+        val selected = RasiFonts.selectedState.intValue
+        Row(
+            Modifier.fillMaxWidth().height(48.dp).padding(horizontal = 6.dp, vertical = 4.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            Row(
+                Modifier.weight(1f).horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(6.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                RasiFonts.styles.forEachIndexed { i, style ->
+                    val shape = RoundedCornerShape(20.dp)
+                    Box(
+                        Modifier
+                            .height(38.dp)
+                            .clip(shape)
+                            .background(scheme.extended.keyboardContainer)
+                            .then(
+                                if (i == selected) Modifier.border(2.dp, scheme.base.primary, shape)
+                                else Modifier
+                            )
+                            .clickable { RasiFonts.selectedState.intValue = i }
+                            .padding(horizontal = 14.dp),
+                        contentAlignment = Alignment.Center
+                    ) {
+                        Text(
+                            style.apply(if (i == 0) "Normal" else style.name),
+                            color = scheme.extended.onKeyboardContainer,
+                            fontSize = 16.sp,
+                            maxLines = 1
+                        )
+                    }
+                }
+            }
+            Box(
+                Modifier
+                    .padding(start = 6.dp)
+                    .size(38.dp)
+                    .clip(CircleShape)
+                    .clickable { RasiFonts.closeBar() },
+                contentAlignment = Alignment.Center
+            ) {
+                Text("✕", color = scheme.extended.onKeyboardContainer, fontSize = 18.sp)
+            }
+        }
+    }
+}
