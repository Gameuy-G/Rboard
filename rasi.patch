@@ -0,0 +1,28 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import androidx.compose.runtime.mutableStateOf
+
+/** Two optional looks for the settings UI and the drawer. Both are off by default. Static drawing only, no animation. */
+object RasiUiStyle {
+    private const val FILE = "rasi_ui_style"
+    /** On: section headers become colored cards with an icon and a per-category accent. */
+    val cards = mutableStateOf(false)
+    /** On: pressable rows get chevrons, buttons become pills, plain text rows lose their box. */
+    val press = mutableStateOf(false)
+    @Volatile private var loaded = false
+
+    fun init(c: Context) {
+        if (loaded) return
+        val p = c.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+        cards.value = p.getBoolean("cards", false)
+        press.value = p.getBoolean("press", false)
+        loaded = true
+    }
+
+    fun set(c: Context, which: String, on: Boolean) {
+        init(c)
+        c.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE).edit().putBoolean(which, on).apply()
+        if (which == "cards") cards.value = on else press.value = on
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiUndo.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiUndo.kt
new file mode 100644
index 000000000..09c75de46
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiUndo.kt
@@ -0,0 +1,127 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.os.SystemClock
+import androidx.compose.runtime.mutableStateOf
+
+/**
+ * Remembers text removed by hold-delete (or a cut / selection delete) so the suggestion bar can
+ * offer an "Undo" button that puts it back. Never touches the clipboard.
+ */
+object RasiUndo {
+    @JvmField val available = mutableStateOf(false)
+
+    private val buf = StringBuilder()
+    private var pos = -1
+    private var lastRecordAt = 0L
+
+    @JvmField var performer: Runnable? = null
+
+    private const val SETTLE_MS = 2500L
+    private const val GROUP_MS = 800L
+
+    /** Gives the live input connection of the focused editor. */
+    @JvmField var connectionProvider: (() -> android.view.inputmethod.InputConnection?)? = null
+
+    private var sawHold = false
+    private var rapid = 0
+    private const val RAPID_MS = 100L
+    private val wordGap = Regex("\\s\\S")
+
+    /**
+     * Text removed by backspace. Earlier-deleted text sits after later-deleted text.
+     * Undo is only offered after a HOLD-delete (repeat flag, or several deletes in very quick
+     * succession, never plain taps) that removed at least one whole word.
+     */
+    @JvmStatic
+    fun record(deleted: String, repeat: Boolean) {
+        if (deleted.isEmpty()) return
+        val now = SystemClock.uptimeMillis()
+        val gap = now - lastRecordAt
+        if (gap > GROUP_MS) {
+            buf.setLength(0)
+            available.value = false
+            sawHold = false
+            rapid = 0
+        } else if (gap <= RAPID_MS) {
+            rapid++
+        }
+        if (repeat || rapid >= 2) sawHold = true
+        buf.insert(0, deleted)
+        lastRecordAt = now
+        pos = -1
+        if (!sawHold) return
+        val stamp = now
+        android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
+            if (lastRecordAt != stamp || buf.isEmpty()) return@postDelayed
+            val t = buf.toString()
+            val ic = connectionProvider?.invoke()
+            val before = ic?.getTextBeforeCursor(1, 0)
+            val atBoundary = before.isNullOrEmpty() || before[0].isWhitespace()
+            val letters = t.count { !it.isWhitespace() }
+            // A whole word is gone when the run reached a word boundary (any stuck-together
+            // letters count as a word) or it already spans a space-separated word.
+            if (wordGap.containsMatchIn(t) || (atBoundary && letters >= 2)) {
+                available.value = true
+            }
+        }, 250)
+    }
+
+    /** Text just cut: offer undo immediately (no waiting on selection callbacks). */
+    @JvmStatic
+    fun noteCut(text: String?) {
+        if (text.isNullOrEmpty()) return
+        buf.setLength(0)
+        buf.append(text)
+        lastRecordAt = SystemClock.uptimeMillis()
+        pos = -1
+        available.value = true
+    }
+
+    /** Cursor moves by the user (after things settle) drop the undo offer. */
+    @JvmStatic
+    fun onSelectionUpdate(oldStart: Int, oldEnd: Int, newStart: Int, newEnd: Int) {
+        if (!available.value) return
+        val now = SystemClock.uptimeMillis()
+        if (now - lastRecordAt < SETTLE_MS) return
+        if (newStart != newEnd) { clear(); return }
+        if (pos == -1) { pos = newStart; return }
+        if (newStart != pos) clear()
+    }
+
+    @JvmStatic
+    fun clear() {
+        available.value = false
+        buf.setLength(0)
+        pos = -1
+    }
+
+    /** Returns the text to put back (and clears), or null if there is nothing to restore. */
+    @JvmStatic
+    fun take(): String? {
+        if (!available.value || buf.isEmpty()) {
+            clear()
+            return null
+        }
+        val s = buf.toString()
+        clear()
+        return s
+    }
+
+    @JvmStatic
+    fun perform() {
+        val text = take()
+        if (text == null) return
+        val ic = connectionProvider?.invoke()
+        if (ic != null) {
+            ic.beginBatchEdit()
+            ic.finishComposingText()
+            ic.commitText(text, 1)
+            ic.endBatchEdit()
+        } else {
+            // fall back to the input-logic path
+            buf.append(text)
+            available.value = true
+            performer?.run()
+        }
+    }
+}
