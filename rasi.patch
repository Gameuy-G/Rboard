+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.unit.dp
+
+/**
+ * Greys out [content] and blocks touches while [disabled] is true, and says why underneath.
+ * Used for settings that only work when another toggle is on.
+ */
+@Composable
+fun RasiGreyable(disabled: Boolean, why: String, content: @Composable () -> Unit) {
+    Column {
+        Box(
+            Modifier
+                .alpha(if (disabled) 0.4f else 1f)
+                .let {
+                    if (disabled) it.pointerInput(Unit) {
+                        awaitPointerEventScope {
+                            while (true) {
+                                awaitPointerEvent(PointerEventPass.Initial).changes.forEach { c -> c.consume() }
+                            }
+                        }
+                    } else it
+                }
+        ) { content() }
+        if (disabled) {
+            Text(
+                why,
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(horizontal = 24.dp, vertical = 2.dp)
+            )
+        }
+    }
+}
