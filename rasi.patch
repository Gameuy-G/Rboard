+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import org.futo.inputmethod.latin.Dictionary
+import org.futo.inputmethod.latin.NgramContext
+import org.futo.inputmethod.latin.SuggestedWords
+import org.futo.inputmethod.latin.common.ComposedData
+import org.futo.inputmethod.latin.settings.SettingsValuesForSuggestion
+import java.util.Locale
+import org.futo.inputmethod.latin.SuggestedWords.SuggestedWordInfo
+import org.futo.inputmethod.latin.utils.SuggestionResults
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.InputStream
+import java.util.zip.ZipInputStream
+
+/** Marks suggestions that come from the Rasi word memory, so the typed word counts as a known word. */
+class RasiMemoryDictionary : Dictionary("rasi_memory", Locale.ROOT) {
+    override fun getNextValidCodePoints(composedData: ComposedData?): ArrayList<Int?>? = arrayListOf()
+
+    override fun getSuggestions(
+        composedData: ComposedData?, ngramContext: NgramContext?, proximityInfoHandle: Long,
+        settingsValuesForSuggestion: SettingsValuesForSuggestion?, sessionId: Int,
+        weightForLocale: Float, inOutWeightOfLangModelVsSpatialModel: FloatArray?
+    ): ArrayList<SuggestedWordInfo?>? = arrayListOf()
+
+    override fun isInDictionary(word: String?): Boolean = false
+}
+
+private val MEM_DICT = RasiMemoryDictionary()
+
+/** One learned thing for the "what was learned" list: [a] (and [b] for pairs, fixes and emoji) used [n] times. */
+data class RasiLearnedItem(val a: String, val b: String, val n: Int)
+
+/** Learns which emoji you tap for each word (offline, on-device) and ranks those first. */
+object RasiEmojiLearn {
+    private var prefs: SharedPreferences? = null
+    private val counts = HashMap<String, HashMap<String, Int>>()
+    private val shown = HashMap<String, String>() // emoji -> word it was offered for
+    private val totals = HashMap<String, Int>()   // emoji -> times tapped overall
+    private val handler = Handler(Looper.getMainLooper())
+
+    @JvmStatic
+    @Synchronized
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences("rasi_emoji_learn", Context.MODE_PRIVATE)
+        prefs = p
+        RasiLearnPrefs.init(context)
+        try {
+            val obj = JSONObject(p.getString("map", "{}") ?: "{}")
+            for (w in obj.keys()) {
+                val inner = obj.getJSONObject(w)
+                val m = HashMap<String, Int>()
+                for (e in inner.keys()) m[e] = inner.getInt(e)
+                counts[w] = m
+            }
+            val t = JSONObject(p.getString("totals", "{}") ?: "{}")
+            for (e in t.keys()) totals[e] = t.getInt(e)
+        } catch (e: Exception) { e.printStackTrace() }
+        if (RasiLearnPrefs.decayDue(p)) {
+            val it = counts.entries.iterator()
+            while (it.hasNext()) {
+                val m = it.next().value
+                val mi = m.entries.iterator()
+                while (mi.hasNext()) { val e = mi.next(); e.setValue(e.value / 2); if (e.value <= 0) mi.remove() }
+                if (m.isEmpty()) it.remove()
+            }
+            val ti = totals.entries.iterator()
+            while (ti.hasNext()) { val e = ti.next(); e.setValue(e.value / 2); if (e.value <= 0) ti.remove() }
+            save()
+            RasiLog.i("RasiLearn", "Emoji habits faded a little (forgetting speed)")
+        }
+    }
+
+    /** How often this emoji was tapped overall; used to put your favourites on the right. */
+    @JvmStatic
+    @Synchronized
+    fun usage(emoji: String): Int = totals[emoji] ?: 0
+
+    @Synchronized
+    private fun save() {
+        val tObj = JSONObject()
+        for ((e, c) in totals) tObj.put(e, c)
+        prefs?.edit()?.putString("totals", tObj.toString())?.apply()
+        val obj = JSONObject()
+        for ((w, m) in counts) {
+            val inner = JSONObject()
+            for ((e, c) in m) inner.put(e, c)
+            obj.put(w, inner)
+        }
+        prefs?.edit()?.putString("map", obj.toString())?.apply()
+    }
+
+    /** Called by the emoji lookup so a later tap knows which word the emoji was offered for. */
+    @JvmStatic
+    @Synchronized
+    fun noteShown(word: String, emoji: List<String>) {
+        if (shown.size > 64) shown.clear()
+        emoji.forEach { shown[it] = word }
+    }
+
+    /** Called when an emoji suggestion is tapped. */
+    @JvmStatic
+    @Synchronized
+    fun noteTapped(emoji: String) {
+        if (!RasiLearnPrefs.learnEmoji()) return
+        totals[emoji] = (totals[emoji] ?: 0) + 1
+        handler.removeCallbacks(saveTask)
+        handler.postDelayed(saveTask, 3000)
+        val word = shown[emoji] ?: return
+        // Teach the whole word and its prefixes (3+ letters) so the emoji shows up earlier next time
+        for (n in 3..word.length) {
+            val key = word.substring(0, n)
+            val m = counts.getOrPut(key) { HashMap() }
+            m[emoji] = (m[emoji] ?: 0) + (if (n == word.length) 2 else 1)
+        }
+        if (word.length < 3) {
+            val m = counts.getOrPut(word) { HashMap() }
+            m[emoji] = (m[emoji] ?: 0) + 2
+        }
+        while (counts.size > 20000) {
+            counts.entries.minByOrNull { it.value.values.sum() }?.let { counts.remove(it.key) } ?: break
+        }
+        handler.removeCallbacks(saveTask)
+        handler.postDelayed(saveTask, 3000)
+    }
+
+    private val saveTask = Runnable { save() }
+
+    @JvmStatic
+    @Synchronized
+    fun emojiCount(): Int = totals.size
+
+    /** Learned word -> emoji picks, most used first. */
+    @Synchronized
+    fun listAll(): List<RasiLearnedItem> =
+        counts.flatMap { (w, m) -> m.map { RasiLearnedItem(w, it.key, it.value) } }.sortedByDescending { it.n }
+
+    @Synchronized
+    fun delete(word: String, emoji: String) {
+        val m = counts[word] ?: return
+        m.remove(emoji)
+        if (m.isEmpty()) counts.remove(word)
+        save()
+    }
+
+    @Synchronized
+    fun clearAll() {
+        counts.clear(); totals.clear(); shown.clear(); save()
+    }
+
+    /** Emoji you picked for this word, most-tapped first. */
+    @JvmStatic
+    @Synchronized
+    fun learnedFor(word: String, minCount: Int = 1): List<String> =
+        counts[word]?.entries?.filter { it.value >= minCount }?.sortedByDescending { it.value }?.map { it.key } ?: emptyList()
+}
+
+/**
+ * Remembers words you commit (names, slang, anything the dictionary lacks) and words imported
+ * from a Gboard dictionary file, and offers them right after the first use.
+ */
+object RasiWordMemory {
+    private const val MAX_WORDS = 20000
+    private var prefs: SharedPreferences? = null
+    private val words = HashMap<String, IntArray>()      // lowercase -> [count, lastUsedSeconds]
+    private val display = HashMap<String, String>()      // lowercase -> best capitalisation
+    private val shortcuts = HashMap<String, String>()    // lowercase shortcut -> phrase
+    private val handler = Handler(Looper.getMainLooper())
+    @Volatile private var loaded = false
+
+    @JvmStatic
+    @Synchronized
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences("rasi_word_memory", Context.MODE_PRIVATE)
+        prefs = p
+        RasiLearnPrefs.init(context)
+        try {
+            val obj = JSONObject(p.getString("data", "{}") ?: "{}")
+            val w = obj.optJSONObject("w")
+            if (w != null) for (k in w.keys()) {
+                val a = w.getJSONArray(k)
+                words[k.lowercase()] = intArrayOf(a.getInt(1), a.getInt(2))
+                display[k.lowercase()] = a.getString(0)
+            }
+            val s = obj.optJSONObject("s")
+            if (s != null) for (k in s.keys()) shortcuts[k] = s.getString(k)
+            val b = obj.optJSONObject("b")
+            if (b != null) for (prev in b.keys()) {
+                val inner = b.getJSONObject(prev)
+                val m = HashMap<String, Int>()
+                for (nx in inner.keys()) { m[nx] = inner.getInt(nx); bigramTotal++ }
+                bigrams[prev] = m
+            }
+            val f = obj.optJSONObject("f")
+            if (f != null) for (typo in f.keys()) {
+                val inner = f.getJSONObject(typo)
+                val m = HashMap<String, Int>()
+                for (w in inner.keys()) m[w] = inner.getInt(w)
+                fixes[typo] = m
+            }
+        } catch (e: Exception) { e.printStackTrace() }
+        try { forgetOld(p) } catch (e: Exception) { RasiLog.w("RasiLearn", "Forgetting step failed", e) }
+        try {
+            val dp = org.futo.inputmethod.latin.uix.PreferenceUtils.getDefaultSharedPreferences(context.applicationContext)
+            readSettings(dp)
+            dp.registerOnSharedPreferenceChangeListener(settingsListener)
+        } catch (e: Exception) { e.printStackTrace() }
+        loaded = true
+    }
+
+    // ---- Rasi typing helpers: short-word autocorrect protection + next-word fallback ----
+    private const val KEY_PROTECT = "rasi_ac_protect"
+    private const val KEY_PROTECT_LEN = "rasi_ac_protect_len"
+    private const val KEY_NEXT = "rasi_next_fallback"
+    private const val KEY_GLIDE = "rasi_glide_boost"
+    private const val KEY_GLIDE_STRENGTH = "rasi_glide_strength"
+    private const val KEY_GLIDE_DEMOTE = "rasi_glide_demote"
+    @Volatile private var glideBoost = true
+    @Volatile private var glideStrength = 50
+    @Volatile private var glideDemote = true
+    @Volatile private var protectEnabled = true
+    @Volatile private var protectLen = 3
+    @Volatile private var nextFallback = true
+    private val bigrams = HashMap<String, HashMap<String, Int>>()   // prev -> (next -> count), lowercase
+    private val fixes = HashMap<String, HashMap<String, Int>>()     // typo -> (word you picked -> count), lowercase
+    private var bigramTotal = 0
+    private const val MAX_BIGRAMS = 20000
+
+    @JvmStatic
+    fun nextFallbackEnabled(): Boolean = loaded && nextFallback
+
+    private val settingsListener = SharedPreferences.OnSharedPreferenceChangeListener { p, _ -> readSettings(p) }
+
+    private fun readSettings(p: SharedPreferences) {
+        protectEnabled = p.getBoolean(KEY_PROTECT, true)
+        protectLen = p.getInt(KEY_PROTECT_LEN, 3)
+        nextFallback = p.getBoolean(KEY_NEXT, true)
+        glideBoost = p.getBoolean(KEY_GLIDE, true)
+        glideStrength = p.getInt(KEY_GLIDE_STRENGTH, 50)
+        glideDemote = p.getBoolean(KEY_GLIDE_DEMOTE, true)
+    }
+
+    /**
+     * Re-orders swipe candidates (best first). Words you have used before climb up to a few places;
+     * words that exist only because they were learned once (user history, never used twice) drop down.
+     * Rank based, so it does not depend on the engine's score scale.
+     */
+    @JvmStatic
+    @Synchronized
+    fun rerankGlide(list: ArrayList<SuggestedWordInfo>) {
+        if (!loaded || !glideBoost || list.size < 2) return
+        val maxUp = glideStrength / 100.0 * 4.0
+        val keyed = list.mapIndexed { i, info ->
+            val used = words[info.mWord.lowercase()]?.get(0) ?: 0
+            var k = i.toDouble()
+            if (used >= 1) {
+                k -= maxUp * minOf(used, 10) / 10.0
+            } else if (glideDemote && info.mSourceDict?.mDictType == Dictionary.TYPE_USER_HISTORY) {
+                k += 3.0
+            }
+            Triple(k, i, info)
+        }.sortedWith(compareBy({ it.first }, { it.second }))
+        list.clear()
+        for (t in keyed) list.add(t.third)
+    }
+
+    /** Slang and short words people type on purpose; never autocorrected while protection is on. */
+    private val SLANG = hashSetOf(
+        "uwu", "owo", "lol", "lmao", "lmfao", "omg", "idk", "ngl", "tbh", "imo", "imho", "smh", "fr", "rn",
+        "ty", "thx", "pls", "plz", "bruh", "bro", "sus", "gg", "wp", "xd", "ikr", "irl", "fyi", "btw", "brb",
+        "afk", "ez", "wtf", "nvm", "jk", "np", "yw", "ily", "ik", "ok", "ye", "yea", "yeah", "nah", "istg",
+        "ong", "fam", "icl", "ofc", "tf", "af", "bc", "cuz", "tho", "kinda", "gonna", "wanna", "gotta"
+    )
+
+    /**
+     * True when this typed word must not be replaced by autocorrect: slang, words of 2 letters or fewer,
+     * and short words that are real words or that you have used or undone before.
+     */
+    @JvmStatic
+    @Synchronized
+    fun protectFromAutocorrect(word: String?, inDictionary: Boolean): Boolean {
+        if (!protectEnabled || word.isNullOrEmpty()) return false
+        val lower = word.lowercase()
+        if (lower in SLANG) return true
+        // Words you use often are yours, whatever their length
+        if (RasiLearnPrefs.protectLearned()) {
+            val used = words[lower]
+            if (used != null && used[0] >= RasiLearnPrefs.trustUses()) return true
+        }
+        val len = word.codePointCount(0, word.length)
+        if (len > protectLen) return false
+        if (len <= 2) return true
+        if (inDictionary) return true
+        val e = words[lower]
+        return e != null && e[0] >= 1
+    }
+
+    /** You undid an autocorrect: remember the word you really typed so it is left alone from now on. */
+    @JvmStatic
+    @Synchronized
+    fun rememberUndone(word: String?) {
+        if (word == null || !ok(word) || !RasiLearnPrefs.learnCorrections()) return
+        val key = word.lowercase()
+        val e = words.getOrPut(key) { intArrayOf(0, 0) }
+        val need = RasiLearnPrefs.trustUses().coerceAtLeast(2)
+        if (e[0] < need) e[0] = need
+        e[1] = (System.currentTimeMillis() / 1000L).toInt()
+        if (display[key] == null) display[key] = word
+        topCacheAt = 0L
+        scheduleSave()
+    }
+
+    /** Remember that [word] followed [prev] (both lowercase-folded). */
+    @JvmStatic
+    @Synchronized
+    fun learnPair(prev: String?, word: String?) {
+        if (prev == null || word == null || !ok(prev) || !ok(word) || !RasiLearnPrefs.learnPairs()) return
+        val m = bigrams.getOrPut(prev.lowercase()) { HashMap() }
+        val k = word.lowercase()
+        val old = m[k]
+        m[k] = (old ?: 0) + 1
+        if (old == null) bigramTotal++
+        if (bigramTotal > MAX_BIGRAMS) pruneBigrams()
+        scheduleSave()
+    }
+
+    private fun pruneBigrams() {
+        var thresh = 1
+        while (bigramTotal > MAX_BIGRAMS * 4 / 5 && thresh < 50) {
+            val it = bigrams.entries.iterator()
+            while (it.hasNext()) {
+                val e = it.next()
+                val inner = e.value.entries.iterator()
+                while (inner.hasNext()) {
+                    if (inner.next().value <= thresh) { inner.remove(); bigramTotal-- }
+                }
+                if (e.value.isEmpty()) it.remove()
+            }
+            thresh++
+        }
+    }
+
+    private var topCache: List<String> = emptyList()
+    private var topCacheAt = 0L
+
+    private fun topWords(): List<String> {
+        val now = System.currentTimeMillis()
+        if (now - topCacheAt > 30_000L) {
+            topCache = words.entries
+                .sortedWith(compareByDescending<Map.Entry<String, IntArray>> { it.value[0] }.thenByDescending { it.value[1] })
+                .take(40).map { display[it.key] ?: it.key }
+            topCacheAt = now
+        }
+        return topCache
+    }
+
+    private fun scriptFor(lang: String): Character.UnicodeScript? = when (lang) {
+        "ja", "zh", "ko" -> null
+        "ar", "fa", "ur", "ps", "ku", "sd" -> Character.UnicodeScript.ARABIC
+        "ru", "uk", "bg", "sr", "mk", "be", "kk" -> Character.UnicodeScript.CYRILLIC
+        "el" -> Character.UnicodeScript.GREEK
+        "he", "yi" -> Character.UnicodeScript.HEBREW
+        "hi", "mr", "ne" -> Character.UnicodeScript.DEVANAGARI
+        "bn" -> Character.UnicodeScript.BENGALI
+        "th" -> Character.UnicodeScript.THAI
+        else -> Character.UnicodeScript.LATIN
+    }
+
+    /**
+     * Next-word predictions are empty or short for some languages (no bigram data / no language model).
+     * Fills the bar up to 3 words from what you have typed before: words that followed the previous word,
+     * then your most used words in the same script. Returns null when nothing needs to change.
+     */
+    @JvmStatic
+    @Synchronized
+    fun fillPredictions(sw: SuggestedWords, ngram: NgramContext?, seq: Int, lang: String?): SuggestedWords? {
+        if (!loaded) return null
+        val promoted = promoteLearned(sw, ngram, seq, lang)
+        val filled = fillFallback(promoted ?: sw, ngram, seq, lang)
+        return filled ?: promoted
+    }
+
+    /**
+     * Moves next-word guesses from your own habits (words you followed the previous word with at least
+     * "uses before trusted" times) to the front of the bar. The rest keep their order. Returns null when nothing changes.
+     */
+    private fun promoteLearned(sw: SuggestedWords, ngram: NgramContext?, seq: Int, lang: String?): SuggestedWords? {
+        if (!RasiLearnPrefs.rankPairs()) return null
+        if (ngram?.isBeginningOfSentenceContext == true) return null
+        val prev = ngram?.getNthPrevWord(1)?.toString()?.lowercase()
+        if (prev.isNullOrEmpty()) return null
+        val script = scriptFor((lang ?: "en").lowercase()) ?: return null
+        val m = bigrams[prev] ?: return null
+        val need = RasiLearnPrefs.trustUses().coerceAtLeast(2)
+        val picks = m.entries
+            .filter { it.value >= need && it.key.isNotEmpty() && Character.UnicodeScript.of(it.key.codePointAt(0)) == script }
+            .sortedByDescending { it.value }
+            .take(RasiLearnPrefs.pairsMax())
+            .map { it.key }
+        if (picks.isEmpty()) return null
+        val have = sw.mSuggestedWordInfoList
+        val existing = HashMap<String, SuggestedWordInfo>()
+        for (i in have) existing.putIfAbsent(i.mWord.lowercase(), i)
+        var score = (have.firstOrNull()?.mScore ?: 1_000_000) + picks.size
+        val out = ArrayList<SuggestedWordInfo>()
+        for (k in picks) {
+            out.add(existing[k] ?: SuggestedWordInfo(display[k] ?: k, "", score, SuggestedWordInfo.KIND_PREDICTION,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+            score--
+        }
+        for (i in have) if (i.mWord.lowercase() !in picks) out.add(i)
+        val size = maxOf(have.size, 3)
+        while (out.size > size) out.removeAt(out.size - 1)
+        val style = if (sw.mInputStyle == SuggestedWords.INPUT_STYLE_BEGINNING_OF_SENTENCE_PREDICTION)
+            sw.mInputStyle else SuggestedWords.INPUT_STYLE_PREDICTION
+        return SuggestedWords(out, sw.mRawSuggestions, sw.mTypedWordInfo, sw.mTypedWordValid,
+            sw.mWillAutoCorrect, false, style, seq)
+    }
+
+    private fun fillFallback(sw: SuggestedWords, ngram: NgramContext?, seq: Int, lang: String?): SuggestedWords? {
+        if (!loaded || !nextFallback) return null
+        val have = sw.mSuggestedWordInfoList
+        val want = 3
+        if (have.size >= want) return null
+        val script = scriptFor((lang ?: "en").lowercase()) ?: return null
+        val seen = HashSet<String>()
+        for (i in have) seen.add(i.mWord.lowercase())
+        val cands = ArrayList<String>()
+        fun scriptOk(w: String) = w.isNotEmpty() && Character.UnicodeScript.of(w.codePointAt(0)) == script
+        val prev = ngram?.getNthPrevWord(1)?.toString()?.lowercase()
+        val bos = ngram?.isBeginningOfSentenceContext == true
+        if (!prev.isNullOrEmpty() && !bos) {
+            bigrams[prev]?.entries?.sortedByDescending { it.value }?.forEach {
+                if (have.size + cands.size < want && scriptOk(it.key) && seen.add(it.key.lowercase())) {
+                    cands.add(display[it.key] ?: it.key)
+                }
+            }
+        }
+        if (have.size + cands.size < want) {
+            for (w in topWords()) {
+                if (have.size + cands.size >= want) break
+                if (scriptOk(w) && seen.add(w.lowercase())) cands.add(w)
+            }
+        }
+        if (cands.isEmpty()) return null
+        val out = ArrayList<SuggestedWordInfo>(have)
+        var score = (have.lastOrNull()?.mScore ?: 1_000_000) - 1
+        for (w in cands) {
+            val shown = if (bos) w.replaceFirstChar { it.uppercase() } else w
+            out.add(SuggestedWordInfo(shown, "", score--, SuggestedWordInfo.KIND_PREDICTION,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+        }
+        val style = if (sw.mInputStyle == SuggestedWords.INPUT_STYLE_BEGINNING_OF_SENTENCE_PREDICTION)
+            sw.mInputStyle else SuggestedWords.INPUT_STYLE_PREDICTION
+        return SuggestedWords(out, sw.mRawSuggestions, sw.mTypedWordInfo, sw.mTypedWordValid,
+            sw.mWillAutoCorrect, false, style, seq)
+    }
+
+    private val saveTask = Runnable { save() }
+
+    private fun scheduleSave() {
+        handler.removeCallbacks(saveTask)
+        handler.postDelayed(saveTask, 5000)
+    }
+
+    @Synchronized
+    fun save() {
+        val w = JSONObject()
+        for ((k, v) in words) w.put(display[k] ?: k, JSONArray(listOf(display[k] ?: k, v[0], v[1])))
+        val s = JSONObject()
+        for ((k, v) in shortcuts) s.put(k, v)
+        val b = JSONObject()
+        for ((prev, m) in bigrams) {
+            val inner = JSONObject()
+            for ((nx, c) in m) inner.put(nx, c)
+            b.put(prev, inner)
+        }
+        val f = JSONObject()
+        for ((typo, m) in fixes) {
+            val inner = JSONObject()
+            for ((w2, c) in m) inner.put(w2, c)
+            f.put(typo, inner)
+        }
+        val obj = JSONObject().put("w", w).put("s", s).put("b", b).put("f", f)
+        prefs?.edit()?.putString("data", obj.toString())?.apply()
+    }
+
+    private fun ok(word: String) =
+        word.length in 2..30 && word.all { it.isLetter() || it == '\'' || it == '-' } && word.any { it.isLetter() }
+
+    /** Called whenever a word is committed in a field that allows learning. */
+    @JvmStatic
+    @Synchronized
+    fun learn(word: String?) {
+        if (word == null || !ok(word) || !RasiLearnPrefs.learnWords()) return
+        val key = word.lowercase()
+        val e = words.getOrPut(key) { intArrayOf(0, 0) }
+        e[0] = e[0] + 1
+        e[1] = (System.currentTimeMillis() / 1000L).toInt()
+        topCacheAt = 0L
+        // keep the capitalisation you used, but prefer one with capitals (names)
+        val old = display[key]
+        if (old == null || word != word.lowercase() || old == old.lowercase()) display[key] = word
+        if (words.size > MAX_WORDS) {
+            words.entries.minByOrNull { it.value[0] * 1_000_000L + it.value[1] / 1000 }?.let {
+                words.remove(it.key); display.remove(it.key)
+            }
+        }
+        scheduleSave()
+    }
+
+    @Synchronized fun wordCount() = words.size
+    @Synchronized fun shortcutCount() = shortcuts.size
+    @Synchronized fun pairCount() = bigramTotal
+    @Synchronized fun fixCount() = fixes.size
+
+    // ---- lists for the "what was learned" screen ----
+    @Synchronized
+    fun listWords(): List<RasiLearnedItem> =
+        words.entries.sortedByDescending { it.value[0] }.map { RasiLearnedItem(display[it.key] ?: it.key, "", it.value[0]) }
+
+    @Synchronized
+    fun deleteWord(shown: String) {
+        val k = shown.lowercase()
+        words.remove(k); display.remove(k); topCacheAt = 0L; save()
+    }
+
+    @Synchronized
+    fun listPairs(): List<RasiLearnedItem> =
+        bigrams.flatMap { (prev, m) -> m.map { RasiLearnedItem(prev, it.key, it.value) } }.sortedByDescending { it.n }
+
+    @Synchronized
+    fun deletePair(prev: String, next: String) {
+        val m = bigrams[prev] ?: return
+        if (m.remove(next) != null) bigramTotal--
+        if (m.isEmpty()) bigrams.remove(prev)
+        save()
+    }
+
+    @Synchronized
+    fun listFixes(): List<RasiLearnedItem> =
+        fixes.flatMap { (typo, m) -> m.map { RasiLearnedItem(typo, it.key, it.value) } }.sortedByDescending { it.n }
+
+    @Synchronized
+    fun deleteFix(typo: String, word: String) {
+        val m = fixes[typo] ?: return
+        m.remove(word)
+        if (m.isEmpty()) fixes.remove(typo)
+        save()
+    }
+
+    /** Fades things you have not used for a long time (see the forgetting speed setting). */
+    private fun forgetOld(p: SharedPreferences) {
+        val days = RasiLearnPrefs.forgetDays()
+        if (days >= RasiLearnPrefs.FORGET_NEVER) return
+        val cutoff = (System.currentTimeMillis() / 1000L - days * 86_400L).toInt()
+        val before = words.size
+        val wi = words.entries.iterator()
+        while (wi.hasNext()) {
+            val e = wi.next()
+            if (e.value[0] <= 3 && e.value[1] < cutoff) { display.remove(e.key); wi.remove() }
+        }
+        var faded = false
+        if (RasiLearnPrefs.decayDue(p)) {
+            faded = true
+            bigramTotal = 0
+            val bi = bigrams.entries.iterator()
+            while (bi.hasNext()) {
+                val m = bi.next().value
+                val mi = m.entries.iterator()
+                while (mi.hasNext()) { val e = mi.next(); e.setValue(e.value / 2); if (e.value <= 0) mi.remove() else bigramTotal++ }
+                if (m.isEmpty()) bi.remove()
+            }
+            val fi = fixes.entries.iterator()
+            while (fi.hasNext()) {
+                val m = fi.next().value
+                val mi = m.entries.iterator()
+                while (mi.hasNext()) { val e = mi.next(); e.setValue(e.value / 2); if (e.value <= 0) mi.remove() }
+                if (m.isEmpty()) fi.remove()
+            }
+        }
+        if (words.size != before || faded) {
+            RasiLog.i("RasiLearn", "Forgetting step: dropped ${before - words.size} rarely used words" + if (faded) ", faded next-word and fix counts" else "")
+            save()
+        }
+    }
+
+    /** You picked [word] from the suggestion bar while the typo [typed] was in the text box. */
+    @JvmStatic
+    @Synchronized
+    fun learnFix(typed: String?, word: String?) {
+        if (typed == null || word == null || !ok(typed) || !ok(word) || !RasiLearnPrefs.learnCorrections()) return
+        val t = typed.lowercase()
+        val w = word.lowercase()
+        if (t == w) return
+        val m = fixes.getOrPut(t) { HashMap() }
+        m[w] = (m[w] ?: 0) + 1
+        if (fixes.size > 5000) fixes.entries.minByOrNull { it.value.values.sum() }?.let { fixes.remove(it.key) }
+        scheduleSave()
+    }
+
+    @Synchronized
+    fun clearAll() {
+        words.clear(); display.clear(); shortcuts.clear(); bigrams.clear(); fixes.clear(); bigramTotal = 0; topCacheAt = 0L; save()
+    }
+
+    /** Add suggestions from memory to the typing results. Words need 2+ uses to be protected from autocorrect. */
+    @JvmStatic
+    @Synchronized
+    fun addTo(results: SuggestionResults, typed: String?) {
+        if (!loaded || typed.isNullOrEmpty() || typed.length > 30) return
+        val lower = typed.lowercase()
+        val top = if (results.isEmpty()) 1_000_000 else results.first().mScore
+        val have = HashSet<String>()
+        for (r in results) have.add(r.mWord.lowercase())
+
+        // Typo fix you chose at least twice before: put that word first so autocorrect uses it
+        if (RasiLearnPrefs.applyFixes() && lower !in SLANG) {
+            val used = words[lower]
+            val trusted = used != null && used[0] >= RasiLearnPrefs.trustUses()
+            val fixMap = fixes[lower]
+            if (!trusted && fixMap != null) {
+                val best = fixMap.entries.maxByOrNull { it.value }
+                if (best != null && best.value >= RasiLearnPrefs.trustUses().coerceAtLeast(2)) {
+                    val shownWord = if (typed[0].isUpperCase()) best.key.replaceFirstChar { it.uppercase() } else best.key
+                    val it = results.iterator()
+                    while (it.hasNext()) if (it.next().mWord.lowercase() == best.key) it.remove()
+                    results.add(SuggestedWordInfo(shownWord, "", top + 1, SuggestedWordInfo.KIND_CORRECTION,
+                        MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+                    have.add(best.key)
+                }
+            }
+        }
+
+        // Exact match you've used before: treat as a valid word so it isn't autocorrected away
+        val exact = words[lower]
+        if (exact != null && (exact[0] >= RasiLearnPrefs.trustUses() || exact[0] >= 1 && lower in importedKeys)) {
+            results.add(SuggestedWordInfo(typed, "", top + 1, SuggestedWordInfo.KIND_TYPED,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+            have.add(lower)
+        }
+
+        // Shortcut expansion (from imported Gboard shortcuts)
+        shortcuts[lower]?.let {
+            results.add(SuggestedWordInfo(it, "", top - 1, SuggestedWordInfo.KIND_COMPLETION,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+        }
+
+        if (lower.length < 2) return
+        var added = 0
+        val matches = words.entries.filter { it.key.startsWith(lower) && it.key != lower && it.key !in have }
+            .sortedWith(compareByDescending<Map.Entry<String, IntArray>> { it.value[0] }.thenByDescending { it.value[1] })
+        for (m in matches) {
+            if (added >= 3) break
+            results.add(SuggestedWordInfo(display[m.key] ?: m.key, "", top - 1 - added, SuggestedWordInfo.KIND_COMPLETION,
+                MEM_DICT, SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE))
+            added++
+        }
+    }
+
+    private val importedKeys = HashSet<String>()
+
+    /**
+     * Imports a Gboard personal-dictionary export (a .zip holding dictionary.txt, or the .txt itself).
+     * Lines are tab separated: shortcut, word, locale. Returns how many entries were added.
+     */
+    @JvmStatic
+    @Synchronized
+    fun importGboard(input: InputStream): Int {
+        val lines = ArrayList<String>()
+        val bytes = input.readBytes()
+        val isZip = bytes.size > 3 && bytes[0] == 'P'.code.toByte() && bytes[1] == 'K'.code.toByte()
+        if (isZip) {
+            ZipInputStream(bytes.inputStream()).use { z ->
+                var e = z.nextEntry
+                while (e != null) {
+                    if (!e.isDirectory && e.name.endsWith(".txt")) {
+                        lines.addAll(String(z.readBytes(), Charsets.UTF_8).lines())
+                    }
+                    e = z.nextEntry
+                }
+            }
+        } else {
+            lines.addAll(String(bytes, Charsets.UTF_8).lines())
+        }
+        var n = 0
+        for (raw in lines) {
+            val line = raw.trim('\uFEFF', '\r')
+            if (line.isBlank() || line.startsWith("#")) continue
+            val parts = line.split('\t')
+            val shortcut = if (parts.size >= 2) parts[0].trim() else ""
+            val phrase = (if (parts.size >= 2) parts[1] else parts[0]).trim()
+            if (phrase.isEmpty()) continue
+            if (shortcut.isNotEmpty() && !shortcut.equals(phrase, ignoreCase = true)) {
+                shortcuts[shortcut.lowercase()] = phrase
+                n++
+            }
+            // single words become known words straight away
+            if (ok(phrase)) {
+                val key = phrase.lowercase()
+                val e = words.getOrPut(key) { intArrayOf(0, 0) }
+                if (e[0] < 2) e[0] = 2
+                e[1] = (System.currentTimeMillis() / 1000L).toInt()
+                display[key] = phrase
+                importedKeys.add(key)
+                n++
+            }
+        }
+        scheduleSave()
+        return n
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiLearnPrefs.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiLearnPrefs.kt
new file mode 100644
index 000000000..1a72ebb4e
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiLearnPrefs.kt
@@ -0,0 +1,113 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+
+/**
+ * Switches for on-device learning (offline, private). Everything is ON by default.
+ * Read cheaply from the typing code; values refresh when the settings change.
+ */
+object RasiLearnPrefs {
+    const val KEY_MASTER = "rasi_learn_master"
+    const val KEY_WORDS = "rasi_learn_words"
+    const val KEY_CORRECTIONS = "rasi_learn_corrections"
+    const val KEY_PAIRS = "rasi_learn_pairs"
+    const val KEY_EMOJI = "rasi_learn_emoji"
+    const val KEY_TRUST = "rasi_learn_trust"
+    const val KEY_FORGET = "rasi_learn_forget"
+    const val KEY_USE_PROTECT = "rasi_use_protect"
+    const val KEY_USE_FIXES = "rasi_use_fixes"
+    const val KEY_USE_PAIRS = "rasi_use_pairs"
+    const val KEY_USE_EMOJI = "rasi_use_emoji"
+    const val KEY_EMOJI_TAPS = "rasi_use_emoji_taps"
+    const val KEY_PAIRS_MAX = "rasi_use_pairs_max"
+    const val FORGET_NEVER = 360
+
+    @Volatile private var master = true
+    @Volatile private var words = true
+    @Volatile private var corrections = true
+    @Volatile private var pairs = true
+    @Volatile private var emoji = true
+    @Volatile private var trust = 2
+    @Volatile private var forget = 180
+    @Volatile private var useProtect = true
+    @Volatile private var useFixes = true
+    @Volatile private var usePairs = true
+    @Volatile private var useEmoji = true
+    @Volatile private var emojiTaps = 1
+    @Volatile private var pairsMax = 2
+    @Volatile private var registered = false
+
+    private val listener = SharedPreferences.OnSharedPreferenceChangeListener { p, _ -> read(p) }
+
+    private fun read(p: SharedPreferences) {
+        master = p.getBoolean(KEY_MASTER, true)
+        words = p.getBoolean(KEY_WORDS, true)
+        corrections = p.getBoolean(KEY_CORRECTIONS, true)
+        pairs = p.getBoolean(KEY_PAIRS, true)
+        emoji = p.getBoolean(KEY_EMOJI, true)
+        trust = p.getInt(KEY_TRUST, 2).coerceIn(1, 5)
+        forget = p.getInt(KEY_FORGET, 180).coerceIn(30, FORGET_NEVER)
+        useProtect = p.getBoolean(KEY_USE_PROTECT, true)
+        useFixes = p.getBoolean(KEY_USE_FIXES, true)
+        usePairs = p.getBoolean(KEY_USE_PAIRS, true)
+        useEmoji = p.getBoolean(KEY_USE_EMOJI, true)
+        emojiTaps = p.getInt(KEY_EMOJI_TAPS, 1).coerceIn(1, 4)
+        pairsMax = p.getInt(KEY_PAIRS_MAX, 2).coerceIn(1, 3)
+    }
+
+    @JvmStatic
+    @Synchronized
+    fun init(context: Context) {
+        if (registered) return
+        try {
+            val dp = org.futo.inputmethod.latin.uix.PreferenceUtils.getDefaultSharedPreferences(context.applicationContext)
+            read(dp)
+            dp.registerOnSharedPreferenceChangeListener(listener)
+            registered = true
+        } catch (e: Exception) {
+            RasiLog.w("RasiLearnPrefs", "Could not read learning settings, using defaults", e)
+        }
+    }
+
+    @JvmStatic fun learnWords(): Boolean = master && words
+    @JvmStatic fun learnCorrections(): Boolean = master && corrections
+    @JvmStatic fun learnPairs(): Boolean = master && pairs
+    @JvmStatic fun learnEmoji(): Boolean = master && emoji
+
+    /** Autocorrect leaves words you use often alone. */
+    @JvmStatic fun protectLearned(): Boolean = master && useProtect
+    /** Next-word guesses from your own habits go to the front of the bar. */
+    @JvmStatic fun rankPairs(): Boolean = master && usePairs && pairs
+    /** Emoji suggestions start with the emoji you picked before for that word. */
+    @JvmStatic fun emojiHabits(): Boolean = master && useEmoji
+    /** Learned weight an emoji needs before it is suggested (an exact-word tap counts 2, a word start counts 1). */
+    @JvmStatic fun emojiMinCount(): Int = emojiTaps * 2
+
+    /** At most this many guesses from your habits are moved to the front. */
+    @JvmStatic fun pairsMax(): Int = pairsMax
+
+    /** Autocorrect applies the typo fixes you picked before. */
+    @JvmStatic fun applyFixes(): Boolean = master && useFixes && corrections
+
+    /** How many times you must use a learned word before it is trusted (kept from autocorrect). */
+    @JvmStatic fun trustUses(): Int = trust
+
+    /** Days of not using something before it starts to fade, or [FORGET_NEVER]. */
+    @JvmStatic fun forgetDays(): Int = forget
+
+    /**
+     * True when a fading step is due for the store behind [p] (and marks it as done).
+     * The first call only starts the clock.
+     */
+    @JvmStatic
+    fun decayDue(p: SharedPreferences): Boolean {
+        if (forget >= FORGET_NEVER) return false
+        val now = System.currentTimeMillis()
+        val last = p.getLong("decayAt", 0L)
+        if (last == 0L) { p.edit().putLong("decayAt", now).apply(); return false }
+        if (now - last < forget * 86_400_000L) return false
+        p.edit().putLong("decayAt", now).apply()
+        return true
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiLive.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiLive.kt
new file mode 100644
index 000000000..e12bd0157
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiLive.kt
@@ -0,0 +1,138 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FieldValue
+import com.google.firebase.firestore.FirebaseFirestore
+
+/**
+ * Live "listening to" for friends (Firebase, uses the internet). Writes users/{uid}/shared/now
+ * {title, artist, app, playing, updatedAt}. Only song status is sent, NEVER typed text.
+ * Prefs (in "rasi_account"): live_on, live_pause, live_stats, live_title, live_artist, live_app, live_paused, live_delay.
+ */
+object RasiLive {
+    private val h = Handler(Looper.getMainLooper())
+    private var lastKey: String? = null
+    private var pendingKey: String? = null
+    private var pendingRun: Runnable? = null
+    @Volatile private var cur: RasiNowPlaying.Track? = null
+    @Volatile private var ctx: Context? = null
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+    private fun me(): String? = try { FirebaseAuth.getInstance().currentUser?.uid } catch (t: Throwable) { null }
+
+    fun uidSet(p: SharedPreferences, key: String): Set<String> =
+        (p.getString(key, "") ?: "").split(",").filter { it.isNotBlank() }.toSet()
+
+    /** Who may see my song: live_vis 0 = all friends, 1 = all except live_hide, 2 = only live_show. Sent as hide/show lists in shared/now. */
+    private fun visFields(p: SharedPreferences): HashMap<String, Any> {
+        val mode = p.getInt("live_vis", 0)
+        val m = HashMap<String, Any>()
+        m["hide"] = if (mode == 1) uidSet(p, "live_hide").take(100) else FieldValue.delete()
+        m["show"] = if (mode == 2) uidSet(p, "live_show").take(100) else FieldValue.delete()
+        return m
+    }
+
+    /** Pushes a visibility change to the song that is already shared, right away (no delay). */
+    fun applyVis(c: Context) {
+        ctx = c.applicationContext
+        if (lastKey == null) return
+        val d = db() ?: return
+        val id = me() ?: return
+        d.collection("users").document(id).collection("shared").document("now").update(visFields(RasiAccount.prefs(c)))
+            .addOnFailureListener { RasiLog.fallback("RasiLive", "Could not update who sees the song: " + it.javaClass.simpleName) }
+    }
+
+    fun setVisible(c: Context, uid: String, mode: Int, visible: Boolean) {
+        val p = RasiAccount.prefs(c)
+        val key = if (mode == 1) "live_hide" else "live_show"
+        val set = uidSet(p, key).toMutableSet()
+        val inList = if (mode == 1) !visible else visible
+        if (inList) set.add(uid) else set.remove(uid)
+        p.edit().putString(key, set.joinToString(",")).apply()
+        applyVis(c)
+    }
+
+    /** Called by the music listener whenever the track changes. */
+    fun onTrack(c: Context, t: RasiNowPlaying.Track?) {
+        cur = t; ctx = c.applicationContext
+        h.post { evaluate() }
+    }
+
+    /** Called after any live-sharing setting changed. */
+    fun refresh(c: Context) {
+        ctx = c.applicationContext
+        h.post { evaluate() }
+    }
+
+    private fun cancelPending() {
+        pendingRun?.let { h.removeCallbacks(it) }
+        pendingRun = null; pendingKey = null
+    }
+
+    private fun evaluate() {
+        val c = ctx ?: return
+        try {
+            val d = db() ?: return
+            val id = me() ?: return
+            val p = RasiAccount.prefs(c)
+            val t = cur
+            val allowed = p.getBoolean("live_on", false) && !p.getBoolean("live_pause", false) && !p.getBoolean("live_stats", false)
+            val share = allowed && t != null && (t.playing || p.getBoolean("live_paused", false))
+            if (!share || t == null) {
+                cancelPending()
+                if (lastKey != null) clear(null)
+                return
+            }
+            val title = if (p.getBoolean("live_title", true)) t.title else ""
+            val artist = if (p.getBoolean("live_artist", true)) t.artist else ""
+            val app = if (p.getBoolean("live_app", true)) RasiNowPlaying.appLabel(c, t.pkg) else ""
+            val playing = t.playing
+            val cols = if (p.getBoolean("live_colors", true) && t.art != null) {
+                try { RasiNowPlayingTheme.swatches(t.art) } catch (e: Throwable) { IntArray(0) }
+            } else IntArray(0)
+            val c1 = cols.getOrNull(0) ?: 0
+            val c2 = cols.getOrNull(1) ?: c1
+            val usePos = p.getBoolean("live_pos", true)
+            val pkg = if (p.getBoolean("live_app", true)) t.pkg else ""
+            val key = "$title|$artist|$app|$playing|$c1|$c2|$usePos|$pkg|" + RasiNowPlaying.durMs + "|" + p.getInt("live_vis", 0) + p.getString("live_hide", "") + p.getString("live_show", "")
+            if (key == lastKey || key == pendingKey) return
+            cancelPending()
+            pendingKey = key
+            val r = Runnable {
+                pendingRun = null; pendingKey = null
+                val map = hashMapOf<String, Any>(
+                    "title" to title.take(120), "artist" to artist.take(120), "app" to app.take(40),
+                    "playing" to playing, "updatedAt" to System.currentTimeMillis()
+                )
+                val vf = visFields(p)
+                if (vf["hide"] !is FieldValue) map["hide"] = vf["hide"]!!
+                if (vf["show"] !is FieldValue) map["show"] = vf["show"]!!
+                map["posMs"] = if (usePos) RasiRooms.myPos(playing) else -1L
+                map["pkg"] = pkg.take(120)
+                map["durMs"] = RasiNowPlaying.durMs
+                if (c1 != 0) { map["c1"] = c1.toLong() and 0xFFFFFFFFL; map["c2"] = c2.toLong() and 0xFFFFFFFFL }
+                d.collection("users").document(id).collection("shared").document("now").set(map)
+                    .addOnSuccessListener { lastKey = key }
+                    .addOnFailureListener { RasiLog.fallback("RasiLive", "Could not share the song: " + it.javaClass.simpleName) }
+            }
+            pendingRun = r
+            h.postDelayed(r, p.getInt("live_delay", 10) * 1000L)
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiLive", "Live share skipped: " + t.javaClass.simpleName)
+        }
+    }
+
+    /** Removes the live song from the server (sharing off, paused, nothing playing, sign out). */
+    fun clear(done: (() -> Unit)?) {
+        cancelPending()
+        lastKey = null
+        val d = db(); val id = me()
+        if (d == null || id == null) { done?.invoke(); return }
+        d.collection("users").document(id).collection("shared").document("now").delete()
+            .addOnCompleteListener { done?.invoke() }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiLog.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiLog.kt
new file mode 100644
index 000000000..712111d07
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiLog.kt
@@ -0,0 +1,221 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.util.Log
+import androidx.compose.runtime.mutableIntStateOf
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.concurrent.Executors
+
+/**
+ * One shared log for every Rasi feature (errors, network failures, fallbacks, caught crashes).
+ * Shown in About > Log. It never stores what you type: callers must only pass technical messages.
+ * Levels: I info, W warning, E error, N network, F fallback, C crash.
+ */
+object RasiLog {
+    data class Entry(val time: Long, val level: Char, val tag: String, val msg: String)
+
+    const val PREFS = "rasi_log"
+    const val KEY_ENABLED = "log_enabled"
+    const val KEY_PERSIST = "log_persist"
+    const val KEY_INFO = "log_info"
+    const val KEY_MAX = "log_max"
+    private const val FILE_NAME = "rasi_log.txt"
+    private const val FILE_LIMIT = 256 * 1024L
+
+    private val lock = Any()
+    private val buf = ArrayList<Entry>()
+    private var file: File? = null
+    private var prefs: SharedPreferences? = null
+    private var io: java.util.concurrent.ExecutorService? = null
+
+    /** Changes every time the log changes, so screens can recompose. */
+    val version = mutableIntStateOf(0)
+
+    /** Safe to call many times. Call again later if the first call came before the phone was unlocked. */
+    @JvmStatic
+    fun init(context: Context) {
+        synchronized(lock) {
+            if (prefs == null) {
+                prefs = try { context.getSharedPreferences(PREFS, Context.MODE_PRIVATE) } catch (t: Throwable) { null }
+            }
+            if (file == null) {
+                try {
+                    val f = File(context.filesDir, FILE_NAME)
+                    file = f
+                    if (f.exists()) {
+                        val old = ArrayList<Entry>()
+                        f.readLines().forEach { parse(it)?.let { e -> old.add(e) } }
+                        buf.addAll(0, old)
+                        trimLocked()
+                        bump()
+                    }
+                } catch (t: Throwable) {
+                    file = null
+                }
+            }
+        }
+    }
+
+    // --- settings ---------------------------------------------------------------------------
+
+    @JvmStatic fun enabled(): Boolean = prefs?.getBoolean(KEY_ENABLED, true) ?: true
+    @JvmStatic fun persist(): Boolean = prefs?.getBoolean(KEY_PERSIST, true) ?: true
+    @JvmStatic fun infoToo(): Boolean = prefs?.getBoolean(KEY_INFO, false) ?: false
+    @JvmStatic fun maxEntries(): Int = (prefs?.getInt(KEY_MAX, 300) ?: 300).coerceIn(50, 2000)
+
+    @JvmStatic fun setBool(key: String, v: Boolean) {
+        prefs?.edit()?.putBoolean(key, v)?.apply()
+        if (key == KEY_PERSIST && !v) synchronized(lock) { try { file?.delete() } catch (t: Throwable) {} }
+        if (key == KEY_PERSIST && v) synchronized(lock) { rewriteLocked() }
+    }
+
+    @JvmStatic fun setMax(n: Int) {
+        prefs?.edit()?.putInt(KEY_MAX, n.coerceIn(50, 2000))?.apply()
+        synchronized(lock) { trimLocked(); bump() }
+    }
+
+    // --- writing ----------------------------------------------------------------------------
+
+    @JvmStatic fun i(tag: String, msg: String) = add('I', tag, msg, null)
+    @JvmStatic fun w(tag: String, msg: String) = add('W', tag, msg, null)
+    @JvmStatic fun w(tag: String, msg: String, t: Throwable?) = add('W', tag, msg, t)
+    @JvmStatic fun e(tag: String, msg: String) = add('E', tag, msg, null)
+    @JvmStatic fun e(tag: String, msg: String, t: Throwable?) = add('E', tag, msg, t)
+
+    /** A network request failed (timeout, no connection, bad answer). Never put the typed text in msg. */
+    @JvmStatic fun net(tag: String, msg: String) = add('N', tag, msg, null)
+
+    /** A feature fell back to its offline or default behavior. */
+    @JvmStatic fun fallback(tag: String, msg: String) = add('F', tag, msg, null)
+
+    /** A crash that was caught (or an uncaught one about to end the app). Always recorded. */
+    @JvmStatic fun crash(tag: String, msg: String, t: Throwable?) = add('C', tag, msg, t)
+
+    private fun add(level: Char, tag: String, msg: String, t: Throwable?) {
+        try {
+            when (level) {
+                'I' -> Log.i(tag, msg)
+                'E', 'C' -> Log.e(tag, msg, t)
+                else -> Log.w(tag, msg, t)
+            }
+        } catch (_: Throwable) {}
+        try {
+            if (level != 'C' && !enabled()) return
+            if (level == 'I' && !infoToo()) return
+            val text = describe(msg, t, level == 'C')
+            val e = Entry(System.currentTimeMillis(), level, tag, text)
+            synchronized(lock) {
+                val last = buf.lastOrNull()
+                // The same message again within 10 seconds is dropped, so a failing draw loop cannot flood the log.
+                if (last != null && last.level == level && last.tag == tag && last.msg == text &&
+                    e.time - last.time < 10_000L) return
+                buf.add(e)
+                trimLocked()
+                bump()
+                if (level == 'C') appendLocked(e) else runIo { synchronized(lock) { appendLocked(e) } }
+            }
+        } catch (_: Throwable) {}
+    }
+
+    private fun describe(msg: String, t: Throwable?, withStack: Boolean): String {
+        if (t == null) return msg
+        val sb = StringBuilder(msg).append(" : ").append(t.toString())
+        if (withStack) {
+            t.stackTrace.take(8).forEach { sb.append("\n    at ").append(it.toString()) }
+            t.cause?.let { sb.append("\n  caused by ").append(it.toString()) }
+        }
+        return sb.toString()
+    }
+
+    private fun runIo(r: () -> Unit) {
+        try {
+            val ex = io ?: Executors.newSingleThreadExecutor().also { io = it }
+            ex.execute { try { r() } catch (_: Throwable) {} }
+        } catch (_: Throwable) {}
+    }
+
+    // --- reading ----------------------------------------------------------------------------
+
+    /** Oldest first. */
+    @JvmStatic fun snapshot(): List<Entry> = synchronized(lock) { ArrayList(buf) }
+
+    @JvmStatic fun clear() {
+        synchronized(lock) {
+            buf.clear()
+            try { file?.delete() } catch (_: Throwable) {}
+            bump()
+        }
+    }
+
+    @JvmStatic fun label(level: Char): String = when (level) {
+        'I' -> "INFO"
+        'W' -> "WARN"
+        'E' -> "ERROR"
+        'N' -> "NET"
+        'F' -> "FALLBACK"
+        'C' -> "CRASH"
+        else -> level.toString()
+    }
+
+    @JvmStatic fun timeText(ms: Long): String =
+        SimpleDateFormat("MM-dd HH:mm:ss", Locale.US).format(Date(ms))
+
+    @JvmStatic fun asText(entries: List<Entry>): String {
+        if (entries.isEmpty()) return "(the log is empty)"
+        val sb = StringBuilder()
+        entries.forEach {
+            sb.append(timeText(it.time)).append("  ").append(label(it.level)).append("  ")
+                .append(it.tag).append(": ").append(it.msg).append('\n')
+        }
+        return sb.toString()
+    }
+
+    // --- file helpers (call with the lock held) ---------------------------------------------
+
+    private fun bump() { version.intValue = version.intValue + 1 }
+
+    private fun trimLocked() {
+        val max = maxEntries()
+        while (buf.size > max) buf.removeAt(0)
+    }
+
+    private fun enc(e: Entry): String =
+        e.time.toString() + "\t" + e.level + "\t" + e.tag.replace('\t', ' ').replace('\n', ' ') + "\t" +
+            e.msg.replace("\\", "\\\\").replace("\n", "\\n").replace('\t', ' ')
+
+    private fun parse(line: String): Entry? {
+        val p = line.split("\t", limit = 4)
+        if (p.size < 4) return null
+        val time = p[0].toLongOrNull() ?: return null
+        val msg = StringBuilder()
+        var k = 0
+        val s = p[3]
+        while (k < s.length) {
+            val c = s[k]
+            if (c == '\\' && k + 1 < s.length) {
+                msg.append(if (s[k + 1] == 'n') '\n' else s[k + 1])
+                k += 2
+            } else { msg.append(c); k++ }
+        }
+        return Entry(time, p[1].firstOrNull() ?: 'I', p[2], msg.toString())
+    }
+
+    private fun appendLocked(e: Entry) {
+        if (!persist()) return
+        val f = file ?: return
+        try {
+            f.appendText(enc(e) + "\n")
+            if (f.length() > FILE_LIMIT) rewriteLocked()
+        } catch (_: Throwable) {}
+    }
+
+    private fun rewriteLocked() {
+        val f = file ?: return
+        if (!persist()) return
+        try { f.writeText(buf.joinToString("") { enc(it) + "\n" }) } catch (_: Throwable) {}
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiMap.java b/java/src/org/futo/inputmethod/latin/rasi/RasiMap.java
new file mode 100644
