+/** The profile card. Used for the live preview while editing (later also for friends). */
+@Composable
+internal fun ProfileCardPreview(name: String, username: String, avatar: String, avatarColor: Int, b1: Int, b2: Int, compact: Boolean = false,
+                               avatarImg: RasiAnimPic? = null, bannerImg: RasiAnimPic? = null,
+                               pronouns: String = "", status: String = "", bio: String = "", accent: Int = 0, small: Boolean = false,
+                               badges: List<RasiBadges.Badge> = emptyList(), top: List<String> = emptyList(), now: String? = null,
+                               nowMode: String = "none", nowManual: Int = -1, nowC1: Int = 0, nowC2: Int = 0,
+                               onNowClick: (() -> Unit)? = null) {
+    val lift = LocalContext.current.let { remember { RasiAccount.prefs(it) }.getBoolean("now_lift", true) }
+    val tiny = compact || small
+    Column(Modifier.fillMaxWidth().clip(RoundedCornerShape(16.dp)).border(2.dp, Color(accent or (0xFF shl 24)), RoundedCornerShape(16.dp))) {
+        Box(Modifier.fillMaxWidth().height(if (tiny) 72.dp else 110.dp)
+            .background(Brush.horizontalGradient(listOf(Color(b1), Color(b2))))) {
+            if (bannerImg != null) {
+                RasiAnimPicture(bannerImg, Modifier.fillMaxSize(), ContentScale.Crop)
+                Box(Modifier.fillMaxSize().background(Brush.verticalGradient(listOf(Color.Transparent, Color(0x66000000)))))
+            }
+            Row(Modifier.align(Alignment.BottomStart).padding(12.dp), verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                Box(Modifier.size(if (tiny) 40.dp else 56.dp).clip(CircleShape).background(Color(avatarColor)), contentAlignment = Alignment.Center) {
+                    if (avatarImg != null) RasiAnimPicture(avatarImg, Modifier.fillMaxSize(), ContentScale.Crop)
+                    else Text(avatar, fontSize = if (tiny) 20.sp else 28.sp)
+                }
+                Column {
+                    Text(name.ifBlank { username }, fontSize = if (tiny) 16.sp else 20.sp, fontWeight = FontWeight.Bold, color = Color.White)
+                    Text("@" + username + (if (pronouns.isNotBlank()) " \u00B7 " + pronouns else ""), color = Color.White)
+                }
+            }
+        }
+        if (!small && (status.isNotBlank() || badges.isNotEmpty() || now != null || (!compact && (bio.isNotBlank() || top.isNotEmpty())))) {
