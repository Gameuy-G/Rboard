+@Composable
+private fun EdChip(label: String, selected: Boolean, onClick: () -> Unit) {
+    val pad = PaddingValues(horizontal = 10.dp, vertical = 4.dp)
+    if (selected) Button(contentPadding = pad, onClick = onClick) { Text(label) }
+    else OutlinedButton(contentPadding = pad, onClick = onClick) { Text(label) }
+}
