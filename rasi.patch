+private fun isSubsequence(small: String, big: String): Boolean {
+    var i = 0
+    for (ch in big) {
+        if (i < small.length && small[i] == ch) i++
+    }
+    return i == small.length
+}
+
+// Every word must appear (any order). If nothing matches that way, allow letters in order within the name.
+private fun searchMatches(tags: String, query: String): Boolean {
+    val tokens = query.trim().split(Regex("\\s+")).filter { it.isNotEmpty() }
+    if (tokens.isEmpty()) return true
+    if (tokens.all { tags.contains(it) }) return true
+    val flat = tokens.joinToString("")
+    return flat.length >= 3 && isSubsequence(flat, tags.substringBefore('\n'))
+}
