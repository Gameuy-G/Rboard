+private object GifRecents {
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("rasi_klipy", Context.MODE_PRIVATE)
+
+    fun load(context: Context): List<GiphyItem> = try {
+        val arr = org.json.JSONArray(prefs(context).getString("recent_gifs", "[]") ?: "[]")
+        (0 until arr.length()).mapNotNull {
+            val o = arr.optJSONObject(it) ?: return@mapNotNull null
+            GiphyItem(
+                o.optString("id"), o.optString("p"), o.optString("g"),
+                o.optDouble("r", 1.0).toFloat()
+            )
+        }.filter { it.id.isNotEmpty() && it.previewUrl.isNotEmpty() && it.gifUrl.isNotEmpty() }
+    } catch (e: Exception) {
+        emptyList()
+    }
+
+    fun add(context: Context, item: GiphyItem) {
+        val list = (listOf(item) + load(context).filter { it.id != item.id }).take(30)
+        val arr = org.json.JSONArray()
+        list.forEach {
+            arr.put(JSONObject().put("id", it.id).put("p", it.previewUrl).put("g", it.gifUrl).put("r", it.ratio.toDouble()))
+        }
+        prefs(context).edit().putString("recent_gifs", arr.toString()).apply()
+    }
+}
