+/**
+ * Music visualizer behind the keys. Tries the real audio output (needs the microphone permission,
+ * and some players block it); if no moving sound is captured it falls back to a simulated beat.
+ * It has its own 30 fps timer, so it keeps moving while music plays and the keyboard is visible,
+ * and stops completely otherwise.
+ */
+object RasiNowPlayingViz {
+    const val N = 64
+    val levels = FloatArray(N)
+    private val disp = FloatArray(N)
+    private val peaks = FloatArray(N)
+    private val prev = FloatArray(N)
+
+    /** Last source that was used: "" (never), "real" or "sim". Shown in settings. */
+    @Volatile var source = ""
+    @Volatile private var bass = 0f
+    /** Grows every time new band levels arrive (real or simulated). */
+    @Volatile private var frameSeq = 0
+    @Volatile private var bassFix = true
+    @Volatile private var lastReal = 0L
+    private var viz: Visualizer? = null
+    private var vizKind = ""
+    private var attachedAt = 0L
+    private var lastKey = ""
+    private val bad = HashMap<String, Long>()
+    private val rootTried = HashMap<String, Long>()
+    private val rootSessions = java.util.concurrent.ConcurrentHashMap<String, Int>()
+    @Volatile private var rootBusy = false
+    /** Short root status line shown in settings. */
+    @Volatile var rootNote = ""
+    private var running = false
+    private var hooked = false
+    private val handler = Handler(Looper.getMainLooper())
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val views = ArrayList<WeakReference<View>>()
+    private val tick = Runnable { step() }
+
+    fun hasPermission(c: Context) =
+        ContextCompat.checkSelfPermission(c, android.Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED
+
+    /** Forget earlier capture failures and try the real sound again. */
+    /** How the visualizer is connected right now (shown in Music settings). */
+    fun connectionLabel(): String = when (source) {
+        "root" -> RasiRoot.via
+        "capture" -> "Other (playback capture)"
+        "player" -> "Other (player session, no root or Shizuku)"
+        "mix", "real" -> "Other (audio mix, no root or Shizuku)"
+        "smart" -> "None (smart simulated beat, " + RasiSmartBeat.bpm.toInt() + " BPM)"
+        "sim" -> "None (plain simulated beat)"
+        else -> "Not checked yet"
+    }
+
+    fun retryReal() {
+        bad.clear()
+        rootSessions.clear()
+        rootTried.clear()
+        release()
+    }
+
+    private fun rank(kind: String) = when (kind) { "player" -> 0; "root" -> 1; else -> 2 }
+
+    /** Real-sound options for this player, best first, skipping ones that failed lately. */
+    private fun candidates(pkg: String, now: Long, useRoot: Boolean, sel: String): List<Pair<String, Int>> {
+        val out = ArrayList<Pair<String, Int>>()
+        RasiNowPlaying.sessions[pkg]?.let { if (it > 0) out.add("player" to it) }
+        if (useRoot) rootSessions[pkg]?.let { if (it > 0) out.add("root" to it) }
+        out.add("mix" to 0)
+        out.removeAll { (it.first == "player" && !RasiMethods.player) || (it.first == "mix" && !RasiMethods.mix) || (sel != "auto" && it.first != sel) }
+        return out.filter { (bad[it.first + it.second] ?: 0L) < now }
+    }
+
+    private fun markBad(now: Long) {
+        bad[vizKind + (if (vizKind == "mix") 0 else sessionOf())] = now + 30000L
+        if (vizKind == "root") RasiNowPlaying.track?.pkg?.let { rootSessions.remove(it) }
+        release()
+    }
+
+    private var vizSession = 0
+    private fun sessionOf() = vizSession
+
+    private fun attach(kind: String, session: Int, now: Long) {
+        release()
+        try {
+            val v = Visualizer(session)
+            v.enabled = false
+            val cr = Visualizer.getCaptureSizeRange()
+            v.captureSize = 512.coerceIn(cr[0], cr[1])
+            v.setDataCaptureListener(object : Visualizer.OnDataCaptureListener {
+                override fun onWaveFormDataCapture(vz: Visualizer?, w: ByteArray?, r: Int) {}
+                override fun onFftDataCapture(vz: Visualizer?, fft: ByteArray?, r: Int) {
+                    if (fft != null) onFft(fft)
+                }
+            }, Visualizer.getMaxCaptureRate(), false, true)
+            v.enabled = true
+            viz = v
+            vizKind = kind
+            vizSession = session
+            attachedAt = now
+        } catch (t: Throwable) {
+            RasiLog.w("RasiViz", "capture not available (" + kind + "): " + t)
+            bad[kind + session] = now + 30000L
+            if (kind == "root") RasiNowPlaying.track?.pkg?.let { rootSessions.remove(it) }
+            viz = null
+        }
+    }
+
+    /** Looks up the player's audio session with root, in the background, at most every 10 s. */
+    private fun findRoot(ctx: Context, pkg: String, now: Long) {
+        if (rootBusy || pkg.isBlank() || rootSessions.containsKey(pkg)) return
+        if (now - (rootTried[pkg] ?: 0L) < 10000L) return
+        rootTried[pkg] = now
+        rootBusy = true
+        val app = ctx.applicationContext
+        Thread {
+            try {
+                val uid = app.packageManager.getApplicationInfo(pkg, 0).uid
+                val id = RasiRoot.sessionFor(uid)
+                if (id > 0) rootSessions[pkg] = id
+            } catch (t: Throwable) {
+                rootNote = "Root: could not look up the app"
+            } finally {
+                rootBusy = false
+            }
+        }.start()
+    }
+
+    private fun release() {
+        try { viz?.enabled = false; viz?.release() } catch (t: Throwable) {}
+        viz = null
+        vizKind = ""
+    }
+
+    fun stop() = release()
+
+    @Volatile private var useCapture = false
+    @Volatile private var capSeen = 0L
+
+    /** Called by the playback capture service for every audio frame (same format as Visualizer FFT). */
+    fun onCaptureFrame(fft: ByteArray, peak: Int) {
+        if (peak > 1) capSeen = System.currentTimeMillis()
+        if (useCapture) onFft(fft)
+    }
+
+    /** Right-side falloff in percent (0 = off), set every frame from the setting. */
+    @Volatile private var tiltPct = 70
+
+    private fun onFft(fft: ByteArray) {
+        val bins = fft.size / 2
+        var total = 0f
+        var change = 0f
+        val out = FloatArray(N)
+        for (i in 0 until N) {
+            // log-spaced bin ranges, skipping DC
+            var a = 1 + ((Math.pow((i / N.toDouble()), 2.0)) * (bins - 2)).toInt()
+            // the lowest bands used to share the same single bin, so the first bars were identical
+            if (bassFix) a = maxOf(a, 1 + i).coerceAtMost(bins - 1)
+            val b = (1 + ((Math.pow(((i + 1) / N.toDouble()), 2.0)) * (bins - 2)).toInt()).coerceAtLeast(a + 1)
+            var m = 0f
+            for (k in a until b.coerceAtMost(bins)) {
+                val re = fft[2 * k].toFloat()
+                val im = fft[2 * k + 1].toFloat()
+                m = maxOf(m, hypot(re, im))
+            }
+            var lv = (log10(m + 1f) / 2.1f).coerceIn(0f, 1f)
+            if (RasiMethods.smoothBars && tiltPct == 0) {
+                // highs carry less energy in music: lift the bars smoothly from left (none) to right (up to 1.9x)
+                val x = i / (N - 1f)
+                lv = (lv * (1f + 0.9f * Math.pow(x.toDouble(), 1.4).toFloat())).coerceIn(0f, 1f)
+            }
+            out[i] = lv
+            total += out[i]
+            change += abs(out[i] - prev[i])
+            prev[i] = out[i]
+        }
+        // Count it as real only when it is not silent AND it keeps changing (blocked captures
+        // return zeros or a frozen frame).
+        if (total > 0.05f && change > 0.02f) {
+            lastReal = System.currentTimeMillis()
+            for (i in 0 until N) levels[i] = out[i]
+            bass = (levels[0] + levels[1] + levels[2]) / 3f
+            frameSeq++
+        }
+    }
+
+    private var simT = 0.0
+    private var lastSimNow = 0L
+
+    /** Simulated beat. Uses its own running clock (a Float cannot hold epoch milliseconds). */
+    private fun simulate(now: Long, speed: Float, beatOverride: Float = -1f) {
+        val dt = if (lastSimNow == 0L) 0.0 else ((now - lastSimNow) / 1000.0).coerceIn(0.0, 0.2)
+        lastSimNow = now
+        simT += dt * speed
+        val t = simT
+        val beat = if (beatOverride >= 0f) beatOverride else Math.abs(Math.sin(t * 6.8)).let { it * it * it }.toFloat()
+        for (i in 0 until N) {
+            val wob = (0.5 + 0.5 * Math.sin(t * (1.3 + i * 0.15) + i * 0.9)).toFloat()
+            levels[i] = (0.15f + 0.55f * wob * (1f - i * 0.36f / N) + 0.3f * beat * (1f - i / N.toFloat())).coerceIn(0f, 1f)
+        }
+        bass = (0.25f + 0.75f * beat)
+        frameSeq++
+    }
+
+    /** For other drawers (border glow) that want to be redrawn with the visualizer clock. */
+    fun registerView(v: View) = register(v)
+
+    private fun register(v: View) {
+        RasiNowPlaying.ensureConnected(v.context)
+        if (views.none { it.get() === v }) views.add(WeakReference(v))
+        if (!hooked) {
+            hooked = true
+            // wake up when the song or the play state changes
+            RasiNowPlaying.listeners.add { kick() }
+        }
+    }
+
+    private fun liveViews(): List<View> {
+        val out = ArrayList<View>()
+        val it2 = views.iterator()
+        while (it2.hasNext()) {
+            val v = it2.next().get()
+            if (v == null) it2.remove() else if (v.isAttachedToWindow && v.isShown) out.add(v)
+        }
+        return out
+    }
+
+    /** Starts the timer if it is not running. Safe from any thread. */
+    private fun kick() {
+        handler.post { if (!running) step() }
+    }
+
+    /** One animation frame. Reschedules itself only while music plays and a keyboard is visible. */
+    private fun step() {
+        running = false
+        val live = liveViews()
+        val ctx = live.firstOrNull()?.context
+        if (ctx == null) {
+            release()
+            return
+        }
+        val ambient = live.any { it.tag == "rasi_ambient" }
+        val pillViz = live.any { it.tag == "rasi_pill_viz" }
+        val setFx = RasiSettingsFx.active > 0
+        val on = RasiNowPlaying.live(ctx).getBoolean("mode_viz", false) || pillViz || RasiBorderGlow.reactive(ctx) ||
+            (ambient && RasiNowPlaying.live(ctx).getBoolean("set_viz", true)) || (setFx && RasiSettingsFx.reactive(ctx))
+        val playing = RasiNowPlaying.track?.playing == true
+        val fxOn = fxWanted(ctx) || RasiBorderGlow.animated(ctx) || (setFx && RasiSettingsFx.running(ctx))
+        if ((!on || !playing) && !fxOn) {
+            release()
+            for (v in live) v.invalidate() // clear what was drawn
+            return
+        }
+        // no music visualizer to feed: only the keyboard visual effects run, from a simulated beat
+        val idle = !(on && playing)
+        RasiMethods.init(ctx)
+        val pp = RasiNowPlaying.live(ctx)
+        bassFix = pp.getBoolean("viz_bass_fix", true)
+        tiltPct = if (isCircular(styleOf(pp))) 0 else pp.getInt("viz_tilt", 70)
+        val sel = pp.getString("viz_source", "auto") ?: "auto"
+        val forceSim = idle || sel == "sim" || sel == "smart" || sel == "capture" // these never use the Visualizer
+        val now = System.currentTimeMillis()
+        val trk = RasiNowPlaying.track
+        val pkg = trk?.pkg ?: ""
+        val key = pkg + "|" + (trk?.title ?: "")
+        if (key != lastKey) {
+            // new track or player: forget old failures and detect the session again
+            lastKey = key
+            bad.clear()
+            rootSessions.remove(pkg)
+            rootTried.remove(pkg)
+            release()
+        }
+        if (!idle && RasiMethods.smart && (sel == "auto" || sel == "smart") && trk != null) RasiSmartBeat.request(ctx, trk.title, trk.artist)
+        if (forceSim || !hasPermission(ctx)) {
+            release()
+        } else {
+            val useRoot = if (sel == "root") (RasiMethods.root || (RasiShizuku.granted() && RasiMethods.shizuku))
+                else if (sel != "auto") false
+                else (pp.getBoolean("viz_root", false) && RasiMethods.root) || (RasiShizuku.granted() && RasiMethods.shizuku)
+            // a method that was just turned off or not selected: drop its capture
+            if (viz != null && ((vizKind == "root" && !useRoot) || (vizKind == "player" && !RasiMethods.player) ||
+                    (vizKind == "mix" && !RasiMethods.mix) || (sel != "auto" && vizKind != sel))) release()
+            if (useRoot) findRoot(ctx, pkg, now)
+            // the current source gives nothing (blocked or silent): drop it and try the next one
+            if (viz != null) {
+                if (lastReal < attachedAt && now - attachedAt > 2500L) markBad(now)
+                else if (lastReal >= attachedAt && now - lastReal > 5000L) markBad(now)
+            }
+            val best = candidates(pkg, now, useRoot, sel).firstOrNull()
+            if (best != null && (viz == null || rank(best.first) < rank(vizKind))) attach(best.first, best.second, now)
+        }
+        val capFresh = RasiCapture.running && RasiMethods.capture && now - capSeen < 1500L
+        useCapture = !idle && RasiMethods.capture && RasiCapture.running &&
+            (sel == "capture" || (sel == "auto" && capFresh && (viz == null || vizKind == "mix")))
+        if (useCapture && viz != null) release()
+        if (useCapture && now - lastReal < 1500L && capFresh) {
+            source = "capture"
+        } else if (!forceSim && viz != null && lastReal >= attachedAt && now - lastReal < 1500L) {
+            source = vizKind
+        } else {
+            val sb = if (!idle && RasiMethods.smart && (sel == "auto" || sel == "smart")) RasiSmartBeat.beatNow() else -1f
+            source = if (sb >= 0f) "smart" else "sim"
+            val simSpeed = if (idle) RasiNowPlaying.prefs(ctx).getInt("fx_speed", 100) / 100f else pp.getInt("viz_sim_speed", 100) / 100f
+            simulate(now, simSpeed, sb)
+        }
+        val sm = RasiNowPlaying.live(ctx).getInt("viz_smooth", 50) / 100f
+        val fall = 0.6f - 0.55f * sm
+        // 60 fps by default (setting "Smooth animations"); easing is scaled so speed looks the same at 30 fps
+        val frameMs = if (RasiNowPlaying.live(ctx).getBoolean("viz_60", true)) 16L else 33L
+        val k = frameMs / 33f
+        val up = 1f - Math.pow(0.3, k.toDouble()).toFloat()
+        val down = 1f - Math.pow((1f - fall).toDouble(), k.toDouble()).toFloat()
+        val tilt = tiltPct / 100f
+        for (i in 0 until N) {
+            // each bar is a little lower than the one to its left (bass stays, highs fall)
+            val target = levels[i] * (1f - tilt * (i / (N - 1f)))
+            val d = target - disp[i]
+            disp[i] += d * (if (d > 0f) up else down)
+            peaks[i] = maxOf(disp[i], peaks[i] - 0.012f * k)
+        }
+        if (now - histAt > 55L) {
+            histAt = now
+            histHead = (histHead + 1) % 32
+            System.arraycopy(disp, 0, hist[histHead], 0, N)
+        }
+        // beat punch: a beat is bass that jumps well above its slow average
+        val thr = pp.getInt("viz_punch_thr", 50) / 100f
+        val pdec = pp.getInt("viz_punch_decay", 50) / 100f
+        val rise = 0.22f - 0.17f * thr
+        avgBass += (bass - avgBass) * 0.06f
+        var beatNow = false
+        val oldBeat = RasiMethods.beatOld
+        val hit = if (oldBeat) bass > 0.15f && bass - avgBass > rise && now - lastPunchAt > 150L
+            else RasiBeat.detect(levels, frameSeq, now, thr, pp.getInt("viz_beat_cool", 180), pp.getInt("viz_beat_floor", 15) / 100f, pp.getInt("viz_beat_smooth", 30) / 100f)
+        if (hit) { punch = 1f; lastPunchAt = now; beatNow = true }
+        else punch *= Math.pow((0.70f + 0.22f * pdec).toDouble(), k.toDouble()).toFloat()
+        if (punch < 0.01f) punch = 0f
+        val beatStrength = if (oldBeat) (bass * 0.6f + (bass - avgBass) * 1.6f).coerceIn(0f, 1f) else RasiBeat.strength
+        RasiGlowBeat.update(RasiNowPlaying.prefs(ctx), disp, beatNow && !idle, beatStrength, k)
+        if (setFx) RasiSetGlowBeat.update(RasiGlowPrefs.settings(RasiNowPlaying.prefs(ctx)), disp, beatNow && !idle, beatStrength, k)
+        RasiShake.update(pp, beatNow && !idle, if (oldBeat) (bass * 0.6f + (bass - avgBass) * 1.6f).coerceIn(0f, 1f) else RasiBeat.strength, k)
+        if (pp.getBoolean("viz_bc_on", false)) {
+            val bThr = pp.getInt("viz_bc_thr", 50) / 100f
+            if (beatNow) {
+                val bs = pp.getInt("viz_bc_sens", 100) / 100f
+                beatLvl = (if (oldBeat) (bass * 0.6f + (bass - avgBass) * 1.6f) * bs else (RasiBeat.strength * 0.8f + bass * 0.2f) * bs).coerceIn(0f, 1f)
+                beatHoldUntil = now + pp.getInt("viz_bc_hold", 100)
+                beatFlashV = if (beatLvl > bThr) 1f else 0f
+            } else {
+                if (now > beatHoldUntil) beatLvl *= Math.pow((0.80f + 0.17f * pp.getInt("viz_bc_smooth", 50) / 100f).toDouble(), k.toDouble()).toFloat()
+                beatFlashV *= Math.pow(0.78, k.toDouble()).toFloat()
+            }
+            if (beatLvl < 0.01f) beatLvl = 0f
+            if (beatFlashV < 0.01f) beatFlashV = 0f
+            val target = mixOf(beatLvl, bThr, pp.getInt("viz_bc_curve", 1))
+            val spd = 0.05f + 0.95f * pp.getInt("viz_bc_speed", 60) / 100f
+            beatMixDisp += (target - beatMixDisp) * (1f - Math.pow((1f - spd).toDouble(), k.toDouble()).toFloat())
+        }
+        for (v in live) v.invalidate()
+        running = true
+        handler.postDelayed(tick, frameMs)
+    }
+
+    private fun at(arr: FloatArray, pos: Float): Float {
+        val f = pos.coerceIn(0f, (N - 1).toFloat())
+        val a = f.toInt()
+        val b = minOf(a + 1, N - 1)
+        return arr[a] + (arr[b] - arr[a]) * (f - a)
+    }
+
+    fun lerpC(a: Int, b: Int, t: Float) = androidx.core.graphics.ColorUtils.blendARGB(a, b, t.coerceIn(0f, 1f))
+
+    /** Colors for a style, from the prefs under [prefix] ("viz_" or later "pill_"). */
+    /** Colors for weak and strong beats: [mix] (0 weak .. 1 strong), glow boost and flash of the strong color. */
+    class BeatPal(
+        val weak: IntArray, val strong: IntArray, var mix: Float, val glow: Float, var flash: Float,
+        val thr: Float, val curve: Int
+    )
+
+    fun mixOf(env: Float, thr: Float, curve: Int): Float {
+        val m = ((env - (thr - 0.25f)) / 0.5f).coerceIn(0f, 1f)
+        return when (curve) {
+            1 -> m * m * (3f - 2f * m)
+            2 -> ((m - 0.5f) * 3f + 0.5f).coerceIn(0f, 1f)
+            else -> m
+        }
+    }
+
+    class Colors(val src: String, val c1: Int, val c2: Int, val now: Long, val list: IntArray? = null) {
+        var beat: BeatPal? = null
+        /** Beat shake: draw everything in black and white. */
+        var gray = false
+
+        fun at(t: Float): Int {
+            val b = beat
+            val c = if (b == null) baseAt(t) else beatAt(b, t)
+            if (!gray) return c
+            val g = (0.3f * AColor.red(c) + 0.59f * AColor.green(c) + 0.11f * AColor.blue(c)).toInt().coerceIn(0, 255)
+            return AColor.argb(AColor.alpha(c), g, g, g)
+        }
+
+        private fun grad(l: IntArray, t: Float): Int {
+            if (l.size == 1) return l[0]
+            val f = t.coerceIn(0f, 1f) * (l.size - 1)
+            val i = f.toInt().coerceAtMost(l.size - 2)
+            return lerpC(l[i], l[i + 1], f - i)
+        }
+
+        private fun beatAt(b: BeatPal, t: Float): Int {
+            var c = lerpC(grad(b.weak, t), grad(b.strong, t), b.mix)
+            if (b.glow > 0f && b.mix > 0f) {
+                val hv = FloatArray(3)
+                AColor.colorToHSV(c, hv)
+                hv[1] = (hv[1] + 0.5f * b.glow * b.mix).coerceAtMost(1f)
+                hv[2] = (hv[2] + 0.35f * b.glow * b.mix).coerceAtMost(1f)
+                c = AColor.HSVToColor(hv)
+            }
+            if (b.flash > 0.01f) c = lerpC(c, lerpC(grad(b.strong, t), AColor.WHITE, 0.35f), b.flash.coerceIn(0f, 1f) * 0.8f)
+            return c
+        }
+
+        private fun baseAt(t: Float): Int = when (src) {
+            "rgb" -> AColor.HSVToColor(floatArrayOf((((now % 100000L) / 15f) + t * 360f) % 360f, 0.8f, 1f))
+            "solid" -> c1
+            else -> {
+                val l = list
+                if (l != null && l.size >= 3) grad(l, t) else lerpC(c1, c2, t)
+            }
+        }
+    }
+
+    // beat color state, updated by the tick
+    @Volatile private var beatLvl = 0f
+    @Volatile private var beatHoldUntil = 0L
+    @Volatile private var beatMixDisp = 0f
+    @Volatile private var beatFlashV = 0f
+
+    /** Beat shake color cycling: rotates the thumbnail colors by the number of shakes so far. */
+    private fun rotSw(sw: IntArray, sh: Boolean): IntArray {
+        if (!sh || !RasiShake.cycle || sw.size < 2) return sw
+        val r = RasiShake.colorIdx % sw.size
+        return IntArray(sw.size) { sw[(it + r) % sw.size] }
+    }
+
+    private fun withBeat(base: Colors, p: android.content.SharedPreferences, prefix: String, sh: Boolean = false): Colors {
+        if (!p.getBoolean(if (prefix == "viz_") "viz_bc_viz" else "viz_bc_pill", true)) return base
+        val weak: IntArray
+        val strong: IntArray
+        if ((p.getString("viz_bc_mode", "auto") ?: "auto") == "manual") {
+            weak = intArrayOf(p.getInt("viz_bc_w1", 0xFFFFE3E3.toInt()), p.getInt("viz_bc_w2", 0xFFFFB0B0.toInt()))
+            strong = intArrayOf(p.getInt("viz_bc_s1", 0xFFB3001B.toInt()), p.getInt("viz_bc_s2", 0xFF6A0010.toInt()))
+        } else {
+            val art = RasiNowPlaying.track?.art
+            val sw = if (art != null) rotSw(RasiNowPlayingTheme.swatches(art), sh) else IntArray(0)
+            if (sw.isNotEmpty()) {
+                val hv = FloatArray(3)
+                var si = 0; var bs = -1f; var li = 0; var lv = -1f
+                for (i in sw.indices) {
+                    AColor.colorToHSV(sw[i], hv)
+                    if (hv[1] > bs) { bs = hv[1]; si = i }
+                    if (hv[2] > lv) { lv = hv[2]; li = i }
+                }
+                val st = sw[si]
+                strong = intArrayOf(st, lerpC(st, AColor.BLACK, 0.35f))
+                weak = intArrayOf(lerpC(st, AColor.WHITE, 0.88f), lerpC(sw[li], AColor.WHITE, 0.45f))
+            } else {
+                val a = base.at(0f)
+                val b = base.at(1f)
+                strong = intArrayOf(a, b)
+                weak = intArrayOf(lerpC(a, AColor.WHITE, 0.8f), lerpC(b, AColor.WHITE, 0.8f))
+            }
+        }
+        val perf = org.futo.inputmethod.latin.uix.RasiPerf.isOn()
+        val glow = if (perf) 0f else p.getInt("viz_bc_glow", 40) / 100f
+        val flash = if (perf) 0f else beatFlashV * (p.getInt("viz_bc_flash", 60) / 100f)
+        base.beat = BeatPal(
+            weak, strong, if (perf) 0.5f else beatMixDisp, glow, flash,
+            p.getInt("viz_bc_thr", 50) / 100f, p.getInt("viz_bc_curve", 1)
+        )
+        return base
+    }
