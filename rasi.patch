+@Composable
+private fun RasiDrawer(nav: NavHostController, onClose: () -> Unit) {
+    val ctx = LocalContext.current
+    remember { RasiAccount.init(ctx); RasiPerf.init(ctx); RasiUiStyle.init(ctx); 0 }
+    val p = RasiAccount.prefs(ctx)
+    val right = p.getBoolean("dr_right", false)
+    val width = p.getInt("dr_width", 300).dp
+    val perf = RasiPerf.isOn()
+    val vis = remember { MutableTransitionState(perf) }.apply { targetState = true }
+    fun go(route: String) {
+        onClose()
+        try { nav.navigate(route) } catch (t: Throwable) { RasiLog.fallback("RasiDrawer", "Could not open " + route + ": " + t.javaClass.simpleName) }
+    }
+    val slideMs = p.getInt("dr_speed", 250).coerceIn(80, 600)
+    val fadeToo = p.getBoolean("dr_fade", false)
+    Dialog(onDismissRequest = onClose, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        // Turn off the phone's own pop-up animation (it slid up from the bottom and faded); only our side slide plays.
+        val dlgView = LocalView.current
+        SideEffect { (dlgView.parent as? DialogWindowProvider)?.window?.setWindowAnimations(-1) }
+        Box(Modifier.fillMaxSize().pointerInput(Unit) { detectTapGestures { onClose() } }) {
+            AnimatedVisibility(
+                visibleState = vis,
+                modifier = Modifier.align(if (right) Alignment.CenterEnd else Alignment.CenterStart),
+                enter = if (perf) EnterTransition.None else slideInHorizontally(tween(slideMs)) { if (right) it else -it } + (if (fadeToo) fadeIn(tween(slideMs)) else EnterTransition.None),
+                exit = ExitTransition.None
+            ) {
+                val bgOn = p.getBoolean("dr_bg", true)
+                Surface(Modifier.fillMaxHeight().width(width).pointerInput(Unit) { detectTapGestures { } }, color = if (bgOn) Color.Transparent else MaterialTheme.colorScheme.surface) {
+                  RasiDrawerBg(bgOn, p.getBoolean("dr_fx", true), p.getInt("dr_dim", 35)) {
+                    Column(Modifier.verticalScroll(rememberScrollState()).padding(vertical = 16.dp)) {
+                        for (id in rasiDrawerOrder(p)) {
+                            if (!p.getBoolean("dr_show_$id", true)) continue
+                            when (id) {
+                                "profile" -> {
+                                    val pr by RasiAccount.profile
+                                    val img by RasiPictures.avatarImg
+                                    Row(Modifier.fillMaxWidth().clickable { go("rasiAccount") }.padding(horizontal = 20.dp, vertical = 8.dp),
+                                        verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                                        Box(Modifier.size(52.dp).clip(CircleShape).background(Color(pr?.avatarColor ?: 0x33888888)), contentAlignment = Alignment.Center) {
+                                            val a = img
+                                            if (a != null) RasiAnimPicture(a, Modifier.fillMaxSize(), ContentScale.Crop)
+                                            else Text(pr?.avatar ?: "\uD83D\uDE00", fontSize = 26.sp)
+                                        }
+                                        Column(Modifier.weight(1f)) {
+                                            Text(pr?.let { it.name.ifBlank { it.username } } ?: "Not signed in", fontSize = 18.sp, fontWeight = FontWeight.Bold)
+                                            DrawerSongLine(p, pr != null, perf)
+                                        }
+                                    }
+                                }
+                                "recent" -> {
+                                    DrawerHeader("Recent menus")
+                                    val l = RasiRecent.list(ctx).take(p.getInt("dr_recent_max", 6))
+                                    if (l.isEmpty()) DrawerRow("Nothing opened yet", false)
+                                    l.forEach { r -> DrawerRow(rasiRouteTitle(r)) { go(r) } }
+                                }
+                                "messages" -> {
+                                    DrawerHeader("Messages")
+                                    val me by RasiAccount.uid
+                                    val metas by RasiChats.metas
+                                    val fl by RasiFriends.friends
+                                    val maxMsg = p.getInt("dr_msg_max", 4)
+                                    val showText = p.getBoolean("dr_msg_text", true)
+                                    val dots = p.getBoolean("ch_unread", true)
+                                    LaunchedEffect(me) { if (me != null) { RasiFriends.refresh(ctx); RasiChats.loadMetas() } }
+                                    if (me == null) DrawerRow("Sign in to see messages", false)
+                                    else {
+                                        val rows = metas.filter { m -> m.lastMessage.isNotBlank() && fl.any { it.uid == m.other } }.take(maxMsg)
+                                        if (rows.isEmpty()) DrawerRow("No messages yet", false)
+                                        rows.forEach { m ->
+                                            val f = fl.first { it.uid == m.other }
+                                            Row(Modifier.fillMaxWidth().clickable { go("rasiChat/" + m.other) }.padding(horizontal = 20.dp, vertical = 8.dp),
+                                                verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                                                ChatAv(f.p.avatar, f.p.avatarColor, 32, false, f.uid)
+                                                Column(Modifier.weight(1f)) {
+                                                    Text(f.p.name.ifBlank { f.p.username }, fontSize = 15.sp, fontWeight = FontWeight.Bold, maxLines = 1)
+                                                    if (showText) Text((if (m.lastFrom == me) "You: " else "") + m.lastMessage, fontSize = 12.sp, maxLines = 1,
+                                                        overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis)
+                                                }
+                                                if (dots && m.lastFrom != me && m.lastAt > m.myRead) Box(Modifier.size(10.dp).clip(CircleShape).background(MaterialTheme.colorScheme.primary))
+                                            }
+                                        }
+                                        DrawerRow("Open all messages") { go("rasiChats") }
+                                    }
+                                }
+                                "shortcuts" -> {
+                                    DrawerHeader("Shortcuts")
+                                    DrawerRow("Search settings") { go("search") }
+                                    DrawerRow("Account") { go("rasiAccount") }
+                                    DrawerRow("Friends") { go("rasiFriends") }
+                                    DrawerRow("Messages") { go("rasiChats") }
+                                    DrawerRow("Listen together") { go("rasiRooms") }
+                                    DrawerRow("Groups") { go("rasiGroups") }
+                                }
+                            }
+                        }
+                        Spacer(Modifier.height(12.dp))
+                        DrawerRow("Drawer settings") { go("rasiDrawer") }
+                    }
+                  }
+                }
+            }
+        }
+    }
+}
