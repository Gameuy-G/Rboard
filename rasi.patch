+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import androidx.compose.runtime.mutableStateOf
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.auth.FirebaseAuthInvalidCredentialsException
+import com.google.firebase.auth.FirebaseAuthInvalidUserException
+import com.google.firebase.auth.FirebaseAuthUserCollisionException
+import com.google.firebase.auth.FirebaseAuthWeakPasswordException
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.SetOptions
+import com.google.firebase.firestore.Transaction
+
+/**
+ * Rboard account (Firebase). Uses the internet. Only the profile and totals are sent, NEVER typed text.
+ * Firestore layout:
+ *   users/{uid}            public profile (username, name, bio, avatar, hues, statsShared)
+ *   users/{uid}/private/me friend code (owner only)
+ *   users/{uid}/shared/stats totals and top songs (owner now, friends later)
+ *   usernames/{name}       {uid}  (unique username lock)
+ *   codes/{code}           {uid}  (friend code lookup)
+ */
+object RasiAccount {
+    class Profile(
+        val username: String, val name: String, val bio: String, val avatar: String,
+        val avatarColor: Int, val bannerColor1: Int, val bannerColor2: Int, val createdAt: Long,
+        val avatarPicV: Long = 0L, val avatarUsePic: Boolean = true,
+        val bannerPicV: Long = 0L, val bannerUsePic: Boolean = true,
+        val pronouns: String = "", val status: String = "", val accent: Int = -6724391, val cardStyle: String = "full",
+        val badges: List<String> = emptyList(), val showBadges: Boolean = true, val showTop: Boolean = true, val showNow: Boolean = false,
+        val allowRequests: Boolean = true,
+        val nowColorMode: String = "none", val nowColor: Int = -1
+    )
+
+    /** Old profiles stored only a hue; this turns it into a full color. */
+    fun hueToArgb(h: Long): Int = android.graphics.Color.HSVToColor(floatArrayOf(h.toFloat().coerceIn(0f, 359f), 0.6f, 0.85f))
+    private fun colorOf(s: com.google.firebase.firestore.DocumentSnapshot, key: String, hueKey: String, defHue: Long): Int =
+        s.getLong(key)?.toInt() ?: hueToArgb(s.getLong(hueKey) ?: defHue)
+
+    val uid = mutableStateOf<String?>(null)
+    val email = mutableStateOf("")
+    val profile = mutableStateOf<Profile?>(null)
+    val friendCode = mutableStateOf("")
+    val busy = mutableStateOf(false)
+    val message = mutableStateOf("")
+    val syncStatus = mutableStateOf("")
+
+    private var started = false
+    private var appCtx: Context? = null
+    private var lastSyncTry = 0L
+
+    fun prefs(c: Context): SharedPreferences =
+        c.applicationContext.getSharedPreferences("rasi_account", Context.MODE_PRIVATE)
+
+    private fun auth(): FirebaseAuth? = try { FirebaseAuth.getInstance() } catch (t: Throwable) {
+        RasiLog.fallback("RasiAccount", "Firebase is not available: " + t.javaClass.simpleName); null
+    }
+
+    private fun db(): FirebaseFirestore? = try { FirebaseFirestore.getInstance() } catch (t: Throwable) {
+        RasiLog.fallback("RasiAccount", "Firestore is not available: " + t.javaClass.simpleName); null
+    }
+
+    @Synchronized
+    fun init(c: Context) {
+        if (started) return
+        appCtx = c.applicationContext
+        val a = auth() ?: return
+        started = true
+        a.addAuthStateListener { fa ->
+            val u = fa.currentUser
+            uid.value = u?.uid
+            email.value = u?.email ?: ""
+            if (u == null) {
+                profile.value = null; friendCode.value = ""; RasiFriends.clear(); RasiRooms.localReset(); RasiGroups.localReset()
+                RasiPictures.avatarImg.value = null; RasiPictures.bannerImg.value = null
+            } else loadProfile()
+        }
+    }
+
+    fun validUsername(u: String) = Regex("^[a-z0-9_.]{3,20}$").matches(u)
+
+    private fun fail(t: Throwable?, what: String): String {
+        RasiLog.fallback("RasiAccount", what + ": " + (t?.javaClass?.simpleName ?: "unknown"))
+        val chain = generateSequence(t) { it.cause }.take(5).toList()
+        val text = chain.joinToString(" ") { it.message ?: "" }
+        return when {
+            t is FirebaseAuthWeakPasswordException -> "Password is too weak (use at least 6 characters)"
+            t is FirebaseAuthUserCollisionException -> "That email already has an account. Try signing in"
+            t is FirebaseAuthInvalidUserException -> "No account with that email"
+            t is FirebaseAuthInvalidCredentialsException -> "Wrong email or password"
+            text.contains("taken") -> "That username is taken, pick another"
+            text.contains("PERMISSION_DENIED") -> "The server refused this. The Firestore rules may not be pasted yet"
+            else -> "Could not reach the server. Check your internet and try again"
+        }
+    }
+
+    fun signIn(c: Context, mail: String, pass: String) {
+        init(c); val a = auth() ?: run { message.value = "Firebase is not available in this build"; return }
+        busy.value = true; message.value = ""
+        a.signInWithEmailAndPassword(mail.trim(), pass).addOnCompleteListener { t ->
+            busy.value = false
+            message.value = if (t.isSuccessful) "" else fail(t.exception, "Sign in failed")
+        }
+    }
+
+    fun signUp(c: Context, mail: String, pass: String, username: String, name: String) {
+        init(c); val a = auth() ?: run { message.value = "Firebase is not available in this build"; return }
+        val u = username.trim().lowercase()
+        if (!validUsername(u)) { message.value = "Username: 3 to 20 letters, numbers, _ or ."; return }
+        if (name.isBlank()) { message.value = "Pick a display name"; return }
+        busy.value = true; message.value = ""
+        a.createUserWithEmailAndPassword(mail.trim(), pass).addOnCompleteListener { t ->
+            if (!t.isSuccessful) { busy.value = false; message.value = fail(t.exception, "Sign up failed"); return@addOnCompleteListener }
+            createProfile(u, name.trim())
+        }
+    }
+
+    private fun randomCode(): String {
+        val abc = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+        val r = java.security.SecureRandom()
+        return (1..8).map { abc[r.nextInt(abc.length)] }.joinToString("")
+    }
+
+    /** Also used by the Finish profile view when the username was taken. */
+    fun createProfile(username: String, name: String) {
+        val a = auth(); val d = db(); val me = a?.currentUser
+        if (a == null || d == null || me == null) { busy.value = false; message.value = "Not signed in"; return }
+        val u = username.trim().lowercase()
+        if (!validUsername(u)) { busy.value = false; message.value = "Username: 3 to 20 letters, numbers, _ or ."; return }
+        busy.value = true
+        val code = randomCode()
+        val now = System.currentTimeMillis()
+        val profileMap = hashMapOf<String, Any>(
+            "username" to u, "name" to name.take(30), "bio" to "", "avatar" to "\uD83D\uDE00",
+            "avatarColor" to (hueToArgb(270).toLong() and 0xFFFFFFFFL),
+            "bannerColor1" to (hueToArgb(270).toLong() and 0xFFFFFFFFL),
+            "bannerColor2" to (hueToArgb(200).toLong() and 0xFFFFFFFFL),
+            "createdAt" to now, "statsShared" to false
+        )
+        d.runTransaction(Transaction.Function<Void?> { tx ->
+            val nameRef = d.collection("usernames").document(u)
+            val codeRef = d.collection("codes").document(code)
+            if (tx.get(nameRef).exists()) throw IllegalStateException("taken")
+            if (tx.get(codeRef).exists()) throw IllegalStateException("code clash, try again")
+            tx.set(nameRef, hashMapOf("uid" to me.uid))
+            tx.set(codeRef, hashMapOf("uid" to me.uid))
+            tx.set(d.collection("users").document(me.uid), profileMap)
+            tx.set(d.collection("users").document(me.uid).collection("private").document("me"), hashMapOf("friendCode" to code))
+            null
+        }).addOnCompleteListener { t ->
+            busy.value = false
+            if (t.isSuccessful) { message.value = ""; loadProfile() } else message.value = fail(t.exception, "Profile creation failed")
+        }
+    }
+
+    /** Builds a Profile from a users/{uid} document (mine or a friend's). */
+    fun parse(s: com.google.firebase.firestore.DocumentSnapshot): Profile = Profile(
+                s.getString("username") ?: "", s.getString("name") ?: "", s.getString("bio") ?: "",
+                s.getString("avatar") ?: "\uD83D\uDE00",
+                colorOf(s, "avatarColor", "avatarHue", 270L), colorOf(s, "bannerColor1", "bannerHue1", 270L),
+                colorOf(s, "bannerColor2", "bannerHue2", 200L), s.getLong("createdAt") ?: 0L,
+                s.getLong("avatarPicV") ?: 0L, s.getBoolean("avatarUsePic") ?: true,
+                s.getLong("bannerPicV") ?: 0L, s.getBoolean("bannerUsePic") ?: true,
+                s.getString("pronouns") ?: "", s.getString("status") ?: "",
+                s.getLong("accent")?.toInt() ?: hueToArgb(270L), s.getString("cardStyle") ?: "full",
+                (s.get("badges") as? List<*>)?.mapNotNull { it as? String } ?: emptyList(),
+                s.getBoolean("showBadges") ?: true, s.getBoolean("showTop") ?: true, s.getBoolean("showNow") ?: false,
+                s.getBoolean("allowRequests") ?: true,
+                s.getString("nowColorMode") ?: "none", s.getLong("nowColor")?.toInt() ?: -1
+        )
+
+    fun loadProfile() {
+        val d = db() ?: return
+        val id = auth()?.currentUser?.uid ?: return
+        d.collection("users").document(id).get().addOnSuccessListener { s ->
+            profile.value = if (!s.exists()) null else parse(s)
+            appCtx?.let { RasiPictures.refreshOwn(it) }
+        }.addOnFailureListener { RasiLog.fallback("RasiAccount", "Could not load profile: " + it.javaClass.simpleName) }
+        d.collection("users").document(id).collection("private").document("me").get().addOnSuccessListener { s ->
+            friendCode.value = s.getString("friendCode") ?: ""
+        }
+    }
+
+    fun saveProfile(name: String, bio: String, avatar: String, aCol: Int, b1: Int, b2: Int,
+                    pronouns: String, status: String, accent: Int, cardStyle: String,
+                    badges: List<String>, showBadges: Boolean, showTop: Boolean, showNow: Boolean,
+                    nowColorMode: String = "none", nowColor: Int = -1, done: (Boolean) -> Unit) {
+        val d = db(); val id = auth()?.currentUser?.uid
+        if (d == null || id == null) { done(false); return }
+        val map = hashMapOf<String, Any>(
+            "name" to name.trim().take(30), "bio" to bio.trim().take(120), "avatar" to avatar.take(8),
+            "avatarColor" to (aCol.toLong() and 0xFFFFFFFFL),
+            "bannerColor1" to (b1.toLong() and 0xFFFFFFFFL),
+            "bannerColor2" to (b2.toLong() and 0xFFFFFFFFL),
+            "pronouns" to pronouns.trim().take(24), "status" to status.trim().take(60),
+            "accent" to (accent.toLong() and 0xFFFFFFFFL), "cardStyle" to (if (cardStyle == "compact") "compact" else "full"),
+            "badges" to badges.take(12), "showBadges" to showBadges, "showTop" to showTop, "showNow" to showNow,
+            "nowColorMode" to (if (nowColorMode in listOf("gradient", "song", "manual")) nowColorMode else "none"),
+            "nowColor" to (nowColor.toLong() and 0xFFFFFFFFL)
+        )
+        d.collection("users").document(id).set(map, SetOptions.merge()).addOnCompleteListener { t ->
+            if (t.isSuccessful) loadProfile() else RasiLog.fallback("RasiAccount", "Could not save profile: " + (t.exception?.javaClass?.simpleName ?: ""))
+            done(t.isSuccessful)
+        }
+    }
+
+    fun signOut() { RasiLive.clear { auth()?.signOut() } }
+
+    fun resetPassword(mail: String) {
+        val a = auth() ?: return
+        if (mail.isBlank()) { message.value = "Type your email first"; return }
+        a.sendPasswordResetEmail(mail.trim()).addOnCompleteListener { t ->
+            message.value = if (t.isSuccessful) "Password reset email sent" else fail(t.exception, "Reset failed")
+        }
+    }
+
+    // ---- sharing totals (never typed text) ----
+
+    fun setShareStats(c: Context, on: Boolean) {
+        prefs(c).edit().putBoolean("acc_share", on).apply()
+        val d = db(); val id = auth()?.currentUser?.uid ?: return
+        d?.collection("users")?.document(id)?.set(hashMapOf<String, Any>("statsShared" to on), SetOptions.merge())
+        if (on) syncNow(c) else {
+            d?.collection("users")?.document(id)?.collection("shared")?.document("stats")?.delete()
+            syncStatus.value = "Sharing is off, shared totals were removed"
+        }
+    }
+
+    fun syncNow(c: Context) {
+        val d = db(); val id = auth()?.currentUser?.uid
+        if (d == null || id == null) { syncStatus.value = "Sign in first"; return }
+        val s = RasiStats.summary(c, -1, 5)
+        profile.value?.let { pr ->
+            if (pr.showBadges) {
+                val ids = RasiBadges.earned(c, pr.createdAt, pr.avatarPicV > 0L)
+                if (ids != pr.badges) d.collection("users").document(id).set(hashMapOf<String, Any>("badges" to ids), SetOptions.merge())
+            }
+        }
+        val top = s.songs.map { (k, ms) ->
+            val p = k.split("\u001f")
+            hashMapOf<String, Any>("title" to p[0], "artist" to (p.getOrNull(1) ?: ""), "ms" to ms)
+        }
+        val map = hashMapOf<String, Any>(
+            "keys" to s.keys, "words" to s.words, "listenMs" to s.listenMs,
+            "top" to top, "updatedAt" to System.currentTimeMillis()
+        )
+        d.collection("users").document(id).collection("shared").document("stats").set(map).addOnCompleteListener { t ->
+            if (t.isSuccessful) {
+                prefs(c).edit().putLong("acc_last", System.currentTimeMillis()).apply()
+                syncStatus.value = "Totals shared just now"
+            } else {
+                syncStatus.value = "Could not share totals (no internet?)"
+                RasiLog.fallback("RasiAccount", "Stats sync failed: " + (t.exception?.javaClass?.simpleName ?: ""))
+            }
+        }
+    }
+
+    /** Called from RasiStats.flush: cheap checks first, so it costs nothing when sharing is off. */
+    fun maybeSync(c: Context) {
+        val p = prefs(c)
+        if (!p.getBoolean("acc_share", false) || !p.getBoolean("acc_auto", true)) return
+        val now = System.currentTimeMillis()
+        val gap = p.getInt("acc_interval", 60) * 60000L
+        if (now - p.getLong("acc_last", 0L) < gap || now - lastSyncTry < 120000L) return
+        lastSyncTry = now
+        try { if (auth()?.currentUser != null) syncNow(c) } catch (t: Throwable) {
+            RasiLog.fallback("RasiAccount", "Auto sync skipped: " + t.javaClass.simpleName)
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiAccountDelete.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiAccountDelete.kt
new file mode 100644
index 000000000..93f939001
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiAccountDelete.kt
@@ -0,0 +1,140 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import androidx.compose.runtime.mutableStateOf
+import com.google.android.gms.tasks.Tasks
+import com.google.firebase.auth.EmailAuthProvider
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.CollectionReference
+import com.google.firebase.firestore.FirebaseFirestore
+import com.google.firebase.firestore.Query
+
+/**
+ * Deletes my online account: my friend links, requests, my chat messages, my shared data, my username and
+ * friend code, my profile and finally the sign-in itself. Runs on its own thread, step by step, and can be
+ * repeated if it stops half way (nothing is wrong with deleting twice). Free Spark plan only, no functions.
+ */
+object RasiAccountDelete {
+    val busy = mutableStateOf(false)
+    val status = mutableStateOf("")
+    val done = mutableStateOf(false)
+
+    private class Stop(val text: String) : Exception(text)
+
+    private fun <T> await(t: com.google.android.gms.tasks.Task<T>): T = Tasks.await(t)
+
+    private fun step(s: String) { status.value = s }
+
+    /** Deletes every document of [refs] in batches of 400. */
+    private fun deleteRefs(d: FirebaseFirestore, refs: List<com.google.firebase.firestore.DocumentReference>) {
+        refs.chunked(400).forEach { part ->
+            val b = d.batch()
+            part.forEach { r -> b.delete(r) }
+            await(b.commit())
+        }
+    }
+
+    private fun deleteAll(d: FirebaseFirestore, q: Query) {
+        deleteRefs(d, await(q.get()).documents.map { it.reference })
+    }
+
+    private fun why(t: Throwable): String {
+        val chain = generateSequence(t) { it.cause }.take(5).toList()
+        val text = chain.joinToString(" ") { it.message ?: "" }
+        return when {
+            text.contains("PERMISSION_DENIED") -> "The server refused this. Publish the newest Firestore rules first (firestore.rules of v2.4.92)"
+            else -> "Could not reach the server. Check your internet and try again"
+        }
+    }
+
+    /** [resetLocal] also clears the online options kept on this phone (live listening, alerts, caches). */
+    fun start(c: Context, password: String, resetLocal: Boolean) {
+        if (busy.value) return
+        val ctx = c.applicationContext
+        val a = try { FirebaseAuth.getInstance() } catch (t: Throwable) { null }
+        val d = try { FirebaseFirestore.getInstance() } catch (t: Throwable) { null }
+        val user = a?.currentUser
+        if (a == null || d == null || user == null) { status.value = "You are not signed in"; return }
+        val me = user.uid
+        val mail = user.email ?: ""
+        val username = RasiAccount.profile.value?.username ?: ""
+        val code = RasiAccount.friendCode.value
+        busy.value = true; done.value = false
+        status.value = "Checking your password..."
+        Thread {
+            try {
+                try { await(user.reauthenticate(EmailAuthProvider.getCredential(mail, password))) }
+                catch (t: Throwable) { throw Stop("Wrong password. Nothing was deleted") }
+
+                // Stop everything that writes online data for me.
+                Handler(Looper.getMainLooper()).post {
+                    try {
+                        RasiAccount.prefs(ctx).edit().putBoolean("live_on", false).putBoolean("acc_share", false).apply()
+                        RasiRooms.leave(ctx)
+                    } catch (t: Throwable) { RasiLog.fallback("AccountDelete", "stop failed: " + t.message) }
+                }
+                Thread.sleep(800)
+
+                step("Cleaning up chats...")
+                val chats = await(d.collection("chats").whereArrayContains("members", me).get()).documents
+                for (ch in chats) {
+                    try {
+                        if (ch.getString("lastFrom") == me && !ch.getString("lastMessage").isNullOrEmpty())
+                            await(ch.reference.update("lastMessage", ""))
+                    } catch (t: Throwable) { RasiLog.fallback("AccountDelete", "chat preview kept: " + t.message) }
+                    deleteAll(d, ch.reference.collection("messages").whereEqualTo("from", me))
+                }
+
+                step("Removing friend requests...")
+                deleteAll(d, d.collection("friendRequests").whereEqualTo("from", me))
+                deleteAll(d, d.collection("friendRequests").whereEqualTo("to", me))
+
+                step("Removing friends...")
+                val mine = d.collection("users").document(me).collection("friends")
+                val friends = await(mine.get()).documents
+                for (f in friends) {
+                    try { await(d.collection("users").document(f.id).collection("friends").document(me).delete()) }
+                    catch (t: Throwable) { RasiLog.fallback("AccountDelete", "friend side kept: " + t.message) }
+                }
+                deleteRefs(d, friends.map { it.reference })
+
+                step("Removing my data...")
+                val u = d.collection("users").document(me)
+                for (name in listOf("shared", "media", "blocks", "private")) {
+                    val col: CollectionReference = u.collection(name)
+                    deleteAll(d, col)
+                }
+
+                step("Freeing my username and code...")
+                if (username.isNotEmpty()) await(d.collection("usernames").document(username).delete())
+                if (code.isNotEmpty()) await(d.collection("codes").document(code).delete())
+
+                step("Removing my profile...")
+                await(u.delete())
+
+                step("Deleting the sign-in...")
+                try { await(user.delete()) }
+                catch (t: Throwable) { throw Stop("Your data is gone but the sign-in could not be deleted. Sign in again and press delete once more") }
+
+                Handler(Looper.getMainLooper()).post {
+                    try {
+                        if (resetLocal) RasiAccount.prefs(ctx).edit().clear().apply()
+                        a.signOut()
+                    } catch (t: Throwable) { RasiLog.fallback("AccountDelete", "local reset failed: " + t.message) }
+                    status.value = "Your account was deleted."
+                    done.value = true
+                    busy.value = false
+                }
+            } catch (s: Stop) {
+                RasiLog.fallback("AccountDelete", "stopped: " + s.text)
+                status.value = s.text; busy.value = false
+            } catch (t: Throwable) {
+                RasiLog.fallback("AccountDelete", "failed: " + t.javaClass.simpleName + " " + t.message)
+                status.value = why(t) + ". You can press delete again, finished steps are skipped"
+                busy.value = false
+            }
+        }.start()
+    }
+}
