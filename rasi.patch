+/** The settings background (song/gradient/theme) as a brush, for dialogs that live outside the settings page. */
+@Composable
+internal fun rasiDialogBrush(): androidx.compose.ui.graphics.Brush {
+    val c = MaterialTheme.colorScheme
+    val ctx = LocalContext.current
+    val tick = org.futo.inputmethod.latin.rasi.rememberNowPlayingTick()
+    val dark = c.background.luminance() < 0.5f
+    return org.futo.inputmethod.latin.rasi.RasiSettingsAmbience.brush(ctx, dark, tick)
+        ?: org.futo.inputmethod.latin.uix.settings.LocalRasiSettingsBackground.current
+        ?: androidx.compose.ui.graphics.Brush.verticalGradient(listOf(c.background, c.primary.copy(alpha = 0.10f).compositeOver(c.background), c.background))
+}
+
+/** Dialog background that matches the settings theme. fx = also the settings background effects. dim = surface tint 0..100. */
+@Composable
+internal fun RasiDrawerBg(on: Boolean, fx: Boolean, dim: Int, content: @Composable () -> Unit) {
+    if (!on) { content(); return }
+    val tint = MaterialTheme.colorScheme.surface.copy(alpha = dim.coerceIn(0, 100) / 100f)
+    if (fx) {
+        org.futo.inputmethod.latin.uix.settings.RasiGlassBackground {
+            Box(Modifier.fillMaxSize().background(tint))
+            content()
+        }
+    } else {
+        Box(Modifier.fillMaxSize().background(rasiDialogBrush()).background(tint)) { content() }
+    }
+}
