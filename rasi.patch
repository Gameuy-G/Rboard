@@ -0,0 +1,53 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.graphics.ColorMatrix
+import android.graphics.ColorMatrixColorFilter
+import android.graphics.Paint
+import androidx.compose.foundation.Canvas
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.drawscope.drawIntoCanvas
+import androidx.compose.ui.graphics.nativeCanvas
+import androidx.compose.ui.platform.LocalContext
+
+/** The blurred, dimmed cover behind the whole keyboard (suggestions bar and keys). */
+@Composable
+fun RasiSongBackground(modifier: Modifier = Modifier) {
+    val ctx = LocalContext.current
+    var tick by remember { mutableIntStateOf(0) }
+    DisposableEffect(Unit) {
+        val l: () -> Unit = { tick++ }
+        RasiNowPlaying.listeners.add(l)
+        onDispose { RasiNowPlaying.listeners.remove(l) }
+    }
+    val unused = tick
+    if (!RasiNowPlayingBg.windowMode(ctx)) return
+    val art = RasiNowPlaying.track?.art ?: return
+    val p = RasiSongLooks.over(RasiNowPlaying.prefs(ctx))
+    val blur = p.getInt("bg_blur", 40)
+    val dim = p.getInt("bg_dim", 35)
+    val opacity = p.getInt("bg_opacity", 80)
+    val paint = remember { Paint(Paint.FILTER_BITMAP_FLAG) }
+    val grayFilter = remember { ColorMatrixColorFilter(ColorMatrix().apply { setSaturation(0f) }) }
+    Canvas(modifier) {
+        val shakeTick = RasiShake.version // redraw while the beat shake runs
+        val w = size.width.toInt()
+        val h = size.height.toInt()
+        if (w <= 0 || h <= 0) return@Canvas
+        val bmp = RasiNowPlayingBg.bitmapFor(art, blur, dim, w, h) ?: return@Canvas
+        paint.alpha = (255 * opacity / 100).coerceIn(0, 255)
+        drawIntoCanvas {
+            val nc = it.nativeCanvas
+            nc.save()
+            if (RasiShake.toBg && RasiShake.amp > 0f) RasiShake.applyBg(nc, size.width, size.height)
+            paint.colorFilter = if (RasiShake.toBg && RasiShake.gray) grayFilter else null
+            nc.drawBitmap(bmp, 0f, 0f, paint)
+            nc.restore()
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiSongLooks.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiSongLooks.kt
new file mode 100644
index 000000000..a7cd91331
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiSongLooks.kt
@@ -0,0 +1,301 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import org.json.JSONObject
+
+/**
+ * Per-song looks. A look is a small set of option values saved for one song (key = title + artist).
+ * While the song plays, the values are laid over the normal music options (nothing in the normal
+ * settings is changed). Local only, no internet.
+ */
+object RasiSongLooks {
+    private const val FILE = "rasi_songlooks"
+
+    val vizDefaults: Map<String, Any> = linkedMapOf(
+        "viz_color_src" to "song", "viz_song_n" to 3, "viz_song_minv" to 60, "viz_song_sat" to 10,
+        "viz_song_rev" to false, "viz_color1" to 0xFF7CF29C.toInt(), "viz_color2" to 0xFF4F8CFF.toInt()
+    )
+    val gradDefaults: Map<String, Any> = linkedMapOf("dyn_gradient" to false)
+    val customDefaults: Map<String, Any> = linkedMapOf("sl_c1" to 0xFF7CF29C.toInt(), "sl_c2" to 0xFF4F8CFF.toInt())
+    val bgDefaults: Map<String, Any> = linkedMapOf("bg_blur" to 40, "bg_dim" to 35, "bg_opacity" to 80)
+
+    @Volatile private var all: JSONObject? = null
+    @Volatile var current: Map<String, Any>? = null
+        private set
+    @Volatile var currentKey: String? = null
+        private set
+    @Volatile var version = 0
+        private set
+
+    private fun sp(c: Context): SharedPreferences = c.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+    private fun np(c: Context): SharedPreferences = RasiNowPlaying.prefs(c)
+
+    fun keyOf(title: String, artist: String): String = title.trim().lowercase() + "|" + artist.trim().lowercase()
+
+    private fun load(c: Context): JSONObject {
+        all?.let { return it }
+        val o = try { JSONObject(sp(c).getString("looks", "{}") ?: "{}") } catch (t: Throwable) { JSONObject() }
+        all = o
+        return o
+    }
+
+    private fun persist(c: Context) {
+        try { sp(c).edit().putString("looks", load(c).toString()).apply() } catch (t: Throwable) { RasiLog.fallback("SongLooks", "save failed: " + t.message) }
+    }
+
+    private fun toMap(o: JSONObject): Map<String, Any> {
+        val m = HashMap<String, Any>()
+        val it = o.keys()
+        while (it.hasNext()) {
+            val k = it.next()
+            when (val v = o.opt(k)) {
+                is Int -> m[k] = v
+                is Long -> m[k] = v.toInt()
+                is Boolean -> m[k] = v
+                is String -> m[k] = v
+            }
+        }
+        return m
+    }
+
+    /** Forget the cached looks (after a settings import changed the file). */
+    fun reload() { all = null; current = null; currentKey = null; version++ }
+
+    fun enabled(c: Context): Boolean = np(c).getBoolean("sl_on", true)
+    fun auto(c: Context): Boolean = np(c).getBoolean("sl_auto", true)
+
+    /** Called by the listener before the keyboard is told that the track changed. */
+    fun onTrack(c: Context, t: RasiNowPlaying.Track?) {
+        val oldKey = currentKey
+        var nk: String? = null
+        var map: Map<String, Any>? = null
+        if (t != null && enabled(c) && auto(c)) {
+            val k = keyOf(t.title, t.artist)
+            val v = load(c).optJSONObject(k)?.optJSONObject("v")
+            if (v != null) { nk = k; map = toMap(v) }
+        }
+        current = map
+        currentKey = nk
+        if (oldKey != nk) version++
+    }
+
+    fun hasLook(c: Context, t: RasiNowPlaying.Track?): Boolean =
+        t != null && load(c).has(keyOf(t.title, t.artist))
+
+    fun count(c: Context): Int = load(c).length()
+
+    /** Apply the saved look of the playing song right now, even when auto-apply is off (until the song changes). */
+    fun applyNow(c: Context): Boolean {
+        val t = RasiNowPlaying.track ?: return false
+        val k = keyOf(t.title, t.artist)
+        val v = load(c).optJSONObject(k)?.optJSONObject("v") ?: return false
+        current = toMap(v); currentKey = k; version++
+        RasiNowPlaying.notifyChanged()
+        return true
+    }
+
+    /** Saves what the normal options say now. Parts are chosen with the sl_s_* switches. */
+    fun saveCurrent(c: Context): Boolean {
+        val t = RasiNowPlaying.track ?: return false
+        val p = np(c)
+        val v = JSONObject()
+        fun put(defs: Map<String, Any>) {
+            for ((k, d) in defs) {
+                when (d) {
+                    is Int -> v.put(k, p.getInt(k, d))
+                    is Boolean -> v.put(k, p.getBoolean(k, d))
+                    is String -> v.put(k, p.getString(k, d) ?: d)
+                }
+            }
+        }
+        if (p.getBoolean("sl_s_viz", true)) put(vizDefaults)
+        if (p.getBoolean("sl_s_grad", true)) {
+            put(gradDefaults)
+            if (p.getBoolean("sl_cg", false)) put(customDefaults)
+        }
+        if (p.getBoolean("sl_s_bg", true)) put(bgDefaults)
+        if (v.length() == 0) return false
+        val o = JSONObject()
+        o.put("t", t.title); o.put("a", t.artist); o.put("at", System.currentTimeMillis()); o.put("v", v)
+        val k = keyOf(t.title, t.artist)
+        load(c).put(k, o)
+        persist(c)
+        current = toMap(v); currentKey = k; version++
+        RasiNowPlaying.notifyChanged()
+        return true
+    }
+
+    class Item(val key: String, val title: String, val artist: String, val at: Long, val name: String, val values: Map<String, Any>)
+
+    /** All saved looks, newest first. */
+    fun list(c: Context): List<Item> {
+        val o = load(c)
+        val out = ArrayList<Item>()
+        val it = o.keys()
+        while (it.hasNext()) {
+            val k = it.next()
+            val l = o.optJSONObject(k) ?: continue
+            out.add(Item(k, l.optString("t"), l.optString("a"), l.optLong("at"), l.optString("n"), toMap(l.optJSONObject("v") ?: JSONObject())))
+        }
+        out.sortByDescending { x -> x.at }
+        return out
+    }
+
+    fun rename(c: Context, key: String, name: String) {
+        val l = load(c).optJSONObject(key) ?: return
+        l.put("n", name.trim())
+        persist(c)
+    }
+
+    /** Changes one saved value of a look (Int, Boolean or String). Applies live if that song is playing. */
+    fun setValue(c: Context, key: String, pref: String, value: Any) {
+        val l = load(c).optJSONObject(key) ?: return
+        val v = l.optJSONObject("v") ?: return
+        v.put(pref, value)
+        persist(c)
+        if (currentKey == key) { current = toMap(v); version++ }
+        RasiNowPlaying.notifyChanged()
+    }
+
+    fun deleteFor(c: Context, t: RasiNowPlaying.Track?) {
+        if (t == null) return
+        deleteKey(c, keyOf(t.title, t.artist))
+    }
+
+    fun deleteKey(c: Context, key: String) {
+        load(c).remove(key)
+        persist(c)
+        if (currentKey == key) { current = null; currentKey = null; version++ }
+        RasiNowPlaying.notifyChanged()
+    }
+
+    fun clearAll(c: Context) {
+        all = JSONObject(); persist(c)
+        current = null; currentKey = null; version++
+        RasiNowPlaying.notifyChanged()
+    }
+
+
+    // ---- export / import as a small file ----
+    private val ranges: Map<String, IntRange> = mapOf(
+        "viz_song_n" to 2..6, "viz_song_minv" to 20..100, "viz_song_sat" to 0..60,
+        "bg_blur" to 0..100, "bg_dim" to 0..80, "bg_opacity" to 10..100
+    )
+    private val srcIds = setOf("song", "solid", "gradient", "rgb")
+
+    class Parsed(val key: String, val title: String, val artist: String, val at: Long, val name: String, val values: Map<String, Any>)
+
+    /** The looks as the text of a small file. [keys] null = all looks. */
+    fun exportText(c: Context, keys: Set<String>?): String {
+        val o = load(c)
+        val arr = org.json.JSONArray()
+        val it = o.keys()
+        while (it.hasNext()) {
+            val k = it.next()
+            if (keys != null && k !in keys) continue
+            val l = o.optJSONObject(k) ?: continue
+            val e = JSONObject()
+            e.put("t", l.optString("t")); e.put("a", l.optString("a")); e.put("at", l.optLong("at"))
+            val n = l.optString("n"); if (n.isNotBlank()) e.put("n", n)
+            e.put("v", l.optJSONObject("v") ?: JSONObject())
+            arr.put(e)
+        }
+        val root = JSONObject()
+        root.put("rasi", "songlooks"); root.put("ver", 1); root.put("looks", arr)
+        return root.toString(1)
+    }
+
+    /** Reads a looks file. Only known option names with fitting values are kept. Null = not a looks file. */
+    fun parseText(text: String): List<Parsed>? {
+        val root = try { JSONObject(text) } catch (t: Throwable) { return null }
+        if (root.optString("rasi") != "songlooks") return null
+        val arr = root.optJSONArray("looks") ?: return null
+        val defs = LinkedHashMap<String, Any>()
+        defs.putAll(vizDefaults); defs.putAll(gradDefaults); defs.putAll(customDefaults); defs.putAll(bgDefaults)
+        val out = ArrayList<Parsed>()
+        for (i in 0 until minOf(arr.length(), 2000)) {
+            val e = arr.optJSONObject(i) ?: continue
+            val title = e.optString("t").trim().take(200)
+            if (title.isEmpty()) continue
+            val artist = e.optString("a").trim().take(200)
+            val src = e.optJSONObject("v") ?: continue
+            val v = HashMap<String, Any>()
+            for ((k, d) in defs) {
+                if (!src.has(k)) continue
+                when (d) {
+                    is Int -> { val x = src.opt(k); if (x is Int || x is Long) {
+                        val n = (x as Number).toInt()
+                        v[k] = ranges[k]?.let { r -> n.coerceIn(r.first, r.last) } ?: n } }
+                    is Boolean -> (src.opt(k) as? Boolean)?.let { b -> v[k] = b }
+                    is String -> (src.opt(k) as? String)?.let { sv -> if (sv in srcIds) v[k] = sv }
+                }
+            }
+            if (v.isEmpty()) continue
+            val at = e.optLong("at").let { a -> if (a > 0L) a else System.currentTimeMillis() }
+            out.add(Parsed(keyOf(title, artist), title, artist, at, e.optString("n").trim().take(80), v))
+        }
+        return out
+    }
+
+    /** Adds the looks. Existing looks of the same song are kept unless [overwrite]. Returns (added, skipped). */
+    fun importParsed(c: Context, items: List<Parsed>, overwrite: Boolean): Pair<Int, Int> {
+        val o = load(c)
+        var added = 0; var skipped = 0
+        for (p in items) {
+            if (o.has(p.key) && !overwrite) { skipped++; continue }
+            val l = JSONObject()
+            l.put("t", p.title); l.put("a", p.artist); l.put("at", p.at)
+            if (p.name.isNotBlank()) l.put("n", p.name)
+            val v = JSONObject()
+            for ((k, x) in p.values) v.put(k, x)
+            l.put("v", v)
+            o.put(p.key, l)
+            added++
+        }
+        if (added > 0) {
+            persist(c)
+            onTrack(c, RasiNowPlaying.track)
+            version++
+            RasiNowPlaying.notifyChanged()
+        }
+        return Pair(added, skipped)
+    }
+
+    // ---- overlay ----
+    private class Over(private val base: SharedPreferences, private val m: Map<String, Any>) : SharedPreferences by base {
+        override fun getInt(key: String?, defValue: Int): Int = (key?.let { m[it] } as? Int) ?: base.getInt(key, defValue)
+        override fun getBoolean(key: String?, defValue: Boolean): Boolean = (key?.let { m[it] } as? Boolean) ?: base.getBoolean(key, defValue)
+        override fun getString(key: String?, defValue: String?): String? = (key?.let { m[it] } as? String) ?: base.getString(key, defValue)
+    }
+
+    @Volatile private var cBase: SharedPreferences? = null
+    @Volatile private var cMap: Map<String, Any>? = null
+    @Volatile private var cWrap: SharedPreferences? = null
+
+    /** [p] with the playing song's saved look on top (or [p] itself when there is none). */
+    fun over(p: SharedPreferences): SharedPreferences {
+        val m = current ?: return p
+        if (p is RasiMappedPrefs) return p
+        if (cBase === p && cMap === m) cWrap?.let { return it }
+        val w = Over(p, m)
+        cBase = p; cMap = m; cWrap = w
+        return w
+    }
+
+    /** Custom gradient colors (a saved look first, then the general custom gradient option). */
+    fun customPalette(c: Context): RasiPalette? {
+        val m = current
+        var c1 = m?.get("sl_c1") as? Int
+        var c2 = m?.get("sl_c2") as? Int
+        if (c1 == null) {
+            val p = np(c)
+            if (!p.getBoolean("sl_cg", false)) return null
+            c1 = p.getInt("sl_c1", 0xFF7CF29C.toInt()); c2 = p.getInt("sl_c2", 0xFF4F8CFF.toInt())
+        }
+        val a = FloatArray(3); val b = FloatArray(3)
+        android.graphics.Color.colorToHSV(c1, a)
+        android.graphics.Color.colorToHSV(c2 ?: c1, b)
+        return RasiPalette(a[0], a[1].coerceIn(0.2f, 0.85f), b[0], b[1].coerceIn(0.2f, 0.85f), a[2], b[2])
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiState.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiState.kt
new file mode 100644
index 000000000..c35ac03d4
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiState.kt
@@ -0,0 +1,56 @@
+package org.futo.inputmethod.latin.rasi
+
+import androidx.compose.runtime.mutableStateOf
+
+/** Small shared state for the RASI additions. */
+object RasiState {
+    /** If set and it returns true, the phone's Back key is consumed instead of hiding the keyboard. */
+    @JvmField
+    var backInterceptor: (() -> Boolean)? = null
+
+    /** True while the symbols (?123) screen is showing. */
+    @JvmField
+    val symbolsShown = mutableStateOf(false)
+
+    @JvmStatic
+    fun setSymbols(shown: Boolean) {
+        symbolsShown.value = shown
+    }
+
+    /** A screenshot that was just taken, shown as a "Screenshot" chip in the suggestion bar. */
+    data class RasiScreenshot(val file: String, val mime: String, val time: Long)
+
+    @JvmField
+    val screenshot = mutableStateOf<RasiScreenshot?>(null)
+
+    fun activeScreenshot(): RasiScreenshot? {
+        val s = screenshot.value ?: return null
+        return if (System.currentTimeMillis() - s.time > 10L * 60L * 1000L) null else s
+    }
+
+    /** Emoji that stays at the right of the suggestion bar after tapping an emoji suggestion. */
+    @JvmField
+    val stickyEmoji = mutableStateOf<List<String>>(emptyList())
+
+    /** The emoji suggestions most recently shown in the bar (updated by the suggestion bar). */
+    @JvmField
+    var lastEmojiMatches: List<String> = emptyList()
+
+    @JvmStatic
+    fun setStickyEmoji(emoji: String?) {
+        stickyEmoji.value = when {
+            emoji == null -> emptyList()
+            lastEmojiMatches.contains(emoji) -> lastEmojiMatches
+            else -> listOf(emoji)
+        }
+    }
+
+    /** Called for every software key press. Typing a real character ends the chip and the sticky emoji. */
+    @JvmStatic
+    fun onKeyTyped(codePoint: Int) {
+        if (codePoint > 32) {
+            if (stickyEmoji.value.isNotEmpty()) stickyEmoji.value = emptyList()
+            if (screenshot.value != null) screenshot.value = null
+        }
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiStats.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiStats.kt
new file mode 100644
index 000000000..d4542eef8
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiStats.kt
@@ -0,0 +1,225 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import java.util.Calendar
+
+/**
+ * Local usage stats. COUNTS ONLY: it never sees, keeps or saves what you type, only how many keys,
+ * how many words, which app, and how long which song played. Nothing leaves the phone.
+ * Storage keys (all in "rasi_stats"): k|DAY, w|DAY, l|DAY, a|DAY|package, s|DAY|title\u001fartist
+ */
+object RasiStats {
+    const val PREFS = "rasi_stats"
+    private const val CODE_DELETE = -5 // Constants.CODE_DELETE
+
+    class Summary(
+        val keys: Long, val words: Long, val listenMs: Long,
+        val apps: List<Pair<String, Long>>, val songs: List<Pair<String, Long>>
+    )
+
+    private var appCtx: Context? = null
+    private val main = Handler(Looper.getMainLooper())
+    private val pending = HashMap<String, Long>()
+    private var flushQueued = false
+
+    // cached switches (refreshed by a prefs listener, so a key press stays cheap)
+    @Volatile private var onAll = true
+    @Volatile private var onKeys = true
+    @Volatile private var onWords = true
+    @Volatile private var onApps = true
+    @Volatile private var onListen = true
+    @Volatile private var onSongs = true
+    @Volatile private var ignorePw = true
+    @Volatile private var keepDays = 365
+
+    private var inWord = false
+    private var curPkg = ""
+    private var paused = false // password field
+
+    private var dayInt = 0
+    private var dayEnd = 0L
+
+    private var lastAt = 0L
+    private var lastSong: String? = null
+    private var lastPlaying = false
+
+    private val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ -> reload() }
+
+    fun prefs(c: Context): SharedPreferences =
+        c.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    @Synchronized
+    fun init(c: Context) {
+        if (appCtx != null) return
+        appCtx = c.applicationContext
+        val p = prefs(c)
+        p.registerOnSharedPreferenceChangeListener(listener)
+        reload()
+    }
+
+    private fun reload() {
+        val c = appCtx ?: return
+        val p = prefs(c)
+        onAll = p.getBoolean("st_on", true)
+        onKeys = p.getBoolean("st_keys", true)
+        onWords = p.getBoolean("st_words", true)
+        onApps = p.getBoolean("st_apps", true)
+        onListen = p.getBoolean("st_listen", true)
+        onSongs = p.getBoolean("st_songs", true)
+        ignorePw = p.getBoolean("st_pw", true)
+        keepDays = p.getInt("st_keep", 365)
+    }
+
+    /** Day as yyyymmdd, `offset` days back from today. */
+    fun day(offset: Int = 0): Int {
+        val cal = Calendar.getInstance()
+        if (offset != 0) cal.add(Calendar.DAY_OF_YEAR, -offset)
+        return cal.get(Calendar.YEAR) * 10000 + (cal.get(Calendar.MONTH) + 1) * 100 + cal.get(Calendar.DAY_OF_MONTH)
+    }
+
+    private fun today(): Int {
+        val now = System.currentTimeMillis()
+        if (now >= dayEnd) {
+            dayInt = day()
+            val cal = Calendar.getInstance()
+            cal.set(Calendar.HOUR_OF_DAY, 0); cal.set(Calendar.MINUTE, 0)
+            cal.set(Calendar.SECOND, 0); cal.set(Calendar.MILLISECOND, 0)
+            cal.add(Calendar.DAY_OF_YEAR, 1)
+            dayEnd = cal.timeInMillis
+            appCtx?.let { prune(it) }
+        }
+        return dayInt
+    }
+
+    private fun add(key: String, v: Long) {
+        synchronized(pending) { pending[key] = (pending[key] ?: 0L) + v }
+        if (!flushQueued) {
+            flushQueued = true
+            main.postDelayed({ flush() }, 20000L)
+        }
+    }
+
+    /** Called when a text field opens. Only the package name is kept in memory; it is a count bucket. */
+    fun setApp(c: Context, pkg: String?, password: Boolean) {
+        init(c)
+        curPkg = pkg ?: ""
+        paused = password && ignorePw
+        inWord = false
+    }
+
+    /** One key press. Only the kind of key matters, the character itself is never stored. */
+    fun onKey(codePoint: Int) {
+        if (!onAll || paused || appCtx == null) return
+        val isChar = codePoint > 0
+        if (!isChar && codePoint != CODE_DELETE) return
+        val d = today()
+        if (onKeys) add("k|$d", 1)
+        if (onApps && curPkg.isNotEmpty()) add("a|$d|$curPkg", 1)
+        if (isChar && onWords) {
+            if (Character.isLetterOrDigit(codePoint)) inWord = true
+            else if (inWord) { inWord = false; add("w|$d", 1) }
+        }
+    }
+
+    /** A swiped word or an emoji/text insert: counted as the number of words, never stored. */
+    fun onWordsAdded(n: Int) {
+        if (!onAll || paused || !onWords || n <= 0 || appCtx == null) return
+        add("w|${today()}", n.toLong())
+    }
+
+    fun onTextInsert(raw: String?) {
+        if (raw.isNullOrBlank()) return
+        var n = 0
+        for (t in raw.trim().split(Regex("\\s+"))) if (t.any { it.isLetterOrDigit() }) n++
+        onWordsAdded(n)
+    }
+
+    /** Called by the music listener on every check (about every 3 s). */
+    fun onTrack(c: Context, title: String?, artist: String?, playing: Boolean) {
+        init(c)
+        val now = System.currentTimeMillis()
+        if (onAll && lastPlaying && lastAt > 0L) {
+            val delta = (now - lastAt).coerceIn(0L, 10000L)
+            val d = today()
+            if (delta > 0 && onListen) add("l|$d", delta)
+            val s = lastSong
+            if (delta > 0 && onSongs && s != null) add("s|$d|$s", delta)
+        }
+        lastAt = now
+        lastPlaying = playing && !title.isNullOrBlank()
+        lastSong = if (title.isNullOrBlank()) null else title + "\u001f" + (artist ?: "")
+    }
+
+    fun flush() {
+        val c = appCtx ?: return
+        flushQueued = false
+        val copy: Map<String, Long>
+        synchronized(pending) { copy = HashMap(pending); pending.clear() }
+        if (copy.isEmpty()) return
+        try {
+            val p = prefs(c)
+            val e = p.edit()
+            for ((k, v) in copy) e.putLong(k, p.getLong(k, 0L) + v)
+            e.apply()
+            RasiAccount.maybeSync(c)
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiStats", "Could not save stats: " + t.javaClass.simpleName)
+        }
+    }
+
+    private fun dayOf(key: String): Int = key.split("|", limit = 3).getOrNull(1)?.toIntOrNull() ?: 0
+
+    private fun prune(c: Context) {
+        try {
+            val limit = day(keepDays)
+            val p = prefs(c)
+            val old = p.all.keys.filter { it.contains('|') && dayOf(it) in 1 until limit }
+            if (old.isNotEmpty()) { val e = p.edit(); old.forEach { e.remove(it) }; e.apply() }
+        } catch (t: Throwable) {
+            RasiLog.fallback("RasiStats", "Could not clean old stats: " + t.javaClass.simpleName)
+        }
+    }
+
+    /** daysBack = 0 today only, 6 = last 7 days, -1 = all time. */
+    fun summary(c: Context, daysBack: Int, top: Int): Summary {
+        flush()
+        val from = if (daysBack < 0) 0 else day(daysBack)
+        var keys = 0L; var words = 0L; var listen = 0L
+        val apps = HashMap<String, Long>(); val songs = HashMap<String, Long>()
+        for ((k, v) in prefs(c).all) {
+            val n = (v as? Long) ?: continue
+            val parts = k.split("|", limit = 3)
+            if (parts.size < 2) continue
+            val d = parts[1].toIntOrNull() ?: continue
+            if (d < from) continue
+            when (parts[0]) {
+                "k" -> keys += n
+                "w" -> words += n
+                "l" -> listen += n
+                "a" -> if (parts.size == 3) apps[parts[2]] = (apps[parts[2]] ?: 0L) + n
+                "s" -> if (parts.size == 3) songs[parts[2]] = (songs[parts[2]] ?: 0L) + n
+            }
+        }
+        return Summary(keys, words, listen,
+            apps.entries.sortedByDescending { it.value }.take(top).map { it.key to it.value },
+            songs.entries.sortedByDescending { it.value }.take(top).map { it.key to it.value })
+    }
+
+    /** Keystrokes per day for the last [n] days, oldest first. */
+    fun dailyKeys(c: Context, n: Int): List<Pair<Int, Long>> {
+        flush()
+        val p = prefs(c)
+        return (n - 1 downTo 0).map { off -> val d = day(off); d to p.getLong("k|$d", 0L) }
+    }
+
+    fun resetAll(c: Context) {
+        synchronized(pending) { pending.clear() }
+        val p = prefs(c)
+        val e = p.edit()
+        p.all.keys.filter { it.contains('|') }.forEach { e.remove(it) }
+        e.apply()
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiSwipeMemory.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiSwipeMemory.kt
new file mode 100644
index 000000000..d9cecd4ed
--- /dev/null
+++ b/java/src/org/futo/inputmethod/latin/rasi/RasiSwipeMemory.kt
@@ -0,0 +1,115 @@
+package org.futo.inputmethod.latin.rasi
+
+import android.content.Context
+import android.content.SharedPreferences
+import org.futo.inputmethod.latin.SuggestedWords.SuggestedWordInfo
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.ArrayList
+
+/**
+ * Remembers swipe corrections: when a swipe produced word X, you deleted it and typed Y,
+ * the next swipe that produces X gives Y first. If Y is wrong again and you type Z, Z becomes
+ * first and Y becomes the secondary suggestion.
+ */
+object RasiSwipeMemory {
+    private const val MAX_PER_WORD = 3
+    private const val PENDING_TIMEOUT_MS = 60_000L
+
+    private var prefs: SharedPreferences? = null
+    private val map = HashMap<String, ArrayList<String>>()
+
+    @Volatile private var pendingWrong: String? = null
+    @Volatile private var pendingTime = 0L
+    @Volatile private var lastShownTop: String? = null
+    @Volatile private var lastOriginal: String? = null
+
+    @JvmStatic
+    @Synchronized
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences("rasi_swipe_memory", Context.MODE_PRIVATE)
+        prefs = p
+        try {
+            val obj = JSONObject(p.getString("map", "{}") ?: "{}")
+            for (k in obj.keys()) {
+                val arr = obj.getJSONArray(k)
+                val list = ArrayList<String>()
+                for (i in 0 until arr.length()) list.add(arr.getString(i))
+                map[k] = list
+            }
+        } catch (e: Exception) {
+            e.printStackTrace()
+        }
+    }
+
+    @Synchronized
+    private fun save() {
+        val obj = JSONObject()
+        for ((k, v) in map) obj.put(k, JSONArray(v))
+        prefs?.edit()?.putString("map", obj.toString())?.apply()
+    }
+
+    /** Called when the user deletes a word that a swipe just typed. */
+    @JvmStatic
+    fun noteRejected(word: String?) {
+        if (word.isNullOrEmpty()) return
+        val original = if (word == lastShownTop && lastOriginal != null) lastOriginal else word
+        pendingWrong = original
+        pendingTime = System.currentTimeMillis()
+    }
+
+    /** Called when the user commits a word they typed (or picked) themselves. */
+    @JvmStatic
+    @Synchronized
+    fun noteTyped(word: String?) {
+        val wrong = pendingWrong ?: return
+        if (word.isNullOrEmpty()) return
+        if (System.currentTimeMillis() - pendingTime > PENDING_TIMEOUT_MS) {
+            pendingWrong = null
+            return
+        }
+        pendingWrong = null
+        if (word.equals(wrong, ignoreCase = true)) return
+        val key = wrong.lowercase()
+        val list = map.getOrPut(key) { ArrayList() }
+        list.removeAll { it.equals(word, ignoreCase = true) }
+        list.add(0, word)
+        while (list.size > MAX_PER_WORD) list.removeAt(list.size - 1)
+        save()
+    }
+
+    /** Reorders swipe suggestions in place so learned words come first. */
+    @JvmStatic
+    @Synchronized
+    fun apply(suggestions: ArrayList<SuggestedWordInfo>) {
+        if (suggestions.isEmpty()) return
+        val original = suggestions[0].mWord
+        val learned = map[original.lowercase()]
+        if (learned == null || learned.isEmpty()) {
+            lastShownTop = original
+            lastOriginal = original
+            return
+        }
+        // learned[0] first, learned[1] second; the rest keep their order after them.
+        val front = ArrayList<SuggestedWordInfo>()
+        for (w in learned.take(2)) {
+            val existing = suggestions.firstOrNull { it.mWord.equals(w, ignoreCase = true) }
+            if (existing != null) {
+                suggestions.remove(existing)
+                front.add(existing)
+            } else {
+                front.add(
+                    SuggestedWordInfo(
+                        w, "", SuggestedWordInfo.MAX_SCORE - front.size,
+                        SuggestedWordInfo.KIND_CORRECTION, null,
+                        SuggestedWordInfo.NOT_AN_INDEX, SuggestedWordInfo.NOT_A_CONFIDENCE
+                    )
+                )
+            }
+        }
+        suggestions.addAll(0, front)
+        lastShownTop = suggestions[0].mWord
+        lastOriginal = original
+    }
+}
diff --git a/java/src/org/futo/inputmethod/latin/rasi/RasiTextCodecs.kt b/java/src/org/futo/inputmethod/latin/rasi/RasiTextCodecs.kt
