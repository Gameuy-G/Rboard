+/**
+ * Swipe a message to the left: a short swipe is Reply, a long one is Edit (own messages only).
+ * The round icon sits to the right of the message and slides in with it.
+ */
+@Composable
+internal fun SwipeRow(
+    enabled: Boolean, canEdit: Boolean, look: ChatLook, perf: Boolean,
+    onReply: () -> Unit, onEdit: () -> Unit, content: @Composable () -> Unit
+) {
+    val density = androidx.compose.ui.platform.LocalDensity.current
+    val replyPx = with(density) { look.replyDp.dp.toPx() }
+    val editPx = with(density) { look.editDp.dp.toPx() }
+    val maxPx = if (canEdit) editPx * 1.25f else replyPx * 1.5f
+    var dx by remember { mutableFloatStateOf(0f) }
+    var stage by remember { mutableIntStateOf(0) }
+    val scope = rememberCoroutineScope()
+    val haptics = LocalHapticFeedback.current
+    val onReplyU by rememberUpdatedState(onReply)
+    val onEditU by rememberUpdatedState(onEdit)
+    fun stageOf(x: Float): Int = if (canEdit && -x >= editPx) 2 else if (-x >= replyPx) 1 else 0
+    fun back() {
+        if (perf) { dx = 0f } else scope.launch { Animatable(dx).animateTo(0f, tween(150)) { dx = value } }
+    }
+    val drag = if (enabled) Modifier.pointerInput(replyPx, editPx, canEdit, look.haptic) {
+        detectHorizontalDragGestures(
+            onDragEnd = {
+                val st = stage; stage = 0
+                if (st == 1) onReplyU() else if (st == 2) onEditU()
+                back()
+            },
+            onDragCancel = { stage = 0; back() }
+        ) { change, amount ->
+            change.consume()
+            dx = (dx + amount).coerceIn(-maxPx, 0f)
+            val st = stageOf(dx)
+            if (st != stage) {
+                stage = st
+                if (look.haptic && st > 0) haptics.performHapticFeedback(HapticFeedbackType.TextHandleMove)
+            }
+        }
+    } else Modifier
+    val prog = (-dx / replyPx).coerceIn(0f, 1f)
+    Box(Modifier.fillMaxWidth().then(drag)) {
+        Box(Modifier.fillMaxWidth().offset { IntOffset(dx.roundToInt(), 0) }) {
+            content()
+            if (dx < -2f) {
+                val bg = when (stage) { 1 -> MaterialTheme.colorScheme.primary; 2 -> MaterialTheme.colorScheme.tertiary; else -> MaterialTheme.colorScheme.surfaceVariant }
+                val fg = when (stage) { 1 -> MaterialTheme.colorScheme.onPrimary; 2 -> MaterialTheme.colorScheme.onTertiary; else -> MaterialTheme.colorScheme.onSurfaceVariant }
+                Box(
+                    Modifier.align(Alignment.CenterEnd).offset(x = 48.dp).size(36.dp).alpha(prog).clip(CircleShape).background(bg),
+                    contentAlignment = Alignment.Center
+                ) { androidx.compose.material3.Icon(if (stage == 2) org.futo.inputmethod.latin.uix.RasiIcons.Edit else org.futo.inputmethod.latin.uix.RasiIcons.Reply, null, Modifier.size(20.dp), tint = fg) }
+            }
+        }
+    }
+}
