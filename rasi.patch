+                ) { pvPlace = it; prefs.edit().putString("pill_viz_place", it).apply(); RasiNowPlaying.notifyChanged() }
+                if (pvPlace == "cover") {
+                    SwitchRow("Rotate with the cover", "Off keeps the visualizer still while the cover spins.", pvRot) {
+                        pvRot = it; prefs.edit().putBoolean("pill_viz_rotate", it).apply(); RasiNowPlaying.notifyChanged()
+                    }
+                }
+                RasiSection("Style")
+                RasiOptionRows(
+                    listOf("bars" to "Bars", "circle" to "Small circle"), pvStyle
+                ) { pvStyle = it; prefs.edit().putString("pill_viz_style", it).apply(); RasiNowPlaying.notifyChanged() }
+                RasiPrefSlider(prefs, "pill_viz_count", "Bar count", "", 12, 3, 48)
+                RasiColorSourceSection(prefs, "pill_viz_")
+                RasiPrefSlider(prefs, "pill_viz_sens", "Sensitivity", " %", 70, 10, 100)
+                RasiPrefSlider(prefs, "pill_viz_opacity", "Opacity", " %", 80, 10, 100)
